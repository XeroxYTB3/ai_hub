{"app":"ai-hub-update","format":1,"version":"2.2.0","notes":"Reprise integree, mode developpeur, notifications, theme clair/sombre","createdAt":"2026-10-06T20:01:53.240Z","requiresLauncher":null,"files":{"main-core.js":{"sha256":"41b867598df4324cc1cb78df3bd44fe77a3b9d63c2dbcc174ceb2c47cecfd4c9","content":"const { app, BrowserWindow, ipcMain, session, clipboard, dialog, Notification, shell, nativeTheme } = require('electron');\nconst path = require('path'), fs = require('fs'), crypto = require('crypto');\nconst { pathToFileURL } = require('url');\n\nmodule.exports = function start(ctx) {\nlet win;\n// (Le dossier de données fixe est défini par le lanceur main.js)\nconst ud = () => app.getPath('userData');\nconst STATE = () => path.join(ud(), 'ai-hub-state.json');\nconst BK = () => path.join(ud(), 'backups');\nlet lastBk = 0;\n\n// Thème enregistré (lu avant d'ouvrir la fenêtre pour éviter un flash blanc/noir au démarrage)\nconst BG = { dark: '#262624', light: '#FAF9F5' };\nfunction savedTheme() { try { const t = JSON.parse(fs.readFileSync(STATE(), 'utf8')).settings.theme; return ['light', 'dark'].includes(t) ? t : 'system'; } catch { return 'system'; } }\nif (process.platform === 'win32') { try { app.setAppUserModelId('com.aihub.app'); } catch {} }   // nécessaire pour les notifications Windows\n\n// Les sites ne peuvent pas envoyer leurs propres notifications ni demander la position : AI Hub centralise les notifications\nconst DENY = new Set(['notifications', 'geolocation', 'midi', 'midiSysex']);\napp.on('session-created', (s) => {\n  try {\n    s.setPermissionRequestHandler((_wc, perm, cb) => cb(!DENY.has(perm)));\n    s.setPermissionCheckHandler((_wc, perm) => !DENY.has(perm));\n  } catch {}\n});\n\nfunction create() {\n  nativeTheme.themeSource = savedTheme();\n  win = new BrowserWindow({\n    width: 1440, height: 900, backgroundColor: nativeTheme.shouldUseDarkColors ? BG.dark : BG.light, autoHideMenuBar: true,\n    icon: fs.existsSync(path.join(__dirname, 'icon.ico')) ? path.join(__dirname, 'icon.ico') : undefined,\n    webPreferences: { preload: path.join(__dirname, 'preload.js'), webviewTag: true, contextIsolation: true }\n  });\n  win.loadFile(path.join(__dirname, 'index.html'));\n  nativeTheme.on('updated', () => { try { win.setBackgroundColor(nativeTheme.shouldUseDarkColors ? BG.dark : BG.light); } catch {} });\n  win.webContents.on('render-process-gone', (_e, d) => { ctx.fatal('interface plantée : ' + (d && d.reason)); });\n}\n\nipcMain.handle('copy', (_e, t) => clipboard.writeText(t));\nipcMain.handle('clear', (_e, p) => session.fromPartition(p).clearStorageData());\nipcMain.handle('wvpreload', () => pathToFileURL(path.join(__dirname, 'webview-preload.js')).href);\n// Notifications Windows : un clic ramène la fenêtre au premier plan et ouvre le compte concerné\nconst liveNotifs = new Set();\nipcMain.handle('notify', (_e, t, b, accId) => {\n  if (!Notification.isSupported()) return { ok: false, error: 'unsupported' };\n  try {\n    const n = new Notification({ title: String(t || 'AI Hub'), body: String(b || '') });\n    liveNotifs.add(n);                                   // garder une référence (sinon le clic peut être perdu)\n    n.on('close', () => liveNotifs.delete(n));\n    n.on('failed', () => liveNotifs.delete(n));\n    n.on('click', () => {\n      liveNotifs.delete(n);\n      if (!win) return;\n      if (win.isMinimized()) win.restore();\n      win.show(); win.focus();\n      win.webContents.send('notif-click', accId || null);\n    });\n    n.show();\n    return { ok: true };\n  } catch (e) { return { ok: false, error: e.message }; }\n});\nipcMain.handle('theme:set', (_e, t) => { nativeTheme.themeSource = ['light', 'dark'].includes(t) ? t : 'system'; return nativeTheme.shouldUseDarkColors; });\n\n// Export de tous les comptes : liste + cookies de chaque session, chiffré (AES-256-GCM) si mot de passe\nipcMain.handle('export', async (_e, { state, partitions, pass }) => {\n  const cookies = {};\n  for (const p of partitions) cookies[p] = await session.fromPartition(p).cookies.get({});\n  const data = JSON.stringify({ app: 'ai-hub', version: app.getVersion(), v: 1, exportedAt: new Date().toISOString(), state, cookies });\n  let out = data;\n  if (pass) {\n    const salt = crypto.randomBytes(16), iv = crypto.randomBytes(12);\n    const c = crypto.createCipheriv('aes-256-gcm', crypto.scryptSync(pass, salt, 32), iv);\n    const enc = Buffer.concat([c.update(data, 'utf8'), c.final()]);\n    out = JSON.stringify({ app: 'ai-hub', version: app.getVersion(), enc: 1, salt: salt.toString('base64'), iv: iv.toString('base64'), tag: c.getAuthTag().toString('base64'), data: enc.toString('base64') });\n  }\n  const r = await dialog.showSaveDialog(win, { defaultPath: 'ai-hub-comptes-' + new Date().toISOString().slice(0, 10) + '.json' });\n  if (r.canceled) return { ok: false };\n  fs.writeFileSync(r.filePath, out);\n  return { ok: true, path: r.filePath, encrypted: !!pass };\n});\n\nipcMain.handle('import', async (_e, pass) => {\n  const r = await dialog.showOpenDialog(win, { filters: [{ name: 'JSON', extensions: ['json'] }], properties: ['openFile'] });\n  if (r.canceled) return { ok: false };\n  let j = JSON.parse(fs.readFileSync(r.filePaths[0], 'utf8'));\n  const ver = j.version;\n  if (j.app && j.app !== 'ai-hub') return { ok: false, error: 'Ce fichier ne vient pas de AI Hub' };\n  if (j.enc) {\n    try {\n      const d = crypto.createDecipheriv('aes-256-gcm', crypto.scryptSync(pass || '', Buffer.from(j.salt, 'base64'), 32), Buffer.from(j.iv, 'base64'));\n      d.setAuthTag(Buffer.from(j.tag, 'base64'));\n      j = JSON.parse(Buffer.concat([d.update(Buffer.from(j.data, 'base64')), d.final()]).toString('utf8'));\n    } catch { return { ok: false, error: 'Mot de passe incorrect ou fichier corrompu' }; }\n  }\n  let n = 0;\n  for (const [p, list] of Object.entries(j.cookies || {})) for (const c of list) {\n    try {\n      const o = { url: `http${c.secure ? 's' : ''}://${c.domain.replace(/^\\./, '')}${c.path}`, name: c.name, value: c.value, path: c.path, secure: c.secure, httpOnly: c.httpOnly, sameSite: c.sameSite, expirationDate: c.expirationDate };\n      if (!c.hostOnly) o.domain = c.domain;\n      await session.fromPartition(p).cookies.set(o); n++;\n    } catch {}\n  }\n  return { ok: true, state: j.state, cookies: n, version: ver || j.version, current: app.getVersion() };\n});\n\n// Sauvegarde de l'état (comptes, code, détections) dans un fichier avec copies de secours\nconst count = (s) => { try { return (JSON.parse(s).accs || []).length; } catch { return -1; } };\nipcMain.handle('state:load', () => {\n  const files = [STATE()];\n  try { files.push(...fs.readdirSync(BK()).sort().reverse().map((f) => path.join(BK(), f))); } catch {}\n  for (const f of files) { try { return JSON.parse(fs.readFileSync(f, 'utf8')); } catch {} }\n  return null;\n});\nipcMain.handle('state:save', (_e, json) => {\n  fs.mkdirSync(BK(), { recursive: true });\n  try {\n    const old = fs.readFileSync(STATE(), 'utf8');\n    if (old !== json && (count(json) < count(old) || Date.now() - lastBk > 60000)) {\n      fs.writeFileSync(path.join(BK(), 'state-' + new Date().toISOString().replace(/[:.]/g, '-') + '.json'), old); lastBk = Date.now();\n      fs.readdirSync(BK()).sort().reverse().slice(40).forEach((f) => fs.unlinkSync(path.join(BK(), f)));\n    }\n  } catch {}\n  fs.writeFileSync(STATE() + '.tmp', json); fs.renameSync(STATE() + '.tmp', STATE());\n  return true;\n});\n// Sessions qui existent sur le disque mais ne sont plus dans la liste des comptes\nipcMain.handle('orphans', async (_e, known) => {\n  let names = []; try { names = fs.readdirSync(path.join(ud(), 'Partitions')); } catch {}\n  const out = [];\n  for (const n of names) {\n    if (!/^a\\d+$/.test(n) || known.includes(n)) continue;\n    const ck = await session.fromPartition('persist:' + n).cookies.get({});\n    if (ck.length) out.push({ id: n, domains: [...new Set(ck.map((c) => c.domain.replace(/^\\./, '')))] });\n  }\n  return out;\n});\nipcMain.handle('open-data', () => shell.openPath(ud()));\n\n\n// ---------- Résumé par Gemini (appel fait ici, dans le processus principal : pas de souci CORS) ----------\nipcMain.handle('gemini', async (_e, { key, model, system, prompt }) => {\n  if (!key) return { ok: false, error: 'Clé Gemini absente' };\n  const m = String(model || 'gemini-flash-latest').replace(/[^\\w.\\-]/g, '');\n  const ac = new AbortController(), to = setTimeout(() => ac.abort(), 90000);\n  try {\n    const r = await fetch((process.env.AIHUB_GEMINI_URL || 'https://generativelanguage.googleapis.com/v1beta/models/') + m + ':generateContent', {\n      method: 'POST', signal: ac.signal, headers: { 'Content-Type': 'application/json', 'x-goog-api-key': key },\n      body: JSON.stringify({ systemInstruction: system ? { parts: [{ text: system }] } : undefined, contents: [{ role: 'user', parts: [{ text: prompt }] }], generationConfig: { temperature: 0.2, maxOutputTokens: 8192 } })\n    });\n    const j = await r.json().catch(() => null);\n    if (!r.ok) return { ok: false, status: r.status, error: (j && j.error && j.error.message) || 'HTTP ' + r.status };\n    const c = j && j.candidates && j.candidates[0];\n    const text = ((c && c.content && c.content.parts) || []).map((p) => p.text || '').join('').trim();\n    if (!text) return { ok: false, error: 'Réponse vide (' + ((c && c.finishReason) || (j && j.promptFeedback && j.promptFeedback.blockReason) || '?') + ')' };\n    return { ok: true, text };\n  } catch (e) { return { ok: false, error: e.name === 'AbortError' ? 'Délai dépassé (90 s)' : e.message }; }\n  finally { clearTimeout(to); }\n});\n\n// ---------- Mises à jour (la logique est dans updater.js, testée à part) ----------\nconst backupState = (ver) => {                       // copie des données AVANT d'installer : on ne perd rien\n  try { fs.mkdirSync(BK(), { recursive: true }); fs.copyFileSync(STATE(), path.join(BK(), 'state-' + new Date().toISOString().replace(/[:.]/g, '-') + '-avant-maj-' + ver + '.json')); } catch {}\n};\nipcMain.handle('upd:info', () => Object.assign(ctx.updater.info(), { active: ctx.boot.version, rolledBack: ctx.boot.rolledBack, dataDir: ud() }));\nipcMain.handle('upd:apply', async () => {\n  const r = await dialog.showOpenDialog(win, { filters: [{ name: 'Mise à jour AI Hub', extensions: ['aihubupdate', 'json'] }], properties: ['openFile'] });\n  if (r.canceled) return { ok: false, cancelled: true };\n  try { return ctx.updater.install(ctx.updater.readPackage(r.filePaths[0]), { beforeInstall: backupState }); }\n  catch (e) { return { ok: false, error: 'Fichier illisible : ' + e.message }; }\n});\nipcMain.handle('upd:revert', (_e, to) => ctx.updater.revert(to));\nipcMain.handle('upd:healthy', () => ctx.updater.confirm());\nipcMain.handle('upd:fail', (_e, reason) => ctx.fatal('interface : ' + String(reason).slice(0, 200)));\nipcMain.handle('relaunch', () => { ctx.relaunch(); });\n// Garde-fou : une nouvelle version qui ne confirme pas en 15 s est annulée\nif (ctx.updater.info().pending) setTimeout(() => { if (ctx.updater.info().pending) ctx.fatal('aucune confirmation de démarrage en 15 s'); }, 15000);\n\n// Une seule instance à la fois : empêche deux fenêtres d'écraser les mêmes données\nif (!app.requestSingleInstanceLock()) app.quit();\nelse {\n  app.on('second-instance', () => { if (win) { if (win.isMinimized()) win.restore(); win.show(); win.focus(); } });\n  app.whenReady().then(create);\n}\napp.on('window-all-closed', () => app.quit());\n};\n"},"preload.js":{"sha256":"c9cba307cc3b093b88a142efcf2f5d2ef71450d89bc50d248e48d0a5fd63e99f","content":"const { contextBridge, ipcRenderer } = require('electron');\nconst i = (c) => (...a) => ipcRenderer.invoke(c, ...a);\ncontextBridge.exposeInMainWorld('api', {\n  copy: i('copy'), clear: i('clear'), wvpreload: i('wvpreload'), notify: i('notify'),\n  exportAll: i('export'), importAll: i('import'),\n  stateLoad: i('state:load'), stateSave: i('state:save'), orphans: i('orphans'), openData: i('open-data'),\n  gemini: i('gemini'), updInfo: i('upd:info'), updApply: i('upd:apply'), updRevert: i('upd:revert'),\n  updHealthy: i('upd:healthy'), updFail: i('upd:fail'), relaunch: i('relaunch'),\n  setTheme: i('theme:set'), onNotifClick: (cb) => ipcRenderer.on('notif-click', (_e, id) => cb(id))\n});\n"},"webview-preload.js":{"sha256":"bcf79f0c8798020388acd303246b48974790377e1f27b5c73a55865e50a4ae03","content":"// Tourne DANS chaque page de chat : détecte les événements et les envoie à l'app\nconst { ipcRenderer } = require('electron');\nlet cfg = { detectors: [], idle: 120, sel: {} };\n\n// Sélecteurs par défaut + sélecteurs de secours ajoutés dans Paramètres > Détections (cfg.sel)\nconst BASE = {\n  user: '[data-testid=\"user-message\"],user-query,[data-message-author-role=\"user\"]',\n  ai: '.font-claude-response,model-response,[data-message-author-role]:not([data-message-author-role=\"user\"])',   // aligné sur index.html\n  comp: '[contenteditable=\"true\"],textarea',\n  stop: '[data-testid=\"stop-button\"],button[aria-label*=\"Stop\" i],button[aria-label*=\"Arrêter\" i],button[aria-label*=\"Interrompre\" i]',\n  send: '[data-testid=\"send-button\"],button[aria-label*=\"Send\" i],button[aria-label*=\"Envoyer\" i]'\n};\nconst S = Object.assign({}, BASE);\nlet SKIP = '';\nfunction applySel() {\n  const sel = cfg.sel || {};\n  for (const k of Object.keys(BASE)) {\n    let extra = (sel[k] || '').trim();\n    if (extra) { try { document.querySelector(extra); } catch { ipcRenderer.sendToHost('hub-event', { type: 'selector-invalid', detail: { key: k, value: extra }, url: location.href, ts: Date.now() }); extra = ''; } }\n    S[k] = extra ? BASE[k] + ',' + extra : BASE[k];\n  }\n  SKIP = S.user + ',' + S.ai + ',' + S.comp + ',nav,aside,script,style,noscript';\n}\napplySel();\nipcRenderer.on('hub:config', (_e, c) => { cfg = c; applySel(); });\n\n// [événement, regex, événement de fin]\nconst PAT = [\n  ['limit-hit', /(you('|’)?ve (hit|reached) (your|the|our) [\\w\\s-]{0,25}(limit|cap)|usage (limit|cap)|message (limit|cap)|limit reached|out of (free )?messages|limite (d['’]utilisation|de messages|quotidienne|atteinte)|vous avez atteint (votre|la) limite|(n['’]avez|il n['’]y a) plus de messages|plus de messages (gratuits|disponibles)|plus aucun message|come back (later|tomorrow)|reviens? plus tard)/i, 'limit-cleared'],\n  ['limit-soon', /(\\d+|few) messages? (remaining|left)|il vous reste \\d+ message|\\d+ messages? restants?/i],\n  ['rate-limit', /(too many (requests|messages)|rate limit|trop de (requêtes|messages)|slow down|ralentissez)/i],\n  ['overloaded', /(overloaded|at capacity|high demand|forte demande|surcharg|temporarily unavailable|service unavailable|temporairement indisponible)/i],\n  ['error', /(something went wrong|an error occurred|une erreur (est survenue|s['’]est produite)|network error|erreur réseau|failed to (load|send|generate)|impossible de (générer|envoyer)|unable to (send|generate))/i],\n  ['chat-too-long', /(conversation (is )?too long|conversation trop longue|context (window|limit)|maximum (conversation )?length|longueur maximale|start a new (chat|conversation)|commencez une nouvelle conversation)/i],\n  ['captcha', /(verify (that )?you are human|verifying you are human|vérifiez que vous êtes (un )?humain|checking your browser|just a moment|vérification de sécurité)/i, 'captcha-cleared']\n];\nconst LOGIN_BTN = /^(log ?in|sign ?in|se connecter|connexion|continue with (google|email)|continuer avec (google|e-?mail))$/im;\n\nconst emit = (type, detail) => ipcRenderer.sendToHost('hub-event', { type, detail, url: location.href, ts: Date.now() });\nconst q = (s) => { try { return [...document.querySelectorAll(s)]; } catch { return []; } };\nconst vis = (e) => e && e.offsetParent !== null;\nemit('page-start');\nconst flags = {};\nconst edge = (k, on, onT, offT, d) => {\n  if (on && !flags[k]) { flags[k] = 1; emit(onT, d); }\n  else if (!on && flags[k]) { flags[k] = 0; if (offT) emit(offT); }\n};\nfunction shortTexts() {\n  const out = [], w = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT); let n;\n  while ((n = w.nextNode())) {\n    const t = n.nodeValue.trim();\n    if (t.length > 2 && t.length < 300) { const p = n.parentElement; if (p && !p.closest(SKIP)) out.push(t); }\n  }\n  return out.join('\\n');\n}\n\nlet lastUrl = location.href, pu = null, lastLen = 0, lastGrow = 0, recentSend = 0, lastTyping = 0, lastAct = Date.now();\nlet gen = false, genStart = 0, genSeen = 0, lg = null, lgCount = 0, t0 = Date.now();\n\ndocument.addEventListener('keydown', (e) => {\n  lastAct = Date.now();\n  if (e.key === 'Enter' && !e.shiftKey && e.target.closest && e.target.closest(S.comp)) {\n    const t = (e.target.value || e.target.innerText || '').trim();\n    if (t) { recentSend = Date.now(); emit('send-attempt', { via: 'enter', preview: t.slice(0, 200) }); }\n  }\n}, true);\ndocument.addEventListener('click', (e) => {\n  lastAct = Date.now();\n  if (e.target.closest && e.target.closest(S.send)) {\n    const c = q(S.comp)[0]; const t = c ? (c.value || c.innerText || '').trim() : '';\n    recentSend = Date.now(); emit('send-attempt', { via: 'click', preview: t.slice(0, 200) });\n  }\n}, true);\ndocument.addEventListener('input', (e) => {\n  lastAct = Date.now();\n  if (e.target.closest && e.target.closest(S.comp) && Date.now() - lastTyping > 3000) emit('typing');\n  lastTyping = Date.now();\n}, true);\ndocument.addEventListener('visibilitychange', () => emit(document.hidden ? 'tab-hidden' : 'tab-visible'));\nwindow.addEventListener('offline', () => emit('offline'));\nwindow.addEventListener('online', () => emit('online'));\nwindow.addEventListener('load', () => emit('page-loaded', { title: document.title }));\n\nfunction poll() {\n  if (!document.body) return;\n  const now = Date.now();\n  // URL / navigation\n  if (location.href !== lastUrl) {\n    emit('url-changed', { from: lastUrl, to: location.href }); lastUrl = location.href;\n    if (/^\\/(new|app|chat)?\\/?$/.test(location.pathname)) emit('new-chat');\n    else if (/\\/(chat|c|chats|app|thread|search)\\/[\\w-]{8,}/.test(location.pathname)) emit('chat-opened');\n  }\n  // connexion\n  const txt = shortTexts();\n  const comp = q(S.comp).some(vis), pw = q('input[type=password]').some(vis);\n  const cur = comp && !pw ? true : (!comp && (pw || LOGIN_BTN.test(txt)) && now - t0 > 2500 ? false : null);\n  if (cur !== null) {\n    if (cur === lg) lgCount = 0; else if (++lgCount >= 2) {\n      if (cur) emit('logged-in'); else { emit('login-required'); if (lg === true) emit('session-expired'); }\n      lg = cur; lgCount = 0;\n    }\n  }\n  // messages + génération\n  const users = q(S.user), ais = q(S.ai), u = users.length;\n  if (pu === null || u < pu) pu = u;\n  else if (u === pu + 1) {\n    pu = u; recentSend = now;\n    emit('message-sent', { count: u, preview: (users[u - 1].innerText || '').trim().slice(0, 200) });\n  } else pu = u;\n  const last = ais[ais.length - 1], len = last ? last.textContent.length : 0;\n  if (len > lastLen && now - recentSend < 90000) lastGrow = now;\n  lastLen = len;\n  const stopOn = q(S.stop).some(vis);\n  const g = stopOn || now - lastGrow < 1500;\n  if (g) genSeen = now;\n  if (g && !gen) { gen = true; genStart = now; emit('response-started', { via: stopOn ? 'stop-button' : 'text-growth' }); }\n  else if (!g && gen && now - genSeen > 1200) {\n    gen = false;\n    emit('response-complete', { chars: len, seconds: Math.round((now - genStart) / 100) / 10, userMessages: u, aiMessages: ais.length, preview: last ? last.textContent.trim().slice(0, 300) : '' });\n  }\n  // bannières / erreurs\n  for (const [type, re, off] of PAT) { const m = txt.match(re); edge('p' + type, !!m, type, off, m && { match: m[0].slice(0, 120) }); }\n  // détecteurs personnalisés\n  for (const d of cfg.detectors || []) {\n    if (!d.name || !d.value || (d.host !== '*' && !location.hostname.endsWith(d.host))) continue;\n    let on = false;\n    try { on = d.kind === 'selector' ? q(d.value).length > 0 : new RegExp(d.value, 'i').test(txt); } catch {}\n    edge('c' + d.name, on, d.name, d.name + '-gone', {});\n  }\n  // inactivité\n  edge('idle', !gen && now - lastAct > (cfg.idle || 120) * 1000, 'idle', 'active', {});\n}\nsetInterval(poll, 800);\n"},"index.html":{"sha256":"f9c16c1cc0c6c8a61f41f1b2bd3a2ab1ab85c580f66263c066148b2bed7b2ba3","content":"<!DOCTYPE html>\n<html lang=\"fr\" data-theme=\"system\"><head><meta charset=\"UTF-8\"><title>AI Hub</title>\n<script>/* garde-fou : une erreur au démarrage d'une version en essai la fait annuler tout de suite */\nwindow.__healthy=false;(()=>{const f=m=>{if(!window.__healthy&&window.api)window.api.updFail(String(m))};addEventListener('error',e=>f(e.message));addEventListener('unhandledrejection',e=>f(e.reason&&e.reason.message||e.reason))})();</script>\n<style>\n/* ===== Thème : palette inspirée de claude.ai (fond crème, accent terracotta ; sombre = gris chaud) ===== */\n:root{color-scheme:light;\n--bg:#FAF9F5;--side:#F3F1EA;--panel:#FFFFFF;--hover:rgba(31,30,29,.06);--sel:rgba(31,30,29,.09);\n--line:#E4E1D6;--line2:#CFCBBE;--txt:#1F1E1D;--dim:#6F6D66;--acc:#C6613F;--btn:#B5532F;--btnh:#9E4527;\n--soft:rgba(198,97,63,.10);--ok:#2F7D5B;--warn:#A9691A;--err:#B3412F;--tbg:#1F1E1D;--ttx:#FAF9F5;\n--shadow:0 1px 2px rgba(31,30,29,.06),0 8px 28px rgba(31,30,29,.12);\n--serif:\"Iowan Old Style\",\"Palatino Linotype\",Palatino,\"Book Antiqua\",Georgia,serif;\n--sans:system-ui,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif}\n:root[data-theme=dark]{color-scheme:dark;\n--bg:#262624;--side:#1F1E1D;--panel:#30302E;--hover:rgba(250,249,245,.06);--sel:rgba(250,249,245,.10);\n--line:#3D3C38;--line2:#57554E;--txt:#F2F0E8;--dim:#A3A198;--acc:#E08A6B;--btn:#B5532F;--btnh:#C65F39;\n--soft:rgba(224,138,107,.14);--ok:#6CC59A;--warn:#E0B060;--err:#EE8A78;--tbg:#F2F0E8;--ttx:#1F1E1D;\n--shadow:0 1px 2px rgba(0,0,0,.3),0 8px 28px rgba(0,0,0,.45)}\n@media (prefers-color-scheme:dark){:root[data-theme=system]{color-scheme:dark;\n--bg:#262624;--side:#1F1E1D;--panel:#30302E;--hover:rgba(250,249,245,.06);--sel:rgba(250,249,245,.10);\n--line:#3D3C38;--line2:#57554E;--txt:#F2F0E8;--dim:#A3A198;--acc:#E08A6B;--btn:#B5532F;--btnh:#C65F39;\n--soft:rgba(224,138,107,.14);--ok:#6CC59A;--warn:#E0B060;--err:#EE8A78;--tbg:#F2F0E8;--ttx:#1F1E1D;\n--shadow:0 1px 2px rgba(0,0,0,.3),0 8px 28px rgba(0,0,0,.45)}}\n\n*{box-sizing:border-box;margin:0}\nhtml,body{height:100%}\nbody{display:flex;background:var(--bg);color:var(--txt);font:14px/1.5 var(--sans);-webkit-font-smoothing:antialiased}\n::-webkit-scrollbar{width:10px;height:10px}::-webkit-scrollbar-thumb{background:var(--line);border-radius:10px;border:2px solid transparent;background-clip:content-box}::-webkit-scrollbar-thumb:hover{background:var(--line2);background-clip:content-box}\n:focus-visible{outline:2px solid var(--acc);outline-offset:2px}\n.ic{width:16px;height:16px;flex:none}\ncode{font:12.5px Consolas,monospace;background:var(--hover);padding:1px 5px;border-radius:5px}\n\n/* barre latérale */\naside{width:264px;background:var(--side);border-right:1px solid var(--line);display:flex;flex-direction:column;padding:14px 12px;gap:10px;flex:none}\n.brand{display:flex;align-items:center;gap:10px;padding:4px 8px 6px}\n.brand svg{width:26px;height:26px;color:var(--acc)}\nh1{font:500 22px var(--serif);letter-spacing:-.01em}\n#list{flex:1;overflow:auto;margin:0 -4px;padding:0 4px}\n.grp{color:var(--dim);font-size:11.5px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;padding:14px 10px 4px}\n.acc{display:flex;align-items:center;gap:9px;padding:7px 10px;border-radius:8px;cursor:pointer;min-height:34px}\n.acc:hover{background:var(--hover)}.acc.on{background:var(--sel);font-weight:500}\n.dot{width:8px;height:8px;border-radius:50%;flex:none}\n.acc span{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.acc b{display:none;font-weight:400;color:var(--dim);padding:3px;border-radius:6px;line-height:0}\n.acc:hover b{display:block}.acc b:hover{color:var(--txt);background:var(--hover)}.acc b[data-del]:hover{color:var(--err)}\n.bd{display:inline-flex;font-style:normal;color:var(--dim)}.bd.err{color:var(--err)}.bd.warn{color:var(--warn)}\n.spin{width:12px;height:12px;border:2px solid var(--line2);border-top-color:var(--acc);border-radius:50%;animation:rot .8s linear infinite;flex:none}\n@keyframes rot{to{transform:rotate(360deg)}}\n\n/* boutons et champs */\n.btn{font:inherit;font-weight:500;color:var(--txt);background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:7px 12px;cursor:pointer;display:inline-flex;align-items:center;gap:7px;transition:background .12s,border-color .12s}\n.btn:hover{background:var(--hover);border-color:var(--line2)}\n.btn.pri{background:var(--btn);border-color:var(--btn);color:#fff}.btn.pri:hover{background:var(--btnh);border-color:var(--btnh)}\n.btn.ghost{background:transparent;border-color:transparent}.btn.ghost:hover{background:var(--hover)}\n.btn.wide{width:100%;justify-content:center}.btn.wide.left{justify-content:flex-start}\n.btn:disabled{opacity:.5;cursor:default}\nselect,input:not([type=checkbox]),textarea{padding:8px 10px;background:var(--panel);color:var(--txt);border:1px solid var(--line);border-radius:8px;font:inherit}\nselect{padding-right:6px}\ntextarea,pre{font:13px Consolas,monospace}\ninput::placeholder,textarea::placeholder{color:var(--dim)}\npre{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:12px;overflow:auto;white-space:pre-wrap;line-height:1.5}\ndetails{margin:12px 0}summary{cursor:pointer;color:var(--acc);font-weight:500}\n\n/* zone principale */\nmain{flex:1;display:flex;flex-direction:column;min-width:0}\nheader{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 16px;border-bottom:1px solid var(--line);min-height:56px}\nheader strong{font-weight:500;font-size:15px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.hbtns{display:flex;gap:6px;flex:none}\n#ask{display:flex;align-items:center;gap:12px;flex-wrap:wrap;padding:10px 16px;background:var(--soft);border-bottom:1px solid var(--line)}\n#ask[hidden]{display:none}#ask span{flex:1;min-width:200px}\n#views{flex:1;position:relative;background:var(--bg)}\nwebview{position:absolute;inset:0;width:100%;height:100%;display:none;background:var(--bg)}\nwebview.on{display:flex}\n#empty{position:absolute;inset:0;display:grid;place-items:center;text-align:center;padding:40px}\n#empty div{max-width:420px}\n#empty h2{font:500 28px var(--serif);letter-spacing:-.01em;margin-bottom:8px}\n#empty p{color:var(--dim);margin-bottom:18px}\n#bar{position:absolute;top:0;left:0;right:0;height:2px;z-index:6;overflow:hidden;display:none}\n#bar.on{display:block}#bar i{display:block;height:100%;width:35%;background:var(--acc);animation:slide 1s infinite ease-in-out}\n@keyframes slide{from{transform:translateX(-100%)}to{transform:translateX(300%)}}\n\n/* paramètres */\n#set{position:absolute;inset:0;z-index:5;background:var(--bg);display:none}\n#set.on{display:grid;grid-template-columns:250px 1fr}\n.snav{border-right:1px solid var(--line);background:var(--side);padding:22px 12px;display:flex;flex-direction:column;gap:2px;overflow:auto}\n.snav h2{font:500 22px var(--serif);padding:0 10px 14px}\n.snav button{font:inherit;text-align:left;background:none;border:0;color:var(--dim);padding:8px 10px;border-radius:8px;cursor:pointer}\n.snav button:hover{background:var(--hover);color:var(--txt)}.snav button.on{background:var(--sel);color:var(--txt);font-weight:500}\n.sgrp{color:var(--dim);font-size:11.5px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;padding:16px 10px 4px}\n.dev-only{display:none}body.dev .dev-only{display:block}\n.spanes{overflow:auto}\n.pane{display:none;padding:28px 40px 56px;max-width:840px}.pane.on{display:block}\n.pane h2{font:500 28px var(--serif);letter-spacing:-.01em;margin-bottom:6px}\n.pane h3{font-size:14px;font-weight:600;margin:26px 0 6px}\n.pane p,.dim,.lead{color:var(--dim);line-height:1.55}\n.pane p{margin:4px 0}\n.warn{color:var(--warn);margin:8px 0}\n.card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:4px 18px;margin:8px 0}\n.card.pad{padding:16px 18px}\n.opt{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:14px 0;border-bottom:1px solid var(--line);cursor:pointer}\n.opt:last-child{border-bottom:0}.opt.nc{cursor:default}\n.opt b{font-weight:500}.opt small{display:block;color:var(--dim);font-size:12.5px;margin-top:2px;line-height:1.45}\n.opt.off{opacity:.55}\n.sw{appearance:none;-webkit-appearance:none;width:38px;height:22px;padding:0;border:0;border-radius:22px;background:var(--line2);position:relative;cursor:pointer;flex:none;transition:background .15s}\n.sw::after{content:\"\";position:absolute;top:3px;left:3px;width:16px;height:16px;border-radius:50%;background:#fff;transition:transform .15s;box-shadow:0 1px 2px rgba(0,0,0,.25)}\n.sw:checked{background:var(--btn)}.sw:checked::after{transform:translateX(16px)}\n.seg{display:inline-flex;background:var(--hover);border-radius:10px;padding:3px;gap:2px}\n.seg button{font:inherit;border:0;background:none;color:var(--dim);padding:5px 14px;border-radius:8px;cursor:pointer}\n.seg button.on{background:var(--panel);color:var(--txt);box-shadow:0 1px 2px rgba(0,0,0,.14);font-weight:500}\n.line{display:flex;gap:8px;align-items:center;margin:10px 0;flex-wrap:wrap}\n.pill{display:inline-block;font-size:12px;font-weight:500;padding:2px 9px;border-radius:20px;background:var(--hover);color:var(--dim)}\n.pill.ok{background:rgba(47,125,91,.14);color:var(--ok)}.pill.no{background:rgba(179,65,47,.13);color:var(--err)}\n#code{width:100%;height:42vh;resize:vertical;white-space:pre;tab-size:2}\n.ev{display:grid;grid-template-columns:170px 1fr;gap:3px 12px;font-size:13px}.ev code{color:var(--acc);background:none;padding:0}\n.row2{display:grid;grid-template-columns:1.1fr 1fr 2fr 1fr auto;gap:6px;margin:6px 0}\n#logl{max-height:46vh;overflow:auto}\n#custom{width:100%;height:190px;resize:vertical}\n\n/* fenêtres, bulle */\ndialog{margin:auto;background:var(--panel);color:var(--txt);border:1px solid var(--line);border-radius:16px;padding:22px;width:380px;box-shadow:var(--shadow)}\ndialog::backdrop{background:rgba(0,0,0,.45)}\ndialog h3{font:500 20px var(--serif);margin-bottom:6px}\ndialog label{display:block;margin:14px 0 4px;color:var(--dim)}\ndialog label.inl{display:flex;align-items:center;gap:8px;color:var(--txt)}\ndialog select,dialog input:not([type=checkbox]){width:100%}\n.row{display:flex;gap:8px;justify-content:flex-end;margin-top:20px}\n#toast{position:fixed;bottom:24px;left:50%;transform:translate(-50%,20px);background:var(--tbg);color:var(--ttx);padding:10px 16px;border-radius:10px;font-weight:500;opacity:0;pointer-events:none;transition:.2s;z-index:99;max-width:70vw;box-shadow:var(--shadow)}\n#toast.show{opacity:1;transform:translate(-50%,0)}\n@media (prefers-reduced-motion:reduce){#toast{transition:none}.spin{animation-duration:2.4s}}\n\n/* écran de démarrage */\n#splash{position:fixed;inset:0;z-index:50;background:var(--bg);display:flex;flex-direction:column;align-items:center;justify-content:center;transition:opacity .5s,transform .5s}\n#splash.out{opacity:0;transform:scale(1.04);pointer-events:none}\n#splash svg{width:150px;height:150px;overflow:visible}\n#splash .ln{stroke:var(--acc);stroke-width:4;stroke-linecap:round;stroke-dasharray:140;stroke-dashoffset:140;animation:draw .7s ease-out forwards}\n#splash .nd,#splash .ct,#splash .rg{transform-box:fill-box;transform-origin:center}\n#splash .nd{fill:var(--acc);transform:scale(0);animation:pop .45s cubic-bezier(.2,1.6,.4,1) forwards}\n#splash .ct{fill:var(--txt);animation:beat 1.4s ease-in-out .9s infinite}\n#splash .rg{fill:none;stroke:var(--acc);stroke-width:2;opacity:0;animation:ring 1.6s ease-out .9s infinite}\n#splash .wm{margin-top:24px;font:500 24px var(--serif);letter-spacing:.3em;text-indent:.3em;opacity:0;transform:translateY(8px);animation:rise .6s .7s forwards}\n@keyframes draw{to{stroke-dashoffset:0}}@keyframes pop{to{transform:scale(1)}}@keyframes beat{50%{transform:scale(1.18)}}\n@keyframes ring{0%{opacity:.7;transform:scale(1)}100%{opacity:0;transform:scale(3.4)}}@keyframes rise{to{opacity:1;transform:none}}\n@media (prefers-reduced-motion:reduce){#splash *{animation-duration:.01s!important;animation-delay:0s!important}}\n</style></head><body>\n<div id=\"splash\"><svg viewBox=\"0 0 120 120\"><g>\n<line class=\"ln\" x1=\"60\" y1=\"60\" x2=\"60\" y2=\"14\" style=\"animation-delay:.1s\"/><line class=\"ln\" x1=\"60\" y1=\"60\" x2=\"20\" y2=\"94\" style=\"animation-delay:.25s\"/><line class=\"ln\" x1=\"60\" y1=\"60\" x2=\"100\" y2=\"94\" style=\"animation-delay:.4s\"/>\n<circle class=\"nd\" cx=\"60\" cy=\"14\" r=\"9\" style=\"animation-delay:.35s\"/><circle class=\"nd\" cx=\"20\" cy=\"94\" r=\"9\" style=\"animation-delay:.5s\"/><circle class=\"nd\" cx=\"100\" cy=\"94\" r=\"9\" style=\"animation-delay:.65s\"/>\n<circle class=\"rg\" cx=\"60\" cy=\"60\" r=\"11\"/><circle class=\"ct\" cx=\"60\" cy=\"60\" r=\"13\"/></g></svg><div class=\"wm\">AI HUB</div></div>\n\n<aside>\n  <div class=\"brand\"><svg viewBox=\"0 0 120 120\" fill=\"currentColor\" stroke=\"currentColor\"><line x1=\"60\" y1=\"60\" x2=\"60\" y2=\"18\" stroke-width=\"7\" stroke-linecap=\"round\"/><line x1=\"60\" y1=\"60\" x2=\"24\" y2=\"92\" stroke-width=\"7\" stroke-linecap=\"round\"/><line x1=\"60\" y1=\"60\" x2=\"96\" y2=\"92\" stroke-width=\"7\" stroke-linecap=\"round\"/><circle cx=\"60\" cy=\"16\" r=\"12\" stroke=\"none\"/><circle cx=\"22\" cy=\"94\" r=\"12\" stroke=\"none\"/><circle cx=\"98\" cy=\"94\" r=\"12\" stroke=\"none\"/><circle cx=\"60\" cy=\"60\" r=\"15\" stroke=\"none\"/></svg><h1>AI Hub</h1></div>\n  <button id=\"add\" class=\"btn pri wide\" data-ic=\"plus\">Ajouter un compte</button>\n  <div id=\"list\"></div>\n  <button id=\"gear\" class=\"btn ghost wide left\" data-ic=\"sliders\">Paramètres</button>\n</aside>\n\n<main>\n  <header><strong id=\"title\">Aucun compte sélectionné</strong>\n    <div class=\"hbtns\"><button id=\"reload\" class=\"btn ghost\" data-ic=\"refresh\">Recharger</button><button id=\"handoff\" class=\"btn\" data-ic=\"swap\">Reprendre ailleurs</button><button id=\"export\" class=\"btn\" data-ic=\"copy\">Copier la conversation</button></div></header>\n  <div id=\"ask\" hidden><span id=\"asktxt\"></span><button id=\"askyes\" class=\"btn pri\">Reprendre</button><button id=\"askno\" class=\"btn\">Ignorer</button></div>\n  <div id=\"views\"><div id=\"bar\"><i></i></div>\n  <div id=\"empty\"><div><h2>Tous tes comptes IA, au même endroit</h2><p>Chaque compte garde sa session : tu n'as plus à te reconnecter.</p><button id=\"add2\" class=\"btn pri\" data-ic=\"plus\">Ajouter un compte</button></div></div>\n\n  <section id=\"set\">\n    <nav class=\"snav\"><h2>Paramètres</h2>\n      <button data-t=\"gen\" class=\"on\">Général</button>\n      <button data-t=\"acc\">Comptes et sauvegarde</button>\n      <button data-t=\"rel\">Reprise sur un autre compte</button>\n      <button data-t=\"upd\">Mises à jour</button>\n      <div class=\"dev-only\"><div class=\"sgrp\">Développeur</div>\n        <button data-t=\"code\" style=\"width:100%\">Code personnalisé</button><button data-t=\"det\" style=\"width:100%\">Détections</button><button data-t=\"log\" style=\"width:100%\">Journal en direct</button></div>\n    </nav>\n    <div class=\"spanes\">\n\n    <div class=\"pane on\" id=\"p-gen\">\n      <h2>Général</h2>\n      <h3>Apparence</h3>\n      <div class=\"card\"><div class=\"opt nc\"><span><b>Thème</b><small>« Système » suit le thème de Windows. Les sites (Claude, ChatGPT…) qui suivent le thème du système changent aussi.</small></span>\n        <span class=\"seg\" id=\"theme\"><button data-th=\"system\">Système</button><button data-th=\"light\">Clair</button><button data-th=\"dark\">Sombre</button></span></div></div>\n\n      <h3>Notifications</h3>\n      <div class=\"card pad\"><div class=\"line\" style=\"margin:0\"><span id=\"nstate\" class=\"pill\"></span><button id=\"nauth\" class=\"btn\"></button><button id=\"ntest\" class=\"btn\">Envoyer un test</button></div>\n        <p id=\"nhint\" style=\"margin-top:10px\"></p></div>\n      <div class=\"card\" id=\"ntypes\">\n        <label class=\"opt\"><span><b>Réponse terminée</b><small>Quand l'IA finit de répondre sur un compte que tu ne regardes pas.</small></span><input type=\"checkbox\" class=\"sw\" data-n=\"done\"></label>\n        <label class=\"opt\"><span><b>Limite atteinte</b><small>Quand un compte n'a plus de messages.</small></span><input type=\"checkbox\" class=\"sw\" data-n=\"limit\"></label>\n        <label class=\"opt\"><span><b>Reprise sur un autre compte</b><small>Quand une conversation est transférée (ou ne peut pas l'être).</small></span><input type=\"checkbox\" class=\"sw\" data-n=\"handoff\"></label>\n        <label class=\"opt\"><span><b>Compte déconnecté</b><small>Quand une session expire.</small></span><input type=\"checkbox\" class=\"sw\" data-n=\"logout\"></label>\n      </div>\n\n      <h3>Options</h3>\n      <div class=\"card\">\n        <label class=\"opt\"><span><b>Garder tous les comptes chargés en arrière-plan</b><small>Nécessaire pour détecter les limites et les réponses sur les comptes qui ne sont pas affichés.</small></span><input type=\"checkbox\" class=\"sw\" id=\"preall\"></label>\n        <label class=\"opt\"><span><b>Mode développeur</b><small>Active l'onglet « Code personnalisé » (scripts JavaScript), les détections personnalisées et le journal en direct. Désactivé : aucun script n'est exécuté.</small></span><input type=\"checkbox\" class=\"sw\" id=\"dev\"></label>\n      </div>\n    </div>\n\n    <div class=\"pane\" id=\"p-acc\">\n      <h2>Comptes et sauvegarde</h2>\n      <h3>Fichier de comptes</h3>\n      <p>Enregistre tes comptes, leurs sessions connectées et tes réglages dans UN fichier. Charge-le dans une autre instance de AI Hub (autre PC, réinstallation) : les comptes arrivent déjà connectés. Les comptes déjà présents sont conservés.</p>\n      <p class=\"warn\">Ce fichier donne accès à tes comptes sans mot de passe. Mets un mot de passe de chiffrement, et ne le partage jamais.</p>\n      <div class=\"line\"><input id=\"pass\" type=\"password\" placeholder=\"Mot de passe de chiffrement\" autocomplete=\"off\" style=\"width:260px\">\n        <button id=\"exp\" class=\"btn pri\">Enregistrer dans un fichier</button><button id=\"imp\" class=\"btn\">Charger depuis un fichier</button></div>\n      <p id=\"msg\"></p>\n      <h3>Sécurité des données</h3>\n      <p>Les comptes sont enregistrés avec des copies de secours automatiques, et une seule fenêtre AI Hub peut tourner à la fois. Si un compte a disparu de la liste, sa session existe peut-être encore :</p>\n      <div class=\"line\"><button id=\"recover\" class=\"btn\">Retrouver les comptes perdus</button><button id=\"opendata\" class=\"btn\">Ouvrir le dossier des données</button></div>\n    </div>\n\n    <div class=\"pane\" id=\"p-rel\">\n      <h2>Reprise sur un autre compte</h2>\n      <p class=\"lead\">Quand un compte atteint sa limite, AI Hub reprend la conversation sur un autre compte et prépare le message de reprise.</p>\n      <div class=\"card\">\n        <label class=\"opt\"><span><b>Reprise automatique</b><small>Détecte la limite et lance la reprise sans que tu aies à intervenir.</small></span><input type=\"checkbox\" class=\"sw\" data-r=\"enabled\"></label>\n        <div class=\"opt nc\"><span><b>Quand la limite est atteinte</b></span><select data-r=\"mode\"><option value=\"auto\">Reprendre tout de suite</option><option value=\"ask\">Me demander d'abord</option></select></div>\n        <label class=\"opt\"><span><b>Même plateforme seulement</b><small>Ex. de Claude vers un autre compte Claude.</small></span><input type=\"checkbox\" class=\"sw\" data-r=\"samePlatform\"></label>\n        <label class=\"opt\"><span><b>Envoyer le message automatiquement</b><small>Sinon, le message est collé dans la zone de saisie et tu valides toi-même (recommandé pour commencer).</small></span><input type=\"checkbox\" class=\"sw\" data-r=\"send\"></label>\n      </div>\n      <h3>Contenu transmis</h3>\n      <div class=\"card\">\n        <label class=\"opt\"><span><b>Résumer les longues conversations avec Gemini</b><small id=\"sumnote\"></small></span><input type=\"checkbox\" class=\"sw\" data-r=\"summary\"></label>\n        <div class=\"opt nc\"><span><b>Consigne donnée à l'IA</b></span><select data-r=\"tpl\"><option value=\"continue\">Continuer directement le travail</option><option value=\"ready\">Répondre « Prêt » et attendre</option></select></div>\n        <div class=\"opt nc\"><span><b>Taille maximale</b><small>En caractères. Au-delà, les messages du milieu sont omis (le début et la fin sont gardés).</small></span><input type=\"number\" data-r=\"maxChars\" min=\"5000\" max=\"300000\" step=\"5000\" style=\"width:110px\"></div>\n      </div>\n      <details><summary>Modèle du message (avancé)</summary>\n        <p>Laisse vide pour utiliser le modèle intégré. Variables : <code>{plateforme}</code> <code>{compte}</code> <code>{contexte}</code> <code>{suite}</code> <code>{date}</code></p>\n        <textarea id=\"custom\" data-r=\"custom\" spellcheck=\"false\" placeholder=\"[REPRISE] Voici le contexte :&#10;{contexte}&#10;&#10;{suite}\"></textarea></details>\n\n      <h3>Résumé par IA (Gemini)</h3>\n      <p>La conversation est envoyée à Google pour être résumée. Sans clé, ou si Gemini ne répond pas, la conversation est transmise en entier (tronquée si trop longue). La clé est stockée dans le fichier de données de l'app (et dans le fichier de comptes exporté, chiffré si tu mets un mot de passe).</p>\n      <div class=\"line\"><input id=\"gkey\" type=\"password\" placeholder=\"Clé API Gemini\" autocomplete=\"off\" style=\"width:300px\"><input id=\"gmodel\" placeholder=\"modèle\" style=\"width:200px\"><button id=\"gtest\" class=\"btn\">Tester</button></div>\n      <p id=\"gmsg\"></p>\n\n      <h3>Dernières reprises</h3>\n      <pre id=\"hlist\">Aucune reprise pour l'instant.</pre>\n\n      <details><summary>Lecture des conversations (si un site a changé)</summary>\n        <p>Si un site change son code et que l'app ne lit plus la conversation (icône d'alerte dans la liste des comptes), ajoute ici des sélecteurs CSS : ils s'ajoutent aux sélecteurs d'origine, sans mise à jour de l'app. Sépare plusieurs sélecteurs par des virgules. Pour en trouver un : clic droit sur l'élément dans Chrome &gt; Inspecter.</p>\n        <div class=\"line\"><select id=\"selplat\"></select></div>\n        <div class=\"line\"><input id=\"sel-user\" placeholder=\"Tes messages\" style=\"flex:1\"><input id=\"sel-ai\" placeholder=\"Réponses de l'IA\" style=\"flex:1\"></div>\n        <div class=\"line\"><input id=\"sel-comp\" placeholder=\"Zone de saisie\" style=\"flex:1\"><input id=\"sel-stop\" placeholder=\"Bouton Stop\" style=\"flex:1\"><input id=\"sel-send\" placeholder=\"Bouton Envoyer\" style=\"flex:1\"></div>\n        <div class=\"line\"><button id=\"selsave\" class=\"btn pri\">Enregistrer les sélecteurs</button><button id=\"diag\" class=\"btn\">Tester les sélecteurs (comptes chargés)</button></div>\n        <pre id=\"diagout\" style=\"display:none\"></pre></details>\n    </div>\n\n    <div class=\"pane\" id=\"p-upd\">\n      <h2>Mises à jour</h2>\n      <h3>Version</h3><div id=\"upinfo\" class=\"dim\"></div>\n      <p>Une mise à jour est un fichier <code>.aihubupdate</code>. Avant de l'installer, tes données sont copiées dans les sauvegardes. Si la nouvelle version ne démarre pas correctement, l'app revient toute seule à la précédente.</p>\n      <div class=\"line\"><button id=\"upapply\" class=\"btn pri\">Installer un fichier de mise à jour</button><button id=\"uprev\" class=\"btn\">Revenir à la version précédente</button><button id=\"uporig\" class=\"btn\">Revenir à la version d'origine</button></div>\n      <p id=\"upmsg\"></p>\n      <h3>Versions installées</h3><pre id=\"upvers\"></pre>\n      <h3>Historique</h3><pre id=\"uphist\"></pre>\n    </div>\n\n    <div class=\"pane\" id=\"p-code\">\n      <h2>Code personnalisé</h2>\n      <p>Mode développeur. Ton code s'exécute dans l'app avec un accès complet à tes comptes et réagit aux événements. Il est relancé à chaque enregistrement et au démarrage. La reprise sur un autre compte est déjà intégrée (onglet « Reprise ») : inutile de la refaire ici, ou tu risques une double reprise.</p>\n      <textarea id=\"code\" spellcheck=\"false\"></textarea>\n      <div class=\"line\"><button id=\"savecode\" class=\"btn pri\">Enregistrer et activer</button><button id=\"resetcode\" class=\"btn\">Remettre l'exemple</button><span id=\"cst\" class=\"dim\"></span></div>\n      <details open><summary>API disponible</summary><pre>on('limit-hit', async ev =&gt; { ... })     // '*' = tous les événements ; once(...) = une seule fois\nev = { type, detail, url, ts, account:{id,platform,name} }\n\nhub.accounts                  liste des comptes     hub.active   compte affiché\nhub.state(id?)                { gen, limited, logged, last, lastAt }\nhub.switchTo(nom|id|n°|\"Claude:nom\")                 hub.next({samePlatform, skipLimited, dir})\nhub.available({samePlatform, from})                  premier compte non limité\nhub.handoff(from?, {to, send, summary})              reprise intégrée : renvoie { ok, to, mode, chars } ou { ok:false, error }\nhub.getConversation(compte?)                         texte de la conversation (null s'il n'y en a pas)\nhub.getMessages(compte?)     hub.health(compte?)     messages lus / diagnostic des sélecteurs\nhub.exportConversation(compte?)                      idem + copie dans le presse-papiers\nhub.newChat(compte?)                                 ouvre une nouvelle conversation\nhub.paste(texte, {account, send})                    écrit dans la zone de saisie (send:true = Entrée)\nhub.send(compte?)             hub.continueOn(compte, {from, send})   (ancien nom de handoff)\nhub.summarize(texte, {platform})   hub.aiEnabled     résumé Gemini (null sans clé)\nhub.runInPage(js, compte?)   hub.reload(compte?)     hub.notify(msg)   hub.copy(texte)\nhub.log(...)   hub.store.get(k) / hub.store.set(k,v)   hub.setLimited(c, bool)   hub.rename(c, nom)   await sleep(ms)</pre></details>\n    </div>\n\n    <div class=\"pane\" id=\"p-det\">\n      <h2>Détections</h2>\n      <h3>Événements détectés automatiquement</h3>\n      <div class=\"ev\" id=\"evlist\"></div>\n      <h3>Tes propres détections</h3>\n      <p>Un événement est émis quand le sélecteur CSS existe dans la page (ou que le texte correspond à la regex), et <code>nom-gone</code> quand il disparaît.</p>\n      <div id=\"dets\"></div>\n      <div class=\"line\"><button id=\"adddet\" class=\"btn\">Ajouter une détection</button><button id=\"savedet\" class=\"btn pri\">Enregistrer</button></div>\n    </div>\n\n    <div class=\"pane\" id=\"p-log\">\n      <h2>Journal en direct</h2>\n      <div id=\"logst\" class=\"dim\"></div>\n      <div class=\"line\"><input id=\"lf\" placeholder=\"Filtrer (ex. limit, handoff, claude…)\"><button id=\"logclr\" class=\"btn\">Vider</button><button id=\"logcp\" class=\"btn\">Copier en JSON</button></div>\n      <pre id=\"logl\"></pre>\n    </div>\n\n    </div>\n  </section></div>\n</main>\n\n<dialog id=\"dlg\"><h3>Nouveau compte</h3>\n  <label for=\"plat\">Plateforme</label><select id=\"plat\"></select>\n  <label for=\"name\">Nom du compte</label><input id=\"name\" placeholder=\"ex. perso, lycée, projet\" autocomplete=\"off\">\n  <div class=\"row\"><button id=\"cancel\" class=\"btn\">Annuler</button><button id=\"ok\" class=\"btn pri\">Ajouter</button></div></dialog>\n<dialog id=\"dlg2\"><h3>Renommer le compte</h3><label for=\"rname\">Nom</label><input id=\"rname\" autocomplete=\"off\">\n  <div class=\"row\"><button id=\"rcancel\" class=\"btn\">Annuler</button><button id=\"rok\" class=\"btn pri\">Enregistrer</button></div></dialog>\n<dialog id=\"dlgH\"><h3>Reprendre sur un autre compte</h3>\n  <p class=\"dim\" id=\"hsrc\"></p>\n  <label for=\"hto\">Compte de destination</label><select id=\"hto\"></select>\n  <label for=\"hmode\">Contenu transmis</label><select id=\"hmode\"><option value=\"sum\">Résumé + derniers échanges (si Gemini est configuré)</option><option value=\"full\">Conversation complète</option></select>\n  <label class=\"inl\"><input type=\"checkbox\" class=\"sw\" id=\"hsend\"> Envoyer le message automatiquement</label>\n  <div class=\"row\"><button id=\"hcancel\" class=\"btn\">Annuler</button><button id=\"hok\" class=\"btn pri\">Reprendre</button></div></dialog>\n<dialog id=\"dlgN\"><h3>Activer les notifications ?</h3>\n  <p class=\"dim\">AI Hub peut t'envoyer une notification Windows quand une réponse est terminée sur un autre compte, quand une limite est atteinte ou quand une conversation est reprise ailleurs. Tu peux choisir les types de notifications dans Paramètres &gt; Général.</p>\n  <div class=\"row\"><button id=\"nno\" class=\"btn\">Refuser</button><button id=\"nlater\" class=\"btn\">Plus tard</button><button id=\"nyes\" class=\"btn pri\" autofocus>Autoriser</button></div></dialog>\n<div id=\"toast\"></div>\n<script>\nconst P={Claude:['https://claude.ai/new','#e0905f'],ChatGPT:['https://chatgpt.com','#3ecf9e'],Gemini:['https://gemini.google.com','#6e9bff'],'Le Chat':['https://chat.mistral.ai','#ff8a3d'],Copilot:['https://copilot.microsoft.com','#a98bff'],Perplexity:['https://www.perplexity.ai','#35c4d6'],Grok:['https://grok.com','#8a8a98'],DeepSeek:['https://chat.deepseek.com','#5b7cff']};\nconst ICONS={plus:'<path d=\"M5 12h14M12 5v14\"/>',sliders:'<path d=\"M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6\"/>',edit:'<path d=\"M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z\"/>',x:'<path d=\"M18 6 6 18M6 6l12 12\"/>',copy:'<rect x=\"9\" y=\"9\" width=\"13\" height=\"13\" rx=\"2\"/><path d=\"M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1\"/>',refresh:'<path d=\"M3 12a9 9 0 0 1 15-6.7L21 8M21 3v5h-5M21 12a9 9 0 0 1-15 6.7L3 16M3 21v-5h5\"/>',swap:'<path d=\"m16 3 4 4-4 4M20 7H4M8 21l-4-4 4-4M4 17h16\"/>',lock:'<rect x=\"3\" y=\"11\" width=\"18\" height=\"11\" rx=\"2\"/><path d=\"M7 11V7a5 5 0 0 1 10 0v4\"/>',warn:'<path d=\"m21.7 18-8-14a2 2 0 0 0-3.4 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.7-3Z\"/><path d=\"M12 9v4M12 17h.01\"/>',ban:'<circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"m4.9 4.9 14.2 14.2\"/>'};\nconst IC=n=>`<svg class=\"ic\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">${ICONS[n]||''}</svg>`;\nconst EVENTS=[['page-loaded','une page finit de charger'],['url-changed','l\\'adresse change (detail: from, to)'],['new-chat','une nouvelle conversation s\\'ouvre'],['chat-opened','une ancienne conversation s\\'ouvre'],['logged-in','le compte est connecté'],['login-required','page de connexion affichée'],['session-expired','déconnecté alors qu\\'il était connecté'],['typing','tu commences à écrire'],['send-attempt','Entrée ou clic sur Envoyer (detail: preview)'],['message-sent','ta question est apparue dans la conversation'],['response-started','l\\'IA commence à répondre'],['response-complete','la réponse est terminée (chars, seconds, preview)'],['limit-hit','limite de messages / d\\'utilisation atteinte'],['limit-cleared','le message de limite a disparu'],['limit-soon','\"il vous reste N messages\"'],['rate-limit','trop de requêtes'],['overloaded','service surchargé / indisponible'],['error','erreur « something went wrong » etc.'],['chat-too-long','conversation trop longue'],['captcha','vérification « êtes-vous humain »'],['captcha-cleared','vérification passée'],['idle','aucune activité depuis 2 min'],['active','reprise après inactivité'],['tab-hidden','le compte n\\'est plus affiché'],['tab-visible','le compte est affiché'],['offline','plus de connexion internet'],['online','connexion revenue'],['code-error','(journal seulement) erreur dans ton code'],['handoff-*','(journal seulement) reprise sur un autre compte : ok, skip, fail'],['mon-nom','tes détections personnalisées (+ mon-nom-gone)']];\nconst EXAMPLE=`// Mode développeur : ton code réagit aux événements des comptes.\n// La reprise sur un autre compte est intégrée (Paramètres > Reprise) : inutile de la refaire ici.\n\n// Exemple : compter les messages envoyés par jour et par compte\n// on('message-sent', ev => {\n//   const jour = new Date().toISOString().slice(0, 10);\n//   const cle = 'msgs-' + ev.account.id + '-' + jour;\n//   hub.store.set(cle, (hub.store.get(cle) || 0) + 1);\n// });\n\n// Exemple : lancer une reprise à la main après une erreur\n// on('error', ev => hub.handoff(ev.account.id));\n`;\n// Ancien exemple (2.1) : s'il n'a pas été modifié, on le remplace pour ne pas doubler la reprise intégrée\nconst isOldExample=c=>/continueOn\\(cible/.test(c)&&c.length<1000;\nconst UA=navigator.userAgent.replace(/\\s?Electron\\/\\S+/,'').replace(/\\s?ai-hub\\/\\S+/,'');\nconst COMPOSER='[contenteditable=\"true\"],textarea';\nconst GEM='gemini-flash-latest';\nconst $=id=>document.getElementById(id);\nconst esc=s=>String(s).replace(/[&<>\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]));\nconst LS=(k,d)=>{try{const v=JSON.parse(localStorage[k]);return v??d}catch{return d}};\nconst sleep=ms=>new Promise(r=>setTimeout(r,ms));\nconst DEF=()=>({preloadAll:false,theme:'system',devMode:false,\n  notif:{enabled:null,on:{done:true,limit:true,handoff:true,logout:true}},\n  relay:{enabled:true,mode:'auto',samePlatform:true,send:false,summary:true,summaryAbove:15000,tpl:'continue',maxChars:60000,custom:''},\n  gemini:{key:'',model:GEM},selectors:{}});\nfunction mergeSettings(s){const d=DEF();s=s||{};\n  return {...d,...s,notif:{...d.notif,...(s.notif||{}),on:{...d.notif.on,...((s.notif||{}).on||{})}},relay:{...d.relay,...(s.relay||{})},gemini:{...d.gemini,...(s.gemini||{})},selectors:s.selectors||{}}}\nlet accs=[],active=null,detectors=[],settings=DEF(),userCode=EXAMPLE,store={},ready=false;\nlet PRE='',setOpen=false,tab='gen';\nconst st={},LOG=[],H={},HAND=[];\nconst stOf=id=>st[id]??={gen:false,limited:false,logged:null,last:'',lastAt:0};\nconst pub=a=>a&&{id:a.id,platform:a.p,name:a.n};\nconst save=()=>{if(ready)api.stateSave(JSON.stringify({v:3,accs,active,detectors,settings,code:userCode,store}))};\nconst toast=t=>{const e=$('toast');e.textContent=t;e.classList.add('show');clearTimeout(toast._t);toast._t=setTimeout(()=>e.classList.remove('show'),3200)};\nconst find=x=>x==null?null:typeof x==='object'?accs.find(a=>a.id===x.id)||null:accs.find(a=>a.id===x)||accs.find(a=>a.n.toLowerCase()===String(x).toLowerCase())||accs.find(a=>(a.p+':'+a.n).toLowerCase()===String(x).toLowerCase())||(/^\\d+$/.test(x)?accs[+x-1]:null)||null;\n$('plat').innerHTML=Object.keys(P).map(k=>`<option>${k}</option>`).join('');\ndocument.querySelectorAll('[data-ic]').forEach(e=>e.insertAdjacentHTML('afterbegin',IC(e.dataset.ic)));\n\n// ---------- thème ----------\nfunction applyTheme(){const t=settings.theme||'system';document.documentElement.dataset.theme=t;\n  document.querySelectorAll('#theme button').forEach(b=>b.classList.toggle('on',b.dataset.th===t));try{api.setTheme(t)}catch{}}\ndocument.querySelectorAll('#theme button').forEach(b=>b.onclick=()=>{settings.theme=b.dataset.th;save();applyTheme()});\n\n// ---------- notifications ----------\n// Le système (Windows) n'affiche une notification que si l'utilisateur a autorisé AI Hub ici ; sinon, simple bulle dans l'app.\nfunction ping(type,title,body,accId,o={}){\n  const N=settings.notif;if(type!=='script'&&N.on[type]===false)return;\n  const focused=document.hasFocus();\n  if(focused||o.toast)toast(title+(body?' — '+body:''));\n  if(!focused&&N.enabled===true)api.notify(title,body||'',accId||null).catch(()=>{});\n}\nfunction drawNotif(){\n  const N=settings.notif,on=N.enabled===true;\n  $('nstate').textContent=on?'Autorisées':N.enabled===false?'Refusées':'Pas encore demandé';\n  $('nstate').className='pill '+(on?'ok':N.enabled===false?'no':'');\n  $('nauth').textContent=on?'Désactiver':'Autoriser les notifications';\n  $('nauth').classList.toggle('pri',!on);$('ntest').disabled=!on;\n  $('nhint').textContent=on?'Si rien ne s\\'affiche : Paramètres Windows > Système > Notifications > AI Hub, et vérifie que le mode « Ne pas déranger » est désactivé.':'Les notifications ne s\\'affichent que lorsque la fenêtre AI Hub n\\'est pas au premier plan.';\n  document.querySelectorAll('[data-n]').forEach(el=>{el.checked=N.on[el.dataset.n]!==false;el.closest('.opt').classList.toggle('off',!on)});\n}\nasync function testNotif(){const r=await api.notify('AI Hub','Les notifications fonctionnent.',null);\n  if(!r.ok)toast('Notifications non prises en charge par ce système.');return r.ok}\nasync function setNotif(v){settings.notif.enabled=v;save();drawNotif();if(v){const ok=await testNotif();if(!ok){settings.notif.enabled=false;save();drawNotif()}}}\n$('nauth').onclick=()=>setNotif(settings.notif.enabled!==true);\n$('ntest').onclick=testNotif;\ndocument.querySelectorAll('[data-n]').forEach(el=>el.onchange=()=>{settings.notif.on[el.dataset.n]=el.checked;save()});\n$('nyes').onclick=()=>{$('dlgN').close();setNotif(true)};\n$('nno').onclick=()=>{$('dlgN').close();setNotif(false)};\n$('nlater').onclick=()=>$('dlgN').close();\napi.onNotifClick(id=>{if(id&&find(id)){active=id;setOpen=false;save();render()}});\n\n// ---------- vues (une par compte) ----------\nconst cfg=p=>({idle:120,sel:(settings.selectors||{})[p]||{},detectors:settings.devMode?detectors.map(d=>({...d,host:d.site&&d.site!=='*'&&P[d.site]?new URL(P[d.site][0]).hostname:'*'})):[]});\nconst pushCfg=()=>document.querySelectorAll('webview').forEach(v=>{const a=find(v.dataset.id);if(a)try{v.send('hub:config',cfg(a.p))}catch{}});\n\nfunction view(a){\n  let v=document.querySelector(`webview[data-id=\"${a.id}\"]`);\n  if(!v){v=document.createElement('webview');v.dataset.id=a.id;\n    v.setAttribute('partition','persist:'+a.id);v.setAttribute('useragent',UA);v.setAttribute('allowpopups','');v.setAttribute('preload',PRE);\n    v.addEventListener('ipc-message',e=>{if(e.channel==='hub-event')handle(a,e.args[0])});\n    v.addEventListener('did-start-loading',()=>{v._ld=true;bar()});v.addEventListener('did-stop-loading',()=>{v._ld=false;bar()});\n    v.addEventListener('dom-ready',()=>{v._ready=true;try{v.send('hub:config',cfg(a.p))}catch{}});\n    v.src=P[a.p][0];$('views').appendChild(v);}\n  return v;\n}\nconst bar=()=>{const v=document.querySelector(`webview[data-id=\"${active}\"]`);$('bar').classList.toggle('on',!!(v&&v._ld&&!setOpen))};\n\nfunction handle(a,ev){\n  const s=stOf(a.id),t=ev.type;\n  if(t==='page-start'){s.limited=false;s.gen=false;s.logged=null;return renderList()}\n  if(t==='response-started')s.gen=true;if(t==='response-complete')s.gen=false;\n  if(t==='limit-hit')s.limited=true;if(t==='limit-cleared')s.limited=false;\n  if(t==='logged-in')s.logged=true;if(t==='login-required')s.logged=false;\n  s.last=t;s.lastAt=ev.ts;\n  LOG.unshift({ts:ev.ts,acc:a.p+' · '+a.n,type:t,detail:ev.detail,url:ev.url});if(LOG.length>500)LOG.pop();\n  const e={...ev,account:pub(a)};\n  (H[t]||[]).concat(H['*']||[]).forEach(fn=>run(fn,e));          // scripts perso (vide si le mode développeur est désactivé)\n  if(t==='limit-hit')onLimit(a);\n  else if(t==='response-complete')onDone(a,ev);\n  else if(t==='session-expired')ping('logout','Compte déconnecté',a.p+' · '+a.n,a.id);\n  renderList();if(setOpen&&tab==='log')drawLog();\n}\nconst codeErr=x=>{LOG.unshift({ts:Date.now(),acc:'code',type:'code-error',detail:String(x&&x.message||x)});$('cst').textContent='Erreur : '+String(x&&x.message||x)};\nconst run=async(fn,e)=>{try{await fn(e)}catch(x){codeErr(x)}};\nfunction onDone(a,ev){\n  if(a.id===active&&!setOpen&&document.hasFocus())return;          // tu regardes déjà ce compte\n  const d=ev.detail||{};if((d.chars||0)<20)return;\n  ping('done',a.p+' · '+a.n+' a répondu',(d.preview||'').replace(/\\s+/g,' ').slice(0,110),a.id);\n}\n\n// ---------- liste des comptes ----------\nconst badges=s=>(s.gen?'<i class=\"spin\" title=\"L\\'IA répond\"></i>':'')+(s.limited?`<em class=\"bd err\" title=\"Limite atteinte\">${IC('ban')}</em>`:'')+(s.logged===false?`<em class=\"bd\" title=\"Déconnecté\">${IC('lock')}</em>`:'')+(s.degraded?`<em class=\"bd warn\" title=\"Conversation non reconnue : sélecteurs à vérifier (Paramètres > Reprise)\">${IC('warn')}</em>`:'');\nfunction renderList(){\n  const by={};accs.forEach(a=>(by[a.p]??=[]).push(a));\n  $('list').innerHTML=Object.keys(by).map(p=>`<div class=\"grp\">${esc(p)}</div>`+by[p].map(a=>{const s=stOf(a.id);\n    return `<div class=\"acc ${a.id===active&&!setOpen?'on':''}\" data-id=\"${a.id}\"><i class=\"dot\" style=\"background:${P[p][1]}\"></i><span>${esc(a.n)}</span>${badges(s)}<b data-ren=\"${a.id}\" title=\"Renommer\">${IC('edit')}</b><b data-del=\"${a.id}\" title=\"Supprimer\">${IC('x')}</b></div>`}).join('')).join('');\n}\nfunction render(){\n  renderList();if(!PRE)return;\n  if(settings.preloadAll)accs.forEach(view);\n  document.querySelectorAll('webview').forEach(v=>v.classList.toggle('on',v.dataset.id===active));\n  const a=find(active);\n  $('title').textContent=setOpen?'Paramètres':a?`${a.p} · ${a.n}`:'Aucun compte sélectionné';\n  $('empty').style.display=a?'none':'grid';\n  document.querySelector('.hbtns').style.visibility=(setOpen||!a)?'hidden':'visible';\n  $('set').classList.toggle('on',setOpen);\n  if(a)view(a).classList.add('on');\n  bar();\n}\n$('list').onclick=async e=>{\n  const rn=e.target.closest('[data-ren]'),d=e.target.closest('[data-del]');\n  if(rn){renId=rn.dataset.ren;$('rname').value=find(renId).n;$('dlg2').showModal();$('rname').focus();return}\n  if(d){const id=d.dataset.del,a=find(id);if(!confirm(`Supprimer ${a.p} · ${a.n} et sa session ?`))return;\n    document.querySelector(`webview[data-id=\"${id}\"]`)?.remove();await api.clear('persist:'+id);delete st[id];\n    accs=accs.filter(x=>x.id!==id);if(active===id)active=accs[0]?.id||null;save();return render();}\n  const r=e.target.closest('.acc');if(r){active=r.dataset.id;setOpen=false;save();render();}\n};\nconst openAdd=()=>{$('name').value='';$('dlg').showModal();$('name').focus()};\n$('add').onclick=openAdd;$('add2').onclick=openAdd;\n$('cancel').onclick=()=>$('dlg').close();\n$('ok').onclick=()=>{const n=$('name').value.trim();if(!n)return $('name').focus();\n  const a={id:'a'+Date.now(),p:$('plat').value,n};accs.push(a);active=a.id;setOpen=false;save();$('dlg').close();render();};\n$('name').onkeydown=e=>{if(e.key==='Enter')$('ok').click()};\n$('reload').onclick=()=>hub.reload();\n\n// ---------- lecture des conversations ----------\n// Sélecteurs d'origine (alignés sur webview-preload.js) + sélecteurs de secours de Paramètres > Reprise\nconst SELB={user:'[data-testid=\"user-message\"],user-query,[data-message-author-role=\"user\"]',ai:'.font-claude-response,model-response,[data-message-author-role]:not([data-message-author-role=\"user\"])',comp:COMPOSER,stop:'[data-testid=\"stop-button\"],button[aria-label*=\"Stop\" i],button[aria-label*=\"Arrêter\" i],button[aria-label*=\"Interrompre\" i]',send:'[data-testid=\"send-button\"],button[aria-label*=\"Send\" i],button[aria-label*=\"Envoyer\" i]'};\nconst selOf=(p,k)=>{const x=((settings.selectors||{})[p]||{})[k];return x&&x.trim()?SELB[k]+','+x.trim():SELB[k]};\nconst isChatUrl=u=>{try{return /\\/(chat|c|chats|app|thread|search|s)\\/[\\w-]{8,}/.test(new URL(u).pathname)}catch{return false}};\n// Une conversation est « reconnue » dès qu'on trouve au moins UN de tes messages (la limite peut empêcher toute réponse de l'IA)\nconst EXTRACT=a=>`(()=>{const ok=s=>{try{document.querySelector(s);return true}catch{return false}};\nconst U=${JSON.stringify(selOf(a.p,'user'))},A=${JSON.stringify(selOf(a.p,'ai'))};\nconst UU=ok(U)?U:${JSON.stringify(SELB.user)},AA=ok(A)?A:${JSON.stringify(SELB.ai)};\nconst els=[...document.querySelectorAll(UU+','+AA)];\nconst top=els.filter(e=>!els.some(o=>o!==e&&o.contains(e)));\nconst out=top.map(e=>({r:e.matches(UU)?'user':'ai',t:e.innerText.trim()})).filter(m=>m.t);\nif(out.some(m=>m.r==='user'))return {mode:'structured',msgs:out,url:location.href};\nconst m=document.querySelector('main')||document.body;\nreturn {mode:'raw',msgs:[{r:'raw',t:(m.innerText||'').trim()}],url:location.href};})()`;\nasync function read(a){\n  const r=await view(a).executeJavaScript(EXTRACT(a)),s=stOf(a.id);\n  if(r.mode==='raw'&&r.msgs[0]&&r.msgs[0].t&&isChatUrl(r.url)){        // page de conversation mais messages non reconnus\n    if(!s.degraded)LOG.unshift({ts:Date.now(),acc:a.p+' · '+a.n,type:'selector-warning',detail:'messages non reconnus : texte brut utilisé. Ajoute des sélecteurs de secours (Paramètres > Reprise).'});\n    s.degraded=true;renderList()}\n  else if(r.mode==='structured'&&s.degraded){s.degraded=false;renderList()}\n  return r}\n\n// ---------- construction du message de reprise ----------\nconst fmt=m=>(m.r==='user'?'👤 Moi : ':'🤖 IA : ')+m.t;\n// Garde le début (objectif) + la fin ; supprime des messages entiers au milieu\nfunction fit(msgs,max){\n  const all=msgs.map(fmt),size=s=>s.length+2;\n  if(all.reduce((n,s)=>n+size(s),0)<=max)return {text:all.join('\\n\\n'),cut:0};\n  const head=all[0].slice(0,Math.min(4000,Math.floor(max*.15)));\n  let budget=max-head.length-80,i=all.length-1;const tail=[];\n  while(i>0&&budget>200){const s=all[i];\n    if(size(s)<=budget){tail.unshift(s);budget-=size(s);i--}\n    else{tail.unshift('[…début du message tronqué…] '+s.slice(-(budget-40)));budget=0;i--;break}}\n  return {text:head+'\\n\\n[…'+i+' message(s) intermédiaire(s) omis…]\\n\\n'+tail.join('\\n\\n'),cut:i};\n}\nconst fitTail=(msgs,max)=>{const out=[];let n=0;for(let i=msgs.length-1;i>=0;i--){const s=fmt(msgs[i]);if(n+s.length>max&&out.length)break;out.unshift(n+s.length>max?s.slice(-max):s);n+=s.length}return {text:out.join('\\n\\n')}};\nconst TPL_CONTINUE=`[REPRISE AUTOMATIQUE] Cette conversation vient d'un autre compte {plateforme} ({compte}) qui a atteint sa limite. Tu es le relais : tu reprends le travail exactement là où il en est, sans perte.\n\n{contexte}\n\n## INSTRUCTIONS\n1. Ne dis pas bonjour, ne résume pas ce que je viens de te donner et ne repose pas de question dont la réponse figure déjà plus haut. Travaille directement.\n2. {suite}\n3. Réponds de façon concise et directe, dans le même registre et la même langue que la conversation.\n4. Si une information dont tu as besoin manque dans ce transfert, dis-le en une phrase au lieu de l'inventer.`;\nconst TPL_READY=`[CONTEXTE : conversation exportée depuis {plateforme}]\nVoici l'historique d'une conversation précédente. Lis-le en entier, retiens le contexte, réponds seulement « Prêt », puis continue la discussion à partir de là.\n\n{contexte}\n`;\nconst fill=(tpl,v)=>tpl.replace(/\\{(\\w+)\\}/g,(m,k)=>v[k]??m);\nconst ctxFull=(msgs,max)=>{const f=fit(msgs,max);return {ctx:'## CONVERSATION'+(f.cut?` (${f.cut} messages intermédiaires omis)`:'')+'\\n--- DÉBUT ---\\n'+f.text+'\\n--- FIN ---',how:f.cut?'tronqué':'complet'}};\nasync function buildHandoff(src,conv,o){\n  const R=settings.relay,msgs=conv.msgs.filter(m=>m.t);let ctx='',how='';\n  if(conv.mode==='raw'){ctx='## CONVERSATION (texte brut de la page)\\n--- DÉBUT ---\\n'+msgs[0].t.slice(-R.maxChars)+'\\n--- FIN ---';how='texte brut'}\n  else{\n    const full=msgs.map(fmt).join('\\n\\n');\n    if((o.summary??R.summary)&&hub.aiEnabled&&full.length>R.summaryAbove){\n      toast('Résumé de la conversation par Gemini…');\n      const sum=await hub.summarize(full,{platform:src.p});\n      if(sum){ctx='## RÉSUMÉ DE LA CONVERSATION\\n'+sum+'\\n\\n## FIN DE LA CONVERSATION (telle quelle)\\n'+fitTail(msgs,Math.min(8000,Math.floor(R.maxChars/4))).text;how='résumé'}\n    }\n    if(!ctx){const c=ctxFull(msgs,R.maxChars);ctx=c.ctx;how=c.how}\n  }\n  const last=msgs[msgs.length-1];\n  const suite=last&&last.r==='user'?'Ma dernière demande n\\'a pas reçu de réponse : réponds-y maintenant.'\n    :stOf(src.id).gen?'Ta dernière réponse a été interrompue par la limite : reprends-la exactement là où elle s\\'arrête, sans la recommencer.'\n    :'Continue la tâche en cours dans la logique de la fin de la conversation, avec la prochaine étape concrète. Si rien n\\'est en attente, dis-le en une ligne et attends ma prochaine demande.';\n  const tpl=R.custom&&R.custom.trim()?R.custom:R.tpl==='ready'?TPL_READY:TPL_CONTINUE;\n  const text=fill(tpl,{plateforme:src.p,compte:src.n,contexte:ctx,suite,date:new Date().toLocaleString()});\n  return {text,how,chars:text.length};\n}\n// Texte copié par le bouton « Copier la conversation » (modèle « Prêt », sans résumé)\nasync function exportPack(a){\n  const conv=await read(a);\n  if(conv.mode==='raw'&&(!isChatUrl(conv.url)||!conv.msgs[0]||!conv.msgs[0].t))return null;\n  const msgs=conv.msgs.filter(m=>m.t);if(!msgs.length)return null;\n  const body=conv.mode==='raw'?'--- DÉBUT ---\\n'+msgs[0].t.slice(-settings.relay.maxChars)+'\\n--- FIN ---':ctxFull(msgs,settings.relay.maxChars).ctx;\n  return {mode:conv.mode,n:msgs.length,txt:fill(TPL_READY,{plateforme:a.p,contexte:body})};\n}\n$('export').onclick=async()=>{\n  const a=find(active);if(!a)return toast('Sélectionne un compte d\\'abord');\n  try{const r=await exportPack(a);if(!r)return toast('Aucune conversation trouvée sur cette page');\n    await api.copy(r.txt);toast(r.mode==='raw'?'Copié : texte brut de la page (format du site non reconnu)':`Copié : ${r.n} messages. Colle-le ailleurs !`);\n  }catch(e){toast('Export impossible : '+e.message)}\n};\n\n// ---------- reprise sur un autre compte ----------\nlet HQ=Promise.resolve(),LASTANY=0;const LASTH={};\nconst enqueue=f=>{const p=HQ.then(f);HQ=p.catch(x=>hlog('fail',null,String(x&&x.message||x)));return p};   // une reprise à la fois\nconst hlog=(type,src,detail)=>LOG.unshift({ts:Date.now(),acc:src?src.p+' · '+src.n:'app',type:'handoff-'+type,detail});\nconst pickTarget=(src,visited=[])=>accs.find(x=>x.id!==src.id&&!visited.includes(x.id)&&!stOf(x.id).limited&&stOf(x.id).logged!==false&&(!settings.relay.samePlatform||x.p===src.p))||null;\nconst okSel=(a,k)=>{try{document.createDocumentFragment().querySelector(selOf(a.p,k));return selOf(a.p,k)}catch{return SELB[k]}};\n// Attend que la zone de saisie soit visible (page chargée). Renvoie true, 'login' ou false.\nasync function waitComposer(a,ms){\n  const v=view(a),t0=Date.now(),C=JSON.stringify(okSel(a,'comp'));\n  while(Date.now()-t0<ms){\n    try{const r=await v.executeJavaScript(`(()=>({c:[...document.querySelectorAll(${C})].some(e=>e.getClientRects().length>0),pw:!!document.querySelector('input[type=password]')}))()`);\n      if(r.c)return true;if(r.pw&&Date.now()-t0>4000)return 'login'}catch{}\n    await sleep(500)}\n  return false}\nfunction onLimit(a){\n  const R=settings.relay,dst=R.enabled?pickTarget(a):null;\n  if(!dst){ping('limit','Limite atteinte',a.p+' · '+a.n+(R.enabled?' — aucun autre compte disponible':''),a.id,{toast:true});return}\n  if(R.mode==='ask'){ping('limit','Limite atteinte sur '+a.p+' · '+a.n,'Ouvre AI Hub pour reprendre sur '+dst.n,a.id);return askBanner(a,dst)}\n  enqueue(()=>handoff(a.id,{to:dst.id,auto:true}));\n}\nfunction askBanner(src,dst){const b=$('ask');b.hidden=false;b.dataset.src=src.id;b.dataset.dst=dst.id;\n  $('asktxt').innerHTML=`Limite atteinte sur <b>${esc(src.p)} · ${esc(src.n)}</b>. Reprendre la conversation sur <b>${esc(dst.p)} · ${esc(dst.n)}</b> ?`}\n$('askyes').onclick=()=>{const b=$('ask');b.hidden=true;enqueue(()=>handoff(b.dataset.src,{to:b.dataset.dst}))};\n$('askno').onclick=()=>{$('ask').hidden=true};\n\nasync function handoff(fromId,o={}){\n  const R=settings.relay,src=find(fromId||active),now=Date.now();\n  const fail=(msg,silent)=>{hlog('fail',src,msg);HAND.unshift({ts:now,from:src,ok:false,err:msg});\n    if(silent)ping('limit','Limite atteinte',src.p+' · '+src.n,src.id,{toast:true});else ping('handoff','Reprise impossible',msg,src&&src.id,{toast:true});return {ok:false,error:msg}};\n  if(!src)return {ok:false,error:'compte introuvable'};\n  // garde-fous contre les boucles et les doublons (limit-hit se redéclenche à chaque rechargement de page)\n  if(o.auto&&(now-(LASTH[src.id]||0)<300000||now-LASTANY<20000)){hlog('skip',src,'reprise récente : ignorée');return {ok:false,error:'reprise récente'}}\n  let dst=o.to?find(o.to):pickTarget(src);\n  if(!dst)return fail('aucun autre compte disponible'+(R.samePlatform?' sur '+src.p:''));\n  let conv;try{conv=await read(src)}catch(e){return fail('lecture impossible : '+e.message)}\n  const text0=conv.msgs[0]&&conv.msgs[0].t;\n  if(conv.mode==='raw'){\n    if(!text0||!isChatUrl(conv.url))return fail('aucune conversation à reprendre sur '+src.p+' · '+src.n,o.auto);\n    if(o.auto)return fail('conversation non reconnue sur '+src.n+' (sélecteurs à vérifier) : reprise annulée');\n    if(!confirm('Le format de la conversation n\\'est pas reconnu : AI Hub transmettrait le texte brut de la page (avec des éléments d\\'interface). Continuer ?'))return {ok:false,cancelled:true};\n  }\n  const built=await buildHandoff(src,conv,o),visited=[src.id];\n  for(let i=0;i<accs.length&&dst;i++){\n    toast('Reprise : '+src.n+' → '+dst.n+'…');\n    hub.switchTo(dst);await hub.newChat(dst);\n    const w=await waitComposer(dst,25000);\n    if(w===true)await sleep(1500);   // la limite peut s'afficher juste après le chargement\n    if(w!==true||stOf(dst.id).limited||stOf(dst.id).logged===false){\n      hlog('skip',dst,w==='login'||stOf(dst.id).logged===false?'déconnecté':w?'limite atteinte':'page non prête');\n      visited.push(dst.id);dst=o.strict?null:pickTarget(src,visited);continue}\n    let r=await hub.paste(built.text,{account:dst,send:false});\n    if(!r.len){await sleep(1200);r=await hub.paste(built.text,{account:dst,send:false})}\n    if(!r.len){await api.copy(built.text);return fail('collage impossible sur '+dst.n+' : le message est copié dans le presse-papiers (Ctrl+V)')}\n    const send=o.send??R.send;if(send){await sleep(500);await hub.send(dst.id)}\n    LASTH[src.id]=Date.now();LASTANY=Date.now();\n    HAND.unshift({ts:Date.now(),from:src,to:dst,how:built.how,chars:built.chars,sent:!!send,ok:true});if(HAND.length>20)HAND.pop();\n    hlog('ok',src,{to:dst.p+' · '+dst.n,mode:built.how,chars:built.chars,sent:!!send});\n    ping('handoff','Reprise sur '+dst.p+' · '+dst.n,send?'Message envoyé ('+built.how+').':'Message prêt dans la zone de saisie : relis-le et valide.',dst.id,{toast:true});\n    if(setOpen&&tab==='rel')drawRel();\n    return {ok:true,to:pub(dst),mode:built.how,chars:built.chars,n:conv.msgs.length};\n  }\n  return fail('aucun compte disponible : '+(accs.length>1?'tous sont limités, déconnectés ou non prêts':'ajoute un autre compte'));\n}\n// fenêtre « Reprendre ailleurs » (manuel)\n$('handoff').onclick=()=>{const a=find(active);if(!a)return toast('Sélectionne un compte d\\'abord');\n  const others=accs.filter(x=>x.id!==a.id);if(!others.length)return toast('Ajoute un autre compte pour reprendre la conversation.');\n  const sorted=[...others].sort((x,y)=>(x.p===a.p?0:1)-(y.p===a.p?0:1)||(stOf(x.id).limited?1:0)-(stOf(y.id).limited?1:0));\n  $('hsrc').textContent='Depuis '+a.p+' · '+a.n;\n  $('hto').innerHTML=sorted.map(x=>`<option value=\"${x.id}\">${esc(x.p)} · ${esc(x.n)}${stOf(x.id).limited?' (limite atteinte)':''}${stOf(x.id).logged===false?' (déconnecté)':''}</option>`).join('');\n  $('hmode').value=settings.relay.summary&&hub.aiEnabled?'sum':'full';$('hsend').checked=!!settings.relay.send;\n  $('dlgH').dataset.src=a.id;$('dlgH').showModal()};\n$('hcancel').onclick=()=>$('dlgH').close();\n$('hok').onclick=()=>{const d=$('dlgH');d.close();\n  enqueue(()=>handoff(d.dataset.src,{to:$('hto').value,strict:true,send:$('hsend').checked,summary:$('hmode').value==='sum'})).then(r=>{if(!r.ok&&!r.cancelled&&r.error&&!/^reprise récente/.test(r.error))toast('Reprise impossible : '+r.error)}).catch(x=>toast('Reprise impossible : '+(x&&x.message||x)))};\n\n// ---------- API pour ton code (mode développeur) ----------\nconst hub={\n  get accounts(){return accs.map(pub)},get active(){return pub(find(active))},\n  state:id=>st[(find(id||active)||{}).id],\n  switchTo(x){const a=find(x);if(!a)return null;active=a.id;setOpen=false;save();render();return pub(a)},\n  available(o={}){const f=find(o.from||active);return pub(accs.find(a=>a.id!==(f&&f.id)&&!stOf(a.id).limited&&(!o.samePlatform||a.p===(f&&f.p))))||null},\n  next(o={}){const n=accs.length,i=accs.findIndex(a=>a.id===active),d=o.dir||1,cur=find(active);\n    for(let k=1;k<=n;k++){const a=accs[(((i+k*d)%n)+n)%n];\n      if(a.id!==active&&(o.skipLimited===false||!stOf(a.id).limited)&&(!o.samePlatform||a.p===cur?.p))return hub.switchTo(a)}return null},\n  async getConversation(x){const a=find(x||active);const r=a&&await exportPack(a);return r&&r.txt},\n  async exportConversation(x){const t=await hub.getConversation(x);if(t){await api.copy(t);toast('Conversation copiée')}return t},\n  async newChat(x){const a=find(x||active),v=view(a);\n    if(!v._ready)await Promise.race([new Promise(r=>v.addEventListener('dom-ready',r,{once:true})),sleep(15000)]);\n    v.loadURL(P[a.p][0]);await new Promise(r=>{v.addEventListener('did-stop-loading',r,{once:true});setTimeout(r,15000)})},\n  async paste(text,o={}){const a=find(o.account||active),v=view(a),C=JSON.stringify(okSel(a,'comp'));\n    if(!v._ready)await Promise.race([new Promise(r=>v.addEventListener('dom-ready',r,{once:true})),sleep(15000)]);\n    const pick=`(()=>{const l=[...document.querySelectorAll(${C})];return l.find(e=>e.getClientRects().length>0)||l[0]||document.querySelector(${JSON.stringify(COMPOSER)})})()`;\n    await v.executeJavaScript(`(()=>{const c=${pick};if(c)c.focus()})()`);\n    await sleep(250);v.insertText(text);await sleep(300);\n    const len=await v.executeJavaScript(`(()=>{const c=${pick};return c?(c.value||c.innerText||'').trim().length:0})()`);\n    if(o.send){await sleep(600);await hub.send(a.id)}\n    return {len}},\n  async send(x){const v=view(find(x||active));await sleep(100);\n    v.sendInputEvent({type:'keyDown',keyCode:'Enter'});v.sendInputEvent({type:'char',keyCode:'\\r'});v.sendInputEvent({type:'keyUp',keyCode:'Enter'})},\n  async getMessages(x){const a=find(x||active);if(!a)return null;const r=await read(a);\n    return r.msgs[0]&&r.msgs[0].t?{mode:r.mode,msgs:r.msgs.map(m=>({r:m.r,t:m.t}))}:null},\n  async health(x){const a=find(x||active);if(!a)return null;const v=view(a);\n    const r=await v.executeJavaScript(`(()=>{const q=s=>{try{return document.querySelectorAll(s).length}catch{return -1}};\n      let c;try{c=document.querySelector(${JSON.stringify(selOf(a.p,'comp'))})}catch{}\n      return {url:location.href,composer:q(${JSON.stringify(selOf(a.p,'comp'))}),user:q(${JSON.stringify(selOf(a.p,'user'))}),ai:q(${JSON.stringify(selOf(a.p,'ai'))}),stop:q(${JSON.stringify(selOf(a.p,'stop'))}),send:q(${JSON.stringify(selOf(a.p,'send'))}),composerLen:c?(c.value||c.innerText||'').trim().length:0}})()`);\n    return {...r,account:pub(a),mode:r.user>0&&r.ai>0?'structured':r.user+r.ai>0?'partial':'none'}},\n  get aiEnabled(){return !!(settings.gemini&&settings.gemini.key)},\n  // Résumé par Gemini ; renvoie null (jamais d'exception) si pas de clé ou en cas d'échec\n  async summarize(text,o={}){\n    const g=settings.gemini||{};if(!g.key)return null;\n    const body=String(text).slice(-(o.max||350000));\n    const sys='Tu prépares le transfert d\\'une conversation vers un autre compte de la même IA. Tu produis un résumé fidèle, dense et directement exploitable. Tu n\\'inventes rien : si une information est absente, tu écris « aucun ».';\n    const prompt=`Voici une conversation entre un utilisateur et une IA (${o.platform||'IA'}). Écris le résumé dans la langue de la conversation, en Markdown, 700 mots maximum, avec exactement ces sections :\n## Objectif et contexte\n## Où on en est (fait / en cours)\n## Décisions, contraintes et préférences de l'utilisateur (formats, style, ce qui a été refusé)\n## Éléments techniques précis (noms de fichiers, fonctions, valeurs, versions : garde les identifiants exacts ; ne recopie pas de longs blocs de code, décris leur rôle)\n## Problèmes ouverts et erreurs\n## Prochaine étape (la dernière demande de l'utilisateur, et si la dernière réponse de l'IA est terminée ou semble coupée)\n${o.extra?o.extra+'\\n':''}\n=== CONVERSATION ===\n${body}\n=== FIN ===`;\n    try{const r=await api.gemini({key:g.key,model:g.model||GEM,system:sys,prompt});\n      if(!r.ok){LOG.unshift({ts:Date.now(),acc:'code',type:'summary-error',detail:r.error});return null}\n      return r.text}\n    catch(e){LOG.unshift({ts:Date.now(),acc:'code',type:'summary-error',detail:String(e&&e.message||e)});return null}},\n  handoff:(from,o)=>enqueue(()=>handoff(from,{...o,auto:false})),\n  async continueOn(t,o={}){const r=await hub.handoff(o.from||active,{to:t,send:o.send});if(!r.ok)throw new Error(r.error);return r.n},   // ancien nom, conservé\n  runInPage:(js,x)=>view(find(x||active)).executeJavaScript(js),\n  reload(x){const a=find(x||active);if(a)view(a).reload()},\n  notify(m,o={}){toast(m);if(settings.notif.enabled===true&&!document.hasFocus())api.notify(o.title||'AI Hub',String(m),null).catch(()=>{})},\n  copy:t=>api.copy(t),\n  log(...a){LOG.unshift({ts:Date.now(),acc:'code',type:'log',detail:a.join(' ')})},\n  setLimited(x,v=true){const a=find(x);if(a){stOf(a.id).limited=!!v;renderList()}},\n  rename(x,n){const a=find(x);if(a){a.n=String(n);save();renderList()}},\n  store:{get:k=>store[k]??null,set:(k,v)=>{store[k]=v;save()}}\n};\nfunction loadCode(){\n  for(const k in H)delete H[k];\n  if(!settings.devMode)return 'désactivé';\n  const on=(t,fn)=>{(H[t]??=[]).push(fn);return()=>{H[t]=H[t].filter(f=>f!==fn)}};\n  const once=(t,fn)=>{const off=on(t,e=>{off();return fn(e)});return off};\n  try{new Function('hub','on','once','sleep',`return (async()=>{${userCode}\\n})()`)(hub,on,once,sleep).catch(codeErr);return'ok'}\n  catch(x){codeErr(x);return'Erreur : '+x.message}\n}\n\n// ---------- paramètres ----------\nfunction selectTab(t){tab=t;\n  document.querySelectorAll('.snav button').forEach(x=>x.classList.toggle('on',x.dataset.t===t));\n  document.querySelectorAll('.pane').forEach(p=>p.classList.toggle('on',p.id==='p-'+t));\n  if(t==='log')drawLog();if(t==='upd')drawUpd();if(t==='rel')drawRel();if(t==='gen')drawNotif()}\ndocument.querySelectorAll('.snav button').forEach(b=>b.onclick=()=>selectTab(b.dataset.t));\n$('gear').onclick=()=>{setOpen=!setOpen;render();if(setOpen)selectTab(tab)};\n$('preall').onchange=e=>{settings.preloadAll=e.target.checked;save();render()};\n\n// mode développeur : sans lui, aucun script perso ni détection perso n'est exécuté\nfunction applyDev(){\n  document.body.classList.toggle('dev',!!settings.devMode);$('dev').checked=!!settings.devMode;\n  const r=loadCode();$('cst').textContent=settings.devMode?(r==='ok'?'Code activé ✔':r):'';\n  if(!settings.devMode&&['code','det','log'].includes(tab)&&setOpen)selectTab('gen');pushCfg()}\n$('dev').onchange=e=>{\n  if(e.target.checked&&!confirm('Le mode développeur exécute du code JavaScript avec un accès complet à tes comptes (conversations, sessions). N\\'active jamais un script dont tu ne comprends pas le contenu, surtout s\\'il vient d\\'un fichier importé.\\n\\nActiver le mode développeur ?')){e.target.checked=false;return}\n  settings.devMode=e.target.checked;save();applyDev();toast(settings.devMode?'Mode développeur activé':'Mode développeur désactivé : les scripts ne s\\'exécutent plus')};\n$('savecode').onclick=()=>{userCode=$('code').value;save();const r=loadCode();$('cst').textContent=r==='ok'?'Code activé ✔':r};\n$('resetcode').onclick=()=>{$('code').value=EXAMPLE};\n$('evlist').innerHTML=EVENTS.map(([n,d])=>`<code>${n}</code><span>${d}</span>`).join('');\n\n// réglages de la reprise\ndocument.querySelectorAll('[data-r]').forEach(el=>el.onchange=()=>{const k=el.dataset.r;\n  settings.relay[k]=el.type==='checkbox'?el.checked:el.type==='number'?Math.min(300000,Math.max(5000,+el.value||60000)):el.value;\n  if(el.type==='number')el.value=settings.relay[k];save()});\nconst tm=t=>new Date(t).toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'});\nfunction drawRel(){\n  document.querySelectorAll('[data-r]').forEach(el=>{const v=settings.relay[el.dataset.r];if(el.type==='checkbox')el.checked=!!v;else el.value=v??''});\n  $('sumnote').textContent=hub.aiEnabled?'Au-delà de 15 000 caractères : résumé + derniers échanges au texte exact.':'Pas de clé Gemini : la conversation est transmise en entier (tronquée si trop longue). Ajoute une clé ci-dessous.';\n  $('hlist').textContent=HAND.length?HAND.slice(0,8).map(h=>h.ok?`${tm(h.ts)}  ${h.from.p} · ${h.from.n} → ${h.to.p} · ${h.to.n}  (${h.how}, ${h.chars} car.${h.sent?', envoyé':''})`:`${tm(h.ts)}  ${h.from?h.from.n:'?'}  ✘ ${h.err}`).join('\\n'):'Aucune reprise pour l\\'instant.'}\n\n// ---------- export / import de comptes ----------\n$('exp').onclick=async()=>{\n  const r=await api.exportAll({state:{accs,active,detectors,settings,code:userCode,store},partitions:accs.map(a=>'persist:'+a.id),pass:$('pass').value});\n  $('msg').textContent=r.ok?`Exporté ${r.encrypted?'(chiffré)':'(NON chiffré, mets un mot de passe)'} : ${r.path}`:'Annulé'};\n$('imp').onclick=async()=>{\n  let r;try{r=await api.importAll($('pass').value)}catch(e){return $('msg').textContent='Fichier illisible : '+e.message}\n  if(!r.ok)return $('msg').textContent=r.error||'Annulé';\n  const s=r.state||{};(s.accs||[]).forEach(x=>{if(!accs.some(a=>a.id===x.id))accs.push(x)});\n  if(!active)active=s.active||null;\n  if(s.detectors&&s.detectors.length&&!detectors.length)detectors=s.detectors;\n  // le code importé est gardé mais ne s'exécute que si TU actives le mode développeur ; on ne remplace pas ton code sans demander\n  if(s.code&&s.code!==userCode&&!isOldExample(s.code)&&confirm('Le fichier contient du code personnalisé. Le remplacer par le tien ? (Il ne s\\'exécutera que si le mode développeur est activé.)'))userCode=s.code;\n  if(s.settings){const m=mergeSettings(s.settings);\n    settings.selectors={...m.selectors,...settings.selectors};\n    if(!settings.gemini.key&&m.gemini.key)settings.gemini=m.gemini;\n    settings.relay={...m.relay,...settings.relay};}                   // devMode et notifications ne sont jamais importés\n  store={...(s.store||{}),...store};\n  save();$('msg').textContent=`Importé : ${(s.accs||[]).length} comptes, ${r.cookies} cookies`+(r.version&&r.version!==r.current?` (fichier créé avec la version ${r.version}, la tienne est ${r.current} : vérifie que tout est là)`:'')+'. Redémarrage…';setTimeout(()=>location.reload(),r.version&&r.version!==r.current?4000:900)};\n\n// ---------- détections personnalisées + journal ----------\nfunction drawDet(){\n  $('dets').innerHTML=detectors.map((d,i)=>`<div class=\"row2\"><input data-i=\"${i}\" data-k=\"name\" value=\"${esc(d.name)}\" placeholder=\"nom de l'événement\"><select data-i=\"${i}\" data-k=\"kind\"><option value=\"selector\"${d.kind==='selector'?' selected':''}>Sélecteur CSS</option><option value=\"text\"${d.kind==='text'?' selected':''}>Texte (regex)</option></select><input data-i=\"${i}\" data-k=\"value\" value=\"${esc(d.value)}\" placeholder=\"ex. .banner-limit  ou  quota épuisé\"><select data-i=\"${i}\" data-k=\"site\"><option value=\"*\">Tous les sites</option>${Object.keys(P).map(k=>`<option${d.site===k?' selected':''}>${k}</option>`).join('')}</select><button class=\"btn\" data-rm=\"${i}\">${IC('x')}</button></div>`).join('')}\n$('dets').oninput=e=>{const{i,k}=e.target.dataset;if(k)detectors[i][k]=e.target.value};\n$('dets').onclick=e=>{const b=e.target.closest('[data-rm]');if(b){detectors.splice(+b.dataset.rm,1);drawDet()}};\n$('adddet').onclick=()=>{detectors.push({name:'mon-evenement',kind:'text',value:'',site:'*'});drawDet()};\n$('savedet').onclick=()=>{save();pushCfg();toast('Détections enregistrées')};\nfunction drawLog(){\n  const f=$('lf').value.toLowerCase();\n  $('logst').innerHTML=accs.map(a=>{const s=stOf(a.id);return `<div>${esc(a.p)} · ${esc(a.n)} : ${s.gen?'répond':'au repos'}${s.limited?' · limite':''}${s.logged===false?' · déconnecté':''} · dernier événement : ${esc(s.last||'aucun')}</div>`}).join('')||'Aucun compte.';\n  $('logl').textContent=LOG.filter(l=>!f||(l.type+l.acc+JSON.stringify(l.detail||'')).toLowerCase().includes(f)).slice(0,200)\n    .map(l=>`${new Date(l.ts).toLocaleTimeString()}  ${l.acc}  ${l.type}  ${l.detail?JSON.stringify(l.detail).slice(0,150):''}`).join('\\n')||'Aucun événement pour l\\'instant.'}\n$('lf').oninput=drawLog;$('logclr').onclick=()=>{LOG.length=0;drawLog()};\n$('logcp').onclick=()=>{api.copy(JSON.stringify(LOG,null,1));toast('Journal copié')};\n\n// ---------- récupération + renommage ----------\nlet renId=null;\n$('rcancel').onclick=()=>$('dlg2').close();\n$('rok').onclick=()=>{const n=$('rname').value.trim();if(n&&renId){find(renId).n=n;save();renderList();if(!setOpen)render()}$('dlg2').close()};\n$('rname').onkeydown=e=>{if(e.key==='Enter')$('rok').click()};\nconst guess=ds=>{for(const k of Object.keys(P)){if(k==='Gemini')continue;const h=new URL(P[k][0]).hostname;if(ds.some(d=>d.includes('.')&&h.endsWith(d)&&!/google\\.com$/.test(d)))return k}\n  return ds.some(d=>/google\\.com$/.test(d))?'Gemini':null};\nasync function recover(auto){\n  let n=0;\n  for(const o of await api.orphans(accs.map(a=>a.id))){const p=guess(o.domains);if(!p)continue;\n    accs.push({id:o.id,p,n:`${p} récupéré ${accs.filter(a=>a.p===p).length+1}`});n++}\n  if(n){save();toast(`${n} compte(s) retrouvé(s) : renomme-les avec le crayon`)}else if(!auto)toast('Aucun compte perdu à retrouver');\n  return n}\n$('recover').onclick=async()=>{await recover(false);render()};\n$('opendata').onclick=()=>api.openData();\n\n// ---------- Gemini ----------\n$('gkey').onchange=()=>{settings.gemini.key=$('gkey').value.trim();save();drawRel();$('gmsg').textContent=settings.gemini.key?'Clé enregistrée.':'Clé supprimée : la conversation sera transmise en entier.'};\n$('gmodel').onchange=()=>{settings.gemini.model=$('gmodel').value.trim()||GEM;$('gmodel').value=settings.gemini.model;save()};\n$('gtest').onclick=async()=>{\n  settings.gemini.key=$('gkey').value.trim();settings.gemini.model=$('gmodel').value.trim()||GEM;save();drawRel();\n  if(!settings.gemini.key)return $('gmsg').textContent='Entre une clé d\\'abord.';\n  $('gmsg').textContent='Test en cours…';\n  const r=await api.gemini({key:settings.gemini.key,model:settings.gemini.model,prompt:'Réponds uniquement par le mot OK.'});\n  $('gmsg').textContent=r.ok?'✔ Gemini répond ('+settings.gemini.model+').':'✘ '+r.error+(r.status===404?' — essaie un autre nom de modèle (ex. gemini-3.5-flash).':'')};\n\n// ---------- sélecteurs de secours + diagnostic ----------\nconst SELK=['user','ai','comp','stop','send'];\n$('selplat').innerHTML=Object.keys(P).map(k=>`<option>${k}</option>`).join('');\nfunction fillSel(){const c=(settings.selectors||{})[$('selplat').value]||{};SELK.forEach(k=>$('sel-'+k).value=c[k]||'')}\n$('selplat').onchange=fillSel;\n$('selsave').onclick=()=>{const c={};SELK.forEach(k=>{const v=$('sel-'+k).value.trim();if(v)c[k]=v});\n  settings.selectors[$('selplat').value]=c;save();pushCfg();Object.values(st).forEach(x=>x.degraded=false);toast('Sélecteurs enregistrés pour '+$('selplat').value)};\n$('diag').onclick=async()=>{\n  const o=$('diagout');o.style.display='block';o.textContent='Analyse…';const lines=[];\n  for(const a of accs){\n    if(!document.querySelector(`webview[data-id=\"${a.id}\"]`)){lines.push(`${a.p} · ${a.n} : non chargé (clique dessus ou active « Garder tous les comptes chargés »)`);continue}\n    try{const h=await hub.health(a.id);\n      lines.push(`${h.composer>0?'✔':'✘'} ${a.p} · ${a.n} : saisie ${h.composer}, tes messages ${h.user}, réponses IA ${h.ai}, stop ${h.stop}, envoyer ${h.send} → ${h.mode==='structured'?'conversation lue':h.mode==='partial'?'lecture partielle ⚠':h.user+h.ai===0?'aucun message à lire (normal sur un nouveau chat)':'à vérifier ⚠'}`)}\n    catch(e){lines.push(`✘ ${a.p} · ${a.n} : ${e.message}`)}}\n  o.textContent=lines.join('\\n')||'Aucun compte.'};\n\n// ---------- mises à jour ----------\nconst dt=t=>t?new Date(t).toLocaleString():'';\nasync function drawUpd(){\n  const i=await api.updInfo();\n  $('upinfo').innerHTML=`Lanceur : <b>${esc(i.launcherVersion)}</b> · version active : <b>${esc(i.active==='bundled'?'d\\'origine ('+i.launcherVersion+')':i.active)}</b>`\n    +(i.pending?` · <span class=\"warn\">en essai (pas encore confirmée)</span>`:'')+(i.rolledBack?`<br><span class=\"warn\">Une mise à jour a été annulée automatiquement : ${esc(i.rolledBack)}</span>`:'');\n  $('upvers').textContent=i.versions.length?i.versions.map(v=>`${v.version}${v.version===i.current?'  (active)':v.version===i.previous?'  (précédente)':''}${v.ok?'':'  ⚠ fichiers invalides'}${i.bad.includes(v.version)?'  ✘ annulée':''}  ${v.notes?'— '+v.notes:''}`).join('\\n'):'Aucune mise à jour installée : version d\\'origine.';\n  $('uphist').textContent=i.history.map(h=>`${dt(h.ts)}  ${h.action}  ${h.version}  ${h.detail||''}`).join('\\n')||'—'}\n$('upapply').onclick=async()=>{\n  const r=await api.updApply();if(r.cancelled)return;\n  if(!r.ok){$('upmsg').textContent='✘ '+r.error;return}\n  $('upmsg').textContent=`✔ Version ${r.version} installée${r.notes?' : '+r.notes:''}.`;drawUpd();\n  if(confirm(`Version ${r.version} installée. Redémarrer maintenant pour l'essayer ?\\n(Si elle ne démarre pas correctement, l'app revient toute seule à la version précédente.)`))api.relaunch()};\nconst revert=async to=>{const r=await api.updRevert(to);if(!r.ok){$('upmsg').textContent='✘ '+r.error;return}\n  $('upmsg').textContent='Retour à '+(r.version==='bundled'?'la version d\\'origine':r.version)+'. Redémarrage…';setTimeout(()=>api.relaunch(),600)};\n$('uprev').onclick=()=>revert('previous');\n$('uporig').onclick=()=>{if(confirm('Revenir à la version d\\'origine fournie avec l\\'exe ? (tes comptes et ton code sont conservés)'))revert('bundled')};\n\n// ---------- démarrage ----------\n// Santé : l'app confirme qu'elle fonctionne ; sinon, retour arrière automatique (si une mise à jour est en essai)\nasync function init(){\n  let s=await api.stateLoad();\n  if(!s)s={accs:LS('accs',[]),active:localStorage.act||null,detectors:LS('det',[]),settings:LS('set',{}),code:localStorage.code||EXAMPLE,store:{}};\n  const upgraded=!s.v||s.v<3;\n  accs=s.accs||[];active=s.active||null;detectors=s.detectors||[];settings=mergeSettings(s.settings);\n  userCode=s.code||EXAMPLE;store=s.store||{};\n  let migrated=false;\n  if(isOldExample(userCode))userCode=EXAMPLE;                                     // ancien exemple non modifié : remplacé\n  else if(upgraded&&userCode.trim()&&userCode!==EXAMPLE&&!settings.devMode)migrated=true; // ton code est conservé, mais désactivé tant que le mode développeur est coupé\n  $('preall').checked=!!settings.preloadAll;$('code').value=userCode;$('gkey').value=settings.gemini.key;$('gmodel').value=settings.gemini.model;\n  fillSel();drawDet();applyTheme();drawNotif();drawRel();\n  PRE=await api.wvpreload();ready=true;\n  await recover(true);\n  if(!find(active))active=accs[0]?.id||null;\n  save();render();applyDev();\n  api.updInfo().then(i=>{if(i.rolledBack){toast('Mise à jour annulée automatiquement : '+i.rolledBack);LOG.unshift({ts:Date.now(),acc:'app',type:'update-rollback',detail:i.rolledBack})}}).catch(()=>{});\n  setTimeout(()=>{window.__healthy=true;api.updHealthy()},3000);\n  if(migrated)setTimeout(()=>toast('Tes scripts sont conservés dans Paramètres > Général > Mode développeur (désactivé). La reprise sur un autre compte est maintenant intégrée.'),2400);\n  setTimeout(()=>{if(settings.notif.enabled===null&&!$('dlgH').open&&!$('dlg').open)$('dlgN').showModal()},3200);   // demande d'autorisation des notifications\n}\nconst T0=performance.now();\ninit().catch(e=>{toast('Erreur au démarrage : '+e.message);api.updFail(e.message)}).finally(()=>setTimeout(()=>{$('splash').classList.add('out');setTimeout(()=>$('splash').remove(),600)},Math.max(0,1700-(performance.now()-T0))));\n</script></body></html>\n"}}}