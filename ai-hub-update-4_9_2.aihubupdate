-dim);background:none;border:0;border-radius:7px;padding:4px 8px;cursor:pointer;white-space:nowrap}\n#tr button:hover{background:var(--sel);color:var(--txt)}\n#views.solo #chat{display:none!important}#views.solo #editor{right:0}#views.solo #chsplit{display:none}\n#views.split #ch-hint{display:none}\n#tabs .tb.gone .tn{text-decoration:line-through;opacity:.6}\n#ed-h{flex-wrap:nowrap}#ed-h .stl{flex:none;white-space:nowrap}#ed-pos{flex:none;font-size:11.5px;white-space:nowrap}\n#ed-h .eb{font:inherit;font-size:12px;white-space:nowrap;flex:none;color:var(--txt);background:var(--soft);border:1px solid var(--line);border-radius:8px;padding:3px 10px;cursor:pointer;display:inline-block;height:auto;min-width:0}\n#ed-h .eb:hover{border-color:var(--acc)}\n#ed-h .eb.pri{background:var(--txt);color:var(--bg);border-color:var(--txt)}\n#ed-h .eb[hidden],#ed-h .stl[hidden]{display:none}\n</style>\n<script>\n/* 3.8.1 — Un projet = un dossier. Explorateur, onglets + éditeur, chat à droite, Ctrl+P, recherche dans le projet. */\n(function(){try{\nconst H=window.hub260;if(!H||!window.api||!api.projTree)return;\nconst S={tabs:{},act:{},tree:{},open:{},chg:{},snap:{},sub:{},hv:{},q:'',mode:'name',hits:null,ex:true,last:null,shown:''};\nconst pid=()=>H.cur(),P=()=>H.P0(pid()),root=()=>{const p=P();return p&&p.local&&p.local.path||''};\nconst tabsOf=()=>S.tabs[pid()]||(S.tabs[pid()]=[]),actOf=()=>S.act[pid()]||'chat',cur=()=>tabsOf().find(t=>t.rel===actOf())||null;\nconst base=r=>r.split('/').pop(),extOf=r=>{const m=/\\.([A-Za-z0-9]+)$/.exec(r);return m?m[1].toLowerCase():''};\nconst col=e=>{let h=0;for(const c of e)h=(h*31+c.charCodeAt(0))%360;return e?`hsl(${h} 45% 46%)`:'#7a7f87'};\nconst vis=()=>{const p=P();return !!(p&&H.showChat())};\n\n// ---------- squelette (créé une fois) ----------\nconst ex=document.createElement('div');ex.id='explorer';ex.hidden=true;\nex.innerHTML=`<div class=\"xh\"><b id=\"xt\">Fichiers du projet</b><button id=\"xnf\" title=\"Nouveau fichier (termine par / pour créer un dossier)\">${IC('plus')}</button><button id=\"xrf\" title=\"Actualiser\">${IC('refresh')}</button></div>\n<div class=\"xs\"><input id=\"xq\" placeholder=\"Rechercher…  (Entrée : dans le texte)\" spellcheck=\"false\"></div><div id=\"xtree\"></div>`;\n$('plist').after(ex);\nconst aside=document.querySelector('aside'),main=document.querySelector('main'),views=$('views');\nconst asp=document.createElement('div');asp.id='asplit';aside.appendChild(asp);\nconst tabs=document.createElement('div');tabs.id='tabs';tabs.hidden=true;tabs.innerHTML='<div id=\"tl\"></div><div id=\"tr\"><button id=\"tchat\"></button></div>';main.insertBefore(tabs,views);\nconst ed=document.createElement('section');ed.id='editor';\ned.innerHTML=`<div id=\"ed-h\"><span class=\"pth\" id=\"ed-p\"></span><span id=\"ed-pos\"></span><span class=\"stl\" id=\"ed-s\" hidden>Modifié sur le disque</span><button class=\"eb\" id=\"ed-rl\" hidden>Recharger</button><button class=\"eb\" id=\"ed-at\" title=\"Ajouter au chat (Ctrl+L)\">@ chat</button><button class=\"eb pri\" id=\"ed-sv\" title=\"Enregistrer (Ctrl+S)\" hidden>Enregistrer</button></div><div id=\"ed-b\"></div>`;\nviews.appendChild(ed);\nconst chs=document.createElement('div');chs.id='chsplit';views.appendChild(chs);\nconst qo=document.createElement('div');qo.id='qo';qo.hidden=true;qo.innerHTML='<div class=\"qb\"><input id=\"qi\" spellcheck=\"false\" autocomplete=\"off\"><div id=\"ql\"></div><div class=\"qh\">Entrée ouvrir · ↑↓ choisir · Échap fermer · tape &gt; pour les commandes</div></div>';document.body.appendChild(qo);\nconst xd=document.createElement('dialog');xd.id='xdlg';xd.innerHTML='<h3 id=\"xdt\"></h3><input id=\"xdi\" spellcheck=\"false\"><div class=\"row2\"><button class=\"btn\" id=\"xdc\">Annuler</button><button class=\"btn pri\" id=\"xdo\">OK</button></div>';document.body.appendChild(xd);\nconst askName=(t,v)=>new Promise(ok=>{$('xdt').textContent=t;$('xdi').value=v||'';let done=false;const fin=x=>{if(done)return;done=true;xd.close();ok(x)};\n  $('xdo').onclick=()=>fin($('xdi').value.trim());$('xdc').onclick=()=>fin(null);xd.oncancel=()=>fin(null);$('xdi').onkeydown=e=>{if(e.key==='Enter')fin($('xdi').value.trim())};xd.showModal();$('xdi').focus();$('xdi').select()});\n\n// ---------- tailles réglables ----------\nconst rs=(h,vr,min,max,fromRight,box)=>{h.onmousedown=e=>{e.preventDefault();h.classList.add('drag');const mv=ev=>{const r=box.getBoundingClientRect(),w=fromRight?r.right-ev.clientX:ev.clientX-r.left;\n    document.documentElement.style.setProperty(vr,Math.max(min,Math.min(max(),w))+'px')},up=()=>{h.classList.remove('drag');document.removeEventListener('mousemove',mv);document.removeEventListener('mouseup',up);\n    try{localStorage['hub'+vr]=getComputedStyle(document.documentElement).getPropertyValue(vr).trim()}catch{}};document.addEventListener('mousemove',mv);document.addEventListener('mouseup',up)}};\ntry{['--aw','--cw'].forEach(v=>{if(localStorage['hub'+v])document.documentElement.style.setProperty(v,localStorage['hub'+v])})}catch{}\nrs(asp,'--aw',200,()=>420,false,aside);rs(chs,'--cw',320,()=>Math.max(380,views.clientWidth-320),true,views);\nasp.ondblclick=()=>{document.documentElement.style.removeProperty('--aw');try{localStorage['hub--aw']=''}catch{}};chs.ondblclick=()=>{document.documentElement.style.removeProperty('--cw');try{localStorage['hub--cw']=''}catch{}};\n\n// ---------- arbre ----------\nconst openSet=()=>S.open[pid()]||(S.open[pid()]=new Set());\nconst subOf=id=>S.sub[id]||(S.sub[id]={}),hvOf=id=>S.hv[id]||(S.hv[id]=new Set());\nconst srt=a=>a;  // le tri est fait côté Windows (dossiers d'abord, puis nom)\nasync function loadSub(id,rel){const res=await api.projList({root:root(),rel});if(pid()!==id)return false;\n  if(res&&res.ok){subOf(id)[rel]=res.items;res.items.forEach(x=>{if(x.d)hvOf(id).add(x.p)});return true}delete subOf(id)[rel];return false}\nfunction flat(id,items){const sub=subOf(id),o=S.open[id]||new Set(),out=[];const add=a=>{for(const x of a){out.push(x);if(x.d&&x.h&&o.has(x.p)&&sub[x.p])add(sub[x.p])}};add(items);return out}\nasync function loadTree(quiet){const r=root();if(!r)return;const id=pid();\n  try{api.projWatch&&api.projWatch({root:r})}catch{}\n  const res=await api.projTree({root:r});if(pid()!==id)return;\n  if(!res||!res.ok){S.tree[id]={items:[],err:true};drawEx();return}\n  const hv=S.hv[id]=new Set(res.items.filter(x=>x.d&&x.h).map(x=>x.p));\n  const o=S.open[id]||new Set(),q=[...o].filter(p=>hv.has(p));\n  while(q.length){const p=q.shift();if(await loadSub(id,p)){(subOf(id)[p]||[]).forEach(x=>{if(x.d&&o.has(x.p))q.push(x.p)})}else o.delete(p)}\n  if(pid()!==id)return;\n  const all=flat(id,res.items),prev=S.snap[id],now={};all.forEach(x=>{if(!x.d)now[x.p]=x.s+':'+x.m});\n  const c=S.chg[id]||(S.chg[id]={});\n  if(prev){for(const p in now)if(prev[p]===undefined||prev[p]!==now[p])c[p]=1}\n  for(const p in c)if(now[p]===undefined&&!res.cut)delete c[p];\n  S.snap[id]=now;const key=all.map(x=>x.p+':'+(x.s||'')+':'+(x.m||'')+(x.h?'h':'')).join('|');\n  if(quiet&&S.tree[id]&&S.tree[id].key===key)return;S.tree[id]={items:res.items,all,cut:res.cut,key};drawEx()}\nfunction fuzzy(q,s){q=q.toLowerCase();s=s.toLowerCase();let i=0,sc=0,last=-2;for(let k=0;k<s.length&&i<q.length;k++)if(s[k]===q[i]){sc+=(k===last+1?3:1);if(k===0||'/._-'.includes(s[k-1]))sc+=3;last=k;i++}return i===q.length?sc-s.length*.02:-1}\nconst rowH=(x,dep,c,extra)=>{const e=extOf(x.p);return `<div class=\"xr${x.d?' d':''}${x.d&&extra==='o'?' o':''}${!x.d&&c[x.p]?' chg':''}${!x.d&&actOf()===x.p?' on':''}\" data-p=\"${esc(x.p)}\" data-d=\"${x.d?1:0}\" style=\"padding-left:${8+dep*14}px\"><i class=\"xc\">${x.d?'▸':''}</i><span class=\"xb\" style=\"--c:${col(e)}\">${x.d?IC('folder'):esc((e||'·').slice(0,4).toUpperCase())}</span><span class=\"xn\">${esc(base(x.p))}</span>${extra==='r'&&x.p.includes('/')?`<span class=\"xd\">${esc(x.p.slice(0,x.p.lastIndexOf('/')))}</span>`:''}<span class=\"xa\"><button data-xa=\"at\" title=\"Mentionner dans le chat\">@</button><button data-xa=\"ren\" title=\"Renommer\">✎</button><button data-xa=\"del\" title=\"Mettre à la corbeille\">×</button></span></div>`};\nfunction drawEx(){const id=pid(),p=P();const el=$('xtree');if(!p){el.innerHTML='';return}\n  const T0=S.tree[id],nf=T0&&(T0.all||T0.items)?(T0.all||T0.items).filter(x=>!x.d).length:0;$('xt').textContent='Fichiers du projet'+(nf?' · '+nf:'');\n  if(!root()){el.innerHTML='<div class=\"xnote\">Un projet = un dossier : ses fichiers sont ceux du dossier. Ce projet n\\'a pas encore de dossier.<br><button class=\"btn pri\" id=\"xpick\">Choisir le dossier</button></div>';return}\n  if(S.hits&&S.q.length>=2){el.innerHTML='<div class=\"xhit back\" data-back=\"1\"><b>← Retour aux fichiers</b></div>'+(S.hits.length?S.hits.map(h=>`<div class=\"xhit\" data-hp=\"${esc(h.p)}\" data-hl=\"${h.l}\"><b>${esc(h.p)} : ${h.l}</b><span>${esc(h.t)}</span></div>`).join(''):'<div class=\"xnote\">Aucun résultat dans le texte des fichiers.</div>');return}\n  const T=T0;if(!T){el.innerHTML='<div class=\"xnote\">Chargement…</div>';return}\n  if(T.err){el.innerHTML='<div class=\"xnote\">Dossier introuvable. Il a peut-être été déplacé ou supprimé.<br><button class=\"btn\" id=\"xpick\">Choisir un autre dossier</button></div>';return}\n  const q=S.q.trim().toLowerCase(),o=openSet(),c=S.chg[id]||{};let items=q?T.items:(T.all||T.items),rows=[];\n  if(q){const keep=new Set();items.forEach(x=>{if(!x.d&&x.p.toLowerCase().includes(q)){keep.add(x.p);let a=x.p;while(a.includes('/')){a=a.slice(0,a.lastIndexOf('/'));keep.add(a)}}});items=items.filter(x=>keep.has(x.p));rows.push('<div class=\"xl\">Entrée = chercher aussi dans le texte</div>')}\n  else if(nf>=12){const rec=T.items.filter(x=>!x.d).sort((a,b)=>(b.m||0)-(a.m||0)).slice(0,5);rows.push('<div class=\"xl\">Modifiés récemment</div>'+rec.map(x=>rowH(x,0,c,'r')).join('')+'<div class=\"xl\">Tous les fichiers</div>')}\n  let skip=null;for(const x of items){const dep=x.p.split('/').length-1;if(skip!==null){if(dep>skip)continue;skip=null}\n    const op=q||o.has(x.p);if(x.d&&!op)skip=dep;rows.push(rowH(x,dep,c,x.d&&op?'o':''))}\n  el.innerHTML=rows.join('')||'<div class=\"xnote\">Dossier vide. Demande à l\\'IA de créer des fichiers, ou ajoute-en avec le bouton +.</div>';\n  if(T.cut)el.insertAdjacentHTML('beforeend','<div class=\"xnote\">Liste limitée aux 20 000 premiers éléments (le dossier est plus gros).</div>')}\n$('xtree').onclick=async e=>{\n  if(e.target.id==='xpick'){const p=P();if(p&&await H.pickLocal(p)){S.last=null;sync()}return}\n  if(e.target.closest('[data-back]')){S.hits=null;S.q='';$('xq').value='';return drawEx()}const h=e.target.closest('.xhit');if(h)return openFile(h.dataset.hp,+h.dataset.hl);\n  const r=e.target.closest('.xr');if(!r)return;const rel=r.dataset.p,d=r.dataset.d==='1',b=e.target.closest('[data-xa]');\n  if(b){e.stopPropagation();const a=b.dataset.xa;\n    if(a==='at')return mention('@'+rel);\n    if(a==='ren'){const n=await askName('Renommer',rel);if(!n||n===rel)return;const res=await api.projOp({root:root(),op:'rename',rel,to:n});if(!res.ok)return toast(res.error||'Renommage impossible');\n      tabsOf().forEach(t=>{if(t.rel===rel)t.rel=n;else if(t.rel.startsWith(rel+'/'))t.rel=n+t.rel.slice(rel.length)});if(actOf()===rel)S.act[pid()]=n;{const o=openSet(),mv=[...o].filter(x=>x===rel||x.startsWith(rel+'/'));mv.forEach(x=>{o.delete(x);o.add(n+x.slice(rel.length))})}S.shown='';await loadTree();sync();return}\n    if(a==='del'){if(!confirm(`Mettre « ${rel} » à la corbeille ?`))return;const res=await api.projOp({root:root(),op:'delete',rel});if(!res.ok)return toast(res.error||'Suppression impossible');\n      S.tabs[pid()]=tabsOf().filter(t=>t.rel!==rel&&!t.rel.startsWith(rel+'/'));if(!cur()&&actOf()!=='chat')S.act[pid()]='chat';await loadTree();sync();return}}\n  if(d){const o=openSet(),id=pid();if(o.has(rel))o.delete(rel);else{o.add(rel);if(hvOf(id).has(rel)&&!subOf(id)[rel]){await loadSub(id,rel);const T=S.tree[id];if(T)T.all=flat(id,T.items)}}drawEx()}else openFile(rel)};\n$('xnf').onclick=async()=>{if(!root())return;const n=await askName('Nouveau fichier ou dossier (termine par / pour un dossier)','');if(!n)return;\n  if(n.endsWith('/')){const d=n.replace(/\\/+$/,'');const res=await api.projOp({root:root(),op:'mkdir',rel:d});if(!res.ok)return toast(res.error||'Création impossible');openSet().add(d);return loadTree()}\n  const res=await api.projSave({root:root(),rel:n,text:'',force:true});if(!res.ok)return toast(res.error||'Création impossible');await loadTree();openFile(n)};\n$('xrf').onclick=()=>{loadTree();checkDisk();toast('Explorateur actualisé')};\n$('xq').oninput=e=>{S.q=e.target.value;S.hits=null;drawEx()};\n$('xq').onkeydown=async e=>{if(e.key==='Enter'&&S.q.trim().length>=2){$('xtree').innerHTML='<div class=\"xnote\">Recherche dans le texte…</div>';const r=await api.projGrep({root:root(),q:S.q.trim()});S.hits=(r&&r.hits)||[];drawEx()}if(e.key==='Escape'){S.q='';$('xq').value='';S.hits=null;drawEx()}};\n\n// ---------- onglets + éditeur ----------\nasync function openFile(rel,line){const r=root();if(!r)return;const L=tabsOf();let t=L.find(x=>x.rel===rel);\n  if(!t){const res=await api.projRead({root:r,rel});if(!res||!res.ok)return toast('Lecture impossible'+(res&&res.error?' : '+res.error:''));\n    t={rel,kind:res.kind,text:res.text||'',orig:res.text||'',mtime:res.mtime,size:res.size,url:res.url,dirty:false};L.push(t)}\n  if(S.chg[pid()])delete S.chg[pid()][rel];S.act[pid()]=rel;if(line)t.goto=line;S.shown='';sync()}\nfunction drawTabs(){const L=tabsOf(),a=actOf();$('tchat').textContent=S.nochat?'Afficher le chat':'Masquer le chat';\n  $('tl').innerHTML=L.map(t=>`<div class=\"tb${a===t.rel?' on':''}${t.dirty?' dirty':''}${t.gone?' gone':''}\" data-t=\"${esc(t.rel)}\" title=\"${esc(t.rel)}\"><span class=\"tn\">${esc(base(t.rel))}</span>${t.dirty?'<i class=\"dot\"></i>':''}<b data-x=\"${esc(t.rel)}\" title=\"Fermer (Ctrl+W)\">×</b></div>`).join('')}\n$('tchat').onclick=()=>{S.nochat=!S.nochat;sync()};\ntabs.onclick=e=>{if(e.target.closest('#tr'))return;const x=e.target.closest('[data-x]');if(x){e.stopPropagation();return closeTab(x.dataset.x)}const t=e.target.closest('[data-t]');if(t){S.act[pid()]=t.dataset.t;if(t.dataset.t==='chat')S.nochat=false;S.shown='';sync()}};\ntabs.onauxclick=e=>{const t=e.target.closest('[data-t]');if(t&&e.button===1&&t.dataset.t!=='chat')closeTab(t.dataset.t)};\nfunction closeTab(rel){const t=tabsOf().find(x=>x.rel===rel);if(!t)return;if(t.dirty&&!confirm(`« ${base(rel)} » a des modifications non enregistrées. Fermer sans enregistrer ?`))return;\n  S.tabs[pid()]=tabsOf().filter(x=>x!==t);if(actOf()===rel){const L=tabsOf();S.act[pid()]=L.length?L[L.length-1].rel:'chat'}S.shown='';sync()}\nconst nl=s=>{let n=1;for(let i=0;i<s.length;i++)if(s.charCodeAt(i)===10)n++;return n};\nfunction gut(){const t=cur(),g=$('egut');if(!t||!g)return;const n=nl(t.text);if(g.dataset.n!=n){g.dataset.n=n;let s='';for(let i=1;i<=n;i++)s+=i+'\\n';g.textContent=s}}\nfunction drawEditor(){const t=cur(),on=vis()&&!!t&&!!root();views.classList.toggle('split',on);views.classList.toggle('solo',on&&!!S.nochat);if(!on)return;\n  $('ed-p').textContent=t.rel;$('ed-sv').hidden=!(t.kind==='text'&&t.dirty);$('ed-at').hidden=t.kind!=='text';$('ed-pos').textContent=t.kind==='text'?(S.pos||''):'';$('ed-s').textContent=t.gone?'Supprimé du disque':'Modifié sur le disque';$('ed-s').hidden=!(t.stale||t.gone);$('ed-rl').hidden=!t.stale||!!t.gone;\n  const key=pid()+'|'+t.rel+'|'+(t.ver||0);if(S.shown===key){gut();return}S.shown=key;const b=$('ed-b');\n  if(t.kind==='text'){b.innerHTML='<pre id=\"egut\"></pre><textarea id=\"ed\" spellcheck=\"false\" wrap=\"off\"></textarea>';const ta=$('ed');ta.value=t.text;gut();\n    ta.oninput=()=>{t.text=ta.value;const d=t.text!==t.orig;if(d!==t.dirty){t.dirty=d;drawTabs();$('ed-sv').hidden=!d}gut();pos()};ta.onscroll=()=>{$('egut').scrollTop=ta.scrollTop};ta.onclick=ta.onkeyup=pos;\n    ta.onkeydown=e=>{if(e.key==='Tab'){e.preventDefault();document.execCommand('insertText',false,'  ')}\n      else if(e.key==='Enter'&&!e.ctrlKey){const v=ta.value,s=ta.selectionStart,ls=v.lastIndexOf('\\n',s-1)+1,ind=/^[ \\t]*/.exec(v.slice(ls,s))[0];e.preventDefault();document.execCommand('insertText',false,'\\n'+ind)}};\n    if(t.goto){const l=t.goto;t.goto=0;let i=0;for(let k=1;k<l;k++){i=t.text.indexOf('\\n',i)+1;if(i===0)break}ta.focus();ta.setSelectionRange(i,i);ta.scrollTop=Math.max(0,(l-6)*20)}}\n  else if(t.kind==='img')b.innerHTML=`<div id=\"ed-o\"><img src=\"${t.url}\" alt=\"\"></div>`;\n  else b.innerHTML=`<div id=\"ed-o\"><div>${t.kind==='big'?'Fichier trop gros pour être affiché':'Fichier binaire, non affichable'} (${Math.round((t.size||0)/1024)} Ko).<br><br><button class=\"btn\" id=\"ed-sh\">Afficher dans le dossier</button></div></div>`;\n  const sh=$('ed-sh');if(sh)sh.onclick=()=>api.projOp({root:root(),op:'show',rel:t.rel})}\nfunction pos(){const ta=$('ed');if(!ta)return;const v=ta.value.slice(0,ta.selectionStart),l=nl(v),c=v.length-v.lastIndexOf('\\n');S.pos=`Ln ${l}, Col ${c}`;const q=$('ed-pos');if(q)q.textContent=S.pos}\nasync function save(t){t=t||cur();if(!t||t.kind!=='text'||!t.dirty)return;let res=await api.projSave({root:root(),rel:t.rel,text:t.text,mtime:t.mtime});\n  if(res&&res.conflict){if(!confirm('Ce fichier a été modifié sur le disque (par l\\'IA ou un autre programme) depuis son ouverture. Écraser avec ta version ?'))return;res=await api.projSave({root:root(),rel:t.rel,text:t.text,force:true})}\n  if(!res||!res.ok)return toast('Enregistrement impossible'+(res&&res.error?' : '+res.error:''));t.orig=t.text;t.dirty=false;t.stale=false;t.mtime=res.mtime;$('ed-sv').hidden=true;toast('Enregistré : '+base(t.rel));drawTabs();drawEditor();\n  if(S.tree[pid()]&&!S.tree[pid()].items.some(x=>x.p===t.rel))loadTree()}\n$('ed-sv').onclick=()=>save();$('ed-at').onclick=()=>mentionSel();\n$('ed-rl').onclick=async()=>{const t=cur();if(!t)return;const r=await api.projRead({root:root(),rel:t.rel});if(r&&r.ok&&r.kind==='text'){t.text=t.orig=r.text;t.mtime=r.mtime;t.dirty=t.stale=false;t.ver=(t.ver||0)+1;S.shown='';sync()}};\nasync function checkDisk(){const r=root();if(!r)return;let ch=false;for(const t of tabsOf()){if(t.kind!=='text')continue;const res=await api.projRead({root:r,rel:t.rel});if(!res||!res.ok){if(!t.gone&&res&&res.error&&/ENOENT|no such file/i.test(res.error)){t.gone=true;ch=true}continue}if(t.gone){t.gone=false;ch=true}if(res.kind!=='text'||res.mtime===t.mtime)continue;\n    if(!t.dirty){const keep=actOf()===t.rel&&$('ed')?{s:$('ed').selectionStart,y:$('ed').scrollTop}:null;t.text=t.orig=res.text;t.mtime=res.mtime;t.ver=(t.ver||0)+1;ch=true;S.shown='';if(keep)setTimeout(()=>{const ta=$('ed');if(ta){ta.setSelectionRange(Math.min(keep.s,ta.value.length),Math.min(keep.s,ta.value.length));ta.scrollTop=keep.y}},0)}\n    else if(!t.stale){t.stale=true;ch=true}}\n  if(ch){drawTabs();drawEditor()}}\n\n// ---------- mentions dans le chat (comme @ / Ctrl+L de Cursor) ----------\nfunction mention(txt){const i=$('ch-in');if(!i)return;S.act[pid()]=actOf();const v=i.value;i.value=v+(v&&!/\\s$/.test(v)?' ':'')+txt+' ';i.dispatchEvent(new Event('input',{bubbles:true}));i.focus();i.setSelectionRange(i.value.length,i.value.length)}\nfunction mentionSel(){const t=cur();if(!t)return;const ta=$('ed');let m='@'+t.rel;if(ta&&ta.selectionStart!==ta.selectionEnd){const a=nl(ta.value.slice(0,ta.selectionStart)),b=nl(ta.value.slice(0,ta.selectionEnd));m+=a===b?` (ligne ${a})`:` (lignes ${a}-${b})`}mention(m)}\n\n// ---------- palette : Ctrl+P (fichiers) / Ctrl+Maj+P (commandes) ----------\nconst menuCmd=k=>{$('ch-mode').click();setTimeout(()=>{const b=document.querySelector('#ch-menu [data-md=\"'+k+'\"]');if(b)b.click()},40)};\nconst CMDS=()=>[\n  {n:'Ouvrir un dossier (nouveau projet)',f:newFolderProject},{n:'Aller au chat en plein écran',f:()=>{S.act[pid()]='chat';S.shown='';sync()}},\n  {n:'Replier / ouvrir la barre latérale (Ctrl+B)',f:()=>{const b=$('sbtog');b&&b.click()}},{n:'Masquer / afficher le chat',f:()=>{S.nochat=!S.nochat;sync()}},{n:'Rechercher dans le projet (Ctrl+Maj+F)',f:()=>searchProj()},\n  {n:'Enregistrer le fichier (Ctrl+S)',f:()=>save()},{n:'Fermer l\\'onglet (Ctrl+W)',f:()=>{const t=cur();if(t)closeTab(t.rel)}},\n  {n:'Actualiser l\\'explorateur',f:()=>$('xrf').click()},{n:'Historique du dossier (annuler des changements)',f:()=>menuCmd('hist')},{n:'Règles du projet',f:()=>menuCmd('rules')},\n  {n:'Annuler le dernier tour de l\\'IA',f:()=>menuCmd('undo')},{n:'Afficher le dossier dans Windows',f:()=>root()&&api.projOp({root:root(),op:'show',rel:''})},\n  {n:'Basculer clair / sombre',f:()=>$('themebtn').click()},{n:'Paramètres',f:()=>$('gear').click()},{n:'Bibliothèque de fichiers (pièces jointes)',f:()=>$('filesbtn').click()}];\nlet QL=[],QI=0;\nfunction qOpen(pre){if(!P())return;qo.hidden=false;$('qi').value=pre||'';qDraw();$('qi').focus()}\nfunction qDraw(){const v=$('qi').value;let L;\n  if(v.startsWith('>')){const q=v.slice(1).trim();L=CMDS().map(c=>({c,s:q?fuzzy(q,c.n):1})).filter(x=>x.s>=0).sort((a,b)=>b.s-a.s).map(x=>({t:x.c.n,f:x.c.f}))}\n  else{const T=(S.tree[pid()]||{items:[]}).items.filter(x=>!x.d);L=(v?T.map(x=>({x,s:Math.max(fuzzy(v,x.p),fuzzy(v,base(x.p))+2)})).filter(y=>y.s>=0).sort((a,b)=>b.s-a.s):T.slice().sort((a,b)=>(S.chg[pid()]||{})[b.p]?1:-1)).slice(0,40).map(y=>{const x=y.x||y;return {t:base(x.p),d:x.p,f:()=>openFile(x.p)}})}\n  QL=L.slice(0,40);QI=Math.min(QI,Math.max(0,QL.length-1));$('ql').innerHTML=QL.map((x,i)=>`<div class=\"qr${i===QI?' on':''}\" data-i=\"${i}\"><span>${esc(x.t)}</span>${x.d?`<em>${esc(x.d)}</em>`:''}</div>`).join('')||'<div class=\"xnote\">Aucun résultat</div>'}\n$('qi').oninput=()=>{QI=0;qDraw()};\n$('qi').onkeydown=e=>{if(e.key==='ArrowDown'){e.preventDefault();QI=Math.min(QL.length-1,QI+1);qDraw();const r=document.querySelector('#ql .on');r&&r.scrollIntoView({block:'nearest'})}\n  else if(e.key==='ArrowUp'){e.preventDefault();QI=Math.max(0,QI-1);qDraw();const r=document.querySelector('#ql .on');r&&r.scrollIntoView({block:'nearest'})}\n  else if(e.key==='Enter'){e.preventDefault();const x=QL[QI];qo.hidden=true;x&&x.f()}else if(e.key==='Escape')qo.hidden=true};\n$('ql').onclick=e=>{const r=e.target.closest('.qr');if(!r)return;const x=QL[+r.dataset.i];qo.hidden=true;x&&x.f()};\nqo.onmousedown=e=>{if(e.target===qo)qo.hidden=true};\nfunction searchProj(){if(!root())return;const b=$('sbtog');if(document.querySelector('aside.min')&&b)b.click();setTimeout(()=>{$('xq').focus();$('xq').select()},50)}\n\n// ---------- un projet = un dossier ----------\nasync function newFolderProject(){const r=await api.localPick();if(!r||!r.ok)return;const dup=PJ().find(q=>q.local&&q.local.path===r.path);\n  if(dup){H.openProject(dup.id);return toast('Ce dossier est déjà le projet « '+dup.name+' »')}\n  const p={id:'p'+Date.now().toString(36),name:r.name,desc:'',mode:'local',local:{path:r.path,name:r.name}};PJ().push(p);save();H.openProject(p.id)}\n['newproj','newproj2'].forEach(id=>{const b=$(id);if(!b)return;b.onclick=newFolderProject;const n=[...b.childNodes].reverse().find(x=>x.nodeType===3&&x.textContent.trim());if(n)n.textContent='Ouvrir un dossier';b.title='Un projet = un dossier de ton PC'});\n{const b=$('filesbtn'),n=b&&[...b.childNodes].find(x=>x.nodeType===3&&/Fichiers/.test(x.textContent));if(n)n.textContent='Bibliothèque';if(b)b.title='Pièces jointes envoyées / reçues (les fichiers d\\'un projet sont ceux de son dossier)'}\n{const g=document.querySelector('.pgrp');if(g)g.textContent='Projets (dossiers)'}\n\n// ---------- synchronisation ----------\nfunction sync(){const p=P(),v=vis();ex.hidden=!v;tabs.hidden=!(v&&root()&&(tabsOf().length||S.nochat));\n  if(pid()!==S.last){S.last=pid();S.q='';S.hits=null;$('xq').value='';S.shown='';if(root())loadTree()}\n  if(!tabs.hidden)drawTabs();drawEx();drawEditor()}\nwindow.hub380={sync,openFile,save,version:'3.8.1'};\nnew MutationObserver(()=>sync()).observe($('chat'),{attributes:true,attributeFilter:['class']});\nlet wasRun=false;new MutationObserver(()=>{const run=!$('ch-stop').hidden;if(wasRun&&!run&&vis()){loadTree(true);checkDisk()}wasRun=run}).observe($('ch-stop'),{attributes:true,attributeFilter:['hidden']});\nsetInterval(()=>{if(vis()&&root()&&document.hasFocus()){loadTree(true);checkDisk()}},5000);\n{const nz=p=>String(p||'').replace(/[\\\\/]+$/,'').replace(/\\//g,'\\\\').toLowerCase();let tm=null;\n if(api.onProj)api.onProj(d=>{if(!root()||!d||nz(d.root)!==nz(root()))return;clearTimeout(tm);tm=setTimeout(()=>{loadTree(true);checkDisk()},60)})}\nwindow.addEventListener('focus',()=>{if(vis()&&root()){loadTree(true);checkDisk()}});\ndocument.addEventListener('keydown',e=>{if(!(e.ctrlKey||e.metaKey)||e.altKey)return;const k=e.key.toLowerCase();\n  if(k==='p'){e.preventDefault();qOpen(e.shiftKey?'>':'')}\n  else if(!vis())return;\n  else if(k==='s'&&cur()){e.preventDefault();save()}\n  else if(k==='w'&&cur()){e.preventDefault();closeTab(cur().rel)}\n  else if(k==='l'&&root()){e.preventDefault();cur()?mentionSel():($('ch-in')&&$('ch-in').focus())}\n  else if(k==='f'&&e.shiftKey&&root()){e.preventDefault();searchProj()}},true);\ntry{if(!localStorage.hub381){localStorage.hub381='1';if(!$('keysbox').classList.contains('min'))$('keystog').click()}}catch{}\nsync();\n}catch(x){console.error('module 3.8.1',x)}})();\n</script>\n<style id=\"css390\">\n/* 3.9.0 — page Fichiers simplifiée : une seule liste, 4 actions par fichier */\n#files.f39 #fwrap{display:block}\n#files.f39 #fprojs,#files.f39 #ftools,#files.f39 #fpedit,#files.f39 #fauto,#files.f39 #ficols,#files.f39 #fhmore,#files.f39 #fhmenu{display:none!important}\n#files.f39 #fgrid{display:flex;flex-direction:column;gap:0}\n#files.f39 .fact{gap:8px}\n.fr9{display:grid;grid-template-columns:22px 40px minmax(0,1fr) auto;align-items:center;gap:12px;min-height:58px;padding:8px 10px;border-bottom:1px solid var(--line);border-radius:8px}\n.fr9:hover{background:var(--hover)}.fr9.sel{background:var(--soft)}\n.fr9 .fk9{display:flex;opacity:0;transition:opacity .12s}\n.fr9:hover .fk9,.fr9.sel .fk9,#fgrid.hassel .fk9{opacity:1}\n.fpv9{width:40px;height:44px;display:grid;place-items:center;border:0;background:none;padding:0;cursor:zoom-in;border-radius:8px;overflow:hidden}\n.fpv9 img{width:40px;height:40px;object-fit:cover;border-radius:8px;background:var(--hover);display:block}\n.fb9{min-width:0;display:flex;flex-direction:column;gap:2px}\n.fn9{font-size:13.5px;font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;cursor:pointer}\n.fm9{font-size:12px;color:var(--dim);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.fa9{display:flex;gap:2px;align-items:center;flex:none}\n.ftr9{padding:16px 10px;color:var(--dim);font-size:12.5px;display:flex;gap:10px;align-items:center;flex-wrap:wrap}\n@media (max-width:760px){.fr9{grid-template-columns:22px 40px minmax(0,1fr)}.fa9{grid-column:2/-1}}\n/* 3.9.0 — page Mises à jour */\n.upcard{border:1px solid var(--line);border-radius:12px;padding:18px 20px;margin:14px 0 18px;background:var(--panel)}\n.upv{display:flex;align-items:baseline;gap:10px}\n.upn{color:var(--dim);font-size:13px}\n.upv b{font:500 30px var(--serif);letter-spacing:-.01em}\n.upbadge{font-size:11.5px;padding:2px 9px;border-radius:99px;background:var(--soft);color:var(--dim)}\n.upbadge.warn{background:color-mix(in srgb,#d98a00 18%,transparent);color:#a86400}\n.upcard .line{margin:14px 0 4px}\n.updet{margin-top:18px}.updet summary{cursor:pointer;color:var(--dim);font-size:13px;padding:4px 0}\n.updet[open] summary{margin-bottom:4px}\n\n</style>\n<script>\n/* 3.9.0 — page Fichiers simplifiée. Les données (FILES, FDB, loadFiles...) ne changent pas : seule l'interface est refaite. */\n(function(){try{\nconst files=$('files');if(!files)throw new Error('page Fichiers introuvable');\nfiles.classList.add('f39');\n// anciens écouteurs (étiquettes, favoris, corbeille, volet de détail...) retirés : on repart d'une liste et d'une barre propres\nconst swap=id=>{const o=$(id);if(!o)return null;const n=o.cloneNode(false);o.replaceWith(n);return n};\nconst g=swap('fgrid'),bar=swap('fselbar');\nconst act=files.querySelector('.fact'),fa=$('fadd'),sc=$('fscanbtn');\nif(act&&fa&&sc)act.insertBefore(sc,fa);                 // « Scanner Claude » reste visible, le reste du menu ⋯ disparaît\nconst sleep9=ms=>new Promise(r=>setTimeout(r,ms));\n\nwindow.drawFiles=function(anim){\n  try{applyFcol()}catch{}\n  fUrls.forEach(u=>URL.revokeObjectURL(u));fUrls=[];fproj='all';ftype='';\n  for(const id of [...SEL])if(!FILES.some(f=>f.id===id))SEL.delete(id);\n  const q=(fq||'').trim().toLowerCase(),list=FILES.filter(f=>matchQ(f,q)),tot=FILES.reduce((s,f)=>s+f.size,0);VIS=list.map(f=>f.id);\n  $('fsub').textContent=FILES.length?`${FILES.length} fichier${FILES.length>1?'s':''} · ${fmtSize(tot)} · disponibles sur tous tes comptes`:'Ta bibliothèque est commune à tous tes comptes.';\n  $('fcount').textContent=FILES.length||'';\n  $('fempty').style.display=FILES.length?'none':'grid';\n  const gr=$('fgrid');gr.classList.toggle('hassel',SEL.size>0);\n  gr.innerHTML=list.map(f=>{\n    let pv;\n    if(iconKind(f)==='image'){const u=URL.createObjectURL(f.blob);fUrls.push(u);pv=`<img src=\"${u}\" alt=\"\">`}else pv=fileTile(f);\n    const d=new Date(f.added).toLocaleDateString('fr-FR',{day:'numeric',month:'short'});\n    const bits=[fileLabel(f),fmtSize(f.size),d];if(f.src)bits.push(f.src.kind==='created'?'Créé par Claude':'Joint');\n    return `<div class=\"fr9${SEL.has(f.id)?' sel':''}\" data-id=\"${f.id}\"><label class=\"fk9\" title=\"Sélectionner (Maj+clic : plage)\"><input type=\"checkbox\" data-s=\"${f.id}\"${SEL.has(f.id)?' checked':''}></label>`\n      +`<button class=\"fpv9\" data-a=\"prev\" title=\"Aperçu\" type=\"button\">${pv}</button>`\n      +`<div class=\"fb9\"><div class=\"fn9\" data-a=\"prev\" title=\"${esc(f.name)}\">${esc(f.name)}</div><div class=\"fm9\">${esc(bits.join(' · '))}</div></div>`\n      +`<div class=\"fa9\"><button class=\"btn sm\" data-a=\"att\" data-att=\"${f.id}\" type=\"button\" title=\"Joindre à une conversation\">${IC('clip')}Joindre</button>`\n      +`<button class=\"btn ghost sm ico\" data-a=\"dl\" type=\"button\" title=\"Télécharger\" aria-label=\"Télécharger\">${IC('dl')}</button>`\n      +`<button class=\"btn ghost sm ico\" data-a=\"rn\" type=\"button\" title=\"Renommer (F2)\" aria-label=\"Renommer\">${IC('edit')}</button>`\n      +`<button class=\"btn ghost sm ico del\" data-a=\"del\" type=\"button\" title=\"Supprimer\" aria-label=\"Supprimer\">${IC('trash')}</button></div></div>`}).join('')\n    +(!list.length&&FILES.length?`<p class=\"dim\" style=\"padding:22px 10px\">Aucun fichier ne correspond à « ${esc(q)} ».</p>`:'')\n    +(TRASH.length?`<div class=\"ftr9\"><span>${TRASH.length} fichier${TRASH.length>1?'s':''} dans l'ancienne corbeille (effacé${TRASH.length>1?'s':''} définitivement après 30 jours)</span><button class=\"btn ghost sm\" data-a=\"restoreall\" type=\"button\">Tout restaurer</button><button class=\"btn ghost sm del\" data-a=\"emptytrash\" type=\"button\">Vider</button></div>`:'');\n  drawSel();try{pushMenu()}catch{}};\n\nwindow.drawSel=function(){const b=$('fselbar');if(!b)return;\n  if(!SEL.size){b.hidden=true;b.innerHTML='';return}\n  const s=SEL.size>1?'s':'';b.hidden=false;\n  b.innerHTML=`<b>${SEL.size} fichier${s} sélectionné${s}</b><button class=\"btn ghost sm\" data-b=\"all\" type=\"button\">Tout sélectionner (${VIS.length})</button><span class=\"sp\"></span>`\n    +`<button class=\"btn sm pri\" data-b=\"att\" data-att=\"*\" type=\"button\">${IC('clip')}Joindre à…</button><button class=\"btn sm\" data-b=\"dl\" type=\"button\">${IC('dl')}Télécharger</button><button class=\"btn ghost sm del\" data-b=\"del\" type=\"button\">${IC('trash')}Supprimer</button><button class=\"btn ghost sm\" data-b=\"none\" type=\"button\">Annuler</button>`};\nwindow.drawProjs=function(){};window.drawTools=function(){};window.drawPEdit=function(){};\n\n// suppression directe, avec confirmation (l'ancienne corbeille n'est plus utilisée)\nwindow.trashIds=async function(ids){ids=ids.filter(id=>FILES.some(f=>f.id===id));if(!ids.length)return;\n  const one=FILES.find(f=>f.id===ids[0]);\n  if(!confirm(ids.length===1?`Supprimer « ${one.name} » de la bibliothèque ?\\n(Les conversations où il a déjà été joint ne changent pas.)`:`Supprimer ces ${ids.length} fichiers de la bibliothèque ?`))return;\n  for(const id of ids){try{if(String(id).startsWith('scan-'))(settings.scanSkip??=[]).push(id);await FDB.del(id)}catch{}SEL.delete(id)}\n  save();await loadFiles(false);toast(ids.length===1?'Fichier supprimé':`${ids.length} fichiers supprimés`)};\nwindow.startRename=function(id){const f=byId(id),el=document.querySelector(`.fr9[data-id=\"${id}\"] .fn9`);if(!f||!el)return;\n  inlineInput(el,'Nom du fichier',v=>v!==f.name&&FDB.put({...f,name:v.slice(0,200)}),f.name)};\n\ng.addEventListener('click',async e=>{const b=e.target.closest('[data-a]');if(!b)return;const a=b.dataset.a;\n  if(a==='restoreall')return restoreIds(TRASH.map(f=>f.id));\n  if(a==='emptytrash')return purgeIds(TRASH.map(f=>f.id),true);\n  const row=b.closest('.fr9'),id=row&&row.dataset.id;if(!id)return;\n  if(a==='att'){$('fmenu').dataset.ids='';openFMenu(b,id)}\n  else if(a==='dl')dlFile(byId(id));\n  else if(a==='rn')startRename(id);\n  else if(a==='del')trashIds([id]);\n  else if(a==='prev')openPrev(id)});\ng.addEventListener('click',e=>{if(e.target.closest('input[data-s]'))shiftNext=e.shiftKey},true);\ng.addEventListener('change',e=>{const c=e.target.closest('input[data-s]');if(!c)return;const id=c.dataset.s;\n  c.checked?SEL.add(id):SEL.delete(id);\n  if(shiftNext&&lastSel&&lastSel!==id){const a=VIS.indexOf(lastSel),b=VIS.indexOf(id);if(a>=0&&b>=0)VIS.slice(Math.min(a,b),Math.max(a,b)+1).forEach(x=>SEL.add(x))}\n  lastSel=id;shiftNext=false;drawFiles(false)});\nbar.addEventListener('click',async e=>{const b=e.target.closest('[data-b]');if(!b)return;const ids=[...SEL];\n  if(b.dataset.b==='all'){VIS.forEach(x=>SEL.add(x));drawFiles(false)}\n  else if(b.dataset.b==='att'){$('fmenu').dataset.ids='';openMulti(b,ids.filter(x=>FILES.some(f=>f.id===x)))}\n  else if(b.dataset.b==='dl'){for(const x of ids){dlFile(byId(x));await sleep9(250)}}\n  else if(b.dataset.b==='del')trashIds(ids);\n  else if(b.dataset.b==='none'){SEL.clear();drawFiles(false)}});\ndrawFiles(false);\n}catch(x){console.error('module 3.9.0 fichiers',x)}})();\n\n</script>\n<style id=\"css400\">\n/* ===== 4.0.0 — refonte totale : un seul système de design pour toutes les interfaces ===== */\n:root{--sans:\"Inter\",\"Segoe UI Variable Text\",\"Segoe UI\",system-ui,-apple-system,Roboto,Helvetica,Arial,sans-serif;--serif:var(--sans);\n--mono:\"Cascadia Code\",Consolas,\"SF Mono\",Menlo,monospace;\n--r1:6px;--r2:10px;--r3:14px;--r4:20px;--ease:cubic-bezier(.2,.8,.2,1);\n--bg:#ffffff;--side:#f7f7f8;--panel:#ffffff;--raised:#f2f2f4;--hover:rgba(20,20,30,.05);--sel:rgba(20,20,30,.085);--soft:rgba(20,20,30,.04);\n--line:#e7e7ea;--line2:#d2d2d8;--txt:#18181b;--dim:#62626b;--acc:#4f5bd5;--btn:#18181b;--btnh:#000;--btntx:#fff;\n--ok:#1f8a5b;--warn:#9a6a0c;--err:#c23d2e;--tbg:#18181b;--ttx:#fff;\n--shadow:0 0 0 1px rgba(0,0,0,.04),0 12px 36px rgba(20,20,40,.14)}\n:root[data-theme=dark]{--bg:#121214;--side:#0d0d0f;--panel:#18181b;--raised:#202024;--hover:rgba(255,255,255,.055);--sel:rgba(255,255,255,.095);--soft:rgba(255,255,255,.045);\n--line:#26262b;--line2:#37373e;--txt:#ececef;--dim:#9a9aa4;--acc:#8b97ff;--btn:#ececef;--btnh:#fff;--btntx:#121214;\n--ok:#5fc08f;--warn:#e0b060;--err:#ef8878;--tbg:#ececef;--ttx:#121214;\n--shadow:0 0 0 1px rgba(255,255,255,.05),0 14px 40px rgba(0,0,0,.6)}\n@media (prefers-color-scheme:dark){:root[data-theme=system]{--bg:#121214;--side:#0d0d0f;--panel:#18181b;--raised:#202024;--hover:rgba(255,255,255,.055);--sel:rgba(255,255,255,.095);--soft:rgba(255,255,255,.045);\n--line:#26262b;--line2:#37373e;--txt:#ececef;--dim:#9a9aa4;--acc:#8b97ff;--btn:#ececef;--btnh:#fff;--btntx:#121214;\n--ok:#5fc08f;--warn:#e0b060;--err:#ef8878;--tbg:#ececef;--ttx:#121214;\n--shadow:0 0 0 1px rgba(255,255,255,.05),0 14px 40px rgba(0,0,0,.6)}}\nhtml,body{background:var(--bg)}\nbody{font:13.5px/1.55 var(--sans);letter-spacing:-.003em;color:var(--txt)}\n::selection{background:color-mix(in srgb,var(--acc) 32%,transparent)}\n::-webkit-scrollbar{width:10px;height:10px}::-webkit-scrollbar-thumb{background:var(--line2);border-radius:10px;border:3px solid transparent;background-clip:content-box}\n:focus-visible{outline:2px solid color-mix(in srgb,var(--acc) 70%,transparent);outline-offset:1px;border-radius:var(--r1)}\ncode{font-family:var(--mono);font-size:12.2px;background:var(--raised);border:1px solid var(--line);padding:1px 6px;border-radius:var(--r1)}\npre{font-family:var(--mono);font-size:12.2px}\n\n/* --- boutons --- */\n.btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:32px;padding:5px 13px;border-radius:var(--r2);border:1px solid var(--line2);background:var(--panel);color:var(--txt);font:500 13px var(--sans);cursor:pointer;transition:background .14s,border-color .14s,color .14s,transform .12s var(--ease),box-shadow .14s}\n.btn:hover:not(:disabled){background:var(--raised);border-color:var(--line2)}\n.btn:active:not(:disabled){transform:scale(.97)}\n.btn:disabled{opacity:.45;cursor:default}\n.btn.pri{background:var(--btn);border-color:transparent;color:var(--btntx);box-shadow:0 1px 2px rgba(0,0,0,.18)}\n.btn.pri:hover:not(:disabled){background:var(--btnh);border-color:transparent}\n.btn.ghost{background:transparent;border-color:transparent;color:var(--dim)}\n.btn.ghost:hover:not(:disabled){background:var(--hover);color:var(--txt);border-color:transparent}\n.btn.sm{min-height:28px;padding:3px 10px;font-size:12.5px;border-radius:var(--r1)}\n.btn.ico,.btn.ic-only{padding:0;width:32px;min-width:32px}.btn.sm.ico{width:28px;min-width:28px}\n.btn.wide{width:100%}.btn.left{justify-content:flex-start}\n.btn.del:hover:not(:disabled){color:var(--err);background:color-mix(in srgb,var(--err) 12%,transparent)}\n.btn .ic{width:16px;height:16px;opacity:.9}\n\n/* --- champs --- */\nselect,input:not([type=checkbox]):not([type=range]):not([type=file]),textarea{font:13px var(--sans);color:var(--txt);background:var(--panel);border:1px solid var(--line2);border-radius:var(--r2);padding:7px 11px;min-height:34px;transition:border-color .14s,box-shadow .14s}\nselect{padding-right:28px}\ntextarea{line-height:1.5}\nselect:hover,input:not([type=checkbox]):hover,textarea:hover{border-color:color-mix(in srgb,var(--txt) 28%,var(--line2))}\nselect:focus,input:not([type=checkbox]):focus,textarea:focus{outline:none;border-color:var(--acc);box-shadow:0 0 0 3px color-mix(in srgb,var(--acc) 22%,transparent)}\n::placeholder{color:var(--dim);opacity:.75}\n.sw{appearance:none;-webkit-appearance:none;position:relative;flex:none;width:36px;height:20px;min-height:0;padding:0;border:0;border-radius:99px;background:var(--line2);cursor:pointer;transition:background .18s}\n.sw::after{content:\"\";position:absolute;top:2px;left:2px;width:16px;height:16px;border-radius:50%;background:#fff;box-shadow:0 1px 3px rgba(0,0,0,.35);transition:transform .2s var(--ease)}\n.sw:checked{background:var(--acc)}.sw:checked::after{transform:translateX(16px);background:#fff}\n.seg{display:inline-flex;padding:3px;gap:2px;background:var(--raised);border:1px solid var(--line);border-radius:var(--r2)}\n.seg button{border:0;background:transparent;color:var(--dim);font:500 12.5px var(--sans);padding:4px 12px;border-radius:7px;cursor:pointer;transition:background .14s,color .14s}\n.seg button:hover{color:var(--txt)}.seg button.on,.seg button[aria-pressed=true]{background:var(--panel);color:var(--txt);box-shadow:0 1px 2px rgba(0,0,0,.2)}\n.pill{display:inline-flex;align-items:center;padding:2px 9px;border-radius:99px;background:var(--raised);border:1px solid var(--line);color:var(--dim);font-size:11.5px;font-weight:500}\n.pill.ok{color:var(--ok);border-color:color-mix(in srgb,var(--ok) 40%,transparent)}.pill.no{color:var(--err);border-color:color-mix(in srgb,var(--err) 40%,transparent)}\n.card{background:var(--panel);border:1px solid var(--line);border-radius:var(--r3);overflow:hidden;margin:8px 0 18px}\n.card.pad{padding:16px 18px}\n.opt{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:14px 18px;border-top:1px solid var(--line)}\n.card>.opt:first-child{border-top:0}\n.opt>span:first-child{display:flex;flex-direction:column;gap:2px;min-width:0}\n.opt b{font-weight:600;font-size:13.5px}.opt small{color:var(--dim);font-size:12.5px;line-height:1.45}\ndetails>summary{cursor:pointer;color:var(--dim);font-size:13px;padding:6px 0;list-style:none}\ndetails>summary::before{content:\"›\";display:inline-block;width:14px;transition:transform .18s}\ndetails[open]>summary::before{transform:rotate(90deg)}details>summary:hover{color:var(--txt)}\n.dim{color:var(--dim)}.warn{color:var(--warn)}\n\n/* --- barre latérale --- */\naside{width:252px;background:var(--side);border-right:1px solid var(--line);padding:12px 10px;gap:6px}\n.brand{gap:8px;padding:2px 4px 8px}\n.brand>svg{color:var(--acc);width:20px;height:20px}\nh1{font:650 14.5px var(--sans);letter-spacing:-.01em}\n#sbtog{border-radius:var(--r1)}\n#newproj{min-height:36px;border-radius:var(--r2);font-weight:600}\n.grp{font:600 10.5px var(--sans);letter-spacing:.07em;text-transform:uppercase;color:var(--dim);padding:14px 10px 4px}\n.acc{min-height:32px;padding:5px 10px;border-radius:var(--r1);gap:9px;color:color-mix(in srgb,var(--txt) 88%,transparent);transition:background .12s}\n.acc:hover{background:var(--hover)}\n.acc.on{background:var(--sel);color:var(--txt);font-weight:550}\n#plist .acc.prj .pic{display:grid;place-items:center;text-decoration:none;color:var(--dim)}\n#plist .acc.prj.on .pic{color:var(--acc)}\n#explorer{margin:6px 0;border:1px solid var(--line);border-radius:var(--r2);background:var(--panel);overflow:hidden}\n#explorer .xh{padding:8px 10px;font-size:11.5px;color:var(--dim);display:flex;align-items:center;gap:4px;border-bottom:1px solid var(--line)}\n#explorer .xh b{flex:1;font-weight:600;letter-spacing:.02em}\n#explorer .xs input{border:0;border-bottom:1px solid var(--line);border-radius:0;background:transparent;width:100%;min-height:30px;font-size:12.5px}\n#explorer .xs input:focus{box-shadow:none}\n#explorer .xnote{padding:12px;color:var(--dim);font-size:12.5px;white-space:normal;line-height:1.5}\n#explorer .xnote .btn{margin-top:10px;width:100%}\n#keysbox{margin-top:auto;border-top:1px solid var(--line);padding-top:6px}\n.keyshead{display:flex;align-items:center;gap:8px;width:100%;padding:7px 10px;border:0;background:transparent;color:var(--dim);font:600 11px var(--sans);letter-spacing:.06em;text-transform:uppercase;border-radius:var(--r1);cursor:pointer}\n.keyshead:hover{background:var(--hover);color:var(--txt)}.keyshead small{text-transform:none;letter-spacing:0;font-weight:400;opacity:.8}\n.keyshead em{font-style:normal;margin-left:auto;min-width:20px;text-align:center;padding:1px 7px;border-radius:99px;background:var(--raised);border:1px solid var(--line);font-size:11px}\n#list .acc .dot{box-shadow:0 0 0 3px color-mix(in srgb,currentColor 0%,transparent)}\naside .foot{display:flex;align-items:center;gap:4px;border-top:1px solid var(--line);padding-top:8px;margin-top:4px}\naside #filesbtn,aside .foot #gear{border-radius:var(--r1);padding:7px 10px;min-height:34px;font-weight:500;color:var(--txt)}\naside #filesbtn.on{background:var(--sel)}\naside #filesbtn .pill{margin-left:auto}\naside.min{width:56px;padding:10px 6px}\n\n/* --- en-tête principal --- */\nmain>header{min-height:48px;padding:0 18px;gap:12px;border-bottom:1px solid var(--line);background:var(--bg)}\n#title{font:600 13.5px var(--sans);letter-spacing:-.01em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0}\n#hright{display:flex;align-items:center;gap:8px;margin-left:auto}\n#q-glob .gi{display:flex;align-items:center;gap:7px;padding:4px 12px;border:1px solid var(--line2);border-radius:99px;background:var(--panel);cursor:pointer;font-size:12.5px;transition:background .14s}\n#q-glob .gi:hover{background:var(--raised)}#q-glob .gi small{color:var(--dim)}\n#hacc{border-radius:var(--r2)}\n/* 4.6.0 : haut à droite, une seule règle finale (avant : 3 blocs se contredisaient → double contour, hauteurs différentes, texte coupé) */\n#hright{display:flex;align-items:center;gap:8px;flex:none;margin-left:auto}\n#q-glob{position:static!important;border:0!important;background:transparent!important;box-shadow:none!important;padding:0!important;height:auto!important;opacity:1!important;color:var(--txt)!important}\n#q-glob .gi{height:30px;box-sizing:border-box;padding:0 12px 0 8px;gap:7px;border:1px solid var(--line2);border-radius:99px;background:var(--panel);white-space:nowrap}\n#q-glob .gi b{font-size:12.5px}#q-glob .gi small{font-size:12px;color:var(--dim);opacity:1}\n#hacc{height:30px;box-sizing:border-box;padding:0 12px;border-radius:99px;white-space:nowrap;gap:7px;border:1px solid var(--line2);background:var(--panel)}\n#hacc:hover,#hacc.open{background:var(--raised)}\n#hacc .hl{max-width:200px}\nmain>header strong{min-width:0;flex:1 1 auto;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n@media (max-width:900px){#hacc .hl,#q-glob .gi small{display:none}}\n/* 4.7.0 : lignes de clés alignées : boutons dans la ligne (plus en position absolue), même largeur partout */\n.acc{display:flex!important;align-items:center;gap:8px}\n.acc>.dot,.acc>i.dot{flex:none}\n.acc>span{flex:1 1 auto;min-width:0}\n.acc b,.acc:hover b{position:static!important;transform:none!important;right:auto!important;top:auto!important;display:inline-flex!important;align-items:center;justify-content:center;flex:none;width:22px;height:22px;padding:0!important;opacity:0;background:transparent;border-radius:6px}\n.acc:hover b,.acc:focus-within b{opacity:1}\n.acc:hover b:hover{background:var(--hover)}\n.acc .qr{flex:none;margin:0!important}\n#empty{background:var(--bg)}\n#empty h2{font:650 26px/1.25 var(--sans);letter-spacing:-.02em;max-width:520px;margin:0 auto 10px}\n#empty p{color:var(--dim);max-width:460px;margin:0 auto 22px;line-height:1.6}\n#empty .ebtns{display:flex;gap:10px;justify-content:center}\n\n/* --- chat --- */\n#ch-top{padding:12px 24px;border-bottom:1px solid var(--line)}\n#ch-name{font:650 15px var(--sans);letter-spacing:-.01em}\n#ch-desc{font-size:12.5px;color:var(--dim)}\n.ch-act{display:flex;align-items:center;gap:4px}\n#ch-msgs{padding:28px 0 12px}\n.m{margin-bottom:22px}\n.m .b{font-size:14px;line-height:1.7}\n.m.u{align-items:flex-end}\n.m.u .b{background:var(--raised);border:1px solid var(--line);padding:10px 15px;border-radius:var(--r3) var(--r3) 4px var(--r3);max-width:86%}\n.m.a .mk{display:flex;align-items:center;gap:8px;font:600 12px var(--sans);color:var(--dim);margin-bottom:6px}\n.m .b p{margin:0 0 .7em}.m .b p:last-child{margin-bottom:0}\n.m .b ol,.m .b ul{padding-left:22px;margin:.4em 0 .8em}\n.m .b pre{background:var(--side);border:1px solid var(--line);border-radius:var(--r2);padding:12px 14px;overflow:auto;margin:.6em 0;line-height:1.55}\n.m .b pre code{background:none;border:0;padding:0}\n.m.s{align-items:center}\n.m.s>span{font-size:12px;color:var(--dim);background:var(--raised);border:1px solid var(--line);border-radius:99px;padding:3px 12px}\n.m.s.warn>span{color:var(--warn);border-color:color-mix(in srgb,var(--warn) 40%,transparent);background:color-mix(in srgb,var(--warn) 9%,transparent)}\n.ch-empty{text-align:center;padding:12vh 0 0}\n.ch-empty h3{font:650 22px var(--sans);letter-spacing:-.02em;margin-bottom:8px}.ch-empty p{color:var(--dim);max-width:460px;margin:0 auto;line-height:1.6}\n#ch-bar{padding:8px 0 22px}\n#ch-box{background:var(--panel);border:1px solid var(--line2);border-radius:var(--r4);padding:10px 12px;box-shadow:0 2px 14px rgba(0,0,0,.14);transition:border-color .15s,box-shadow .15s}\n#ch-box:focus-within{border-color:color-mix(in srgb,var(--acc) 65%,var(--line2));box-shadow:0 0 0 3px color-mix(in srgb,var(--acc) 16%,transparent),0 2px 14px rgba(0,0,0,.14)}\n#ch-box #ch-in,#ch-box #ch-in:focus,#ch-box #ch-in:hover{background:transparent;border:0;box-shadow:none;padding:6px 6px;font-size:14px;line-height:1.55;min-height:44px;max-height:220px}\n#ch-send{border-radius:99px;padding:5px 18px;font-weight:600}\n#ch-stop{border-radius:99px}\n#ch-hint{font-size:11.5px;color:var(--dim);text-align:center;margin-top:8px}\n#ch-chips{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:8px}\n#ch-chips:empty{display:none}\n#ch-chips .fc{display:inline-flex;align-items:center;gap:6px;padding:3px 6px 3px 11px;border-radius:99px;background:var(--raised);border:1px solid var(--line);font-size:12px}\n#ch-chips .fc b{display:grid;place-items:center;width:18px;height:18px;border-radius:50%;cursor:pointer;color:var(--dim)}\n#ch-chips .fc b:hover{background:var(--sel);color:var(--txt)}\n#ch-chips .fc b:empty::before{content:\"×\";font-weight:400;font-size:14px;line-height:1}\n\n/* --- page Fichiers --- */\n#files.fnew{padding:28px clamp(20px,4vw,48px) 56px}\n#files.fnew .fhead{display:flex;align-items:flex-end;justify-content:space-between;gap:18px;flex-wrap:wrap;margin-bottom:20px}\n#files.fnew .fhead h2{font:650 24px var(--sans);letter-spacing:-.02em}\n#files.fnew .fhead p{color:var(--dim);font-size:13px;margin-top:2px}\n#files.fnew .fact{display:flex;align-items:center;gap:8px;flex-wrap:wrap}\n#files.fnew .fsearch{position:relative;display:flex;align-items:center}\n#files.fnew .fsearch>span{position:absolute;left:11px;color:var(--dim);display:grid;pointer-events:none}\n#files.fnew .fsearch input{width:230px;padding-left:34px}\n#files.fnew .fsearch input:focus{width:280px}\n#files.f39 #fgrid,#files.fnew #fgrid{display:flex;flex-direction:column;gap:2px}\n#files.f39 #fgrid.v4-grid,#files.fnew #fgrid.v4-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:14px}\n.fr9{display:grid;grid-template-columns:24px 44px minmax(0,1fr) auto;align-items:center;gap:14px;min-height:62px;padding:9px 14px;border:1px solid transparent;border-radius:var(--r2);transition:background .12s,border-color .12s}\n.fr9:hover{background:var(--hover)}.fr9.sel{background:color-mix(in srgb,var(--acc) 12%,transparent);border-color:color-mix(in srgb,var(--acc) 40%,transparent)}\n.fr9 .fa9 .btn{opacity:.0;transition:opacity .12s}.fr9:hover .fa9 .btn,.fr9:focus-within .fa9 .btn,.fr9.sel .fa9 .btn{opacity:1}\n.fpv9{width:44px;height:44px;display:grid;place-items:center;border:0;background:none;padding:0;cursor:zoom-in;border-radius:var(--r2);overflow:hidden}\n.fpv9 img{width:44px;height:44px;object-fit:cover;border-radius:var(--r2);border:1px solid var(--line)}\n.fn9{font-size:13.5px;font-weight:550}.fm9{font-size:12px}\n#fgrid.v4-grid .fr9{grid-template-columns:1fr auto;grid-template-rows:auto auto auto;gap:10px 8px;padding:14px;min-height:0;background:var(--panel);border:1px solid var(--line);border-radius:var(--r3);align-items:start;position:relative}\n#fgrid.v4-grid .fr9:hover{border-color:var(--line2);background:var(--panel)}\n#fgrid.v4-grid .fr9.sel{border-color:var(--acc)}\n#fgrid.v4-grid .fk9{grid-column:2;grid-row:1;justify-self:end}\n#fgrid.v4-grid .fpv9{grid-column:1;grid-row:1;width:52px;height:52px}\n#fgrid.v4-grid .fpv9 img{width:52px;height:52px}\n#fgrid.v4-grid .fb9{grid-column:1/-1;grid-row:2}\n#fgrid.v4-grid .fa9{grid-column:1/-1;grid-row:3;justify-content:flex-start}\n#fgrid.v4-grid .fa9 .btn{opacity:1}\n#fgrid.v4-grid .fn9{white-space:normal;overflow-wrap:anywhere;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}\n.fk9 input{width:16px;height:16px;accent-color:var(--acc);cursor:pointer}\n#files.fnew #fselbar{position:sticky;bottom:18px;z-index:6;display:flex;align-items:center;gap:8px;margin:18px auto 0;max-width:760px;background:var(--raised);border:1px solid var(--line2);border-radius:var(--r3);box-shadow:var(--shadow);padding:9px 14px}\n#files.fnew #fselbar[hidden]{display:none}#fselbar .sp{flex:1}\n#fempty{place-items:center;text-align:center;padding:12vh 0}\n#fempty .big{width:60px;height:60px;border-radius:var(--r3);background:var(--raised);border:1px solid var(--line);display:grid;place-items:center;margin:0 auto 16px;color:var(--dim)}\n#fempty h3{font:650 18px var(--sans)}#fempty p{color:var(--dim);max-width:380px;margin:6px auto 18px}\n#fscan{background:var(--panel);border:1px solid var(--line);border-radius:var(--r3);padding:12px 16px}\n#fdrop{border-radius:var(--r4)}\n#fmenu,#ch-menu,.menu{background:var(--panel);border:1px solid var(--line2);border-radius:var(--r2);box-shadow:var(--shadow);padding:5px}\n#fmenu button,#ch-menu button{display:flex;align-items:center;gap:9px;width:100%;text-align:left;padding:7px 10px;border:0;background:transparent;color:var(--txt);border-radius:var(--r1);font:13px var(--sans);cursor:pointer}\n#fmenu button:hover,#ch-menu button:hover{background:var(--hover)}\n#fmenu .mt,#ch-menu .mt{font:600 10.5px var(--sans);letter-spacing:.07em;text-transform:uppercase;color:var(--dim);padding:7px 10px 4px}\n#fprev{background:rgba(0,0,0,.62);backdrop-filter:blur(6px)}\n#fprev .pvbox{background:var(--panel);border:1px solid var(--line2);border-radius:var(--r3);box-shadow:var(--shadow);overflow:hidden}\n#fprev .pvhead{display:flex;align-items:center;gap:6px;padding:10px 14px;border-bottom:1px solid var(--line)}\n\n/* --- paramètres --- */\n#set{background:var(--bg)}\n#set .snav{padding:28px 14px;border-right:1px solid var(--line);background:var(--side);display:flex;flex-direction:column;gap:2px}\n#set .snav h2{font:650 18px var(--sans);letter-spacing:-.01em;padding:0 12px 14px}\n#set .snav button{text-align:left;padding:8px 12px;border:0;border-radius:var(--r1);background:transparent;color:var(--dim);font:500 13.5px var(--sans);cursor:pointer;transition:background .12s,color .12s}\n#set .snav button:hover{background:var(--hover);color:var(--txt)}\n#set .snav button.on{background:var(--sel);color:var(--txt)}\n#set .sgrp{font:600 10.5px var(--sans);letter-spacing:.07em;text-transform:uppercase;color:var(--dim);padding:18px 12px 6px}\n#set .spanes{padding:0 clamp(20px,5vw,64px) 64px}\n#set .pane{max-width:780px;padding-top:32px}\n#set .pane h2{font:650 24px var(--sans);letter-spacing:-.02em;margin-bottom:6px}\n#set .pane h3{font:600 12px var(--sans);letter-spacing:.06em;text-transform:uppercase;color:var(--dim);margin:28px 0 8px}\n#set .pane p{color:var(--dim);line-height:1.6;margin:6px 0}\n#set .pane p.warn{color:var(--warn);background:color-mix(in srgb,var(--warn) 9%,transparent);border:1px solid color-mix(in srgb,var(--warn) 30%,transparent);border-radius:var(--r2);padding:10px 14px}\n#set .line{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:12px 0}\n#set textarea{width:100%;font-family:var(--mono);font-size:12.5px;min-height:200px;resize:vertical}\n#set pre{background:var(--panel);border:1px solid var(--line);border-radius:var(--r2);padding:14px 16px;overflow:auto;line-height:1.6;color:var(--dim)}\n.upcard{border-radius:var(--r3);padding:22px 24px;background:var(--panel)}\n.upv b{font:650 34px var(--sans);letter-spacing:-.03em}\n.upbadge{background:color-mix(in srgb,var(--ok) 14%,transparent);color:var(--ok)}\n.upbadge.warn{background:color-mix(in srgb,var(--warn) 16%,transparent);color:var(--warn)}\n\n/* --- dialogues, notifications, palette --- */\ndialog{background:var(--panel);color:var(--txt);border:1px solid var(--line2);border-radius:var(--r3);box-shadow:var(--shadow);padding:22px 24px;width:min(440px,calc(100vw - 32px))}\ndialog.wide{width:min(720px,calc(100vw - 32px))}\ndialog::backdrop{background:rgba(0,0,0,.5);backdrop-filter:blur(4px)}\ndialog h3{font:650 17px var(--sans);letter-spacing:-.01em;margin-bottom:12px}\ndialog label{display:block;font:600 12px var(--sans);color:var(--dim);margin:14px 0 6px}\ndialog label.inl{display:flex;align-items:center;gap:10px;font-weight:500;color:var(--txt)}\ndialog input:not([type=checkbox]),dialog select,dialog textarea{width:100%}\ndialog p{color:var(--dim);line-height:1.6;margin:6px 0}\ndialog .row{display:flex;justify-content:flex-end;gap:8px;margin-top:20px}\n.ltabs{display:flex;gap:4px;border-bottom:1px solid var(--line);margin-bottom:14px}\n.ltabs button{border:0;background:transparent;color:var(--dim);padding:8px 12px;font:500 13px var(--sans);cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-1px}\n.ltabs button.on{color:var(--txt);border-bottom-color:var(--acc)}\n#toast{top:auto;bottom:28px;left:50%;right:auto;transform:translate(-50%,16px);max-width:min(560px,calc(100vw - 32px));background:var(--tbg);color:var(--ttx);border:0;border-radius:var(--r2);padding:10px 16px;font-size:13px;box-shadow:var(--shadow);opacity:0;pointer-events:none;z-index:99;transition:opacity .2s,transform .26s var(--ease)}\n#toast.show{opacity:1;transform:translate(-50%,0)}\n#qo .qb{background:var(--panel);border:1px solid var(--line2);border-radius:var(--r3);box-shadow:var(--shadow);overflow:hidden}\n#qo #qi{width:100%;border:0;border-bottom:1px solid var(--line);border-radius:0;background:transparent;padding:14px 18px;font-size:15px;box-shadow:none}\n#qo .qh{padding:8px 16px;font-size:11.5px;color:var(--dim);border-top:1px solid var(--line)}\n#splash{background:var(--bg)}\n\n/* --- petites largeurs --- */\n@media (max-width:900px){aside{width:212px}#files.fnew .fsearch input,#files.fnew .fsearch input:focus{width:180px}#set .snav{padding:20px 8px}}\n@media (max-width:640px){\n  .fr9{grid-template-columns:24px 40px minmax(0,1fr);gap:10px}.fr9 .fa9{grid-column:2/-1}.fr9 .fa9 .btn{opacity:1}\n  .opt{flex-direction:column;align-items:flex-start;gap:10px}\n  main>header{padding:0 10px}#hacc .hl{display:none}\n}\n</style>\n<script>\n/* 4.0.0 — refonte totale. Aucune donnée n'est modifiée : seule l'interface change. fview ('grid'|'list') est déjà lu par toutes les versions. */\n(function(){try{\nconst g=$('fgrid'),act=document.querySelector('#files .fact');if(!g||!act)throw new Error('page Fichiers introuvable');\nconst view=()=>settings.fview==='grid'?'grid':'list';\nconst seg=document.createElement('span');seg.className='seg';seg.id='fv4';seg.setAttribute('role','group');seg.setAttribute('aria-label','Affichage');\nseg.innerHTML='<button type=\"button\" data-v=\"list\" title=\"Liste\">Liste</button><button type=\"button\" data-v=\"grid\" title=\"Grille\">Grille</button>';\nconst add=$('fadd');add?act.insertBefore(seg,add):act.appendChild(seg);\nfunction sync(){g.classList.remove('grid','list','noanim');g.classList.toggle('v4-grid',view()==='grid');\n  seg.querySelectorAll('button').forEach(b=>{const on=b.dataset.v===view();b.classList.toggle('on',on);b.setAttribute('aria-pressed',on)})}\nseg.onclick=e=>{const b=e.target.closest('[data-v]');if(!b||settings.fview===b.dataset.v)return;settings.fview=b.dataset.v;save();sync()};\nconst prev=window.drawFiles;\nwindow.drawFiles=function(){const r=prev.apply(this,arguments);sync();return r};\nsync();\n}catch(x){console.error('module 4.0.0 interface',x)}})();\n</script>\n<style>\n/* ===== 4.1.0 ===== */\n/* Barre latérale : plus de panneau « Fichiers du projet » ni de bouton « Nouveau projet » ; la liste des clés ne déborde plus */\n#explorer,#newproj,#fcount{display:none!important}\naside{min-height:0;max-height:100%;overflow:hidden}\naside>*{flex-shrink:0}\naside #plist{flex:1 1 0;min-height:84px;max-height:none;overflow-y:auto;overflow-x:hidden}\naside #keysbox{flex:0 1 auto;min-height:0;max-height:min(52%,calc(100vh - 300px));display:flex;flex-direction:column}\naside #keysbox .keyshead{flex:none}\naside #keysbody{flex:1 1 auto;min-height:0;display:flex;flex-direction:column;overflow:hidden}\naside #keysbody #add{flex:none}\naside #keysbox #list{flex:1 1 auto;min-height:0;overflow-y:auto;overflow-x:hidden;overscroll-behavior:contain}\naside #filesbtn,aside .foot{flex:none}\n\n/* Bibliothèque : projets → fichiers du dossier */\n#files.libnew:not(.liblegacy)>:not(#lib):not(#fin){display:none!important}\n#files.libnew.liblegacy>#lib{display:none}\n#libback{display:flex;align-items:center;gap:12px;margin-bottom:14px}#libback[hidden]{display:none}\n#lib{max-width:1040px;margin:0 auto}\n#lib .lh{display:flex;align-items:flex-end;gap:16px;margin-bottom:16px}\n#lib .lh h2{font:600 20px var(--sans);letter-spacing:-.01em}#lib .lh p{font-size:12.5px;margin-top:1px}\n#lib .lh .sp{flex:1}\n#lib .lq{position:relative}\n#lib .lq input,#lib .lq2 input{width:230px;font:inherit;font-size:13px;color:var(--txt);background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:6px 10px}\n#lib .lq input:focus,#lib .lq2 input:focus{outline:none;border-color:var(--line2)}\n#lib .lgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:10px}\n#lib .lp{display:flex;align-items:center;gap:12px;text-align:left;width:100%;padding:12px 14px;background:var(--panel);border:1px solid var(--line);border-radius:12px;color:var(--txt);font:inherit;cursor:pointer;transition:background .15s,border-color .15s}\n#lib .lp:hover{background:var(--hover);border-color:var(--line2)}\n#lib .lpi{display:grid;place-items:center;width:38px;height:38px;border-radius:10px;background:var(--soft);color:var(--acc);flex:none}\n#lib .lpi .ic{width:19px;height:19px}\n#lib .lpb{min-width:0;flex:1;display:flex;flex-direction:column;gap:1px}\n#lib .lpb b{font-weight:600;font-size:14px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n#lib .lpb small{color:var(--dim);font-size:11.5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;direction:rtl;text-align:left}\n#lib .lpn{color:var(--dim);font-size:12px;font-variant-numeric:tabular-nums;white-space:nowrap}\n#lib .lleg{margin-top:22px;background:none;border:0;color:var(--dim);font:inherit;font-size:12.5px;cursor:pointer;padding:6px 2px}\n#lib .lleg:hover{color:var(--txt)}\n#lib .lnote{color:var(--dim);font-size:13px;padding:28px 6px;line-height:1.55}\n#lib .lnote .btn{margin-top:10px}\n#lib .lbc{display:flex;align-items:center;flex-wrap:wrap;gap:2px;margin-bottom:12px;font-size:13.5px;min-width:0}\n#lib .lbc button{background:none;border:0;color:var(--dim);font:inherit;padding:3px 7px;border-radius:6px;cursor:pointer;max-width:240px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n#lib .lbc button:hover{background:var(--hover);color:var(--txt)}\n#lib .lbc button.cur{color:var(--txt);font-weight:600;cursor:default}\n#lib .lbc i{font-style:normal;color:var(--dim);opacity:.6}\n#lib .ltools{display:flex;align-items:center;gap:8px;margin-bottom:8px;padding-bottom:10px;border-bottom:1px solid var(--line)}\n#lib .ltools .sp{flex:1}#lib .ltools .cnt{color:var(--dim);font-size:12.5px}\n#lib .lrow{display:grid;grid-template-columns:40px minmax(0,1fr) 92px 120px 34px;align-items:center;gap:12px;min-height:46px;padding:5px 10px;border-bottom:1px solid var(--line);cursor:pointer;border-radius:0}\n#lib .lrow:hover{background:var(--hover)}\n#lib .lrow .lb{display:grid;place-items:center;width:34px;height:30px;border-radius:7px;font:600 9.5px var(--sans);letter-spacing:.02em;color:#fff;background:var(--c,#7a7f87)}\n#lib .lrow.d .lb{background:var(--soft);color:var(--acc)}#lib .lrow .lb .ic{width:17px;height:17px}\n#lib .lrow .ln{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:13.5px;font-weight:500}\n#lib .lrow .lm{color:var(--dim);font-size:12px;white-space:nowrap;font-variant-numeric:tabular-nums}\n#lib .lrow .lm.r{text-align:right}\n#lib .lrow .lx{opacity:0;transition:opacity .12s;background:none;border:0;color:var(--dim);cursor:pointer;display:grid;place-items:center;width:28px;height:28px;border-radius:6px}\n#lib .lrow:hover .lx{opacity:1}#lib .lrow .lx:hover{background:var(--sel);color:var(--txt)}\n@media(max-width:760px){#lib .lrow{grid-template-columns:40px minmax(0,1fr) 34px}#lib .lrow .lm{display:none}}\n#libpv{width:min(860px,92vw);height:min(78vh,720px);padding:0;border:1px solid var(--line);border-radius:14px;background:var(--panel);color:var(--txt);overflow:hidden;box-shadow:var(--shadow)}\n#libpv[open]{display:flex;flex-direction:column}\n#libpv::backdrop{background:rgba(0,0,0,.55)}\n#libpv .ph{display:flex;align-items:center;gap:8px;padding:10px 14px;border-bottom:1px solid var(--line)}\n#libpv .ph b{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:13.5px}\n#libpv .pb{flex:1;min-height:0;overflow:auto;display:grid;place-items:center}\n#libpv .pb img{max-width:100%;max-height:100%;object-fit:contain}\n#libpv .pb pre{margin:0;align-self:stretch;justify-self:stretch;padding:14px;white-space:pre-wrap;word-break:break-word;font:12.5px/1.5 ui-monospace,Consolas,monospace;overflow:auto;text-align:left}\n#libpv .pb .dim{padding:24px;text-align:center}\n\n/* Page Mises à jour (4.1.0) */\n.upnew{display:flex;align-items:center;gap:10px;margin:12px 0 2px;padding:10px 12px;border-radius:10px;background:color-mix(in srgb,var(--acc) 12%,transparent);border:1px solid color-mix(in srgb,var(--acc) 35%,transparent);font-size:13.5px}\n.upnew[hidden]{display:none}.upnew b{font-weight:600}\n.upbusy{height:3px;border-radius:3px;background:var(--line);overflow:hidden;margin:10px 0 2px}.upbusy[hidden]{display:none}\n.upbusy i{display:block;height:100%;width:32%;border-radius:3px;background:var(--acc);animation:upslide 1.1s ease-in-out infinite}\n@keyframes upslide{0%{margin-left:-32%}100%{margin-left:100%}}\n.upauto{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--dim);margin:0 0 6px;cursor:pointer}\n.updot{position:relative}\nhtml.upd-avail #gear::after,html.upd-avail #p-upd-tab::after,html.upd-avail [data-t=\"upd\"]::after{content:\"\";display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--acc);margin-left:8px;vertical-align:middle}\n</style>\n<script>\n/* 4.1.0 — Bibliothèque = tes projets ; dans un projet, les fichiers de son dossier (explorateur). Les pièces jointes des anciens échanges restent accessibles en bas. */\n(function(){try{\nconst files=$('files');if(!files)throw new Error('page Bibliothèque introuvable');\nfiles.classList.add('libnew');\nconst lib=document.createElement('div');lib.id='lib';\nconst back=document.createElement('div');back.id='libback';back.hidden=true;\nback.innerHTML='<button class=\"btn ghost sm\" id=\"libbk\" type=\"button\">← Retour aux projets</button><span class=\"dim\">Pièces jointes des échanges avec les IA</span>';\nfiles.prepend(lib);files.prepend(back);\nconst pv=document.createElement('dialog');pv.id='libpv';document.body.appendChild(pv);\nconst L={pid:null,rel:'',items:null,err:'',q:'',gen:0,cnt:{},wasOn:false};\nconst H=window.hub260||{};\nconst projs=()=>{try{return PJ()}catch{return []}};\nconst proj=id=>projs().find(p=>p.id===id)||null;\nconst rootOf=p=>(p&&p.local&&p.local.path)||'';\nconst ext=n=>{const m=/\\.([A-Za-z0-9]+)$/.exec(n);return m?m[1].toLowerCase():''};\nconst bn=r=>String(r).split('/').pop();\nconst colr=e=>{let h=0;for(const c of e)h=(h*31+c.charCodeAt(0))%360;return e?`hsl(${h} 45% 46%)`:'#7a7f87'};\nconst dt=m=>m?new Date(m).toLocaleDateString('fr-FR',{day:'numeric',month:'short',year:'numeric'}):'';\nconst sz=n=>{try{return fmtSize(n)}catch{return n+' o'}};\n\nfunction drawRoot(){\n  const q=L.q.trim().toLowerCase(),all=projs(),ps=all.filter(p=>!q||String(p.name||'').toLowerCase().includes(q)||rootOf(p).toLowerCase().includes(q));\n  const nleg=(typeof FILES!=='undefined'&&FILES&&FILES.length)||0;\n  lib.innerHTML=`<div class=\"lh\"><div><h2>Bibliothèque</h2><p class=\"dim\">${all.length?all.length+' projet'+(all.length>1?'s':''):'Aucun projet'}</p></div><div class=\"sp\"></div><div class=\"lq\"><input id=\"lq\" placeholder=\"Rechercher un projet…\" autocomplete=\"off\" spellcheck=\"false\" value=\"${esc(L.q)}\"></div></div>`\n   +(ps.length?`<div class=\"lgrid\">${ps.map(p=>{const r=rootOf(p),c=L.cnt[p.id];\n      return `<button class=\"lp\" type=\"button\" data-lp=\"${esc(p.id)}\"><span class=\"lpi\">${IC('folder')}</span><span class=\"lpb\"><b>${esc(p.name)}</b><small>${r?esc(r):'Aucun dossier choisi'}</small></span><span class=\"lpn\" data-cnt=\"${esc(p.id)}\">${c==null?'':c}</span></button>`}).join('')}</div>`\n     :`<div class=\"lnote\">${all.length?'Aucun projet ne correspond.':'Aucun projet pour l\\'instant. Un projet apparaît ici dès que tu en as un dans la liste de gauche ; ses fichiers sont ceux de son dossier.'}</div>`)\n   +(nleg?`<button class=\"lleg\" id=\"lleg\" type=\"button\">Pièces jointes des conversations (${nleg}) →</button>`:'');\n  countAll()}\n\nasync function countAll(){const g=++L.gen;\n  for(const p of projs()){if(g!==L.gen||L.pid)return;const r=rootOf(p);if(!r||L.cnt[p.id]!=null)continue;\n    try{const res=await api.projTree({root:r});if(g!==L.gen)return;\n      const n=res&&res.ok?res.items.filter(x=>!x.d).length:'—';L.cnt[p.id]=res&&res.ok?(n+(res.cut?'+':'')+' fichier'+(n>1?'s':'')):'dossier introuvable';\n      const el=lib.querySelector(`[data-cnt=\"${CSS.escape(p.id)}\"]`);if(el)el.textContent=L.cnt[p.id]}catch{}}}\n\nfunction crumbs(p){const parts=L.rel?L.rel.split('/'):[];\n  let h=`<button type=\"button\" data-bc=\"__root\">Projets</button><i>›</i><button type=\"button\" data-bc=\"\" class=\"${parts.length?'':'cur'}\">${esc(p.name)}</button>`;\n  parts.forEach((s,i)=>{const rel=parts.slice(0,i+1).join('/');h+=`<i>›</i><button type=\"button\" data-bc=\"${esc(rel)}\" class=\"${i===parts.length-1?'cur':''}\">${esc(s)}</button>`});return h}\n\nfunction drawProj(){const p=proj(L.pid);if(!p){L.pid=null;return drawRoot()}\n  const r=rootOf(p);\n  const head=`<div class=\"lbc\">${crumbs(p)}</div>`;\n  if(!r){lib.innerHTML=head+`<div class=\"lnote\">Ce projet n'a pas encore de dossier : ses fichiers sont ceux de son dossier.<br><button class=\"btn pri\" id=\"lpick\" type=\"button\">Choisir le dossier</button></div>`;return}\n  const q=L.q.trim().toLowerCase();let it=L.items;\n  const tools=`<div class=\"ltools\"><button class=\"btn ghost sm\" id=\"lup\" type=\"button\" ${L.rel?'':'disabled'} title=\"Dossier parent\">↑</button><span class=\"cnt\">${it?it.length+' élément'+(it.length>1?'s':''):''}</span><div class=\"sp\"></div><span class=\"lq2\"><input id=\"lq2\" placeholder=\"Filtrer ce dossier…\" autocomplete=\"off\" spellcheck=\"false\" value=\"${esc(L.q)}\"></span><button class=\"btn ghost sm\" id=\"lref\" type=\"button\" title=\"Actualiser\">${IC('refresh')}</button><button class=\"btn ghost sm\" id=\"lshow\" type=\"button\" title=\"Afficher le dossier dans l'explorateur Windows\">${IC('folder')}</button><button class=\"btn sm\" id=\"lopen\" type=\"button\">Ouvrir le projet</button></div>`;\n  let body;\n  if(L.err)body=`<div class=\"lnote\">${esc(L.err)}<br><button class=\"btn\" id=\"lpick\" type=\"button\">Choisir un autre dossier</button></div>`;\n  else if(!it)body='<div class=\"lnote\">Chargement…</div>';\n  else{if(q)it=it.filter(x=>bn(x.p).toLowerCase().includes(q));\n    body=it.length?it.map(x=>{const e=ext(x.p);\n      return `<div class=\"lrow${x.d?' d':''}\" data-p=\"${esc(x.p)}\" data-d=\"${x.d?1:0}\"><span class=\"lb\" style=\"--c:${colr(e)}\">${x.d?IC('folder'):esc((e||'·').slice(0,4).toUpperCase())}</span><span class=\"ln\" title=\"${esc(x.p)}\">${esc(bn(x.p))}</span><span class=\"lm\">${x.d?'Dossier':sz(x.s||0)}</span><span class=\"lm r\">${x.d?'':dt(x.m)}</span><button class=\"lx\" type=\"button\" data-sh=\"${esc(x.p)}\" title=\"Afficher dans l'explorateur Windows\">${IC('folder')}</button></div>`}).join('')\n      :`<div class=\"lnote\">${q?'Aucun fichier ne correspond.':'Ce dossier est vide.'}</div>`}\n  lib.innerHTML=head+tools+body}\n\nasync function load(){const p=proj(L.pid);if(!p)return;const r=rootOf(p);if(!r)return drawProj();\n  const g=++L.gen;L.err='';L.items=null;drawProj();\n  try{api.projWatch&&api.projWatch({root:r})}catch{}\n  const res=await api.projList({root:r,rel:L.rel});if(g!==L.gen)return;\n  if(res&&res.ok){L.items=res.items}else{L.items=[];L.err='Dossier introuvable. Il a peut-être été déplacé ou supprimé.'}\n  drawProj()}\nconst draw=()=>L.pid?drawProj():drawRoot();\nfunction openProj(id){L.pid=id;L.rel='';L.q='';L.items=null;load()}\nfunction toRoot(){L.pid=null;L.rel='';L.q='';L.items=null;L.cnt={};drawRoot()}\n\nasync function preview(rel){const p=proj(L.pid),r=rootOf(p);if(!p||!r)return;\n  pv.innerHTML=`<div class=\"ph\"><b>${esc(rel)}</b><button class=\"btn ghost sm\" data-pvs type=\"button\">Afficher dans le dossier</button><button class=\"btn ghost sm\" data-pvc type=\"button\">Copier le chemin</button><button class=\"btn ghost ico\" data-pvx type=\"button\" title=\"Fermer\">${IC('x')}</button></div><div class=\"pb\"><div class=\"dim\">Chargement…</div></div>`;\n  pv.dataset.rel=rel;if(!pv.open)pv.showModal();\n  const res=await api.projRead({root:r,rel});const b=pv.querySelector('.pb');if(!b||pv.dataset.rel!==rel)return;\n  if(!res||!res.ok)b.innerHTML=`<div class=\"dim\">${esc((res&&res.error)||'Lecture impossible')}</div>`;\n  else if(res.kind==='img')b.innerHTML=`<img src=\"${res.url}\" alt=\"\">`;\n  else if(res.kind==='text'){const pre=document.createElement('pre');pre.textContent=res.text;b.innerHTML='';b.appendChild(pre)}\n  else b.innerHTML=`<div class=\"dim\">${res.kind==='big'?'Fichier trop gros pour l\\'aperçu':'Fichier binaire : pas d\\'aperçu'} (${sz(res.size||0)}).<br>Utilise « Afficher dans le dossier » pour l'ouvrir avec une autre application.</div>`}\npv.addEventListener('click',e=>{\n  if(e.target===pv||e.target.closest('[data-pvx]')){pv.close();return}\n  const rel=pv.dataset.rel,p=proj(L.pid),r=rootOf(p);\n  if(e.target.closest('[data-pvs]')&&r){api.projOp({root:r,rel,op:'show'});return}\n  if(e.target.closest('[data-pvc]')&&r){const full=r.replace(/[\\\\/]+$/,'')+'\\\\'+rel.replace(/\\//g,'\\\\');try{api.copy(full);toast('Chemin copié')}catch{}}});\n\nlib.addEventListener('click',e=>{\n  const lp=e.target.closest('[data-lp]');if(lp){openProj(lp.dataset.lp);return}\n  if(e.target.closest('#lleg')){files.classList.add('liblegacy');back.hidden=false;try{drawFiles(false)}catch{}return}\n  const bc=e.target.closest('[data-bc]');if(bc){if(bc.dataset.bc==='__root')toRoot();else if(bc.dataset.bc!==L.rel){L.rel=bc.dataset.bc;L.q='';load()}return}\n  if(e.target.closest('#lup')){L.rel=L.rel.includes('/')?L.rel.slice(0,L.rel.lastIndexOf('/')):'';L.q='';load();return}\n  if(e.target.closest('#lref')){load();return}\n  const p=proj(L.pid),r=rootOf(p);\n  if(e.target.closest('#lshow')&&r){api.projOp({root:r,rel:L.rel,op:'show'});return}\n  if(e.target.closest('#lopen')&&p){try{H.openProject(p.id)}catch{}return}\n  if(e.target.closest('#lpick')&&p){(async()=>{try{if(await H.pickLocal(p)){L.cnt={};load()}}catch{}})();return}\n  const sh=e.target.closest('[data-sh]');if(sh){e.stopPropagation();if(r)api.projOp({root:r,rel:sh.dataset.sh,op:'show'});return}\n  const row=e.target.closest('.lrow');if(row){if(row.dataset.d==='1'){L.rel=row.dataset.p;L.q='';load()}else preview(row.dataset.p)}});\nlib.addEventListener('input',e=>{\n  if(e.target.id==='lq'){L.q=e.target.value;const pos=e.target.selectionStart;drawRoot();const i=$('lq');if(i){i.focus();try{i.setSelectionRange(pos,pos)}catch{}}}\n  if(e.target.id==='lq2'){L.q=e.target.value;const pos=e.target.selectionStart;drawProj();const i=$('lq2');if(i){i.focus();try{i.setSelectionRange(pos,pos)}catch{}}}});\n$('libbk').onclick=()=>{files.classList.remove('liblegacy');back.hidden=true;toRoot()};\n// ouverture de la page : toujours la liste des projets\ntry{$('filesbtn').addEventListener('click',()=>{if(!files.classList.contains('on')){files.classList.remove('liblegacy');back.hidden=true;L.pid=null;L.rel='';L.q='';L.items=null;L.cnt={}}},true)}catch{}\nnew MutationObserver(()=>{const on=files.classList.contains('on');if(on&&!L.wasOn&&!files.classList.contains('liblegacy'))draw();L.wasOn=on}).observe(files,{attributes:true,attributeFilter:['class']});\ntry{if(window.api&&api.onProj)api.onProj(d=>{if(files.classList.contains('on')&&L.pid&&!files.classList.contains('liblegacy')){const p=proj(L.pid);if(p&&d&&d.root&&rootOf(p)&&d.root.replace(/[\\\\/]+$/,'')===rootOf(p).replace(/[\\\\/]+$/,'')&&!pv.open)load()}})}catch{}\nwindow.addEventListener('focus',()=>{if(files.classList.contains('on')&&L.pid&&!pv.open)load()});\n}catch(x){console.error('module 4.1.0 bibliothèque',x)}})();\n\n/* 4.1.0 — mises à jour : même source que l'installeur (dernier paquet à la racine de github.com/XeroxYTB3/ai_hub) */\n(function(){try{\nconst msg=(t,cls)=>{const m=$('upmsg');if(!m)return;m.className=cls||'';m.textContent=t||''};\nconst busy=on=>{const b=$('upbusy');if(b)b.hidden=!on;['upcheck','upget','upsetup','upapply','uprev','uporig'].forEach(i=>{const e=$(i);if(e)e.disabled=!!on});if(!on){try{drawUpd()}catch{}}};\nlet last=null;\nconst flag=r=>{document.documentElement.classList.toggle('upd-avail',!!(r&&r.ok&&r.newer))};\nfunction paint(){const n=$('upnew'),g=$('upget'),c=$('upcheck');if(!n||!g||!c)return;\n  const r=last;g.hidden=true;n.hidden=true;c.textContent='Rechercher une mise à jour';\n  if(r&&r.ok&&r.newer){n.hidden=false;n.innerHTML=`Version <b>${esc(r.latest)}</b> disponible <span class=\"dim\">(tu as la ${esc(r.current)})</span>`;g.hidden=false;g.textContent='Installer la '+r.latest}\n  else if(r&&r.ok){msg('✔ AI Hub est à jour (version '+r.latest+').')}}\nasync function check(auto){\n  if(!window.api||!api.updCheck)return null;\n  if(!auto){busy(true);msg('Recherche sur github.com/XeroxYTB3/ai_hub…')}\n  let r;try{r=await api.updCheck()}catch(e){r={ok:false,error:e.message}}\n  last=window.__upd=r;flag(r);\n  if(!auto){busy(false);if(!r.ok)msg('✘ Impossible de vérifier : '+r.error+'. Vérifie ta connexion, ou installe un fichier .aihubupdate dans les options avancées.','warn');else{paint()}}\n  else paint();\n  return r}\nasync function install(){\n  busy(true);msg('Téléchargement et vérification de la dernière version…');\n  let r;try{r=await api.updFetch()}catch(e){r={ok:false,error:e.message}}\n  busy(false);\n  if(r&&r.ok&&r.uptodate){msg('✔ Déjà à jour (version '+r.version+').');return}\n  if(!r||!r.ok){msg('✘ '+((r&&r.error)||'échec'),'warn');\n    if(r&&r.launcherTooOld&&confirm('Ce lanceur est trop ancien pour installer une mise à jour. Télécharger et lancer l\\'installeur AI Hub ? (tes comptes, scripts et réglages sont conservés ; AI Hub va se fermer)'))setup();return}\n  last=null;flag(null);msg('✔ Version '+r.version+' installée.');paint();\n  if(confirm(`Version ${r.version} installée. Redémarrer maintenant pour l'essayer ?\\n(Si elle ne démarre pas correctement, l'app revient toute seule à la version précédente.)`))api.relaunch()}\nasync function setup(){busy(true);msg('Téléchargement de l\\'installeur…');let r;try{r=await api.updSetup()}catch(e){r={ok:false,error:e.message}}\n  busy(false);msg(r&&r.ok?'Installeur lancé : AI Hub se ferme…':'✘ '+((r&&r.error)||'échec'),r&&r.ok?'':'warn')}\nconst wire=(id,f)=>{const e=$(id);if(e)e.onclick=f};\nwire('upcheck',()=>check(false));wire('upget',install);\nwire('upsetup',()=>{if(confirm('Télécharger la dernière version de l\\'installeur depuis le dépôt et le lancer ? AI Hub va se fermer ; tes comptes, scripts et réglages sont conservés.'))setup()});\nconst au=$('upauto');if(au){try{au.checked=localStorage.hubUpdAuto!=='0'}catch{au.checked=true}au.onchange=()=>{try{localStorage.hubUpdAuto=au.checked?'1':'0'}catch{}}}\nconst d0=window.drawUpd;if(typeof d0==='function')window.drawUpd=async function(){await d0.apply(this,arguments);paint()};\n// vérification discrète au démarrage (désactivable) : un point apparaît sur Paramètres si une version est disponible\nsetTimeout(()=>{let on=true;try{on=localStorage.hubUpdAuto!=='0'}catch{}if(on)check(true).then(r=>{if(r&&r.ok&&r.newer&&typeof toast==='function')toast('Mise à jour '+r.latest+' disponible : Paramètres › Mises à jour')}).catch(()=>{})},9000);\n}catch(x){console.error('module 4.1.0 mises à jour',x)}})();\n</script>\n</body></html>\n"}}}