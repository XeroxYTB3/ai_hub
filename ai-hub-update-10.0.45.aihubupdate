= '';\n  if (!(MENU.files || []).length) { hlist.appendChild(hel('div', 'padding:10px;opacity:.7', 'Aucun fichier. Ajoute-en dans AI Hub > Fichiers (tu peux les classer par projet).')); return; }\n  if (!files.length) { hlist.appendChild(hel('div', 'padding:10px;opacity:.7', 'Aucun fichier ne correspond.')); return; }\n  const groups = (MENU.projects || []).map((p) => ({ p, f: files.filter((x) => x.proj === p.id) })).concat([{ p: null, f: files.filter((x) => !x.proj) }]).filter((g) => g.f.length);\n  for (const g of groups) {\n    const head = hel('div', 'display:flex;align-items:center;gap:8px;padding:8px 10px 3px');\n    head.appendChild(hel('span', 'flex:1;font-weight:600;font-size:12.5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap', g.p ? g.p.name : 'Sans projet'));\n    if (g.p) {\n      const b = hel('button', 'border:0;background:none;color:#c6613f;font:inherit;font-size:11.5px;cursor:pointer;padding:2px 4px;border-radius:6px', 'contexte seul');\n      b.title = 'Ajoute seulement le résumé du projet dans la zone de message'; b.addEventListener('click', () => pick({ pid: g.p.id })); head.appendChild(b);\n    }\n    { const allIn = g.f.every((x) => SELH.has(x.id)); const sb = hel('button', 'border:0;background:none;color:#c6613f;font:inherit;font-size:11.5px;cursor:pointer;padding:2px 4px;border-radius:6px', allIn ? 'désélectionner' : 'tout sélectionner'); sb.title = 'Sélectionne tous les fichiers de ce groupe pour les envoyer en une fois'; sb.addEventListener('click', () => { g.f.forEach((x) => allIn ? SELH.delete(x.id) : SELH.add(x.id)); drawHubMenu(); }); head.appendChild(sb); }\n    hlist.appendChild(head);\n    for (const f of g.f) {\n      const row = hel('button', 'display:flex;align-items:center;gap:9px;width:100%;padding:7px 10px;border:0;background:none;color:inherit;font:inherit;text-align:left;cursor:pointer;border-radius:8px');\n      const ext = ((f.name.includes('.') ? f.name.split('.').pop() : 'file') || 'file').slice(0, 4).toUpperCase();\n      row.appendChild(mkCb(f.id)); row.appendChild(hel('span', 'flex:none;min-width:34px;text-align:center;font-size:10px;font-weight:700;padding:3px 4px;border-radius:6px;background:' + (dark ? 'rgba(198,97,63,.22)' : 'rgba(198,97,63,.12)') + ';color:#c6613f', ext));\n      row.appendChild(hel('span', 'flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap', f.name));\n      row.appendChild(hel('span', 'flex:none;font-size:11.5px;opacity:.55', hSize(f.size)));\n      row.addEventListener('mouseenter', () => { row.style.background = hov; }); row.addEventListener('mouseleave', () => { row.style.background = 'none'; });\n      row.addEventListener('click', () => { if (SELH.size) { SELH.has(f.id) ? SELH.delete(f.id) : SELH.add(f.id); drawHubMenu(); } else pick({ fid: f.id }); }); hlist.appendChild(row);\n    }\n  }\n}\n\nfunction mkCb(id) {\n  const cb = hel('input', 'flex:none;width:15px;height:15px;margin:0;accent-color:#c6613f;cursor:pointer'); cb.type = 'checkbox'; cb.checked = SELH.has(id); cb.title = 'Sélectionner pour envoyer plusieurs fichiers';\n  cb.addEventListener('click', (e) => e.stopPropagation()); cb.addEventListener('change', () => { cb.checked ? SELH.add(id) : SELH.delete(id); drawHubMenu(); }); return cb;\n}\nfunction updHubFoot() {\n  if (!hfoot) return; hfoot.textContent = '';\n  if (!SELH.size) { hfoot.style.display = 'none'; return; }\n  const dark = hmenu && hmenu.dataset.dark; hfoot.style.display = 'flex'; hfoot.style.background = dark ? '#2b2a27' : '#fff'; hfoot.style.borderTop = '1px solid ' + (dark ? '#4a4843' : '#e4e1d6');\n  const go = hel('button', 'flex:1;border:0;border-radius:8px;padding:8px 10px;background:#c6613f;color:#fff;font:inherit;font-weight:600;cursor:pointer', 'Joindre ' + SELH.size + ' fichier' + (SELH.size > 1 ? 's' : ''));\n  go.addEventListener('click', () => { const fids = [...SELH]; ipcRenderer.sendToHost('hub-attach-pick', { fids }); closeHubMenu(); });\n  const no = hel('button', 'border:0;background:none;color:inherit;opacity:.7;font:inherit;cursor:pointer;padding:6px 8px', 'Annuler'); no.addEventListener('click', () => { SELH.clear(); drawHubMenu(); });\n  hfoot.appendChild(go); hfoot.appendChild(no);\n}\n\n// ---------- 10.0.5 : mode épuré : seuls la conversation et la zone de saisie restent ; pop-ups fermés automatiquement ----------\n(function () {\n  try {\n    const OFF = () => { try { return (cfg && cfg.clean === false) || localStorage.hubClean === '0'; } catch { return false; } };\n    const CSS = [\n      \"[data-testid*='banner' i]\",\n      \"[data-testid*='cookie' i]\", \"[id*='cookie' i]\", \"[class*='cookie' i]\", \"[id*='onetrust' i]\", \"[class*='consent-banner' i]\",\n      \"[data-testid*='upsell' i]\", \"[data-testid*='promo' i]\", \"[data-testid*='upgrade' i]\", \"[class*='upsell' i]\", \"[class*='promo-banner' i]\", \"[class*='announcement' i]\"\n    ].map(x => 'html.hub-clean ' + x).join(',') + '{display:none !important}';\n    const CLOSE_RE = /^(close|fermer|dismiss|ignorer|not now|plus tard|pas maintenant|no,? thanks|non,? merci|skip|passer|later|maybe later|peut-être plus tard|got it|compris|ok|okay|d['’]accord|stay logged out|rester déconnecté|×|✕|x)$/i;\n    const BLOCK_RE = /(log ?in|sign ?in|sign ?up|connexion|se connecter|s['’]inscrire|créer un compte|create (an )?account|password|mot de passe|verif|vérif|captcha|human|humain|continue with|continuer avec|enter the code|saisissez le code)/i;\n    const vis = (e) => { try { const r = e.getBoundingClientRect(); return r.width > 0 && r.height > 0; } catch { return false; } };\n    const done = new WeakMap(); let styleEl = null;\n    function sweep() {\n      if (OFF()) { document.documentElement.classList.remove('hub-clean'); return; }\n      if (!styleEl) { styleEl = document.createElement('style'); styleEl.textContent = CSS; (document.head || document.documentElement).appendChild(styleEl); }\n      let comp = null; try { comp = document.querySelector(S.comp); } catch {}\n      const login = !!document.querySelector('input[type=\"password\"]');\n      document.documentElement.classList.toggle('hub-clean', !!comp && !login);\n      if (!comp || login) return;\n      const now = Date.now();\n      for (const dlg of document.querySelectorAll('[role=\"dialog\"],[role=\"alertdialog\"],[aria-modal=\"true\"]')) {\n        if (!vis(dlg) || dlg.contains(comp) || dlg.querySelector('textarea,[contenteditable=\"true\"],input[type=\"file\"]')) continue;\n        if (now - (done.get(dlg) || 0) < 5000) continue;\n        const t = (dlg.innerText || '').slice(0, 700);\n        if (LIMIT_RE.test(t) || BLOCK_RE.test(t)) continue;\n        const btns = [...dlg.querySelectorAll('button,[role=\"button\"],a')];\n        const b = btns.find(x => CLOSE_RE.test(((x.innerText || x.textContent || '').trim()))) || btns.find(x => /^(close|fermer|dismiss)/i.test(x.getAttribute('aria-label') || ''));\n        if (b && vis(b)) { done.set(dlg, now); try { b.click(); } catch {} }\n      }\n    }\n    setInterval(() => { try { sweep(); } catch {} }, 1500);\n  } catch (x) { /* le mode épuré ne doit jamais casser la détection */ }\n})();\n\n// ---------- 10.0.21 : mode épuré strict (liste blanche, temps réel) ----------\n// Reste : zone de saisie, conversation, bouton menu, anciennes conversations, limites/captcha/connexion.\n// Pop-ups, dialogues, fonds sombres, bandeaux promo/cookies : masqués dès leur apparition. Rien n'est fait tant que la page n'est pas chargée.\n(function () {\n  try {\n    const OFF = () => { try { return (typeof cfg !== 'undefined' && cfg && cfg.clean === false) || localStorage.hubClean === '0'; } catch { return false; } };\n    const KEEP_RE = /(captcha|turnstile|cloudflare|verify you are human|vérifiez|êtes-vous humain|log ?in|sign ?in|connexion|se connecter|mot de passe|password|enter the code|saisissez le code)/i;\n    const PROMO_RE = /(cookie|consent|gdpr|rgpd|upgrade|passer à|passez à|essai gratuit|free trial|download the app|get the app|télécharger l['’]app|newsletter|survey|sondage|donnez votre avis|your feedback|what['’]s new|nouveautés|welcome|bienvenue|new feature|nouvelle fonctionnalité|terms|conditions|privacy|confidentialité|notification|promo|offre|offer)/i;\n    const CLOSE_RE = /^(close|fermer|dismiss|ignorer|not now|plus tard|pas maintenant|no,? thanks|non,? merci|skip|passer|later|maybe later|got it|compris|ok|okay|d['’]accord|stay logged out|rester déconnecté|×|✕|x)$/i;\n    const HIST = 'a[href*=\"/c/\"],a[href*=\"/chat/\"],a[href*=\"/app/\"],a[href*=\"/thread\"],a[href*=\"/search/\"],a[href*=\"/chats\"],[data-testid*=\"history\" i],[data-testid*=\"conversation\" i]';\n    const MSG = 'article,[data-message-author-role],[data-testid*=\"message\" i],[data-testid*=\"turn\" i]';\n    const BLOCK = 'input[type=\"password\"],iframe[src*=\"captcha\" i],iframe[src*=\"turnstile\" i],iframe[src*=\"challenges.cloudflare\" i],#challenge-form,.cf-turnstile';\n    const CSS = [\"[data-testid*='upsell' i]\", \"[data-testid*='promo' i]\", \"[data-testid*='upgrade' i]\", \"[class*='upsell' i]\", \"[class*='promo' i]\", \"[class*='cookie' i]\", \"[id*='cookie' i]\", \"[id*='onetrust' i]\", \"[class*='consent' i]\", \"[class*='survey' i]\"]\n      .map((x) => 'html.hub-purge ' + x + \":not(:has(textarea,[contenteditable='true']))\").join(',') + '{display:none !important}';\n    const hidden = new Set(), okSet = new WeakSet();\n    let styleEl = null, emptySince = 0, emptySent = 0, tmr = 0, lastUser = 0;\n    const protect = (t) => { try { LIMIT_RE.lastIndex = 0; return LIMIT_RE.test(t) || KEEP_RE.test(t); } catch { return KEEP_RE.test(t); } };\n    const txt = (e) => { try { return (e.innerText || e.textContent || '').slice(0, 600); } catch { return ''; } };\n    const area = (r) => Math.max(0, Math.min(r.right, innerWidth) - Math.max(r.left, 0)) * Math.max(0, Math.min(r.bottom, innerHeight) - Math.max(r.top, 0));\n    function hide(e) { try { e.setAttribute('data-hub-x', '1'); e.style.setProperty('display', 'none', 'important'); hidden.add(e); } catch {} }\n    function restore() { for (const e of hidden) { try { e.removeAttribute('data-hub-x'); e.style.removeProperty('display'); } catch {} } hidden.clear(); }\n    ['pointerdown', 'keydown'].forEach((ev) => document.addEventListener(ev, () => { lastUser = Date.now(); }, true));\n    function run() {\n      tmr = 0;\n      const root = document.documentElement;\n      if (OFF()) { root.classList.remove('hub-purge'); restore(); return; }\n      let comp = null; try { comp = document.querySelector(S.comp); } catch {}\n      let blocked = false; try { blocked = !!document.querySelector(BLOCK); } catch {}\n      if (!comp || blocked) {\n        root.classList.remove('hub-purge'); if (hidden.size) restore();\n        if (!comp && !blocked && document.readyState === 'complete') {\n          if (!emptySince) emptySince = Date.now();\n          else if (Date.now() - emptySince > 30000 && Date.now() - emptySent > 120000) { emptySent = Date.now(); emit('page-empty', { url: location.href }); }\n        } else emptySince = 0;\n        return;\n      }\n      emptySince = 0;\n      if (!styleEl) { styleEl = document.createElement('style'); styleEl.textContent = CSS; (document.head || root).appendChild(styleEl); }\n      root.classList.add('hub-purge');\n      // débloquer la page si un pop-up a verrouillé les clics\n      for (let n = comp; n && n !== root; n = n.parentElement) { if (n.hasAttribute('inert')) n.removeAttribute('inert'); if (n.getAttribute('aria-hidden') === 'true') n.removeAttribute('aria-hidden'); }\n      for (const el of [document.body, root]) { if (el && el.style && el.style.pointerEvents === 'none') el.style.pointerEvents = ''; }\n      const vw = innerWidth, vh = innerHeight, recent = Date.now() - lastUser < 1500;\n      const cand = new Set(document.querySelectorAll('[role=\"dialog\"],[role=\"alertdialog\"],[aria-modal=\"true\"],body > *,body > * > *,[data-radix-portal] > *,[role=\"alert\"],[role=\"status\"]'));\n      for (const e of cand) {\n        if (!e.isConnected || e === comp || okSet.has(e) || e.hasAttribute('data-hub-x') || /^(SCRIPT|STYLE|LINK|IFRAME|NOSCRIPT)$/.test(e.tagName)) continue;\n        if (e.contains(comp) || (e.id && /^hub/i.test(e.id))) continue;\n        if (typeof hmenu !== 'undefined' && hmenu && (e === hmenu || e.contains(hmenu))) continue;\n        if (e.querySelector('input[type=\"file\"]')) continue;\n        let cs; try { cs = getComputedStyle(e); } catch { continue; }\n        if (cs.display === 'none' || cs.visibility === 'hidden') continue;\n        const role = e.getAttribute('role') || '', t = txt(e);\n        if (protect(t)) continue;\n        const dlg = role === 'dialog' || role === 'alertdialog' || e.getAttribute('aria-modal') === 'true';\n        if (dlg) {\n          if (e.querySelector('textarea,[contenteditable=\"true\"]')) continue;\n          if (recent) { okSet.add(e); continue; }       // ouvert volontairement par l'utilisateur\n          const b = [...e.querySelectorAll('button,[role=\"button\"],a')].find((x) => CLOSE_RE.test((x.innerText || x.textContent || '').trim()) || /^(close|fermer|dismiss)/i.test(x.getAttribute('aria-label') || ''));\n          if (b) { try { b.click(); } catch {} }\n          hide(e); continue;\n        }\n        if (cs.position === 'fixed') {\n          const r = e.getBoundingClientRect();\n          const big = area(r) > vw * vh * 0.45 && !e.querySelector(HIST) && !e.querySelector(MSG);\n          const banner = r.width > vw * 0.4 && r.height < 280 && r.bottom >= vh - 8 && PROMO_RE.test(t) && !e.querySelector('textarea,[contenteditable=\"true\"]');\n          if (big || banner) { if (recent) { okSet.add(e); continue; } hide(e); }\n        } else if ((role === 'alert' || role === 'status') && PROMO_RE.test(t)) hide(e);\n      }\n    }\n    const kick = () => { if (!tmr) tmr = setTimeout(() => { try { run(); } catch {} }, 400); };\n    try { new MutationObserver(kick).observe(document.documentElement, { childList: true, subtree: true }); } catch {}\n    setInterval(kick, 1500);\n    kick();\n  } catch (x) { /* le mode épuré ne doit jamais casser la détection */ }\n})();"}, "index.html": {"sha256": "b94f76fbaa5294422206d266209acb4c46200d355f9a9a3bd3756cfee773a9f9", "content": "<!DOCTYPE html>\r\n<!--\r\n  ⚠ RÈGLE N°1 — MISE À JOUR UNIVERSELLE (à lire AVANT toute modification de ce fichier)\r\nCette mise à jour doit TOUJOURS être compatible, PEU IMPORTE la version actuellement installée :\r\nversion d'origine de l'exe, ancienne, récente, ou même plus récente que celle-ci. N'importe qui doit\r\npouvoir l'installer, depuis n'importe quelle version, sans rien perdre (comptes, scripts, réglages).\r\nPour cela, TOUJOURS :\r\n 1. Livrer un paquet COMPLET : les 4 fichiers (main-core.js, preload.js, webview-preload.js, index.html), jamais un paquet partiel.\r\n 2. requiresLauncher = null. Ne rien supposer du lanceur (voir normalizeCtx dans main-core.js) et ne jamais exiger un lanceur plus récent.\r\n 3. Garder les 4 fichiers cohérents entre eux (preload.js <-> main-core.js <-> index.html).\r\n 4. Savoir lire les données écrites par N'IMPORTE QUELLE version : champ absent = valeur par défaut ; ne jamais supprimer ni réécrire un champ inconnu.\r\n 5. Ne rien écrire qu'une version plus ancienne ne puisse relire (le retour arrière doit toujours marcher).\r\n 6. Numéro de version strictement supérieur au précédent ; un numéro déjà publié n'est jamais réutilisé.\r\n-->\r\n<html lang=\"fr\" data-theme=\"system\"><head><meta charset=\"UTF-8\"><title>AI Hub</title>\r\n<script>/* garde-fou : une erreur au démarrage d'une version en essai la fait annuler tout de suite */\r\nwindow.__healthy=false;(()=>{const f=m=>{if(!window.__healthy&&window.api)window.api.updFail(String(m))};addEventListener('error',e=>f(e.message));addEventListener('unhandledrejection',e=>f(e.reason&&e.reason.message||e.reason))})();</script>\r\n<style>\r\n/* ===== Thème : palette inspirée de claude.ai (fond crème, accent terracotta ; sombre = gris chaud) ===== */\r\n:root{color-scheme:light;\r\n--bg:#FAF9F5;--side:#F3F1EA;--panel:#FFFFFF;--hover:rgba(31,30,29,.06);--sel:rgba(31,30,29,.09);\r\n--line:#E4E1D6;--line2:#CFCBBE;--txt:#1F1E1D;--dim:#6F6D66;--acc:#C6613F;--btn:#B5532F;--btnh:#9E4527;\r\n--soft:rgba(198,97,63,.10);--ok:#2F7D5B;--warn:#A9691A;--err:#B3412F;--tbg:#1F1E1D;--ttx:#FAF9F5;\r\n--shadow:0 1px 2px rgba(31,30,29,.06),0 8px 28px rgba(31,30,29,.12);\r\n--serif:\"Iowan Old Style\",\"Palatino Linotype\",Palatino,\"Book Antiqua\",Georgia,serif;\r\n--sans:system-ui,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif}\r\n:root[data-theme=dark]{color-scheme:dark;\r\n--bg:#262624;--side:#1F1E1D;--panel:#30302E;--hover:rgba(250,249,245,.06);--sel:rgba(250,249,245,.10);\r\n--line:#3D3C38;--line2:#57554E;--txt:#F2F0E8;--dim:#A3A198;--acc:#E08A6B;--btn:#B5532F;--btnh:#C65F39;\r\n--soft:rgba(224,138,107,.14);--ok:#6CC59A;--warn:#E0B060;--err:#EE8A78;--tbg:#F2F0E8;--ttx:#1F1E1D;\r\n--shadow:0 1px 2px rgba(0,0,0,.3),0 8px 28px rgba(0,0,0,.45)}\r\n@media (prefers-color-scheme:dark){:root[data-theme=system]{color-scheme:dark;\r\n--bg:#262624;--side:#1F1E1D;--panel:#30302E;--hover:rgba(250,249,245,.06);--sel:rgba(250,249,245,.10);\r\n--line:#3D3C38;--line2:#57554E;--txt:#F2F0E8;--dim:#A3A198;--acc:#E08A6B;--btn:#B5532F;--btnh:#C65F39;\r\n--soft:rgba(224,138,107,.14);--ok:#6CC59A;--warn:#E0B060;--err:#EE8A78;--tbg:#F2F0E8;--ttx:#1F1E1D;\r\n--shadow:0 1px 2px rgba(0,0,0,.3),0 8px 28px rgba(0,0,0,.45)}}\r\n\r\n*{box-sizing:border-box;margin:0}\r\nhtml,body{height:100%}\r\nbody{display:flex;background:var(--bg);color:var(--txt);font:14px/1.5 var(--sans);-webkit-font-smoothing:antialiased}\r\n::-webkit-scrollbar{width:10px;height:10px}::-webkit-scrollbar-thumb{background:var(--line);border-radius:10px;border:2px solid transparent;background-clip:content-box}::-webkit-scrollbar-thumb:hover{background:var(--line2);background-clip:content-box}\r\n:focus-visible{outline:2px solid var(--acc);outline-offset:2px}\r\n.ic{width:16px;height:16px;flex:none}\r\ncode{font:12.5px Consolas,monospace;background:var(--hover);padding:1px 5px;border-radius:5px}\r\n\r\n/* barre latérale */\r\naside{width:264px;background:var(--side);border-right:1px solid var(--line);display:flex;flex-direction:column;padding:14px 12px;gap:10px;flex:none}\r\n.brand{display:flex;align-items:center;gap:10px;padding:4px 8px 6px}\r\n.brand svg{width:26px;height:26px;color:var(--acc)}\r\nh1{font:500 22px var(--serif);letter-spacing:-.01em}\r\n#list{flex:1;overflow:auto;margin:0 -4px;padding:0 4px}\r\n.grp{color:var(--dim);font-size:11.5px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;padding:14px 10px 4px}\r\n.acc{display:flex;align-items:center;gap:9px;padding:7px 10px;border-radius:8px;cursor:pointer;min-height:34px}\r\n.acc:hover{background:var(--hover)}.acc.on{background:var(--sel);font-weight:500}\r\n.dot{width:8px;height:8px;border-radius:50%;flex:none}\r\n.acc span{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\r\n.acc b{display:none;font-weight:400;color:var(--dim);padding:3px;border-radius:6px;line-height:0}\r\n.acc:hover b{display:block}.acc b:hover{color:var(--txt);background:var(--hover)}.acc b[data-del]:hover{color:var(--err)}\r\n.bd{display:inline-flex;font-style:normal;color:var(--dim)}.bd.err{color:var(--err)}.bd.warn{color:var(--warn)}\r\n.spin{width:12px;height:12px;border:2px solid var(--line2);border-top-color:var(--acc);border-radius:50%;animation:rot .8s linear infinite;flex:none}\r\n@keyframes rot{to{transform:rotate(360deg)}}\r\n\r\n/* boutons et champs */\r\n.btn{font:inherit;font-weight:500;color:var(--txt);background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:7px 12px;cursor:pointer;display:inline-flex;align-items:center;gap:7px;transition:background .12s,border-color .12s}\r\n.btn:hover{background:var(--hover);border-color:var(--line2)}\r\n.btn.pri{background:var(--btn);border-color:var(--btn);color:#fff}.btn.pri:hover{background:var(--btnh);border-color:var(--btnh)}\r\n.btn.ghost{background:transparent;border-color:transparent}.btn.ghost:hover{background:var(--hover)}\r\n.btn.wide{width:100%;justify-content:center}.btn.wide.left{justify-content:flex-start}\r\n.btn:disabled{opacity:.5;cursor:default}\r\nselect,input:not([type=checkbox]),textarea{padding:8px 10px;background:var(--panel);color:var(--txt);border:1px solid var(--line);border-radius:8px;font:inherit}\r\nselect{padding-right:6px}\r\ntextarea,pre{font:13px Consolas,monospace}\r\ninput::placeholder,textarea::placeholder{color:var(--dim)}\r\npre{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:12px;overflow:auto;white-space:pre-wrap;line-height:1.5}\r\ndetails{margin:12px 0}summary{cursor:pointer;color:var(--acc);font-weight:500}\r\n\r\n/* zone principale */\r\nmain{flex:1;display:flex;flex-direction:column;min-width:0}\r\nheader{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 16px;border-bottom:1px solid var(--line);min-height:56px}\r\nheader strong{font-weight:500;font-size:15px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\r\n.hbtns{display:flex;gap:6px;flex:none}\r\n#ask{display:flex;align-items:center;gap:12px;flex-wrap:wrap;padding:10px 16px;background:var(--soft);border-bottom:1px solid var(--line)}\r\n#ask[hidden]{display:none}#ask span{flex:1;min-width:200px}\r\n#views{flex:1;position:relative;background:var(--bg)}\r\nwebview{position:absolute;inset:0;width:100%;height:100%;display:none;background:var(--bg)}\r\nwebview.on{display:flex}\r\n#empty{position:absolute;inset:0;display:grid;place-items:center;text-align:center;padding:40px}\r\n#empty div{max-width:420px}\r\n#empty h2{font:500 28px var(--serif);letter-spacing:-.01em;margin-bottom:8px}\r\n#empty p{color:var(--dim);margin-bottom:18px}\r\n#bar{position:absolute;top:0;left:0;right:0;height:2px;z-index:6;overflow:hidden;display:none}\r\n#bar.on{display:block}#bar i{display:block;height:100%;width:35%;background:var(--acc);animation:slide 1s infinite ease-in-out}\r\n@keyframes slide{from{transform:translateX(-100%)}to{transform:translateX(300%)}}\r\n\r\n/* paramètres */\r\n#set{position:absolute;inset:0;z-index:5;background:var(--bg);display:none}\r\n#set.on{display:grid;grid-template-columns:250px 1fr}\r\n.snav{border-right:1px solid var(--line);background:var(--side);padding:22px 12px;display:flex;flex-direction:column;gap:2px;overflow:auto}\r\n.snav h2{font:500 22px var(--serif);padding:0 10px 14px}\r\n.snav button{font:inherit;text-align:left;background:none;border:0;color:var(--dim);padding:8px 10px;border-radius:8px;cursor:pointer}\r\n.snav button:hover{background:var(--hover);color:var(--txt)}.snav button.on{background:var(--sel);color:var(--txt);font-weight:500}\r\n.sgrp{color:var(--dim);font-size:11.5px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;padding:16px 10px 4px}\r\n.dev-only{display:none}body.dev .dev-only{display:block}\r\n.spanes{overflow:auto}\r\n.pane{display:none;padding:28px 40px 56px;max-width:840px}.pane.on{display:block}\r\n.pane h2{font:500 28px var(--serif);letter-spacing:-.01em;margin-bottom:6px}\r\n.pane h3{font-size:14px;font-weight:600;margin:26px 0 6px}\r\n.pane p,.dim,.lead{color:var(--dim);line-height:1.55}\r\n.pane p{margin:4px 0}\r\n.warn{color:var(--warn);margin:8px 0}\r\n.card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:4px 18px;margin:8px 0}\r\n.card.pad{padding:16px 18px}\r\n.opt{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:14px 0;border-bottom:1px solid var(--line);cursor:pointer}\r\n.opt:last-child{border-bottom:0}.opt.nc{cursor:default}\r\n.opt b{font-weight:500}.opt small{display:block;color:var(--dim);font-size:12.5px;margin-top:2px;line-height:1.45}\r\n.opt.off{opacity:.55}\r\n.sw{appearance:none;-webkit-appearance:none;width:38px;height:22px;padding:0;border:0;border-radius:22px;background:var(--line2);position:relative;cursor:pointer;flex:none;transition:background .15s}\r\n.sw::after{content:\"\";position:absolute;top:3px;left:3px;width:16px;height:16px;border-radius:50%;background:#fff;transition:transform .15s;box-shadow:0 1px 2px rgba(0,0,0,.25)}\r\n.sw:checked{background:var(--btn)}.sw:checked::after{transform:translateX(16px)}\r\n.seg{display:inline-flex;background:var(--hover);border-radius:10px;padding:3px;gap:2px}\r\n.seg button{font:inherit;border:0;background:none;color:var(--dim);padding:5px 14px;border-radius:8px;cursor:pointer}\r\n.seg button.on{background:var(--panel);color:var(--txt);box-shadow:0 1px 2px rgba(0,0,0,.14);font-weight:500}\r\n.line{display:flex;gap:8px;align-items:center;margin:10px 0;flex-wrap:wrap}\r\n.pill{display:inline-block;font-size:12px;font-weight:500;padding:2px 9px;border-radius:20px;background:var(--hover);color:var(--dim)}\r\n.pill.ok{background:rgba(47,125,91,.14);color:var(--ok)}.pill.no{background:rgba(179,65,47,.13);color:var(--err)}\r\n#code{width:100%;height:42vh;resize:vertical;white-space:pre;tab-size:2}\r\n.ev{display:grid;grid-template-columns:170px 1fr;gap:3px 12px;font-size:13px}.ev code{color:var(--acc);background:none;padding:0}\r\n.row2{display:grid;grid-template-columns:1.1fr 1fr 2fr 1fr auto;gap:6px;margin:6px 0}\r\n#logl{max-height:46vh;overflow:auto}\r\n#custom{width:100%;height:190px;resize:vertical}\r\n\r\n/* fenêtres, bulle */\r\ndialog{margin:auto;background:var(--panel);color:var(--txt);border:1px solid var(--line);border-radius:16px;padding:22px;width:380px;box-shadow:var(--shadow)}\r\ndialog::backdrop{background:rgba(0,0,0,.45)}\r\ndialog h3{font:500 20px var(--serif);margin-bottom:6px}\r\ndialog label{display:block;margin:14px 0 4px;color:var(--dim)}\r\ndialog label.inl{display:flex;align-items:center;gap:8px;color:var(--txt)}\r\ndialog select,dialog input:not([type=checkbox]){width:100%}\r\n.row{display:flex;gap:8px;justify-content:flex-end;margin-top:20px}\r\n#toast{position:fixed;bottom:24px;left:50%;transform:translate(-50%,20px);background:var(--tbg);color:var(--ttx);padding:10px 16px;border-radius:10px;font-weight:500;opacity:0;pointer-events:none;transition:.2s;z-index:99;max-width:70vw;box-shadow:var(--shadow)}\r\n#toast.show{opacity:1;transform:translate(-50%,0)}\r\n@media (prefers-reduced-motion:reduce){#toast{transition:none}.spin{animation-duration:2.4s}}\r\n\r\n/* écran de démarrage */\r\n#splash{position:fixed;inset:0;z-index:50;background:var(--bg);display:flex;flex-direction:column;align-items:center;justify-content:center;transition:opacity .5s,transform .5s}\r\n#splash.out{opacity:0;transform:scale(1.04);pointer-events:none}\r\n#splash svg{width:150px;height:150px;overflow:visible}\r\n#splash .ln{stroke:var(--acc);stroke-width:4;stroke-linecap:round;stroke-dasharray:140;stroke-dashoffset:140;animation:draw .7s ease-out forwards}\r\n#splash .nd,#splash .ct,#splash .rg{transform-box:fill-box;transform-origin:center}\r\n#splash .nd{fill:var(--acc);transform:scale(0);animation:pop .45s cubic-bezier(.2,1.6,.4,1) forwards}\r\n#splash .ct{fill:var(--txt);animation:beat 1.4s ease-in-out .9s infinite}\r\n#splash .rg{fill:none;stroke:var(--acc);stroke-width:2;opacity:0;animation:ring 1.6s ease-out .9s infinite}\r\n#splash .wm{margin-top:24px;font:500 24px var(--serif);letter-spacing:.3em;text-indent:.3em;opacity:0;transform:translateY(8px);animation:rise .6s .7s forwards}\r\n@keyframes draw{to{stroke-dashoffset:0}}@keyframes pop{to{transform:scale(1)}}@keyframes beat{50%{transform:scale(1.18)}}\r\n@keyframes ring{0%{opacity:.7;transform:scale(1)}100%{opacity:0;transform:scale(3.4)}}@keyframes rise{to{opacity:1;transform:none}}\r\n@media (prefers-reduced-motion:reduce){#splash *{animation-duration:.01s!important;animation-delay:0s!important}}\r\n\r\n/* ===== 2.2.2 : animations, thème, page Fichiers ===== */\r\n:root{--ease:cubic-bezier(.2,.8,.2,1);--spring:cubic-bezier(.3,1.4,.5,1)}\r\n.themeswap,.themeswap *{transition:background-color .38s ease,color .38s ease,border-color .38s ease,fill .38s ease,stroke .38s ease,box-shadow .38s ease!important}\r\n@keyframes pagein{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}\r\n@keyframes fadein{from{opacity:0}to{opacity:1}}\r\n@keyframes itemin{from{opacity:0;transform:translateX(-10px)}to{opacity:1;transform:none}}\r\n@keyframes cardin{from{opacity:0;transform:translateY(16px) scale(.97)}to{opacity:1;transform:none}}\r\n@keyframes dlgin{from{opacity:0;transform:translateY(14px) scale(.96)}to{opacity:1;transform:none}}\r\n@keyframes menuin{from{opacity:0;transform:translateY(-6px) scale(.96)}to{opacity:1;transform:none}}\r\n@keyframes askin{from{opacity:0;transform:translateY(-8px)}to{opacity:1;transform:none}}\r\n@keyframes floaty{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}\r\n@keyframes pulsebd{0%,100%{border-color:var(--acc)}50%{border-color:transparent}}\r\n\r\n.brand svg{transition:transform .8s var(--spring)}.brand:hover svg{transform:rotate(60deg) scale(1.06)}\r\n.acc{transition:background .15s,transform .2s var(--ease)}.acc:hover{transform:translateX(2px)}\r\n.acc.enter{animation:itemin .42s var(--ease) backwards;animation-delay:calc(var(--i,0)*50ms)}\r\n.grp.enter{animation:fadein .6s ease backwards}\r\n.acc.on .dot{box-shadow:0 0 0 3px var(--soft)}.dot{transition:box-shadow .25s}\r\n.btn{transition:background .15s,border-color .15s,transform .18s var(--ease),box-shadow .22s}\r\n.btn:active{transform:scale(.97)}\r\n.btn.pri:hover{box-shadow:0 5px 16px rgba(181,83,47,.30);transform:translateY(-1px)}\r\n.btn.pri:active{transform:scale(.97)}\r\n.btn.on{background:var(--sel)}\r\n#set.on{animation:pagein .36s var(--ease) backwards}\r\n.pane.on{animation:pagein .4s var(--ease) backwards}\r\n#empty>div{animation:pagein .7s var(--ease) backwards}\r\n.sw{transition:background .2s}.sw::after{transition:transform .28s var(--spring),width .15s}\r\n.sw:active::after{width:20px}.sw:checked:active::after{transform:translateX(12px)}\r\n.card{transition:border-color .2s,box-shadow .25s}.card:hover{border-color:var(--line2)}\r\n.seg{position:relative}\r\n.seg .ind{position:absolute;top:3px;bottom:3px;left:0;width:var(--w,0);transform:translateX(var(--x,0));background:var(--panel);border-radius:8px;box-shadow:0 1px 2px rgba(0,0,0,.14);transition:transform .32s var(--spring),width .32s var(--ease);pointer-events:none}\r\n.seg button{position:relative;z-index:1;transition:color .2s}\r\n.seg button.on{background:none!important;box-shadow:none!important}\r\ndialog[open]{animation:dlgin .3s var(--ease)}\r\ndialog[open]::backdrop{animation:fadein .25s ease;backdrop-filter:blur(2px)}\r\n#ask:not([hidden]){animation:askin .4s var(--ease)}\r\n\r\n.foot{display:flex;gap:6px;align-items:center}\r\n.foot #gear{flex:1;min-width:0;width:auto}\r\n.btn.ic-only{padding:8px;line-height:0}\r\n.tg{position:relative;width:16px;height:16px;display:block}\r\n.tg>span{position:absolute;inset:0;display:block;transition:transform .6s var(--spring),opacity .3s ease}\r\n.tg .moon{opacity:0;transform:rotate(-80deg) scale(.3)}\r\n:root[data-eff=dark] .tg .sun{opacity:0;transform:rotate(80deg) scale(.3)}\r\n:root[data-eff=dark] .tg .moon{opacity:1;transform:none}\r\n#filesbtn .pill{margin-left:auto}.pill:empty{display:none}\r\n\r\n#files{position:absolute;inset:0;z-index:5;background:var(--bg);display:none;overflow:auto;padding:30px 40px 56px}\r\n#files.on{display:block;animation:pagein .38s var(--ease) backwards}\r\n.fhead{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;flex-wrap:wrap;margin-bottom:22px}\r\n.fhead h2{font:500 30px var(--serif);letter-spacing:-.01em}\r\n.fhead p{color:var(--dim);margin-top:4px;max-width:540px}\r\n.fact{display:flex;gap:10px;align-items:center;flex-wrap:wrap}\r\n.fsearch{position:relative;display:flex;align-items:center}\r\n.fsearch .ic{position:absolute;left:11px;color:var(--dim);pointer-events:none}\r\n.fsearch input{padding-left:34px;width:220px;transition:border-color .15s,box-shadow .2s,width .28s var(--ease)}\r\n.fsearch input:focus{outline:none;border-color:var(--acc);box-shadow:0 0 0 3px var(--soft);width:280px}\r\n#fgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:14px}\r\n.fcard{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:14px;display:flex;flex-direction:column;gap:6px;min-width:0;transition:transform .26s var(--ease),box-shadow .26s,border-color .2s;animation:cardin .5s var(--ease) backwards;animation-delay:calc(min(var(--i,0),14)*38ms)}\r\n.fcard:hover{transform:translateY(-3px);box-shadow:var(--shadow);border-color:var(--line2)}\r\n#fgrid.noanim .fcard{animation:none}\r\n.ftile{width:46px;height:46px;border-radius:12px;display:grid;place-items:center;font:600 12px var(--sans);letter-spacing:.04em;color:var(--tint,var(--dim));background:var(--soft);background:color-mix(in srgb,var(--tint,var(--dim)) 15%,transparent);margin-bottom:6px;transition:transform .35s var(--spring)}\r\n.fcard:hover .ftile{transform:scale(1.08) rotate(-3deg)}\r\n.k-image{--tint:#5B8FD0}.k-pdf{--tint:#D4604A}.k-doc{--tint:#4F86D9}.k-sheet{--tint:#3F9A6A}.k-code{--tint:#9A78D2}.k-zip{--tint:#C4902F}.k-txt{--tint:#8A877D}\r\n.fthumb{height:112px;border-radius:10px;overflow:hidden;background:var(--hover);margin-bottom:6px}\r\n.fthumb img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .6s var(--ease)}\r\n.fcard:hover .fthumb img{transform:scale(1.06)}\r\n.fname{font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\r\n.fmeta{color:var(--dim);font-size:12.5px}\r\n.fact2{display:flex;gap:4px;align-items:center;margin-top:8px}\r\n.fact2 .btn.sm:first-child{flex:1;justify-content:center}\r\n.btn.sm{padding:5px 9px;font-size:13px}.btn.ico{padding:6px;line-height:0}\r\n.btn.ico.del:hover{color:var(--err)}\r\n#fempty{display:none;place-items:center;text-align:center;padding:70px 20px}\r\n#fempty>div{max-width:380px}\r\n#fempty .big{width:84px;height:84px;margin:0 auto 18px;border-radius:24px;display:grid;place-items:center;color:var(--acc);background:var(--soft);animation:floaty 3.4s ease-in-out infinite}\r\n#fempty .big .ic{width:38px;height:38px}\r\n#fempty h3{font:500 22px var(--serif);margin-bottom:6px}\r\n#fempty p{color:var(--dim);margin-bottom:16px}\r\n#fdrop{position:fixed;top:68px;left:276px;right:12px;bottom:12px;border:2px dashed var(--acc);border-radius:20px;background:var(--soft);backdrop-filter:blur(3px);display:grid;place-items:center;text-align:center;opacity:0;pointer-events:none;transform:scale(.985);transition:opacity .2s,transform .28s var(--ease);z-index:7}\r\n#fdrop.on{opacity:1;transform:none;animation:pulsebd 1.5s ease-in-out infinite}\r\n#fdrop b{display:block;font:500 22px var(--serif);margin-top:10px}#fdrop span{color:var(--dim)}\r\n#fdrop .ic{width:42px;height:42px;color:var(--acc);animation:floaty 1.6s ease-in-out infinite}\r\n#fmenu{position:fixed;z-index:80;width:260px;max-height:50vh;overflow:auto;background:var(--panel);border:1px solid var(--line);border-radius:12px;box-shadow:var(--shadow);padding:6px}\r\n#fmenu[hidden]{display:none}#fmenu.in{animation:menuin .18s var(--ease)}\r\n#fmenu .mt{color:var(--dim);font-size:11.5px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;padding:6px 10px 4px}\r\n#fmenu button{font:inherit;color:var(--txt);width:100%;display:flex;align-items:center;gap:9px;padding:8px 10px;border:0;background:none;border-radius:8px;cursor:pointer;text-align:left;transition:background .12s}\r\n#fmenu button:hover{background:var(--hover)}\r\n#fmenu button span{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\r\n#fmenu button em{font-style:normal;font-size:11.5px;color:var(--acc);font-weight:500}\r\n@media (prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-delay:0s!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}\r\n/* 2.2.4 : projets */\r\n#fprojs{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 16px}\r\n.chip{font:inherit;font-size:13px;color:var(--txt);background:var(--panel);border:1px solid var(--line);border-radius:999px;padding:5px 12px;cursor:pointer;display:inline-flex;align-items:center;gap:6px;transition:background .15s,border-color .15s,transform .18s var(--ease)}\r\n.chip:hover{background:var(--hover);transform:translateY(-1px)}\r\n.chip .ic{width:14px;height:14px}\r\n.chip i{font-style:normal;font-size:11.5px;color:var(--dim)}\r\n.chip.on{background:var(--soft);border-color:var(--acc);color:var(--acc)}.chip.on i{color:var(--acc)}\r\n.chip.add{border-style:dashed;color:var(--dim)}\r\n#fpedit{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:14px;margin:0 0 18px;display:flex;flex-direction:column;gap:10px}\r\n#fpedit[hidden]{display:none}\r\n#fpedit .pe-row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}\r\n#fpedit input,#fpedit textarea{font:inherit;color:var(--txt);background:var(--bg);border:1px solid var(--line);border-radius:8px;padding:7px 10px;outline:none;min-width:0}\r\n#fpedit input{flex:1}#fpedit textarea{resize:vertical;width:100%;box-sizing:border-box}\r\n#fpedit input:focus,#fpedit textarea:focus{border-color:var(--acc)}\r\n#psum{margin:0;white-space:pre-wrap;font:12.5px/1.5 inherit;color:var(--dim);background:var(--bg);border:1px solid var(--line);border-radius:8px;padding:9px 11px;max-height:190px;overflow:auto}\r\n.psel{font:inherit;font-size:12px;color:var(--dim);background:var(--bg);border:1px solid var(--line);border-radius:8px;padding:4px 6px;margin-top:2px;max-width:100%;cursor:pointer}\r\n.psel:hover{border-color:var(--acc)}\r\n/* 2.2.6 : cartes fichiers façon Claude, icônes animées, couleurs personnalisables */\r\n#fgrid{grid-template-columns:repeat(auto-fill,minmax(290px,1fr))}\r\n.fcard .frow{display:flex;gap:13px;align-items:center;min-width:0}\r\n.fcard .fbody{min-width:0;flex:1;display:flex;flex-direction:column;gap:1px}\r\n.ftile{--sp:2.6s;width:52px;height:60px;flex:none;margin:0;border-radius:13px;color:var(--tint);display:grid;place-items:center;position:relative;overflow:hidden;\r\n  border:1px solid color-mix(in srgb,var(--tint) 55%,transparent);\r\n  background:linear-gradient(160deg,color-mix(in srgb,var(--tint) 38%,var(--panel)),color-mix(in srgb,var(--tint) 9%,var(--panel)) 85%);\r\n  box-shadow:0 0 0 0 color-mix(in srgb,var(--tint) 0%,transparent),inset 0 1px 0 color-mix(in srgb,var(--tint) 35%,transparent);\r\n  animation:ficGlow calc(var(--sp)*1.6) ease-in-out infinite;transition:transform .35s var(--spring)}\r\n.ftile::after{content:\"\";position:absolute;inset:0;background:linear-gradient(115deg,transparent 35%,color-mix(in srgb,var(--tint) 40%,#fff) 50%,transparent 65%);opacity:0;transform:translateX(-100%)}\r\n:is(.fcard,.fc-item):hover .ftile{--sp:1s;transform:translateY(-2px) rotate(-2.5deg) scale(1.05)}\r\n:is(.fcard,.fc-item):hover .ftile::after{animation:ficShine 1.1s ease-out}\r\n.fic{width:26px;height:26px;overflow:visible;position:relative;z-index:1;filter:drop-shadow(0 0 5px color-mix(in srgb,var(--tint) 55%,transparent))}\r\n.fic *{transform-box:fill-box;transform-origin:center}\r\n.fcard .fthumb{width:52px;height:60px;flex:none;margin:0;border-radius:13px;border:1px solid var(--line)}\r\n@keyframes ficGlow{0%,100%{box-shadow:0 0 0 0 color-mix(in srgb,var(--tint) 0%,transparent),inset 0 1px 0 color-mix(in srgb,var(--tint) 35%,transparent)}50%{box-shadow:0 0 16px 0 color-mix(in srgb,var(--tint) 38%,transparent),inset 0 1px 0 color-mix(in srgb,var(--tint) 35%,transparent)}}\r\n@keyframes ficShine{to{transform:translateX(100%);opacity:.55}}\r\n@keyframes ficSpinA{0%{transform:scaleX(1)}50%{transform:scaleX(.04)}100%{transform:scaleX(1)}}\r\n@keyframes ficSpinB{0%{transform:scaleX(.04)}50%{transform:scaleX(1)}100%{transform:scaleX(.04)}}\r\n@keyframes ficSun{0%,100%{transform:translate(0,0) scale(1)}50%{transform:translate(7px,-1px) scale(1.25)}}\r\n@keyframes ficDraw{0%{stroke-dasharray:1 1;stroke-dashoffset:1}55%,85%{stroke-dasharray:1 1;stroke-dashoffset:0}100%{stroke-dasharray:1 1;stroke-dashoffset:-1}}\r\n@keyframes ficBrL{0%,100%{transform:translateX(0) rotate(0)}50%{transform:translateX(-2.8px) rotate(-7deg)}}\r\n@keyframes ficBrR{0%,100%{transform:translateX(0) rotate(0)}50%{transform:translateX(2.8px) rotate(7deg)}}\r\n@keyframes ficChL{0%,100%{transform:translateX(0)}50%{transform:translateX(-3px)}}\r\n@keyframes ficChR{0%,100%{transform:translateX(0)}50%{transform:translateX(3px)}}\r\n@keyframes ficSlash{0%,100%{transform:rotate(0) scaleY(1)}50%{transform:rotate(14deg) scaleY(1.12)}}\r\n@keyframes ficLid{0%,18%,100%{transform:rotate(0) translateY(0)}45%,70%{transform:rotate(-16deg) translate(-1px,-2.5px)}}\r\n@keyframes ficItem{0%,18%,100%{transform:translateY(2px);opacity:0}45%,70%{transform:translateY(-5px);opacity:1}}\r\n@keyframes ficZip{0%,100%{opacity:1}50%{opacity:.2}}\r\n@keyframes ficCell{0%,100%{opacity:0}40%{opacity:.5}}\r\n@keyframes ficBar{0%,100%{transform:scaleY(.3)}50%{transform:scaleY(1.15)}}\r\n@keyframes ficPlay{0%,100%{transform:scale(1)}50%{transform:scale(1.28)}}\r\n@keyframes ficRing{0%{transform:scale(.6);opacity:.9}100%{transform:scale(2.1);opacity:0}}\r\n@keyframes ficFold{0%,100%{transform:rotate(0)}50%{transform:rotate(-14deg) scale(1.2)}}\r\n/* 2.2.7 : AU REPOS = animations douces et lentes ; AU SURVOL = animations complètes, différentes */\r\n@keyframes ficIdleFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-1.4px)}}\r\n@keyframes ficIdleSun{0%,100%{transform:translateY(0)}50%{transform:translateY(-1.8px)}}\r\n@keyframes ficIdleBr{0%,100%{transform:scale(1)}50%{transform:scale(1.07)}}\r\n@keyframes ficIdleFade{0%,100%{opacity:1}50%{opacity:.4}}\r\n@keyframes ficIdleLid{0%,100%{transform:rotate(0)}50%{transform:rotate(-4deg)}}\r\n@keyframes ficIdleBar{0%,100%{transform:scaleY(.6)}50%{transform:scaleY(.95)}}\r\n@keyframes ficIdlePlay{0%,100%{transform:scale(1)}50%{transform:scale(1.1)}}\r\n@keyframes ficTilt{0%,100%{transform:rotate(0)}25%{transform:rotate(-9deg)}75%{transform:rotate(9deg)}}\r\n.fic{animation:ficIdleFloat calc(var(--sp)*1.4) ease-in-out infinite}\r\n.ik-web .a{animation:ficSpinA calc(var(--sp)*2.4) linear infinite}.ik-web .b{animation:ficSpinB calc(var(--sp)*2.4) linear infinite}\r\n.ik-vector .a,.ik-image .a{animation:ficIdleSun calc(var(--sp)*1.3) ease-in-out infinite}\r\n.ik-braces .a,.ik-braces .b{animation:ficIdleBr calc(var(--sp)*1.4) ease-in-out infinite}\r\n.ik-code .a,.ik-code .b{animation:ficIdleFade calc(var(--sp)*1.2) ease-in-out infinite}.ik-code .b{animation-delay:.6s}\r\n.ik-zip .a{animation:ficIdleLid calc(var(--sp)*1.3) ease-in-out infinite;transform-origin:left bottom}.ik-zip .c{opacity:0}\r\n.ik-pdf .b,.ik-doc .c,.ik-txt .c{animation:ficIdleFade calc(var(--sp)*.7) ease-in-out infinite}\r\n.ik-sheet .a{animation:ficCell calc(var(--sp)*1.8) ease-in-out infinite}.ik-sheet .b,.ik-sheet .c{opacity:0}\r\n.ik-audio .a,.ik-audio .b,.ik-audio .c{animation:ficIdleBar calc(var(--sp)*.9) ease-in-out infinite}.ik-audio .b{animation-delay:.2s}.ik-audio .c{animation-delay:.4s}\r\n.ik-video .a{animation:ficIdlePlay calc(var(--sp)*1.2) ease-in-out infinite}\r\n.ik-file .a{animation:ficIdleFade calc(var(--sp)*1.2) ease-in-out infinite}\r\n:is(.fcard,.fc-item):hover .fic{animation:none}\r\n:is(.fcard,.fc-item):hover .ik-web .fic{animation:ficTilt calc(var(--sp)*2.2) ease-in-out infinite}\r\n:is(.fcard,.fc-item):hover .ik-web .a{animation:ficSpinA var(--sp) linear infinite}:is(.fcard,.fc-item):hover .ik-web .b{animation:ficSpinB var(--sp) linear infinite}\r\n:is(.fcard,.fc-item):hover :is(.ik-vector,.ik-image) .a{animation:ficSun calc(var(--sp)*1.5) ease-in-out infinite}\r\n:is(.fcard,.fc-item):hover :is(.ik-vector,.ik-image) .b{animation:ficDraw calc(var(--sp)*1.4) ease-in-out infinite}\r\n:is(.fcard,.fc-item):hover .ik-braces .a{animation:ficBrL var(--sp) ease-in-out infinite}:is(.fcard,.fc-item):hover .ik-braces .b{animation:ficBrR var(--sp) ease-in-out infinite}\r\n:is(.fcard,.fc-item):hover .ik-code .a{animation:ficChL var(--sp) ease-in-out infinite}:is(.fcard,.fc-item):hover .ik-code .b{animation:ficChR var(--sp) ease-in-out infinite}:is(.fcard,.fc-item):hover .ik-code .c{animation:ficSlash var(--sp) ease-in-out infinite}\r\n:is(.fcard,.fc-item):hover .ik-zip .a{animation:ficLid calc(var(--sp)*1.5) ease-in-out infinite;transform-origin:left bottom}:is(.fcard,.fc-item):hover .ik-zip .c{animation:ficItem calc(var(--sp)*1.5) ease-in-out infinite}:is(.fcard,.fc-item):hover .ik-zip .b{animation:ficZip var(--sp) ease-in-out infinite}\r\n:is(.fcard,.fc-item):hover :is(.ik-pdf,.ik-doc,.ik-txt) :is(.a,.b,.c),:is(.fcard,.fc-item):hover .ik-file .b{stroke-dasharray:1 1;animation:ficDraw calc(var(--sp)*1.6) ease-in-out infinite}\r\n:is(.fcard,.fc-item):hover :is(.ik-pdf,.ik-doc,.ik-txt) .b,:is(.fcard,.fc-item):hover :is(.ik-pdf,.ik-doc,.ik-txt) .c{animation-delay:.25s}:is(.fcard,.fc-item):hover :is(.ik-doc,.ik-txt) .c{animation-delay:.5s}\r\n:is(.fcard,.fc-item):hover .ik-sheet .a{animation:ficCell calc(var(--sp)*1.5) ease-in-out infinite}:is(.fcard,.fc-item):hover .ik-sheet .b{animation:ficCell calc(var(--sp)*1.5) .3s ease-in-out infinite}:is(.fcard,.fc-item):hover .ik-sheet .c{animation:ficCell calc(var(--sp)*1.5) .6s ease-in-out infinite}\r\n:is(.fcard,.fc-item):hover .ik-audio :is(.a,.b,.c){animation:ficBar calc(var(--sp)*.55) ease-in-out infinite}:is(.fcard,.fc-item):hover .ik-audio .b{animation-delay:.15s}:is(.fcard,.fc-item):hover .ik-audio .c{animation-delay:.3s}\r\n:is(.fcard,.fc-item):hover .ik-video .a{animation:ficPlay var(--sp) ease-in-out infinite}:is(.fcard,.fc-item):hover .ik-video .b{animation:ficRing var(--sp) ease-out infinite}\r\n:is(.fcard,.fc-item):hover .ik-file .a{animation:ficFold calc(var(--sp)*1.2) ease-in-out infinite;transform-origin:top right}\r\n/* 2.2.9 : sélection groupée */\r\n.chipw{display:inline-flex;align-items:center;gap:2px}\r\n.chipsel{font:inherit;font-size:15px;line-height:1;color:var(--dim);background:transparent;border:0;border-radius:8px;padding:4px 5px;cursor:pointer}\r\n.chipsel:hover:not(:disabled){background:var(--hover);color:var(--acc)}.chipsel.on{color:var(--acc)}.chipsel:disabled{opacity:.3;cursor:default}\r\n#fselbar{display:flex;align-items:center;gap:10px;flex-wrap:wrap;background:var(--soft);border:1px solid var(--acc);border-radius:12px;padding:8px 14px;margin:0 0 14px;font-size:13px}\r\n#fselbar[hidden]{display:none}#fselbar .sp{flex:1}\r\n.fcard{position:relative}.fcard.sel{border-color:var(--acc);box-shadow:0 0 0 1px var(--acc) inset}\r\n.fck{position:absolute;top:8px;right:8px;z-index:2;display:flex;cursor:pointer}.fck input{width:16px;height:16px;accent-color:var(--acc);cursor:pointer;margin:0}\r\n/* 2.2.8 : classement automatique */\r\n#fauto{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:12px 14px;margin:0 0 14px}\r\n#fauto[hidden]{display:none}\r\n#fauto .ap-h{display:flex;align-items:center;gap:10px;margin-bottom:6px}\r\n#fauto .ap{border-top:1px solid var(--line);padding:8px 0}\r\n#fauto .ap label{display:flex;align-items:center;gap:8px;font-size:13px;flex-wrap:wrap}\r\n#fauto .apn{font-weight:600}\r\n#fauto .apin{font:inherit;font-size:13px;font-weight:600;color:var(--txt);background:var(--bg);border:1px solid var(--line);border-radius:8px;padding:3px 8px;min-width:160px}\r\n#fauto .tag{font-style:normal;font-size:11px;color:var(--acc);background:var(--soft);border-radius:999px;padding:2px 8px}\r\n#fauto ul{margin:4px 0 0 26px;padding:0;list-style:none;font-size:12px;color:var(--dim)}\r\n#fauto .ap-f{display:flex;align-items:center;gap:8px;flex-wrap:wrap;border-top:1px solid var(--line);padding-top:10px;margin-top:4px}\r\n#fauto .ap-f .sp{flex:1}\r\n/* 2.2.7 : limite avec heure de retour, scanner */\r\n.bd .until{font-size:11px;font-weight:600;margin-left:3px;font-variant-numeric:tabular-nums}\r\n.bd.err{align-items:center}\r\n#fscan{display:flex;align-items:center;gap:12px;flex-wrap:wrap;background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:10px 14px;margin:0 0 14px}\r\n#fscan[hidden]{display:none}\r\n#fscan .st{font-size:13px;flex:1;min-width:200px}\r\n#fscan .pb{flex:1 1 160px;height:6px;border-radius:6px;background:var(--line);overflow:hidden}#fscan .pb i{display:block;height:100%;width:0;background:var(--acc);transition:width .25s}\r\n#fscan pre{flex:1 1 100%;margin:2px 0 0;font-size:12px;white-space:pre-wrap;max-height:150px;overflow:auto;color:var(--dim)}\r\n#ficols{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:14px;margin:0 0 18px}\r\n#ficols[hidden]{display:none}\r\n.fc-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px;flex-wrap:wrap}\r\n.fc-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:10px}\r\n.fc-item{display:flex;align-items:center;gap:11px;padding:8px;border:1px solid var(--line);border-radius:12px;cursor:pointer}\r\n.fc-item .ftile{width:40px;height:46px;border-radius:10px}.fc-item .fic{width:21px;height:21px}\r\n.fc-n{flex:1;font-size:13px;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\r\n.fc-item input[type=color]{width:34px;height:30px;padding:0;border:1px solid var(--line);border-radius:8px;background:none;cursor:pointer}\r\n\r\n/* 2.3.0 */\r\n#ftools{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin:0 0 14px}\r\n#ftools select,.finp{font:inherit;font-size:13px;color:var(--txt);background:var(--panel);border:1px solid var(--line);border-radius:9px;padding:6px 9px;outline:none;cursor:pointer}\r\n.finp{cursor:text;min-width:140px}.finp:focus,#ftools select:hover{border-color:var(--acc)}\r\n#ftools .sp{flex:1}\r\n#ftools .vt{display:inline-flex;border:1px solid var(--line);border-radius:9px;overflow:hidden}\r\n#ftools .vt button{font:inherit;background:var(--panel);color:var(--dim);border:0;padding:6px 10px;cursor:pointer}#ftools .vt button.on{background:var(--soft);color:var(--acc)}\r\n#fgrid.list{grid-template-columns:1fr;gap:8px}\r\n#fgrid.list .fcard{flex-direction:row;align-items:center;gap:14px;padding:10px 14px}\r\n#fgrid.list .fcard .frow{flex:1}#fgrid.list .fact2{margin:0}\r\n#fgrid.list .fthumb{width:52px;height:52px;margin:0;flex:none}\r\n.ftags{display:flex;flex-wrap:wrap;gap:4px;margin-top:3px}\r\n.ftag{font:inherit;font-size:11.5px;color:var(--acc);background:var(--soft);border:0;border-radius:999px;padding:1px 8px;cursor:pointer}\r\n.ftag.add{color:var(--dim);background:transparent;border:1px dashed var(--line)}\r\n.fstar{color:var(--dim)}.fstar.on{color:#E0A526}\r\n#fprev{position:fixed;inset:0;z-index:90;background:rgba(0,0,0,.6);display:grid;place-items:center;backdrop-filter:blur(3px)}#fprev[hidden]{display:none}\r\n.pvbox{width:min(920px,92vw);height:min(80vh,760px);background:var(--panel);border:1px solid var(--line);border-radius:16px;display:flex;flex-direction:column;overflow:hidden;box-shadow:var(--shadow)}\r\n.pvhead{display:flex;align-items:center;gap:10px;padding:10px 14px;border-bottom:1px solid var(--line)}.pvhead .sp{flex:1}\r\n#pvbody{flex:1;overflow:auto;display:grid;place-items:center;min-height:0}#pvbody img{max-width:100%;max-height:100%;object-fit:contain}#pvbody iframe{width:100%;height:100%;border:0}\r\n#pvbody pre{margin:0;align-self:stretch;justify-self:stretch;padding:14px;white-space:pre-wrap;word-break:break-word;font:12.5px/1.5 ui-monospace,Consolas,monospace;text-align:left;overflow:auto}\r\n</style><link rel=\"icon\" href=\"data:image/svg+xml,%3Csvg%20xmlns=%27http://www.w3.org/2000/svg%27%20viewBox=%270%200%20120%20120%27%3E%3Crect%20width=%27120%27%20height=%27120%27%20rx=%2726%27%20fill=%27%23000%27/%3E%3Cg%20stroke=%27%23fff%27%20stroke-width=%275%27%20stroke-linecap=%27round%27%3E%3Cline%20x1=%2760%27%20y1=%2758%27%20x2=%2760%27%20y2=%2728%27/%3E%3Cline%20x1=%2760%27%20y1=%2758%27%20x2=%2734%27%20y2=%2782%27/%3E%3Cline%20x1=%2760%27%20y1=%2758%27%20x2=%2786%27%20y2=%2782%27/%3E%3C/g%3E%3Cg%20fill=%27%23fff%27%3E%3Ccircle%20cx=%2760%27%20cy=%2726%27%20r=%278%27/%3E%3Ccircle%20cx=%2732%27%20cy=%2784%27%20r=%278%27/%3E%3Ccircle%20cx=%2788%27%20cy=%2784%27%20r=%278%27/%3E%3Ccircle%20cx=%2760%27%20cy=%2758%27%20r=%2710%27/%3E%3C/g%3E%3C/svg%3E\">\r\n</head><body>\r\n<div id=\"splash\"><svg viewBox=\"0 0 120 120\"><g>\r\n<line class=\"ln\" x1=\"60\" y1=\"60\" x2=\"60\" y2=\"14\" style=\"animation-delay:.1s\"/><line class=\"ln\" x1=\"60\" y1=\"60\" x2=\"20\" y2=\"94\" style=\"animation-delay:.25s\"/><line class=\"ln\" x1=\"60\" y1=\"60\" x2=\"100\" y2=\"94\" style=\"animation-delay:.4s\"/>\r\n<circle class=\"nd\" cx=\"60\" cy=\"14\" r=\"9\" style=\"animation-delay:.35s\"/><circle class=\"nd\" cx=\"20\" cy=\"94\" r=\"9\" style=\"animation-delay:.5s\"/><circle class=\"nd\" cx=\"100\" cy=\"94\" r=\"9\" style=\"animation-delay:.65s\"/>\r\n<circle class=\"rg\" cx=\"60\" cy=\"60\" r=\"11\"/><circle class=\"ct\" cx=\"60\" cy=\"60\" r=\"13\"/></g></svg><div class=\"wm\">AI HUB</div></div>\r\n\r\n<nav id=\"sb\" data-sb=\"rail\" aria-label=\"Barre latérale\"><div class=\"sbp\" id=\"sbp\">\r\n  <div class=\"sb-head\"><button id=\"sbtog\" type=\"button\" class=\"sb-tog\" aria-controls=\"sbp\"></button><span class=\"sb-logo\" aria-hidden=\"true\"><svg viewBox=\"0 0 120 120\" fill=\"currentColor\" stroke=\"currentColor\"><line x1=\"60\" y1=\"60\" x2=\"60\" y2=\"18\" stroke-width=\"7\" stroke-linecap=\"round\"/><line x1=\"60\" y1=\"60\" x2=\"24\" y2=\"92\" stroke-width=\"7\" stroke-linecap=\"round\"/><line x1=\"60\" y1=\"60\" x2=\"96\" y2=\"92\" stroke-width=\"7\" stroke-linecap=\"round\"/><circle cx=\"60\" cy=\"16\" r=\"12\" stroke=\"none\"/><circle cx=\"22\" cy=\"94\" r=\"12\" stroke=\"none\"/><circle cx=\"98\" cy=\"94\" r=\"12\" stroke=\"none\"/><circle cx=\"60\" cy=\"60\" r=\"15\" stroke=\"none\"/></svg></span><span class=\"sb-name\">AI Hub</span></div>\r\n  <button id=\"newproj\" class=\"btn pri wide\" data-ic=\"plus\" hidden>Nouveau projet</button>\r\n  <button id=\"sbnew\" type=\"button\" class=\"sb-new\" data-ic=\"plus\" title=\"Nouveau projet\" aria-label=\"Nouveau projet\"><span>Nouveau projet</span></button>\r\n  <div class=\"sb-label\">Projets</div>\r\n  <div id=\"plist\"></div>\r\n  <div id=\"keysbox\">\r\n    <button id=\"keystog\" class=\"keyshead\" type=\"button\" aria-expanded=\"true\"><span class=\"kt\">Clés <small>(comptes IA)</small></span><em id=\"kcount\"></em><svg class=\"ic chev\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m6 9 6 6 6-6\"/></svg></button>\r\n    <div id=\"keysbody\"><button id=\"add\" class=\"btn wide\" data-ic=\"plus\">Ajouter une clé</button><div id=\"list\"></div></div>\r\n  </div>\r\n  <button id=\"filesbtn\" class=\"btn ghost wide left\" data-ic=\"lib\">Fichiers<span class=\"pill\" id=\"fcount\"></span></button>\r\n  <div class=\"foot\"><button id=\"gear\" class=\"btn ghost wide left\" data-ic=\"sliders\">Paramètres</button><button id=\"themebtn\" class=\"btn ghost ic-only\" title=\"Basculer clair / sombre\" aria-label=\"Basculer clair / sombre\"></button></div>\r\n</div></nav>\r\n\r\n<main>\r\n  <header><strong id=\"title\">Aucun compte sélectionné</strong>\r\n    <div class=\"hbtns\"><button id=\"reload\" class=\"btn ghost\" data-ic=\"refresh\" title=\"Recharger la page de ce compte\" aria-label=\"Recharger la page de ce compte\">Recharger</button><button id=\"chromelogin\" class=\"btn ghost\" data-ic=\"lock\" title=\"Se connecter (Google, etc.) dans un vrai Chrome puis récupérer la session\" aria-label=\"Connexion via Chrome\">Connexion via Chrome</button><button id=\"handoff\" class=\"btn ghost\" data-ic=\"swap\" title=\"Reprendre cette conversation sur un autre compte\" aria-label=\"Reprendre sur un autre compte\">Reprendre ailleurs</button><button id=\"export\" class=\"btn ghost\" data-ic=\"copy\" title=\"Copier toute la conversation\" aria-label=\"Copier la conversation\">Copier la conversation</button></div><div id=\"hright\"></div></header>\r\n  <div id=\"ask\" hidden><span id=\"asktxt\"></span><button id=\"askyes\" class=\"btn pri\">Reprendre</button><button id=\"askno\" class=\"btn\">Ignorer</button></div>\r\n<div id=\"fixbn\" hidden><span id=\"fixtxt\"></span><button id=\"fixgo\" class=\"btn pri\">Réparer la lecture</button><button id=\"fixno\" class=\"btn\">Ignorer</button></div>\r\n  <div id=\"views\"><div id=\"bar\"><i></i></div>\r\n  <div id=\"empty\"><div><h2>Tes projets, une seule interface de chat</h2><p>Ajoute tes comptes IA : AI Hub change de compte tout seul quand une limite est atteinte.</p><div class=\"ebtns\"><button id=\"newproj2\" class=\"btn pri\" data-ic=\"plus\">Créer un projet</button><button id=\"add2\" class=\"btn\" data-ic=\"plus\">Ajouter une clé</button></div><ol class=\"u5-steps\"><li><b>Ajoute une clé</b><span>Un compte Claude, ChatGPT ou Gemini : AI Hub change tout seul de compte quand une limite est atteinte.</span></li><li><b>Ouvre un dossier</b><span>Un projet = un dossier. L'IA lit, modifie et vérifie ses fichiers pour toi.</span></li><li><b>Écris ta demande</b><span>Tape / pour afficher les commandes et réglages du chat (/auto, /max, /claude, /code…).</span></li></ol></div></div>\r\n\r\n  <section id=\"chat\">\r\n    <div id=\"ch-top\">\r\n      <div class=\"ch-id\"><b id=\"ch-name\"></b><span id=\"ch-desc\"></span><div id=\"ch-stat\"></div></div>\r\n      <div class=\"ch-act\">\r\n        <button id=\"ch-key\" class=\"btn\" type=\"button\" title=\"Quelle clé (compte) est branchée\"></button>\r\n        <button id=\"ch-copy\" class=\"btn ghost\" type=\"button\" title=\"Copier toute la conversation dans le presse-papiers\" aria-label=\"Copier la conversation\" data-ic=\"copy\">Copier</button>\r\n        <button id=\"ch-new\" class=\"btn ghost\" type=\"button\" title=\"Nouvelle conversation (vide l'historique du projet)\" aria-label=\"Nouvelle conversation\" data-ic=\"refresh\">Nouveau chat</button>\r\n      </div>\r\n    </div>\r\n    <div id=\"ch-msgs\"></div>\r\n    <div id=\"ch-bar\">\r\n      <div id=\"ch-chips\"></div>\r\n      <div id=\"ch-box\">\r\n        <button id=\"ch-att\" class=\"btn ghost ico\" type=\"button\" title=\"Joindre des fichiers de la bibliothèque\" aria-label=\"Joindre des fichiers\" data-ic=\"clip\"></button>\r\n        <button id=\"ch-mode\" class=\"btn ghost\" type=\"button\" title=\"Mode du chat : en ligne (tes clés) ou local (un dossier de ton PC)\"></button>\r\n        <textarea id=\"ch-in\" rows=\"1\" placeholder=\"Écris ton message… (Entrée pour envoyer, Maj+Entrée pour un retour à la ligne)\" spellcheck=\"true\"></textarea>\r\n        <button id=\"ch-send\" class=\"btn pri\" type=\"button\">Envoyer</button>\r\n        <button id=\"ch-stop\" class=\"btn\" type=\"button\" hidden>Arrêter</button>\r\n      </div>\r\n      <div id=\"ch-hint\">Les clés répondent en arrière-plan : tu restes ici, AI Hub change de clé si une limite est atteinte.</div>\r\n    </div>\r\n  </section>\r\n  <div id=\"ch-menu\" hidden></div>\r\n\r\n  <section id=\"files\">\r\n    <div class=\"fhead\">\r\n      <div><h2>Fichiers</h2><p id=\"fsub\"></p></div>\r\n      <div class=\"fact\"><div class=\"fsearch\"><span data-ic=\"search\"></span><input id=\"fq\" placeholder=\"Rechercher un fichier…\" autocomplete=\"off\"></div><button id=\"fscanbtn\" class=\"btn\" data-ic=\"search\"><span id=\"fscanlbl\">Scanner Claude</span></button><button id=\"fautobtn\" class=\"btn\" data-ic=\"folder\">Classer automatiquement</button><button id=\"fcolbtn\" class=\"btn\" data-ic=\"sliders\">Couleurs</button><button id=\"fadd\" class=\"btn pri\" data-ic=\"plus\">Ajouter des fichiers</button></div>\r\n    </div>\r\n    <div id=\"fscan\" hidden><span class=\"st\" id=\"fscantxt\"></span><span class=\"pb\"><i id=\"fscanbar\"></i></span><button class=\"btn sm\" id=\"fscancp\">Copier le rapport</button><button class=\"btn ghost sm\" id=\"fscanx\">Fermer</button><pre id=\"fscanrep\"></pre></div><div id=\"fauto\" hidden></div><div id=\"ficols\" hidden></div><div id=\"fprojs\"></div><div id=\"fselbar\" hidden></div><div id=\"fpedit\" hidden></div>\r\n    <div id=\"fgrid\"></div>\r\n    <div id=\"fempty\"><div><div class=\"big\" data-ic=\"folder\"></div><h3>Aucun fichier pour l'instant</h3><p>Ajoute un fichier une seule fois : il sera disponible sur tous tes comptes, prêt à être joint à n'importe quelle conversation.</p><button id=\"fadd2\" class=\"btn pri\" data-ic=\"plus\">Ajouter des fichiers</button></div></div>\r\n    <input type=\"file\" id=\"fin\" multiple hidden>\r\n  </section>\r\n  <div id=\"fdrop\"><div><div data-ic=\"upload\"></div><b>Dépose tes fichiers ici</b><span>Ils seront disponibles sur tous tes comptes</span></div></div>\r\n  <div id=\"fmenu\" hidden></div>\r\n  <section id=\"set\">\r\n    <nav class=\"snav\"><h2>Paramètres</h2>\r\n      <button data-t=\"gen\" class=\"on\">Général</button>\r\n<button data-t=\"cc\">Centre de contrôle</button>\r\n      <button data-t=\"acc\">Comptes et sauvegarde</button>\r\n      <button data-t=\"rel\">Reprise sur un autre compte</button>\r\n      <button data-t=\"upd\">Mises à jour</button>\r\n      <div class=\"dev-only\"><div class=\"sgrp\">Développeur</div>\r\n        <button data-t=\"code\" style=\"width:100%\">Code personnalisé</button><button data-t=\"det\" style=\"width:100%\">Détections</button><button data-t=\"log\" style=\"width:100%\">Journal en direct</button></div>\r\n    </nav>\r\n    <div class=\"spanes\">\r\n\r\n    <div class=\"pane on\" id=\"p-gen\">\r\n      <h2>Général</h2>\r\n      <h3>Apparence</h3>\r\n      <div class=\"card\"><div class=\"opt nc\"><span><b>Thème</b><small>« Système » suit le thème de Windows.</small></span>\r\n        <span class=\"seg\" id=\"theme\"><button data-th=\"system\">Système</button><button data-th=\"light\">Clair</button><button data-th=\"dark\">Sombre</button></span></div>\r\n<div class=\"opt nc\"><span><b>Couleur d'accent</b><small>Boutons, sélections et liens.</small></span><span class=\"u5acc\" id=\"u5acc\"><button type=\"button\" data-acc=\"#4f5bd5\" title=\"Indigo\" aria-label=\"Indigo\"></button><button type=\"button\" data-acc=\"#0f7b8a\" title=\"Turquoise\" aria-label=\"Turquoise\"></button><button type=\"button\" data-acc=\"#2f7d4f\" title=\"Vert\" aria-label=\"Vert\"></button><button type=\"button\" data-acc=\"#b45a1f\" title=\"Orange\" aria-label=\"Orange\"></button><button type=\"button\" data-acc=\"#b8365f\" title=\"Rose\" aria-label=\"Rose\"></button><button type=\"button\" data-acc=\"#7a4fc4\" title=\"Violet\" aria-label=\"Violet\"></button><label class=\"u5accpick\" title=\"Couleur libre\"><input type=\"color\" id=\"u5accpick\" value=\"#4f5bd5\" aria-label=\"Couleur libre\"></label><button type=\"button\" data-acc=\"\" class=\"u5accreset\">Par défaut</button></span></div></div>\r\n\r\n      <h3>Notifications</h3>\r\n      <div class=\"card pad\"><div class=\"line\" style=\"margin:0\"><span id=\"nstate\" class=\"pill\"></span><button id=\"nauth\" class=\"btn\"></button><button id=\"ntest\" class=\"btn\">Envoyer un test</button></div>\r\n        <p id=\"nhint\" style=\"margin-top:10px\"></p></div>\r\n      <div class=\"card\"><div class=\"opt nc\"><span><b>Mode épuré des fenêtres IA</b><small>Masque les barres latérales, bannières et pop-ups gênants des sites.</small></span><label><input type=\"checkbox\" id=\"cleanmode\"></label></div></div>\r\n      <div class=\"card\" id=\"ntypes\">\r\n        <label class=\"opt\"><span><b>Réponse terminée</b><small>Quand l'IA finit de répondre sur un compte que tu ne regardes pas.</small></span><input type=\"checkbox\" class=\"sw\" data-n=\"done\"></label>\r\n        <label class=\"opt\"><span><b>Limite atteinte</b><small>Quand un compte n'a plus de messages.</small></span><input type=\"checkbox\" class=\"sw\" data-n=\"limit\"></label>\r\n        <label class=\"opt\"><span><b>Reprise sur un autre compte</b><small>Quand une conversation est transférée (ou ne peut pas l'être).</small></span><input type=\"checkbox\" class=\"sw\" data-n=\"handoff\"></label>\r\n        <label class=\"opt\"><span><b>Compte déconnecté</b><small>Quand une session expire.</small></span><input type=\"checkbox\" class=\"sw\" data-n=\"logout\"></label>\r\n      </div>\r\n\r\n      <h3>Options</h3>\r\n      <div class=\"card\">\r\n        <label class=\"opt\"><span><b>Garder tous les comptes chargés en arrière-plan</b><small>Nécessaire pour détecter les limites et les réponses sur les comptes qui ne sont pas affichés.</small></span><input type=\"checkbox\" class=\"sw\" id=\"preall\"></label>\r\n        <label class=\"opt\"><span><b>Mode développeur</b><small>Active l'onglet « Code personnalisé » (scripts JavaScript), les détections personnalisées et le journal en direct. Désactivé : aucun script n'est exécuté.</small></span><input type=\"checkbox\" class=\"sw\" id=\"dev\"></label>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"pane\" id=\"p-cc\">\r\n<h2>Centre de contrôle</h2>\r\n<p class=\"lead\">L'état de tes comptes et de ton projet local, en un coup d'œil.</p>\r\n<div id=\"cc-body\" class=\"cc-grid\"></div>\r\n<div id=\"cc-api\" class=\"cc-grid\"></div>\r\n</div>\r\n\r\n<div class=\"pane\" id=\"p-acc\">\r\n      <h2>Comptes et sauvegarde</h2>\r\n      <h3>Fichier de comptes</h3>\r\n      <p>Enregistre tes comptes, leurs sessions connectées et tes réglages dans UN fichier. Charge-le dans une autre instance de AI Hub (autre PC, réinstallation) : les comptes arrivent déjà connectés. Les comptes déjà présents sont conservés.</p>\r\n      <p class=\"warn\">Ce fichier donne accès à tes comptes sans mot de passe. Mets un mot de passe de chiffrement, et ne le partage jamais.</p>\r\n      <div class=\"line\"><input id=\"pass\" type=\"password\" placeholder=\"Mot de passe de chiffrement\" autocomplete=\"off\" style=\"width:260px\">\r\n        <button id=\"exp\" class=\"btn pri\">Enregistrer dans un fichier</button><button id=\"imp\" class=\"btn\">Charger depuis un fichier</button></div>\r\n      <p id=\"msg\"></p>\r\n      <h3>Sécurité des données</h3>\r\n      <p>Les comptes sont enregistrés avec des copies de secours automatiques, et une seule fenêtre AI Hub peut tourner à la fois. Si un compte a disparu de la liste, sa session existe peut-être encore :</p>\r\n      <div class=\"line\"><button id=\"recover\" class=\"btn\">Retrouver les comptes perdus</button><button id=\"opendata\" class=\"btn\">Ouvrir le dossier des données</button></div>\r\n    </div>\r\n\r\n    <div class=\"pane\" id=\"p-rel\">\r\n      <h2>Reprise sur un autre compte</h2>\r\n      <p class=\"lead\">Quand un compte atteint sa limite, AI Hub reprend la conversation sur un autre compte et prépare le message de reprise.</p>\r\n      <div class=\"card\">\r\n        <label class=\"opt\"><span><b>Reprise automatique</b><small>Détecte la limite et lance la reprise sans que tu aies à intervenir.</small></span><input type=\"checkbox\" class=\"sw\" data-r=\"enabled\"></label>\r\n        <div class=\"opt nc\"><span><b>Quand la limite est atteinte</b></span><select data-r=\"mode\"><option value=\"auto\">Reprendre tout de suite</option><option value=\"ask\">Me demander d'abord</option></select></div>\r\n        <label class=\"opt\"><span><b>Même plateforme seulement</b><small>Ex. de Claude vers un autre compte Claude.</small></span><input type=\"checkbox\" class=\"sw\" data-r=\"samePlatform\"></label>\r\n        <label class=\"opt\"><span><b>Envoyer le message automatiquement</b><small>Sinon, le message est collé dans la zone de saisie et tu valides toi-même (recommandé pour commencer).</small></span><input type=\"checkbox\" class=\"sw\" data-r=\"send\"></label>\r\n      </div>\r\n      <h3>Contenu transmis</h3>\r\n      <div class=\"card\">\r\n        <div class=\"opt nc\"><span><b>Contexte au changement de compte</b><small>Économe : mémo d'état tenu à jour par l'IA + derniers messages + fichiers utiles seulement. Complet : tout l'historique (beaucoup plus de tokens). Valable pour toutes les plateformes.</small></span><select data-r=\"ctxMode\"><option value=\"eco\">Économe (recommandé)</option><option value=\"bal\">Équilibré</option><option value=\"full\">Complet</option></select></div>\r\n        <label class=\"opt\"><span><b>Résumer les longues conversations avec Gemini</b><small id=\"sumnote\"></small></span><input type=\"checkbox\" class=\"sw\" data-r=\"summary\"></label>\r\n        <div class=\"opt nc\"><span><b>Consigne donnée à l'IA</b></span><select data-r=\"tpl\"><option value=\"continue\">Continuer directement le travail</option><option value=\"ready\">Répondre « Prêt » et attendre</option></select></div>\r\n        <div class=\"opt nc\"><span><b>Taille maximale</b><small>En caractères. Au-delà, les messages du milieu sont omis (le début et la fin sont gardés).</small></span><input type=\"number\" data-r=\"maxChars\" min=\"5000\" max=\"300000\" step=\"5000\" style=\"width:110px\"></div>\r\n      </div>\r\n      <details><summary>Modèle du message (avancé)</summary>\r\n        <p>Laisse vide pour utiliser le modèle intégré. Variables : <code>{plateforme}</code> <code>{compte}</code> <code>{contexte}</code> <code>{suite}</code> <code>{date}</code></p>\r\n        <textarea id=\"custom\" data-r=\"custom\" spellcheck=\"false\" placeholder=\"[REPRISE] Voici le contexte :&#10;{contexte}&#10;&#10;{suite}\"></textarea></details>\r\n\r\n      <h3>Résumé par IA (Gemini)</h3>\r\n      <p>La conversation est envoyée à Google pour être résumée. Sans clé, ou si Gemini ne répond pas, la conversation est transmise en entier (tronquée si trop longue). La clé est stockée dans le fichier de données de l'app (et dans le fichier de comptes exporté, chiffré si tu mets un mot de passe).</p>\r\n      <div class=\"line\"><input id=\"gkey\" type=\"password\" placeholder=\"Clé API Gemini\" autocomplete=\"off\" style=\"width:300px\"><input id=\"gmodel\" placeholder=\"modèle\" style=\"width:200px\"><button id=\"gtest\" class=\"btn\">Tester</button></div>\r\n      <p id=\"gmsg\"></p>\r\n\r\n      <h3>Dernières reprises</h3>\r\n      <pre id=\"hlist\">Aucune reprise pour l'instant.</pre>\r\n\r\n      <details><summary>Lecture des conversations (si un site a changé)</summary>\r\n        <p>Si un site change son code et que l'app ne lit plus la conversation (icône d'alerte dans la liste des comptes), ajoute ici des sélecteurs CSS : ils s'ajoutent aux sélecteurs d'origine, sans mise à jour de l'app. Sépare plusieurs sélecteurs par des virgules. Pour en trouver un : clic droit sur l'élément dans Chrome &gt; Inspecter.</p>\r\n        <div class=\"line\"><select id=\"selplat\"></select></div>\r\n        <div class=\"line\"><input id=\"sel-user\" placeholder=\"Tes messages\" style=\"flex:1\"><input id=\"sel-ai\" placeholder=\"Réponses de l'IA\" style=\"flex:1\"></div>\r\n        <div class=\"line\"><input id=\"sel-comp\" placeholder=\"Zone de saisie\" style=\"flex:1\"><input id=\"sel-stop\" placeholder=\"Bouton Stop\" style=\"flex:1\"><input id=\"sel-send\" placeholder=\"Bouton Envoyer\" style=\"flex:1\"></div>\r\n        <div class=\"line\"><button id=\"selsave\" class=\"btn pri\">Enregistrer les sélecteurs</button><button id=\"diag\" class=\"btn\">Tester les sélecteurs (comptes chargés)</button></div>\r\n        <pre id=\"diagout\" style=\"display:none\"></pre></details>\r\n    </div>\r\n\r\n    <div class=\"pane\" id=\"p-upd\">\r\n      <h2>Mises à jour</h2>\r\n      <div class=\"upcard\">\r\n        <div class=\"upv\"><span class=\"upn\">AI Hub</span><b id=\"upver\"></b><span id=\"upbadge\" class=\"upbadge\"></span></div>\r\n        <p id=\"upsub\" class=\"dim\"></p>\r\n        <div id=\"upnew\" class=\"upnew\" hidden></div>\r\n        <div class=\"line\"><button id=\"upcheck\" class=\"btn pri\">Rechercher une mise à jour</button><button id=\"upget\" class=\"btn pri\" hidden>Installer</button></div>\r\n        <div id=\"upbusy\" class=\"upbusy\" hidden><i></i></div>\r\n        <p id=\"upmsg\"></p>\r\n      </div>\r\n      <div class=\"upcard\" id=\"lncard\">\r\n        <div class=\"upv\"><span class=\"upn\">Lanceur</span><b id=\"lnver\"></b><span id=\"lnbadge\" class=\"upbadge\"></span></div>\r\n        <p id=\"lnsub\" class=\"dim\"></p>\r\n        <div class=\"line\"><button id=\"lnrebuild\" class=\"btn pri\">Reconstruire le lanceur</button><button id=\"lnpick\" class=\"btn\">Choisir le ZIP…</button><button id=\"lnrestart\" class=\"btn\" hidden>Redémarrer pour finaliser</button></div>\r\n        <p id=\"lnmsg\"></p>\r\n        <details class=\"updet\"><summary>Détails du lanceur</summary><div id=\"lninfo\" class=\"dim\"></div><pre id=\"lnlog\"></pre></details>\r\n      </div>\r\n      <p class=\"dim\">Tes comptes, scripts et réglages sont conservés lors d'une mise à jour.</p>\r\n      <label class=\"upauto\"><input type=\"checkbox\" id=\"upauto\" checked> Vérifier automatiquement au démarrage</label>\r\n      <details class=\"updet\"><summary>Options avancées</summary>\r\n        <div class=\"line\"><button id=\"upapply\" class=\"btn\">Installer depuis un fichier…</button><button id=\"uprev\" class=\"btn\">Revenir à la version précédente</button><button id=\"upsetup\" class=\"btn\">Réinstaller avec l'installeur</button></div>\r\n        <div id=\"upinfo\" class=\"dim\"></div>\r\n        <h3>Versions installées</h3><pre id=\"upvers\"></pre>\r\n        <h3>Historique</h3><pre id=\"uphist\"></pre>\r\n        <div class=\"line\"><button id=\"uporig\" class=\"btn\">Revenir à la version d'origine</button></div>\r\n        <div class=\"dev-only\"><h3>Exporter le logiciel (mode développeur)</h3>\r\n          <p>Crée un fichier ZIP avec tout le logiciel tel qu'il est maintenant, plus un paquet <code>.aihubupdate</code> prêt à réinstaller. Tes comptes, cookies et conversations ne sont <b>pas</b> inclus.</p>\r\n          <div class=\"line\"><button id=\"packzip\" class=\"btn\">Exporter le logiciel en ZIP</button></div><p id=\"packmsg\"></p></div>\r\n      </details>\r\n    </div>\r\n\r\n    <div class=\"pane\" id=\"p-code\">\r\n      <h2>Code personnalisé</h2>\r\n      <p>Mode développeur. Ton code s'exécute dans l'app avec un accès complet à tes comptes et réagit aux événements. Il est relancé à chaque enregistrement et au démarrage. La reprise sur un autre compte est déjà intégrée (onglet « Reprise ») : inutile de la refaire ici, ou tu risques une double reprise.</p>\r\n      <textarea id=\"code\" spellcheck=\"false\"></textarea>\r\n      <div class=\"line\"><button id=\"savecode\" class=\"btn pri\">Enregistrer et activer</button><button id=\"resetcode\" class=\"btn\">Remettre l'exemple</button><span id=\"cst\" class=\"dim\"></span></div>\r\n      <details open><summary>API disponible</summary><pre>on('limit-hit', async ev =&gt; { ... })     // '*' = tous les événements ; once(...) = une seule fois\r\nev = { type, detail, url, ts, account:{id,platform,name} }\r\n\r\nhub.accounts                  liste des comptes     hub.active   compte affiché\r\nhub.state(id?)                { gen, limited, logged, last, lastAt }\r\nhub.switchTo(nom|id|n°|\"Claude:nom\")                 hub.next({samePlatform, skipLimited, dir})\r\nhub.available({samePlatform, from})                  premier compte non limité\r\nhub.handoff(from?, {to, send, summary})              reprise intégrée : renvoie { ok, to, mode, chars } ou { ok:false, error }\r\nhub.getConversation(compte?)                         texte de la conversation (null s'il n'y en a pas)\r\nhub.getMessages(compte?)     hub.health(compte?)     messages lus / diagnostic des sélecteurs\r\nhub.exportConversation(compte?)                      idem + copie dans le presse-papiers\r\nhub.newChat(compte?)                                 ouvre une nouvelle conversation\r\nhub.paste(texte, {account, send})                    écrit dans la zone de saisie (send:true = Entrée)\r\nhub.send(compte?)             hub.continueOn(compte, {from, send})   (ancien nom de handoff)\r\nhub.summarize(texte, {platform})   hub.aiEnabled     résumé Gemini (null sans clé)\r\nhub.runInPage(js, compte?)   hub.reload(compte?)     hub.notify(msg)   hub.copy(texte)\r\nhub.log(...)   hub.store.get(k) / hub.store.set(k,v)   hub.setLimited(c, bool)   hub.rename(c, nom)   await sleep(ms)</pre></details>\r\n    </div>\r\n\r\n    <div class=\"pane\" id=\"p-det\">\r\n      <h2>Détections</h2>\r\n      <h3>Événements détectés automatiquement</h3>\r\n      <div class=\"ev\" id=\"evlist\"></div>\r\n      <h3>Tes propres détections</h3>\r\n      <p>Un événement est émis quand le sélecteur CSS existe dans la page (ou que le texte correspond à la regex), et <code>nom-gone</code> quand il disparaît.</p>\r\n      <div id=\"dets\"></div>\r\n      <div class=\"line\"><button id=\"adddet\" class=\"btn\">Ajouter une détection</button><button id=\"savedet\" class=\"btn pri\">Enregistrer</button></div>\r\n    </div>\r\n\r\n    <div class=\"pane\" id=\"p-log\">\r\n      <h2>Journal en direct</h2>\r\n      <div id=\"logst\" class=\"dim\"></div>\r\n      <div class=\"line\"><input id=\"lf\" placeholder=\"Filtrer (ex. limit, handoff, claude…)\"><button id=\"logclr\" class=\"btn\">Vider</button><button id=\"logcp\" class=\"btn\">Copier en JSON</button></div>\r\n      <pre id=\"logl\"></pre>\r\n    </div>\r\n\r\n    </div>\r\n  </section></div>\r\n</main>\r\n\r\n<dialog id=\"dlg\"><h3>Nouvelle clé (compte IA)</h3>\r\n  <label for=\"plat\">Plateforme</label><select id=\"plat\"></select>\r\n  <label for=\"name\">Nom du compte</label><input id=\"name\" placeholder=\"ex. perso, lycée, projet\" autocomplete=\"off\">\r\n  <div class=\"row\"><button id=\"cancel\" class=\"btn\">Annuler</button><button id=\"ok\" class=\"btn pri\">Ajouter</button></div></dialog>\r\n<dialog id=\"dlgC\"><h3>Connexion via Google Chrome</h3>\r\n  <p class=\"dim\" id=\"cinfo\"></p>\r\n  <p>Google refuse la connexion dans les fenêtres intégrées comme AI Hub. Ici, tu te connectes dans un vrai Chrome (avec Google, comme d'habitude), puis AI Hub récupère la session pour ce compte.</p>\r\n  <ol class=\"dim\" style=\"margin:6px 0 10px 18px;line-height:1.7\"><li>Clique « Ouvrir Chrome ».</li><li>Connecte-toi sur le site (« Continuer avec Google »…).</li><li>Reviens ici et clique « J'ai fini : importer ».</li></ol>\r\n  <p id=\"cmsg\"></p>\r\n  <div class=\"row\"><button id=\"cclose\" class=\"btn\">Fermer</button><button id=\"copen\" class=\"btn\">Ouvrir Chrome</button><button id=\"cimp\" class=\"btn pri\" disabled>J'ai fini : importer</button></div></dialog>\r\n<dialog id=\"dlg2\"><h3>Renommer le compte</h3><label for=\"rname\">Nom</label><input id=\"rname\" autocomplete=\"off\">\r\n  <div class=\"row\"><button id=\"rcancel\" class=\"btn\">Annuler</button><button id=\"rok\" class=\"btn pri\">Enregistrer</button></div></dialog>\r\n<dialog id=\"dlgH\"><h3>Reprendre sur un autre compte</h3>\r\n  <p class=\"dim\" id=\"hsrc\"></p>\r\n  <label for=\"hto\">Compte de destination</label><select id=\"hto\"></select>\r\n  <label for=\"hmode\">Contenu transmis</label><select id=\"hmode\"><option value=\"sum\">Résumé + derniers échanges (si Gemini est configuré)</option><option value=\"full\">Conversation complète</option></select>\r\n  <label class=\"inl\"><input type=\"checkbox\" class=\"sw\" id=\"hsend\"> Envoyer le message automatiquement</label>\r\n  <div class=\"row\"><button id=\"hcancel\" class=\"btn\">Annuler</button><button id=\"hok\" class=\"btn pri\">Reprendre</button></div></dialog>\r\n<dialog id=\"dlgN\"><h3>Activer les notifications ?</h3>\r\n  <p class=\"dim\">AI Hub peut t'envoyer une notification Windows quand une réponse est terminée sur un autre compte, quand une limite est atteinte ou quand une conversation est reprise ailleurs. Tu peux choisir les types de notifications dans Paramètres &gt; Général.</p>\r\n  <div class=\"row\"><button id=\"nno\" class=\"btn\">Refuser</button><button id=\"nlater\" class=\"btn\">Plus tard</button><button id=\"nyes\" class=\"btn pri\" autofocus>Autoriser</button></div></dialog>\r\n<dialog id=\"dlgL\" class=\"wide\"><h3 id=\"ldt\">Dossier local</h3>\r\n  <div class=\"ltabs\"><button type=\"button\" data-lt=\"hist\" class=\"on\">Historique</button><button type=\"button\" data-lt=\"needs\">Capacités souhaitées</button><button type=\"button\" data-lt=\"rules\">Règles</button><button type=\"button\" data-lt=\"cfg\">Réglages</button></div>\r\n  <div id=\"lpane\"></div>\r\n  <div class=\"row\"><button id=\"lclose\" class=\"btn pri\" type=\"button\">Fermer</button></div></dialog>\r\n<dialog id=\"dlgP\"><h3 id=\"pdt\">Nouveau projet</h3>\r\n  <label for=\"pdn\">Nom du projet</label><input id=\"pdn\" maxlength=\"60\" autocomplete=\"off\" placeholder=\"ex. Robot DeskBuddy, Mod CinematicMC\">\r\n  <label for=\"pdd\">Instructions / contexte (facultatif)</label><textarea id=\"pdd\" rows=\"5\" style=\"width:100%;resize:vertical\" placeholder=\"Ce texte est donné à l'IA au début de chaque nouveau fil du projet (par ex. le but, le style de réponse voulu).\"></textarea>\r\n  <div class=\"row\"><button id=\"pdc\" class=\"btn\" type=\"button\">Annuler</button><button id=\"pdok\" class=\"btn pri\" type=\"button\">Créer</button></div></dialog>\r\n<div id=\"toast\"></div>\r\n<script>\r\nconst P={Claude:['https://claude.ai/new','#e0905f'],ChatGPT:['https://chatgpt.com','#3ecf9e'],Gemini:['https://gemini.google.com','#6e9bff'],'Le Chat':['https://chat.mistral.ai','#ff8a3d'],Copilot:['https://copilot.microsoft.com','#a98bff'],Perplexity:['https://www.perplexity.ai','#35c4d6'],Grok:['https://grok.com','#8a8a98'],DeepSeek:['https://chat.deepseek.com','#5b7cff']};\r\nconst ICONS={lib:'<path d=\"M5 4h3.5v16H5zM10.5 4H14v16h-3.5z\"/><path d=\"m16 5.2 3.3-.9 3 14.4-3.3.9z\"/>',globe:'<circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M3 12h18M12 3c3 3.5 3 14.5 0 18M12 3c-3 3.5-3 14.5 0 18\"/>',plus:'<path d=\"M5 12h14M12 5v14\"/>',sliders:'<path d=\"M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6\"/>',edit:'<path d=\"M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z\"/>',x:'<path d=\"M18 6 6 18M6 6l12 12\"/>',copy:'<rect x=\"9\" y=\"9\" width=\"13\" height=\"13\" rx=\"2\"/><path d=\"M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1\"/>',refresh:'<path d=\"M3 12a9 9 0 0 1 15-6.7L21 8M21 3v5h-5M21 12a9 9 0 0 1-15 6.7L3 16M3 21v-5h5\"/>',swap:'<path d=\"m16 3 4 4-4 4M20 7H4M8 21l-4-4 4-4M4 17h16\"/>',lock:'<rect x=\"3\" y=\"11\" width=\"18\" height=\"11\" rx=\"2\"/><path d=\"M7 11V7a5 5 0 0 1 10 0v4\"/>',warn:'<path d=\"m21.7 18-8-14a2 2 0 0 0-3.4 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.7-3Z\"/><path d=\"M12 9v4M12 17h.01\"/>',ban:'<circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"m4.9 4.9 14.2 14.2\"/>'};\r\nconst IC=n=>`<svg class=\"ic\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">${ICONS[n]||''}</svg>`;\r\nObject.assign(ICONS,{\r\nfolder:'<path d=\"M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z\"/>',\r\nclip:'<path d=\"m21.4 11-9.2 9.2a5.5 5.5 0 0 1-7.8-7.8l9.2-9.2a3.7 3.7 0 0 1 5.2 5.2l-9.2 9.2a1.8 1.8 0 0 1-2.6-2.6l8.5-8.5\"/>',\r\ndl:'<path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3\"/>',\r\nupload:'<path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12\"/>',\r\ntrash:'<path d=\"M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6M10 11v6M14 11v6\"/>',\r\nsearch:'<circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/>',\r\nsun:'<circle cx=\"12\" cy=\"12\" r=\"4\"/><path d=\"M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4\"/>',\r\nmoon:'<path d=\"M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z\"/>'});\r\nlet filesOpen=false;\r\nconst seenA=new Set(),seenG=new Set();                       // animation d'entrée : seulement la 1re fois qu'un élément apparaît\r\nconst entA=id=>seenA.has(id)?'':(seenA.add(id),'enter'),entG=p=>seenG.has(p)?'':(seenG.add(p),'enter');\r\n\r\nconst EVENTS=[['page-loaded','une page finit de charger'],['url-changed','l\\'adresse change (detail: from, to)'],['new-chat','une nouvelle conversation s\\'ouvre'],['chat-opened','une ancienne conversation s\\'ouvre'],['logged-in','le compte est connecté'],['login-required','page de connexion affichée'],['session-expired','déconnecté alors qu\\'il était connecté'],['typing','tu commences à écrire'],['send-attempt','Entrée ou clic sur Envoyer (detail: preview)'],['message-sent','ta question est apparue dans la conversation'],['response-started','l\\'IA commence à répondre'],['response-complete','la réponse est terminée (chars, seconds, preview)'],['limit-hit','limite de messages / d\\'utilisation atteinte'],['limit-cleared','le message de limite a disparu'],['limit-soon','\"il vous reste N messages\"'],['rate-limit','trop de requêtes'],['overloaded','service surchargé / indisponible'],['error','erreur « something went wrong » etc.'],['chat-too-long','conversation trop longue'],['captcha','vérification « êtes-vous humain »'],['captcha-cleared','vérification passée'],['idle','aucune activité depuis 2 min'],['active','reprise après inactivité'],['tab-hidden','le compte n\\'est plus affiché'],['tab-visible','le compte est affiché'],['offline','plus de connexion internet'],['online','connexion revenue'],['code-error','(journal seulement) erreur dans ton code'],['handoff-*','(journal seulement) reprise sur un autre compte : ok, skip, fail'],['mon-nom','tes détections personnalisées (+ mon-nom-gone)']];\r\nconst EXAMPLE=`// Mode développeur : ton code réagit aux événements des comptes.\r\n// La reprise sur un autre compte est intégrée (Paramètres > Reprise) : inutile de la refaire ici.\r\n\r\n// Exemple : compter les messages envoyés par jour et par compte\r\n// on('message-sent', ev => {\r\n//   const jour = new Date().toISOString().slice(0, 10);\r\n//   const cle = 'msgs-' + ev.account.id + '-' + jour;\r\n//   hub.store.set(cle, (hub.store.get(cle) || 0) + 1);\r\n// });\r\n\r\n// Exemple : lancer une reprise à la main après une erreur\r\n// on('error', ev => hub.handoff(ev.account.id));\r\n`;\r\n// Ancien exemple (2.1) : s'il n'a pas été modifié, on le remplace pour ne pas doubler la reprise intégrée\r\nconst isOldExample=c=>/continueOn\\(cible/.test(c)&&c.length<1000;\r\nconst UA=navigator.userAgent.replace(/\\s?Electron\\/\\S+/,'').replace(/\\s?ai-hub\\/\\S+/,'');\r\nconst COMPOSER='[contenteditable=\"true\"],textarea';\r\nconst GEM='gemini-flash-latest';\r\nconst $=id=>document.getElementById(id);\r\nconst esc=s=>String(s).replace(/[&<>\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]));\r\nconst LS=(k,d)=>{try{const v=JSON.parse(localStorage[k]);return v??d}catch{return d}};\r\nconst sleep=ms=>new Promise(r=>setTimeout(r,ms));\r\nconst DEF=()=>({preloadAll:false,clean:true,theme:'system',devMode:false,\r\n  notif:{enabled:null,on:{done:true,limit:true,handoff:true,logout:true}},\r\n  relay:{enabled:true,mode:'auto',samePlatform:true,send:false,summary:true,summaryAbove:15000,tpl:'continue',maxChars:60000,ctxMode:'eco',custom:''},\r\n  gemini:{key:'',model:GEM},selectors:{},projects:[],fcol:{}});\r\nfunction mergeSettings(s){const d=DEF();s=s||{};\r\n  return {...d,...s,notif:{...d.notif,...(s.notif||{}),on:{...d.notif.on,...((s.notif||{}).on||{})}},relay:{...d.relay,...(s.relay||{})},gemini:{...d.gemini,...(s.gemini||{})},selectors:s.selectors||{},projects:Array.isArray(s.projects)?s.projects:[],fcol:s.fcol&&typeof s.fcol==='object'?s.fcol:{}}}\r\nlet accs=[],active=null,detectors=[],settings=DEF(),userCode=EXAMPLE,store={},ready=false;\r\nlet PRE='',setOpen=false,tab='gen';  // filesOpen : voir plus haut\r\nconst st={},LOG=[],H={},HAND=[];\r\nconst stOf=id=>st[id]??={gen:false,limited:false,logged:null,last:'',lastAt:0};\r\nconst pub=a=>a&&{id:a.id,platform:a.p,name:a.n};\r\nlet EXTRA_STATE={},STATE_V=3;   // champs inconnus (écrits par une autre version) : conservés tels quels\r\nconst save=()=>{if(ready)api.stateSave(JSON.stringify({...EXTRA_STATE,v:Math.max(3,STATE_V),accs,active,detectors,settings,code:userCode,store}))};\r\nconst toast=t=>{const e=$('toast');e.textContent=t;e.classList.add('show');clearTimeout(toast._t);toast._t=setTimeout(()=>e.classList.remove('show'),3200)};\r\nconst find=x=>x==null?null:typeof x==='object'?accs.find(a=>a.id===x.id)||null:accs.find(a=>a.id===x)||accs.find(a=>a.n.toLowerCase()===String(x).toLowerCase())||accs.find(a=>(a.p+':'+a.n).toLowerCase()===String(x).toLowerCase())||(/^\\d+$/.test(x)?accs[+x-1]:null)||null;\r\n$('plat').innerHTML=Object.keys(P).map(k=>`<option>${k}</option>`).join('');\r\ndocument.querySelectorAll('[data-ic]').forEach(e=>e.insertAdjacentHTML('afterbegin',IC(e.dataset.ic)));\r\n\r\n// ---------- thème ----------\r\nconst mq=matchMedia('(prefers-color-scheme:dark)');\r\nconst effTheme=()=>{const t=settings.theme||'system';return t==='system'?(mq.matches?'dark':'light'):t};\r\nfunction applyTheme(animate){const t=settings.theme||'system',h=document.documentElement;\r\n  if(animate===true){h.classList.add('themeswap');clearTimeout(applyTheme._t);applyTheme._t=setTimeout(()=>h.classList.remove('themeswap'),480)}   // fondu doux entre clair et sombre\r\n  h.dataset.theme=t;h.dataset.eff=effTheme();try{applyAccent()}catch{}\r\n  document.querySelectorAll('#theme button').forEach(b=>b.classList.toggle('on',b.dataset.th===t));try{api.setTheme(t)}catch{}}\r\nmq.addEventListener('change',()=>{if((settings.theme||'system')==='system')applyTheme(true)});\r\ndocument.querySelectorAll('#theme button').forEach(b=>b.onclick=()=>{settings.theme=b.dataset.th;save();applyTheme(true)});\r\n// ---------- 5.0 (U15) : couleur d'accent au choix ; la teinte est éclaircie ou assombrie jusqu'à un contraste lisible (≥ 4,6) sur le fond le plus défavorable ----------\r\nfunction accRgb(h){h=String(h||'').replace('#','');if(h.length===3)h=h.split('').map(c=>c+c).join('');if(!/^[0-9a-f]{6}$/i.test(h))return null;return [0,2,4].map(k=>parseInt(h.slice(k,k+2),16))}\r\nfunction accLum(c){const f=v=>{v/=255;return v<=.03928?v/12.92:Math.pow((v+.055)/1.055,2.4)};return .2126*f(c[0])+.7152*f(c[1])+.0722*f(c[2])}\r\nfunction accContrast(a,b){const x=accLum(a),y=accLum(b);return (Math.max(x,y)+.05)/(Math.min(x,y)+.05)}\r\nfunction accFit(hex,dark){const c=accRgb(hex);if(!c)return '';const bg=dark?[27,27,29]:[243,243,241],target=dark?[255,255,255]:[0,0,0];let k=0;\r\n  const mix=p=>c.map((v,i)=>Math.round(v+(target[i]-v)*p));\r\n  while(accContrast(mix(k),bg)<4.6&&k<1)k+=.04;\r\n  return '#'+mix(Math.min(k,1)).map(v=>v.toString(16).padStart(2,'0')).join('')}\r\nfunction applyAccent(){const h=document.documentElement,a=settings&&settings.accent;\r\n  if(a&&accRgb(a))h.style.setProperty('--c-acc',accFit(a,effTheme()==='dark'));else h.style.removeProperty('--c-acc');\r\n  const box=document.getElementById('u5acc');if(!box)return;\r\n  box.querySelectorAll('button[data-acc]').forEach(b=>{const v=b.dataset.acc||'';b.classList.toggle('on',!!v&&v.toLowerCase()===String(a||'').toLowerCase());if(v)b.style.setProperty('--sw',v)});\r\n  const p=document.getElementById('u5accpick');if(p&&a&&accRgb(a)&&String(a).length===7)p.value=String(a).toLowerCase()}\r\n{const box=document.getElementById('u5acc');if(box){\r\n  box.addEventListener('click',e=>{const b=e.target.closest('button[data-acc]');if(!b)return;if(b.dataset.acc)settings.accent=b.dataset.acc;else delete settings.accent;save();applyAccent()});\r\n  const p=document.getElementById('u5accpick');if(p){p.oninput=()=>{settings.accent=p.value;applyAccent()};p.onchange=()=>{settings.accent=p.value;save();applyAccent()}}}}\r\n\r\n// ---------- 2.2.2 : sélecteur animé, bouton de thème, fichiers partagés ----------\r\nfunction fitSeg(s){let ind=s.querySelector(':scope>.ind');if(!ind){s.insertAdjacentHTML('afterbegin','<i class=\"ind\"></i>')}\r\n  const b=s.querySelector('button.on');if(!b||!b.offsetWidth)return;s.style.setProperty('--x',b.offsetLeft+'px');s.style.setProperty('--w',b.offsetWidth+'px')}\r\ndocument.querySelectorAll('.seg').forEach(s=>{fitSeg(s);const f=()=>requestAnimationFrame(()=>fitSeg(s));\r\n  new ResizeObserver(f).observe(s);new MutationObserver(f).observe(s,{subtree:true,attributes:true,attributeFilter:['class'],childList:true})});\r\n$('themebtn').innerHTML='<span class=\"tg\"><span class=\"sun\">'+IC('sun')+'</span><span class=\"moon\">'+IC('moon')+'</span></span>';\r\n$('themebtn').onclick=()=>{settings.theme=effTheme()==='dark'?'light':'dark';save();applyTheme(true)};\r\n\r\n// Bibliothèque de fichiers commune à tous les comptes (stockée localement dans l'appli, IndexedDB)\r\nconst FDB={db:null,\r\n  open(){return this.db||(this.db=new Promise((ok,ko)=>{const r=indexedDB.open('aihub-files',1);r.onupgradeneeded=()=>r.result.createObjectStore('files',{keyPath:'id'});r.onsuccess=()=>ok(r.result);r.onerror=()=>ko(r.error)}))},\r\n  async tx(mode,fn){const db=await this.open();return new Promise((ok,ko)=>{const t=db.transaction('files',mode);let r;try{r=fn(t.objectStore('files'))}catch(x){return ko(x)}\r\n    t.oncomplete=()=>ok(r&&r.result);t.onerror=()=>ko(t.error);t.onabort=()=>ko(t.error)})},\r\n  all(){return this.tx('readonly',s=>s.getAll())},put(f){return this.tx('readwrite',s=>s.put(f))},del(id){return this.tx('readwrite',s=>s.delete(id))}};\r\nlet FILES=[],TRASH=[],fq='',fUrls=[],SEL=new Set();\r\nconst MAXF=100*1048576;\r\nconst fmtSize=n=>n<1024?n+' o':n<1048576?Math.round(n/1024)+' Ko':(n/1048576).toFixed(1).replace('.',',')+' Mo';\r\nconst extOf=n=>n.includes('.')?n.split('.').pop():'';\r\nconst kindOf=f=>{const e=extOf(f.name).toLowerCase(),t=f.type||'';\r\n  if(t.startsWith('image/'))return'image';if(e==='pdf')return'pdf';if(/^(docx?|odt|rtf)$/.test(e))return'doc';if(/^(xlsx?|csv|tsv|ods)$/.test(e))return'sheet';\r\n  if(/^(js|ts|jsx|tsx|py|java|c|cpp|cs|go|rs|rb|php|html|css|json|xml|ya?ml|sh|bat|sql|md)$/.test(e))return'code';if(/^(zip|rar|7z|tar|gz)$/.test(e))return'zip';return'txt'};\r\nasync function addFiles(list){let ok=0,big=0;\r\n  for(const f of list){if(f.size>MAXF){big++;continue}\r\n    try{await FDB.put({id:'f'+Date.now().toString(36)+Math.random().toString(36).slice(2,6),name:f.name,type:f.type||'',size:f.size,added:Date.now(),proj:(isProjId(fproj)?fproj:''),blob:f});ok++}catch{}}\r\n  await loadFiles();\r\n  toast(ok?`${ok} fichier${ok>1?'s ajoutés':' ajouté'} à la bibliothèque`+(big?` (${big} trop gros, 100 Mo max)`:''):big?'Fichier trop gros (100 Mo maximum)':'Impossible d\\'ajouter le fichier')}\r\nfunction openFMenu(btn,id){const m=$('fmenu');if(!accs.length)return toast('Ajoute d\\'abord un compte');\r\n  const by={};accs.forEach(a=>(by[a.p]??=[]).push(a));\r\n  m.innerHTML='<div class=\"mt\">Joindre à…</div>'+Object.keys(by).map(p=>by[p].map(a=>`<button data-acc=\"${a.id}\"><i class=\"dot\" style=\"background:${P[p][1]}\"></i><span>${esc(p)} · ${esc(a.n)}</span>${a.id===active?'<em>actif</em>':''}</button>`).join('')).join('');\r\n  m.dataset.file=id;m.hidden=false;\r\n  const r=btn.getBoundingClientRect();m.style.left=Math.max(12,Math.min(r.left,innerWidth-272))+'px';m.style.top=(r.bottom+6)+'px';\r\n  const h=m.offsetHeight;if(r.bottom+6+h>innerHeight-12)m.style.top=Math.max(12,r.top-h-6)+'px';\r\n  m.classList.remove('in');void m.offsetWidth;m.classList.add('in')}\r\nconst closeFMenu=()=>{$('fmenu').hidden=true};\r\ndocument.addEventListener('mousedown',e=>{if(!e.target.closest('#fmenu')&&!e.target.closest('[data-att]'))closeFMenu()});\r\ndocument.addEventListener('keydown',e=>{if(e.key==='Escape')closeFMenu()});\r\n$('fmenu').onclick=e=>{const b=e.target.closest('[data-acc]');if(!b)return;const id=$('fmenu').dataset.file;closeFMenu();attachFile(id,b.dataset.acc)};\r\n// Joint le fichier à la zone de message du compte choisi (champ d'envoi de fichier de la page, sinon collage dans la zone de saisie)\r\nasync function attachFile(fid,accId,o={}){const f=FILES.find(x=>x.id===fid),a=find(accId);if(!f||!a)return;\r\n  if(!o.stay){active=a.id;setOpen=false;filesOpen=false;save();render()}\r\n  const v=view(a);for(let i=0;i<60&&!v._ready;i++)await sleep(250);\r\n  if(!v._ready)return toast(`La page de ${a.p} n'est pas prête, réessaie dans un instant`);\r\n  if(f.size>25*1048576)toast('Gros fichier : le transfert peut prendre un moment…');\r\n  let b64;try{b64=await new Promise((ok,ko)=>{const r=new FileReader();r.onload=()=>ok(String(r.result).split(',')[1]||'');r.onerror=ko;r.readAsDataURL(f.blob)})}catch{return toast('Lecture du fichier impossible')}\r\n  const js=ATTACH_JS+'('+JSON.stringify(b64)+','+JSON.stringify(f.name)+','+JSON.stringify(f.type||'')+')';\r\n  try{const r=await v.executeJavaScript(js);\r\n    if(r!=='none'&&f.proj)addProjectContext(a,f.proj,f).catch(x=>toast('Contexte du projet non ajouté : '+String(x&&x.message||x).slice(0,60)));\r\n    toast(r==='none'?`Aucune zone de message trouvée sur ${a.p} : ouvre une conversation puis réessaie`:`Fichier transmis à ${a.p} · ${a.n}. Vérifie qu'il apparaît dans la zone de message.`)}\r\n  catch(x){toast('Impossible de joindre le fichier : '+String(x&&x.message||x).slice(0,80))}}\r\nconst ATTACH_JS=`(async(b64,name,type)=>{\r\n  const bin=atob(b64),u8=new Uint8Array(bin.length);for(let i=0;i<bin.length;i++)u8[i]=bin.charCodeAt(i);\r\n  const file=new File([u8],name,{type:type||'application/octet-stream'}),dt=new DataTransfer();dt.items.add(file);\r\n  const look=()=>({inp:[...document.querySelectorAll('input[type=file]')].find(i=>!i.disabled),box:document.querySelector('div[contenteditable=\"true\"],textarea,[role=textbox]')});\r\n  let t={};for(let i=0;i<32;i++){t=look();if(t.inp||t.box)break;await new Promise(r=>setTimeout(r,250))}\r\n  if(t.inp){t.inp.files=dt.files;t.inp.dispatchEvent(new Event('input',{bubbles:true}));t.inp.dispatchEvent(new Event('change',{bubbles:true}));return 'input'}\r\n  if(t.box){t.box.focus();t.box.dispatchEvent(new ClipboardEvent('paste',{clipboardData:dt,bubbles:true,cancelable:true}));return 'paste'}\r\n  return 'none'})`;\r\n$('fgrid').onclick=async e=>{const at=e.target.closest('[data-att]'),dl=e.target.closest('[data-dl]'),rm=e.target.closest('[data-rm]');\r\n  if(at)return openFMenu(at,at.dataset.att);\r\n  if(dl){const f=FILES.find(x=>x.id===dl.dataset.dl);if(!f)return;const a=document.createElement('a');a.href=URL.createObjectURL(f.blob);a.download=f.name;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),5000);return}\r\n  if(rm){const f=FILES.find(x=>x.id===rm.dataset.rm);if(!f||!confirm(`Supprimer « ${f.name} » de la bibliothèque ? (Les conversations où il a déjà été joint ne changent pas.)`))return;\r\n    if(String(f.id).startsWith('scan-')){(settings.scanSkip??=[]).push(f.id);save()}await FDB.del(f.id);await loadFiles()}};\r\n\r\n// ---------- 2.2.7 : scanner des fichiers de Claude (joints + créés par Claude) ----------\r\n// Ces deux fonctions ne tournent PAS ici : elles sont envoyées dans la page claude.ai du compte (avec sa session) via executeJavaScript.\r\nasync function scanListPage(){\r\n  const J=async u=>{const r=await fetch(u,{credentials:'include',headers:{accept:'application/json'}});if(!r.ok)throw new Error(u.replace(/[0-9a-f]{8}-[0-9a-f-]{27}/g,'…')+' → HTTP '+r.status);return r.json()};\r\n  const orgs=await J('/api/organizations');\r\n  const list=Array.isArray(orgs)?orgs:[];\r\n  const o=list.find(x=>(x.capabilities||[]).includes('chat'))||list[0];\r\n  if(!o||!o.uuid)throw new Error('organisation introuvable (compte non connecté ?)');\r\n  const convs=[],ids=new Set(),lim=100;\r\n  for(let off=0;off<3000;off+=lim){\r\n    let pg;try{pg=await J('/api/organizations/'+o.uuid+'/chat_conversations?limit='+lim+'&offset='+off)}catch(e){if(off===0)throw e;break}\r\n    if(!Array.isArray(pg))break;\r\n    const fresh=pg.filter(c=>c&&c.uuid&&!ids.has(c.uuid));\r\n    if(!fresh.length)break;\r\n    for(const c of fresh){ids.add(c.uuid);convs.push({uuid:c.uuid,name:c.name||''})}\r\n    if(pg.length<lim)break;\r\n  }\r\n  return {org:o.uuid,convs};\r\n}\r\nasync function scanConvPage(a){\r\n  const J=async u=>{const r=await fetch(u,{credentials:'include',headers:{accept:'application/json'}});if(!r.ok)throw new Error('HTTP '+r.status);return r.json()};\r\n  const c=await J('/api/organizations/'+a.org+'/chat_conversations/'+a.uuid+'?tree=True&rendering_mode=messages&render_all_tools=true');\r\n  const errors=[],created=new Map(),attached=[],urls=new Set();\r\n  const extFor=(i)=>{const t=String(i.type||'');return /html/.test(t)?'.html':/svg/.test(t)?'.svg':/react/.test(t)?'.jsx':/markdown/.test(t)?'.md':/mermaid/.test(t)?'.mmd':/code/.test(t)?('.'+(String(i.language||'txt').toLowerCase().replace(/[^a-z0-9]/g,'')||'txt')):'.txt'};\r\n  for(const m of (c.chat_messages||[])){\r\n    const when=m.created_at||'';\r\n    for(const t of (m.attachments||[])){if(t&&t.file_name&&typeof t.extracted_content==='string'&&t.extracted_content)attached.push({kind:'attached',name:t.file_name,text:t.extracted_content,when})}\r\n    for(const f of [...(m.files||[]),...(m.files_v2||[])]){\r\n      const nm=f&&(f.file_name||f.name);\r\n      const url=f&&((f.document_asset&&f.document_asset.url)||(f.preview_asset&&f.preview_asset.url)||f.preview_url||f.thumbnail_url);\r\n      if(nm&&url&&!urls.has(url)){urls.add(url);attached.push({kind:'attached',name:nm,url,when})}\r\n    }\r\n    for(const b of (m.content||[])){\r\n      if(!b||b.type!=='tool_use'||!b.input)continue;\r\n      const i=b.input;\r\n      if(typeof i.file_text==='string'&&i.path&&i.file_text)created.set(String(i.path),{kind:'created',name:String(i.path).split('/').pop(),text:i.file_text,when});\r\n      else if(b.name==='artifacts'&&typeof i.content==='string'&&i.content&&(i.command==='create'||i.command==='rewrite')){const base=String(i.title||i.id||'artifact');created.set('artifact:'+(i.id||base),{kind:'created',name:/\\.\\w{1,6}$/.test(base)?base:base+extFor(i),text:i.content,when})}\r\n    }\r\n  }\r\n  const files=[...attached.filter(f=>f.text!=null),...created.values()];\r\n  for(const f of attached.filter(f=>f.url)){\r\n    try{\r\n      const r=await fetch(f.url,{credentials:'include'});if(!r.ok){errors.push(f.name+' : HTTP '+r.status);continue}\r\n      const b=await r.blob();if(b.size>a.max){errors.push(f.name+' : trop gros');continue}\r\n      const u8=new Uint8Array(await b.arrayBuffer());let s='';for(let i=0;i<u8.length;i+=0x8000)s+=String.fromCharCode.apply(null,u8.subarray(i,i+0x8000));\r\n      files.push({kind:'attached',name:f.name,b64:btoa(s),type:b.type||'',when:f.when});\r\n    }catch(e){errors.push(f.name+' : '+String(e&&e.message||e))}\r\n  }\r\n  return {files,errors};\r\n}\r\nconst fnv=s=>{let h=2166136261;for(let i=0;i<s.length;i++){h^=s.charCodeAt(i);h=Math.imul(h,16777619)}return (h>>>0).toString(36)};\r\nconst b64Blob=(b64,type)=>{const bin=atob(b64),u=new Uint8Array(bin.length);for(let i=0;i<bin.length;i++)u[i]=bin.charCodeAt(i);return new Blob([u],{type})};\r\nconst MIME={html:'text/html',htm:'text/html',svg:'image/svg+xml',json:'application/json',md:'text/markdown',css:'text/css',js:'text/javascript',csv:'text/csv',xml:'application/xml'};\r\nconst cleanName=n=>String(n||'fichier').replace(/[\\\\/:*?\"<>|\\u0000-\\u001f]/g,'_').slice(0,120)||'fichier';\r\nlet scanning=false,scanStop=false,scanLog=[];\r\nasync function scanClaude(){\r\n  if(scanning){scanStop=true;$('fscanlbl').textContent='Arrêt…';return}\r\n  const cl=accs.filter(a=>a.p==='Claude');\r\n  if(!cl.length)return toast('Aucun compte Claude à scanner');\r\n  scanning=true;scanStop=false;scanLog=[];\r\n  const box=$('fscan'),say=(t,p)=>{$('fscantxt').textContent=t;if(p!=null)$('fscanbar').style.width=Math.round(p*100)+'%'},rep=()=>{$('fscanrep').textContent=scanLog.slice(-60).join('\\n')};\r\n  box.hidden=false;$('fscanlbl').textContent='Arrêter le scan';say('Démarrage…',0);rep();\r\n  const sk=new Set(settings.scanSkip||[]),have=new Set([...FILES,...TRASH].map(f=>f.id));\r\n  let added=0,convDone=0,convTotal=0,fails=0;\r\n  try{\r\n    for(const a of cl){\r\n      if(scanStop)break;\r\n      say('Compte '+a.n+' : ouverture de la page Claude…');\r\n      const v=view(a);for(let i=0;i<60&&!v._ready;i++)await sleep(250);\r\n      let host='';try{host=new URL(v.getURL()).hostname}catch{}\r\n      if(!v._ready||!/(^|\\.)claude\\.ai$/.test(host)){scanLog.push(a.n+' : page Claude non prête (connecte-toi puis relance le scan)');rep();continue}\r\n      let L;try{L=await v.executeJavaScript('('+scanListPage.toString()+')()')}catch(x){scanLog.push(a.n+' : liste des conversations impossible — '+String(x&&x.message||x).slice(0,160));rep();continue}\r\n      convTotal+=L.convs.length;scanLog.push(a.n+' : '+L.convs.length+' conversation(s) trouvée(s)');rep();\r\n      let idx=0,found=0;\r\n      const worker=async()=>{\r\n        while(!scanStop){\r\n          const c=L.convs[idx++];if(!c)return;\r\n          try{\r\n            const r=await v.executeJavaScript('('+scanConvPage.toString()+')('+JSON.stringify({org:L.org,uuid:c.uuid,max:MAXF})+')');\r\n            for(const f of r.files||[]){\r\n              const name=cleanName(f.name),id='scan-'+fnv([a.id,f.kind,c.uuid,name,f.text!=null?f.text.length:(f.b64||'').length].join('|'));\r\n              found++;if(sk.has(id)||have.has(id))continue;\r\n              const ext=extOf(name).toLowerCase(),blob=f.text!=null?new Blob([f.text],{type:MIME[ext]||'text/plain'}):b64Blob(f.b64,f.type||'application/octet-stream');\r\n              if(!blob.size||blob.size>MAXF)continue;\r\n              await FDB.put({id,name,type:blob.type,size:blob.size,added:Date.now(),proj:'',blob,src:{p:'Claude',acc:a.n,conv:c.name||'Sans titre',kind:f.kind}});\r\n              have.add(id);added++;\r\n            }\r\n            for(const e of r.errors||[])scanLog.push('  '+(c.name||c.uuid).slice(0,40)+' · '+e);\r\n          }catch(x){fails++;scanLog.push('  '+(c.name||c.uuid).slice(0,40)+' : '+String(x&&x.message||x).slice(0,120))}\r\n          convDone++;say(`Conversation ${convDone}/${convTotal} · ${added} nouveau${added>1?'x':''} fichier${added>1?'s':''}`,convTotal?convDone/convTotal:0);\r\n        }\r\n      };\r\n      await Promise.all([worker(),worker(),worker()]);\r\n      scanLog.push(a.n+' : '+found+' fichier(s) repéré(s) dans les conversations');rep();\r\n    }\r\n  }catch(x){scanLog.push('Erreur : '+String(x&&x.message||x))}\r\n  scanning=false;$('fscanlbl').textContent='Scanner Claude';\r\n  scanLog.push((scanStop?'Scan arrêté':'Scan terminé')+' : '+convDone+' conversation(s) lue(s), '+added+' fichier(s) ajouté(s)'+(fails?', '+fails+' erreur(s)':''));\r\n  say((scanStop?'Scan arrêté · ':'Scan terminé · ')+added+' fichier'+(added>1?'s ajoutés':' ajouté')+' · '+convDone+' conversation'+(convDone>1?'s':'')+' lue'+(convDone>1?'s':''),1);rep();\r\n  await loadFiles(false);\r\n  if(added)toast(added+' fichier'+(added>1?'s':'')+' ajouté'+(added>1?'s':'')+' depuis Claude');\r\n  if(added&&settings.autoClass!==false){try{const pl=autoPlan(FILES,PJ());if(pl.length){const r=await applyAuto(pl);if(r.n){scanLog.push('Classement automatique : '+r.n+' fichier(s) rangé(s) dans '+r.projs+' projet(s)');rep();toast(r.n+' fichier'+(r.n>1?'s classés':' classé')+' automatiquement · « Classer automatiquement » permet d\\'annuler')}}}catch(x){scanLog.push('Classement automatique impossible : '+String(x&&x.message||x).slice(0,100));rep()}}\r\n}\r\n$('fscanbtn').onclick=scanClaude;\r\n$('fscanx').onclick=()=>{if(!scanning)$('fscan').hidden=true};\r\n$('fscancp').onclick=()=>{api.copy(scanLog.join('\\n'));toast('Rapport copié')};\r\n$('filesbtn').onclick=()=>{filesOpen=!filesOpen;setOpen=false;render();if(filesOpen)loadFiles()};\r\nconst pickFiles=()=>$('fin').click();$('fadd').onclick=pickFiles;$('fadd2').onclick=pickFiles;\r\n$('fin').onchange=e=>{const l=[...e.target.files];e.target.value='';if(l.length)addFiles(l)};\r\n$('fq').oninput=e=>{fq=e.target.value;drawFiles(false)};\r\nlet dragN=0;const isFileDrag=e=>e.dataTransfer&&[...e.dataTransfer.types].includes('Files');\r\n$('files').addEventListener('dragenter',e=>{if(!isFileDrag(e))return;e.preventDefault();dragN++;$('fdrop').classList.add('on')});\r\n$('files').addEventListener('dragover',e=>{if(isFileDrag(e))e.preventDefault()});\r\n$('files').addEventListener('dragleave',()=>{dragN=Math.max(0,dragN-1);if(!dragN)$('fdrop').classList.remove('on')});\r\n$('files').addEventListener('drop',e=>{e.preventDefault();dragN=0;$('fdrop').classList.remove('on');if(e.dataTransfer.files.length)addFiles([...e.dataTransfer.files])});\r\ndocument.addEventListener('dragover',e=>e.preventDefault());document.addEventListener('drop',e=>e.preventDefault());   // jamais d'ouverture d'un fichier lâché à côté\r\n\r\n// ---------- 2.2.6 : icônes animées par type de fichier, couleurs personnalisables ----------\r\nconst FI_SVG=b=>`<svg class=\"fic\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">${b}</svg>`;\r\nconst PG='<path d=\"M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8Z\"/><path d=\"M14 3v5h5\"/>';\r\nconst FI={\r\n  web:{n:'HTML / web',t:'#F0629A',l:'Code',s:FI_SVG('<circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M3 12h18\"/><ellipse class=\"a\" cx=\"12\" cy=\"12\" rx=\"4.4\" ry=\"9\"/><ellipse class=\"b\" cx=\"12\" cy=\"12\" rx=\"4.4\" ry=\"9\"/>')},\r\n  vector:{n:'SVG',t:'#8B7CFF',l:'Image',s:FI_SVG('<rect x=\"3.5\" y=\"4\" width=\"17\" height=\"16\" rx=\"3\"/><circle class=\"a\" cx=\"9\" cy=\"9.5\" r=\"1.8\"/><path class=\"b\" pathLength=\"1\" d=\"m4 18 5-5 3.5 3.5 3-3L20 17\"/>')},\r\n  image:{n:'Images',t:'#4DA3FF',l:'Image',s:FI_SVG('<rect x=\"3.5\" y=\"4\" width=\"17\" height=\"16\" rx=\"3\"/><circle class=\"a\" cx=\"9\" cy=\"9.5\" r=\"1.8\"/><path class=\"b\" pathLength=\"1\" d=\"m4 18 5-5 3.5 3.5 3-3L20 17\"/>')},\r\n  braces:{n:'JSON / YAML / XML',t:'#F5A524',l:'Code',s:FI_SVG('<path class=\"a\" d=\"M9 4C6.5 4 7 7 7 9s-.5 3-3 3c2.5 0 3 1 3 3s-.5 5 2 5\"/><path class=\"b\" d=\"M15 4c2.5 0 2 3 2 5s.5 3 3 3c-2.5 0-3 1-3 3s.5 5-2 5\"/>')},\r\n  code:{n:'Code',t:'#2FC9A6',l:'Code',s:FI_SVG('<path class=\"a\" d=\"m8 7-5 5 5 5\"/><path class=\"b\" d=\"m16 7 5 5-5 5\"/><path class=\"c\" d=\"m13.5 5-3 14\"/>')},\r\n  zip:{n:'Archives',t:'#9C9AA6',l:'Archive',s:FI_SVG('<rect class=\"c\" x=\"9.8\" y=\"9\" width=\"4.4\" height=\"3.2\" rx=\".8\" fill=\"currentColor\" stroke=\"none\"/><path class=\"a\" d=\"M3.5 4.5h17v4h-17z\"/><path d=\"M5 8.5V18a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8.5\"/><path class=\"b\" d=\"M10 13.5h4\"/>')},\r\n  pdf:{n:'PDF',t:'#F0603F',l:'Document',s:FI_SVG(PG+'<path class=\"a\" pathLength=\"1\" d=\"M8.5 12.5h7\"/><path class=\"b\" pathLength=\"1\" d=\"M8.5 16h5\"/>')},\r\n  doc:{n:'Word / documents',t:'#5B8DEF',l:'Document',s:FI_SVG(PG+'<path class=\"a\" pathLength=\"1\" d=\"M8.5 12h7\"/><path class=\"b\" pathLength=\"1\" d=\"M8.5 15h7\"/><path class=\"c\" pathLength=\"1\" d=\"M8.5 18h4\"/>')},\r\n  sheet:{n:'Tableurs / CSV',t:'#3DBE7A',l:'Tableur',s:FI_SVG('<rect class=\"a\" x=\"10.2\" y=\"4.6\" width=\"9.6\" height=\"4.8\" rx=\".5\" fill=\"currentColor\" stroke=\"none\"/><rect class=\"b\" x=\"10.2\" y=\"10.6\" width=\"9.6\" height=\"3.8\" rx=\".5\" fill=\"currentColor\" stroke=\"none\"/><rect class=\"c\" x=\"10.2\" y=\"15.6\" width=\"9.6\" height=\"3.8\" rx=\".5\" fill=\"currentColor\" stroke=\"none\"/><rect x=\"3.5\" y=\"4\" width=\"17\" height=\"16\" rx=\"2.5\"/><path d=\"M3.5 10h17M3.5 15h17M9.5 4v16\"/>')},\r\n  txt:{n:'Texte / Markdown',t:'#E3B341',l:'Texte',s:FI_SVG('<path class=\"a\" pathLength=\"1\" d=\"M5 7h14\"/><path class=\"b\" pathLength=\"1\" d=\"M5 12h14\"/><path class=\"c\" pathLength=\"1\" d=\"M5 17h9\"/>')},\r\n  audio:{n:'Audio',t:'#2FC4C0',l:'Audio',s:FI_SVG('<path class=\"a\" d=\"M4.5 10v4\"/><path class=\"b\" d=\"M8.5 6v12\"/><path class=\"c\" d=\"M12.5 4v16\"/><path class=\"b\" d=\"M16.5 7.5v9\"/><path class=\"a\" d=\"M20.5 10.5v3\"/>')},\r\n  video:{n:'Vidéo',t:'#D55CE0',l:'Vidéo',s:FI_SVG('<rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"3\"/><circle class=\"b\" cx=\"12\" cy=\"12\" r=\"4.6\"/><path class=\"a\" d=\"m10.6 9.8 3.8 2.2-3.8 2.2Z\" fill=\"currentColor\"/>')},\r\n  file:{n:'Autres fichiers',t:'#A3A3B0',l:'Fichier',s:FI_SVG(PG.replace('<path d=\"M14 3v5h5\"/>','<path class=\"a\" d=\"M14 3v5h5\"/>')+'<path class=\"b\" pathLength=\"1\" d=\"M8.5 14h7\"/>')}\r\n};\r\nfunction iconKind(f){const e=extOf(f.name).toLowerCase(),t=f.type||'';\r\n  if(/^(html?|xhtml)$/.test(e))return'web';if(e==='svg')return'vector';\r\n  if(t.startsWith('image/')||/^(png|jpe?g|gif|webp|bmp|ico|avif|heic)$/.test(e))return'image';\r\n  if(/^(json|jsonc|json5|ya?ml|toml|xml)$/.test(e))return'braces';\r\n  if(/^(js|mjs|cjs|ts|jsx|tsx|py|java|c|h|cpp|hpp|cs|go|rs|rb|php|css|scss|sh|bat|ps1|sql|kt|swift|lua|gd|glsl|vue)$/.test(e))return'code';\r\n  if(/^(zip|rar|7z|tar|gz|tgz|bz2|xz|jar|apk)$/.test(e))return'zip';if(e==='pdf')return'pdf';\r\n  if(/^(docx?|odt|rtf|pages)$/.test(e))return'doc';if(/^(xlsx?|csv|tsv|ods|numbers)$/.test(e))return'sheet';\r\n  if(/^(txt|md|markdown|log|ini|cfg|rst)$/.test(e)||t.startsWith('text/'))return'txt';\r\n  if(t.startsWith('audio/')||/^(mp3|wav|ogg|flac|m4a|aac)$/.test(e))return'audio';\r\n  if(t.startsWith('video/')||/^(mp4|webm|mov|mkv|avi)$/.test(e))return'video';\r\n  return'file'}\r\n// Couleurs : par défaut celles de FI, remplaçables par type (settings.fcol), appliquées via des variables CSS\r\nconst fcolOf=ik=>{const c=(settings.fcol||{})[ik];return /^#[0-9a-f]{6}$/i.test(c||'')?c:FI[ik].t};\r\nfunction applyFcol(){for(const ik in FI)document.documentElement.style.setProperty('--fc-'+ik,fcolOf(ik))}\r\nconst fileTile=f=>{const ik=iconKind(f);return `<div class=\"ftile ik-${ik}\" style=\"--tint:var(--fc-${ik})\">${FI[ik].s}</div>`};\r\nconst fileLabel=f=>{const d=FI[iconKind(f)],e=(extOf(f.name)||'').toUpperCase();return d.l+(e?' · '+e.slice(0,5):'')};\r\nfunction drawFcols(){const el=$('ficols');if(!el)return;\r\n  el.innerHTML='<div class=\"fc-head\"><b>Couleurs des fichiers</b><button class=\"btn ghost sm\" id=\"fcreset\">Rétablir les couleurs d\\'origine</button></div><div class=\"fc-grid\">'\r\n    +Object.keys(FI).map(ik=>`<label class=\"fc-item\"><span class=\"ftile ik-${ik}\" style=\"--tint:var(--fc-${ik})\">${FI[ik].s}</span><span class=\"fc-n\">${esc(FI[ik].n)}</span><input type=\"color\" data-fc=\"${ik}\" value=\"${fcolOf(ik)}\"></label>`).join('')+'</div>'}\r\n$('ficols').addEventListener('input',e=>{const i=e.target.closest('[data-fc]');if(!i)return;\r\n  (settings.fcol??={})[i.dataset.fc]=i.value;applyFcol();clearTimeout(drawFcols._t);drawFcols._t=setTimeout(save,300)});\r\n$('ficols').addEventListener('click',e=>{if(!e.target.closest('#fcreset'))return;settings.fcol={};save();applyFcol();drawFcols()});\r\n$('fcolbtn').onclick=()=>{const el=$('ficols');el.hidden=!el.hidden;if(!el.hidden)drawFcols()};\r\n\r\n// ---------- 2.2.4 : projets (tri des fichiers) + bouton « Fichiers AI Hub » dans la barre de saisie de Claude ----------\r\nlet fproj='all';\r\nconst PJ=()=>settings.projects||(settings.projects=[]);\r\nconst projOf=f=>PJ().find(p=>p.id===f.proj)||null;\r\nconst pjIdx=f=>{const i=PJ().findIndex(p=>p.id===f.proj);return i<0?1e6:i};\r\nconst sortP=(a,b)=>{const s=settings.fsort||'new',nm=(x,y)=>x.name.localeCompare(y.name,'fr',{numeric:true}),c=s==='old'?a.added-b.added:s==='az'?nm(a,b):s==='za'?nm(b,a):s==='big'?b.size-a.size:s==='small'?a.size-b.size:s==='type'?(kindOf(a).localeCompare(kindOf(b))||b.added-a.added):b.added-a.added;return fproj==='all'&&s==='new'?(pjIdx(a)-pjIdx(b)||c):c};\r\nconst projSel=f=>`<select class=\"psel\" data-pj=\"${f.id}\" title=\"Projet de ce fichier\"><option value=\"\">Sans projet</option>${PJ().map(p=>`<option value=\"${p.id}\"${p.id===f.proj?' selected':''}>${esc(p.name)}</option>`).join('')}</select>`;\r\nfunction drawProjs(){const el=$('fprojs');if(!el)return;\r\n  const cnt=id=>FILES.filter(f=>id==='none'?!projOf(f):f.proj===id).length;\r\n  const sa=id=>{const ids=catIds(id),all=ids.length&&ids.every(x=>SEL.has(x));return `<button class=\"chipsel${all?' on':''}\" data-pa=\"${id}\" title=\"${all?'Désélectionner':'Tout sélectionner'} dans cette catégorie\"${ids.length?'':' disabled'}>${all?'☑':'☐'}</button>`};\r\n  el.innerHTML=`<span class=\"chipw\"><button class=\"chip ${fproj==='all'?'on':''}\" data-pf=\"all\">Tous<i>${FILES.length}</i></button>${sa('all')}</span><span class=\"chipw\"><button class=\"chip ${fproj==='none'?'on':''}\" data-pf=\"none\">Non classés<i>${cnt('none')}</i></button>${sa('none')}</span>`+extraChips()\r\n    +PJ().map(p=>`<span class=\"chipw\"><button class=\"chip ${fproj===p.id?'on':''}\" data-pf=\"${p.id}\">${IC('folder')}${esc(p.name)}<i>${cnt(p.id)}</i></button>${sa(p.id)}</span>`).join('')\r\n    +trashChip()+`<button class=\"chip add\" data-pf=\"new\">${IC('plus')}Projet</button>`;\r\n  drawPEdit()}\r\nfunction drawPEdit(){const el=$('fpedit'),p=PJ().find(x=>x.id===fproj);\r\n  if(!p){el.hidden=true;el.innerHTML='';delete el.dataset.pid;return}\r\n  if(el.dataset.pid===p.id&&!el.hidden)return;           // ne pas écraser la saisie en cours\r\n  el.dataset.pid=p.id;el.hidden=false;\r\n  el.innerHTML=`<div class=\"pe-row\"><input id=\"pname\" value=\"${esc(p.name)}\" maxlength=\"60\" placeholder=\"Nom du projet\" autocomplete=\"off\"><button class=\"btn sm\" id=\"patt\">${IC('clip')}Joindre tout le projet à…</button><button class=\"btn ghost sm del\" id=\"pdel\">${IC('trash')}Supprimer le projet</button></div>\r\n    <textarea id=\"pdesc\" rows=\"3\" placeholder=\"Décris le projet en quelques mots (facultatif) : à quoi servent ces fichiers ? Cela améliore le résumé donné à Claude.\">${esc(p.desc||'')}</textarea>\r\n    <div class=\"pe-row\"><button class=\"btn sm\" id=\"psumb\">${IC('refresh')}Générer le résumé</button><span class=\"dim\" id=\"pstat\"></span></div><pre id=\"psum\"></pre>`;\r\n  showSum(p)}\r\nfunction showSum(p){const s=$('psum');if(!s)return;s.textContent=p.sum||'Pas encore de résumé : il est créé automatiquement la première fois que tu joins un fichier de ce projet (Gemini si ta clé est enregistrée, sinon un résumé par mots-clés).';\r\n  $('pstat').textContent=p.sum?'Source : '+p.how:''}\r\n$('fprojs').onclick=e=>{const b=e.target.closest('[data-pf]');if(!b)return;\r\n  if(b.dataset.pf==='new'){const p={id:'p'+Date.now().toString(36),name:'Nouveau projet',desc:''};PJ().push(p);fproj=p.id;save();drawFiles(false);setTimeout(()=>{const i=$('pname');if(i){i.focus();i.select()}},60);return}\r\n  fproj=b.dataset.pf;drawFiles(false)};\r\n$('fpedit').addEventListener('change',e=>{const p=PJ().find(x=>x.id===fproj);if(!p)return;\r\n  if(e.target.id==='pname'){p.name=e.target.value.trim()||'Projet';e.target.value=p.name;save();drawFiles(false)}\r\n  if(e.target.id==='pdesc'){p.desc=e.target.value;save()}});\r\n$('fpedit').addEventListener('click',async e=>{const p=PJ().find(x=>x.id===fproj);if(!p)return;\r\n  if(e.target.closest('#pdel')){if(!confirm(`Supprimer le projet « ${p.name} » ? Ses fichiers restent dans la bibliothèque (sans projet).`))return;\r\n    for(const f of FILES.filter(x=>x.proj===p.id))try{await FDB.put({...f,proj:''})}catch{}\r\n    settings.projects=PJ().filter(x=>x.id!==p.id);fproj='all';save();await loadFiles(false);return}\r\n  if(e.target.closest('#psumb')){$('pstat').textContent='Génération…';try{await projSummary(p,true)}catch{}showSum(p)}});\r\n$('fgrid').addEventListener('change',async e=>{const s=e.target.closest('select[data-pj]');if(!s)return;\r\n  const f=FILES.find(x=>x.id===s.dataset.pj);if(!f)return;\r\n  try{await FDB.put({...f,proj:s.value,man:true,auto:false})}catch{return toast('Impossible de changer le projet')}\r\n  await loadFiles(false)});\r\n\r\n\r\n// ---------- 2.2.9 : sélection par catégorie + suppression groupée ----------\r\nconst catIds=id=>viewList(id).map(f=>f.id);\r\nasync function delSelected(){const ids=[...SEL];if(!ids.length)return;\r\n  if(!confirm(`Supprimer ${ids.length} fichier${ids.length>1?'s':''} de la bibliothèque ? Cette action est définitive. (Les conversations où ils ont déjà été joints ne changent pas.)`))return;\r\n  let n=0;for(const id of ids){try{if(String(id).startsWith('scan-'))(settings.scanSkip??=[]).push(id);await FDB.del(id);n++}catch{}}\r\n  SEL.clear();save();await loadFiles(false);toast(n+' fichier'+(n>1?'s supprimés':' supprimé'))}\r\n$('fprojs').addEventListener('click',e=>{const b=e.target.closest('[data-pa]');if(!b||b.disabled)return;\r\n  const ids=catIds(b.dataset.pa),all=ids.length&&ids.every(x=>SEL.has(x));\r\n  ids.forEach(x=>all?SEL.delete(x):SEL.add(x));drawFiles(false)});\r\n$('fgrid').addEventListener('change',e=>{const c=e.target.closest('input[data-sel]');if(!c)return;\r\n  c.checked?SEL.add(c.dataset.sel):SEL.delete(c.dataset.sel);c.closest('.fcard').classList.toggle('sel',c.checked);drawProjs();drawSel()});\r\n$('fselbar').addEventListener('click',e=>{if(e.target.closest('#selnone')){SEL.clear();drawFiles(false)}else if(e.target.closest('#seldel'))delSelected()});\r\n\r\n// ---------- 2.2.8 : classement automatique des fichiers en projets ----------\r\nconst AGEN=new Set(['index','main','app','script','scripts','test','tests','readme','untitled','image','img','photo','screenshot','capture','document','doc','file','fichier','new','nouveau','copy','copie','final','old','backup','temp','tmp','data','style','styles','code','texte','text','page','sans','titre','artifact','output','result','resultat','export','download','sans titre']);\r\nconst ASTOP=new Set(['de','du','des','la','le','les','un','une','et','en','pour','the','of','and','to','in','mon','ma','mes']);\r\nconst aTok=s=>String(s||'').replace(/\\.[A-Za-z0-9]{1,6}$/,'').normalize('NFD').replace(/[\\u0300-\\u036f]/g,'').toLowerCase().replace(/\\(\\d+\\)/g,' ').split(/[^a-z0-9]+/).filter(Boolean);\r\nconst aSig=t=>t.length>=2&&!AGEN.has(t)&&!ASTOP.has(t);\r\nconst aStem=name=>{const out=[];for(const t of aTok(name)){if(/^v?\\d+$/.test(t))break;if(aSig(t))out.push(t)}return out};\r\nconst aCap=s=>{s=String(s).trim().slice(0,60);return s.charAt(0).toUpperCase()+s.slice(1)};\r\n// files : [{id,name,proj,man,src}] ; projects : [{id,name}] -> [{pid|null,name,files:[file],tokens}]\r\nfunction autoPlan(files,projects){\r\n  const hasP=f=>!!f.proj&&projects.some(p=>p.id===f.proj),elig=f=>!hasP(f)&&!f.man;\r\n  const par=files.map((_,i)=>i),find=i=>{while(par[i]!==i){par[i]=par[par[i]];i=par[i]}return i},uni=(a,b)=>{a=find(a);b=find(b);if(a!==b)par[b]=a};\r\n  const bucket={},put=(k,i)=>{if(k)(bucket[k]??=[]).push(i)};\r\n  const convOf=f=>{const c=f.src&&f.src.conv;return c&&!/^(sans titre|untitled)$/i.test(String(c).trim())?String(c).trim():''};\r\n  files.forEach((f,i)=>{const st=aStem(f.name);let k='';\r\n    if(st.length){k=st[0].length>=4?st[0]:st.slice(0,2).join(' ');if(k.length<3)k=''}\r\n    put(k&&'n|'+k,i);const c=convOf(f);if(c)put('c|'+((f.src&&f.src.acc)||'')+'|'+c.toLowerCase(),i)});\r\n  for(const [k,ix] of Object.entries(bucket)){if(ix.length<2)continue;if(k[0]==='c'&&ix.length>25)continue;for(let j=1;j<ix.length;j++)uni(ix[0],ix[j])}\r\n  const comps={};files.forEach((f,i)=>(comps[find(i)]??=[]).push(f));\r\n  const out=[],newByName={};\r\n  for(const mem of Object.values(comps)){\r\n    const free=mem.filter(elig);if(!free.length)continue;\r\n    const anch=mem.filter(hasP);let pid=null,name='';\r\n    if(anch.length){const c={};anch.forEach(f=>c[f.proj]=(c[f.proj]||0)+1);pid=Object.keys(c).sort((a,b)=>c[b]-c[a])[0];name=projects.find(p=>p.id===pid).name}\r\n    else{\r\n      const toks=new Set();mem.forEach(f=>{aStem(f.name).forEach(t=>toks.add(t));aTok(convOf(f)).filter(aSig).forEach(t=>toks.add(t))});\r\n      const hit=projects.find(p=>{const pt=aTok(p.name).filter(aSig);return pt.length&&pt.every(t=>toks.has(t))});\r\n      if(hit){pid=hit.id;name=hit.name}\r\n      else if(free.length>=2){\r\n        const cs={};mem.forEach(f=>{const s=aStem(f.name);if(s.length)cs[s[0]]=(cs[s[0]]||0)+1});\r\n        const top=Object.keys(cs).sort((a,b)=>cs[b]-cs[a])[0];\r\n        const cv={};mem.forEach(f=>{const c=convOf(f);if(c)cv[c]=(cv[c]||0)+1});\r\n        const topc=Object.keys(cv).sort((a,b)=>cv[b]-cv[a])[0];\r\n        if(top&&cs[top]>=Math.ceil(mem.length/2)){const m=mem.find(f=>aStem(f.name)[0]===top);name=aCap(aStem(m.name).slice(0,3).join(' '))}\r\n        else if(topc)name=aCap(topc);\r\n        else if(top)name=aCap(top);else name='Projet automatique';\r\n        const ex=projects.find(p=>p.name.toLowerCase()===name.toLowerCase());if(ex){pid=ex.id;name=ex.name}\r\n      }else continue;\r\n    }\r\n    const key=pid?'p|'+pid:'n|'+name.toLowerCase();\r\n    if(newByName[key]){newByName[key].files.push(...free);continue}\r\n    out.push(newByName[key]={pid,name,files:[...free]});\r\n  }\r\n  return out.sort((a,b)=>b.files.length-a.files.length||a.name.localeCompare(b.name));\r\n}\r\nlet autoProps=[];\r\nasync function applyAuto(props){\r\n  const created=[],moved=[];\r\n  for(const p of props){\r\n    let pid=p.pid;\r\n    if(!pid){const ex=PJ().find(x=>x.name.toLowerCase()===p.name.toLowerCase());\r\n      if(ex)pid=ex.id;else{pid='p'+Date.now().toString(36)+Math.random().toString(36).slice(2,5);PJ().push({id:pid,name:p.name,desc:'',auto:true});created.push(pid)}}\r\n    for(const f of p.files){const cur=FILES.find(x=>x.id===f.id);if(!cur||projOf(cur)||cur.man)continue;\r\n      try{await FDB.put({...cur,proj:pid,auto:true});moved.push({id:cur.id,to:pid})}catch{}}}\r\n  settings.lastAuto={created,moved};save();await loadFiles(false);return {n:moved.length,projs:new Set(moved.map(m=>m.to)).size}}\r\nasync function undoAuto(){const la=settings.lastAuto;if(!la||!la.moved||!la.moved.length)return toast('Rien à annuler');\r\n  let n=0;for(const m of la.moved){const f=FILES.find(x=>x.id===m.id);if(f&&f.proj===m.to&&f.auto){try{await FDB.put({...f,proj:'',auto:false});n++}catch{}}}\r\n  await loadFiles(false);\r\n  settings.projects=PJ().filter(p=>!((la.created||[]).includes(p.id)&&!FILES.some(f=>f.proj===p.id)));\r\n  if(!PJ().some(p=>p.id===fproj)&&!['all','none','fav','recent','trash'].includes(fproj))fproj='all';\r\n  settings.lastAuto=null;save();await loadFiles(false);toast(n+' fichier'+(n>1?'s remis':' remis')+' sans projet');drawAuto()}\r\nfunction drawAuto(){const el=$('fauto');el.hidden=false;\r\n  const la=settings.lastAuto,sel=autoProps.length;\r\n  el.innerHTML=`<div class=\"ap-h\"><b>Classement automatique</b><span class=\"dim\">${sel?sel+' regroupement'+(sel>1?'s':'')+' proposé'+(sel>1?'s':''):''}</span></div>`\r\n    +(sel?autoProps.map((p,i)=>`<div class=\"ap\"><label><input type=\"checkbox\" data-ap=\"${i}\" checked>${p.pid?`<span class=\"apn\">${esc(p.name)}</span>`:`<input class=\"apin\" data-apn=\"${i}\" value=\"${esc(p.name)}\" maxlength=\"60\">`}<em class=\"tag\">${p.pid?'projet existant':'nouveau projet'}</em><span class=\"dim\">${p.files.length} fichier${p.files.length>1?'s':''}</span></label><ul>${p.files.slice(0,8).map(f=>`<li>${esc(f.name)}</li>`).join('')}${p.files.length>8?`<li>… et ${p.files.length-8} autre${p.files.length-8>1?'s':''}</li>`:''}</ul></div>`).join(''):'<p class=\"dim\">Rien à classer : tous les fichiers sont déjà rangés, ou aucun n\\'a de point commun (même nom, même conversation) avec un autre. Un fichier que tu ranges toi-même n\\'est jamais déplacé.</p>')\r\n    +`<div class=\"ap-f\"><label class=\"dim\"><input type=\"checkbox\" id=\"apauto\"${settings.autoClass!==false?' checked':''}> Classer automatiquement après chaque scan</label><span class=\"sp\"></span>`\r\n    +(la&&la.moved&&la.moved.length?`<button class=\"btn ghost sm\" id=\"apundo\">Annuler le dernier classement (${la.moved.length})</button>`:'')\r\n    +(sel?`<button class=\"btn pri sm\" id=\"apgo\">Classer la sélection</button>`:'')+`<button class=\"btn ghost sm\" id=\"apx\">Fermer</button></div>`}\r\nfunction runAutoPreview(){if(!FILES.length){toast('La bibliothèque est vide');return}autoProps=autoPlan(FILES,PJ());drawAuto()}\r\n$('fautobtn').onclick=runAutoPreview;\r\n$('fauto').addEventListener('click',async e=>{\r\n  if(e.target.closest('#apx')){$('fauto').hidden=true;return}\r\n  if(e.target.closest('#apundo'))return undoAuto();\r\n  if(e.target.closest('#apgo')){\r\n    const sel=[...$('fauto').querySelectorAll('input[data-ap]')].filter(c=>c.checked).map(c=>{const p=autoProps[+c.dataset.ap];const i=$('fauto').querySelector(`input[data-apn=\"${c.dataset.ap}\"]`);return {...p,name:i?(i.value.trim()||p.name):p.name}});\r\n    if(!sel.length)return toast('Aucun regroupement coché');\r\n    const r=await applyAuto(sel);autoProps=[];drawAuto();toast(r.n+' fichier'+(r.n>1?'s classés':' classé')+' dans '+r.projs+' projet'+(r.projs>1?'s':''))}});\r\n$('fauto').addEventListener('change',e=>{if(e.target.id==='apauto'){settings.autoClass=e.target.checked;save()}});\r\n\r\n// Résumé d'un projet : Gemini si une clé est enregistrée, sinon repli par mots-clés. Mis en cache tant que les fichiers ne changent pas.\r\nconst STOPW=new Set('avec dans pour that this from have with います les des une est sur par pas plus comme mais vous nous leur ils elles cette ces aux the and for are was not you your but can will var let const function return true false null undefined import export class else then when what which about into over html json text file name type data'.split(' '));\r\nasync function sampleOf(f){const k=kindOf(f),e=extOf(f.name).toLowerCase();\r\n  if(f.size>3*1048576||!(k==='code'||k==='txt'||/^(csv|tsv|md|txt|log|ini|cfg|toml)$/.test(e)))return '';\r\n  try{return (await f.blob.slice(0,6000).text()).replace(/\\0/g,'').slice(0,5000)}catch{return ''}}\r\nfunction keywordsOf(texts,n=12){const c={};\r\n  for(const t of texts)for(const w of (String(t).toLowerCase().match(/[a-zà-ÿ][a-zà-ÿ0-9_]{3,}/g)||[]))if(!STOPW.has(w))c[w]=(c[w]||0)+1;\r\n  return Object.entries(c).sort((a,b)=>b[1]-a[1]).slice(0,n).map(x=>x[0])}\r\nfunction fallbackProj(p,fl,samples){\r\n  const kinds={};fl.forEach(f=>{const k=kindOf(f);kinds[k]=(kinds[k]||0)+1});\r\n  const kw=keywordsOf(fl.map(f=>f.name.replace(/[._-]/g,' ')).concat(samples,[p.desc||'',p.name]));\r\n  return (p.desc&&p.desc.trim()?p.desc.trim()+'\\n':'')+`Projet « ${p.name} » : ${fl.length} fichier${fl.length>1?'s':''}`+(Object.keys(kinds).length?' ('+Object.entries(kinds).map(([k,n])=>n+' '+k).join(', ')+')':'')+'.\\n'\r\n    +'Fichiers : '+fl.slice(0,25).map(f=>f.name).join(', ')+(fl.length>25?'…':'')+'.'+(kw.length?'\\nMots-clés : '+kw.join(', ')+'.':'')}\r\nasync function projSummary(p,force){\r\n  const fl=FILES.filter(f=>f.proj===p.id),g=settings.gemini||{},sig=(p.desc||'')+'|'+p.name+'|'+fl.map(f=>f.id+':'+f.size).sort().join(',')+'|'+(g.key?'g':'k');\r\n  if(!force&&p.sum&&p.sig===sig)return {text:p.sum,how:p.how};\r\n  const samples=[];let tot=0;\r\n  for(const f of fl){if(tot>24000)break;const s=await sampleOf(f);if(s){samples.push(s);tot+=s.length}}\r\n  let text='',how='';\r\n  if(g.key){toast('Résumé du projet « '+p.name+' » par Gemini…');\r\n    const prompt=`Résume en 120 mots maximum, en français, ce projet pour qu'une IA comprenne de quoi il s'agit quand elle reçoit l'un de ses fichiers. Dis à quoi sert le projet et le rôle probable de chaque fichier. N'invente rien : si tu ne sais pas, dis-le.\\nNom du projet : ${p.name}\\nDescription de l'utilisateur : ${p.desc||'aucune'}\\nFichiers : ${fl.map(f=>f.name+' ('+fmtSize(f.size)+')').join(', ')||'aucun'}\\n`\r\n      +(samples.length?'\\nExtraits de fichiers texte :\\n'+samples.map((s,i)=>'--- extrait '+(i+1)+' ---\\n'+s).join('\\n'):'');\r\n    try{const r=await api.gemini({key:g.key,model:g.model||GEM,system:'Tu écris des résumés de projet courts, fidèles et factuels.',prompt});\r\n      if(r&&r.ok&&r.text){text=String(r.text).trim();how='Gemini'}else LOG.unshift({ts:Date.now(),acc:'code',type:'summary-error',detail:'résumé de projet : '+((r&&r.error)||'échec')})}\r\n    catch(x){LOG.unshift({ts:Date.now(),acc:'code',type:'summary-error',detail:String(x&&x.message||x)})}}\r\n  if(!text){text=fallbackProj(p,fl,samples);how='mots-clés'}\r\n  p.sum=text;p.sig=sig;p.how=how;save();return {text,how}}\r\n\r\n// Texte ajouté dans la zone de message quand on joint un fichier d'un projet : Claude sait d'où il vient.\r\nconst ANN={};\r\nasync function addProjectContext(a,pid,f){\r\n  const p=PJ().find(x=>x.id===pid);if(!p)return;\r\n  await sleep(700);\r\n  const v=view(a);let url='';try{url=v.getURL()}catch{}\r\n  const chat=/\\/(chat|c)\\/[\\w-]{8,}/.test(url),key=a.id+'|'+pid;\r\n  let txt;\r\n  if(chat&&ANN[key]===url)txt=`[Projet « ${p.name} »${f?' · fichier joint : '+f.name:''}]\\n\\n`;\r\n  else{const s=await projSummary(p);\r\n    txt=`[CONTEXTE DU PROJET « ${p.name} »]\\n${s.text}\\n`+(f?`\\nFichier joint maintenant : ${f.name} (il fait partie de ce projet).\\n`:'')+`\\n`;\r\n    if(chat)ANN[key]=url}\r\n  await hub.paste(txt,{account:a.id});\r\n  toast(f?`Fichier et contexte du projet « ${p.name} » ajoutés`:`Contexte du projet « ${p.name} » ajouté`)}\r\nfunction pushMenu(only){\r\n  const d={projects:PJ().map(p=>({id:p.id,name:p.name})),files:FILES.map(f=>({id:f.id,name:f.name,size:f.size,proj:projOf(f)?f.proj:'',k:kindOf(f)}))};\r\n  document.querySelectorAll('webview').forEach(v=>{if(only&&v!==only)return;\r\n    const a=accs.find(x=>x.id===v.dataset.id);if(!a||a.p!=='Claude'||!v._ready)return;try{v.send('hub:menu',d)}catch{}})}\r\n// ---------- notifications ----------\r\n// Le système (Windows) n'affiche une notification que si l'utilisateur a autorisé AI Hub ici ; sinon, simple bulle dans l'app.\r\nfunction ping(type,title,body,accId,o={}){\r\n  const N=settings.notif;if(type!=='script'&&N.on[type]===false)return;\r\n  const focused=document.hasFocus();\r\n  if(focused||o.toast)toast(title+(body?' — '+body:''));\r\n  if(!focused&&N.enabled===true)api.notify(title,body||'',accId||null).catch(()=>{});\r\n}\r\nfunction drawNotif(){\r\n  const N=settings.notif,on=N.enabled===true;\r\n  $('nstate').textContent=on?'Autorisées':N.enabled===false?'Refusées':'Pas encore demandé';\r\n  $('nstate').className='pill '+(on?'ok':N.enabled===false?'no':'');\r\n  $('nauth').textContent=on?'Désactiver':'Autoriser les notifications';\r\n  $('nauth').classList.toggle('pri',!on);$('ntest').disabled=!on;\r\n  $('nhint').textContent=on?'Si rien ne s\\'affiche : Paramètres Windows > Système > Notifications > AI Hub, et vérifie que le mode « Ne pas déranger » est désactivé.':'Les notifications ne s\\'affichent que lorsque la fenêtre AI Hub n\\'est pas au premier plan.';\r\n  document.querySelectorAll('#set input[data-n]').forEach(el=>{el.checked=N.on[el.dataset.n]!==false;const o=el.closest('.opt');if(o)o.classList.toggle('off',!on)});\r\n}\r\nasync function testNotif(){const r=await api.notify('AI Hub','Les notifications fonctionnent.',null);\r\n  if(!r.ok)toast('Notifications non prises en charge par ce système.');return r.ok}\r\nasync function setNotif(v){settings.notif.enabled=v;save();drawNotif();if(v){const ok=await testNotif();if(!ok){settings.notif.enabled=false;save();drawNotif()}}}\r\n$('nauth').onclick=()=>setNotif(settings.notif.enabled!==true);\r\n$('ntest').onclick=testNotif;\r\ndocument.querySelectorAll('#set input[data-n]').forEach(el=>el.onchange=()=>{settings.notif.on[el.dataset.n]=el.checked;save()});\r\n$('nyes').onclick=()=>{$('dlgN').close();setNotif(true)};\r\n$('nno').onclick=()=>{$('dlgN').close();setNotif(false)};\r\n$('nlater').onclick=()=>$('dlgN').close();\r\napi.onNotifClick(id=>{if(id&&find(id)){active=id;setOpen=false;filesOpen=false;save();render()}});\r\n\r\n// ---------- vues (une par compte) ----------\r\nconst cfg=p=>({idle:120,clean:settings.clean!==false,sel:(settings.selectors||{})[p]||{},detectors:settings.devMode?detectors.map(d=>({...d,host:d.site&&d.site!=='*'&&P[d.site]?new URL(P[d.site][0]).hostname:'*'})):[]});\r\nconst pushCfg=()=>document.querySelectorAll('webview').forEach(v=>{const a=find(v.dataset.id);if(a)try{v.send('hub:config',cfg(a.p))}catch{}});\r\n\r\nfunction view(a){\r\n  let v=document.querySelector(`webview[data-id=\"${a.id}\"]`);\r\n  if(!v){v=document.createElement('webview');v.dataset.id=a.id;\r\n    v.setAttribute('partition','persist:'+a.id);v.setAttribute('useragent',UA);v.setAttribute('allowpopups','');v.setAttribute('preload',PRE);\r\n    v.addEventListener('ipc-message',e=>{if(e.channel==='hub-event')handle(a,e.args[0]);else if(e.channel==='hub-attach-open')pushMenu(v);else if(e.channel==='hub-attach-pick')onMenuPick(a,e.args[0]).catch(x=>toast('Impossible de joindre : '+String(x&&x.message||x).slice(0,80)))});\r\n    v.addEventListener('did-start-loading',()=>{v._ld=true;bar()});v.addEventListener('did-stop-loading',()=>{v._ld=false;bar()});\r\n    v.addEventListener('dom-ready',()=>{v._ready=true;try{v.send('hub:config',cfg(a.p))}catch{}pushMenu(v)});\r\n    v.addEventListener('did-fail-load',e=>{if(e.isMainFrame&&e.errorCode!==-3&&(v._rt=(v._rt||0)+1)<=3)setTimeout(()=>{try{v.reload()}catch{}},3000*v._rt)});\r\n    v.src=P[a.p][0];$('views').appendChild(v);}\r\n  return v;\r\n}\r\nconst bar=()=>{const v=document.querySelector(`webview[data-id=\"${active}\"]`);$('bar').classList.toggle('on',!!(v&&v._ld&&!setOpen&&!filesOpen))};\r\n\r\nfunction handle(a,ev){\r\n  const s=stOf(a.id),t=ev.type;\r\n  if(t==='page-start'){if(!(s.limited&&limAlive(a,s))){s.limited=false;s.until=0;s.limAt=0;persistLim(a)}s.gen=false;s.logged=null;return renderList()}\r\n  if(t==='google-blocked')toast('Google refuse la connexion dans cette fenêtre. Clique « Connexion via Chrome » (en haut) : tu te connectes dans un vrai Chrome et AI Hub récupère la session.');\r\n  if(t==='limit-hit'){const u=+((ev.detail||{}).until)||0;if(u&&u<=Date.now()){limReset(a);return}s.until=u||s.until||0}\r\n  if(t==='limit-cleared')s.until=0;\r\n  if(t==='response-started')s.gen=true;if(t==='response-complete')s.gen=false;\r\n  if(t==='limit-hit'){if(!s.limited||!s.limAt)s.limAt=ev.ts||Date.now();s.limited=true}if(t==='limit-cleared'){s.limited=false;s.limAt=0}\r\n  if(t==='limit-hit'||t==='limit-cleared')persistLim(a);\r\n  if(t==='logged-in')s.logged=true;if(t==='login-required')s.logged=false;\r\nif(t==='selftest'){const d=ev.detail||{},bad=d.ok===false;if(bad&&!s.selfbad)LOG.unshift({ts:ev.ts,acc:a.p+' · '+a.n,type:'selector-warning',detail:'autotest : zone de saisie ou messages non trouvés '+JSON.stringify(d.counts||{})});s.selfbad=bad;s.selfCounts=d.counts||null;renderList()}\r\n  s.last=t;s.lastAt=ev.ts;\r\n  LOG.unshift({ts:ev.ts,acc:a.p+' · '+a.n,type:t,detail:ev.detail,url:ev.url});if(LOG.length>500)LOG.pop();\r\n  const e={...ev,account:pub(a)};\r\n  (H[t]||[]).concat(H['*']||[]).forEach(fn=>run(fn,e));          // scripts perso (vide si le mode développeur est désactivé)\r\n  if(t==='limit-hit')onLimit(a);\r\n  else if(t==='response-complete')onDone(a,ev);\r\n  else if(t==='session-expired')ping('logout','Compte déconnecté',a.p+' · '+a.n,a.id);\r\n  renderList();if(setOpen&&tab==='log')drawLog();\r\n}\r\nconst codeErr=x=>{LOG.unshift({ts:Date.now(),acc:'code',type:'code-error',detail:String(x&&x.message||x)});$('cst').textContent='Erreur : '+String(x&&x.message||x)};\r\nconst run=async(fn,e)=>{try{await fn(e)}catch(x){codeErr(x)}};\r\nfunction onDone(a,ev){\r\n  if(a.id===active&&!setOpen&&document.hasFocus())return;          // tu regardes déjà ce compte\r\n  const d=ev.detail||{};if((d.chars||0)<20)return;\r\n  ping('done',a.p+' · '+a.n+' a répondu',(d.preview||'').replace(/\\s+/g,' ').slice(0,110),a.id);\r\n}\r\n\r\n// ---------- liste des comptes ----------\r\nconst hm=t=>new Date(t).toLocaleTimeString('fr-FR',{hour:'2-digit',minute:'2-digit'});\r\nconst limReset=a=>{const v=document.querySelector(`webview[data-id=\"${a.id}\"]`);try{v&&v.send('hub:limit-reset')}catch{}};\r\nsetInterval(()=>{let ch=false;for(const a of accs){const s=stOf(a.id);if(s.limited&&s.until&&s.until<=Date.now()){s.limited=false;s.until=0;s.limAt=0;persistLim(a);limReset(a);ch=true;ping('limit','Limite levée',a.p+' · '+a.n+' peut de nouveau répondre',a.id)}}if(ch)renderList()},15000);\r\nconst badges=s=>(s.gen?'<i class=\"spin\" title=\"L\\'IA répond\"></i>':'')+(s.limited?`<em class=\"bd err\" title=\"${s.until?'Limite atteinte jusqu’à '+hm(s.until):'Limite atteinte'+(s.limAt?' (depuis '+hm(s.limAt)+')':'')}\">${IC('ban')}${s.until?`<small class=\"until\">${hm(s.until)}</small>`:''}</em>`:'')+(s.logged===false?`<em class=\"bd\" title=\"Déconnecté\">${IC('lock')}</em>`:'')+(s.degraded?`<em class=\"bd warn\" title=\"Conversation non reconnue : sélecteurs à vérifier (Paramètres > Reprise)\">${IC('warn')}</em>`:'');\r\nfunction renderList(){\r\n  const by={};accs.forEach(a=>(by[a.p]??=[]).push(a));\r\n  $('list').innerHTML=Object.keys(by).map(p=>`<div class=\"grp ${entG(p)}\">${esc(p)}</div>`+by[p].map((a,i)=>{const s=stOf(a.id);\r\n    return `<div class=\"acc ${a.id===active&&!setOpen&&!filesOpen?'on':''} ${entA(a.id)}\" style=\"--i:${i}\" data-id=\"${a.id}\"><i class=\"dot\" style=\"background:${P[p][1]}\"></i><span>${esc(a.n)}</span>${badges(s)}<b data-ren=\"${a.id}\" title=\"Renommer\">${IC('edit')}</b><b data-del=\"${a.id}\" title=\"Supprimer\">${IC('x')}</b></div>`}).join('')).join('');\r\n}\r\nfunction render(){\r\n  renderList();if(!PRE)return;\r\n  if(settings.preloadAll)accs.forEach(view);\r\n  document.querySelectorAll('webview').forEach(v=>v.classList.toggle('on',v.dataset.id===active));\r\n  const a=find(active);\r\n  $('title').textContent=filesOpen?'Fichiers':setOpen?'Paramètres':a?`${a.p} · ${a.n}`:'Aucun compte sélectionné';\r\n  $('empty').style.display=a?'none':'grid';\r\n  document.querySelector('.hbtns').style.visibility=(setOpen||filesOpen||!a)?'hidden':'visible';\r\n  $('set').classList.toggle('on',setOpen&&!filesOpen);$('files').classList.toggle('on',filesOpen);$('filesbtn').classList.toggle('on',filesOpen);\r\n  if(a)view(a).classList.add('on');\r\n  bar();\r\n}\r\n$('list').onclick=async e=>{\r\n  const rn=e.target.closest('[data-ren]'),d=e.target.closest('[data-del]');\r\n  if(rn){renId=rn.dataset.ren;$('rname').value=find(renId).n;$('dlg2').showModal();$('rname').focus();return}\r\n  if(d){const id=d.dataset.del,a=find(id);if(!confirm(`Supprimer ${a.p} · ${a.n} et sa session ?`))return;\r\n    document.querySelector(`webview[data-id=\"${id}\"]`)?.remove();await api.clear('persist:'+id);delete st[id];\r\n    accs=accs.filter(x=>x.id!==id);if(active===id)active=accs[0]?.id||null;save();return render();}\r\n  const r=e.target.closest('.acc');if(r){active=r.dataset.id;setOpen=false;filesOpen=false;save();render();}\r\n};\r\nconst openAdd=()=>{$('name').value='';$('dlg').showModal();$('name').focus()};\r\n$('add').onclick=openAdd;$('add2').onclick=openAdd;\r\n$('cancel').onclick=()=>$('dlg').close();\r\n$('ok').onclick=()=>{const n=$('name').value.trim();if(!n)return $('name').focus();\r\n  const a={id:'a'+Date.now(),p:$('plat').value,n};accs.push(a);active=a.id;setOpen=false;filesOpen=false;save();$('dlg').close();render();};\r\n$('name').onkeydown=e=>{if(e.key==='Enter')$('ok').click()};\r\n$('reload').onclick=()=>hub.reload();\r\n\r\n// ---------- lecture des conversations ----------\r\n// Sélecteurs d'origine (alignés sur webview-preload.js) + sélecteurs de secours de Paramètres > Reprise\r\nconst SELB={user:'[data-testid=\"user-message\"],user-query,[data-message-author-role=\"user\"],article[data-turn=\"user\"],section[data-turn=\"user\"],[data-turn=\"user\"],[data-chatgpt-search-unit-key$=\":user\"],.ds-message .ds-collapsible-text',ai:'.font-claude-response,.font-claude-message,[data-testid=\"assistant-message\"],[data-is-streaming],model-response,[data-message-author-role]:not([data-message-author-role=\"user\"]),article[data-turn=\"assistant\"],section[data-turn=\"assistant\"],[data-turn=\"assistant\"],.markdown.prose,message-content,.response-container,[data-chatgpt-search-unit-key$=\":assistant\"],.ds-assistant-message-main-content',comp:COMPOSER,stop:'[data-testid=\"stop-button\"],button[aria-label*=\"Stop\" i],button[aria-label*=\"Arrêter\" i],button[aria-label*=\"Interrompre\" i]',send:'[data-testid=\"send-button\"],button[aria-label*=\"Send\" i],button[aria-label*=\"Envoyer\" i]'};\r\nconst selOf=(p,k)=>{const x=((settings.selectors||{})[p]||{})[k];return x&&x.trim()?SELB[k]+','+x.trim():SELB[k]};\r\nconst isChatUrl=u=>{try{return /\\/(chat|c|chats|app|thread|search|s)\\/[\\w-]{8,}/.test(new URL(u).pathname)}catch{return false}};\r\n// Une conversation est « reconnue » dès qu'on trouve au moins UN de tes messages (la limite peut empêcher toute réponse de l'IA)\r\nconst EXTRACT=a=>`(()=>{const ok=s=>{try{document.querySelector(s);return true}catch{return false}};\r\nconst U=${JSON.stringify(selOf(a.p,'user'))},A=${JSON.stringify(selOf(a.p,'ai'))};\r\nconst UU=ok(U)?U:${JSON.stringify(SELB.user)},AA=ok(A)?A:${JSON.stringify(SELB.ai)};\r\nconst DSB=location.hostname.indexOf('deepseek')>=0?[...document.querySelectorAll('.ds-message .ds-collapsible-text,.ds-assistant-message-main-content')]:[];\nif(DSB.length){const o=[];for(const b of DSB){if(b.closest('.ds-think-content'))continue;const u=b.matches('.ds-collapsible-text');const t=(b.innerText||'').trim();if(!t)continue;o.push({r:u?'user':'ai',t})}\nif(o.some(m=>m.r==='user'))return {mode:'structured',msgs:o,url:location.href}}\nconst GB=[...document.querySelectorAll('[data-chatgpt-search-unit-key$=\":assistant\"],[data-chatgpt-search-unit-key$=\":user\"],[data-content-search-unit-key$=\":assistant\"],[data-content-search-unit-key$=\":user\"]')];\r\nif(GB.length){const seen=new Set(),o=[];for(const b of GB){const k=b.getAttribute('data-chatgpt-search-unit-key')||b.getAttribute('data-content-search-unit-key')||'';const u=/:user$/.test(k);const te=u?(b.querySelector('[data-user-message-bubble=\"true\"]')||b):b.querySelector('[data-markdown-text-style=\"assistant-message\"]');if(!te)continue;const t=(te.innerText||'').trim();if(!t)continue;const sel=b.querySelector('[data-chatgpt-selection-message-id]');const id=(b.getAttribute('data-chatgpt-search-message-ids')||'').trim().split(/\\\\s+/)[0]||(sel&&sel.getAttribute('data-chatgpt-selection-message-id'))||(k+'|'+t.slice(0,200));if(seen.has(id))continue;seen.add(id);o.push({r:u?'user':'ai',t})}\r\nif(o.some(m=>m.r==='user'))return {mode:'structured',msgs:o,url:location.href}}\r\nconst els=[...document.querySelectorAll(UU+','+AA)];\r\nconst top=els.filter(e=>!els.some(o=>o!==e&&o.contains(e)));\r\nconst NW=s=>String(s||'').replace(/\\\\s+/g,'');const ct=p=>{let x='';try{const L=p.querySelectorAll('.cm-line');x=L.length?[...L].map(l=>l.textContent).join('\\\\n'):(p.innerText||p.textContent||'')}catch{}return x.replace(/^\\\\s*(Texte brut|Copier le code|Copy code)\\\\s*\\\\n/,'')};const gt=e=>{let t=(e.innerText||'').trim();if(!e.matches(UU)){try{const nt=NW(t);const bl=[...e.querySelectorAll('.cm-content,pre')].filter(p=>!(p.parentElement&&p.parentElement.closest('.cm-content,pre'))).map(ct).filter(x=>x.trim());const tl=new Set(t.split('\\\\n').map(s=>s.trim()));const add=bl.filter(x=>x.split('\\\\n').map(s=>s.trim()).filter(Boolean).some(l=>!tl.has(l)));if(add.length)t=(t?t+'\\\\n':'')+add.join('\\\\n')}catch{}}return t};const out=top.map(e=>({r:e.matches(UU)?'user':'ai',t:gt(e)})).filter(m=>m.t);\r\nconst CMP=${JSON.stringify(COMPOSER)};\r\nconst AFTER=u=>{let e=u;for(let i=0;i<8&&e&&e!==document.body;i++){const parts=[];for(let s=e.nextElementSibling;s;s=s.nextElementSibling){try{if(s.matches('nav,aside,form,footer,script,style')||s.matches(CMP)||s.querySelector(CMP))continue}catch{}const t=(s.innerText||'').trim();if(t)parts.push(t)}if(parts.length)return parts.join('\\\\n\\\\n');e=e.parentElement}return ''};\r\nif(out.length&&out[out.length-1].r==='user'){const lu=top.filter(e=>e.matches(UU)).pop();let t='';try{t=lu?AFTER(lu):''}catch{}if(t)out.push({r:'ai',t,fb:1})}\r\nif(out.some(m=>m.r==='user'))return {mode:'structured',msgs:out,url:location.href};\r\nconst m=document.querySelector('main')||document.body;\r\nreturn {mode:'raw',msgs:[{r:'raw',t:(m.innerText||'').trim()}],url:location.href};})()`;\r\nasync function read(a){\r\n  const r=await view(a).executeJavaScript(EXTRACT(a)),s=stOf(a.id);\r\n  if(r.mode==='raw'&&r.msgs[0]&&r.msgs[0].t&&isChatUrl(r.url)){        // page de conversation mais messages non reconnus\r\n    if(!s.degraded)LOG.unshift({ts:Date.now(),acc:a.p+' · '+a.n,type:'selector-warning',detail:'messages non reconnus : texte brut utilisé. Ajoute des sélecteurs de secours (Paramètres > Reprise).'});\r\n    s.degraded=true;renderList()}\r\n  else if(r.mode==='structured'&&s.degraded){s.degraded=false;renderList()}\r\n  return r}\r\n\r\n// ---------- construction du message de reprise ----------\r\nconst fmt=m=>(m.r==='user'?'👤 Moi : ':'🤖 IA : ')+m.t;\r\n// Garde le début (objectif) + la fin ; supprime des messages entiers au milieu\r\nfunction fit(msgs,max){\r\n  const all=msgs.map(fmt),size=s=>s.length+2;\r\n  if(all.reduce((n,s)=>n+size(s),0)<=max)return {text:all.join('\\n\\n'),cut:0};\r\n  const head=all[0].slice(0,Math.min(4000,Math.floor(max*.15)));\r\n  let budget=max-head.length-80,i=all.length-1;const tail=[];\r\n  while(i>0&&budget>200){const s=all[i];\r\n    if(size(s)<=budget){tail.unshift(s);budget-=size(s);i--}\r\n    else{tail.unshift('[…début du message tronqué…] '+s.slice(-(budget-40)));budget=0;i--;break}}\r\n  return {text:head+'\\n\\n[…'+i+' message(s) intermédiaire(s) omis…]\\n\\n'+tail.join('\\n\\n'),cut:i};\r\n}\r\nconst fitTail=(msgs,max)=>{const out=[];let n=0;for(let i=msgs.length-1;i>=0;i--){const s=fmt(msgs[i]);if(n+s.length>max&&out.length)break;out.unshift(n+s.length>max?s.slice(-max):s);n+=s.length}return {text:out.join('\\n\\n')}};\r\nconst TPL_CONTINUE=`[REPRISE AUTOMATIQUE] Cette conversation vient d'un autre compte {plateforme} ({compte}) qui a atteint sa limite. Tu es le relais : tu reprends le travail exactement là où il en est, sans perte.\r\n\r\n{contexte}\r\n\r\n## INSTRUCTIONS\r\n1. Ne dis pas bonjour, ne résume pas ce que je viens de te donner et ne repose pas de question dont la réponse figure déjà plus haut. Travaille directement.\r\n2. {suite}\r\n3. Réponds de façon concise et directe, dans le même registre et la même langue que la conversation.\r\n4. Si une information dont tu as besoin manque dans ce transfert, dis-le en une phrase au lieu de l'inventer.`;\r\nconst TPL_READY=`[CONTEXTE : conversation exportée depuis {plateforme}]\r\nVoici l'historique d'une conversation précédente. Lis-le en entier, retiens le contexte, réponds seulement « Prêt », puis continue la discussion à partir de là.\r\n\r\n{contexte}\r\n`;\r\nconst fill=(tpl,v)=>tpl.replace(/\\{(\\w+)\\}/g,(m,k)=>v[k]??m);\r\nconst ctxFull=(msgs,max)=>{const f=fit(msgs,max);return {ctx:'## CONVERSATION'+(f.cut?` (${f.cut} messages intermédiaires omis)`:'')+'\\n--- DÉBUT ---\\n'+f.text+'\\n--- FIN ---',how:f.cut?'tronqué':'complet'}};\r\nasync function buildHandoff(src,conv,o){\r\n  const R=settings.relay,msgs=conv.msgs.filter(m=>m.t);let ctx='',how='';\r\n  if(conv.mode==='raw'){ctx='## CONVERSATION (texte brut de la page)\\n--- DÉBUT ---\\n'+msgs[0].t.slice(-R.maxChars)+'\\n--- FIN ---';how='texte brut'}\r\n  else{\r\n    const full=msgs.map(fmt).join('\\n\\n');\r\n    if((o.summary??R.summary)&&hub.aiEnabled&&full.length>R.summaryAbove){\r\n      toast('Résumé de la conversation par Gemini…');\r\n      const sum=await hub.summarize(full,{platform:src.p});\r\n      if(sum){ctx='## RÉSUMÉ DE LA CONVERSATION\\n'+sum+'\\n\\n## FIN DE LA CONVERSATION (telle quelle)\\n'+fitTail(msgs,Math.min(8000,Math.floor(R.maxChars/4))).text;how='résumé'}\r\n    }\r\n    if(!ctx){const c=ctxFull(msgs,R.maxChars);ctx=c.ctx;how=c.how}\r\n  }\r\n  const last=msgs[msgs.length-1];\r\n  const suite=last&&last.r==='user'?'Ma dernière demande n\\'a pas reçu de réponse : réponds-y maintenant.'\r\n    :stOf(src.id).gen?'Ta dernière réponse a été interrompue par la limite : reprends-la exactement là où elle s\\'arrête, sans la recommencer.'\r\n    :'Continue la tâche en cours dans la logique de la fin de la conversation, avec la prochaine étape concrète. Si rien n\\'est en attente, dis-le en une ligne et attends ma prochaine demande.';\r\n  const tpl=R.custom&&R.custom.trim()?R.custom:R.tpl==='ready'?TPL_READY:TPL_CONTINUE;\r\n  const text=fill(tpl,{plateforme:src.p,compte:src.n,contexte:ctx,suite,date:new Date().toLocaleString()});\r\n  return {text,how,chars:text.length};\r\n}\r\n// Texte copié par le bouton « Copier la conversation » (modèle « Prêt », sans résumé)\r\nasync function exportPack(a){\r\n  const conv=await read(a);\r\n  if(conv.mode==='raw'&&(!isChatUrl(conv.url)||!conv.msgs[0]||!conv.msgs[0].t))return null;\r\n  const msgs=conv.msgs.filter(m=>m.t);if(!msgs.length)return null;\r\n  const body=conv.mode==='raw'?'--- DÉBUT ---\\n'+msgs[0].t.slice(-settings.relay.maxChars)+'\\n--- FIN ---':ctxFull(msgs,settings.relay.maxChars).ctx;\r\n  return {mode:conv.mode,n:msgs.length,txt:fill(TPL_READY,{plateforme:a.p,contexte:body})};\r\n}\r\n$('export').onclick=async()=>{\r\n  const a=find(active);if(!a)return toast('Sélectionne un compte d\\'abord');\r\n  try{const r=await exportPack(a);if(!r)return toast('Aucune conversation trouvée sur cette page');\r\n    await api.copy(r.txt);toast(r.mode==='raw'?'Copié : texte brut de la page (format du site non reconnu)':`Copié : ${r.n} messages. Colle-le ailleurs !`);\r\n  }catch(e){toast('Export impossible : '+e.message)}\r\n};\r\n\r\n// ---------- reprise sur un autre compte ----------\r\nlet HQ=Promise.resolve(),LASTANY=0;const LASTH={};\r\nconst enqueue=f=>{const p=HQ.then(f);HQ=p.catch(x=>hlog('fail',null,String(x&&x.message||x)));return p};   // une reprise à la fois\r\nconst hlog=(type,src,detail)=>LOG.unshift({ts:Date.now(),acc:src?src.p+' · '+src.n:'app',type:'handoff-'+type,detail});\r\nconst pickTarget=(src,visited=[])=>accs.find(x=>x.id!==src.id&&!visited.includes(x.id)&&!stOf(x.id).limited&&stOf(x.id).logged!==false&&(!settings.relay.samePlatform||x.p===src.p))||null;\r\nconst okSel=(a,k)=>{try{document.createDocumentFragment().querySelector(selOf(a.p,k));return selOf(a.p,k)}catch{return SELB[k]}};\r\n// Attend que la zone de saisie soit visible (page chargée). Renvoie true, 'login' ou false.\r\nasync function waitComposer(a,ms){\r\n  const v=view(a),t0=Date.now(),C=JSON.stringify(okSel(a,'comp'));\r\n  while(Date.now()-t0<ms){\r\n    try{const r=await v.executeJavaScript(`(()=>({c:[...document.querySelectorAll(${C})].some(e=>e.getClientRects().length>0),pw:!!document.querySelector('input[type=password]')}))()`);\r\n      if(r.c)return true;if(r.pw&&Date.now()-t0>4000)return 'login'}catch{}\r\n    await sleep(150)}\r\n  return false}\r\nfunction onLimit(a){\r\n  const R=settings.relay,dst=R.enabled?pickTarget(a):null;\r\n  if(!dst){ping('limit','Limite atteinte',a.p+' · '+a.n+(R.enabled?' — aucun autre compte disponible':''),a.id,{toast:true});return}\r\n  if(R.mode==='ask'){ping('limit','Limite atteinte sur '+a.p+' · '+a.n,'Ouvre AI Hub pour reprendre sur '+dst.n,a.id);return askBanner(a,dst)}\r\n  enqueue(()=>handoff(a.id,{to:dst.id,auto:true}));\r\n}\r\nfunction askBanner(src,dst){const b=$('ask');b.hidden=false;b.dataset.src=src.id;b.dataset.dst=dst.id;\r\n  $('asktxt').innerHTML=`Limite atteinte sur <b>${esc(src.p)} · ${esc(src.n)}</b>. Reprendre la conversation sur <b>${esc(dst.p)} · ${esc(dst.n)}</b> ?`}\r\n$('askyes').onclick=()=>{const b=$('ask');b.hidden=true;enqueue(()=>handoff(b.dataset.src,{to:b.dataset.dst}))};\r\n$('askno').onclick=()=>{$('ask').hidden=true};\r\n// 4.12 (F2) : bannière « l'interface du site a changé » + réparation en un clic (relance la config et l'autotest)\r\nlet FIXHID={};\r\nfunction drawFix(){const b=$('fixbn');if(!b)return;const a=find(active),s=a&&stOf(a.id);\r\n  if(!a||!s||!s.selfbad||FIXHID[a.id]){b.hidden=true;return}\r\n  const c=s.selfCounts||{};b.hidden=false;b.dataset.id=a.id;\r\n  $('fixtxt').innerHTML=`<b>${esc(a.p)}</b> a peut-être changé son interface : AI Hub ne retrouve plus ${c.comp===0?'la zone de saisie':'les messages'} (saisie ${c.comp??'?'}, vous ${c.user??'?'}, IA ${c.ai??'?'}).`}\r\n$('fixgo').onclick=()=>{const id=$('fixbn').dataset.id,a=find(id);if(!a)return;const s=stOf(id);s.selfbad=false;s.degraded=false;pushCfg();\r\n  const v=document.querySelector(`webview[data-id=\"${id}\"]`);try{if(v)v.reload()}catch{}\r\n  toast('Lecture relancée pour '+a.p+'. Si la bannière revient, ajoute un sélecteur de secours (Paramètres > Détections).');drawFix()};\r\n$('fixno').onclick=()=>{const id=$('fixbn').dataset.id;FIXHID[id]=true;drawFix()};\r\nsetInterval(()=>{if(document.hidden)return;try{drawFix()}catch{}},2000);\r\n\r\n// 4.12 (I1 + I2) : « Centre de contrôle » : cartes animées, couleurs uniquement issues des variables du thème (couleur d'accentuation de l'utilisateur comprise)\r\n(()=>{\r\n  const css=document.createElement('style');\r\n  css.textContent=`\r\n  .cc-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:14px;margin-top:14px}\r\n  .cc-card{background:var(--panel);border:1px solid var(--line);border-radius:var(--r3,14px);padding:16px 18px;box-shadow:var(--shadow);transition:transform .2s var(--ease),border-color .2s}\r\n  .cc-card:hover{transform:translateY(-2px);border-color:color-mix(in srgb,var(--acc) 45%,var(--line))}\r\n  .cc-fresh .cc-card{animation:ccin .4s var(--ease) backwards;animation-delay:calc(var(--i,0)*70ms)}\r\n  .cc-card h3{margin:0 0 4px;font-size:14.5px;font-weight:600}\r\n  .cc-card .sub{margin:0 0 12px;color:var(--dim);font-size:12.5px;line-height:1.5}\r\n  .cc-head{display:flex;align-items:baseline;gap:8px;margin-bottom:10px}\r\n  .cc-big{font-size:30px;font-weight:650;letter-spacing:-.02em;color:var(--acc);line-height:1}\r\n  .cc-big small{font-size:15px;font-weight:500;color:var(--dim)}\r\n  .cc-sub2{color:var(--dim);font-size:12.5px;flex:1}\r\n  .cc-bar{height:8px;border-radius:99px;background:var(--hover);overflow:hidden;margin-bottom:12px}\r\n  .cc-bar>i{display:block;height:100%;width:0;border-radius:99px;background:linear-gradient(90deg,var(--acc),color-mix(in srgb,var(--acc) 55%,var(--ok)));transition:width .7s var(--ease)}\r\n  .cc-list{max-height:260px;overflow:auto}\r\n  .cc-row{display:flex;align-items:center;gap:10px;padding:7px 0;border-top:1px solid var(--line)}\r\n  .cc-row:first-child{border-top:0}\r\n  .cc-nm{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:13px}\r\n  .cc-dot{width:9px;height:9px;border-radius:50%;background:var(--dim);flex:none}\r\n  .cc-dot.ok{background:var(--ok)}.cc-dot.warn{background:var(--warn)}.cc-dot.bad{background:var(--err)}\r\n  .cc-dot.live{animation:ccpulse 1.4s ease-in-out infinite}\r\n  .cc-pill{font-size:11.5px;padding:2px 9px;border-radius:99px;font-weight:550;--c:var(--dim);background:color-mix(in srgb,var(--c) 16%,transparent);color:var(--c);white-space:nowrap}\r\n  .cc-pill.ok{--c:var(--ok)}.cc-pill.warn{--c:var(--warn)}.cc-pill.bad{--c:var(--err)}\r\n  .cc-tip{color:var(--dim);font-size:12.5px;line-height:1.6;margin:0}\r\n  .cc-tip b{color:var(--txt);font-weight:550}\r\n  @keyframes ccin{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}\r\n  @keyframes ccpulse{0%,100%{box-shadow:0 0 0 0 color-mix(in srgb,currentColor 0%,transparent);opacity:1}50%{opacity:.45}}\r\n  @media (prefers-reduced-motion:reduce){.cc-fresh .cc-card,.cc-dot.live{animation:none}.cc-card,.cc-bar>i{transition:none}}`;\r\n  document.head.appendChild(css);\r\n  const CC={t:0,tk:null,lk:null,sig:''};\r\n  const bar=(d,n)=>`<div class=\"cc-bar\"><i data-w=\"${n?Math.round(d*100/n):0}%\"></i></div>`;\r\n  function fixOne(id){const a=find(id);if(!a)return;const s=stOf(id);s.selfbad=false;s.degraded=false;try{pushCfg()}catch{}\r\n    const v=document.querySelector(`webview[data-id=\"${id}\"]`);try{if(v)v.reload()}catch{}}\r\n  async function ccDraw(fresh){\r\n    const box=document.getElementById('cc-body');if(!box)return;\r\n    if(fresh){box.classList.add('cc-fresh');CC.sig='';CC.t=0;setTimeout(()=>box.classList.remove('cc-fresh'),1200)}\r\n    const rows=(typeof accs!=='undefined'?accs:[]).map(a=>{const s=stOf(a.id)||{};let k='ok',t='Prête',fix=false;\r\n      if(s.logged===false){k='bad';t='Déconnectée'}\r\n      else if(s.selfbad){k='bad';t='Lecture à réparer';fix=true}\r\n      else if(s.limited){k='warn';t='Limite atteinte'}\r\n      else if(s.degraded){k='warn';t='Lecture en repli';fix=true}\r\n      else if(s.gen){t='Répond…'}\r\n      return {a,k,t,fix,gen:!!s.gen}});\r\n    const p=(typeof P0==='function'&&typeof chatProj!=='undefined')?P0(chatProj):null,loc=p&&p.local&&p.local.path?p:null;\r\n    if(!loc){CC.tk=null;CC.lk=null}\r\n    else if(Date.now()-CC.t>6000){CC.t=Date.now();CC.tk=null;CC.lk=null;\r\n      try{const o=await api.localExec({root:loc.local.path,verb:'task',arg:'list -a',opts:{}}),m=/TÂCHES\\s+(\\d+)\\/(\\d+)/.exec((o&&o.out)||'');if(m)CC.tk={d:+m[1],n:+m[2]}}catch{}\r\n      try{const r=await api.localLocks({root:loc.local.path});CC.lk=Object.keys((r&&r.files)||{}).length}catch{}}\r\n    const nOk=rows.filter(r=>r.k==='ok').length,nFix=rows.filter(r=>r.fix).length;\r\n    const c1=`<div class=\"cc-card\" style=\"--i:0\"><h3>Clés et lecture des pages</h3><p class=\"sub\">${rows.length?'Une clé est « prête » quand elle est connectée, sans limite, et que sa page se lit correctement.':'Aucune clé pour l\\'instant : ajoute un compte IA dans la zone « Clés ».'}</p>\r\n      <div class=\"cc-head\"><span class=\"cc-big\">${nOk}<small>/${rows.length}</small></span><span class=\"cc-sub2\">prêtes</span>${nFix?`<button class=\"btn sm\" data-ccfix=\"*\">Tout réparer (${nFix})</button>`:''}</div>${bar(nOk,rows.length)}\r\n      <div class=\"cc-list\">${rows.map(r=>`<div class=\"cc-row\"><i class=\"cc-dot ${r.k}${r.gen?' live':''}\"></i><span class=\"cc-nm\">${esc(r.a.p+' · '+r.a.n)}</span><span class=\"cc-pill ${r.k}\">${r.t}</span>${r.fix?`<button class=\"btn sm ghost\" data-ccfix=\"${r.a.id}\">Réparer</button>`:''}</div>`).join('')}</div></div>`;\r\n    const c2=!loc?`<div class=\"cc-card\" style=\"--i:1\"><h3>Projet local</h3><p class=\"sub\">Ouvre un projet en mode « Local » (bouton à côté du trombone) pour voir ici l'avancement des tâches et les fichiers verrouillés.</p></div>`\r\n      :`<div class=\"cc-card\" style=\"--i:1\"><h3>${esc(loc.local.name||'Projet local')}</h3><p class=\"sub\">Avancement du plan de tâches de ce dossier.</p>${CC.tk&&CC.tk.n?`<div class=\"cc-head\"><span class=\"cc-big\">${CC.tk.d}<small>/${CC.tk.n}</small></span><span class=\"cc-sub2\">tâches faites</span></div>${bar(CC.tk.d,CC.tk.n)}`:'<p class=\"sub\">Aucune tâche en cours.</p>'}<div class=\"cc-row\"><i class=\"cc-dot ${CC.lk?'warn live':'ok'}\"></i><span class=\"cc-nm\">Fichiers verrouillés</span><span class=\"cc-pill ${CC.lk?'warn':'ok'}\">${CC.lk||0}</span></div></div>`;\r\n    const c3=`<div class=\"cc-card\" style=\"--i:2\"><h3>Relire les changements</h3><p class=\"cc-tip\">Sous chaque tour du chat en mode local, le bouton <b>Changements</b> liste les fichiers modifiés avec le diff en couleur. <b>Refuser</b> annule un seul fichier, sans toucher au reste du tour.</p></div>`;\r\n    const html=c1+c2+c3;if(html===CC.sig)return;CC.sig=html;box.innerHTML=html;\r\n    requestAnimationFrame(()=>requestAnimationFrame(()=>box.querySelectorAll('.cc-bar>i').forEach(i=>{i.style.width=i.dataset.w})))}\r\n  const body=document.getElementById('cc-body');\r\n  if(body)body.addEventListener('click',e=>{const b=e.target.closest('[data-ccfix]');if(!b)return;const id=b.dataset.ccfix;\r\n    if(id==='*')accs.filter(a=>{const s=stOf(a.id);return s.logged!==false&&(s.selfbad||s.degraded)}).forEach(a=>fixOne(a.id));else fixOne(id);\r\n    toast('Lecture relancée.');CC.sig='';ccDraw()});\r\n  const nav=document.querySelector('[data-t=\"cc\"]');if(nav)nav.addEventListener('click',()=>ccDraw(true));\r\n  setInterval(()=>{const pn=document.getElementById('p-cc');if(pn&&pn.classList.contains('on'))ccDraw().catch(()=>{})},2000);\r\n})();\r\n\r\n// 4.12 (G1) : carte « Mode API » (Paramètres > Centre de contrôle) : une clé API par compte Gemini / Claude / ChatGPT, bouton Tester\r\n(()=>{\r\n  const APXP={Claude:'claude-sonnet-5-5',ChatGPT:'gpt-5',Gemini:GEM},box=document.getElementById('cc-api');let sel=null,msg='';\r\n  const s2=document.createElement('style');s2.textContent=`\r\n  .cc-edit{margin-top:12px;padding-top:12px;border-top:1px solid var(--line);display:grid;gap:10px;animation:ccin .3s var(--ease)}\r\n  .cc-edit label{display:grid;gap:4px;font-size:12.5px;color:var(--dim)}\r\n  .cc-edit input:not([type=checkbox]){background:var(--bg);color:var(--txt);border:1px solid var(--line2);border-radius:var(--r2,10px);padding:8px 10px;font:inherit;transition:border-color .15s,box-shadow .15s}\r\n  .cc-edit input:not([type=checkbox]):focus{outline:none;border-color:var(--acc);box-shadow:0 0 0 3px var(--soft)}\r\n  .cc-chk{display:flex!important;align-items:center;gap:8px;color:var(--txt)!important}\r\n  .cc-btns{display:flex;gap:8px;flex-wrap:wrap}\r\n  .cc-msg{margin:0;font-size:12.5px;color:var(--dim);min-height:1.2em}\r\n  @media (prefers-reduced-motion:reduce){.cc-edit{animation:none}}`;document.head.appendChild(s2);\r\n  function apiDraw(){\r\n    if(!box)return;\r\n    const L=(typeof accs!=='undefined'?accs:[]).filter(x=>APXP[x.p]);\r\n    if(!L.length){box.innerHTML='<div class=\"cc-card\" style=\"--i:3\"><h3>Mode API (optionnel)</h3><p class=\"sub\">Ajoute un compte Claude, ChatGPT ou Gemini dans la zone « Clés » pour pouvoir lui associer une clé API.</p></div>';return}\r\n    const a=L.find(x=>x.id===sel)||null,ap=(a&&a.api)||{};\r\n    box.innerHTML=`<div class=\"cc-card\" style=\"--i:3\"><h3>Mode API (optionnel)</h3>\r\n      <p class=\"sub\">Avec une clé API, AI Hub appelle directement Gemini, Claude ou OpenAI : réponse en direct, sans passer par la page web, bien plus rapide. Sans clé, tout fonctionne comme avant. La clé reste sur ce PC (elle n'est chiffrée que dans l'export de comptes, si tu mets un mot de passe).</p>\r\n      <div class=\"cc-list\">${L.map(x=>{const on=!!(x.api&&x.api.k&&x.api.on!==false);return `<div class=\"cc-row\"><i class=\"cc-dot ${on?'ok':''}\"></i><span class=\"cc-nm\">${esc(x.p+' · '+x.n)}</span><span class=\"cc-pill ${on?'ok':''}\">${on?'API':'Pages'}</span><button class=\"btn sm ghost\" data-apx=\"${x.id}\">${x.id===sel?'Fermer':'Configurer'}</button></div>`}).join('')}</div>\r\n      ${a?`<div class=\"cc-edit\"><label>Clé API ${esc(a.p)}<input id=\"apx-k\" type=\"password\" autocomplete=\"off\" placeholder=\"${ap.k?'•••••• (déjà enregistrée)':'colle ta clé ici'}\"></label>\r\n        <label>Modèle<input id=\"apx-m\" placeholder=\"${esc(APXP[a.p])}\" value=\"${esc(ap.m||'')}\"></label>\r\n        <label class=\"cc-chk\"><input id=\"apx-on\" type=\"checkbox\" ${ap.k&&ap.on!==false?'checked':''}> Utiliser l'API pour ce compte</label>\r\n        <div class=\"cc-btns\"><button class=\"btn pri sm\" data-apxsave>Enregistrer</button><button class=\"btn sm\" data-apxtest>Tester</button>${ap.k?'<button class=\"btn sm ghost\" data-apxdel>Retirer la clé</button>':''}</div>\r\n        <p class=\"cc-msg\" id=\"apx-msg\">${esc(msg)}</p></div>`:''}</div>`}\r\n  if(box)box.addEventListener('click',async e=>{\r\n    const o=e.target.closest('[data-apx]');if(o){sel=sel===o.dataset.apx?null:o.dataset.apx;msg='';apiDraw();return}\r\n    const a=find(sel);if(!a)return;\r\n    if(e.target.closest('[data-apxdel]')){delete a.api;save();msg='Clé retirée : ce compte repasse par la page web.';apiDraw();return}\r\n    const kEl=document.getElementById('apx-k'),mEl=document.getElementById('apx-m'),onEl=document.getElementById('apx-on');\r\n    const k=(kEl&&kEl.value.trim())||(a.api&&a.api.k)||'',m=(mEl&&mEl.value.trim())||'';\r\n    if(e.target.closest('[data-apxsave]')){if(!k){msg='Colle une clé d\\'abord.';apiDraw();return}a.api={k,m,on:!onEl||onEl.checked};save();msg='✔ Enregistré.';apiDraw();toast('Mode API '+(a.api.on?'activé':'désactivé')+' pour '+a.n);return}\r\n    if(e.target.closest('[data-apxtest]')){if(!k){msg='Colle une clé d\\'abord.';apiDraw();return}\r\n      const t=document.getElementById('apx-msg');if(t)t.textContent='Test en cours…';\r\n      let r;try{r=await api.localApiAsk({id:'tst'+Date.now(),plat:a.p,key:k,model:m||APXP[a.p],prompt:'Réponds uniquement par le mot OK.',maxTokens:32})}catch(x){r={ok:false,error:String(x&&x.message||x)}}\r\n      msg=r.ok?'✔ '+a.p+' répond ('+(m||APXP[a.p])+').':'✘ '+String(r.error||'échec').slice(0,200)+(/404|not found|model/i.test(String(r.error))?' — essaie un autre nom de modèle.':'');\r\n      const t2=document.getElementById('apx-msg');if(t2)t2.textContent=msg}});\r\n  const nav2=document.querySelector('[data-t=\"cc\"]');if(nav2)nav2.addEventListener('click',()=>{msg='';apiDraw()});\r\n  apiDraw();\r\n})();\r\n\r\nasync function handoff(fromId,o={}){\r\n  const R=settings.relay,src=find(fromId||active),now=Date.now();\r\n  const fail=(msg,silent)=>{hlog('fail',src,msg);HAND.unshift({ts:now,from:src,ok:false,err:msg});\r\n    if(silent)ping('limit','Limite atteinte',src.p+' · '+src.n,src.id,{toast:true});else ping('handoff','Reprise impossible',msg,src&&src.id,{toast:true});return {ok:false,error:msg}};\r\n  if(!src)return {ok:false,error:'compte introuvable'};\r\n  // garde-fous contre les boucles et les doublons (limit-hit se redéclenche à chaque rechargement de page)\r\n  if(o.auto&&(now-(LASTH[src.id]||0)<300000||now-LASTANY<20000)){hlog('skip',src,'reprise récente : ignorée');return {ok:false,error:'reprise récente'}}\r\n  let dst=o.to?find(o.to):pickTarget(src);\r\n  if(!dst)return fail('aucun autre compte disponible'+(R.samePlatform?' sur '+src.p:''));\r\n  let conv;try{conv=await read(src)}catch(e){return fail('lecture impossible : '+e.message)}\r\n  const text0=conv.msgs[0]&&conv.msgs[0].t;\r\n  if(conv.mode==='raw'){\r\n    if(!text0||!isChatUrl(conv.url))return fail('aucune conversation à reprendre sur '+src.p+' · '+src.n,o.auto);\r\n    if(o.auto)return fail('conversation non reconnue sur '+src.n+' (sélecteurs à vérifier) : reprise annulée');\r\n    if(!confirm('Le format de la conversation n\\'est pas reconnu : AI Hub transmettrait le texte brut de la page (avec des éléments d\\'interface). Continuer ?'))return {ok:false,cancelled:true};\r\n  }\r\n  const built=await buildHandoff(src,conv,o),visited=[src.id];\r\n  for(let i=0;i<accs.length&&dst;i++){\r\n    toast('Reprise : '+src.n+' → '+dst.n+'…');\r\n    hub.switchTo(dst);await hub.newChat(dst);\r\n    const w=await waitComposer(dst,25000);\r\n    if(w===true)await sleep(1500);   // la limite peut s'afficher juste après le chargement\r\n    if(w!==true||stOf(dst.id).limited||stOf(dst.id).logged===false){\r\n      hlog('skip',dst,w==='login'||stOf(dst.id).logged===false?'déconnecté':w?'limite atteinte':'page non prête');\r\n      visited.push(dst.id);dst=o.strict?null:pickTarget(src,visited);continue}\r\n    let r=await hub.paste(built.text,{account:dst,send:false});\r\n    if(!r.len){await sleep(1200);r=await hub.paste(built.text,{account:dst,send:false})}\r\n    if(!r.len){await api.copy(built.text);return fail('collage impossible sur '+dst.n+' : le message est copié dans le presse-papiers (Ctrl+V)')}\r\n    const send=o.send??R.send;if(send){await sleep(500);await hub.send(dst.id)}\r\n    LASTH[src.id]=Date.now();LASTANY=Date.now();\r\n    HAND.unshift({ts:Date.now(),from:src,to:dst,how:built.how,chars:built.chars,sent:!!send,ok:true});if(HAND.length>20)HAND.pop();\r\n    hlog('ok',src,{to:dst.p+' · '+dst.n,mode:built.how,chars:built.chars,sent:!!send});\r\n    ping('handoff','Reprise sur '+dst.p+' · '+dst.n,send?'Message envoyé ('+built.how+').':'Message prêt dans la zone de saisie : relis-le et valide.',dst.id,{toast:true});\r\n    if(setOpen&&tab==='rel')drawRel();\r\n    return {ok:true,to:pub(dst),mode:built.how,chars:built.chars,n:conv.msgs.length};\r\n  }\r\n  return fail('aucun compte disponible : '+(accs.length>1?'tous sont limités, déconnectés ou non prêts':'ajoute un autre compte'));\r\n}\r\n// fenêtre « Reprendre ailleurs » (manuel)\r\n$('handoff').onclick=()=>{const a=find(active);if(!a)return toast('Sélectionne un compte d\\'abord');\r\n  const others=accs.filter(x=>x.id!==a.id);if(!others.length)return toast('Ajoute un autre compte pour reprendre la conversation.');\r\n  const sorted=[...others].sort((x,y)=>(x.p===a.p?0:1)-(y.p===a.p?0:1)||(stOf(x.id).limited?1:0)-(stOf(y.id).limited?1:0));\r\n  $('hsrc').textContent='Depuis '+a.p+' · '+a.n;\r\n  $('hto').innerHTML=sorted.map(x=>`<option value=\"${x.id}\">${esc(x.p)} · ${esc(x.n)}${stOf(x.id).limited?' (limite atteinte)':''}${stOf(x.id).logged===false?' (déconnecté)':''}</option>`).join('');\r\n  $('hmode').value=settings.relay.summary&&hub.aiEnabled?'sum':'full';$('hsend').checked=!!settings.relay.send;\r\n  $('dlgH').dataset.src=a.id;$('dlgH').showModal()};\r\n$('hcancel').onclick=()=>$('dlgH').close();\r\n$('hok').onclick=()=>{const d=$('dlgH');d.close();\r\n  enqueue(()=>handoff(d.dataset.src,{to:$('hto').value,strict:true,send:$('hsend').checked,summary:$('hmode').value==='sum'})).then(r=>{if(!r.ok&&!r.cancelled&&r.error&&!/^reprise récente/.test(r.error))toast('Reprise impossible : '+r.error)}).catch(x=>toast('Reprise impossible : '+(x&&x.message||x)))};\r\n\r\n// ---------- API pour ton code (mode développeur) ----------\r\nconst hub={\r\n  get accounts(){return accs.map(pub)},get active(){return pub(find(active))},\r\n  state:id=>st[(find(id||active)||{}).id],\r\n  switchTo(x){const a=find(x);if(!a)return null;active=a.id;setOpen=false;filesOpen=false;save();render();return pub(a)},\r\n  available(o={}){const f=find(o.from||active);return pub(accs.find(a=>a.id!==(f&&f.id)&&!stOf(a.id).limited&&(!o.samePlatform||a.p===(f&&f.p))))||null},\r\n  next(o={}){const n=accs.length,i=accs.findIndex(a=>a.id===active),d=o.dir||1,cur=find(active);\r\n    for(let k=1;k<=n;k++){const a=accs[(((i+k*d)%n)+n)%n];\r\n      if(a.id!==active&&(o.skipLimited===false||!stOf(a.id).limited)&&(!o.samePlatform||a.p===cur?.p))return hub.switchTo(a)}return null},\r\n  async getConversation(x){const a=find(x||active);const r=a&&await exportPack(a);return r&&r.txt},\r\n  async exportConversation(x){const t=await hub.getConversation(x);if(t){await api.copy(t);toast('Conversation copiée')}return t},\r\n  async newChat(x){const a=find(x||active),v=view(a);\r\n    if(!v._ready)await Promise.race([new Promise(r=>v.addEventListener('dom-ready',r,{once:true})),sleep(15000)]);\r\n    v.loadURL(P[a.p][0]);await new Promise(r=>{v.addEventListener('did-stop-loading',r,{once:true});setTimeout(r,15000)})},\r\n  async paste(text,o={}){const a=find(o.account||active),v=view(a),C=JSON.stringify(okSel(a,'comp'));\r\n    if(!v._ready)await Promise.race([new Promise(r=>v.addEventListener('dom-ready',r,{once:true})),sleep(15000)]);\r\n    const pick=`(()=>{const l=[...document.querySelectorAll(${C})];return l.find(e=>e.getClientRects().length>0)||l[0]||document.querySelector(${JSON.stringify(COMPOSER)})})()`;\r\n    {const ds=await v.executeJavaScript(`(()=>{if(location.hostname.indexOf('deepseek')<0)return false;const c=document.querySelector('textarea[placeholder=\"Message à DeepSeek\"],textarea[name=\"search\"]');if(!c)return false;c.focus();const st=Object.getOwnPropertyDescriptor(HTMLTextAreaElement.prototype,'value').set;st.call(c,${JSON.stringify(text)});c.dispatchEvent(new Event('input',{bubbles:true}));c.dispatchEvent(new Event('change',{bubbles:true}));return true})()`);\r\n      if(ds){await sleep(300);const len0=await v.executeJavaScript(`(()=>{const c=document.querySelector('textarea[placeholder=\"Message à DeepSeek\"],textarea[name=\"search\"]');return c?c.value.trim().length:0})()`);if(o.send){await sleep(600);await hub.send(a.id)}return {len:len0}}}\r\n    await v.executeJavaScript(`(()=>{const c=${pick};if(c)c.focus()})()`);\r\n    await sleep(80);await v.executeJavaScript(`(()=>{const c=${pick};if(!c)return;if(c.matches('.ProseMirror')||c.closest('form[data-chatgpt-composer]')){c.focus();const s=getSelection(),r=document.createRange();r.selectNodeContents(c);s.removeAllRanges();s.addRange(r);document.execCommand('delete',false)}})()`);\r\n    v.insertText(text);await sleep(120);\r\n    await v.executeJavaScript(`(()=>{const c=${pick};if(!c||!(c.matches('.ProseMirror')||c.closest('form[data-chatgpt-composer]')))return;if((c.innerText||'').trim().length)return;c.focus();const s=getSelection(),r=document.createRange();r.selectNodeContents(c);s.removeAllRanges();s.addRange(r);document.execCommand('insertText',false,${JSON.stringify(text)});c.dispatchEvent(new InputEvent('input',{bubbles:true,inputType:'insertText',data:${JSON.stringify(text)}}))})()`);await sleep(200);\r\n    const len=await v.executeJavaScript(`(()=>{const c=${pick};return c?(c.value||c.innerText||'').trim().length:0})()`);\r\n    if(o.send){await sleep(600);await hub.send(a.id)}\r\n    return {len}},\r\n  async send(x){const v=view(find(x||active));await sleep(100);\r\n    v.sendInputEvent({type:'keyDown',keyCode:'Enter'});v.sendInputEvent({type:'char',keyCode:'\\r'});v.sendInputEvent({type:'keyUp',keyCode:'Enter'})},\r\n  async getMessages(x){const a=find(x||active);if(!a)return null;const r=await read(a);\r\n    return r.msgs[0]&&r.msgs[0].t?{mode:r.mode,msgs:r.msgs.map(m=>({r:m.r,t:m.t}))}:null},\r\n  async health(x){const a=find(x||active);if(!a)return null;const v=view(a);\r\n    const r=await v.executeJavaScript(`(()=>{const q=s=>{try{return document.querySelectorAll(s).length}catch{return -1}};\r\n      let c;try{c=document.querySelector(${JSON.stringify(selOf(a.p,'comp'))})}catch{}\r\n      return {url:location.href,composer:q(${JSON.stringify(selOf(a.p,'comp'))}),user:q(${JSON.stringify(selOf(a.p,'user'))}),ai:q(${JSON.stringify(selOf(a.p,'ai'))}),stop:q(${JSON.stringify(selOf(a.p,'stop'))}),send:q(${JSON.stringify(selOf(a.p,'send'))}),composerLen:c?(c.value||c.innerText||'').trim().length:0}})()`);\r\n    return {...r,account:pub(a),mode:r.user>0&&r.ai>0?'structured':r.user+r.ai>0?'partial':'none'}},\r\n  get aiEnabled(){return !!(settings.gemini&&settings.gemini.key)},\r\n  // Résumé par Gemini ; renvoie null (jamais d'exception) si pas de clé ou en cas d'échec\r\n  async summarize(text,o={}){\r\n    const g=settings.gemini||{};if(!g.key)return null;\r\n    const body=String(text).slice(-(o.max||350000));\r\n    const sys='Tu prépares le transfert d\\'une conversation vers un autre compte de la même IA. Tu produis un résumé fidèle, dense et directement exploitable. Tu n\\'inventes rien : si une information est absente, tu écris « aucun ».';\r\n    const prompt=`Voici une conversation entre un utilisateur et une IA (${o.platform||'IA'}). Écris le résumé dans la langue de la conversation, en Markdown, 700 mots maximum, avec exactement ces sections :\r\n## Objectif et contexte\r\n## Où on en est (fait / en cours)\r\n## Décisions, contraintes et préférences de l'utilisateur (formats, style, ce qui a été refusé)\r\n## Éléments techniques précis (noms de fichiers, fonctions, valeurs, versions : garde les identifiants exacts ; ne recopie pas de longs blocs de code, décris leur rôle)\r\n## Problèmes ouverts et erreurs\r\n## Prochaine étape (la dernière demande de l'utilisateur, et si la dernière réponse de l'IA est terminée ou semble coupée)\r\n${o.extra?o.extra+'\\n':''}\r\n=== CONVERSATION ===\r\n${body}\r\n=== FIN ===`;\r\n    try{const r=await api.gemini({key:g.key,model:g.model||GEM,system:sys,prompt});\r\n      if(!r.ok){LOG.unshift({ts:Date.now(),acc:'code',type:'summary-error',detail:r.error});return null}\r\n      return r.text}\r\n    catch(e){LOG.unshift({ts:Date.now(),acc:'code',type:'summary-error',detail:String(e&&e.message||e)});return null}},\r\n  handoff:(from,o)=>enqueue(()=>handoff(from,{...o,auto:false})),\r\n  async continueOn(t,o={}){const r=await hub.handoff(o.from||active,{to:t,send:o.send});if(!r.ok)throw new Error(r.error);return r.n},   // ancien nom, conservé\r\n  runInPage:(js,x)=>view(find(x||active)).executeJavaScript(js),\r\n  reload(x){const a=find(x||active);if(a){const s=stOf(a.id);s.limited=false;s.until=0;s.limAt=0;persistLim(a);renderList();view(a).reload()}},\r\n  notify(m,o={}){toast(m);if(settings.notif.enabled===true&&!document.hasFocus())api.notify(o.title||'AI Hub',String(m),null).catch(()=>{})},\r\n  copy:t=>api.copy(t),\r\n  log(...a){LOG.unshift({ts:Date.now(),acc:'code',type:'log',detail:a.join(' ')})},\r\n  setLimited(x,v=true){const a=find(x);if(a){const s=stOf(a.id);s.limited=!!v;s.limAt=v?Date.now():0;if(!v)s.until=0;persistLim(a);renderList()}},\r\n  rename(x,n){const a=find(x);if(a){a.n=String(n);save();renderList()}},\r\n  store:{get:k=>store[k]??null,set:(k,v)=>{store[k]=v;save()}}\r\n};\r\nfunction loadCode(){\r\n  for(const k in H)delete H[k];\r\n  if(!settings.devMode)return 'désactivé';\r\n  const on=(t,fn)=>{(H[t]??=[]).push(fn);return()=>{H[t]=H[t].filter(f=>f!==fn)}};\r\n  const once=(t,fn)=>{const off=on(t,e=>{off();return fn(e)});return off};\r\n  try{new Function('hub','on','once','sleep',`return (async()=>{${userCode}\\n})()`)(hub,on,once,sleep).catch(codeErr);return'ok'}\r\n  catch(x){codeErr(x);return'Erreur : '+x.message}\r\n}\r\n\r\n// ---------- paramètres ----------\r\nfunction selectTab(t){tab=t;\r\n  document.querySelectorAll('.snav button').forEach(x=>x.classList.toggle('on',x.dataset.t===t));\r\n  document.querySelectorAll('.pane').forEach(p=>p.classList.toggle('on',p.id==='p-'+t));\r\n  if(t==='log')drawLog();if(t==='upd')drawUpd();if(t==='rel')drawRel();if(t==='gen')drawNotif()}\r\ndocument.querySelectorAll('.snav button').forEach(b=>b.onclick=()=>selectTab(b.dataset.t));\r\n$('gear').onclick=()=>{setOpen=!setOpen;filesOpen=false;render();if(setOpen)selectTab(tab)};\r\n$('preall').onchange=e=>{settings.preloadAll=e.target.checked;save();render()};\r\n{const cm=$('cleanmode');if(cm)cm.onchange=e=>{settings.clean=e.target.checked;save();document.querySelectorAll('webview').forEach(v=>{const a=find(v.dataset.id);if(a)try{v.send('hub:config',cfg(a.p))}catch{}})}}\r\n\r\n// mode développeur : sans lui, aucun script perso ni détection perso n'est exécuté\r\nfunction applyDev(){\r\n  document.body.classList.toggle('dev',!!settings.devMode);$('dev').checked=!!settings.devMode;\r\n  const r=loadCode();$('cst').textContent=settings.devMode?(r==='ok'?'Code activé ✔':r):'';\r\n  if(!settings.devMode&&['code','det','log'].includes(tab)&&setOpen)selectTab('gen');pushCfg()}\r\n$('dev').onchange=e=>{\r\n  if(e.target.checked&&!confirm('Le mode développeur exécute du code JavaScript avec un accès complet à tes comptes (conversations, sessions). N\\'active jamais un script dont tu ne comprends pas le contenu, surtout s\\'il vient d\\'un fichier importé.\\n\\nActiver le mode développeur ?')){e.target.checked=false;return}\r\n  settings.devMode=e.target.checked;save();applyDev();toast(settings.devMode?'Mode développeur activé':'Mode développeur désactivé : les scripts ne s\\'exécutent plus')};\r\n$('savecode').onclick=()=>{userCode=$('code').value;save();const r=loadCode();$('cst').textContent=r==='ok'?'Code activé ✔':r};\r\n$('resetcode').onclick=()=>{$('code').value=EXAMPLE};\r\n$('evlist').innerHTML=EVENTS.map(([n,d])=>`<code>${n}</code><span>${d}</span>`).join('');\r\n\r\n// réglages de la reprise\r\ndocument.querySelectorAll('[data-r]').forEach(el=>el.onchange=()=>{const k=el.dataset.r;\r\n  settings.relay[k]=el.type==='checkbox'?el.checked:el.type==='number'?Math.min(300000,Math.max(5000,+el.value||60000)):el.value;\r\n  if(el.type==='number')el.value=settings.relay[k];save()});\r\nconst tm=t=>new Date(t).toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'});\r\nfunction drawRel(){\r\n  document.querySelectorAll('[data-r]').forEach(el=>{const v=settings.relay[el.dataset.r];if(el.type==='checkbox')el.checked=!!v;else el.value=v??''});\r\n  $('sumnote').textContent=hub.aiEnabled?'Au-delà de 15 000 caractères : résumé + derniers échanges au texte exact.':'Pas de clé Gemini : la conversation est transmise en entier (tronquée si trop longue). Ajoute une clé ci-dessous.';\r\n  $('hlist').textContent=HAND.length?HAND.slice(0,8).map(h=>h.ok?`${tm(h.ts)}  ${h.from.p} · ${h.from.n} → ${h.to.p} · ${h.to.n}  (${h.how}, ${h.chars} car.${h.sent?', envoyé':''})`:`${tm(h.ts)}  ${h.from?h.from.n:'?'}  ✘ ${h.err}`).join('\\n'):'Aucune reprise pour l\\'instant.'}\r\n\r\n// ---------- export / import de comptes ----------\r\n$('exp').onclick=async()=>{\r\n  const r=await api.exportAll({state:{accs,active,detectors,settings,code:userCode,store},partitions:accs.map(a=>'persist:'+a.id),pass:$('pass').value});\r\n  $('msg').textContent=r.ok?`Exporté ${r.encrypted?'(chiffré)':'(NON chiffré, mets un mot de passe)'} : ${r.path}`:'Annulé'};\r\n$('imp').onclick=async()=>{\r\n  let r;try{r=await api.importAll($('pass').value)}catch(e){return $('msg').textContent='Fichier illisible : '+e.message}\r\n  if(!r.ok)return $('msg').textContent=r.error||'Annulé';\r\n  const s=r.state||{};(s.accs||[]).forEach(x=>{if(!accs.some(a=>a.id===x.id))accs.push(x)});\r\n  if(!active)active=s.active||null;\r\n  if(s.detectors&&s.detectors.length&&!detectors.length)detectors=s.detectors;\r\n  // le code importé est gardé mais ne s'exécute que si TU actives le mode développeur ; on ne remplace pas ton code sans demander\r\n  if(s.code&&s.code!==userCode&&!isOldExample(s.code)&&confirm('Le fichier contient du code personnalisé. Le remplacer par le tien ? (Il ne s\\'exécutera que si le mode développeur est activé.)'))userCode=s.code;\r\n  if(s.settings){const m=mergeSettings(s.settings);\r\n    settings.selectors={...m.selectors,...settings.selectors};\r\n    if(!settings.gemini.key&&m.gemini.key)settings.gemini=m.gemini;\r\n    settings.relay={...m.relay,...settings.relay};}                   // devMode et notifications ne sont jamais importés\r\n  store={...(s.store||{}),...store};\r\n  save();$('msg').textContent=`Importé : ${(s.accs||[]).length} comptes, ${r.cookies} cookies`+(r.version&&r.version!==r.current?` (fichier créé avec la version ${r.version}, la tienne est ${r.current} : vérifie que tout est là)`:'')+'. Redémarrage…';setTimeout(()=>location.reload(),r.version&&r.version!==r.current?4000:900)};\r\n\r\n// ---------- détections personnalisées + journal ----------\r\nfunction drawDet(){\r\n  $('dets').innerHTML=detectors.map((d,i)=>`<div class=\"row2\"><input data-i=\"${i}\" data-k=\"name\" value=\"${esc(d.name)}\" placeholder=\"nom de l'événement\"><select data-i=\"${i}\" data-k=\"kind\"><option value=\"selector\"${d.kind==='selector'?' selected':''}>Sélecteur CSS</option><option value=\"text\"${d.kind==='text'?' selected':''}>Texte (regex)</option></select><input data-i=\"${i}\" data-k=\"value\" value=\"${esc(d.value)}\" placeholder=\"ex. .banner-limit  ou  quota épuisé\"><select data-i=\"${i}\" data-k=\"site\"><option value=\"*\">Tous les sites</option>${Object.keys(P).map(k=>`<option${d.site===k?' selected':''}>${k}</option>`).join('')}</select><button class=\"btn\" data-rm=\"${i}\">${IC('x')}</button></div>`).join('')}\r\n$('dets').oninput=e=>{const{i,k}=e.target.dataset;if(k)detectors[i][k]=e.target.value};\r\n$('dets').onclick=e=>{const b=e.target.closest('[data-rm]');if(b){detectors.splice(+b.dataset.rm,1);drawDet()}};\r\n$('adddet').onclick=()=>{detectors.push({name:'mon-evenement',kind:'text',value:'',site:'*'});drawDet()};\r\n$('savedet').onclick=()=>{save();pushCfg();toast('Détections enregistrées')};\r\nfunction drawLog(){\r\n  const f=$('lf').value.toLowerCase();\r\n  $('logst').innerHTML=accs.map(a=>{const s=stOf(a.id);return `<div>${esc(a.p)} · ${esc(a.n)} : ${s.gen?'répond':'au repos'}${s.limited?' · limite':''}${s.logged===false?' · déconnecté':''} · dernier événement : ${esc(s.last||'aucun')}</div>`}).join('')||'Aucun compte.';\r\n  $('logl').textContent=LOG.filter(l=>!f||(l.type+l.acc+JSON.stringify(l.detail||'')).toLowerCase().includes(f)).slice(0,200)\r\n    .map(l=>`${new Date(l.ts).toLocaleTimeString()}  ${l.acc}  ${l.type}  ${l.detail?JSON.stringify(l.detail).slice(0,150):''}`).join('\\n')||'Aucun événement pour l\\'instant.'}\r\n$('lf').oninput=drawLog;$('logclr').onclick=()=>{LOG.length=0;drawLog()};\r\n$('logcp').onclick=()=>{api.copy(JSON.stringify(LOG,null,1));toast('Journal copié')};\r\n\r\n// ---------- récupération + renommage ----------\r\nlet renId=null;\r\n$('rcancel').onclick=()=>$('dlg2').close();\r\n$('rok').onclick=()=>{const n=$('rname').value.trim();if(n&&renId){find(renId).n=n;save();renderList();if(!setOpen)render()}$('dlg2').close()};\r\n$('rname').onkeydown=e=>{if(e.key==='Enter')$('rok').click()};\r\nconst guess=ds=>{for(const k of Object.keys(P)){if(k==='Gemini')continue;const h=new URL(P[k][0]).hostname;if(ds.some(d=>d.includes('.')&&h.endsWith(d)&&!/google\\.com$/.test(d)))return k}\r\n  return ds.some(d=>/google\\.com$/.test(d))?'Gemini':null};\r\nasync function recover(auto){\r\n  let n=0;\r\n  for(const o of await api.orphans(accs.map(a=>a.id))){const p=guess(o.domains);if(!p)continue;\r\n    accs.push({id:o.id,p,n:`${p} récupéré ${accs.filter(a=>a.p===p).length+1}`});n++}\r\n  if(n){save();toast(`${n} compte(s) retrouvé(s) : renomme-les avec le crayon`)}else if(!auto)toast('Aucun compte perdu à retrouver');\r\n  return n}\r\n$('recover').onclick=async()=>{await recover(false);render()};\r\n$('opendata').onclick=()=>api.openData();\r\n\r\n// ---------- Gemini ----------\r\n$('gkey').onchange=()=>{settings.gemini.key=$('gkey').value.trim();save();drawRel();$('gmsg').textContent=settings.gemini.key?'Clé enregistrée.':'Clé supprimée : la conversation sera transmise en entier.'};\r\n$('gmodel').onchange=()=>{settings.gemini.model=$('gmodel').value.trim()||GEM;$('gmodel').value=settings.gemini.model;save()};\r\n$('gtest').onclick=async()=>{\r\n  settings.gemini.key=$('gkey').value.trim();settings.gemini.model=$('gmodel').value.trim()||GEM;save();drawRel();\r\n  if(!settings.gemini.key)return $('gmsg').textContent='Entre une clé d\\'abord.';\r\n  $('gmsg').textContent='Test en cours…';\r\n  const r=await api.gemini({key:settings.gemini.key,model:settings.gemini.model,prompt:'Réponds uniquement par le mot OK.'});\r\n  $('gmsg').textContent=r.ok?'✔ Gemini répond ('+settings.gemini.model+').':'✘ '+r.error+(r.status===404?' — essaie un autre nom de modèle (ex. gemini-3.5-flash).':'')};\r\n\r\n// ---------- sélecteurs de secours + diagnostic ----------\r\nconst SELK=['user','ai','comp','stop','send'];\r\n$('selplat').innerHTML=Object.keys(P).map(k=>`<option>${k}</option>`).join('');\r\nfunction fillSel(){const c=(settings.selectors||{})[$('selplat').value]||{};SELK.forEach(k=>$('sel-'+k).value=c[k]||'')}\r\n$('selplat').onchange=fillSel;\r\n$('selsave').onclick=()=>{const c={};SELK.forEach(k=>{const v=$('sel-'+k).value.trim();if(v)c[k]=v});\r\n  settings.selectors[$('selplat').value]=c;save();pushCfg();Object.values(st).forEach(x=>x.degraded=false);toast('Sélecteurs enregistrés pour '+$('selplat').value)};\r\n$('diag').onclick=async()=>{\r\n  const o=$('diagout');o.style.display='block';o.textContent='Analyse…';const lines=[];\r\n  for(const a of accs){\r\n    if(!document.querySelector(`webview[data-id=\"${a.id}\"]`)){lines.push(`${a.p} · ${a.n} : non chargé (clique dessus ou active « Garder tous les comptes chargés »)`);continue}\r\n    try{const h=await hub.health(a.id);\r\n      lines.push(`${h.composer>0?'✔':'✘'} ${a.p} · ${a.n} : saisie ${h.composer}, tes messages ${h.user}, réponses IA ${h.ai}, stop ${h.stop}, envoyer ${h.send} → ${h.mode==='structured'?'conversation lue':h.mode==='partial'?'lecture partielle ⚠':h.user+h.ai===0?'aucun message à lire (normal sur un nouveau chat)':'à vérifier ⚠'}`)}\r\n    catch(e){lines.push(`✘ ${a.p} · ${a.n} : ${e.message}`)}}\r\n  o.textContent=lines.join('\\n')||'Aucun compte.'};\r\n\r\n// ---------- mises à jour ----------\r\nconst dt=t=>t?new Date(t).toLocaleString():'';\r\nasync function drawUpd(){\r\n  const i=await api.updInfo(),cur=i.active&&i.active!=='bundled'?i.active:null,inst=(i.versions||[]).find(v=>v.version===i.current);\r\n  $('upver').textContent=cur||i.launcherVersion;\r\n  const bd=$('upbadge');bd.className='upbadge'+(i.pending?' warn':'');bd.textContent=i.pending?'En essai':'Active';\r\n  $('upsub').textContent=i.pending?'Cette version est en essai : elle sera confirmée dès que l\\'app a démarré correctement.'\r\n    :cur?(inst&&inst.installedAt?'Mise à jour installée le '+new Date(inst.installedAt).toLocaleDateString('fr-FR',{day:'numeric',month:'long',year:'numeric'}):'Mise à jour installée.'):'Version fournie avec l\\'application.';\r\n  const back=i.current!=='bundled';\r\n  $('uprev').disabled=!back;$('uprev').textContent=i.previous&&i.previous!=='bundled'?'Revenir à la '+i.previous:'Revenir à la version d\\'origine';\r\n  $('uporig').style.display=back&&i.previous&&i.previous!=='bundled'?'':'none';\r\n  if(i.rolledBack)$('upmsg').innerHTML='<span class=\"warn\">Une mise à jour a été annulée automatiquement : '+esc(i.rolledBack)+'</span>';\r\n  $('upinfo').innerHTML=`Lanceur : <b>${esc(i.launcherVersion)}</b> · dossier de données : <b>${esc(i.dataDir||'')}</b>`;\r\n  $('upvers').textContent=(i.versions||[]).length?i.versions.map(v=>`${v.version}${v.version===i.current?'  (active)':v.version===i.previous?'  (précédente)':''}${v.ok?'':'  ⚠ fichiers invalides'}${(i.bad||[]).includes(v.version)?'  ✘ annulée':''}  ${v.notes?'— '+v.notes:''}`).join('\\n'):'Aucune mise à jour installée : version d\\'origine.';\r\n  $('uphist').textContent=(i.history||[]).map(h=>`${dt(h.ts)}  ${h.action}  ${h.version}  ${h.detail||''}`).join('\\n')||'—'}\r\n$('upapply').onclick=async()=>{\r\n  const r=await api.updApply();if(r.cancelled)return;\r\n  if(!r.ok){$('upmsg').textContent='✘ '+r.error;return}\r\n  drawUpd().then(()=>{$('upmsg').textContent=`✔ Version ${r.version} installée.`});\r\n  if(confirm(`Version ${r.version} installée. Redémarrer maintenant pour l'essayer ?\\n(Si elle ne démarre pas correctement, l'app revient toute seule à la version précédente.)`))api.relaunch()};\r\nconst revert=async to=>{const r=await api.updRevert(to);if(!r.ok){$('upmsg').textContent='✘ '+r.error;return}\r\n  $('upmsg').textContent='Retour à '+(r.version==='bundled'?'la version d\\'origine':r.version)+'. Redémarrage…';setTimeout(()=>api.relaunch(),600)};\r\n$('packzip').onclick=async()=>{const b=$('packzip');b.disabled=true;$('packmsg').textContent='Création du ZIP…';\r\n  try{const r=await api.packZip();$('packmsg').textContent=r.cancelled?'':r.ok?`✔ ZIP créé : ${r.files} fichiers, ${(r.size/1048576).toFixed(1)} Mo (version ${r.version}). ${r.path}`:'✘ '+r.error}\r\n  catch(e){$('packmsg').textContent='✘ '+e.message}finally{b.disabled=false}};\r\n$('uprev').onclick=()=>revert('previous');\r\n$('uporig').onclick=()=>{if(confirm('Revenir à la version d\\'origine fournie avec l\\'exe ? (tes comptes et ton code sont conservés)'))revert('bundled')};\r\n\r\n// ---- 2.5.4 : les limites atteintes sont enregistrées (elles survivent à la fermeture de l'app) ----\r\nconst LIM_H={Claude:5,ChatGPT:5,Gemini:24};   // sans heure de fin connue : on garde la limite pendant la fenêtre habituelle du site\r\nfunction limAlive(a,s){const n=Date.now();if(s.until)return s.until>n;return n-(s.limAt||n)<(LIM_H[a.p]||5)*36e5}\r\nfunction persistLim(a){try{const m=store.__limits=store.__limits||{},s=stOf(a.id);\r\n  if(s.limited&&limAlive(a,s))m[a.id]={until:s.until||0,at:s.limAt||Date.now()};else delete m[a.id];save()}catch{}}\r\nfunction restoreLimits(){try{const m=store.__limits||{};let ch=false;\r\n  for(const id of Object.keys(m)){const a=find(id);if(!a){delete m[id];ch=true;continue}\r\n    const s=stOf(id);s.limited=true;s.until=+m[id].until||0;s.limAt=+m[id].at||Date.now();\r\n    if(!limAlive(a,s)){s.limited=false;s.until=0;s.limAt=0;delete m[id];ch=true}}\r\n  if(ch)save()}catch{}}\r\n\r\n// ---------- démarrage ----------\r\n// Santé : l'app confirme qu'elle fonctionne ; sinon, retour arrière automatique (si une mise à jour est en essai)\r\nasync function init(){\r\n  let s=await api.stateLoad();\r\n  try{if(s&&typeof s==='object'){EXTRA_STATE=Object.fromEntries(Object.entries(s).filter(([k])=>!['v','accs','active','detectors','settings','code','store'].includes(k)));STATE_V=+s.v||3}}catch{}\r\n  if(!s)s={accs:LS('accs',[]),active:localStorage.act||null,detectors:LS('det',[]),settings:LS('set',{}),code:localStorage.code||EXAMPLE,store:{}};\r\n  const upgraded=!s.v||s.v<3;\r\n  accs=s.accs||[];active=s.active||null;detectors=s.detectors||[];settings=mergeSettings(s.settings);\r\n  userCode=s.code||EXAMPLE;store=s.store||{};restoreLimits();\r\n  let migrated=false;\r\n  if(isOldExample(userCode))userCode=EXAMPLE;                                     // ancien exemple non modifié : remplacé\r\n  else if(upgraded&&userCode.trim()&&userCode!==EXAMPLE&&!settings.devMode)migrated=true; // ton code est conservé, mais désactivé tant que le mode développeur est coupé\r\n  $('preall').checked=!!settings.preloadAll;{const cm=$('cleanmode');if(cm)cm.checked=settings.clean!==false}$('code').value=userCode;$('gkey').value=settings.gemini.key;$('gmodel').value=settings.gemini.model;\r\n  fillSel();drawDet();applyTheme();drawNotif();drawRel();loadFiles();\r\n  PRE=await api.wvpreload();ready=true;setTimeout(()=>{[...accs].sort((x,y)=>(y.id===active)-(x.id===active)).forEach((a,i)=>setTimeout(()=>{try{view(a)}catch{}},i*400))},500);\r\n  await recover(true);\r\n  if(!find(active))active=accs[0]?.id||null;\r\n  save();render();applyDev();\r\n  api.updInfo().then(i=>{if(i.rolledBack){toast('Mise à jour annulée automatiquement : '+i.rolledBack);LOG.unshift({ts:Date.now(),acc:'app',type:'update-rollback',detail:i.rolledBack})}}).catch(()=>{});\r\n  setTimeout(()=>{window.__healthy=true;api.updHealthy()},3000);\r\n  if(migrated)setTimeout(()=>toast('Tes scripts sont conservés dans Paramètres > Général > Mode développeur (désactivé). La reprise sur un autre compte est maintenant intégrée.'),2400);\r\n  setTimeout(()=>{if(settings.notif.enabled===null&&!$('dlgH').open&&!$('dlg').open)$('dlgN').showModal()},3200);   // demande d'autorisation des notifications\r\n}\r\n\r\n// ---------- 2.3.0 : page Fichiers réorganisée + envoi de plusieurs fichiers ----------\r\nconst DAY=864e5,TTL=30*DAY,FKINDS={image:'Images',pdf:'PDF',doc:'Documents',sheet:'Tableurs',code:'Code',zip:'Archives',txt:'Texte'};\r\nlet ftype='',lastSel=null,VIS=[],lastT=false,shiftNext=false,PVID=null,PVURL=null;\r\nconst byId=id=>FILES.find(x=>x.id===id)||TRASH.find(x=>x.id===id);\r\nconst isProjId=id=>PJ().some(p=>p.id===id);\r\nconst fview=()=>settings.fview==='list'?'list':'grid';\r\nconst viewList=id=>id==='trash'?TRASH:id==='fav'?FILES.filter(f=>f.fav):id==='recent'?FILES.filter(f=>Date.now()-f.added<7*DAY):id==='none'?FILES.filter(f=>!projOf(f)):id==='sent'?FILES.filter(f=>f.dir==='sent'):id==='recv'?FILES.filter(f=>f.dir==='recv'):id==='all'?FILES:FILES.filter(f=>f.proj===id);\r\nconst matchQ=(f,q)=>!q||q.split(/\\s+/).filter(Boolean).every(t=>t[0]==='#'?(f.tags||[]).some(x=>x.includes(t.slice(1))):t.startsWith('type:')?(kindOf(f)===t.slice(5)||extOf(f.name).toLowerCase()===t.slice(5)):(f.name.toLowerCase().includes(t)||(f.tags||[]).some(x=>x.includes(t))));\r\nconst dlAnchor=f=>{const a=document.createElement('a');a.href=URL.createObjectURL(f.blob);a.download=f.name;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),5000)};\r\nconst dlFile=f=>{if(!f)return;\r\n  if(window.api&&typeof api.saveFile==='function'){b64Of(f.blob).then(b=>api.saveFile(f.name,b)).then(r=>{if(!r||!r.ok)throw new Error(r&&r.err||'échec');toast('Enregistré dans Téléchargements : '+r.name);try{dispatchEvent(new CustomEvent('hub-saved',{detail:{id:f.id,path:r.path}}))}catch{}}).catch(()=>dlAnchor(f));return}\r\n  dlAnchor(f)};\r\nconst b64Of=blob=>new Promise((ok,ko)=>{const r=new FileReader();r.onload=()=>ok(String(r.result).split(',')[1]||'');r.onerror=ko;r.readAsDataURL(blob)});\r\nconst cleanTag=v=>v.replace(/^#/,'').toLowerCase().slice(0,24);\r\nfunction extraChips(){return `<span class=\"chipw\"><button class=\"chip ${fproj==='fav'?'on':''}\" data-pf=\"fav\">★ Favoris<i>${FILES.filter(f=>f.fav).length}</i></button></span><span class=\"chipw\"><button class=\"chip ${fproj==='recent'?'on':''}\" data-pf=\"recent\">Récents<i>${viewList('recent').length}</i></button></span>`}\r\nfunction trashChip(){return `<button class=\"chip ${fproj==='trash'?'on':''}\" data-pf=\"trash\">${IC('trash')}Corbeille<i>${TRASH.length}</i></button>`}\r\n$('fprojs').insertAdjacentHTML('afterend','<div id=\"ftools\"></div>');\r\ndocument.body.insertAdjacentHTML('beforeend','<div id=\"fprev\" hidden><div class=\"pvbox\"><div class=\"pvhead\"><b id=\"pvname\"></b><span class=\"sp\"></span><button class=\"btn ghost sm\" id=\"pvdl\">Enregistrer</button><button class=\"btn ghost sm\" id=\"pvx\">Fermer</button></div><div id=\"pvbody\"></div></div></div>');\r\nasync function loadFiles(anim=true){let all=[];try{all=await FDB.all()||[]}catch{}\r\n  const old=all.filter(f=>f.del&&Date.now()-f.del>TTL);\r\n  for(const f of old){try{if(String(f.id).startsWith('scan-'))(settings.scanSkip??=[]).push(f.id);await FDB.del(f.id)}catch{}}\r\n  if(old.length)save();\r\n  all=all.filter(f=>!old.includes(f));FILES=all.filter(f=>!f.del).sort((a,b)=>b.added-a.added);TRASH=all.filter(f=>f.del).sort((a,b)=>b.del-a.del);drawFiles(anim)}\r\nfunction drawTools(){const el=$('ftools');if(!el)return;const kc={};FILES.forEach(f=>{const k=kindOf(f);kc[k]=(kc[k]||0)+1});if(ftype&&!kc[ftype])ftype='';\r\n  el.innerHTML=`<select id=\"fsort\" title=\"Trier\"><option value=\"new\">Plus récents</option><option value=\"old\">Plus anciens</option><option value=\"az\">Nom A → Z</option><option value=\"za\">Nom Z → A</option><option value=\"big\">Plus gros</option><option value=\"small\">Plus petits</option><option value=\"type\">Par type</option></select><select id=\"ftype\" title=\"Filtrer par type\"><option value=\"\">Tous les types</option>${Object.keys(FKINDS).filter(k=>kc[k]).map(k=>`<option value=\"${k}\">${FKINDS[k]} (${kc[k]})</option>`).join('')}</select><span class=\"vt\"><button data-v=\"grid\" class=\"${fview()==='grid'?'on':''}\" title=\"Grille\">▦</button><button data-v=\"list\" class=\"${fview()==='list'?'on':''}\" title=\"Liste\">☰</button></span><span class=\"sp\"></span><button class=\"btn ghost sm\" id=\"fdup\" title=\"Même nom et même taille\">Doublons</button>`+(fproj==='trash'&&TRASH.length?`<button class=\"btn ghost sm del\" id=\"fempt\">${IC('trash')}Vider la corbeille</button>`:'');\r\n  $('fsort').value=settings.fsort||'new';$('ftype').value=ftype}\r\nfunction drawFiles(anim=true){applyFcol();\r\n  fUrls.forEach(u=>URL.revokeObjectURL(u));fUrls=[];\r\n  if(fproj!=='all'&&!['none','fav','recent','trash'].includes(fproj)&&!isProjId(fproj))fproj='all';\r\n  const tr=fproj==='trash';if(tr!==lastT){SEL.clear();lastT=tr}\r\n  const q=fq.trim().toLowerCase(),tot=FILES.reduce((s,f)=>s+f.size,0),n=accs.length;\r\n  const list=viewList(fproj).filter(f=>matchQ(f,q)&&(!ftype||kindOf(f)===ftype)).sort(sortP);VIS=list.map(f=>f.id);\r\n  $('fsub').textContent=FILES.length?`${FILES.length} fichier${FILES.length>1?'s':''} · ${fmtSize(tot)} · disponibles sur ${n} compte${n>1?'s':''}`+(TRASH.length?` · ${TRASH.length} dans la corbeille`:''):'Ta bibliothèque est commune à tous tes comptes.';\r\n  $('fcount').textContent=FILES.length||'';\r\n  $('fempty').style.display=FILES.length||TRASH.length?'none':'grid';\r\n  const g=$('fgrid');g.classList.toggle('noanim',!anim);g.classList.toggle('list',fview()==='list');\r\n  g.innerHTML=list.map((f,i)=>{const ik=iconKind(f);let top;\r\n    if(ik==='image'){const u=URL.createObjectURL(f.blob);fUrls.push(u);top=`<div class=\"fthumb\" data-prev=\"${f.id}\" style=\"cursor:zoom-in\"><img src=\"${u}\" alt=\"\"></div>`}else top=`<div data-prevw=\"${f.id}\" style=\"cursor:zoom-in;display:flex\">${fileTile(f)}</div>`;\r\n    const d=new Date(f.added).toLocaleDateString('fr-FR',{day:'numeric',month:'short'});\r\n    const tags=`<div class=\"ftags\">${(f.tags||[]).map(t=>`<button class=\"ftag\" data-tag=\"${esc(t)}\" title=\"Clic : filtrer · clic droit : retirer\">#${esc(t)}</button>`).join('')}${tr?'':`<button class=\"ftag add\" data-addtag=\"${f.id}\">+ étiquette</button>`}</div>`;\r\n    const src=f.src?`<div class=\"fmeta\" title=\"${esc(f.src.conv||'')}\">${f.src.kind==='created'?'Créé par Claude':'Joint'} · ${esc(f.src.conv||'')}</div>`:'';\r\n    const acts=tr?`<button class=\"btn sm\" data-restore=\"${f.id}\">Restaurer</button><button class=\"btn ghost sm ico del\" data-purge=\"${f.id}\" title=\"Supprimer définitivement\">${IC('trash')}</button>`\r\n      :`<button class=\"btn sm\" data-att=\"${f.id}\">${IC('clip')}Joindre à…</button><button class=\"btn ghost sm ico fstar${f.fav?' on':''}\" data-fav=\"${f.id}\" title=\"Favori\">${f.fav?'★':'☆'}</button><button class=\"btn ghost sm ico\" data-edtn=\"${f.id}\" title=\"Renommer (F2)\">${IC('edit')}</button><button class=\"btn ghost sm ico\" data-dl=\"${f.id}\" title=\"Enregistrer sous\">${IC('dl')}</button><button class=\"btn ghost sm ico del\" data-rm=\"${f.id}\" title=\"Mettre à la corbeille\">${IC('trash')}</button>`;\r\n    return `<div class=\"fcard${SEL.has(f.id)?' sel':''}\" data-id=\"${f.id}\" style=\"--i:${i}\"><label class=\"fck\" title=\"Sélectionner (Maj+clic : plage)\"><input type=\"checkbox\" data-sel=\"${f.id}\"${SEL.has(f.id)?' checked':''}></label><div class=\"frow\">${top}<div class=\"fbody\"><div class=\"fname\" data-rn=\"${f.id}\" title=\"${esc(f.name)} · double-clic pour renommer\">${esc(f.name)}</div><div class=\"fmeta\">${esc(fileLabel(f))}</div><div class=\"fmeta\">${fmtSize(f.size)} · ${d}${tr?` · supprimé dans ${Math.max(0,Math.ceil((TTL-(Date.now()-f.del))/DAY))} j`:''}</div>${src}${tr?'':projSel(f)}${tags}</div></div><div class=\"fact2\">${acts}</div></div>`}).join('')\r\n    +(!list.length&&(FILES.length||TRASH.length)?`<p class=\"dim\">${q?'Aucun fichier ne correspond.':tr?'La corbeille est vide.':fproj==='fav'?'Aucun favori : clique sur l\\'étoile d\\'une carte.':'Aucun fichier dans cette sélection.'}</p>`:'');\r\n  drawTools();drawProjs();drawSel();pushMenu()}\r\n// corbeille (30 jours), étiquettes, favoris\r\nasync function trashIds(ids){let n=0;for(const id of ids){const f=FILES.find(x=>x.id===id);if(!f)continue;try{await FDB.put({...f,del:Date.now()});n++}catch{}SEL.delete(id)}\r\n  await loadFiles(false);if(n)toast(`${n} fichier${n>1?'s déplacés':' déplacé'} dans la corbeille · restauration possible pendant 30 jours`)}\r\nasync function restoreIds(ids){let n=0;for(const id of ids){const f=TRASH.find(x=>x.id===id);if(!f)continue;try{await FDB.put({...f,del:0});n++}catch{}SEL.delete(id)}await loadFiles(false);if(n)toast(`${n} fichier${n>1?'s restaurés':' restauré'}`)}\r\nasync function purgeIds(ids,ask){ids=ids.filter(id=>TRASH.some(f=>f.id===id));if(!ids.length)return;\r\n  if(ask&&!confirm(`Supprimer définitivement ${ids.length} fichier${ids.length>1?'s':''} ? Cette action est irréversible.`))return;\r\n  for(const id of ids){try{if(String(id).startsWith('scan-'))(settings.scanSkip??=[]).push(id);await FDB.del(id)}catch{}SEL.delete(id)}save();await loadFiles(false);toast('Supprimé définitivement')}\r\nasync function dedupe(){const seen=new Map(),dups=[];for(const f of [...FILES].sort((a,b)=>a.added-b.added)){const k=f.name.toLowerCase()+'|'+f.size;seen.has(k)?dups.push(f):seen.set(k,f)}\r\n  if(!dups.length)return toast('Aucun doublon (même nom et même taille)');\r\n  if(!confirm(`${dups.length} doublon${dups.length>1?'s':''} trouvé${dups.length>1?'s':''} (${fmtSize(dups.reduce((s,f)=>s+f.size,0))}). Mettre les copies les plus récentes à la corbeille et garder l'original ?`))return;\r\n  await trashIds(dups.map(f=>f.id))}\r\nfunction inlineInput(el,ph,cb,val=''){const i=document.createElement('input');i.className='finp';i.placeholder=ph;i.value=val;el.replaceWith(i);i.focus();i.select();let done=0;\r\n  const end=ok=>{if(done)return;done=1;const v=i.value.trim();ok&&v?Promise.resolve(cb(v)).catch(()=>{}).then(()=>loadFiles(false)):drawFiles(false)};\r\n  i.onkeydown=e=>{if(e.key==='Enter')end(true);else if(e.key==='Escape')end(false);e.stopPropagation()};i.onblur=()=>end(true)}\r\nfunction startRename(id){const f=byId(id),el=document.querySelector(`.fcard[data-id=\"${id}\"] .fname`);if(!f||!el)return;\r\n  inlineInput(el,'Nom du fichier',v=>v!==f.name&&FDB.put({...f,name:v.slice(0,200)}),f.name)}\r\nconst addTag=async(ids,t)=>{t=cleanTag(t);if(!t)return;for(const id of ids){const f=byId(id);if(f&&!(f.tags||[]).includes(t))await FDB.put({...f,tags:[...(f.tags||[]),t]})}};\r\n// aperçu rapide\r\nasync function openPrev(id){const f=byId(id);if(!f)return;PVID=id;$('fprev').hidden=false;$('pvname').textContent=f.name;const body=$('pvbody');\r\n  if(PVURL)URL.revokeObjectURL(PVURL);PVURL=null;body.textContent='';const k=kindOf(f);\r\n  if(k==='image'||k==='pdf'){PVURL=URL.createObjectURL(f.blob);body.innerHTML=k==='image'?`<img src=\"${PVURL}\" alt=\"\">`:`<iframe src=\"${PVURL}\"></iframe>`;return}\r\n  if(f.size<1048576&&!(await f.blob.slice(0,2048).text()).includes('\\0')){const pre=document.createElement('pre');pre.textContent=await f.blob.text();body.appendChild(pre);return}\r\n  body.innerHTML='<p class=\"dim\">Pas d\\'aperçu pour ce type de fichier : utilise « Enregistrer ».</p>'}\r\nfunction closePrev(){$('fprev').hidden=true;$('pvbody').textContent='';if(PVURL)URL.revokeObjectURL(PVURL);PVURL=null}\r\n$('pvx').onclick=closePrev;$('pvdl').onclick=()=>dlFile(byId(PVID));$('fprev').onclick=e=>{if(e.target.id==='fprev')closePrev()};\r\n// envoi de plusieurs fichiers d'un coup\r\nconst ATTACH_MANY_JS=`(async(items)=>{\r\n  const dt=new DataTransfer();\r\n  for(const it of items){const bin=atob(it.b64),u8=new Uint8Array(bin.length);for(let i=0;i<bin.length;i++)u8[i]=bin.charCodeAt(i);dt.items.add(new File([u8],it.name,{type:it.type||'application/octet-stream'}))}\r\n  const look=()=>({inp:[...document.querySelectorAll('input[type=file]')].find(i=>!i.disabled),box:document.querySelector('div[contenteditable=true],textarea,[role=textbox]')});\r\n  let t={};for(let i=0;i<32;i++){t=look();if(t.inp||t.box)break;await new Promise(r=>setTimeout(r,250))}\r\n  if(t.inp){t.inp.files=dt.files;t.inp.dispatchEvent(new Event('input',{bubbles:true}));t.inp.dispatchEvent(new Event('change',{bubbles:true}));return 'input'}\r\n  if(t.box){t.box.focus();t.box.dispatchEvent(new ClipboardEvent('paste',{clipboardData:dt,bubbles:true,cancelable:true}));return 'paste'}\r\n  return 'none'})`;\r\nasync function attachFiles(ids,accId,o={}){const fs=ids.map(id=>FILES.find(x=>x.id===id)).filter(Boolean),a=find(accId);if(!fs.length||!a)return;\r\n  if(fs.length===1)return attachFile(fs[0].id,accId,o);\r\n  if(!o.stay){active=a.id;setOpen=false;filesOpen=false;save();render()}\r\n  const v=view(a);for(let i=0;i<60&&!v._ready;i++)await sleep(250);\r\n  if(!v._ready)return toast(`La page de ${a.p} n'est pas prête, réessaie dans un instant`);\r\n  if(fs.reduce((s,f)=>s+f.size,0)>25*1048576)toast('Gros transfert : cela peut prendre un moment…');\r\n  const items=[];for(const f of fs){try{items.push({b64:await b64Of(f.blob),name:f.name,type:f.type||''})}catch{}}\r\n  if(!items.length)return toast('Lecture des fichiers impossible');\r\n  try{const r=await v.executeJavaScript(ATTACH_MANY_JS+'('+JSON.stringify(items)+')');\r\n    if(r==='none')return toast(`Aucune zone de message trouvée sur ${a.p} : ouvre une conversation puis réessaie`);\r\n    for(const p of [...new Set(fs.map(f=>f.proj).filter(p=>p&&isProjId(p)))]){try{await addProjectContext(a,p,null)}catch(x){toast('Contexte du projet non ajouté : '+String(x&&x.message||x).slice(0,60))}}\r\n    toast(`${items.length} fichiers transmis à ${a.p} · ${a.n}. Vérifie qu'ils apparaissent dans la zone de message.`)}\r\n  catch(x){toast('Impossible de joindre les fichiers : '+String(x&&x.message||x).slice(0,80))}}\r\nasync function onMenuPick(a,p){\r\n  if(!p)return;\r\n  if(p.fids&&p.fids.length)return attachFiles(p.fids,a.id,{stay:true});\r\n  if(p.fid)return attachFile(p.fid,a.id,{stay:true});\r\n  if(p.pid)return addProjectContext(a,p.pid,null)}\r\nfunction openMulti(btn,ids){if(!ids.length)return toast('Aucun fichier à joindre');openFMenu(btn,'');const m=$('fmenu');m.dataset.ids=JSON.stringify(ids);m.querySelector('.mt').textContent='Joindre '+ids.length+' fichier'+(ids.length>1?'s':'')+' à…'}\r\n$('fmenu').onclick=e=>{const b=e.target.closest('[data-acc]');if(!b)return;const m=$('fmenu'),ids=m.dataset.ids?JSON.parse(m.dataset.ids):null,id=m.dataset.file;m.dataset.ids='';closeFMenu();ids?attachFiles(ids,b.dataset.acc):attachFile(id,b.dataset.acc)};\r\n// barre de sélection\r\nfunction drawSel(){const bar=$('fselbar');if(!bar)return;\r\n  for(const id of [...SEL])if(!byId(id))SEL.delete(id);\r\n  if(!SEL.size){bar.hidden=true;bar.innerHTML='';return}\r\n  const tr=fproj==='trash',s=SEL.size>1?'s':'';bar.hidden=false;\r\n  bar.innerHTML=`<b>${SEL.size} fichier${s} sélectionné${s}</b><button class=\"btn ghost sm\" id=\"selvis\">Tout sélectionner (${VIS.length})</button><span class=\"sp\"></span>`\r\n    +(tr?`<button class=\"btn sm\" id=\"selrest\">Restaurer</button><button class=\"btn ghost sm del\" id=\"selpurge\">Supprimer définitivement</button>`\r\n    :`<button class=\"btn sm pri\" id=\"selatt\">${IC('clip')}Joindre à…</button><select class=\"psel\" id=\"selmove\"><option value=\"\">Déplacer vers…</option><option value=\"-\">Sans projet</option>${PJ().map(p=>`<option value=\"${p.id}\">${esc(p.name)}</option>`).join('')}</select><button class=\"btn ghost sm\" id=\"selfav\">★ Favori</button><button class=\"btn ghost sm\" id=\"seltag\"># Étiquette</button><button class=\"btn ghost sm\" id=\"seldl\">${IC('dl')}Télécharger</button><button class=\"btn ghost sm del\" id=\"seltrash\">${IC('trash')}Corbeille</button>`)\r\n    +`<button class=\"btn ghost sm\" id=\"selnone\">Désélectionner</button>`}\r\n$('fselbar').addEventListener('click',async e=>{const b=e.target.closest('button');if(!b)return;const ids=[...SEL];\r\n  if(b.id==='selvis'){VIS.forEach(x=>SEL.add(x));drawFiles(false)}\r\n  else if(b.id==='selatt')openMulti(b,ids.filter(x=>FILES.some(f=>f.id===x)))\r\n  else if(b.id==='selfav'){const all=ids.every(x=>(byId(x)||{}).fav);for(const x of ids){const f=byId(x);if(f)await FDB.put({...f,fav:!all})}await loadFiles(false)}\r\n  else if(b.id==='seltag')inlineInput(b,'Étiquette pour la sélection',v=>addTag(ids,v))\r\n  else if(b.id==='seldl'){for(const x of ids){dlFile(byId(x));await sleep(250)}}\r\n  else if(b.id==='seltrash')trashIds(ids)\r\n  else if(b.id==='selrest')restoreIds(ids)\r\n  else if(b.id==='selpurge')purgeIds(ids,true)});\r\n$('fselbar').addEventListener('change',async e=>{if(e.target.id!=='selmove'||!e.target.value)return;const v=e.target.value;\r\n  for(const x of [...SEL]){const f=byId(x);if(f)await FDB.put({...f,proj:v==='-'?'':v,man:true,auto:false})}await loadFiles(false);toast('Fichiers déplacés')});\r\n$('fpedit').addEventListener('click',e=>{const b=e.target.closest('#patt');if(b)openMulti(b,FILES.filter(f=>f.proj===fproj).map(f=>f.id))});\r\n// barre d'outils\r\n$('ftools').addEventListener('change',e=>{if(e.target.id==='fsort'){settings.fsort=e.target.value;save();drawFiles(false)}else if(e.target.id==='ftype'){ftype=e.target.value;drawFiles(false)}});\r\n$('ftools').addEventListener('click',e=>{const v=e.target.closest('[data-v]');if(v){settings.fview=v.dataset.v;save();return drawFiles(false)}\r\n  if(e.target.closest('#fdup'))return dedupe();if(e.target.closest('#fempt'))purgeIds(TRASH.map(f=>f.id),true)});\r\n// cartes\r\n$('fgrid').onclick=async e=>{const g=s=>e.target.closest(s);let b;\r\n  if(b=g('[data-att]')){$('fmenu').dataset.ids='';return openFMenu(b,b.dataset.att)}\r\n  if(b=g('[data-dl]'))return dlFile(byId(b.dataset.dl));\r\n  if(b=g('[data-fav]')){const f=byId(b.dataset.fav);if(f){await FDB.put({...f,fav:!f.fav});await loadFiles(false)}return}\r\n  if(b=g('[data-rm]'))return trashIds([b.dataset.rm]);\r\n  if(b=g('[data-restore]'))return restoreIds([b.dataset.restore]);\r\n  if(b=g('[data-purge]'))return purgeIds([b.dataset.purge],true);\r\n  if(b=g('[data-prev]')||g('[data-prevw]'))return openPrev(b.dataset.prev||b.dataset.prevw);\r\n  if(b=g('[data-edtn]'))return startRename(b.dataset.edtn);\r\n  if(b=g('[data-addtag]'))return inlineInput(b,'Étiquette',v=>addTag([b.dataset.addtag],v));\r\n  if(b=g('[data-tag]')){fq='#'+b.dataset.tag;$('fq').value=fq;drawFiles(false)}};\r\n$('fgrid').ondblclick=e=>{const n=e.target.closest('[data-rn]');if(n&&fproj!=='trash')startRename(n.dataset.rn)};\r\n$('fgrid').addEventListener('contextmenu',e=>{const t=e.target.closest('[data-tag]');if(!t)return;e.preventDefault();const f=byId(t.closest('.fcard').dataset.id);\r\n  if(f)FDB.put({...f,tags:(f.tags||[]).filter(x=>x!==t.dataset.tag)}).then(()=>loadFiles(false))});\r\n$('fgrid').addEventListener('click',e=>{if(e.target.closest('input[data-sel]'))shiftNext=e.shiftKey},true);\r\n$('fgrid').addEventListener('change',e=>{const c=e.target.closest('input[data-sel]');if(!c)return;const id=c.dataset.sel;\r\n  if(shiftNext&&lastSel&&lastSel!==id){const a=VIS.indexOf(lastSel),b=VIS.indexOf(id);if(a>=0&&b>=0){VIS.slice(Math.min(a,b),Math.max(a,b)+1).forEach(x=>SEL.add(x));drawFiles(false)}}\r\n  lastSel=id;shiftNext=false});\r\n// raccourcis clavier\r\ndocument.addEventListener('keydown',e=>{if(!filesOpen)return;\r\n  if(!$('fprev').hidden){if(e.key==='Escape'||e.key===' '){e.preventDefault();closePrev()}else if(e.key==='ArrowRight'||e.key==='ArrowLeft'){const n=VIS[VIS.indexOf(PVID)+(e.key==='ArrowRight'?1:-1)];if(n)openPrev(n)}return}\r\n  if(/^(INPUT|TEXTAREA|SELECT)$/.test((e.target||{}).tagName))return;\r\n  const k=e.key.toLowerCase(),ctl=e.ctrlKey||e.metaKey;\r\n  if(ctl&&k==='a'){e.preventDefault();VIS.forEach(x=>SEL.add(x));drawFiles(false)}\r\n  else if(ctl&&k==='f'){e.preventDefault();$('fq').focus()}\r\n  else if(e.key==='Delete'&&SEL.size)fproj==='trash'?purgeIds([...SEL],true):trashIds([...SEL]);\r\n  else if(e.key===' '&&SEL.size){e.preventDefault();openPrev([...SEL][0])}\r\n  else if(e.key==='F2'&&SEL.size===1)startRename([...SEL][0]);\r\n  else if(e.key==='Escape'&&SEL.size){SEL.clear();drawFiles(false)}});\r\n\r\nconst T0=performance.now();\r\ninit().catch(e=>{toast('Erreur au démarrage : '+e.message);api.updFail(e.message)}).finally(()=>setTimeout(()=>{$('splash').classList.add('out');setTimeout(()=>$('splash').remove(),600)},Math.max(0,1700-(performance.now()-T0))));\r\n</script><style id=\"css240\">\r\n.k-ov{position:fixed;inset:0;z-index:99990;background:rgba(0,0,0,.38);display:none;align-items:flex-start;justify-content:center;padding-top:12vh;font-family:var(--sans)}\r\n.k-ov.on{display:flex}\r\n.k-box{width:min(640px,92vw);max-height:76vh;overflow:auto;background:var(--panel);color:var(--txt);border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow);animation:kin .16s var(--ease)}\r\n@keyframes kin{from{opacity:0;transform:translateY(-8px) scale(.98)}to{opacity:1;transform:none}}\r\n.k-in{width:100%;box-sizing:border-box;border:0;border-bottom:1px solid var(--line);background:transparent;color:var(--txt);font:inherit;font-size:16px;padding:14px 16px;outline:none}\r\n.k-it{padding:9px 16px;cursor:pointer;display:flex;flex-direction:column;gap:2px}\r\n.k-it.sel,.k-it:hover{background:var(--sel)}\r\n.k-it b{font-weight:600;font-size:14px}.k-it small{color:var(--dim);font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\r\n.k-h{padding:8px 16px 2px;color:var(--dim);font-size:11px;text-transform:uppercase;letter-spacing:.06em}\r\n.k-pad{padding:16px 18px}.k-pad h3{margin:0 0 10px;font-family:var(--serif);font-weight:500;font-size:20px}\r\n.k-t{width:100%;border-collapse:collapse;font-size:13px}.k-t th{color:var(--dim);font-weight:500;text-align:left;padding:6px 8px;border-bottom:1px solid var(--line)}\r\n.k-t td{padding:7px 8px;border-bottom:1px solid var(--line)}\r\n.acc{position:relative}\r\n.qr{flex:none;display:inline-flex;line-height:0;cursor:pointer;border-radius:50%}\r\n.qr circle{fill:none;stroke-width:3}.qr .t{stroke:rgba(128,128,128,.28)}\r\n.qr .p{stroke:var(--ok);stroke-linecap:round;transition:stroke-dasharray .5s,stroke .3s}\r\n.qr.w .p{stroke:var(--warn)}.qr.e .p{stroke:var(--err)}.qr.z{opacity:.55}.qr:hover{transform:scale(1.12)}\r\n#q-glob{position:fixed;right:14px;bottom:14px;z-index:40;display:flex;align-items:center;gap:10px;padding:8px 14px;border-radius:12px;background:var(--tbg);color:var(--ttx);font-size:12px;box-shadow:0 4px 16px rgba(0,0,0,.28);cursor:pointer;user-select:none;opacity:.94}\r\n#q-glob:hover{opacity:1}#q-glob b{font-weight:600;font-variant-numeric:tabular-nums}#q-glob small{opacity:.7;font-size:11px}\r\n#q-glob .gb{width:64px;height:4px;border-radius:4px;background:rgba(128,128,128,.35);overflow:hidden}#q-glob .gb i{display:block;height:100%;background:#6CC59A;transition:width .3s}\r\n#q-glob.w .gb i{background:#E0B060}#q-glob.e .gb i{background:#EE8A78}\r\n/* 2.5.1 : anneaux parfaitement ronds et bien placés */\r\n.acc .qr{flex:none;width:24px;height:24px;min-width:24px;max-width:24px;aspect-ratio:1/1;display:block;line-height:0;margin-left:2px;border-radius:50%;overflow:visible}\r\n.acc .qr svg{display:block;width:24px;height:24px}\r\n.acc:hover b{position:absolute;top:50%;transform:translateY(-50%);background:var(--sel);z-index:2}\r\n.acc b[data-del]{right:40px}.acc b[data-ren]{right:66px}\r\n#q-glob{right:16px;bottom:16px;gap:16px;padding:10px 16px;border-radius:20px;align-items:flex-start}\r\n#q-glob .gi{display:flex;flex-direction:column;align-items:center;gap:4px}\r\n#q-glob .gi small{font-size:10px;opacity:.7;letter-spacing:.02em}\r\n#q-glob .rg{position:relative;width:48px;height:48px;min-width:48px;aspect-ratio:1/1;flex:none;border-radius:50%}\r\n#q-glob .rg svg{display:block;width:48px;height:48px}\r\n#q-glob .rg circle{fill:none}#q-glob .rg .t{stroke:rgba(128,128,128,.3)}\r\n#q-glob .rg .p{stroke:#6CC59A;stroke-linecap:round;transition:stroke-dasharray .5s,stroke .3s}\r\n#q-glob .rg.w .p{stroke:#E0B060}#q-glob .rg.e .p{stroke:#EE8A78}\r\n#q-glob .rg b{position:absolute;inset:0;display:grid;place-items:center;font-size:12px;font-weight:600;font-variant-numeric:tabular-nums}\r\n\r\n/* 2.5.2 : jauge unique + bas de barre latérale */\r\n#q-glob{padding:10px 14px;border-radius:18px;align-items:center}\r\n#q-glob .rg{width:56px;height:56px;min-width:56px}#q-glob .rg svg{width:56px;height:56px}\r\n#q-glob .rg b{font-size:13px}\r\n#q-glob .gi small{font-size:10px;opacity:.75}\r\naside #filesbtn{margin-top:8px;padding:9px 12px;border-radius:10px;transition:background .15s,color .15s}\r\naside #filesbtn:hover,aside .foot #gear:hover{background:var(--sel)}\r\naside #filesbtn .pill{min-width:22px;height:20px;padding:0 7px;border-radius:999px;display:inline-grid;place-items:center;font-size:11px;font-weight:600;font-variant-numeric:tabular-nums;background:var(--soft);color:var(--dim);border:1px solid var(--line)}\r\naside .foot{margin-top:6px;padding-top:10px;border-top:1px solid var(--line);gap:8px}\r\naside .foot #gear{padding:9px 12px;border-radius:10px}\r\naside .foot #themebtn{width:38px;height:38px;flex:none;display:grid;place-items:center;padding:0;border-radius:10px;border:1px solid var(--line);background:var(--soft);transition:background .2s,border-color .2s,transform .18s}\r\naside .foot #themebtn:hover{background:var(--sel);border-color:var(--line2)}\r\naside .foot #themebtn .tg{color:var(--acc)}\r\n\r\n/* 2.5.3 : au survol, crayon et croix prennent la place des badges (plus de chevauchement) */\r\n.acc:hover b,.acc:hover b[data-ren],.acc:hover b[data-del]{position:static;transform:none;right:auto;top:auto;display:grid;place-items:center;width:24px;height:24px;padding:0;flex:none;background:transparent}\r\n.acc:hover b:hover{background:var(--hover)}\r\n.acc:hover .bd,.acc:hover .spin{display:none}\r\n\r\n.q-f{display:flex;flex-direction:column;gap:6px;margin:10px 0}.q-f label{font-size:12px;color:var(--dim)}\r\n.q-f input,.q-f select{border:1px solid var(--line);background:var(--soft);color:var(--txt);border-radius:8px;padding:8px 10px;font:inherit}\r\n\r\n.k-pill{display:inline-block;padding:1px 8px;border-radius:99px;font-size:11px;background:var(--soft);color:var(--acc)}.k-pill.ok{background:rgba(47,125,91,.12);color:var(--ok)}.k-pill.err{background:rgba(179,65,47,.12);color:var(--err)}\r\n.k-row{display:flex;gap:6px;align-items:center;margin:6px 0;flex-wrap:wrap}\r\n.k-row select,.k-row input[type=text]{background:var(--bg);color:var(--txt);border:1px solid var(--line2);border-radius:8px;padding:5px 8px;font:inherit;font-size:13px}\r\n.k-btn{background:var(--btn);color:#fff;border:0;border-radius:8px;padding:6px 12px;cursor:pointer;font:inherit;font-size:13px}.k-btn.g{background:var(--hover);color:var(--txt)}\r\n</style>\r\n<script>\r\n(()=>{try{\r\nconst V240='2.5.1',$$=s=>document.querySelector(s),esc=s=>String(s??'').replace(/[&<>\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]));\r\nconst day=(o=0)=>new Date(Date.now()-o*864e5).toISOString().slice(0,10);\r\nconst gs=(k,d)=>{const v=hub.store.get(k);return v==null?d:v},ss=(k,v)=>hub.store.set(k,v);\r\n\r\n// ---- 1. Détection par le réseau (statuts HTTP réels, compteur de messages réel) ----\r\nconst lastNet={};\r\napi.onNet(e=>{try{\r\n  const v=[...document.querySelectorAll('webview')].find(w=>{try{return w.getWebContentsId()===e.wc}catch{return false}});\r\n  const a=v&&find(v.dataset.id);if(!a)return;\r\n  const s=stOf(a.id);if(Object.keys(e.quota||{}).length)s.quota=e.quota;\r\n  if(e.completion&&e.status<400){const k='n-'+a.id+'-'+day();ss(k,(gs(k,0))+1);try{const tk='qts-'+a.id,t7=Date.now()-7*864e5;ss(tk,gs(tk,[]).filter(x=>x>t7).concat(Date.now()).slice(-2000))}catch{}try{window.__qRefresh&&window.__qRefresh()}catch{}return}\r\n  const key=a.id+e.status;if(Date.now()-(lastNet[key]||0)<10000)return;lastNet[key]=Date.now();\r\n  const d={match:'HTTP '+e.status+' (réseau)',via:'network',status:e.status,until:e.until||0,quota:e.quota};\r\n  const type=e.status===429?(e.completion&&gs('__netlimit',true)?'limit-hit':'rate-limit'):'overloaded';\r\n  s.net429=(s.net429||0)+(e.status===429?1:0);\r\n  handle(a,{type,ts:e.ts,url:'',detail:d});\r\n}catch(x){}});\r\n\r\n// ---- 2. Historique local : on enregistre la conversation après chaque réponse ----\r\nconst capT={};\r\nconst _h=handle;\r\nhandle=function(a,ev){\r\n  _h(a,ev);\r\n  try{ if(ev.type==='response-complete'){clearTimeout(capT[a.id]);capT[a.id]=setTimeout(async()=>{\r\n      const v=document.querySelector(`webview[data-id=\"${a.id}\"]`),txt=await hub.getConversation(a.id);if(!v||!txt||txt.length<50)return;\r\n      let url='',title='';try{url=v.getURL();title=v.getTitle()}catch{}\r\n      api.convPut({key:a.id+'|'+url,acc:a.id,platform:a.p,name:a.n,url,title,text:txt})},4000)}\r\n    runRules(a,ev);\r\n  }catch(x){}\r\n};\r\n\r\n// ---- 3. Règles sans code : quand [événement] sur [plateforme] → [action] ----\r\nconst REV=[['limit-hit','Limite atteinte'],['rate-limit','Trop de requêtes'],['overloaded','Service saturé'],['error','Erreur'],['chat-too-long','Conversation trop longue'],['limit-soon','Limite bientôt atteinte'],['session-expired','Compte déconnecté'],['captcha','Vérification anti-robot'],['response-complete','Réponse terminée'],['idle','Inactif 2 min']];\r\nconst RACT=[['notify','Me notifier'],['next','Passer au compte suivant (même plateforme)'],['continue','Reprendre la conversation sur un autre compte'],['copy','Copier la conversation'],['mark','Marquer le compte comme limité'],['reload','Recharger la page']];\r\nconst cool={};\r\nasync function runRules(a,ev){\r\n  for(const r of gs('__rules',[])){\r\n    if(r.ev!==ev.type||(r.plat&&r.plat!=='*'&&r.plat!==a.p))continue;\r\n    if(ev.type==='response-complete'&&a.id===active)continue;\r\n    const k=r.id+a.id;if(Date.now()-(cool[k]||0)<20000)continue;cool[k]=Date.now();\r\n    try{\r\n      if(r.act==='notify')hub.notify((r.arg||REV.find(x=>x[0]===r.ev)[1])+' — '+a.p+' · '+a.n);\r\n      else if(r.act==='next')hub.next({samePlatform:true});\r\n      else if(r.act==='continue'){const t=hub.available({samePlatform:true,from:a.id});if(t)await hub.continueOn(t,{from:a.id,send:false});else hub.notify('Aucun autre compte '+a.p+' disponible')}\r\n      else if(r.act==='copy'){await hub.exportConversation(a.id);hub.notify('Conversation copiée')}\r\n      else if(r.act==='mark')hub.setLimited(a.id,true);\r\n      else if(r.act==='reload')hub.reload(a.id);\r\n    }catch(x){codeErr(x)}\r\n  }\r\n}\r\n\r\n// ---- 4. Fenêtre modale + tableau de bord + règles ----\r\nconst ov=document.createElement('div');ov.className='k-ov';ov.innerHTML='<div class=\"k-box\" id=\"k-box\"></div>';document.body.appendChild(ov);\r\nconst box=$$('#k-box'),close=()=>ov.classList.remove('on'),open=h=>{box.innerHTML=h;ov.classList.add('on')};\r\nov.addEventListener('mousedown',e=>{if(e.target===ov)close()});\r\n\r\nfunction dashboard(){\r\n  const rows=accs.map(a=>{const s=stOf(a.id);let n7=0;for(let i=0;i<7;i++)n7+=gs('n-'+a.id+'-'+day(i),0);\r\n    const lim=s.limited?`<span class=\"k-pill err\">Limité${s.until?' jusqu’à '+new Date(s.until).toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'}):''}</span>`:s.logged===false?'<span class=\"k-pill err\">Déconnecté</span>':s.gen?'<span class=\"k-pill\">Répond…</span>':'<span class=\"k-pill ok\">OK</span>';\r\n    const q=s.quota&&Object.entries(s.quota).slice(0,2).map(([k,v])=>esc(k.replace(/^.*ratelimit-?/,'')+': '+v)).join(' · ');\r\n    return `<tr><td><b>${esc(a.n)}</b><br><small style=\"color:var(--dim)\">${esc(a.p)}</small></td><td>${lim}</td><td>${(()=>{const q=qInfo(a);return q.max?q.n+'/'+q.max:q.n+' / —'})()}</td><td>${gs('n-'+a.id+'-'+day(),0)}</td><td>${n7}</td><td>${s.net429||0}</td><td style=\"color:var(--dim);font-size:11px\">${q||'—'}</td></tr>`}).join('');\r\n  open(`<div class=\"k-pad\"><h3>Tableau de bord</h3><table class=\"k-t\"><tr><th>Compte</th><th>État</th><th>Quota</th><th>Msgs aujourd’hui</th><th>7 jours</th><th>HTTP 429</th><th>Quota (en-têtes)</th></tr>${rows||'<tr><td colspan=7>Aucun compte</td></tr>'}</table>\r\n  <p style=\"color:var(--dim);font-size:12px\">Les messages sont comptés d’après les vraies requêtes réseau, pas à la main. Les en-têtes de quota ne s’affichent que si le site en envoie.</p>\r\n  <div class=\"k-row\"><button class=\"k-btn g\" id=\"k-x\">Fermer</button></div></div>`);\r\n  $$('#k-x').onclick=close;\r\n}\r\nfunction rules(){\r\n  const R=gs('__rules',[]),sel=(id,l,v)=>`<select id=\"${id}\">${l.map(x=>`<option value=\"${x[0]}\"${x[0]===v?' selected':''}>${esc(x[1])}</option>`).join('')}</select>`;\r\n  const plats=[['*','Toutes les plateformes'],...[...new Set(accs.map(a=>a.p))].map(p=>[p,p])];\r\n  open(`<div class=\"k-pad\"><h3>Règles automatiques</h3>\r\n  ${R.map((r,i)=>`<div class=\"k-row\"><span>Quand <b>${esc((REV.find(x=>x[0]===r.ev)||[,r.ev])[1])}</b> sur <b>${esc(r.plat==='*'?'toutes':r.plat)}</b> → ${esc((RACT.find(x=>x[0]===r.act)||[,r.act])[1])}</span><button class=\"k-btn g\" data-d=\"${i}\">Supprimer</button></div>`).join('')||'<p style=\"color:var(--dim)\">Aucune règle.</p>'}\r\n  <div class=\"k-row\" style=\"margin-top:14px\">Quand ${sel('r-ev',REV,'limit-hit')} sur ${sel('r-pl',plats,'*')} alors ${sel('r-ac',RACT,'notify')}<button class=\"k-btn\" id=\"r-add\">Ajouter</button></div>\r\n  <label class=\"k-row\" style=\"font-size:13px\"><input type=\"checkbox\" id=\"r-nl\"${gs('__netlimit',true)?' checked':''}> Le réseau (HTTP 429 sur l’envoi d’un message) peut marquer un compte comme limité</label>\r\n  <div class=\"k-row\"><button class=\"k-btn g\" id=\"k-x\">Fermer</button></div></div>`);\r\n  $$('#k-x').onclick=close;\r\n  $$('#r-add').onclick=()=>{R.push({id:'r'+Date.now(),ev:$$('#r-ev').value,plat:$$('#r-pl').value,act:$$('#r-ac').value});ss('__rules',R);rules()};\r\n  $$('#r-nl').onchange=e=>ss('__netlimit',e.target.checked);\r\n  box.querySelectorAll('[data-d]').forEach(b=>b.onclick=()=>{R.splice(+b.dataset.d,1);ss('__rules',R);rules()});\r\n}\r\n\r\nlet items=[],idx=0,qT=null,qs=0;\r\nfunction drawPal(){box.querySelector('#k-list').innerHTML=items.map((it,i)=>it.h?`<div class=\"k-h\">${esc(it.h)}</div>`:`<div class=\"k-it${i===idx?' sel':''}\" data-i=\"${i}\"><b>${esc(it.t)}</b><small>${esc(it.s||'')}</small></div>`).join('');\r\n  box.querySelectorAll('.k-it').forEach(e=>e.onclick=()=>pick(+e.dataset.i))}\r\nfunction pick(i){const it=items[i];if(!it||it.h)return;close();it.go()}\r\nasync function build(q){\r\n  const ql=q.toLowerCase(),my=++qs,out=[];\r\n  const cmds=[{t:'Tableau de bord',s:'Messages, limites et quotas par compte',go:dashboard},{t:'Règles automatiques',s:'Quand X arrive, faire Y — sans code',go:rules},{t:'Vider l’historique local',s:'Efface les conversations enregistrées',go:async()=>{await api.convClear();toast('Historique vidé')}}].filter(c=>!ql||c.t.toLowerCase().includes(ql));\r\n  if(cmds.length)out.push({h:'Commandes'},...cmds);\r\n  const ac=accs.filter(a=>!ql||(a.p+' '+a.n).toLowerCase().includes(ql)).map(a=>({t:a.n,s:a.p+(stOf(a.id).limited?' · limité':''),go:()=>hub.switchTo(a.id)}));\r\n  if(ac.length)out.push({h:'Comptes'},...ac);\r\n  items=out;idx=out.findIndex(x=>!x.h);drawPal();\r\n  if(q.trim().length>=2){const r=await api.convSearch(q);if(my!==qs)return;\r\n    if(r.length){items=out.concat([{h:'Conversations enregistrées'}],r.map(c=>({t:c.title||c.name+' · '+c.platform,s:c.name+' — '+c.snip,go:()=>{const a=find(c.acc);if(!a)return toast('Compte introuvable');hub.switchTo(a.id);const v=document.querySelector(`webview[data-id=\"${a.id}\"]`);if(v&&c.url)setTimeout(()=>{try{v.loadURL(c.url)}catch{}},300)}})));if(idx<0)idx=items.findIndex(x=>!x.h);drawPal()}}\r\n}\r\naddEventListener('keydown',e=>{\r\n  \r\n  if(!ov.classList.contains('on'))return;\r\n  if(e.key==='Escape')close();\r\n  else if(box.querySelector('#k-q')&&['ArrowDown','ArrowUp','Enter'].includes(e.key)){e.preventDefault();\r\n    if(e.key==='Enter')return pick(idx);const d=e.key==='ArrowDown'?1:-1;let i=idx;do{i+=d}while(items[i]&&items[i].h);if(items[i]){idx=i;drawPal();box.querySelector('.k-it.sel')?.scrollIntoView({block:'nearest'})}}\r\n},true);\r\n\r\n// ---- 5. (2.5.0) Compteurs de quota : un par compte (barre de gauche) + un global (bas à droite) ----\r\nconst QW={day:['Aujourd’hui (minuit à minuit)',0],'5h':['5 heures glissantes',5],'24h':['24 heures glissantes',24],'7j':['7 jours glissants',168]};\r\nconst QC=()=>gs('__quota',{});\r\nconst num=v=>{const n=parseFloat(String(v).replace(/[^\\d.]/g,''));return isFinite(n)?n:null};\r\nfunction realQ(s){ // vrais compteurs envoyés par le site (en-têtes), si disponibles\r\n  const q=s&&s.quota;if(!q)return null;let lim=null,rem=null;\r\n  for(const [k,v] of Object.entries(q)){const n=num(v);if(n==null)continue;\r\n    if(/remaining/.test(k)&&rem==null)rem=n;else if(/limit/.test(k)&&!/remaining|reset/.test(k)&&lim==null)lim=n}\r\n  return lim!=null&&rem!=null&&lim>=rem&&lim>0?{n:lim-rem,max:lim}:null}\r\nconst QDEF={Claude:{max:40,win:'5h'},ChatGPT:{max:40,win:'5h'},Gemini:{max:50,win:'24h'}};\r\nfunction qInfo(a){\r\n  const c=QC()[a.id]||{},r=realQ(stOf(a.id)),hit=gs('qhit-'+a.id,0),d=QDEF[a.p]||{max:0,win:'day'};\r\n  const w=QW[c.win||d.win]?(c.win||d.win):'day';\r\n  if(r)return{n:r.n,max:r.max,real:true,win:w,src:'site'};\r\n  let n;if(w==='day')n=gs('n-'+a.id+'-'+day(),0);\r\n  else{const t=Date.now()-QW[w][1]*36e5;n=gs('qts-'+a.id,[]).filter(x=>x>t).length}\r\n  return{n,max:c.max||hit||d.max||0,real:false,win:w,src:c.max?'manuel':hit?'appris':'estimé'}}\r\nconst qCls=(n,m,lim)=>lim||(m&&n>=m)?'e':(m&&n/m>=.8)?'w':'';\r\nconst ringSvg=(pr,sz,sw)=>{const R=(sz-sw)/2,C=2*Math.PI*R,m=sz/2;\r\n  return '<svg viewBox=\"0 0 '+sz+' '+sz+'\" width=\"'+sz+'\" height=\"'+sz+'\"><circle class=\"t\" cx=\"'+m+'\" cy=\"'+m+'\" r=\"'+R+'\" stroke-width=\"'+sw+'\"/><circle class=\"p\" cx=\"'+m+'\" cy=\"'+m+'\" r=\"'+R+'\" stroke-width=\"'+sw+'\" transform=\"rotate(-90 '+m+' '+m+')\" stroke-dasharray=\"'+(Math.max(0,Math.min(1,pr))*C).toFixed(1)+' '+C.toFixed(1)+'\"/></svg>'};\r\nfunction decorate(){\r\n  document.querySelectorAll('#list .acc').forEach(row=>{\r\n    const a=find(row.dataset.id);if(!a)return;const q=qInfo(a),s=stOf(a.id),cls=qCls(q.n,q.max,s.limited);\r\n    row.querySelector('.qr')?.remove();\r\n    const pr=q.max?Math.min(1,q.n/q.max):(s.limited?1:0);\r\n    const c=document.createElement('div');c.className='qr '+cls+(q.max?'':' z');c.dataset.q=a.id;c.innerHTML=ringSvg(pr,24,3);\r\n    c.title=q.max?'Quota '+q.n+'/'+q.max+' ('+Math.round(q.n/q.max*100)+' %) · '+QW[q.win][0]+' · plafond '+q.src:q.n+' message(s) · '+QW[q.win][0];\r\n    row.appendChild(c)})}\r\nlet gEl=null;\r\nfunction glob(){\r\n  if(!gEl){gEl=document.createElement('div');gEl.id='q-glob';gEl.title='Quota global — clic : tableau de bord';(document.getElementById('hright')||document.body).appendChild(gEl);gEl.onclick=dashboard}\r\n  let tot=0,uMax=0,sMax=0,free=0;\r\n  for(const a of accs){const q=qInfo(a),s=stOf(a.id);tot+=q.n;if(q.max){uMax+=q.n;sMax+=q.max}if(!s.limited&&s.logged!==false)free++}\r\n  const n=accs.length,c1=qCls(uMax,sMax,false),c2=!n?'':free===0?'e':free/n<=.34?'w':'';\r\n  gEl.className=c1;gEl.style.display=n?'flex':'none';\r\n  gEl.innerHTML='<div class=\"gi\"><div class=\"rg '+c2+'\">'+ringSvg(n?free/n:0,18,3)+'</div><b>'+free+'/'+n+'</b><small>dispo</small></div>';\r\n  gEl.title='Comptes disponibles : '+free+' sur '+n+' · '+tot+' message(s) au total — clic : tableau de bord'}\r\n// ---- 2.5.5 : connexion via un vrai Chrome (contourne le blocage Google des fenêtres intégrées) ----\r\nconst LOGIN_HOSTS={Claude:['claude.ai','anthropic.com'],ChatGPT:['chatgpt.com','openai.com'],Gemini:['google.com'],'Le Chat':['mistral.ai'],Copilot:['microsoft.com','live.com','bing.com','microsoftonline.com'],Perplexity:['perplexity.ai'],Grok:['grok.com','x.ai','x.com'],DeepSeek:['deepseek.com']};\r\nconst loginHosts=a=>LOGIN_HOSTS[a.p]||(()=>{try{return [new URL(P[a.p][0]).hostname.split('.').slice(-2).join('.')]}catch{return []}})();\r\nlet CH={acc:null,port:0};\r\nfunction cdpCookies(url){return new Promise((res,rej)=>{\r\n  let done=false;const ws=new WebSocket(url);\r\n  const t=setTimeout(()=>{if(!done){done=true;try{ws.close()}catch{}rej(new Error('Chrome ne répond pas'))}},8000);\r\n  ws.onopen=()=>ws.send(JSON.stringify({id:1,method:'Storage.getCookies'}));\r\n  ws.onmessage=m=>{let j;try{j=JSON.parse(m.data)}catch{return}if(j.id!==1)return;done=true;clearTimeout(t);try{ws.close()}catch{}\r\n    j.error?rej(new Error(j.error.message)):res((j.result&&j.result.cookies)||[])};\r\n  ws.onerror=()=>{if(!done){done=true;clearTimeout(t);rej(new Error('Connexion à Chrome impossible'))}}})}\r\n$('chromelogin').onclick=()=>{const a=find(active);if(!a)return toast('Choisis d’abord un compte');\r\n  CH={acc:a.id,port:0};$('cinfo').textContent=a.p+' · '+a.n;$('cmsg').textContent='';$('copen').disabled=false;$('cimp').disabled=true;$('dlgC').showModal()};\r\n$('copen').onclick=async()=>{const a=find(CH.acc);if(!a)return;$('copen').disabled=true;$('cmsg').textContent='Ouverture de Chrome…';\r\n  const r=await api.chromeStart(P[a.p][0]);\r\n  if(!r.ok){$('cmsg').textContent='✘ '+r.error;$('copen').disabled=false;return}\r\n  CH.port=r.port;$('cimp').disabled=false;$('cmsg').textContent='Chrome est ouvert : connecte-toi sur le site, puis reviens ici cliquer « J’ai fini ».'};\r\n$('cimp').onclick=async()=>{const a=find(CH.acc);if(!a||!CH.port)return;$('cimp').disabled=true;$('cmsg').textContent='Lecture de la session…';\r\n  try{\r\n    const w=await api.chromeWs(CH.port);if(!w.ok)throw new Error(w.error);\r\n    const cookies=await cdpCookies(w.ws);\r\n    const r=await api.chromeImport({partition:'persist:'+a.id,hosts:loginHosts(a),cookies});\r\n    if(!r.ok)throw new Error(r.error);\r\n    if(!r.imported){$('cmsg').textContent='Aucune connexion trouvée dans Chrome pour ce site. Finis de te connecter dans Chrome, puis reclique « J’ai fini ».';$('cimp').disabled=false;return}\r\n    CH.port=0;api.chromeStop();$('dlgC').close();toast('Connexion importée ('+r.imported+' cookies) : rechargement…');\r\n    const v=document.querySelector('webview[data-id=\"'+a.id+'\"]');try{if(v)v.loadURL(P[a.p][0])}catch{}\r\n  }catch(e){$('cmsg').textContent='✘ '+(e.message||e);$('cimp').disabled=false}};\r\n$('cclose').onclick=()=>$('dlgC').close();\r\n$('dlgC').addEventListener('close',()=>{if(CH.port){CH.port=0;api.chromeStop()}});\r\nfunction refreshQ(){try{decorate();glob()}catch(x){}}\r\nwindow.__qRefresh=refreshQ;\r\nconst _rl=renderList;renderList=function(){_rl.apply(this,arguments);refreshQ()};\r\nsetInterval(refreshQ,30000);\r\n\r\nfunction quotaDlg(id){\r\n  const a=find(id);if(!a)return;const c=QC()[id]||{},q=qInfo(a),hit=gs('qhit-'+id,0);\r\n  open(`<div class=\"k-pad\"><h3>Quota · ${esc(a.p)} — ${esc(a.n)}</h3>\r\n  <p style=\"color:var(--dim);font-size:12px\">Utilisé : <b>${q.n}</b>${q.real?' (quota réel du site : '+q.n+'/'+q.max+')':' message(s) sur la fenêtre choisie'}.${hit?' Dernière limite atteinte à <b>'+hit+'</b> message(s).':''}</p>\r\n  <div class=\"q-f\"><label>Plafond de messages (0 = aucun)</label><input id=\"q-max\" type=\"number\" min=\"0\" value=\"${c.max||''}\" placeholder=\"ex. 40\">\r\n  <label>Fenêtre de comptage</label><select id=\"q-win\">${Object.entries(QW).map(([k,v])=>`<option value=\"${k}\"${k===(c.win||'day')?' selected':''}>${esc(v[0])}</option>`).join('')}</select></div>\r\n  <div class=\"k-row\">${hit?'<button class=\"k-btn g\" id=\"q-hit\">Utiliser '+hit+'</button>':''}<button class=\"k-btn g\" id=\"q-rz\">Remettre à 0</button><button class=\"k-btn g\" id=\"q-x\">Annuler</button><button class=\"k-btn\" id=\"q-ok\">Enregistrer</button></div></div>`);\r\n  $$('#q-x').onclick=close;\r\n  if(hit)$$('#q-hit').onclick=()=>{$$('#q-max').value=hit};\r\n  $$('#q-rz').onclick=()=>{ss('qts-'+id,[]);ss('n-'+id+'-'+day(),0);refreshQ();close();toast('Compteur remis à 0')};\r\n  $$('#q-ok').onclick=()=>{const m=Math.max(0,parseInt($$('#q-max').value,10)||0),all=QC();all[id]={max:m,win:$$('#q-win').value};ss('__quota',all);refreshQ();close()}}\r\n$('list').addEventListener('click',e=>{const q=e.target.closest('[data-q]');if(q){e.stopPropagation();const a=find(q.dataset.q);if(a){const i=qInfo(a);toast(a.n+' : '+i.n+(i.max?'/'+i.max:'')+' message(s) · '+QW[i.win][0]+(i.max?' · plafond '+i.src:''))}}},true);\r\n\r\n// apprentissage : quand une limite tombe, on retient le nombre de messages utilisés\r\nconst _h2=handle;\r\nhandle=function(a,ev){_h2(a,ev);try{if(ev.type==='limit-hit'){const q=qInfo(a);if(q.n>0)ss('qhit-'+a.id,q.n)}if(ev.type==='limit-cleared'){ss('qts-'+a.id,[])}refreshQ()}catch(x){}};\r\nrefreshQ();\r\n\r\nwindow.hub240={dashboard,rules,quotaDlg,version:V240};\r\n\r\n}catch(x){console.error('module 2.5.0',x)}})();\r\n</script>\r\n<style id=\"css260\">\r\n/* ===== 2.6.0 : projets + chat unique, comptes = clés ===== */\r\naside .pgrp{padding:10px 10px 2px}\r\n#plist{flex:1 1 auto;min-height:70px;overflow:auto;margin:0 -4px;padding:0 4px}\r\n#plist .acc.prj{gap:9px}\r\n#plist .acc .pic{display:inline-flex;line-height:0;color:var(--dim);text-decoration:none;flex:none}\r\n#plist .acc.on .pic{color:var(--acc)}\r\n#plist .acc .pn{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\r\n#plist .acc:hover b{position:static;transform:none;display:grid;place-items:center;width:24px;height:24px;padding:0;background:transparent}\r\n#plist .acc:hover .spin{display:none}\r\n#plist .pempty{color:var(--dim);font-size:13px;padding:10px;line-height:1.45}\r\n#keysbox{flex:none;display:flex;flex-direction:column;min-height:0;max-height:44%;border-top:1px solid var(--line);padding-top:6px}\r\n.keyshead{display:flex;align-items:center;gap:8px;width:100%;background:transparent;border:0;color:var(--dim);font:inherit;font-size:11.5px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;padding:6px 10px;cursor:pointer;border-radius:8px;text-align:left}\r\n.keyshead:hover{background:var(--hover);color:var(--txt)}\r\n.keyshead .kt{flex:1}.keyshead small{font-weight:500;text-transform:none;letter-spacing:0;opacity:.8}\r\n.keyshead em{font-style:normal;font-variant-numeric:tabular-nums;background:var(--soft);color:var(--dim);border:1px solid var(--line);border-radius:999px;padding:0 7px;font-size:11px;line-height:18px}\r\n.keyshead .chev{transition:transform .2s}\r\n#keysbox.min .chev{transform:rotate(-90deg)}\r\n#keysbody{display:flex;flex-direction:column;gap:6px;min-height:0;overflow:hidden;padding-top:4px}\r\n#keysbox.min #keysbody{display:none}\r\n#keysbox #list{flex:1 1 auto;min-height:0;overflow:auto}\r\n#keysbox #add{padding:5px 9px;font-size:13px}\r\n#list .acc.inuse{box-shadow:inset 3px 0 0 var(--acc)}\r\n#list .acc.inuse>span{color:var(--acc);font-weight:500}\r\n.ebtns{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}\r\n\r\n/* le chat recouvre les pages des comptes (qui continuent de tourner dessous) */\r\nwebview.drv{display:flex}\r\n#chat{position:absolute;inset:0;z-index:5;background:var(--bg);display:none;flex-direction:column;min-height:0}\r\n#chat.on{display:flex;animation:pagein .3s var(--ease) backwards}\r\n#ch-top{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 22px;border-bottom:1px solid var(--line);flex:none}\r\n.ch-id{min-width:0;display:flex;flex-direction:column}\r\n#ch-name{font:500 18px var(--serif);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\r\n#ch-desc{color:var(--dim);font-size:12.5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:60ch}\r\n#ch-desc:empty{display:none}\r\n#ch-stat{display:flex;flex-wrap:wrap;gap:6px;margin-top:5px}\r\n#ch-stat .sp{display:inline-flex;align-items:center;gap:5px;max-width:320px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding:2px 9px;border:1px solid var(--line2);border-radius:99px;font-size:11.5px;color:var(--dim);background:var(--panel)}\r\n#ch-stat .sp.ok::before,#ch-stat .sp.run::before,#ch-stat .sp.warn::before{content:\"\";width:7px;height:7px;border-radius:50%;flex:none;background:#3fb27f}\r\n#ch-stat .sp.run::before{background:var(--acc);animation:caretb 1s steps(2,start) infinite}\r\n#ch-stat .sp.warn{color:var(--err);border-color:var(--err)}#ch-stat .sp.warn::before{background:var(--err)}\r\n#ch-stat .sp.run{color:var(--txt)}\r\n.ch-act{display:flex;align-items:center;gap:6px;flex:none}\r\n#ch-key{max-width:300px}\r\n#ch-key .kl{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\r\n#ch-key .ks{font-size:11.5px;color:var(--dim)}\r\n#ch-key.bad{border-color:var(--err);color:var(--err)}\r\n#ch-msgs{flex:1;overflow:auto;padding:22px 0 10px;scroll-behavior:smooth}\r\n#ch-msgs>*{width:min(820px,calc(100% - 44px));margin-left:auto;margin-right:auto}\r\n.m{display:flex;flex-direction:column;margin-bottom:18px;animation:itemin .3s var(--ease) backwards}\r\n.m .b{white-space:pre-wrap;word-break:break-word;line-height:1.6;font-size:14.5px}\r\n.m.u{align-items:flex-end}\r\n.m.u .b{background:var(--sel);border-radius:16px 16px 4px 16px;padding:10px 14px;max-width:85%}\r\n.m.a .b{padding:2px 2px}\r\n.m .mk{display:flex;align-items:center;gap:7px;color:var(--dim);font-size:12px;margin-bottom:4px}\r\n.m .mf{margin-top:6px;font-size:12px;color:var(--dim)}\r\n.m.s{align-items:center;margin-bottom:14px}\r\n.m.s span{background:var(--soft);color:var(--dim);border:1px solid var(--line);border-radius:999px;padding:3px 12px;font-size:12.5px;text-align:center}\r\n.m.s.warn span{color:var(--warn)}\r\n.m .cb{position:relative;margin:8px 0;white-space:normal}\r\n.m .cb pre{background:var(--side);border:1px solid var(--line);border-radius:10px;padding:12px 14px;overflow:auto;white-space:pre;font-size:12.5px;margin:0}\r\n.m .cb .cbc{position:absolute;top:6px;right:6px;font:inherit;font-size:11.5px;color:var(--dim);background:var(--panel);border:1px solid var(--line);border-radius:6px;padding:2px 8px;cursor:pointer}\r\n.m .cb .cbc:hover{color:var(--txt)}\r\n.ch-typing{display:flex;align-items:center;gap:9px;color:var(--dim);font-size:13px;margin-bottom:18px}\r\n.ch-empty{text-align:center;color:var(--dim);margin-top:11vh;line-height:1.6}\r\n.ch-empty h3{font:500 26px var(--serif);color:var(--txt);margin-bottom:8px}\r\n.ch-empty p{max-width:520px;margin:0 auto 6px}\r\n#ch-bar{flex:none;padding:6px 0 14px}\r\n#ch-bar>*{width:min(820px,calc(100% - 44px));margin-left:auto;margin-right:auto}\r\n#ch-box{display:flex;align-items:flex-end;gap:6px;background:var(--panel);border:1px solid var(--line2);border-radius:16px;padding:8px 8px 8px 6px;box-shadow:var(--shadow);transition:border-color .15s}\r\n#ch-box:focus-within{border-color:var(--acc)}\r\n#ch-in{flex:1;border:0;background:transparent;resize:none;max-height:220px;padding:7px 6px;font:14.5px/1.5 var(--sans);outline:none}\r\n#ch-in:focus-visible{outline:none}\r\n#ch-chips{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:6px}\r\n#ch-chips:empty{display:none}\r\n#ch-chips .fc{display:inline-flex;align-items:center;gap:6px;background:var(--soft);border:1px solid var(--line);border-radius:999px;padding:2px 4px 2px 10px;font-size:12.5px}\r\n#ch-chips .fc b{font-weight:400;cursor:pointer;color:var(--dim);line-height:0;padding:3px;border-radius:50%}\r\n#ch-chips .fc b:hover{color:var(--err);background:var(--hover)}\r\n#ch-hint{color:var(--dim);font-size:11.5px;text-align:center;margin-top:7px}\r\n#ch-menu{position:fixed;z-index:200;min-width:270px;max-width:380px;max-height:60vh;overflow:auto;background:var(--panel);border:1px solid var(--line);border-radius:12px;box-shadow:var(--shadow);padding:6px}\r\n#ch-menu[hidden]{display:none}\r\n#ch-menu .mt{color:var(--dim);font-size:11px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;padding:8px 10px 4px}\r\n#ch-menu button{display:flex;align-items:center;gap:9px;width:100%;text-align:left;background:transparent;border:0;color:var(--txt);font:inherit;padding:7px 10px;border-radius:8px;cursor:pointer}\r\n#ch-menu button:hover{background:var(--hover)}\r\n#ch-menu button .tx{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\r\n#ch-menu button em{font-style:normal;color:var(--dim);font-size:11.5px}\r\n#ch-menu button em.err{color:var(--err)}\r\n#ch-menu button.on{background:var(--sel)}\r\n#ch-menu button.on::after{content:'✓';color:var(--acc)}\r\n#ch-menu .sep{height:1px;background:var(--line);margin:6px 4px}\r\nwebview.on{z-index:1}\r\n\r\n</style>\r\n<script>\r\n/* 2.6.0 — Projets à gauche, un seul chat, les comptes sont des « clés » qu'AI Hub branche et change tout seul. */\r\n(function(){try{\r\nconst CV='10.0.2';\r\nconst lbl=a=>a.p+' · '+a.n;\r\nconst P0=id=>PJ().find(p=>p.id===id)||null;\r\nconst keyOk=a=>{const s=stOf(a.id);return !s.limited&&(s.logged!==false||apiOn(a))};\r\nconst mid=()=>'m'+Date.now().toString(36)+Math.random().toString(36).slice(2,5);\r\nconst TXT0='Écris ton message… (Entrée pour envoyer, Maj+Entrée pour un retour à la ligne)';\r\n\r\n// ---------- stockage des conversations de projet (IndexedDB, local) ----------\r\nconst CDB={db:null,\r\n  open(){return this.db||(this.db=new Promise((ok,ko)=>{const r=indexedDB.open('aihub-chats',1);r.onupgradeneeded=()=>r.result.createObjectStore('chats',{keyPath:'id'});r.onsuccess=()=>ok(r.result);r.onerror=()=>ko(r.error)}))},\r\n  async tx(mode,fn){const db=await this.open();return new Promise((ok,ko)=>{const t=db.transaction('chats',mode);let r;try{r=fn(t.objectStore('chats'))}catch(x){return ko(x)}t.oncomplete=()=>ok(r&&r.result);t.onerror=()=>ko(t.error);t.onabort=()=>ko(t.error)})},\r\n  get(id){return this.tx('readonly',s=>s.get(id))},put(o){return this.tx('readwrite',s=>s.put(o))},del(id){return this.tx('readwrite',s=>s.delete(id))}};\r\nconst CH={};\r\nconst chatOf=async pid=>CH[pid]||(CH[pid]=(await CDB.get(pid).catch(()=>null))||{id:pid,msgs:[],threads:{},seen:{},key:''});\r\nconst chSave=ch=>CDB.put(JSON.parse(JSON.stringify(ch))).catch(()=>{});\r\n\r\n// ---------- état de l'interface ----------\r\nlet chatProj=null,keyRaw=false,chatInit=false,lastActive,quiet=false,drawnFor=null,wasOn=false,CUR=null,PEND=[],editP=null,MENU=null;\r\nconst DRV=new Set(),WAIT={};\r\nconst showChat=()=>!!(chatProj&&P0(chatProj)&&!setOpen&&!filesOpen&&!keyRaw);\r\n\r\n// ---------- barre latérale : projets ----------\r\nfunction renderProjs(){\r\n  const el=$('plist');if(!el)return;\r\n  const H1=PJ().map(p=>{const on=p.id===chatProj&&showChat(),run=CUR&&CUR.pid===p.id;\r\n    return `<div class=\"acc prj${on?' on':''}\" data-pid=\"${p.id}\" title=\"${esc(p.name)}\"><u class=\"pic\">${IC('folder')}</u><span class=\"pn\">${esc(p.name)}</span>${run?'<i class=\"spin\" title=\"Une clé répond\"></i>':''}<b data-pren=\"${p.id}\" title=\"Modifier le projet\">${IC('edit')}</b><b data-pdel=\"${p.id}\" title=\"Supprimer le projet\">${IC('x')}</b></div>`}).join('')\r\n    ||'<div class=\"pempty\">Aucun projet pour l\\'instant. Crée-en un : chaque projet a son propre chat.</div>';\r\n  if(el.__h!==H1){el.innerHTML=H1;el.__h=H1}\r\n  const k=$('kcount');if(k)k.textContent=accs.length||'';\r\n}\r\nfunction openProject(id){chatProj=id;keyRaw=false;setOpen=false;filesOpen=false;settings.lastProj=id;save();PEND=[];render();drawChat();setTimeout(()=>{const i=$('ch-in');if(i)i.focus()},60)}\r\n$('plist').onclick=e=>{\r\n  const rn=e.target.closest('[data-pren]'),d=e.target.closest('[data-pdel]');\r\n  if(rn)return openProjDlg(P0(rn.dataset.pren));\r\n  if(d)return delProject(d.dataset.pdel);\r\n  const r=e.target.closest('[data-pid]');if(r)openProject(r.dataset.pid)};\r\nfunction openProjDlg(p){editP=p||null;$('pdt').textContent=p?'Modifier le projet':'Nouveau projet';$('pdok').textContent=p?'Enregistrer':'Créer';\r\n  $('pdn').value=p?p.name:'';$('pdd').value=p?(p.desc||''):'';$('dlgP').showModal();$('pdn').focus()}\r\n$('pdc').onclick=()=>$('dlgP').close();\r\n$('pdok').onclick=()=>{const n=$('pdn').value.trim();if(!n)return $('pdn').focus();const d=$('pdd').value;\r\n  $('dlgP').close();\r\n  if(editP){editP.name=n;editP.desc=d;save();renderProjs();drawChat();try{drawFiles(false)}catch{}return}\r\n  const p={id:'p'+Date.now().toString(36),name:n,desc:d};PJ().push(p);save();openProject(p.id)};\r\n$('pdn').onkeydown=e=>{if(e.key==='Enter')$('pdok').click()};\r\n$('newproj').onclick=()=>openProjDlg();$('newproj2').onclick=()=>openProjDlg();\r\nasync function delProject(id){const p=P0(id);if(!p)return;\r\n  if(CUR&&CUR.pid===id)return toast('Une réponse est en cours dans ce projet : clique d\\'abord sur Arrêter.');\r\n  if(!confirm(`Supprimer le projet « ${p.name} » et sa conversation ? Ses fichiers restent dans la bibliothèque (sans projet).`))return;\r\n  for(const f of FILES.filter(x=>x.proj===id))try{await FDB.put({...f,proj:''})}catch{}\r\n  settings.projects=PJ().filter(x=>x.id!==id);delete CH[id];await CDB.del(id).catch(()=>{});\r\n  if(chatProj===id){chatProj=(PJ()[0]||{}).id||null;settings.lastProj=chatProj;drawnFor=null}\r\n  save();try{await loadFiles(false)}catch{}render();drawChat()}\r\n\r\n// ---------- zone « Clés » repliable ----------\r\n(function(){const box=$('keysbox'),set=m=>{box.classList.toggle('min',m);$('keystog').setAttribute('aria-expanded',String(!m));try{localStorage.keysmin=m?'1':''}catch{}};\r\n  set(!!localStorage.keysmin);$('keystog').onclick=()=>set(!box.classList.contains('min'))})();\r\n\r\n// ---------- affichage du chat ----------\r\ndocument.addEventListener('click',e=>{const b=e.target.closest&&e.target.closest('[data-more]');if(!b)return;const bx=$('ch-msgs');bx.__full=chatProj;bx.__sg='';drawMsgs(false)});\nfunction md(t){let h=esc(t);\r\n  h=h.replace(/```[\\w+-]*\\n?([\\s\\S]*?)```/g,(m,c)=>`<div class=\"cb\"><button class=\"cbc\" data-cc type=\"button\">Copier</button><pre>${c.replace(/\\n$/,'')}</pre></div>`);\r\n  return h.replace(/`([^`\\n]+)`/g,'<code>$1</code>').replace(/\\*\\*([^*\\n]+)\\*\\*/g,'<b>$1</b>')}\r\nfunction drawKeyChip(){const b=$('ch-key'),p=P0(chatProj);if(!b||!p)return;\r\n  const ch=CH[p.id],cur=find(p.pin)||find(ch&&ch.key)||null;\r\n  if(!accs.length){b.innerHTML=IC('lock')+'<span class=\"kl\">Aucune clé : ajoutes-en une</span>';b.className='btn bad';return}\r\n  if(!cur)b.innerHTML=IC('swap')+'<span class=\"kl\">Clé : automatique'+(p.only?' · '+esc(p.only)+' seul':'')+'</span>';\r\n  else{const s=stOf(cur.id);b.innerHTML=`<i class=\"dot\" style=\"background:${P[cur.p][1]}\"></i><span class=\"kl\">${esc(lbl(cur))}</span><span class=\"ks\">${p.pin?'fixée':'auto'+routeBadge(ch)}${s.limited?' · limite':''}</span>`}\r\n  b.className='btn'+(accs.some(keyOk)?'':' bad')}\r\nfunction msgHtml(m,i,arr){\r\n  if(m.r==='user')return `<div class=\"m u\"><div class=\"b\">${md(m.t)}</div>${m.fids&&m.fids.length?fcards(m.fids):(m.files&&m.files.length?`<div class=\"mf\">${IC('clip')} ${esc(m.files.join(', '))}</div>`:'')}${msgAct(m,m.id)}</div>`;\r\n  if(m.r==='ai'){const k=m.k||{},c=P[k.p]?P[k.p][1]:'var(--dim)';\r\n    return `<div class=\"m a\"><div class=\"mk\"><i class=\"dot\" style=\"background:${c}\"></i>${esc(k.p?k.p+' · '+k.n:'IA')}</div>${stepsHtml(m.steps)}${m.t?`<div class=\"b\">${md(m.t)}</div>`:''}${actsHtml(m.acts,m)}${fcards(m.fids)}${msgAct(m,arr&&i===lastAiIdx(arr)?prevUserId(arr,i):'')}</div>`}\r\n  if(m.diffAsk)return diffAskHtml(m);\r\n  if(m.det)return `<div class=\"m s\"><details class=\"sysd\"${m.open?' open':''}><summary><span>${esc(m.t)}</span></summary><pre>${esc(m.det)}</pre></details></div>`;\r\n  return `<div class=\"m s${m.warn?' warn':''}\"><span>${esc(m.t)}</span></div>`}\r\nfunction drawMsgs(stick){const ch=CH[chatProj];if(!ch)return;const box=$('ch-msgs');\r\n  const run0=!!(CUR&&CUR.pid===ch.id);   // 10.0.16 : rien n'a changé = pas de redessin (retour au chat instantané)\r\n  if(!run0){const sg=ch.id+(box.__full===ch.id?'F':'')+'|'+accs.length+'|'+accs.filter(keyOk).length+'|'+ch.msgs.map(m=>(m.id||'')+':'+String(m.t||'').length+(m.undone?'u':'')+((m.acts||[]).length)+'.'+((m.chg||[]).length)+'.'+(m.tok||0)+'.'+((m.fids||[]).length)+'.'+(m.rd||0)).join(',');\r\n    if(box.__sg===sg&&box.firstElementChild){if(stick)box.scrollTop=box.scrollHeight;return}box.__sg=sg}else box.__sg='';\r\n  const near=box.scrollHeight-box.scrollTop-box.clientHeight<140;\r\n  const k=CUR&&CUR.pid===ch.id?find(CUR.key):null;\r\n  const st0=box.__full===ch.id?0:Math.max(0,ch.msgs.length-40);\n  let h=(st0>0?'<div class=\"ch-more\" style=\"text-align:center;padding:8px\"><button class=\"btn ghost\" type=\"button\" data-more>Afficher les '+st0+' messages précédents</button></div>':'')+ch.msgs.map((m,i,a)=>i<st0?'':msgHtml(m,i,a)).join('');\r\n  if(CUR&&CUR.pid===ch.id)h+=liveHtml(k);\r\n  if(!ch.msgs.length&&!CUR){const ok=accs.filter(keyOk).length;\r\n    h=`<div class=\"ch-empty\"><h3>${esc((P0(chatProj)||{}).name||'')}</h3><p>${accs.length?`Écris ton premier message ci-dessous. AI Hub l'envoie avec une de tes clés (${ok} prête${ok>1?'s':''} sur ${accs.length}) et en change tout seul si une limite est atteinte.`:'Ajoute d\\'abord une clé (un compte IA) dans la zone « Clés » à gauche : une fois connectée, elle sert à tous tes projets.'}</p></div>`}\r\n  box.innerHTML=h;if(stick||near)box.scrollTop=box.scrollHeight;\r\n  try{if(!ch.msgs.length&&!CUR)u5Home(ch.id)}catch{}}\r\n// R7 (5.2) : accueil de projet : état, clés, plan, derniers tours, trois actions (ids du contrat inchangés)\r\nasync function u5Home(pid){const p=P0(pid),box=$('ch-msgs');if(!p||!box)return;const el=box.querySelector('.ch-empty');if(!el)return;\r\n  const loc=modeOf(p)==='local'&&p.local,ok=accs.filter(keyOk).length;\r\n  let st={};if(loc&&window.api&&api.localState){try{const g=await api.localState({root:p.local.path,op:'get'});st=(g&&g.st)||{}}catch{}}\r\n  if(chatProj!==pid||!box.contains(el)||el.querySelector('.u5h'))return;\r\n  const rounds=(st.rounds||[]).slice(-3).reverse(),plan=st.plan?String(st.plan).slice(0,160):'';\r\n  const card=(t,b)=>`<div class=\"u5h-c\"><small>${t}</small><div>${b}</div></div>`;\r\n  const cards=card('État',loc?'Local · '+esc(p.local.name):'En ligne')+card('Clés',ok+' prête'+(ok>1?'s':'')+' sur '+accs.length)\r\n    +(plan?card('Plan en cours',esc(plan)):'')\r\n    +(rounds.length?card('Derniers tours',rounds.map(r=>esc((r.talk||((r.acts||[])[0]||{}).t||'tour').slice(0,60))).join('<br>')):'');\r\n  el.insertAdjacentHTML('beforeend',`<div class=\"u5h\">${cards}</div><div class=\"u5h-a\"><button type=\"button\" class=\"btn pri\" data-u5h=\"msg\">Écrire un message</button><button type=\"button\" class=\"btn\" data-u5h=\"files\">Fichiers</button></div>`)}\r\ndocument.addEventListener('click',e=>{const b=e.target.closest('[data-u5h]');if(!b)return;const a=b.dataset.u5h;\r\n  if(a==='msg'){const i=$('ch-in');i&&i.focus()}else if(a==='files'){const f=$('filesbtn');f&&f.click()}});\r\nfunction lastTok(ch){let l=0,t=0;for(const m of (ch.msgs||[])){if(m&&m.tok){l=m.tok;t+=m.tok+(m.to||0)}}return l?'<span class=\"sp\" title=\"Tokens envoyés au dernier tour / total de la conversation (estimation)\">≈ '+l+' tok · Σ '+t+'</span>':''}\r\nfunction drawStat(){const el=$('ch-stat'),p=P0(chatProj);if(!el||!p)return;const ch=CH[p.id]||{},loc=modeOf(p)==='local',run=!!CUR&&CUR.pid===p.id,k=find(ch.key),s=k?stOf(k.id):{};\r\n  let tk=ch.tk||'';if(run&&CUR.tasks){const m=CUR.tasks.match(/TÂCHES (\\d+)\\/(\\d+)/);if(m){tk=m[1]+'/'+m[2];ch.tk=tk}}\r\n  const pill=(c,t,tt)=>`<span class=\"sp ${c}\" title=\"${esc(tt||'')}\">${esc(t)}</span>`;\r\n  el.innerHTML=pill('',loc?'Local'+(p.local?' · '+p.local.name:' · choisir un dossier'):'En ligne',loc&&p.local?p.local.path:'Mode du chat : en ligne ou local')\r\n   +pill(s.limited?'warn':'',k?lbl(k)+(s.limited?' · en limite'+(s.until?' jusqu\\'à '+hm(s.until):''):''):'Clé : automatique','Compte IA utilisé pour ce chat')\r\n   +(tk?`<span class=\"sp\" data-tkp style=\"cursor:pointer\" title=\"Cliquer : liste des tâches (cocher, pause)\">Tâches ${esc(tk)}${run&&CUR.pause?' · pause':''}</span>`:'')\r\n   +lastTok(ch)+(()=>{try{const e=settings.ctxAuto!==false&&modeOf(p)==='local'&&window.hub380&&hub380.edCtx&&hub380.edCtx();return e?pill('','📄 '+e.rel.split('/').pop()+(e.sel?' · sélection':''),'Fichier ouvert envoyé avec ton message (/ctx-auto off pour couper)'):''}catch{return ''}})()+pill(run?'run':'ok',run?actText():'Prêt',run?'Ce que fait l\\'IA en ce moment':'Rien en cours')}\r\nsetInterval(()=>{if(document.hidden||!showChat())return;try{drawStat()}catch{}},1000);\r\nasync function drawChat(){const p=P0(chatProj);if(!p)return;drawnFor=p.id;\r\n  await chatOf(p.id);if(chatProj!==p.id)return;\r\n  $('ch-name').textContent=p.name;$('ch-desc').textContent=(p.desc||'').replace(/\\s+/g,' ').trim();\r\n  drawMsgs(true);drawChips();setBusy();try{drawModeChip()}catch{}{const i0=$('ch-in'),dv=DRAFTS[p.id]!==undefined?DRAFTS[p.id]:((CH[p.id]&&CH[p.id].draft)||'');if(i0&&i0.value!==dv){i0.value=dv;autoGrow()}}try{window.hub380&&hub380.sync()}catch{}}\r\nfunction drawChips(){const el=$('ch-chips');if(!el)return;\r\n  el.innerHTML=PEND.map(id=>{const f=FILES.find(x=>x.id===id);return f?`<span class=\"fc\">${esc(f.name)}<b data-rmf=\"${id}\" title=\"Retirer\">${IC('x')}</b></span>`:''}).join('')}\r\n$('ch-chips').onclick=e=>{const b=e.target.closest('[data-rmf]');if(b){PEND=PEND.filter(x=>x!==b.dataset.rmf);drawChips()}};\r\nfunction setBusy(){const run=!!CUR,here=run&&CUR.pid===chatProj;\r\n  $('ch-send').hidden=false;$('ch-send').textContent=run?'Mettre en file':'Envoyer';$('ch-stop').hidden=!here;\r\n  $('ch-in').placeholder=run?'Écris ton message : il partira à la fin de la réponse en cours…':TXT0;try{drawQueue()}catch{}\r\n  renderProjs();if(chatProj)drawKeyChip();if(chatProj&&CH[chatProj])drawMsgs(false)}\r\nfunction autoGrow(){const i=$('ch-in');i.style.height='auto';i.style.height=Math.min(220,i.scrollHeight)+'px'}\r\n$('ch-in').addEventListener('input',()=>{autoGrow();const pid=chatProj;if(!pid)return;DRAFTS[pid]=$('ch-in').value;clearTimeout(DRAFTS._t);DRAFTS._t=setTimeout(()=>{const c0=CH[pid];if(c0){c0.draft=DRAFTS[pid];chSave(c0)}},900)});\r\n$('ch-in').addEventListener('keydown',e=>{if(typeof slKey==='function'&&slKey(e))return;if(e.key==='Enter'&&!e.shiftKey&&!e.isComposing){e.preventDefault();chatSend()}});\r\n// 2.6.2 : Ctrl+V colle une capture d'écran (ou toute image du presse-papiers) dans la barre de chat\r\n$('ch-in').addEventListener('paste',async e=>{\r\n  const cd=e.clipboardData;let items=[];try{for(const i of [...((cd&&cd.items)||[])]){if(i.kind==='file'&&/^image\\//.test(i.type)){const f0=i.getAsFile();if(f0)items.push(f0)}}if(!items.length&&cd&&cd.files)items=[...cd.files].filter(f=>/^image\\//.test(f.type))}catch{}\r\n  if(!items.length)return;e.preventDefault();\r\n  const d=new Date(),pad=x=>String(x).padStart(2,'0'),stamp=`${d.getFullYear()}${pad(d.getMonth()+1)}${pad(d.getDate())}-${pad(d.getHours())}${pad(d.getMinutes())}${pad(d.getSeconds())}`;\r\n  let n=0;\r\n  for(const it of items){const b=it;if(!b)continue;\r\n    const ext=((b.type.split('/')[1]||'png').replace('jpeg','jpg').replace(/[^a-z0-9]/g,''))||'png';\r\n    const id='f'+Date.now().toString(36)+Math.random().toString(36).slice(2,6);\r\n    try{await FDB.put({id,name:`capture-${stamp}${items.length>1?'-'+(n+1):''}.${ext}`,type:b.type,size:b.size,added:Date.now(),proj:chatProj||'',dir:'sent',tags:['capture'],blob:b});PEND.push(id);n++}catch{}}\r\n  if(!n)return toast('Impossible de coller l\\'image');\r\n  await loadFiles(false);drawChips();toast(n>1?n+' images collées':'Image collée')});\r\n$('ch-send').onclick=()=>chatSend();\r\n$('ch-msgs').addEventListener('click',async e=>{const c=e.target.closest('[data-cc]');if(!c)return;\r\n  const t=c.parentElement.querySelector('pre').textContent;await api.copy(t);c.textContent='Copié';setTimeout(()=>c.textContent='Copier',1400)});\r\n\r\n// ---------- menus (clé du projet, fichiers à joindre) ----------\r\nfunction showMenu(btn,html,fn){const m=$('ch-menu');m.innerHTML=html;MENU={fn,btn};m.hidden=false;\r\n  const sa=(screen.availTop||0)+screen.availHeight-(window.screenY||0)-Math.max(0,window.outerHeight-window.innerHeight),vb=Math.max(240,Math.min(innerHeight,sa));\r\n  m.style.maxHeight=Math.max(160,Math.min(vb*.6,vb-24))+'px';\r\n  const r=btn.getBoundingClientRect(),w=m.offsetWidth,h=m.offsetHeight;\r\n  m.style.left=Math.max(12,Math.min(r.right-w,innerWidth-w-12))+'px';\r\n  m.style.top=(r.bottom+6+h>vb-12?Math.max(12,r.top-h-6):r.bottom+6)+'px'}\r\nconst closeMenu=()=>{$('ch-menu').hidden=true;MENU=null};\r\n$('ch-menu').addEventListener('click',e=>{if(MENU)MENU.fn(e)});\r\ndocument.addEventListener('mousedown',e=>{if(!e.target.closest('#ch-menu')&&!e.target.closest('#ch-key')&&!e.target.closest('#ch-att')&&!e.target.closest('#ch-mode'))closeMenu()});\r\ndocument.addEventListener('keydown',e=>{if(e.key==='Escape')closeMenu()});\r\nfunction keyMenu(btn){const p=P0(chatProj);if(!p)return;const cur=CH[p.id]&&CH[p.id].key;\r\n  const rows=accs.filter(a=>!p.only||a.p===p.only).map(a=>{const s=stOf(a.id);\r\n    return `<button data-pin=\"${a.id}\" class=\"${p.pin===a.id?'on':''}\"><i class=\"dot\" style=\"background:${P[a.p][1]}\"></i><span class=\"tx\">${esc(lbl(a))}</span>${s.limited?'<em class=\"err\">limite</em>':s.logged===false?'<em class=\"err\">déconnectée</em>':cur===a.id?'<em>branchée</em>':''}</button>`}).join('');\r\n  showMenu(btn,`<div class=\"mt\">Clé de ce projet${p.only?' · '+esc(p.only)+' seul':''}</div><button data-route=\"smart\" class=\"${!p.pin&&routeOn()?'on':''}\"><span class=\"tx\">Automatique · meilleure IA selon la tâche</span><em>code → Claude…</em></button><button data-route=\"simple\" class=\"${!p.pin&&!routeOn()?'on':''}\"><span class=\"tx\">Automatique simple</span><em>change seule</em></button><button data-act=\"routecfg\"><span class=\"tx\">Régler les notes par tâche…</span></button>${rows}<div class=\"sep\"></div><button data-act=\"keys\"><span class=\"tx\">Gérer les clés…</span></button>`,e=>{\r\n    const b=e.target.closest('button');if(!b)return;\r\n    if(b.dataset.route!==undefined){setRoute(b.dataset.route,p);closeMenu();return}if(b.dataset.act==='routecfg'){closeMenu();routeCfg();return}if(b.dataset.act==='keys'){closeMenu();$('keysbox').classList.remove('min');return}\r\n    if(b.dataset.pin!==undefined){p.pin=b.dataset.pin;save();closeMenu();drawKeyChip()}})}\r\n$('ch-key').onclick=e=>{if($('ch-menu').hidden||!MENU||MENU.btn!==e.currentTarget)keyMenu(e.currentTarget);else closeMenu()};\r\n// ================= 2.8.0 : mode En ligne / Local, brouillons, actions de message =================\r\nconst DRAFTS={};\r\nconst HINT0=($('ch-hint')||{}).textContent||'';\r\nconst modeOf=p=>p&&p.mode==='local'?'local':'online';\r\n// ================= 3.0.0 : moteur local complet =================\r\n// L'IA reçoit des demandes minuscules et répond par des lignes « @verbe ». AI Hub les exécute dans le dossier du projet\r\n// (côté main-core.js, enfermé dans ce dossier). Lecture automatique, écriture avec sauvegarde, commandes avec confirmation.\r\nconst LV='[AI HUB LOCAL v2]',L_READ={tree:1,read:1,outline:1,find:1,grep:1,stat:1,ctx:1,refs:1,history:1,diff:1},L_WRITE={write:1,edit:1,append:1,replace:1,mkdir:1,move:1,copy:1,scaffold:1},L_NET={web:1,search:1,open:1},\r\n  L_ALL={tree:1,read:1,outline:1,find:1,grep:1,stat:1,write:1,edit:1,append:1,replace:1,mkdir:1,move:1,copy:1,delete:1,undo:1,run:1,script:1,open:1,web:1,search:1,task:1,build:1,ctx:1,refs:1,history:1,diff:1,test:1,scaffold:1,tool:1},\r\n  L_LIST='tree outline read find grep stat write edit append replace mkdir move copy delete undo run script open web search task build test scaffold ctx refs history diff tool note plan ask need done',\r\n  L_MODIFY=/^(write|edit|append|replace|mkdir|move|copy|delete|run|script|scaffold)$/;\r\nconst isDry=a=>a&&a.verb==='replace'&&/(^|\\s)-n(\\s|$)/.test(a.arg||'');   // @replace -n : simple aperçu, rien n'est écrit\r\nfunction localCard(plat){const small=(PLIM[plat]||30000)<=10000;\r\n  if(small)return LV+\" Dossier du PC, uniquement par lignes @ (UN seul bloc de code ```, 12 max, une phrase hors bloc). @tree @outline ch (plan du fichier) @read ch [a-b | fn:nom] (ou plusieurs fichiers d'un coup) @find motif @grep txt [ch] [-l] [-C2] @stat ch @ctx question (blocs par sens) @refs symbole @history ch @diff [ch] (changements git) @test [cmd] (détecte et lance les tests) @scaffold node|python|html|mc-fabric|mc-forge [nom] @task next · @write/@append ch + <<< texte >>> · @edit ch + <<< CHERCHE ancien REMPLACE nouveau >>> (ou @edit ch lignes 12-18 + <<< nouveau texte >>>) · @replace [dossier] + <<< CHERCHE ancien REMPLACE nouveau >>> (même changement dans TOUS les fichiers ; -w mot entier, -n aperçu) · @mkdir @move src dst @copy src dst @delete ch · @undo · @run cmd · @script node|python|powershell <<< code >>> · @open @web url @search txt · @note texte @plan étapes restantes @ask @need @done résumé. Chemins relatifs sans « .. ». ÉCONOMIE : chaque réponse coûte un crédit à l'utilisateur : groupe tes instructions, lis avec @outline puis @read a-b (jamais un gros fichier en entier) et mets @done dans la MÊME réponse que tes modifications si tu es sûr (AI Hub contrôle la syntaxe : si ✕, @done est ignoré et l'erreur te revient). « déjà lu, inchangé » = réutilise ta lecture précédente. Le message peut contenir CARTE (fichiers principaux) et PRÉ-LECTURE (extraits déjà lus : ne les relis pas). AI Hub contrôle la syntaxe après chaque @write/@edit/@append/@replace (ligne VÉRIF dans RESULTATS : corrige tout de suite).\";\r\n  return LV+\" Tu travailles dans un dossier du PC de l'utilisateur, uniquement par instructions. Réponds par des lignes @ (une par ligne, TOUTES dans UN SEUL bloc de code ```, sinon le site abîme les * et _) ; hors du bloc, une phrase d'explication au maximum. 16 instructions max par réponse, exécutées dans l'ordre : la première erreur arrête la suite (sauf entre lectures : une lecture qui échoue n'empêche pas les autres), et les résultats te reviennent.\\n\"\r\n   +\"VOIR : @tree [chemin] [profondeur] · @outline chemin (plan du fichier : fonctions, classes, titres avec leur n° de ligne) · @read [-n numéros de ligne] chemin [début-fin | fn:nom] (fn:nom = seulement cette fonction, classe ou section ; plusieurs fichiers d'un coup : @read a.js b.js:10-40 c.js#nom) · @find motif (ex. *.js) [-m récents d'abord] [-n 150] · @grep texte [chemin] [-r regex] [-s casse exacte] [-w mot entier] [-l fichiers seulement] [-A2 lignes après] [-B1 lignes avant] [-C5 lignes autour, jusqu'à 12] [-g *.js] · @stat chemin [chemin2 …] (taille, lignes, date) · @ctx question (blocs pertinents trouvés par sens, 0 crédit en plus) · @refs symbole (définition + usages) · @history chemin (commits git) · @diff [chemin] (changements git non commités) · @test [commande | fichier de test] (détecte et lance les tests, 300 s) · @scaffold node|python|html|mc-fabric|mc-forge [nom] (squelette de projet) · @task add (ligne [après:3,4] [p1]) / @task next (prochaine tâche prête)\\n\"\r\n   +\"CHANGER : @write chemin · @append chemin · @edit chemin · @replace [chemin] [*.js] · @mkdir chemin · @move source cible · @copy source cible · @delete chemin · @undo [n]\\n\"\r\n   +\"  @write, @append et @edit reçoivent leur texte sur les lignes suivantes, entre une ligne <<< et une ligne >>>. @edit : une ligne CHERCHE, le texte exact à trouver (il doit être unique dans le fichier), une ligne REMPLACE, le nouveau texte ; plusieurs paires possibles. Pour modifier un fichier qui existe, préfère @edit à @write. Autre forme : @edit chemin lignes 12-18 puis, entre <<< et >>>, le nouveau texte qui remplace ces lignes (après les avoir lues avec @read ; vide = supprimer les lignes). Si le fichier a changé depuis ta dernière lecture, AI Hub refuse : relis-le.\\n\"\r\n   +\"  @replace applique le MÊME CHERCHE/REMPLACE (texte exact, plusieurs paires possibles, entre <<< et >>>) dans TOUS les fichiers du dossier (ou du chemin / motif donné) en UNE instruction : renommer une fonction, une variable, une classe ou une URL partout = un seul @replace. -w = mot entier seulement (indispensable pour un nom court), -n = aperçu sans rien écrire (nombre de remplacements par fichier). Les fichiers protégés sont ignorés.\\n\"\r\n   +\"FAIRE : @run commande (npm, git, python… tout ce que le PC sait faire ; jamais de programme qui ne s'arrête pas, 60 s max) · @script node|python|powershell puis le code entre <<< et >>> (exécuté dans le dossier du projet) · @tool list|search mot|new nom node|python|powershell [description] (code entre <<< et >>>)|run nom args|help nom|delete nom|pkg npm|pip nom (outils persistants de l'IA, paquets npm/pip) · @open chemin|url · @web url · @search texte\\n\"\r\n   +\"COMMUNIQUER : @note texte (fait durable à retenir sur le projet) · @plan étapes restantes (remplace le plan précédent ; mets-le à jour à chaque tour : si un autre compte te remplace, il continue depuis ce plan) · @ask question · @need ce qui te manque (quand aucune instruction ne le permet) · @done résumé en 1 à 3 lignes\\n\"\r\n   +\"GROS PROJET (mod complet, jeu, application de dizaines de fichiers) : ne fais jamais tout d'un coup. 1) Au tout premier tour, écris l'architecture dans un fichier PLAN.md (modules, noms, conventions, API) puis découpe en 15 à 60 tâches courtes avec @task add (une tâche par ligne entre <<< et >>>, dans l'ordre logique, une tâche = un fichier ou un module précis). 2) Ensuite, à chaque tour : @task start N, écris les fichiers de cette tâche (plusieurs tâches proches dans le même tour si elles sont petites), vérifie (@run), @task done N résumé d'une ligne. 3) Les TÂCHES sont partagées entre toutes les clés : si une limite est atteinte, un autre compte te remplace et reprend à la prochaine tâche [ ]. Ne refais jamais une tâche [x]. 4) Les conventions (noms de classes, packages, identifiants) vont dans PLAN.md et dans @note pour rester cohérent d'un compte à l'autre. 5) @task list pour l'avancement, @task block N raison si une tâche est impossible. 6) Fichier de plus de 300 lignes : @write les 300 premières lignes puis @append par morceaux (une instruction par morceau, 60 Ko maximum chacune).\\n\"\r\n   +\"ÉCONOMIE (chaque réponse que tu envoies consomme un crédit de l'utilisateur : fais-en le moins possible) : 1) Mets un maximum d'instructions dans UNE réponse : lectures, modifications ET vérification ensemble. 2) Ne lis jamais un gros fichier en entier : @outline puis @read chemin début-fin ou fn:nom, ou @grep. 3) Quand ta modification est simple et sûre, termine par @done dans la MÊME réponse que @edit/@write/@replace : AI Hub contrôle la syntaxe, et si une vérification ou une commande échoue, @done est ignoré et l'erreur te revient. 4) « déjà lu, inchangé » = le fichier n'a pas bougé : réutilise ta lecture précédente (@read -f chemin pour la recevoir de nouveau). 5) Pas de bavardage ni de récapitulatif hors du bloc.\\n\"\r\n   +\"Chemins relatifs au dossier, jamais de « .. ». Ne demande jamais un fichier à l'avance : lis-le avec @read (sauf si PRÉ-LECTURE le contient déjà). CARTE = fichiers principaux du projet avec leur rôle. Après chaque @write/@edit/@append/@replace, AI Hub contrôle la syntaxe (JSON, JS, Python, HTML) : une ligne VÉRIF ✕ dans RESULTATS veut dire qu'il faut corriger ce fichier avant tout le reste. Après une modification, vérifie si possible (@run test) dans la MÊME réponse, puis @done.\\n\"\r\n   +\"Exemple :\\n```\\n@outline src/app.js\\n@read src/app.js fn:startServer\\n```\\nPuis, dès que tu as ce qu'il faut, tout dans UNE réponse :\\n```\\n@edit src/app.js\\n<<<\\nCHERCHE\\nconst port = 3000;\\nREMPLACE\\nconst port = 8080;\\n>>>\\n@run npm test\\n@note API Node, point d'entrée src/app.js, port 8080\\n@done Port changé en 8080, les tests passent.\\n```\"}\r\nfunction parseActs(txt){const L=String(txt||'').replace(/\\r/g,'').split('\\n'),acts=[],talk=[];\r\n  for(let i=0;i<L.length;i++){const l=L[i];if(/^\\s*```/.test(l))continue;\r\n    const m=l.match(/^\\s*@([a-zA-Z]+)\\b[ \\t]*(.*)$/);if(!m){const tl=l.trim();if(NZ_CMD.test(tl)||NZ_TIME.test(tl)||(tl&&/^[\\s\\u200b-\\u200f\\u2028-\\u202f\\u2060-\\u206f\\u25a0-\\u25ff\\ue000-\\uf8ff\\ufffd\\u2190-\\u21ff\\ufe00-\\ufe0f]+$/.test(tl)))continue;talk.push(l.replace(/[\\ue000-\\uf8ff\\ufffd]/g,''));continue}\r\n    const a={verb:m[1].toLowerCase(),arg:m[2].trim(),body:'',hasBody:false};let j=i+1,open=false;\r\n    if(/\\s*<<<\\s*$/.test(a.arg)){a.arg=a.arg.replace(/\\s*<<<\\s*$/,'');open=true;j=i}      // « @write fichier <<< » sur une seule ligne\r\n    else if(L[j]!==undefined&&/^\\s*<<<\\s*$/.test(L[j]))open=true;\r\n    if(open){const b=[];let closed=false;for(j=j+1;j<L.length;j++){if(/^\\s*>>>\\s*$/.test(L[j])){closed=true;break}b.push(L[j])}\r\n      if(!closed){while(b.length&&/^\\s*```\\s*$/.test(b[b.length-1]))b.pop();a.bad='bloc <<< sans >>> de fin (réponse coupée ?) : seule « @'+a.verb+' '+a.arg.slice(0,60)+' » n\\'a PAS été exécutée (les instructions d\\'avant, sans erreur, l\\'ont été) : renvoie UNIQUEMENT cette instruction, complète, avec son >>> de fin'}\r\n      a.body=b.join('\\n');a.hasBody=true;i=Math.min(j,L.length)}\r\n    acts.push(a)}\r\n  return {acts:acts.slice(0,30),extra:Math.max(0,acts.length-30),talk:talk.join('\\n').replace(/\\n{3,}/g,'\\n\\n').trim()}}\r\nconst actTitle=a=>{const n=a.hasBody?String(a.body||'').split('\\n').length:0,s=String(a.arg||'').split('\\n')[0].slice(0,70);return a.verb+(s?' '+s:'')+(a.hasBody&&!/^(edit|plan|note)$/.test(a.verb)?' ('+n+' lignes)':'')};\r\nconst liveBody=raw=>{raw=String(raw||'').replace(/^[ \\t]*@[a-zA-Z]{0,12}[ \\t]*$(?![\\s\\S]*\\n)/m,'');                      // ligne @ coupée en plein flux : jamais affichée brute\r\n  if(!/^\\s*(?:[-*•>]+\\s+|\\d+[.)]\\s+)?(?:\\*\\*|__|`)?\\s*@\\s?[a-z]/mi.test(raw))return md(raw.replace(/\\n```[\\w-]*\\s*$/,''));\r\n  let q=parseActs(raw);if(!q.acts.length&&typeof fixAts==='function')q=parseActs(fixAts(raw));\r\n  if(!q.acts.length)return md(raw.replace(/\\n```[\\w-]*\\s*$/,''));\r\n  const last=q.acts.length-1;\r\n  return (q.talk?md(q.talk):'')+'<div class=\"lacts\">'+q.acts.map((a,i)=>`<div class=\"la ${i===last&&!a.bad?'run':'ok'}\"><i>${i===last&&!a.bad?'…':'›'}</i><span>${esc(actTitle(a))}</span></div>`).join('')+'</div>'};\r\nconst capMid=(t,n)=>t.length<=n?t:t.slice(0,Math.floor(n*.55))+'\\n[… '+(t.length-n)+' caractères omis …]\\n'+t.slice(-Math.floor(n*.45));\r\nconst memoAdd=(old,t)=>{t=String(t||'').replace(/\\s+/g,' ').trim().slice(0,600);if(!t)return old||'';let m=(old?old+' | ':'')+t;if(m.length>1400){m=m.slice(-1400);const k=m.indexOf(' | ');if(k>=0&&k<300)m=m.slice(k+3)}return m};\r\nconst actsHtml=(a,m)=>{if(!a||!a.length)return '';\r\n  const rows=a.map(x=>{const mk=`<i>${x.ok?'✔':'✕'}</i><span>${esc(x.t)}</span>`;\r\n    const row=x.d?`<details class=\"la ${x.ok?'ok':'err'}\"><summary>${mk}</summary><pre>${esc(x.d)}</pre></details>`:`<div class=\"la ${x.ok?'ok':'err'}\">${mk}</div>`;\r\n    const df=x.df&&(x.df.d||x.df.a||x.df.r)?`<details class=\"ldfd\"><summary>Voir le diff ${dfSum(x.df)}</summary><pre class=\"ldf\">${dfHtml(x.df.d)}</pre></details>`:'';\r\n    return row+df}).join('');\r\n  let foot='';if(m&&m.turn&&m.chg&&m.chg.length){foot=`<div class=\"lchg\"><span>${m.chg.length} élément${m.chg.length>1?'s':''} touché${m.chg.length>1?'s':''} : ${esc(m.chg.slice(0,4).join(', '))}${m.chg.length>4?'…':''}</span>${m.undone?'<em>annulé</em>':`<button type=\"button\" class=\"lund\" data-lchg=\"${esc(m.id)}\">Changements</button><button type=\"button\" class=\"lund\" data-lun=\"${esc(m.id)}\">Annuler ce tour</button>`}</div>`}\r\n  const tk=m&&m.tok?`<div class=\"ltok\">≈ ${m.tok} tokens envoyés${m.to?' + ≈ '+m.to+' reçus':''} pour ce tour${m.rd?' · réponse n°'+m.rd+' de la demande ('+m.rd+' crédit'+(m.rd>1?'s':'')+' jusqu\\'ici)':''}${m.sv?` · ≈ ${m.sv} évités (déjà lu, sorties compactées)`:''}</div>`:'';\r\n  return `<div class=\"lacts\">${rows}${foot}${tk}</div>`};\r\n// ---- réglages et autorisations du dossier (gardés dans AI Hub, pas dans le dossier : l'IA ne peut pas les changer) ----\r\nconst lcfg=p=>{const c=p.local.cfg=p.local.cfg||{},d={trust:false,askWrite:false,autoGit:true,verify:true,forbid:'',eco:false,timeout:60,ignore:'',allow:[],net:{}};for(const k in d)if(c[k]===undefined)c[k]=d[k];if(!c.net)c.net={};if(!Array.isArray(c.allow))c.allow=[];return c};\r\nconst lIgnore=c=>String(c.ignore||'').split(/[\\s,;]+/).filter(Boolean);\r\nconst L_META=/[&|;<>`$\\n\\r()]/;\r\nconst L_WHITE=[/^npm (test|run test|run lint|ls|ls --depth=\\d)$/i,/^npm (-v|--version)$/i,/^git (status|log|diff)( (--?[a-z][\\w-]*|[\\w.\\/@~^-]+))*$/i,/^git branch$/i,/^(node|python|python3|py|pip|git|npm|npx) (-V|-v|--version)$/i];\r\nconst L_DANGER=/\\b(rm\\s+-[a-z]*[rf][a-z]*\\b|rmdir\\s+\\/s|del\\s+(\\/[a-z]\\s+)*\\/[sq]|rd\\s+\\/s|format\\s+[a-z]:|mkfs|dd\\s+if=|shutdown|reboot|diskpart|reg\\s+delete|sudo\\b|chmod\\s+-R|git\\s+push\\b[^\\n]*--force|git\\s+push\\b[^\\n]*\\s-f\\b|git\\s+reset\\s+--hard|git\\s+clean|Remove-Item[^\\n]*-Recurse|Invoke-Expression|\\biex\\b|net\\s+user|takeown|icacls|cipher\\s+\\/w|(curl|wget)\\b[^\\n|]*\\|\\s*(sh|bash|zsh|powershell|pwsh)|:\\(\\)\\s*\\{|shutil\\.rmtree|rmSync\\([^)]*recursive)/i;\r\nconst lNorm=s=>String(s||'').trim().replace(/\\s+/g,' ');\r\n// ---- 3.7.0 : réparation des lignes @ abîmées par le site, mots d'action, fichiers protégés, affichage des diffs ----\r\nconst L_ACTION=/(modifi|corrig|ajout|cré|cree|supprim|chang|renomm|écri|ecri|implément|implement|remplac|retir|enlèv|enlev|déplac|deplac|refactor|install|lance|exécut|execut|\\bfix|creat|\\badd\\b|remov|delet|updat|\\bedit|\\bwrit|renam|replac|rewrit)/i;\r\nconst fixAts=raw=>String(raw||'').split('\\n').map(l=>{const m=l.replace(/\\\\@/g,'@'),k=/^\\s*(?:[-*•>]+\\s+|\\d+[.)]\\s+)?(?:\\*\\*|__|`)?\\s*@\\s?([a-zA-Z]+)\\b(.*)$/.exec(m);\r\n  if(!k)return l;const v=k[1].toLowerCase();if(!L_ALL[v]&&!/^(note|plan|ask|need|done)$/.test(v))return l;\r\n  return '@'+v+k[2].replace(/^(\\*\\*|__|`)/,'').replace(/(\\*\\*|__|`)\\s*$/,'')}).join('\\n');\r\nconst lToks=s=>(String(s||'').match(/\"[^\"]*\"|\\S+/g)||[]).map(x=>x.replace(/^\"|\"$/g,''));\r\nconst lGlobRe=g=>new RegExp('^'+String(g).replace(/[.+^${}()|[\\]\\\\]/g,'\\\\$&').replace(/\\*\\*/g,'\\u0001').replace(/\\*/g,'[^/]*').replace(/\\u0001/g,'.*').replace(/\\?/g,'[^/]')+'$','i');\r\n// renvoie le motif interdit qui correspond à l'un des chemins, ou ''\r\nfunction lForbidden(c,paths){const L=String(c.forbid||'').split(/[\\n,;]+/).map(x=>x.trim().replace(/\\\\/g,'/').replace(/^\\.\\//,'')).filter(Boolean);if(!L.length)return '';\r\n  for(const p0 of paths){const p=String(p0||'').trim().replace(/\\\\/g,'/').replace(/^\\.\\//,'');if(!p)continue;const segs=p.split('/'),bn=segs[segs.length-1];\r\n    for(const g of L){const dir=g.endsWith('/'),gg=dir?g.slice(0,-1):g;\r\n      if(dir){if(p===gg||p.startsWith(gg+'/')||(!gg.includes('/')&&segs.includes(gg)))return g}\r\n      else if(gg.includes('/')){if(lGlobRe(gg).test(p)||p.startsWith(gg+'/'))return g}\r\n      else if(lGlobRe(gg).test(bn)||segs.includes(gg))return g}}\r\n  return ''}\r\nconst PDIFF={};\r\nfunction dfHtml(d){return String(d||'').split('\\n').map(l=>{const c=l[0]==='+'?'a':l[0]==='-'?'d':l[0]==='@'?'h':'';return `<span class=\"dl ${c}\">${esc(l||' ')}</span>`}).join('')}\r\nconst dfSum=d=>`<b class=\"pl\">+${d.a||0}</b> <b class=\"mn\">−${d.r||0}</b>`;\r\nfunction diffAskHtml(m){const d=m.df||{},st=m.state;\r\n  return `<div class=\"m s ldfask\"><div class=\"ldft\">${esc(m.t)} ${dfSum(d)}</div><pre class=\"ldf\">${dfHtml(d.d)}</pre>${st==='wait'&&PDIFF[m.id]?`<div class=\"ldfb\"><button type=\"button\" class=\"btn\" data-dfa=\"${m.id}\" data-ans=\"yes\">Appliquer</button><button type=\"button\" class=\"btn\" data-dfa=\"${m.id}\" data-ans=\"no\">Refuser</button></div>`:`<div class=\"ldfs\">${st==='yes'?'✔ appliqué':st==='no'?'✕ refusé':'expiré (réponse interrompue)'}</div>`}</div>`}\r\n\r\nasync function lConfirm(title,detail,always){const r=await api.localConfirm({title,detail,always});return (r&&r.choice)||'no'}\r\n// décide si une instruction part toute seule ou demande l'accord de l'utilisateur\r\nasync function authorize(p,a){const c=lcfg(p),v=a.verb;\r\n  if(v==='task'||v==='build'||v==='test')return {ok:true};\r\n  if(L_READ[v]||isDry(a))return {ok:true};\r\n  if(L_WRITE[v]||v==='delete'){const t=lToks(a.arg),ps=v==='move'?[t[0],t[1]]:v==='copy'?[t[1]]:v==='replace'?[t.filter(x=>x[0]!=='-')[0]||'.']:[t[0]],g=lForbidden(c,ps);\r\n    if(g)return {ok:false,why:'fichier protégé par les règles du projet (« '+g+' ») : AI Hub refuse sans demander. Ne recommence pas : fais autrement ou termine avec @done'}}\r\n  if((v==='write'||v==='edit'||v==='append'||v==='replace')&&c.askWrite&&!c.trust)return await askDiff(p,a);\r\n  if(L_WRITE[v]||v==='undo'){if(!c.askWrite||c.trust)return {ok:true};\r\n    const r=await lConfirm('L\\'IA veut modifier le dossier : '+v,a.verb+' '+a.arg+(a.hasBody?'\\n\\n'+a.body.slice(0,900):''),false);return r==='no'?{ok:false,why:'refusé par l\\'utilisateur'}:{ok:true}}\r\n  if(v==='delete'){if(c.trust)return {ok:true};\r\n    const r=await lConfirm('L\\'IA veut SUPPRIMER : '+a.arg,'Une copie est gardée dans .aihub : tu pourras annuler (@undo ou Historique du dossier).',false);return r==='no'?{ok:false,why:'suppression refusée par l\\'utilisateur'}:{ok:true}}\r\n  if(v==='run'){const cmd=lNorm(a.arg),danger=L_DANGER.test(cmd),simple=!L_META.test(cmd);\r\n    if(!danger&&(c.trust||(simple&&(L_WHITE.some(r=>r.test(cmd))||c.allow.includes(cmd)))))return {ok:true};\r\n    const r=await lConfirm(danger?'⚠ Commande potentiellement dangereuse':'L\\'IA veut lancer une commande',cmd+'\\n\\nDossier : '+p.local.path,!danger&&simple);\r\n    if(r==='always'){if(!c.allow.includes(cmd))c.allow.push(cmd);save()}\r\n    return r==='no'?{ok:false,why:'commande refusée par l\\'utilisateur'}:{ok:true}}\r\n  if(v==='script'){const danger=L_DANGER.test(a.body||'');if(c.trust&&!danger)return {ok:true};\r\n    const r=await lConfirm(danger?'⚠ Programme potentiellement dangereux':'L\\'IA veut exécuter un programme ('+(a.arg||'?')+')',(a.body||'').slice(0,1500)+'\\n\\nDossier : '+p.local.path,false);return r==='no'?{ok:false,why:'programme refusé par l\\'utilisateur'}:{ok:true}}\r\n  if(L_NET[v]){if(c.trust||c.net[v])return {ok:true};\r\n    const what=v==='web'?'lire la page ':v==='search'?'faire une recherche web : ':'ouvrir ',r=await lConfirm('L\\'IA veut '+what+a.arg.slice(0,200),'« Toujours autoriser » mémorise l\\'accord pour @'+v+' dans ce projet.',true);\r\n    if(r==='always'){c.net[v]=true;save()}return r==='no'?{ok:false,why:'refusé par l\\'utilisateur'}:{ok:true}}\r\n  if(v==='tool'){const tk=lToks(a.arg),sub=(tk[0]||'').toLowerCase();if(/^(list|search|help)$/.test(sub))return {ok:true};\r\n    const danger=L_DANGER.test((a.body||'')+' '+a.arg),key='tool '+sub+' '+(tk[1]||'');\r\n    if(!danger&&c.trust&&sub!=='pkg')return {ok:true};\r\n    if(!danger&&sub==='run'&&c.allow.includes(key))return {ok:true};\r\n    const r=await lConfirm(danger?'⚠ Outil potentiellement dangereux':sub==='pkg'?'L\\'IA veut installer un paquet ('+(tk[1]||'?')+' '+(tk[2]||'')+')':'L\\'IA veut '+(sub==='new'?'créer':sub==='run'?'lancer':'gérer')+' un outil : '+(tk[1]||'?'),a.arg+(a.hasBody?'\\n\\n'+a.body.slice(0,1500):'')+'\\n\\nDossier : '+p.local.path,!danger&&sub==='run');\r\n    if(r==='always'){if(!c.allow.includes(key))c.allow.push(key);save()}\r\n    return r==='no'?{ok:false,why:'outil refusé par l\\'utilisateur'}:{ok:true}}\r\n  return {ok:false,why:'instruction inconnue'}}\r\n// 3.7.0 : « Demander avant d'appliquer » = aperçu en diff dans le chat, boutons Appliquer / Refuser (remplace la boîte de dialogue pour write/edit/append)\r\nasync function askDiff(p,a){\r\n  let r=null;try{r=await api.localExec({root:p.local.path,verb:a.verb,arg:a.arg,body:a.body,hasBody:a.hasBody,turn:'dry',opts:{ignore:lIgnore(lcfg(p)),dry:true,forbid:lcfg(p).forbid||''}})}catch{}\r\n  if(!r||!r.ok||!r.diff||(!r.diff.a&&!r.diff.r))return {ok:true};       // erreur ou aucun changement : l'exécution réelle s'en occupe et le dira à l'IA\r\n  const ch=CH[p.id],m=addMsg(ch,{r:'sys',diffAsk:true,state:'wait',t:'L\\'IA propose de modifier '+((r.rels&&r.rels[0])||lToks(a.arg)[0]||'?'),df:r.diff});\r\n  const ans=await new Promise(res=>{let tm;const done=x=>{clearInterval(tm);res(x)};PDIFF[m.id]=done;tm=setInterval(()=>{if(!CUR||CUR.cancel){const f=PDIFF[m.id];if(f){delete PDIFF[m.id];f('no')}else clearInterval(tm)}},400);drawMsgs(true)});\r\n  m.state=ans==='yes'?'yes':'no';chSave(ch);if(chatProj===ch.id)drawMsgs(false);\r\n  return ans==='yes'?{ok:true}:{ok:false,why:'refusé par l\\'utilisateur'}}\r\n$('ch-msgs').addEventListener('click',e=>{const b=e.target.closest('[data-dfa]');if(!b)return;const f=PDIFF[b.dataset.dfa];if(!f)return;delete PDIFF[b.dataset.dfa];f(b.dataset.ans)});\r\n// ---- 4.2.0 : commandes gratuites (0 crédit) : tapées dans le chat, exécutées tout de suite par AI Hub, sans passer par une IA ----\r\nconst SL_RE=/^\\/(aide|help|tree|arbre|read|lire|outline|plan|grep|find|trouve|stat|run|git|test|tests|ctx|refs|history|historique|agents|auto|ia|mode|interface|changements|claude|chatgpt|gemini|max|code|sub-agents|subagents|web-search|websearch|eco|economie|ctx-auto)(?:\\s+([\\s\\S]*))?$/i;\r\n// 4.14 (S1) : registre des commandes spéciales : /agents /auto /ia /mode /interface /changements (0 crédit)\r\nconst SL_PLATS=['Claude','ChatGPT','Gemini'];\r\nconst SLX={\r\n  auto:p=>{p.only='';p.pin='';try{setRoute('simple',p)}catch{}save();try{drawKeyChip()}catch{}return {t:'IA automatique : AI Hub choisit la clé et en change tout seul'}},\r\n  ia:(p,a)=>{const n=SL_PLATS.find(x=>x.toLowerCase()===String(a||'').trim().toLowerCase());if(!n)return {warn:true,t:'usage : /ia claude|chatgpt|gemini'};if(!accs.some(x=>x.p===n))return {warn:true,t:'aucune clé '+n+' : ajoute-en une'};p.only=n;p.pin='';save();try{drawKeyChip()}catch{}return {t:n+' seulement (change de clé entre comptes '+n+')'}},\r\n  mode:(p,a)=>{const v=String(a||'').trim().toLowerCase();if(v!=='api'&&v!=='pages')return {warn:true,t:'usage : /mode api|pages'};let n=0;accs.forEach(x=>{if(x.api&&x.api.k){x.api.on=v==='api';n++}});save();return n?{t:n+' compte(s) en mode '+(v==='api'?'API':'pages web')}:{warn:true,t:'aucun compte n\\'a de clé API (Paramètres > Centre de contrôle)'}},\r\n  agents:(p,a)=>{const v=String(a||'').trim().toLowerCase();if(v==='stop'){WK.cancel=true;return {t:'arrêt demandé : les agents finissent leur appel en cours'}}const n=Math.max(1,Math.min(3,parseInt(v,10)||2));wkStart(n);return {t:'lancement de '+n+' agent(s) parallèle(s)…'}},\r\n  interface:()=>{const b=document.querySelector('[data-t=\"cc\"]');if(!b)return {warn:true,t:'Centre de contrôle introuvable'};try{const s=document.getElementById('settings')||document.querySelector('[data-open-settings],#set,#btn-settings');if(s)s.click()}catch{}setTimeout(()=>{try{b.click()}catch{}},250);return {t:'Centre de contrôle ouvert (Paramètres)'}},\r\n  changements:()=>{const l=[...document.querySelectorAll('[data-lchg]')].pop();if(!l)return {warn:true,t:'aucun tour avec des changements dans ce chat'};l.click();return {t:'panneau Changements du dernier tour'}}\r\n};\r\nconst slFlag=(k,lab)=>(p,a)=>{p.fl=p.fl||{};const v=String(a||'').trim().toLowerCase();p.fl[k]=(v==='off'||v==='non')?false:(v==='on'||v==='oui')?true:!p.fl[k];save();return {t:lab+' '+(p.fl[k]?'activé':'désactivé')+' pour ce projet'}};\r\nconst ecoF=(p,a)=>{const c=lcfg(p),v=String(a||'').trim().toLowerCase();c.eco=(v==='off'||v==='non')?false:(v==='on'||v==='oui')?true:!c.eco;save();return {t:'Mode économie '+(c.eco?'activé : fil, arbre et pré-lecture réduits':'désactivé')+' pour ce projet'}};\r\nObject.assign(SLX,{'ctx-auto':(p,a)=>{const v=String(a||'').trim().toLowerCase();settings.ctxAuto=(v==='off'||v==='non')?false:(v==='on'||v==='oui')?true:settings.ctxAuto===false;save();return {t:'Fichier ouvert envoyé automatiquement : '+(settings.ctxAuto!==false?'activé':'désactivé')}},eco:ecoF,economie:ecoF,claude:p=>SLX.ia(p,'claude'),chatgpt:p=>SLX.ia(p,'chatgpt'),gemini:p=>SLX.ia(p,'gemini'),'sub-agents':(p,a)=>SLX.agents(p,a),subagents:(p,a)=>SLX.agents(p,a),max:slFlag('max','Mode max'),code:slFlag('code','Mode code'),'web-search':slFlag('web','Recherche web'),websearch:slFlag('web','Recherche web')});\r\nconst SL_HELP='Commandes gratuites : aucun crédit utilisé, AI Hub les exécute directement dans le dossier du projet.\\n/tree [dossier] [profondeur] · /read fichier [début-fin | fn:nom] · /outline fichier · /grep texte [dossier] [-r regex] [-l] [-C2] [-g *.js] · /find *.js · /stat chemin · /run commande · /git status|diff|log · /test · /ctx question (trouve le code par le sens, même sans mot en commun) · /refs symbole (définition + usages) · /history [fichier] (git)\\nCommandes spéciales : /agents [1-3|stop] agents parallèles (un par compte) · /auto IA automatique · /ia claude|chatgpt|gemini une seule IA · /mode api|pages · /interface Centre de contrôle · /changements diff du dernier tour\\nRéglages du chat : /claude /chatgpt /gemini (une seule IA) · /sub-agents [1-3|stop] · /max · /code · /web-search (on|off)';\r\n// ---- menu d'autocomplétion des commandes gratuites (taper « / » dans la barre de chat) ----\r\nconst SL_LIST=[['ctx-auto','fichier ouvert envoyé tout seul (on/off)'],['max','mode max : réponse la plus complète'],['auto','IA automatique (meilleure clé)'],['web-search','recherche web pour ce message'],['code','mode code'],['claude','Claude seulement'],['chatgpt','ChatGPT seulement'],['gemini','Gemini seulement'],['sub-agents','agents parallèles (1-3)'],['aide','liste de toutes les commandes'],['tree','arborescence du dossier'],['read','lire un fichier ou une fonction'],['outline','plan d\\'un fichier'],['grep','chercher du texte'],['find','trouver des fichiers'],['stat','infos sur un fichier'],['run','lancer une commande'],['git','status, diff, log'],['test','lancer les tests'],['ctx','trouver le code par le sens'],['refs','définition et usages d\\'un symbole'],['history','historique git'],['agents','agents parallèles'],['ia','forcer une seule IA'],['mode','API ou pages web'],['interface','Centre de contrôle'],['changements','diff du dernier tour'],['eco','mode économie : moins de tokens (on|off)']];\r\nlet SLM=null,SLI=0,SLR=[];\r\n// 10.0.26 : mention @ = fichiers et dossiers du PROJET (mode local), cache 60 s\r\nconst MENC={};\r\nfunction menAt(q){const p=P0(chatProj);\r\n  if(p&&modeOf(p)==='local'&&p.local&&p.local.path){const root=p.local.path;let c=MENC[root];\r\n    if(!c||(!c.l&&Date.now()-c.t>60000)){const e=c=MENC[root]=c||{t:0,f:[],d:[],l:0};e.l=1;\r\n      api.localExec({root,verb:'find',arg:'* -n 3000',opts:{ignore:lIgnore(lcfg(p)),noGen:true}}).then(o=>{\r\n        const f=String((o&&o.out)||'').split('\\n').map(s=>s.trim().replace(/\\\\/g,'/')).filter(s=>s&&!/^(…|\\.\\.\\.|aucun)/i.test(s)&&!/\\s{2}/.test(s));\r\n        const d=new Set();f.forEach(s=>{const a=s.split('/');a.pop();let k='';a.forEach(x=>{k+=x+'/';d.add(k)})});\r\n        e.f=f;e.d=[...d];e.t=Date.now();e.l=0;try{slMenuShow()}catch{}}).catch(()=>{e.l=0;e.t=Date.now()})}\r\n    const ql=q.toLowerCase().replace(/\\\\/g,'/'),all=((c&&c.d)||[]).concat((c&&c.f)||[]);\r\n    const base=s=>s.replace(/\\/$/,'').split('/').pop().toLowerCase();\r\n    return all.filter(s=>s.toLowerCase().includes(ql)).sort((a,b)=>(base(b).startsWith(ql)-base(a).startsWith(ql))||a.length-b.length).slice(0,8).map(s=>[s,/\\/$/.test(s)?'dossier du projet':'fichier du projet',s,1])}\r\n  return (FILES||[]).filter(f=>f&&f.name&&f.name.toLowerCase().includes(q)).slice(0,8).map(f=>[f.name,'joindre ce fichier',f.id])}\r\nfunction menInject(p,text){const c=MENC[p.local.path];if(!c)return text;const set=new Set((c.f||[]).concat(c.d||[])),out=[];\r\n  String(text).replace(/(^|\\s)@([^\\s@]+)/g,(m,pre,tok)=>{const path=tok.replace(/(:\\d+(-\\d+)?|#[\\w$.-]+)$/,'');if(set.has(path)&&!out.includes(tok))out.push(tok);return m});\r\n  return out.length?text+'\\n\\n[Fichiers mentionnés : lis-les avec @read (ou @tree pour un dossier) avant de répondre : '+out.join(', ')+']':text}\r\nfunction slMenuHide(){if(SLM)SLM.hidden=true}\r\nlet SLT=null;\r\nfunction slCaretX(inp,start){const cs=getComputedStyle(inp),c=slCaretX._c||(slCaretX._c=document.createElement('canvas').getContext('2d'));c.font=cs.font;\r\n  const v=inp.value.slice(0,start),line=v.slice(v.lastIndexOf('\\n')+1);return (parseFloat(cs.paddingLeft)||0)+c.measureText(line).width}\r\nfunction slMenuShow(){\r\n  const inp=$('ch-in');if(!inp)return;\r\n  const v=inp.value,c=inp.selectionStart==null?v.length:inp.selectionStart,m=/(^|\\s)\\/([a-zà-ÿ-]*)$/i.exec(v.slice(0,c));\r\n  let at=null;if(!m){at=/(^|\\s)@([^\\s@]*)$/.exec(v.slice(0,c));if(!at){slMenuHide();return}}\r\n  const q=(m||at)[2].toLowerCase();SLT={a:c-q.length-1,b:c};\r\n  SLR=m?SL_LIST.filter(x=>x[0].includes(q)).sort((a,b)=>(b[0].startsWith(q)-a[0].startsWith(q))):menAt(q);\r\n  if(!SLR.length||(SLR.length===1&&SLR[0][0]===q)){slMenuHide();return}\r\n  if(!SLM){\r\n    const st=document.createElement('style');st.textContent='.slmenu{position:fixed;z-index:200;background:var(--c-surface,var(--bg,#fff));border:1px solid var(--c-line,var(--line));border-radius:12px;box-shadow:0 10px 32px rgba(0,0,0,.28);padding:5px;font-size:13px;max-height:320px;overflow:auto}.slmenu[hidden]{display:none}.slr{display:flex;gap:12px;align-items:baseline;padding:6px 10px;border-radius:8px;cursor:pointer}.slr b{font-family:ui-monospace,Consolas,monospace;font-weight:600;flex:none}.slr span{color:var(--dim,#888);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.slr.on,.slr:hover{background:rgba(127,127,127,.18)}';document.head.appendChild(st);\r\n    SLM=document.createElement('div');SLM.className='slmenu';document.body.appendChild(SLM);\r\n    SLM.addEventListener('mousedown',e=>{const r=e.target.closest('[data-sl]');if(!r)return;e.preventDefault();slPick(+r.dataset.sl)});\r\n  }\r\n  SLI=Math.min(SLI,SLR.length-1);\r\n  SLM.innerHTML=SLR.map((x,i)=>'<div class=\"slr'+(i===SLI?' on':'')+'\" data-sl=\"'+i+'\"><b>'+(x[2]?'@':'/')+x[0]+'</b><span>'+x[1]+'</span></div>').join('');\r\n  SLM.hidden=false;const r=inp.getBoundingClientRect(),W=Math.min(380,Math.max(260,r.width)),h=SLM.offsetHeight;\r\n  let x=slCaretX(inp,SLT.a)%Math.max(100,r.width-40);let left=Math.max(8,Math.min(innerWidth-W-8,r.left+x-8));\r\n  SLM.style.width=W+'px';SLM.style.left=left+'px';SLM.style.top=Math.max(8,r.top-h-8)+'px';\r\n  const on=SLM.querySelector('.on');if(on)on.scrollIntoView({block:'nearest'});\r\n}\r\n{const i0=$('ch-in');if(i0){i0.addEventListener('input',()=>{SLI=0;slMenuShow()});i0.addEventListener('click',()=>slMenuShow());i0.addEventListener('keyup',e=>{if(e.key==='ArrowLeft'||e.key==='ArrowRight'||e.key==='Home'||e.key==='End')slMenuShow()});i0.addEventListener('blur',()=>setTimeout(slMenuHide,150))}}\r\nfunction slPick(i){const x=SLR[i];if(!x||!SLT)return;if(x[3]){const ip=$('ch-in'),vv=ip.value,ins='@'+x[0]+(/\\/$/.test(x[0])?'':' ');ip.value=vv.slice(0,SLT.a)+ins+vv.slice(SLT.b);const pos=SLT.a+ins.length;slMenuHide();ip.focus();try{ip.setSelectionRange(pos,pos)}catch{}autoGrow();return}if(x[2]){const ip=$('ch-in'),vv=ip.value;ip.value=vv.slice(0,SLT.a)+vv.slice(SLT.b);if(!PEND.includes(x[2]))PEND.push(x[2]);drawChips();slMenuHide();ip.focus();autoGrow();return}const inp=$('ch-in'),v=inp.value,ins='/'+x[0]+' ';inp.value=v.slice(0,SLT.a)+ins+v.slice(SLT.b);const pos=SLT.a+ins.length;slMenuHide();inp.focus();try{inp.setSelectionRange(pos,pos)}catch{}autoGrow();inp.dispatchEvent(new Event('input'))}\r\n// réglages écrits dans le message (« cherche des images de gorille /web-search ») : retirés du texte envoyé\r\nconst SL_INL=new Set(['max','auto','web-search','websearch','code','claude','chatgpt','gemini']);\r\nconst SL_HINT={max:'Mode max : réponds de la façon la plus complète et approfondie possible.',code:'Mode code : réponds surtout avec du code, sans bavardage.','web-search':'Utilise la recherche web pour répondre.',websearch:'Utilise la recherche web pour répondre.'};\r\nfunction slFlags(p,text){const t=String(text);if(SL_RE.test(t.trim()))return t;const f=p.fl||{},h=[];\r\n  if(f.max&&!/Mode max/.test(t))h.push(SL_HINT.max);if(f.code&&!/Mode code/.test(t))h.push(SL_HINT.code);if(f.web&&!/recherche web/i.test(t))h.push(SL_HINT['web-search']);\r\n  return h.length?t+'\\n\\n['+h.join(' ')+']':t}\r\nfunction slInline(p,text){const t=String(text),tt=t.trim(),m0=/^\\/([a-zà-ÿ-]+)(?:\\s|$)/i.exec(tt);\r\n  if(m0&&!SL_INL.has(m0[1].toLowerCase()))return t;\r\n  if(/^\\/[a-zà-ÿ-]+$/i.test(tt))return t;\r\n  const hits=[];const out=t.replace(/(^|\\s)\\/(max|auto|web-search|websearch|code|claude|chatgpt|gemini)(?=\\s|$)/gi,(m,pre,w)=>{hits.push(w.toLowerCase());return pre?' ':''}).replace(/[ \\t]{2,}/g,' ').trim();\r\n  if(!hits.length||!out)return t;\r\n  const hints=[];\r\n  for(const w of hits){if(SL_HINT[w]){if(!hints.includes(SL_HINT[w]))hints.push(SL_HINT[w])}else{try{SLX[w]&&SLX[w](p,'')}catch{}}}\r\n  toast('Réglages appliqués : /'+hits.join(' /'));\r\n  return hints.length?out+'\\n\\n['+hints.join(' ')+']':out}\r\nfunction slKey(e){\r\n  if(!SLM||SLM.hidden||!SLR.length)return false;\r\n  if(e.key==='ArrowDown'||e.key==='ArrowUp'){e.preventDefault();SLI=(SLI+(e.key==='ArrowDown'?1:SLR.length-1))%SLR.length;slMenuShow();return true}\r\n  if(e.key==='Tab'||(e.key==='Enter'&&!e.shiftKey&&!e.isComposing)){e.preventDefault();slPick(SLI);return true}\r\n  if(e.key==='Escape'){slMenuHide();return true}\r\n  return false;\r\n}\r\nasync function slashLocal(p,text,isOver){\r\n  const m=SL_RE.exec(String(text).trim());if(!m)return false;\r\n  const ch=await chatOf(p.id),w=m[1].toLowerCase(),rest=(m[2]||'').trim();\r\n  if(!isOver){const inp=$('ch-in');if(inp){inp.value='';autoGrow()}PEND=[];drawChips();DRAFTS[p.id]='';const c0=CH[p.id];if(c0&&c0.draft){c0.draft='';chSave(c0)}}\r\n  addMsg(ch,{r:'user',t:text});\r\n  if(SLX[w]){try{const o=await SLX[w](p,rest);addMsg(ch,{r:'sys',warn:!!(o&&o.warn),t:'/'+w+' · '+((o&&o.t)||'ok')+' · 0 crédit'})}catch(x){addMsg(ch,{r:'sys',warn:true,t:'/'+w+' : '+String(x&&x.message||x).slice(0,160)})}return true}\r\n  if(w==='aide'||w==='help'){addMsg(ch,{r:'sys',t:'Commandes gratuites (0 crédit)',det:SL_HELP,open:true});return true}\r\n  const V={tree:'tree',arbre:'tree',read:'read',lire:'read',outline:'outline',plan:'outline',grep:'grep',find:'find',trouve:'find',stat:'stat',run:'run',git:'run',test:'run',tests:'run',ctx:'ctx',refs:'refs',history:'history',historique:'history'}[w];\r\n  let arg=rest;if(w==='git')arg='git '+(rest||'status');if(w==='test'||w==='tests')arg='npm test';\r\n  if(!arg&&V!=='tree'&&V!=='history'){addMsg(ch,{r:'sys',warn:true,t:'/'+w+' : il manque un argument (tape /aide)'});return true}\r\n  const a={verb:V,arg:arg||(V==='history'?'':'.'),body:'',hasBody:false};\r\n  try{\r\n    const au=await authorize(p,a);if(!au.ok){addMsg(ch,{r:'sys',warn:true,t:'/'+w+' : '+au.why});return true}\r\n    const o=await LOCAL.run(p,a,'sl'+Date.now().toString(36)),det=String(o.out||'').slice(0,8000);\r\n    addMsg(ch,det?{r:'sys',t:'/'+w+' · '+(o.title||V)+' · 0 crédit',det,open:true}:{r:'sys',warn:!o.ok,t:'/'+w+' · '+(o.title||V)+' · 0 crédit'});\r\n  }catch(x){addMsg(ch,{r:'sys',warn:true,t:'/'+w+' : '+String(x&&x.message||x).slice(0,160)})}\r\n  return true}\r\nconst LOCAL={\r\n  ready:true,protocol:2,\r\n  run(p,a,turn){const c=lcfg(p),ch0=CH[p.id],kk=CUR&&CUR.key,sess=kk?kk+'|'+((ch0&&ch0.lcard&&ch0.lcard[kk])?'c':'n'):'';\r\n    return api.localExec({root:p.local.path,verb:a.verb,arg:a.arg,body:a.body,hasBody:a.hasBody,turn,opts:{ignore:lIgnore(c),timeout:c.timeout,verify:c.verify!==false,focus:CUR&&CUR.focus||[],forbid:c.forbid||'',sess}})},\r\n  async ask(p,ch,msg,full,lt,files){      // même logique de clés que le mode en ligne (limites, changement de compte), mais sans historique ni fichiers\r\n    const skip=[],tried=new Set();let last='';\r\n    for(let n=0;n<=accs.length;n++){\r\n      const a=keyOrder(p,ch,skip)[0];\r\n      if(!a&&CUR&&CUR.tasks&&accs.length&&!CUR.cancel&&(CUR.waits=(CUR.waits||0)+1)<=40){      // 4.4.0 : build long : toutes les clés en limite = on attend la plus proche fin de limite puis on reprend tout seul\r\n        const us=accs.map(x=>stOf(x.id).until||0).filter(u=>u>Date.now()),w=Math.min(us.length?Math.min(...us)-Date.now()+5000:60000,6*3600e3),t1=Date.now()+w;\r\n        addMsg(ch,{r:'sys',t:'Toutes les clés sont en limite : le build long reprend automatiquement vers '+hm(t1)+' (garde AI Hub ouvert, « Arrêter » pour annuler).'});\r\n        while(Date.now()<t1&&!CUR.cancel){setAct('En attente d\\'une clé · reprise vers '+hm(t1));await sleep(5000)}\r\n        skip.length=0;n=-1;continue}\r\n      if(!a){addMsg(ch,{r:'sys',warn:true,t:accs.length?`Aucune clé ${p.only?p.only+' ':''}disponible${last?' ('+last+')':''}. Attends la fin d'une limite ou reconnecte une clé.`:'Aucune clé : ajoute un compte IA dans la zone « Clés » à gauche.'});return {ok:false}}\r\n      if(ch.key&&ch.key!==a.id){const o=find(ch.key);addMsg(ch,{r:'sys',t:`Clé changée : ${o?lbl(o):'—'} → ${lbl(a)}${last?' ('+last+')':''}${routeTag(ch)}`})}\r\n      ch.key=a.id;CUR.key=a.id;CUR.local={msg,full,lt};chSave(ch);drawKeyChip();renderList();drawMsgs(true);\r\n      const r=await driveKey(p,ch,a,0,msg,files||[]);\r\n      if(r.ok){(settings.lastUse=settings.lastUse||{})[a.id]=Date.now();save();CUR.live='';CUR.act='';CUR.steps=[];\r\n        if(CUR.cardFor===a.id)(ch.lcard=ch.lcard||{})[a.id]=1;if(lt&&CUR.headFor===a.id)(ch.lhead=ch.lhead||{})[a.id]={h:lt.hh,n:lt.n};return {ok:true,raw:r.raw||r.reply,a}}\r\n      if(r.cancel){addMsg(ch,{r:'sys',t:'Envoi interrompu.'});return {ok:false}}\r\n      if(r.skip&&!tried.has(a.id)&&/page non prête|collage impossible/.test(r.reason||'')){tried.add(a.id);setAct('Nouvel essai sur '+lbl(a)+'…');try{view(a).reload()}catch{}await sleep(2500);n--;continue}\r\n      const s=stOf(a.id);last=(r.reason==='limite atteinte'?'limite atteinte sur '+lbl(a)+(s.until?' jusqu\\'à '+hm(s.until):''):lbl(a)+' : '+(r.reason||'échec'));skip.push(a.id)}\r\n    return {ok:false}},\r\n  async loop(p,ch,text){\r\n    const root=p.local.path,small=a=>(PLIM[a&&a.p]||30000)<=10000,cfg=lcfg(p);\r\n    if(ch.lcardV!==5){ch.lcard={};ch.lhead={};ch.lcardV=5}                       // la carte du langage a changé (nouvelles instructions) : on la renvoie une fois par clé\r\n    // l'état du travail vit dans le dossier (.aihub/memo.txt) : un autre compte, ou une autre session, reprend exactement au même point\r\n    let memo='';try{const m=await api.localMemo({root,op:'get'});memo=(m&&m.text)||''}catch{}\r\n    if(!memo&&ch.localMemoFor===root)memo=ch.localMemo||'';\r\n    // reprise exacte : tâche en cours, plan, derniers tours et derniers résultats viennent du dossier (.aihub/state.json), pas de la conversation\r\n    let stt={};try{const g=await api.localState({root,op:'get'});stt=(g&&g.st)||{}}catch{}\r\n    const unfinished=!!(stt.task&&stt.task.text&&stt.task.status!=='done'),cont=unfinished&&(stt.task.status==='asked'||/^\\s*(continue|continuer|continuez|reprends?|reprenons|vas-y|go|ok|oui|suite)\\b/i.test(text));\r\n    try{const g=await api.localState({root,op:'task',text,keep:cont});if(g&&g.st)stt=g.st}catch{}\r\n    if(!stt.rounds)stt.rounds=[];let plan=stt.plan||'';\r\n    const clip=(s,n)=>{s=String(s||'');return s.length<=n?s:s.slice(0,n-1)+'…'};\r\n    const fil=()=>{const R=stt.rounds.slice(cfg.eco?-6:-16);if(!R.length)return '';\r\n      let s=R.map((x,i)=>{const rec=i>=R.length-3;return x.n+'. '+(rec?x.acc+' : '+(x.talk?clip(x.talk,160)+' → ':''):'')+x.acts.map(a=>(a.ok?'✔ ':'✕ ')+clip(a.t,rec?70:30)).join(rec?' ; ':';')}).join('\\n');\r\n      const cap=(PLIM[(find(ch.key)||{}).p]||30000)<=10000||cfg.eco?700:4500;return s.length>cap?'[…]\\n'+s.slice(-cap):s};\r\n    const saveMemo=()=>{ch.localMemo=memo;ch.localMemoFor=root;try{api.localMemo({root,op:'set',text:memo})}catch{}};\r\n    let results=cont?(stt.lastResults||''):'',lastA=null,gitDone=false;const sigs=[],nreq=(ch.localTurn=(ch.localTurn||0)+1);\r\n    const prev=ch.localPrev;if(prev){delete ch.localPrev}\r\n    const tr=await api.localExec({root,verb:'tree',arg:'. 2',opts:{ignore:lIgnore(cfg),noGen:true}});\r\n    const tree=tr&&tr.ok?tr.out.split('\\n').slice(0,cfg.eco?30:70).join('\\n'):'(arbre indisponible)';\r\n    // 3.7.0 : carte du projet + pré-lecture automatique (index léger .aihub/index.json), règles du projet\r\n    let carte='',pre='',hasTest=false,rulesTxt='';\r\n    try{const a0=keyOrder(p,ch,[])[0],cap0=PLIM[a0&&a0.p]||30000,sm=cap0<=10000;\r\n      if(api.localIndex){const ix=await api.localIndex({root,query:cont?'':text,cap:cont?0:Math.round(cap0*(cfg.eco?.15:.3)),mapN:sm||cfg.eco?8:24,ignore:lIgnore(cfg)});\r\n        if(ix&&ix.ok){carte=ix.map||'';pre=ix.pre||'';hasTest=!!ix.test;\r\n          if(ix.preFiles&&ix.preFiles.length)addMsg(ch,{r:'sys',t:'Pré-lecture : '+ix.preFiles.join(', ')+' joint'+(ix.preFiles.length>1?'s':'')+' à la demande (carte du projet : '+ix.count+' fichiers)'})}}\r\n      if(api.localRules){const rr=await api.localRules({root,op:'get'});rulesTxt=(rr&&rr.text||'').trim()}}catch{}\r\n    CUR.rules=rulesTxt;CUR.focus=[...new Set(String(text).toLowerCase().split(/[^a-zà-ÿ0-9_]+/).filter(w=>w.length>=4))].slice(0,12);\r\n    const hsh=s=>{let h=5381;for(let i=0;i<s.length;i++)h=((h<<5)+h+s.charCodeAt(i))|0;return (h>>>0).toString(36)},hh=hsh(carte+'|'+tree+'|'+rulesTxt);\r\n    let acted=false,retried=false,proposedTest=false,ranTest=false,lastAcc=null;\r\n    const head=(lite)=>{const f=fil();return LV+'\\nDOSSIER: '+p.local.name+'\\n'+(memo?'MÉMO: '+memo+'\\n':'')+(cont?'TÂCHE EN COURS (demande d\\'origine, pas finie) : '+clip(stt.task.text,400)+'\\n':'')+(plan?'PLAN: '+plan+'\\n':'')+(CUR&&CUR.tasks?'TÂCHES (plan partagé entre les clés) :\\n'+CUR.tasks+'\\n':'')+(f?'FIL (tours déjà faits, ne les refais pas) :\\n'+f+'\\n':'')+((f||memo||plan)?'REPRISE: si c\\'est le premier message que tu reçois ici, tu prends le relais d\\'un autre compte : lis MÉMO, PLAN et FIL, ne refais pas ce qui est fait, continue.\\n':'')+(lite?'(CARTE et ARBRE du projet : inchangés depuis tes messages précédents dans cette conversation.)\\n':(carte?'CARTE (fichiers principaux) :\\n'+carte+'\\n':'')+'ARBRE:\\n'+tree+'\\n')};\r\n    const dem='DEMANDE: '+text+(prev?'\\n(suite de ta question précédente : '+capMid(prev,500)+')':'');\r\n    for(let round=0;round<(CUR&&CUR.tasks?400:25);round++){\r\n      if(CUR.cancel){addMsg(ch,{r:'sys',t:'Envoi interrompu.'});return}\r\n      while(CUR.pause&&!CUR.cancel){setAct('En pause (Reprendre dans le panneau Tâches)');await sleep(1000)}\r\n      if(CUR.cancel){addMsg(ch,{r:'sys',t:'Envoi interrompu.'});return}\r\n      try{const tk=await api.localExec({root,verb:'task',arg:'list',opts:{}});CUR.tasks=tk&&tk.ok&&!/aucune tâche/.test(tk.out||'')?tk.out:''}catch{CUR.tasks=''}\r\n      const full=head()+(round===0?pre:'')+(results?'RÉSULTATS:\\n'+results+'\\n':'')+dem+(round===0&&CUR&&CUR.pfiles&&CUR.pfiles.length?'\\n(joint à ce message : '+CUR.pfiles.map(f=>f.name).join(', ')+' — regarde-le directement)':'')+(round?'\\n(continue la demande ci-dessus à partir des résultats, ou @done)':'');\r\n      const msg=round===0?full:LV+'\\nRÉSULTATS:\\n'+results+'\\nSuite de la demande : continue, ou @done.';\r\n      const lt=round===0?{lite:head(true)+pre+(results?'RÉSULTATS:\\n'+results+'\\n':'')+dem,hh,n:nreq}:null;\r\n      let r=await LOCAL.ask(p,ch,msg,full,lt,round===0?((CUR&&CUR.pfiles)||[]):[]);if(!r.ok)return;lastA=r.a;\r\n      if(lastAcc&&lastAcc!==r.a.id&&stt.rounds.length)addMsg(ch,{r:'sys',t:'Reprise sur '+lbl(r.a)+' : '+stt.rounds.length+' tour'+(stt.rounds.length>1?'s':'')+' déjà fait'+(stt.rounds.length>1?'s':'')+(plan?', plan : '+clip(plan,160):'')+'. Rien n\\'est perdu : le fil, le mémo et les derniers résultats sont renvoyés.'});\r\n      lastAcc=r.a.id;\r\n      const parse=raw=>{let q=parseActs(raw);if(!q.acts.length){const f=fixAts(raw);if(f!==raw){const q2=parseActs(f);if(q2.acts.length)q=q2}}return q};\r\n      let pr=parse(r.raw);\r\n      // 3.7.0 : demande d'action sans aucune ligne @ (format abîmé par le site) : on redemande UNE fois avec le rappel du format\r\n      if(!pr.acts.length&&!acted&&!retried&&L_ACTION.test(text)){retried=true;\r\n        addMsg(ch,{r:'sys',t:'Réponse sans instruction @ (le site a peut-être abîmé le format) : nouvelle demande avec le rappel du format…'});\r\n        const rem=LV+'\\nTa réponse précédente ne contenait aucune ligne @ : rien n\\'a été fait. Réponds UNIQUEMENT par des lignes @ (une par ligne) dans UN SEUL bloc de code ```, par exemple @read chemin ou @edit chemin, puis @done. Pas de texte hors du bloc.\\n'+(results?'RÉSULTATS:\\n'+results+'\\n':'')+dem;\r\n        const r2=await LOCAL.ask(p,ch,rem,full+'\\n(ta réponse précédente n\\'avait aucune ligne @ : réponds uniquement par des lignes @ dans un bloc ```)');\r\n        if(!r2.ok)return;r=r2;lastA=r.a;lastAcc=r.a.id;pr=parse(r.raw);\r\n        if(!pr.acts.length){addMsg(ch,{r:'ai',t:pr.talk||r.raw,k:{id:r.a.id,p:r.a.p,n:r.a.n}});addMsg(ch,{r:'sys',warn:true,t:'Toujours aucune instruction @ après le rappel : la réponse est affichée telle quelle. Le site a sans doute abîmé le format (essaie « Relancer » ou une autre clé).'});try{api.localState({root,op:'status',status:'done'})}catch{}return}}\r\n      const k={id:r.a.id,p:r.a.p,n:r.a.n};\r\n      if(!pr.acts.length){addMsg(ch,{r:'ai',t:pr.talk||r.raw,k});try{api.localState({root,op:'status',status:'done'})}catch{}return}      // texte libre : c'est la réponse finale, on ne plante pas\r\n      acted=true;\r\n      const sig=pr.acts.map(a=>a.verb+' '+a.arg+'|'+(a.body||'').length).join('|');sigs.push(sig);\r\n      if(sigs.filter(x=>x===sig).length>=3){addMsg(ch,{r:'ai',t:pr.talk,k,acts:pr.acts.map(a=>({ok:false,t:a.verb+' '+a.arg}))});addMsg(ch,{r:'sys',warn:true,t:'Boucle détectée : l\\'IA redemande la même chose pour la 3e fois. Reformule ta demande ou précise ce que tu veux.'});return}\r\n      const turn='t'+Date.now().toString(36)+round,outs=[],chg=[];let done=null,asked=null,rdFail=false;\r\n      for(const a of pr.acts){setAct(lbl(r.a)+' · '+a.verb+' '+a.arg.slice(0,40));\r\n        if(CUR.cancel)break;\r\n        if(a.bad){outs.push({ok:false,v:a.verb,title:a.verb+' '+a.arg.slice(0,50),out:a.bad});break}\r\n        if(a.verb==='done'){if(rdFail){outs.push({ok:false,title:'done',out:'ignoré : une lecture a échoué dans cette réponse, regarde les résultats'});break}done=a.arg||a.body||'Terminé.';outs.push({ok:true,title:'done'});break}\r\n        if(a.verb==='ask'){asked=a.arg||a.body;outs.push({ok:true,title:'ask'});break}\r\n        if(a.verb==='note'){memo=memoAdd(memo,a.arg||a.body);saveMemo();outs.push({ok:true,title:'note enregistrée'});continue}\r\n        if(a.verb==='plan'){plan=String(a.arg||a.body||'').replace(/\\s+/g,' ').trim().slice(0,1600);stt.plan=plan;try{api.localState({root,op:'plan',text:plan})}catch{}outs.push({ok:true,title:'plan mis à jour'});continue}\r\n        if(a.verb==='need'){const d=(a.arg||a.body).slice(0,200);try{await api.localNeeds({root,op:'add',text:d})}catch{}outs.push({ok:true,title:'need noté : '+d.slice(0,60),out:'noté (liste « Capacités souhaitées »)'});continue}\r\n        if(!L_ALL[a.verb]){outs.push({ok:false,title:a.verb,out:'instruction inconnue. Instructions disponibles : '+L_LIST});break}\r\n        if(rdFail&&!L_READ[a.verb]){outs.push({ok:false,v:a.verb,title:a.verb+' '+a.arg.split('\\n')[0].slice(0,50),out:'non exécutée : une lecture précédente de cette réponse a échoué (regarde son résultat d\\'abord)'});break}\r\n        const au=await authorize(p,a);\r\n        if(!au.ok){outs.push({ok:false,v:a.verb,title:a.verb+' '+a.arg.split('\\n')[0].slice(0,50),out:au.why+' — ne recommence pas, explique autrement ou demande avec @ask'});break}\r\n        if(L_MODIFY.test(a.verb)&&!isDry(a)&&!gitDone){gitDone=true;\r\n          if(cfg.autoGit){try{const g=await api.localGit({root,label:'AI Hub : tour '+nreq});if(g&&g.committed)addMsg(ch,{r:'sys',t:'Point de sauvegarde git créé avant les modifications : « AI Hub : tour '+nreq+' »'})}catch{}}}\r\n        const o=await LOCAL.run(p,a,turn);o.v=a.verb;outs.push(o);\r\n        if(a.verb==='task'&&o.ok&&/^\\s*done\\b/i.test(a.arg||'')){      // 4.8.0 : build automatique après @task done, l'erreur revient à l'IA\r\n          try{const b=await LOCAL.run(p,{verb:'build',arg:'auto',body:'',hasBody:false},turn);b.v='build';b.title='auto : '+b.title;outs.push(b);if(!b.ok){const tid=((a.arg||'').match(/\\d+/)||[])[0];if(tid){try{await LOCAL.run(p,{verb:'task',arg:'start '+tid+' build en échec : '+String(b.out||'').replace(/\\s+/g,' ').slice(0,120),body:'',hasBody:false},turn)}catch{}}break}}\r\n          catch(x){outs.push({ok:false,v:'build',title:'build auto',out:String(x&&x.message||x).slice(0,300)});break}}\r\n        if(o.changed)for(const x of (o.rels||[]))if(!chg.includes(x))chg.push(x);\r\n        if(!o.ok){if(L_READ[a.verb]){rdFail=true;continue}break}}\r\n      // 4.12 J1 : vérification automatique après un tour qui modifie des fichiers (0 crédit) : le résultat revient dans le même retour, @done est ignoré si elle échoue\r\n      if(cfg.autoCheck!==false&&chg.length&&outs.length&&outs.every(o=>o.ok)&&!pr.acts.some(x=>/^(run|build|test|script)$/.test(x.verb)||(x.verb==='task'&&/^done\\b/i.test(x.arg)))){\r\n        try{const b=await LOCAL.run(p,{verb:'build',arg:'auto',body:'',hasBody:false},turn);\r\n          if(b&&!/rien à construire/.test(b.title||'')){b.v='build';b.title='auto : '+b.title;outs.push(b);if(!b.ok&&done!==null){done=null;outs.push({ok:false,title:'done ignoré',out:'la vérification automatique a échoué : corrige puis @done'})}}}catch{}}\r\n      if(pr.extra)outs.push({ok:false,title:'(+'+pr.extra+' instructions ignorées)',out:'30 instructions maximum par réponse'});\r\n      const shown=[pr.talk,done,asked].filter(Boolean).join('\\n\\n');\r\n      const acts=outs.map(o=>({ok:o.ok,t:o.title,d:o.out?String(o.out).slice(0,L_READ[o.v]?500:1500):'',df:o.diff&&(o.diff.a||o.diff.r)?o.diff:undefined}));\r\n      const svd=outs.reduce((n,o)=>n+(+o.saved||0),0),mm=addMsg(ch,{r:'ai',t:shown,k,acts,tok:tok((round===0?(CUR.headFor===r.a.id?full:lt.lite):msg).length),sv:svd>=300?tok(svd):0,to:tok(String(r.raw||'').length),rd:round+1});if(chg.length){mm.turn=turn;mm.chg=chg.slice(0,12);chSave(ch);if(chatProj===ch.id)drawMsgs(false)}\r\n      const cap=small(r.a)?3500:20000,resNow=capMid(outs.map((o,i)=>'#'+(i+1)+' '+(o.ok?'ok ':'err')+' '+o.title+(o.out?'\\n'+o.out:'')).join('\\n'),cap)+(CUR.cancel?'\\n(interrompu par l\\'utilisateur avant la fin des instructions)':'');\r\n      if(pr.acts.some(x=>x.verb==='run'&&/\\b(npm|yarn|pnpm)\\s+(run\\s+)?test\\b|pytest|node\\s+--test/i.test(x.arg)))ranTest=true;\r\n      try{if(!tkb.hidden)drawTasks()}catch{}\r\n      try{const rt=outs.find((o,i)=>pr.acts[i]&&pr.acts[i].verb==='run'&&/\\b(npm|yarn|pnpm)\\s+(run\\s+)?test\\b|pytest|node\\s+--test/i.test(pr.acts[i].arg||''));if(rt)addMsg(ch,{r:'sys',warn:!rt.ok,t:(rt.ok?'✔ Tests réussis':'✕ Tests en échec')+' · '+String(rt.title||'').slice(0,80)})}catch{}\r\n      const hint=(hasTest&&!ranTest&&chg.length&&done===null&&asked===null&&(!proposedTest||(cfg.autoTest!==false&&!CUR.testForced&&(CUR.testForced=true))))?(proposedTest=true,'\\nAI Hub : ce projet a un script de test. Avant @done, lance-le avec @run npm test (obligatoire après une modification).'):'';\r\n      // 4.4.0 : build long : un commit git après chaque tâche terminée (retour en arrière possible à tout moment)\r\n      try{if(cfg.autoGit&&pr.acts.some(x=>x.verb==='task'&&/^done\\b/i.test(x.arg))&&outs.every(o=>o.ok))api.localGit({root,label:'AI Hub : tâche terminée (tour '+nreq+')'})}catch{}\r\n      // 4.3.0 : gros projet multi-clés : une tâche terminée = on passe la main à la clé la moins utilisée (sauf clé fixée), sauf si settings.rotateTasks===false\r\n      try{if(settings.rotateTasks!==false&&!p.pin&&done===null&&asked===null&&pr.acts.some(x=>x.verb==='task'&&/^done\\b/i.test(x.arg))&&outs.every(o=>o.ok)){try{memo=memoAdd(memo,'Relais depuis '+r.a.p+' : tâche terminée'+((typeof chg!=='undefined'&&chg.length)?', fichiers touchés : '+chg.slice(0,6).join(', '):'')+' ; reprends à la prochaine tâche [ ] (@task next)');saveMemo()}catch{}ch.key=null;chSave(ch)}}catch{}\r\n      try{if(typeof chg!=='undefined'&&chg.length&&api.localVerifyTurn){const vt=await api.localVerifyTurn({root,rels:chg});if(vt&&vt.line){addMsg(ch,{r:'sys',warn:!vt.ok,t:vt.line});if(!vt.ok)memo=memoAdd(memo,vt.line.slice(0,300))}}}catch{}\r\nconst stat=done!==null?'done':asked!==null?'asked':'running';\r\n      stt.rounds.push({n:(stt.n=(stt.n||0)+1),acc:r.a.p,talk:pr.talk.slice(0,200),acts:outs.slice(0,12).map(o=>({ok:o.ok,t:String(o.title).slice(0,80)}))});if(stt.rounds.length>60)stt.rounds.shift();\r\n      try{await api.localState({root,op:'round',acc:r.a.p,talk:pr.talk,acts:outs.map(o=>({ok:o.ok,t:o.title})),results:resNow,status:stat})}catch{}\r\n      if(done!==null){memo=memoAdd(memo,'Fait : '+done);saveMemo();chSave(ch);return}\r\n      if(asked!==null){ch.localPrev=text;chSave(ch);return}\r\n      results=resNow+hint}\r\n    addMsg(ch,{r:'sys',warn:true,t:'Limite de 25 tours atteinte pour cette demande. Écris « continue » pour reprendre.'})},\r\n  async send(p,text,ids,isOver){\r\n    if(!p.local||!p.local.path){toast('Mode local : choisis d\\'abord un dossier de travail (bouton à côté du trombone).');return}\r\n    if(CUR){QUEUE.push({pid:p.id,text,ids});if(!isOver){const i0=$('ch-in');if(i0){i0.value='';autoGrow()}PEND=[];drawChips();DRAFTS[p.id]='';const c0=CH[p.id];if(c0&&c0.draft){c0.draft='';chSave(c0)}}drawQueue();toast('Message mis en file d\\'attente ('+QUEUE.length+')');return}\r\n    if(!window.api||!api.localExec||!api.localConfirm||!api.localUndo||!api.localMemo||!api.localState)return toast('Mode local : relance AI Hub pour activer le moteur (le code principal vient d\\'être mis à jour).');\r\n    const chk=await api.localCheck(p.local.path);if(!chk||!chk.ok)return toast('Le dossier « '+p.local.name+' » est introuvable : choisis-en un autre (menu à côté du trombone).');\r\n    if(SL_RE.test(String(text).trim())&&await slashLocal(p,text,isOver))return;      // commande gratuite : pas besoin de clé\r\n    if(!accs.length)return toast('Ajoute d\\'abord une clé (un compte IA) dans la zone « Clés » à gauche');\r\n    if(p.only&&!accs.some(a=>a.p===p.only))return toast('Aucune clé '+p.only+' : ajoutes-en une ou repasse sur « Toutes les plateformes » (en haut à droite)');\r\n    const pid=p.id;\r\n    if(!isOver){const inp=$('ch-in');inp.value='';autoGrow();PEND=[];drawChips();DRAFTS[pid]='';const c0=CH[pid];if(c0&&c0.draft){c0.draft='';chSave(c0)}PAUSED=false}\r\n    const pf=(ids||[]).map(id=>FILES.find(f=>f.id===id)).filter(Boolean);\r\n    CUR={pid,key:null,cancel:false,t0:Date.now(),act:'Branchement d\\'une clé…',live:''};\r\n    const ch=await chatOf(pid),onl=ch.threads;ch.threads=ch.lthreads||(ch.lthreads={});     // fils séparés : le mode local ne pollue pas les conversations en ligne\r\n    try{addMsg(ch,pf.length?{r:'user',t:text,files:pf.map(f=>f.name),fids:pf.map(f=>f.id)}:{r:'user',t:text});CUR.pfiles=pf;markSent(p,pf).catch(()=>{});setBusy();await LOCAL.loop(p,ch,text)}\r\n    catch(x){try{addMsg(ch,{r:'sys',warn:true,t:'Erreur : '+String(x&&x.message||x).slice(0,160)})}catch{}}\r\n    finally{ch.lthreads=ch.threads;ch.threads=onl;chSave(ch);\r\n      CUR=null;document.querySelectorAll('webview.drv').forEach(v=>v.classList.remove('drv'));setBusy();renderList();if(chatProj===pid)$('ch-in').focus();\r\n      const nx=!PAUSED&&QUEUE.length?QUEUE.shift():null;drawQueue();if(nx)setTimeout(()=>chatSend(nx),600)}}};\r\n// ---- annuler un tour depuis le chat, historique du dossier, capacités souhaitées, réglages ----\r\n$('ch-msgs').addEventListener('click',async e=>{const b=e.target.closest('[data-lun]');if(!b)return;\r\n  const p=P0(chatProj),ch=CH[chatProj];if(!p||!p.local||!ch)return;const m=ch.msgs.find(x=>x.id===b.dataset.lun);if(!m||!m.turn)return;\r\n  if(CUR)return toast('Une réponse est en cours : attends la fin ou clique Arrêter.');\r\n  if(!confirm('Annuler les modifications de ce tour dans le dossier « '+p.local.name+' » ?'))return;\r\n  const r=await api.localUndo({root:p.local.path,turn:m.turn});\r\n  if(r&&r.ok){m.undone=true;chSave(ch);drawMsgs(false);toast('Tour annulé ('+r.n+' modification'+(r.n>1?'s':'')+')')}else toast((r&&r.out)||'Rien à annuler');\r\n  if(r&&r.out&&r.n&&r.out.includes('✕'))addMsg(ch,{r:'sys',warn:true,t:'Annulation partielle',det:r.out})});\r\n// 4.11 (E1) : panneau « Changements » : fichiers touchés par le tour, refus fichier par fichier\r\n$('ch-msgs').addEventListener('click',async e=>{const b=e.target.closest('[data-lchg]');if(!b)return;\r\n  const p=P0(chatProj),ch=CH[chatProj];if(!p||!p.local||!ch)return;const m=ch.msgs.find(x=>x.id===b.dataset.lchg);if(!m||!m.turn)return;\r\n  const bar=b.closest('.lchg'),old=bar.nextElementSibling;if(old&&old.classList.contains('lchp')){old.remove();return}\r\n  if(!api.localTurnDiff)return toast('Relance AI Hub pour activer ce panneau.');\r\n  const r=await api.localTurnDiff({root:p.local.path,turn:m.turn}),fl=(r&&r.files)||[],box=document.createElement('div');\r\n  box.className='lchp';box.dataset.m=m.id;\r\n  box.innerHTML=fl.length?'<div class=\"lchh\"><button type=\"button\" class=\"lund\" data-hall=\"acc\" title=\"Alt+Y\">Tout accepter</button><button type=\"button\" class=\"lund\" data-hall=\"rej\" title=\"Alt+N\">Tout refuser</button></div>'+fl.map(f=>`<div class=\"lchf\"><b title=\"${esc(f.rel)}\">${esc(f.rel)}</b><small>${esc([...new Set(f.ops)].join(', '))}</small><button type=\"button\" class=\"lund\" data-lhk=\"${esc(f.rel)}\" title=\"Voir les blocs modifiés\">Blocs</button><button type=\"button\" class=\"lund\" data-lrej=\"${esc(f.rel)}\">Refuser</button></div>`).join(''):'<p class=\"dim\">Aucun changement enregistré pour ce tour.</p>';\r\n  bar.after(box)});\r\n$('ch-msgs').addEventListener('click',async e=>{const b=e.target.closest('[data-lrej]');if(!b)return;\r\n  const p=P0(chatProj),ch=CH[chatProj],box=b.closest('.lchp');if(!p||!p.local||!ch||!box)return;const m=ch.msgs.find(x=>x.id===box.dataset.m);if(!m||!m.turn)return;\r\n  if(CUR)return toast('Une réponse est en cours : attends la fin ou clique Arrêter.');\r\n  if(!confirm('Refuser les modifications de « '+b.dataset.lrej+' » ?'))return;\r\n  const r=await api.localRejectFile({root:p.local.path,turn:m.turn,rel:b.dataset.lrej});\r\n  if(r&&r.ok){b.closest('.lchf').classList.add('rej');b.replaceWith(Object.assign(document.createElement('em'),{textContent:'refusé'}));toast('Fichier remis comme avant')}else toast((r&&r.out)||'Impossible de refuser')});\r\n// 10.0.26 : diff par bloc : Accepter / Refuser chaque bloc, Tout accepter / Tout refuser (Alt+Y / Alt+N)\r\n{const st=document.createElement('style');st.textContent='.lchh{display:flex;gap:6px;margin-bottom:6px}.lhk{margin:4px 0 8px 10px;border-left:2px solid var(--line2,#888);padding-left:8px}.lhb{margin-bottom:6px}.lhb .ldf{margin:0 0 4px;max-height:200px;overflow:auto}.lhb.acc{opacity:.55}.lhb em{font-size:12px;opacity:.7}';document.head.appendChild(st)}\r\nconst HACC=new Set();\r\nconst hkKey=(rel,h)=>rel+'|'+(h.t||'').length+':'+(h.t||'').slice(0,80);\r\nasync function hkDraw(f,m,p){\r\n  const rel=f.querySelector('[data-lhk]').dataset.lhk,nx=f.nextElementSibling;if(nx&&nx.classList.contains('lhk'))nx.remove();\r\n  let r=null;try{r=await api.localHunks({root:p.local.path,turn:m.turn,rel})}catch{}\r\n  const box=document.createElement('div');box.className='lhk';\r\n  if(!r||!r.ok||r.created||!r.hunks.length)box.innerHTML='<p class=\"dim\">'+esc(!r||!r.ok?((r&&r.out)||'Relance AI Hub pour activer les blocs.'):r.created?'Fichier créé par l\\'IA : refuse-le en entier.':'Aucun bloc : identique à l\\'original.')+'</p>';\r\n  else box.innerHTML=r.hunks.map(h=>{const k=hkKey(rel,h),ac=HACC.has(k);return `<div class=\"lhb${ac?' acc':''}\" data-k=\"${esc(k)}\"><pre class=\"ldf\">${dfHtml(h.t)}</pre>${ac?'<em>accepté</em>':`<button type=\"button\" class=\"lund\" data-hacc=\"1\">Accepter</button><button type=\"button\" class=\"lund\" data-hrej=\"${h.i}\">Refuser</button>`}</div>`}).join('');\r\n  f.after(box)}\r\n$('ch-msgs').addEventListener('click',async e=>{\r\n  const b=e.target.closest('[data-lhk],[data-hacc],[data-hrej],[data-hall]');if(!b)return;\r\n  const p=P0(chatProj),ch=CH[chatProj],pan=b.closest('.lchp');if(!p||!p.local||!ch||!pan)return;\r\n  const m=ch.msgs.find(x=>x.id===pan.dataset.m);if(!m||!m.turn)return;\r\n  if(b.dataset.hall==='acc'){pan.querySelectorAll('.lhb').forEach(x=>HACC.add(x.dataset.k));pan.remove();toast('Changements acceptés');return}\r\n  if(b.dataset.hall==='rej'){const u=pan.previousElementSibling&&pan.previousElementSibling.querySelector('[data-lun]');if(u)u.click();else toast('Rien à annuler');return}\r\n  if(b.dataset.lhk!==undefined){const f=b.closest('.lchf'),nx=f.nextElementSibling;if(nx&&nx.classList.contains('lhk')){nx.remove();return}await hkDraw(f,m,p);return}\r\n  if(b.dataset.hacc){const d=b.closest('.lhb');HACC.add(d.dataset.k);d.classList.add('acc');d.querySelectorAll('button').forEach(x=>x.remove());d.insertAdjacentHTML('beforeend','<em>accepté</em>');return}\r\n  if(b.dataset.hrej!==undefined){\r\n    if(CUR)return toast('Une réponse est en cours : attends la fin ou clique Arrêter.');\r\n    const hk=b.closest('.lhk'),f=hk&&hk.previousElementSibling;if(!f)return;const rel=f.querySelector('[data-lhk]').dataset.lhk;\r\n    const r=await api.localRejectHunk({root:p.local.path,turn:m.turn,rel,i:+b.dataset.hrej});\r\n    if(r&&r.ok){toast('Bloc remis comme avant');await hkDraw(f,m,p)}else toast((r&&r.out)||'Impossible de refuser ce bloc')}});\r\ndocument.addEventListener('keydown',e=>{if(!e.altKey||e.ctrlKey||e.metaKey)return;const k=e.key.toLowerCase();if(k!=='y'&&k!=='n')return;\r\n  const ps=document.querySelectorAll('.lchp'),pan=ps[ps.length-1];if(!pan)return;const b=pan.querySelector('[data-hall=\"'+(k==='y'?'acc':'rej')+'\"]');if(b){e.preventDefault();b.click()}});\r\ntry{$('ch-stop').addEventListener('click',()=>{try{api.localKill&&api.localKill()}catch{}})}catch{}\r\nconst LPANEL={tab:'hist'};\r\nconst fdt=ts=>{try{return new Date(ts).toLocaleString('fr-FR',{day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'})}catch{return ''}};\r\nasync function lpDraw(){const p=P0(chatProj);if(!p||!p.local)return;const root=p.local.path,box=$('lpane'),c=lcfg(p);\r\n  document.querySelectorAll('#dlgL .ltabs button').forEach(b=>b.classList.toggle('on',b.dataset.lt===LPANEL.tab));\r\n  if(LPANEL.tab==='hist'){box.innerHTML='<p class=\"dim\">Chargement…</p>';const h=await api.localHistory({root});\r\n    if(!h||!h.ok){box.innerHTML='<p class=\"dim\">Historique indisponible.</p>';return}\r\n    try{const g=await api.localState({root,op:'get'});h.state=g&&g.st}catch{}\r\n    const rows=h.undo.map(e=>`<div class=\"lh\"><span class=\"lt\">${esc(fdt(e.ts))}</span><b>${esc(e.op)}</b><span class=\"lp\" title=\"${esc(e.rel+(e.rel2?' → '+e.rel2:''))}\">${esc(e.rel+(e.rel2?' → '+e.rel2:''))}</span><button type=\"button\" class=\"btn\" data-lu=\"${esc(e.id)}\">Annuler</button></div>`).join('');\r\n    box.innerHTML=`<p class=\"dim\">Les modifications des fichiers faites par l'IA, de la plus récente à la plus ancienne. Chacune garde l'ancienne version dans <code>.aihub/undo</code>. Les commandes (<code>@run</code>, <code>@script</code>) ne s'annulent pas ici${c.autoGit?' : le point de sauvegarde git est là pour ça':''}.</p>\r\n      ${(()=>{const s=h.state||{},t=s.task;if(!t||!t.text)return '<p class=\"dim\">Reprise : aucun travail en cours.</p>';const fin=t.status==='done';\r\n        return `<details class=\"lj\" ${fin?'':'open'}><summary>Reprise entre comptes : ${fin?'dernière tâche terminée':t.status==='asked'?'l\\'IA attend ta réponse':'travail interrompu, « continue » reprend exactement là'}</summary><pre>${esc('Tâche : '+t.text+(s.plan?'\\nPlan : '+s.plan:'')+'\\n'+(s.rounds||[]).slice(-8).map(x=>x.n+'. '+x.acc+' : '+x.acts.map(a=>(a.ok?'✔ ':'✕ ')+a.t).join(' ; ')).join('\\n'))}</pre><button type=\"button\" class=\"btn\" id=\"lreset\">Repartir à zéro (oublier le fil)</button></details>`})()}\r\n      <div class=\"row l\"><button type=\"button\" class=\"btn\" id=\"lundo\">Annuler le dernier tour</button></div>\r\n      <div class=\"lhl\">${rows||'<p class=\"dim\">Aucune modification pour l\\'instant.</p>'}</div>\r\n      <details class=\"lj\"><summary>Journal des actions (${h.journal.length})</summary><pre>${esc(h.journal.join('\\n')||'(vide)')}</pre></details>`;\r\n    if($('lreset'))$('lreset').onclick=async()=>{if(!confirm('Oublier la tâche, le plan et le fil en cours pour ce dossier ?'))return;await api.localState({root,op:'reset'});toast('Fil remis à zéro');lpDraw()};\r\n    $('lundo').onclick=async()=>{if(CUR)return toast('Une réponse est en cours : attends la fin ou clique Arrêter.');if(!h.undo.length)return toast('Rien à annuler');\r\n      if(!confirm('Annuler toutes les modifications du dernier tour ?'))return;const r=await api.localUndo({root,last:true});toast(r&&r.ok?'Dernier tour annulé':(r&&r.out)||'Rien à annuler');lpDraw()};\r\n    box.querySelectorAll('[data-lu]').forEach(b=>b.onclick=async()=>{if(CUR)return toast('Une réponse est en cours : attends la fin ou clique Arrêter.');const r=await api.localUndo({root,id:b.dataset.lu});toast(r&&r.ok?'Annulé':(r&&r.out)||'Impossible d\\'annuler');lpDraw()})}\r\n  else if(LPANEL.tab==='needs'){\r\n    if(p.local.needs&&p.local.needs.length){for(const n of p.local.needs)await api.localNeeds({root,op:'add',text:n.t});delete p.local.needs;save()}      // reprise des besoins notés en 2.9.0\r\n    const r=await api.localNeeds({root,op:'get'}),L=(r&&r.list)||[];\r\n    box.innerHTML=`<p class=\"dim\">Ce que l'IA a voulu faire sans que le langage le permette (cliquer dans une application, capturer l'écran…). Quand un besoin revient souvent, on ajoute une vraie instruction.</p>\r\n      ${L.length?L.map((n,i)=>`<div class=\"lh\"><span class=\"lt\">${esc(n.at)}</span><span class=\"lp wrap\">${esc(n.t)}</span><button type=\"button\" class=\"btn\" data-ln=\"${i}\">Retirer</button></div>`).join('')+'<div class=\"row l\"><button type=\"button\" class=\"btn\" id=\"lnclear\">Tout effacer</button><button type=\"button\" class=\"btn\" id=\"lncopy\">Copier la liste</button></div>':'<p class=\"dim\">Aucun besoin noté pour l\\'instant.</p>'}`;\r\n    box.querySelectorAll('[data-ln]').forEach(b=>b.onclick=async()=>{await api.localNeeds({root,op:'remove',index:+b.dataset.ln});lpDraw()});\r\n    if($('lnclear'))$('lnclear').onclick=async()=>{await api.localNeeds({root,op:'clear'});lpDraw()};\r\n    if($('lncopy'))$('lncopy').onclick=async()=>{await api.copy(L.map(n=>'- '+n.t).join('\\n'));toast('Liste copiée')}}\r\n  else if(LPANEL.tab==='rules'){\r\n    const rr=await api.localRules({root,op:'get'});\r\n    box.innerHTML=`<p class=\"dim\">Écris une fois les conventions de ce projet : l'IA les reçoit au début de chaque nouvelle conversation (enregistrées dans <code>.aihub/rules.md</code>, 1 500 caractères au plus).</p>\r\n      <label for=\"lrules\">Règles du projet (langage, commandes de test, conventions, style de réponse…)</label>\r\n      <textarea id=\"lrules\" rows=\"8\" maxlength=\"1500\" style=\"width:100%\" placeholder=\"ex. Node 20. Tests : npm test. Pas de nouvelle dépendance. Réponds en français, code et commentaires en anglais.\">${esc((rr&&rr.text)||'')}</textarea>\r\n      <label for=\"lforbid\">Fichiers que l'IA ne doit jamais modifier (un par ligne : un nom, un dossier/ ou un motif comme *.env)</label>\r\n      <textarea id=\"lforbid\" rows=\"4\" style=\"width:100%\" placeholder=\"ex.\\n.env\\nsecrets/\\n*.pem\">${esc(c.forbid||'')}</textarea>\r\n      <p class=\"dim\">Si l'IA tente @write, @edit, @append, @replace, @delete, @move ou @copy sur l'un d'eux, AI Hub refuse sans demander. Les commandes (@run, @script) gardent leur confirmation habituelle : elles ne sont pas filtrées par cette liste.</p>\r\n      <div class=\"row l\"><button type=\"button\" class=\"btn\" id=\"lrsave\">Enregistrer</button></div>`;\r\n    $('lrsave').onclick=async()=>{await api.localRules({root,op:'set',text:$('lrules').value});c.forbid=$('lforbid').value;save();toast('Règles du projet enregistrées')}}\r\n  else{\r\n    box.innerHTML=`<label class=\"inl\"><input type=\"checkbox\" class=\"sw\" data-k=\"trust\"${c.trust?' checked':''}> Mode « Je fais confiance » : tout automatique (sauf commandes dangereuses)</label>\r\n      <label class=\"inl\"><input type=\"checkbox\" class=\"sw\" data-k=\"askWrite\"${c.askWrite?' checked':''}> Demander avant d'appliquer : aperçu en rouge / vert dans le chat, boutons Appliquer / Refuser</label>\r\n      <label class=\"inl\"><input type=\"checkbox\" class=\"sw\" data-k=\"autoGit\"${c.autoGit?' checked':''}> Point de sauvegarde git automatique (si le dossier est un dépôt)</label>\r\n      <label class=\"inl\"><input type=\"checkbox\" class=\"sw\" data-k=\"verify\"${c.verify!==false?' checked':''}> Vérifier automatiquement la syntaxe après chaque modification (JSON, JS, Python, HTML)</label>\r\n      <label class=\"inl\"><input type=\"checkbox\" class=\"sw\" data-n=\"web\"${c.net.web?' checked':''}> @web : lire des pages sans demander</label>\r\n      <label class=\"inl\"><input type=\"checkbox\" class=\"sw\" data-n=\"search\"${c.net.search?' checked':''}> @search : chercher sur le web sans demander</label>\r\n      <label class=\"inl\"><input type=\"checkbox\" class=\"sw\" data-n=\"open\"${c.net.open?' checked':''}> @open : ouvrir fichiers et pages sans demander</label>\r\n      <label for=\"ltime\">Durée maximale d'une commande (secondes)</label><input id=\"ltime\" type=\"number\" min=\"5\" max=\"600\" value=\"${c.timeout}\">\r\n      <label for=\"lign\">Éléments ignorés en plus (noms séparés par des espaces)</label><input id=\"lign\" autocomplete=\"off\" placeholder=\"ex. coverage vendor .idea\" value=\"${esc(c.ignore)}\">\r\n      <label>Commandes toujours autorisées (${c.allow.length})</label>\r\n      ${c.allow.length?c.allow.map((x,i)=>`<div class=\"lh\"><span class=\"lp wrap\">${esc(x)}</span><button type=\"button\" class=\"btn\" data-la=\"${i}\">Retirer</button></div>`).join(''):'<p class=\"dim\">Aucune pour l\\'instant : la fenêtre d\\'autorisation propose « Toujours autoriser ».</p>'}\r\n      <p class=\"dim\">Déjà autorisées d'office : npm test, git status / log / diff, versions des outils. Ignorés d'office : node_modules, .git, dist, build.</p>`;\r\n    const persist=()=>{save();try{api.localCfg({root,cfg:{ignore:lIgnore(c),autoGit:c.autoGit,timeoutSeconds:c.timeout,askBeforeWrite:c.askWrite,verifySyntax:c.verify!==false,trustMode:c.trust}})}catch{}};\r\n    box.querySelectorAll('input[data-k]').forEach(i=>i.onchange=()=>{c[i.dataset.k]=i.checked;persist()});\r\n    box.querySelectorAll('input[data-n]').forEach(i=>i.onchange=()=>{c.net[i.dataset.n]=i.checked;persist()});\r\n    $('ltime').onchange=e=>{c.timeout=Math.max(5,Math.min(600,parseInt(e.target.value,10)||60));e.target.value=c.timeout;persist()};\r\n    $('lign').onchange=e=>{c.ignore=e.target.value.trim();persist()};\r\n    box.querySelectorAll('[data-la]').forEach(b=>b.onclick=()=>{c.allow.splice(+b.dataset.la,1);persist();lpDraw()})}}\r\nfunction openLocalPanel(tab){const p=P0(chatProj);if(!p||!p.local)return toast('Choisis d\\'abord un dossier de travail');\r\n  if(!window.api||!api.localHistory)return toast('Relance AI Hub pour activer le moteur local.');\r\n  LPANEL.tab=tab||'hist';$('ldt').textContent='Dossier local · '+p.local.name;$('dlgL').showModal();lpDraw()}\r\ndocument.querySelectorAll('#dlgL .ltabs button').forEach(b=>b.onclick=()=>{LPANEL.tab=b.dataset.lt;lpDraw()});\r\n$('lclose').onclick=()=>$('dlgL').close();\r\nfunction drawModeChip(){const b=$('ch-mode'),p=P0(chatProj);if(!b||!p)return;const loc=modeOf(p)==='local';\r\n  b.innerHTML=IC(loc?'folder':'globe')+'<span class=\"kl\">'+(loc?'Local'+(p.local?' · '+esc(p.local.name):' · choisir un dossier'):'En ligne')+'</span>';\r\n  b.className='btn ghost'+(loc?' loc':'');\r\n  b.title=loc&&p.local?'Mode local — dossier : '+p.local.path:'Mode du chat : en ligne (tes clés) ou local (un dossier de ton PC)';\r\n  const k=$('ch-key');if(k)k.style.display='';\r\n  const hint=$('ch-hint');if(hint)hint.textContent=loc?'Mode local : l\\'IA lit et modifie le dossier choisi par instructions (sauvegarde avant chaque changement, accord demandé pour les commandes) ; tes clés servent de cerveau et changent toutes seules. Tape /aide : commandes gratuites (0 crédit).':HINT0}\r\nasync function pickLocal(p){if(!window.api||!api.localPick)return false;\r\n  const r=await api.localPick(p.local&&p.local.path);if(!r||!r.ok)return false;\r\n  const old=p.local&&p.local.path;\r\n  if(old&&old!==r.path&&!confirm('Un projet = un dossier. Changer de dossier remet à zéro le fil local de ce projet (le mémo et l\\'historique restent dans l\\'ancien dossier). Continuer ?'))return false;\r\n  const dup=PJ().find(q=>q.id!==p.id&&q.local&&q.local.path===r.path);\r\n  if(dup&&!confirm('Le projet « '+dup.name+' » utilise déjà ce dossier. Un projet = un dossier : continuer quand même ?'))return false;\r\n  if(old&&old!==r.path){const c0=CH[p.id];if(c0){c0.lthreads={};c0.localMemo='';c0.localMemoFor='';c0.lcard={};c0.lhead={};c0.localPrev=null;c0.localTurn=0;chSave(c0)}}\r\n  p.local={path:r.path,name:r.name,cfg:(p.local&&p.local.path===r.path)?p.local.cfg:undefined};p.mode='local';save();drawModeChip();toast('Dossier local : '+r.name);return true}\r\nfunction modeMenu(btn){const p=P0(chatProj);if(!p)return;const loc=modeOf(p)==='local';\r\n  showMenu(btn,`<div class=\"mt\">Mode du chat</div>\r\n    <button data-md=\"online\" class=\"${!loc?'on':''}\">${IC('globe')}<span class=\"tx\">En ligne</span><em>tes clés (comptes IA)</em></button>\r\n    <button data-md=\"local\" class=\"${loc?'on':''}\">${IC('folder')}<span class=\"tx\">Local</span><em>${p.local?esc(p.local.name):'choisir un dossier…'}</em></button>\r\n    ${p.local?`<div class=\"sep\"></div><button data-md=\"hist\"><span class=\"tx\">Historique du dossier…</span><em>annuler</em></button><button data-md=\"undo\"><span class=\"tx\">Annuler le dernier tour</span></button><button data-md=\"rules\"><span class=\"tx\">Règles du projet…</span></button><button data-md=\"needs\"><span class=\"tx\">Capacités souhaitées…</span></button><button data-md=\"cfg\"><span class=\"tx\">Réglages du dossier…</span></button><div class=\"sep\"></div><button data-md=\"pick\"><span class=\"tx\">Changer de dossier…</span></button><button data-md=\"open\"><span class=\"tx\">Ouvrir le dossier</span></button>`:''}`,async e=>{\r\n    const b=e.target.closest('button');if(!b)return;const a=b.dataset.md;closeMenu();\r\n    if(a==='online'){p.mode='online';save();drawModeChip()}\r\n    else if(a==='local'){if(p.local){p.mode='local';save();drawModeChip()}else await pickLocal(p)}\r\n    else if(a==='pick')await pickLocal(p);\r\n    else if(a==='hist'||a==='needs'||a==='cfg'||a==='rules')openLocalPanel(a);\r\n    else if(a==='undo'){if(CUR)return toast('Une réponse est en cours : attends la fin ou clique Arrêter.');if(!window.api||!api.localUndo)return toast('Relance AI Hub pour activer le moteur local.');\r\n      if(!confirm('Annuler toutes les modifications du dernier tour ?'))return;const r=await api.localUndo({root:p.local.path,last:true});toast(r&&r.ok?'Dernier tour annulé':(r&&r.out)||'Rien à annuler')}\r\n    else if(a==='open'&&p.local&&window.api&&api.showItem)api.showItem(p.local.path)})}\r\n$('ch-mode').onclick=e=>{if($('ch-menu').hidden||!MENU||MENU.btn!==e.currentTarget)modeMenu(e.currentTarget);else closeMenu()};\r\nconst msgAct=(m,rid)=>`<div class=\"mact\"><button data-mcp=\"${m.id}\" type=\"button\" title=\"Copier ce message\">${IC('copy')}Copier</button>${rid?`<button data-rr=\"${rid}\" type=\"button\" title=\"Renvoyer ce prompt (même texte, mêmes fichiers) dans un nouveau tour\">${IC('refresh')}Relancer</button>`:''}</div>`;\r\n// ---- passage d'un compte à l'autre : mémo local de secours, inventaire des fichiers, plafond par plateforme ----\r\nconst PLIM={Claude:60000,ChatGPT:60000,Gemini:60000,DeepSeek:50000,Grok:30000,'Le Chat':30000,Perplexity:30000,Copilot:7000};\r\nfunction autoMemo(ch,upto){const ms=ch.msgs.slice(0,upto).filter(m=>m.r!=='sys'&&m.t),us=ms.filter(m=>m.r==='user');if(!us.length)return '';\r\n  const sq=(t,n)=>squeeze(extractCtx(t).text||t,n,false).replace(/\\s+/g,' '),parts=[];\r\n  parts.push('Objectif de départ : '+sq(us[0].t,260));\r\n  if(us.length>1)parts.push('Dernière demande : '+sq(us[us.length-1].t,260));\r\n  const fl=[];for(const m of ms.slice().reverse()){if(m.r!=='ai')continue;for(const id of (m.fids||[])){const f=fById(id);if(f&&!fl.includes(f.name))fl.push(f.name)}if(fl.length>=6)break}\r\n  if(fl.length)parts.push('Fichiers livrés : '+fl.slice(0,6).join(', '));\r\n  return parts.join('\\n')}\r\nfunction manifest(ch){const seen=new Set(),out=[];\r\n  for(let i=ch.msgs.length-1;i>=0&&out.length<12;i--){const m=ch.msgs[i];if(m.r==='sys')continue;\r\n    for(const id of idsOf(m)){if(seen.has(id))continue;seen.add(id);const f=fById(id);if(f)out.push(f.name+(m.r==='user'?' (envoyé)':' (reçu)'))}}\r\n  return out.length?'[FICHIERS DÉJÀ ÉCHANGÉS DANS CETTE CONVERSATION, du plus récent au plus ancien : '+out.join(', ')+']':''}\r\nfunction fileMenu(btn){const p=P0(chatProj);if(!p)return;\r\n  const mine=FILES.filter(f=>f.proj===p.id),others=FILES.filter(f=>f.proj!==p.id).slice(0,40);\r\n  const row=f=>`<button data-fid=\"${f.id}\" class=\"${PEND.includes(f.id)?'on':''}\"><span class=\"tx\">${esc(f.name)}</span><em>${fmtSize(f.size)}</em></button>`;\r\n  const html=FILES.length?((mine.length?'<div class=\"mt\">Fichiers du projet</div>'+mine.map(row).join(''):'')+(others.length?'<div class=\"mt\">Autres fichiers</div>'+others.map(row).join(''):'')):'<div class=\"mt\">Bibliothèque vide</div><button data-act=\"files\"><span class=\"tx\">Ouvrir la bibliothèque de fichiers…</span></button>';\r\n  showMenu(btn,html,e=>{const b=e.target.closest('button');if(!b)return;\r\n    if(b.dataset.act==='files'){closeMenu();filesOpen=true;setOpen=false;render();try{drawFiles(false)}catch{}return}\r\n    const id=b.dataset.fid;if(!id)return;PEND=PEND.includes(id)?PEND.filter(x=>x!==id):PEND.concat(id);drawChips();b.classList.toggle('on',PEND.includes(id))})}\r\n$('ch-att').onclick=e=>{if($('ch-menu').hidden||!MENU||MENU.btn!==e.currentTarget)fileMenu(e.currentTarget);else closeMenu()};\r\n$('ch-copy').onclick=async()=>{const ch=CH[chatProj];if(!ch||!ch.msgs.some(m=>m.r!=='sys'))return toast('Rien à copier pour l\\'instant');\r\n  await api.copy(ch.msgs.filter(m=>m.r!=='sys').map(fmt).join('\\n\\n'));toast('Conversation du projet copiée')};\r\n$('ch-new').onclick=async()=>{const ch=CH[chatProj];if(!ch)return;if(CUR)return toast('Une réponse est en cours : attends la fin ou clique Arrêter.');\r\n  if(!ch.msgs.length)return toast('La conversation est déjà vide');\r\n  if(!confirm('Vider la conversation de ce projet et repartir sur un fil neuf ? (Utilise « Copier » avant si tu veux la garder.)'))return;\r\n  ch.msgs=[];ch.threads={};ch.seen={};ch.ctx=null;ch.fseen={};ch.inst={};ch.partial=null;chSave(ch);drawMsgs(true)};\r\n\r\n// ---------- le moteur : choisir une clé, envoyer, attendre, lire, changer de clé ----------\r\n// ---------- 3.5.0 : mode automatique intelligent, la meilleure IA selon la tâche ----------\r\nconst TASKS={\r\n  code:{n:'Code',d:'Programmer, déboguer, scripts, outils',re:/(bug|d[ée]bog|\\bcode\\b|coder|codage|script|fonction|function|javascript|typescript|python|html|css|sql|react|npm|\\bgit\\b|regex|compil|refactor|algorithm|\\bapi\\b|\\.js\\b|\\.py\\b|\\.html\\b|\\.css\\b|json|exception|stack ?trace|variable|plantage|programme|site web)/g},\r\n  web:{n:'Recherche web / actualité',d:'Infos récentes, sources, prix, météo',re:/(actualit|aujourd'?hui|derni[èe]res? (news|nouvelles|infos)|\\bnews\\b|m[ée]t[ée]o|prix (de|du|d')|cours (de|du|d')|\\bscore\\b|cherche (sur|en ligne)|recherche (sur )?(le )?(web|internet)|\\bsources?\\b|en ce moment|202[5-9]|tendance|derni[èe]re version|qui est le|qui a gagn)/g},\r\n  doc:{n:'Long document / fichiers',d:'Résumer ou analyser des documents, PDF, tableurs',re:/(r[ée]sume (ce|cet|le|la) |analyse (ce|cet|le|la) (document|pdf|fichier|rapport|contrat)|\\bpdf\\b|document joint|fichier joint|tableur|\\bexcel\\b|\\bcsv\\b|contrat|rapport)/g},\r\n  math:{n:'Maths / raisonnement',d:'Calculs, logique, démonstrations',re:/(calcul|\\bmath|[ée]quation|d[ée]riv[ée]|int[ée]grale|probabilit|statistique|th[ée]or[èe]me|d[ée]montr|\\blogique\\b|\\bpuzzle\\b|racine carr|matrice|g[ée]om[ée]tri|combien (font|fait|vaut)|\\d+ ?[+\\-*\\/x×÷] ?\\d+)/g},\r\n  image:{n:'Image',d:'Créer ou décrire des images, logos',re:/((g[ée]n[èe]re|cr[ée]e|dessine|r[ée]alise|imagine|fais)[^.\\n]{0,30}(image|illustration|logo|affiche|photo|dessin|visuel|ic[ôo]ne|banni[èe]re)|\\b(dall-?e|midjourney)\\b)/g},\r\n  trans:{n:'Traduction',d:'Traduire un texte',re:/(traduis|traduire|traduction|translate|en (anglais|espagnol|allemand|italien|portugais|japonais|chinois|arabe|russe|n[ée]erlandais))/g},\r\n  write:{n:'Rédaction',d:'Textes, mails, articles, reformulation',re:/(r[ée]dige|r[ée]diger|[ée]cris|[ée]crire|\\btexte\\b|article|e-?mail|\\bmail\\b|lettre|courrier|\\bpost\\b|linkedin|discours|histoire|nouvelle|po[èe]me|r[ée]sum[ée]|reformul|corrige|slogan|description|\\bblog\\b|newsletter|\\bcv\\b|rewrite|draft|essay|story)/g},\r\n  chat:{n:'Discussion',d:'Questions générales',re:null}\r\n};\r\n// Notes de 0 à 10 par plateforme et par tâche (modifiables dans « Régler les notes par tâche »)\r\nconst SC0={\r\n  Claude:{code:10,write:8,web:5,math:8,doc:8,image:0,trans:7,chat:8},\r\n  ChatGPT:{code:7,write:10,web:8,math:8,doc:7,image:10,trans:9,chat:9},\r\n  Gemini:{code:7,write:7,web:8,math:8,doc:10,image:8,trans:8,chat:7},\r\n  Grok:{code:6,write:6,web:8,math:7,doc:5,image:6,trans:6,chat:7},\r\n  DeepSeek:{code:8,write:5,web:4,math:9,doc:5,image:0,trans:6,chat:6},\r\n  'Le Chat':{code:6,write:7,web:6,math:6,doc:6,image:5,trans:8,chat:7},\r\n  Perplexity:{code:4,write:5,web:10,math:5,doc:5,image:0,trans:5,chat:6},\r\n  Copilot:{code:6,write:6,web:7,math:6,doc:6,image:7,trans:6,chat:6}\r\n};\r\nconst STR={Claude:'code, gros projets, longs textes',ChatGPT:'généraliste, rédaction, images, multimodal',Gemini:'très long contexte, documents, outils Google',Grok:'actualité et données X en temps réel',DeepSeek:'maths, raisonnement et code à bas coût',\"Le Chat\":'français, souveraineté européenne',Perplexity:'recherche web avec sources',Copilot:'Microsoft 365 et Bing'};\r\nconst rcfg=()=>{const r=settings.route=settings.route||{};if(r.on===undefined)r.on=true;if(r.stick===undefined)r.stick=1;if(!r.sc||typeof r.sc!=='object')r.sc={};return r};\r\nconst routeOn=()=>rcfg().on!==false;\r\nconst routeScore=(pf,t)=>{const o=(rcfg().sc[pf]||{})[t];if(typeof o==='number')return o;const d=(SC0[pf]||{})[t];return typeof d==='number'?d:5};\r\nfunction routeTask(ch){\r\n  const lm=[...((ch&&ch.msgs)||[])].reverse().find(m=>m.r==='user'),tx=String((lm&&lm.t)||''),low=tx.toLowerCase();\r\n  const nf=lm?((lm.fids&&lm.fids.length)||(lm.files&&lm.files.length)||0):0;\r\n  const sc={};\r\n  for(const k of Object.keys(TASKS)){const t=TASKS[k];if(!t.re)continue;sc[k]=Math.min(4,(low.match(t.re)||[]).length)}\r\n  if(/\\x60\\x60\\x60/.test(tx))sc.code=(sc.code||0)+3;\r\n  if(nf)sc.doc=(sc.doc||0)+2;\r\n  if(tx.length>6000)sc.doc=(sc.doc||0)+2;\r\n  let best='chat',bs=0;\r\n  for(const k of ['image','code','web','doc','math','trans','write']){if((sc[k]||0)>bs){bs=sc[k];best=k}}\r\n  return {id:best,n:TASKS[best].n}\r\n}\r\nconst routeBadge=ch=>routeOn()&&ch&&ch.route&&TASKS[ch.route.t]?' · '+TASKS[ch.route.t].n:'';\r\nconst routeTag=ch=>routeOn()&&ch&&ch.route&&TASKS[ch.route.t]?' · tâche : '+TASKS[ch.route.t].n:'';\r\nfunction keyOrder(p,ch,skip){\r\n  const base=keyOrderBase(p,ch,skip);\r\n  try{\r\n    if(p.pin||!routeOn()||base.length<2){if(ch&&ch.route)ch.route=null;return base}\r\n    const t=routeTask(ch),cur=find(ch.key),stick=Math.max(0,Number(rcfg().stick)||0);\r\n    ch.route={t:t.id,at:Date.now()};\r\n    const sc=a=>routeScore(a.p,t.id)+(cur&&a.id===cur.id?stick:0);\r\n    return base.map((a,i)=>({a,i})).sort((x,y)=>(sc(y.a)-sc(x.a))||(x.i-y.i)).map(o=>o.a)\r\n  }catch(e){return base}\r\n}\r\nfunction setRoute(mode,p){\r\n  const r=rcfg();r.on=mode!=='simple';if(p)p.pin='';save();\r\n  try{drawKeyChip()}catch{}\r\n  toast(r.on?'Automatique intelligent : AI Hub choisit la meilleure IA selon la tâche':'Automatique simple : AI Hub change de clé seulement quand une limite est atteinte')\r\n}\r\nfunction routeCfg(){\r\n  const r=rcfg(),pf=[...new Set(accs.map(a=>a.p))];\r\n  if(!pf.length){toast(\"Ajoute d'abord une clé (compte IA).\");return}\r\n  let d=document.getElementById('routedlg');\r\n  if(!d){d=document.createElement('dialog');d.id='routedlg';d.className='wide';document.body.appendChild(d)}\r\n  const head='<tr><th></th>'+pf.map(k=>'<th style=\"color:'+(P[k]?P[k][1]:'inherit')+'\">'+esc(k)+'</th>').join('')+'</tr>';\r\n  const rows=Object.keys(TASKS).map(t=>'<tr><td title=\"'+esc(TASKS[t].d)+'\">'+esc(TASKS[t].n)+'</td>'+pf.map(k=>'<td><input type=\"number\" min=\"0\" max=\"10\" step=\"1\" data-k=\"'+esc(k)+'\" data-t=\"'+t+'\" value=\"'+routeScore(k,t)+'\" style=\"width:54px\"></td>').join('')+'</tr>').join('');\r\n  const leg=pf.map(k=>'<b>'+esc(k)+'</b> : '+esc(STR[k]||'')).join(' · ');\r\n  d.innerHTML='<style>.rtab{border-collapse:collapse;font-size:13px}.rtab td,.rtab th{padding:4px 8px;border-bottom:1px solid var(--line);text-align:center}.rtab td:first-child{text-align:left}</style>'\r\n   +'<h3 style=\"margin:0 0 6px\">Automatique : la meilleure IA selon la tâche</h3>'\r\n   +'<p style=\"margin:0 0 10px;color:var(--dim);font-size:13px\">AI Hub devine la tâche de ton message, puis prend la clé disponible (connectée, sans limite) dont la plateforme a la meilleure note. Notes de 0 à 10, modifiables.</p>'\r\n   +'<div style=\"overflow:auto\"><table class=\"rtab\">'+head+rows+'</table></div>'\r\n   +'<p style=\"margin:10px 0;color:var(--dim);font-size:12.5px\">'+leg+'</p>'\r\n   +'<div class=\"opt\"><span><b>Rester sur la plateforme actuelle</b><small>Bonus donné à la clé en cours, pour ne pas changer d\\'IA pour un petit gain. 0 = toujours la meilleure.</small></span><input type=\"number\" id=\"rstick\" min=\"0\" max=\"10\" step=\"1\" value=\"'+r.stick+'\" style=\"width:70px\"></div>'\r\n   +'<div class=\"row\"><button class=\"btn\" id=\"rreset\">Notes par défaut</button><button class=\"btn\" id=\"rcancel\">Annuler</button><button class=\"btn pri\" id=\"rok\">Enregistrer</button></div>';\r\n  d.querySelector('#rcancel').onclick=()=>d.close();\r\n  d.querySelector('#rreset').onclick=()=>{r.sc={};r.stick=1;save();routeCfg()};\r\n  d.querySelector('#rok').onclick=()=>{\r\n    d.querySelectorAll('input[data-k]').forEach(i=>{const k=i.dataset.k,t=i.dataset.t,v=Math.max(0,Math.min(10,Math.round(Number(i.value))));if(!isFinite(v))return;\r\n      if(v===((SC0[k]||{})[t]??5)){if(r.sc[k])delete r.sc[k][t]}else{(r.sc[k]=r.sc[k]||{})[t]=v}});\r\n    r.stick=Math.max(0,Math.min(10,Math.round(Number(d.querySelector('#rstick').value)||0)));\r\n    save();d.close();toast('Notes enregistrées')};\r\n  if(!d.open)d.showModal();\r\n}\r\nfunction keyOrderBase(p,ch,skip){\r\n  const ok=accs.filter(a=>keyOk(a)&&!skip.includes(a.id)&&(!p.only||a.p===p.only)),first=[],pin=find(p.pin),cur=find(ch.key);\r\n  if(pin&&ok.includes(pin))first.push(pin);\r\n  if(cur&&ok.includes(cur)&&!first.includes(cur))first.push(cur);\r\n  const plat=(first[0]&&first[0].p)||(cur&&cur.p)||'';\r\n  return first.concat(ok.filter(a=>!first.includes(a)).sort((x,y)=>((x.p===plat?0:1)-(y.p===plat?0:1))||(((settings.lastUse||{})[x.id]||0)-((settings.lastUse||{})[y.id]||0))))}\r\nfunction addMsg(ch,m){const o={id:mid(),ts:Date.now(),...m};ch.msgs.push(o);chSave(ch);if(chatProj===ch.id)drawMsgs(true);return o}\r\nasync function projCtx(p){\r\n  const parts=[];if(p.desc&&p.desc.trim())parts.push(p.desc.trim());\r\n  try{if(FILES.some(f=>f.proj===p.id)){const r=await projSummary(p);if(r&&r.text)parts.push(r.text)}}catch{}\r\n  return parts.length?`[PROJET « ${p.name} »]\\n`+parts.join('\\n\\n'):''}\r\n// ---------- 2.6.8 : contexte économe entre les comptes ----------\r\n// L'IA tient à jour un mémo d'état [[CTX: …]] en fin de réponse ; au changement de compte on envoie ce mémo\r\n// + les derniers messages, au lieu de tout l'historique. Fichiers : jamais deux fois au même compte, une seule version par famille.\r\nconst CTX_INST=\"[AI Hub : termine chaque réponse par une ligne [[CTX: …]] (400 car. max : objectif, décisions, fichiers livrés + version, reste à faire). Rien après.]\";\r\nfunction extractCtx(t){let last='';const text=String(t||'').replace(/\\[\\[CTX:([\\s\\S]*?)\\]\\]/g,(m,c)=>{c=c.replace(/\\s+/g,' ').trim();if(c.length>=20&&c!=='…')last=c;return ''}).replace(/\\n{3,}/g,'\\n\\n').trimEnd();return {text,ctx:last.slice(0,700)}}\r\nconst stripPartialCtx=t=>String(t||'').replace(/\\[\\[CTX:[\\s\\S]*$/,'').replace(/\\[{1,2}(?:C|CT|CTX)?$/,'').trimEnd();\r\nconst CTXM={eco:{direct:2000,keep:2,u:500,a:800,digest:1000,head:1200,file:2,bytes:2*1048576,sum:0},\r\n            bal:{direct:5000,keep:4,u:1100,a:1900,digest:2600,head:2800,file:3,bytes:8*1048576,sum:1200},\r\n            full:{direct:60000,keep:999,u:1e9,a:1e9,digest:0,head:1e9,file:3,bytes:40*1048576,sum:1e9}};\r\nconst ctxMode=()=>CTXM[(settings.relay&&settings.relay.ctxMode)]?settings.relay.ctxMode:'eco';\r\nconst cfgC=()=>CTXM[ctxMode()];\r\nconst tok=n=>Math.round((n||0)/3.6);\r\nfunction squeeze(t,max,keepCode){let x=String(t||'');\r\n  if(!keepCode)x=x.replace(/```[\\s\\S]*?```/g,m=>{const n=m.split('\\n').length-2;return n>8?'[code : '+n+' lignes omises]':m});\r\n  x=x.replace(/\\n{3,}/g,'\\n\\n').trim();if(x.length<=max)return x;\r\n  const h=Math.floor(max*.6);return x.slice(0,h).trimEnd()+' […] '+x.slice(-(max-h-8)).trimStart()}\r\nfunction histLine(m,c,isLast){const raw=m.t,x=extractCtx(raw).text||raw;\r\n  const names=m.r==='user'?(m.files||[]):(m.fids||[]).map(fById).filter(Boolean).map(f=>f.name);\r\n  return (m.r==='user'?'👤 Moi : ':'🤖 IA : ')+squeeze(x,m.r==='user'?c.u:c.a,ctxMode()==='full')+(names.length?' ['+(m.r==='user'?'joints':'fichiers')+' : '+names.join(', ').slice(0,160)+']':'')}\r\nfunction digestOf(list,c){const out=list.map(({m})=>{const raw=m.t;\r\n    const x=(extractCtx(raw).text||raw).replace(/```[\\s\\S]*?```/g,' ').replace(/\\s+/g,' ').trim(),n=m.r==='user'?160:200;\r\n    return (m.r==='user'?'• Moi : ':'  → IA : ')+x.slice(0,n)+(x.length>n?'…':'')});\r\n  let t=out.join('\\n');if(t.length>c.digest){const h=Math.floor(c.digest*.35);t=t.slice(0,h)+'\\n[… tours intermédiaires omis …]\\n'+t.slice(-(c.digest-h))}return t}\r\nfunction buildHist(ch,a,pendIdx){const c=cfgC(),base=ch.seen[a.id]||0,miss=[];\r\n  for(let i=base;i<pendIdx;i++){const m=ch.msgs[i];if(m&&m.r!=='sys'&&m.t)miss.push({m,i})}\r\n  if(!miss.length)return {body:'',full:0,how:''};\r\n  const full=miss.map(x=>fmt(x.m)).join('\\n\\n').length;\r\n  if(ctxMode()==='full')return {body:null,full,how:'historique complet',miss};\r\n  const last=miss[miss.length-1],lines=miss.map(x=>histLine(x.m,c,x===last)),direct=lines.join('\\n\\n');\r\n  if(direct.length<=c.direct)return {body:direct,full,how:'derniers échanges'};\r\n  const memo=ch.ctx&&ch.ctx.t,covered=memo?Math.min(ch.ctx.at,pendIdx):0,keepN=Math.max(c.keep,2);\r\n  let tail=miss.filter((x,k)=>(memo&&x.i>=covered)||k>=miss.length-keepN);\r\n  let tl=tail.map(x=>histLine(x.m,c,x===last));const cap=Math.round(c.direct*1.4);\r\n  while(tail.length>keepN&&tl.join('\\n\\n').length>cap){tail.shift();tl.shift()}\r\n  const older=miss.filter(x=>!tail.includes(x));let body='';\r\n  if(memo)body+=\"## ÉTAT DU TRAVAIL (mémo tenu à jour par l'IA précédente)\\n\"+memo+'\\n\\n';\r\n  else if(older.length){const am=autoMemo(ch,pendIdx);body+=(am?'## ÉTAT DU TRAVAIL (établi par AI Hub)\\n'+am+'\\n\\n':'')+'## RÉSUMÉ DES ÉCHANGES PRÉCÉDENTS\\n'+digestOf(older,c)+'\\n\\n'}\r\n  body+=(memo?'## DERNIERS MESSAGES\\n':'## DERNIERS ÉCHANGES\\n')+tl.join('\\n\\n');\r\n  return {body,full,how:memo?'mémo + derniers messages':'résumé + derniers échanges'}}\r\nasync function projCtxC(p){if(ctxMode()==='full')return projCtx(p);const c=cfgC(),parts=[];\r\n  if(p.desc&&p.desc.trim())parts.push(p.desc.trim().slice(0,c.head));\r\n  if(c.sum){try{if(FILES.some(f=>f.proj===p.id)){const r=await projSummary(p);if(r&&r.text)parts.push(r.text.slice(0,c.sum))}}catch{}}\r\n  return parts.length?`[PROJET « ${p.name} »]\\n`+parts.join('\\n\\n'):''}\r\nfunction noteSeen(ch,a,fs){const m=ch.fseen=ch.fseen||{},arr=m[a.id]=m[a.id]||[];for(const f of fs||[]){if(f&&f.id&&!arr.includes(f.id))arr.push(f.id)}if(arr.length>300)arr.splice(0,arr.length-300)}\r\nasync function compose(p,ch,a,pendIdx,text,fresh){\r\n  if(CUR&&CUR.local){const L=CUR.local,need=fresh||!(ch.lcard&&ch.lcard[a.id]);CUR.cardFor=need?a.id:null;ch.lastCtx=null;\r\n    const ru=need&&CUR.rules?'RÈGLES DU PROJET (à respecter) :\\n'+CUR.rules.slice(0,(PLIM[a.p]||30000)<=10000?600:1500)+'\\n\\n':'';\r\n    let bd=need?L.full:L.msg,lite=false;\r\n    if(!need&&L.lt){const o=ch.lhead&&ch.lhead[a.id],d=o?L.lt.n-o.n:-1;if(o&&o.h===L.lt.hh&&d>=0&&d<=3){bd=L.lt.lite;lite=true}}   // 4.2.0 : CARTE + ARBRE inchangés et déjà envoyés à cette clé : on ne les renvoie pas\r\n    CUR.headFor=(L.lt&&!lite)?a.id:null;\r\n    return (need?ru+localCard(a.p)+'\\n\\n':'')+bd}\r\n  const R=settings.relay,H=buildHist(ch,a,pendIdx),head=fresh?await projCtxC(p):'';\r\n  const inst=(!ch.inst||!ch.inst[a.id])?CTX_INST:'';\r\n  let body=H.body;\r\n  if(body===null){const miss=H.miss.map(x=>x.m);   // mode « Complet » : comportement d'origine\r\n    body='';const full=miss.map(fmt).join('\\n\\n');\r\n    if(hub.aiEnabled&&R.summary&&full.length>(R.summaryAbove||15000)){toast('Résumé de l\\'historique par Gemini…');\r\n      const sum=await hub.summarize(full,{platform:a.p});if(sum)body='## RÉSUMÉ\\n'+sum+'\\n\\n## DERNIERS ÉCHANGES\\n'+fitTail(miss,6000).text}\r\n    if(!body)body=fit(miss,Math.min(R.maxChars||60000,60000)).text}\r\n  {const lim=PLIM[a.p]||30000;if(body&&body.length>lim)body=body.slice(0,Math.floor(lim*.3))+'\\n[… partie centrale omise (limite de '+a.p+') …]\\n'+body.slice(-Math.floor(lim*.7))}\r\n  let out=head?head+'\\n\\n':'';\r\n  if(body)out+=\"[HISTORIQUE — reprise sur un autre compte par AI Hub : lis, retiens, ne résume pas, ne dis pas bonjour.]\\n--- DÉBUT ---\\n\"+body+\"\\n--- FIN ---\\n\\n\";\r\n  if(body){const mf=manifest(ch);if(mf)out+=mf+'\\n\\n'}\r\n  if(CUR&&CUR.partial)out+=\"[RÉPONSE INTERROMPUE sur la clé précédente (limite atteinte) — voici ce qui avait déjà été écrit :]\\n\"+squeeze(CUR.partial,1500,false)+\"\\n[Reprends la tâche à partir de là, sans tout recommencer ni répéter ce qui est déjà fait.]\\n\\n\";\r\n  out=out?out+'MA DEMANDE :\\n'+text:text;\r\n  if(inst){out+='\\n\\n'+inst;if(CUR)CUR.instFor=a.id}\r\n  ch.lastCtx={chars:Math.max(0,out.length-text.length),full:H.full,how:H.how,body:!!body,txt:(out.indexOf('MA DEMANDE :')>0?out.slice(0,out.indexOf('MA DEMANDE :')).trim():'').slice(0,8000)};\r\n  return out}\r\n// contenu des petits fichiers texte collé dans le message quand la plateforme n'accepte pas les pièces jointes\r\nasync function inlineFiles(fs,a){let out='',tot=0;const names=[];\r\n  for(const f of fs){const e=(extOf(f.name)||'').toLowerCase();\r\n    if(/^(png|jpe?g|gif|webp|bmp|zip|rar|7z|pdf|docx?|xlsx?|pptx?|aihubupdate)$/.test(e)||f.size>24000||tot>48000){names.push(f.name);continue}\r\n    try{const t=await f.blob.text();tot+=t.length;out+='\\n### '+f.name+'\\n```\\n'+t.slice(0,24000)+'\\n```'}catch{names.push(f.name)}}\r\n  if(!out&&!names.length)return '';\r\n  return '\\n\\n[Fichiers non joignables sur '+a.p+(out?' — contenu des fichiers texte :':'')+']'+out+(names.length?'\\n[Non transmis (binaires ou trop gros) : '+names.join(', ')+']':'')}\r\nfunction makeWait(a){const w={started:false,sent:false,done:false,preview:''};\r\n  w.promise=new Promise(res=>{w.fin=r=>{if(w.done)return;w.done=true;clearTimeout(w.t1);clearTimeout(w.t2);if(WAIT[a.id]===w)delete WAIT[a.id];res(r)}});\r\n  w.t1=setTimeout(()=>{if(!w.started&&!w.sent)w.fin('nostart')},45000);\r\n  w.t2=setTimeout(()=>w.fin('timeout'),20*60000);\r\n  w.cancel=()=>w.fin('cancel');WAIT[a.id]=w;return w}\r\nconst _handle=handle;\r\nhandle=function(a,ev){_handle(a,ev);const w=WAIT[a.id];if(!w)return;const t=ev.type;\r\n  if(t==='send-attempt'||t==='message-sent')w.sent=true;\r\n  if(t==='response-started'){w.started=true;w.sent=true}\r\n  if(t==='response-complete'&&(w.started||w.sent)){w.preview=((ev.detail||{}).preview)||'';w.fin('done')}\r\n  else if(t==='limit-hit')w.fin('limit');\r\n  else if(t==='rate-limit'){try{hub.setLimited(a.id,true)}catch{}w.fin('limit')}\r\n  else if(t==='login-required'||t==='session-expired'||t==='google-blocked')w.fin('login')};\r\n// Une clé pilotée par un projet ne déclenche plus l'ancienne reprise automatique (elle collerait dans un autre compte)\r\nconst _onLimit=onLimit;\r\nonLimit=function(a){if(DRV.has(a.id)||(settings.keyIds||[]).includes(a.id)){ping('limit','Limite atteinte',lbl(a)+' — AI Hub change de clé au prochain message',null);return}return _onLimit(a)};\r\n\r\n// 4.12 (G3) : compte avec clé API : appel direct en flux, sans page web. Sans état : chaque appel renvoie tout le contexte utile (carte des instructions, mémo, plan, fil, résultats).\r\nconst apiOn=a=>!!(a&&a.api&&a.api.k&&a.api.on!==false&&(a.p==='Claude'||a.p==='ChatGPT'||a.p==='Gemini')&&window.api&&api.localApiAsk);\r\nlet APIID=0;\r\n// 4.13 (H2) : agents parallèles : une clé API par agent, sans CUR ; verrous .aihub/locks.json (opts.agent) ; tâches réservées une par une\r\nconst WK={run:false,cancel:false,claimed:new Set(),q:Promise.resolve(),ok:0,fail:0,act:{}};\r\nconst WK_OK=new Set(['tree','outline','read','find','grep','stat','ctx','refs','history','diff','write','edit','append','mkdir','task','note','plan','done']);\r\nasync function wkAsk(a,prompt,first){\r\n  if(apiOn(a)){const id='ax'+(++APIID)+Date.now().toString(36);return await api.localApiAsk({id,plat:a.p,key:a.api.k,model:a.api.m||'',prompt,images:[]})}\r\n  const s=stOf(a.id);if(s.limited)return {ok:false,limited:true,error:'limite atteinte sur '+lbl(a)};\r\n  if(s.logged===false)return {ok:false,error:lbl(a)+' est déconnecté'};\r\n  const v=view(a);v.classList.add('drv');DRV.add(a.id);\r\n  try{\r\n    for(let i=0;i<60&&!v._ready;i++)await sleep(250);\r\n    if(!v._ready)return {ok:false,error:'page non prête ('+lbl(a)+')'};\r\n    if(first){await hub.newChat(a);const w0=await waitComposer(a,25000);if(w0!==true)return {ok:false,error:(w0==='login'?'déconnecté : ':'zone de saisie introuvable : ')+lbl(a)};await sleep(1500)}\r\n    let n0=0;try{const c0=await read(a);if(c0.mode==='structured')n0=c0.msgs.length}catch{}\r\n    const W=makeWait(a);let r=await hub.paste(prompt,{account:a,send:false});\r\n    if(!r.len){await sleep(1200);r=await hub.paste(prompt,{account:a,send:false})}\r\n    if(!r.len){W.cancel();return {ok:false,error:'collage impossible sur '+lbl(a)}}\r\n    await sleep(600);await hub.send(a.id);\r\n    const res=await W.promise;\r\n    if(res==='limit'){s.limited=true;s.limAt=Date.now();try{persistLim(a)}catch{}return {ok:false,limited:true,error:'limite atteinte sur '+lbl(a)}}\r\n    if(res==='login')return {ok:false,error:lbl(a)+' est déconnecté'};\r\n    if(res!=='done')return {ok:false,error:'pas de réponse de '+lbl(a)+' ('+res+')'};\r\n    await sleep(900);\r\n    const c=await read(a);let txt='';\r\n    if(c.mode==='structured'&&c.msgs.length>n0){for(let k=c.msgs.length-1;k>=n0;k--){if(c.msgs[k].r==='ai'&&c.msgs[k].t){txt=c.msgs[k].t;break}}}\r\n    if(!txt)return {ok:false,error:'réponse illisible sur '+lbl(a)};\r\n    return {ok:true,text:txt}\r\n  }finally{v.classList.remove('drv');DRV.delete(a.id)}\r\n}\r\nfunction wkClaim(root){const run=async()=>{const r=await api.localExec({root,verb:'task',arg:'next',opts:{}});if(!r||!r.ok)return null;const o=String(r.out||''),k=o.indexOf('PROCHAINES');if(k<0)return null;\r\n  for(const l of o.slice(k).split('\\n').slice(1)){const m=/^(\\d+)\\s+(.*)$/.exec(l.trim());if(m&&!WK.claimed.has(+m[1])){WK.claimed.add(+m[1]);await api.localExec({root,verb:'task',arg:'start '+m[1],opts:{}});return {id:+m[1],t:m[2]}}}return null};\r\n  const p=WK.q.then(run,run);WK.q=p.catch(()=>{});return p}\r\nasync function wkWorker(p,a,i){const root=p.local.path,ag='w'+(i+1),c=lcfg(p);\r\n  while(!WK.cancel){const t=await wkClaim(root);if(!t)break;WK.act[ag]='tâche '+t.id;let results='',fin=false;\r\n    for(let round=0;round<10&&!WK.cancel&&!fin;round++){\r\n      const prompt=LV+'\\nDOSSIER: '+p.local.name+'\\nTu es l\\'AGENT PARALLÈLE '+(i+1)+' : d\\'autres agents travaillent en même temps sur d\\'autres tâches. Ne touche QUE les fichiers de ta tâche (un fichier verrouillé par un autre agent sera refusé). Instructions permises : lectures, @write @edit @append @mkdir, @task, @note, @done (pas de @run ni @delete).\\nTÂCHE '+t.id+' : '+t.t+'\\nQuand elle est terminée : @task done '+t.id+' résumé d\\'une ligne, puis @done.\\n'+localCard(a.p)+(results?'\\nRÉSULTATS:\\n'+results:'');\r\n      const short='RÉSULTATS:\\n'+results+'\\nContinue ta TÂCHE '+t.id+' (lignes @ uniquement, dans UN SEUL bloc de code ```). Quand elle est terminée : @task done '+t.id+' résumé d\\'une ligne, puis @done.';\r\n      let r;try{r=await wkAsk(a,(round===0||apiOn(a))?prompt:short,round===0)}catch(x){r={ok:false,error:String(x&&x.message||x)}}\r\n      if(!r.ok){WK.fail++;try{await api.localExec({root,verb:'task',arg:'todo '+t.id+' agent '+(i+1)+' : '+String(r.error||'erreur API').slice(0,80),opts:{}})}catch{}WK.claimed.delete(t.id);try{await api.localUnlock({root,agent:ag})}catch{}return}\r\n      let q=parseActs(String(r.text||''));if(!q.acts.length&&typeof fixAts==='function')q=parseActs(fixAts(String(r.text||'')));const outs=[];\r\n      for(const x of q.acts){if(WK.cancel)break;if(!WK_OK.has(x.verb)){outs.push('#'+(outs.length+1)+' err '+x.verb+' : non permis pour un agent parallèle');continue}\r\n        if(x.bad){outs.push('#'+(outs.length+1)+' err '+x.bad);break}\r\n        if(x.verb==='done'){fin=true;break}\r\n        if(x.verb==='note'||x.verb==='plan')continue;\r\n        const o=await api.localExec({root,verb:x.verb,arg:x.arg,body:x.body,hasBody:x.hasBody,turn:'w'+ag+Date.now().toString(36),opts:{ignore:lIgnore(c),timeout:c.timeout,verify:c.verify!==false,agent:ag,task:'T'+t.id}});\r\n        outs.push('#'+(outs.length+1)+' '+(o.ok?'ok ':'err ')+o.title+(o.out?'\\n'+String(o.out).slice(0,1500):''));\r\n        if(x.verb==='task'&&o.ok&&/^\\s*done\\b/i.test(x.arg||''))fin=true}\r\n      results=outs.join('\\n').slice(-6000)}\r\n    try{await api.localUnlock({root,agent:ag})}catch{}\r\n    if(fin)WK.ok++;else{WK.fail++;try{await api.localExec({root,verb:'task',arg:'todo '+t.id+' agent '+(i+1)+' : non terminée',opts:{}})}catch{};WK.claimed.delete(t.id)}}\r\n  delete WK.act[ag]}\r\nfunction wkDraw(){const pn=document.getElementById('p-cc');if(!pn)return;let b=document.getElementById('cc-agents');\r\n  if(!b){b=document.createElement('div');b.id='cc-agents';const ref=document.getElementById('cc-api');(ref&&ref.parentNode?ref.parentNode:pn).appendChild(b)}\r\n  const act=Object.entries(WK.act).map(([k,v])=>k+' : '+v).join(' · '),n=(b.querySelector('#wk-n')||{}).value||'2';\r\n  b.innerHTML=`<div class=\"cc-card\" style=\"--i:4\"><h3>Agents parallèles</h3><p class=\"sub\">Plusieurs comptes (par leur page web, ou par API si activée) traitent des tâches indépendantes du plan en même temps, avec verrous de fichiers. Chaque agent lit, écrit des fichiers et clôt sa tâche (pas de commandes).</p><div class=\"cc-btns\"><select id=\"wk-n\">${['1','2','3'].map(x=>`<option${x===n?' selected':''}>${x}</option>`).join('')}</select><button class=\"btn pri\" id=\"wk-go\"${WK.run?' disabled':''}>${WK.run?'En cours…':'Lancer les agents'}</button><button class=\"btn\" id=\"wk-stop\">Arrêter</button></div><p class=\"cc-msg\">${WK.run?esc(act||'démarrage…'):'Prêt. Il faut au moins 2 comptes connectés et sans limite.'}</p></div>`;\r\n  b.querySelector('#wk-go').onclick=()=>wkStart(+b.querySelector('#wk-n').value);\r\n  b.querySelector('#wk-stop').onclick=()=>{WK.cancel=true;toast('Arrêt demandé : les agents finissent leur appel en cours.')}}\r\nsetInterval(()=>{try{const pn=document.getElementById('p-cc');if(pn&&pn.classList.contains('on')&&!(document.activeElement&&document.activeElement.closest&&document.activeElement.closest('#cc-agents')))wkDraw()}catch{}},1500);\r\nconst wkRedraw=()=>{try{wkDraw()}catch{}};\r\nasync function wkStart(n){if(WK.run)return toast('Les agents tournent déjà.');if(CUR)return toast('Attends la fin du tour en cours.');\r\n  const p=P0(chatProj);if(!p||!p.local)return toast('Ouvre d\\'abord un projet en mode local.');\r\n  const ks=accs.filter(x=>!stOf(x.id).limited&&stOf(x.id).logged!==false).slice(0,n);\r\n  if(ks.length<2&&n>1)return toast('Il faut au moins 2 comptes connectés et sans limite (pas besoin de clé API).');\r\n  if(!ks.length)return toast('Aucun compte disponible (limite atteinte ou déconnecté).');\r\n  WK.run=true;WK.cancel=false;WK.ok=0;WK.fail=0;WK.claimed=new Set();wkRedraw();\r\n  const ch=await chatOf(p.id);addMsg(ch,{r:'sys',t:ks.length+' agent(s) parallèle(s) lancé(s) : '+ks.map(lbl).join(', ')+'.'});\r\n  try{await Promise.all(ks.map((a,i)=>wkWorker(p,a,i)))}finally{WK.run=false;try{await api.localUnlock({root:p.local.path})}catch{}\r\n    addMsg(ch,{r:'sys',warn:WK.fail>0,t:'Agents terminés : '+WK.ok+' tâche(s) faite(s), '+WK.fail+' remise(s) à faire.'});chSave(ch);wkRedraw()}}\r\nif(window.api&&api.onApiDelta)api.onApiDelta(d=>{if(CUR&&CUR.apiId===d.id){CUR.live=(CUR.live||'')+d.d;try{liveDraw()}catch{}}});\r\nasync function driveApi(p,ch,a,pendIdx,text,files){\r\n  if(CUR&&CUR.cancel)return {ok:false,cancel:true};\r\n  const s=stOf(a.id);if(s.limited)return {ok:false,reason:'limite atteinte',skip:true};\r\n  const fl=(files||[]).slice(),images=[];let inlineTxt='';\r\n  for(const f of fl){if(/^image\\//.test(f.type||'')&&f.blob&&f.blob.size<=8*1048576){try{images.push({type:f.type,b64:await b64Of(f.blob)})}catch{}}}\r\n  const rest=fl.filter(f=>!/^image\\//.test(f.type||''));\r\n  if(rest.length){try{inlineTxt=await inlineFiles(rest,a)}catch{}}\r\n  setAct('Préparation du message…');\r\n  let msg=await compose(p,ch,a,pendIdx,text+inlineTxt,true);\r\n  if(CUR&&CUR.local)msg+=inlineTxt||'';\r\n  if(CUR){CUR.cardFor=null;CUR.headFor=null;CUR.instFor=null}      // API sans état : rien n'est « déjà envoyé » à cette clé\r\n  if(CUR&&CUR.cancel)return {ok:false,cancel:true};\r\n  const id='ax'+(++APIID)+Date.now().toString(36);CUR.apiId=id;CUR.live='';CUR.steps=[];CUR.raw='';\r\n  setAct(a.p+' répond (API)…');\r\n  const iv=setInterval(()=>{if(CUR&&CUR.cancel){try{api.localApiCancel({id})}catch{}}},400);\r\n  let r;try{r=await api.localApiAsk({id,plat:a.p,key:a.api.k,model:a.api.m||'',prompt:msg,images})}catch(x){r={ok:false,error:String(x&&x.message||x)}}finally{clearInterval(iv)}\r\n  if(CUR)CUR.apiId=null;\r\n  if(r.cancel||(CUR&&CUR.cancel))return {ok:false,cancel:true};\r\n  if(!r.ok){\r\n    if(r.limited){s.limited=true;s.limAt=Date.now();try{persistLim(a)}catch{}return {ok:false,reason:'limite atteinte',partial:r.partial||(CUR&&CUR.live)||''}}\r\n    if(r.auth)return {ok:false,reason:'clé API refusée ('+a.p+') : vérifie-la dans Paramètres > Centre de contrôle',skip:true};\r\n    return {ok:false,reason:'API : '+String(r.error||'erreur').slice(0,160),skip:true,partial:r.partial||''}}\r\n  const reply=String(r.text||'').trim();\r\n  if(!reply)return {ok:false,reason:'API : réponse vide',skip:true};\r\n  const sp=splitAct(reply);let memo='';{const ex=extractCtx(sp.text);if(ex.text.trim())sp.text=ex.text;memo=ex.ctx}\r\n  const outText=cleanFiles(sp.text,[])||reply;\r\n  return {ok:true,reply:outText,steps:sp.steps,fids:[],warn:'',ctx:memo,sent:files||[],raw:reply}}\r\nasync function driveKey(p,ch,a,pendIdx,text,files){\r\n  if(apiOn(a))return await driveApi(p,ch,a,pendIdx,text,files);\r\n  const v=view(a);v.classList.add('drv');DRV.add(a.id);\r\n  if(!(settings.keyIds||[]).includes(a.id)){(settings.keyIds=settings.keyIds||[]).push(a.id);save()}\r\n  try{\r\n    for(let i=0;i<60&&!v._ready;i++)await sleep(250);\r\n    if(!v._ready)return {ok:false,reason:'page non prête',skip:true};\r\n    if(CUR&&CUR.cancel)return {ok:false,cancel:true};\r\n    // 1. ouvrir le bon fil : celui du projet sur cette clé, sinon une nouvelle conversation\r\n    setAct('Ouverture de la conversation sur '+lbl(a)+'…');const url=ch.threads[a.id];let cur='';try{cur=v.getURL()}catch{}\r\n    if(url){if(cur.split('#')[0]!==url.split('#')[0]){v.loadURL(url);await new Promise(r=>{v.addEventListener('did-stop-loading',r,{once:true});setTimeout(r,20000)})}}\r\n    else await hub.newChat(a);\r\n    const w0=await waitComposer(a,25000);\r\n    if(w0===true)await sleep(400);\r\n    const s=stOf(a.id);\r\n    if(w0!==true||s.limited||s.logged===false)return {ok:false,reason:(w0==='login'||s.logged===false)?'déconnectée':s.limited?'limite atteinte':'page non prête',skip:true};\r\n    let fresh=!url;\r\n    if(url){let u2='';try{u2=v.getURL()}catch{}if(!isChatUrl(u2)){fresh=true;delete ch.threads[a.id];ch.seen[a.id]=0}}\r\n    if(CUR&&CUR.cancel)return {ok:false,cancel:true};\r\n    // 1b. relais : l'historique est renvoyé par compose(), les fichiers récents + ceux de la question sont rejoints ici\r\n    let sendFiles=files,relayNote=[];\r\n    if(ch.msgs.slice(0,pendIdx).some(m=>m.r!=='sys')){try{const rf=relayFiles(p,ch,text,files,pendIdx,a,fresh);if(rf.extra.length){sendFiles=rf.files;relayNote=rf.extra.map(f=>f.name)}}catch{}}\r\n    // 2. fichiers joints (si la plateforme ne les accepte pas : contenu des petits fichiers texte collé dans le message)\r\n    let inlineTxt='';\r\n    if(sendFiles.length){setAct('Envoi des fichiers ('+sendFiles.length+')…');let failed=false;\r\n      try{const items=[];for(const f of sendFiles)items.push({b64:await b64Of(f.blob),name:f.name,type:f.type||''});\r\n        const r=await v.executeJavaScript(ATTACH_MANY_JS+'('+JSON.stringify(items)+')');\r\n        if(r==='none'){failed=true;addMsg(ch,{r:'sys',warn:true,t:`Fichiers non joints : pas de zone de message trouvée sur ${lbl(a)}`})}else await sleep(1800)}\r\n      catch(x){failed=true;addMsg(ch,{r:'sys',warn:true,t:'Fichiers non joints : '+String(x&&x.message||x).slice(0,80)})}\r\n      if(failed){try{inlineTxt=await inlineFiles(sendFiles,a)}catch{}}}\r\n    // 3. message (+ contexte du projet / historique manquant) puis envoi\r\n    setAct('Préparation du message…');\r\n    const msg=await compose(p,ch,a,pendIdx,(relayNote.length?text+'\\n\\n[Fichiers joints automatiquement pour reprendre le contexte : '+relayNote.join(', ')+']':text)+inlineTxt,fresh);\r\n    {const L0=ch.lastCtx;if(L0&&(L0.body||relayNote.length)){addMsg(ch,{r:'sys',t:'Relais vers '+lbl(a)+' : '+(L0.body?'contexte ≈ '+tok(L0.chars)+' tokens'+(L0.full>L0.chars*1.3?' (au lieu de ≈ '+tok(L0.full)+')':'')+' · '+L0.how:'')+(relayNote.length?(L0.body?' · ':'')+'fichiers : '+relayNote.join(', ').slice(0,100):'')+'.',det:L0.txt||''})}}\r\n    setAct('Envoi du message…');let n0=0;CUR.steps=[];CUR.raw='';\r\n    {const [c0,sb,dl]=await Promise.all([read(a).catch(()=>null),snapOutputs(ch,a,v,fresh).catch(()=>undefined),v.executeJavaScript(DL_COUNT_JS).catch(()=>0)]);\r\n      if(c0&&c0.mode==='structured')n0=c0.msgs.length;CUR.before=sb;CUR.dl0=dl||0}\r\n    let W=makeWait(a),r=await hub.paste(msg,{account:a,send:false});\r\n    if(!r.len){await sleep(500);r=await hub.paste(msg,{account:a,send:false})}\r\n    if(!r.len){W.cancel();return {ok:false,reason:'collage impossible',skip:true}}\r\n    await sleep(150);await hub.send(a.id);\r\n    setAct(a.p+' réfléchit…');let res=await waitLive(W,a,n0);\r\n    if(res==='nostart'){      // l'envoi par Entrée n'a rien déclenché : on clique le bouton Envoyer\r\n      W=makeWait(a);\r\n      try{await v.executeJavaScript(`(()=>{const b=document.querySelector(${JSON.stringify(okSel(a,'send'))});if(b)b.click()})()`)}catch{}\r\n      res=await waitLive(W,a,n0);if(res==='nostart')return {ok:false,reason:'envoi impossible',skip:true}}\r\n    if(res==='cancel')return {ok:false,cancel:true};\r\n    if(res==='limit')return {ok:false,reason:'limite atteinte',partial:(CUR&&CUR.live)||W.preview||''};\r\n    if(res==='login')return {ok:false,reason:'session expirée',skip:true};\r\n    if(res==='timeout')return {ok:false,reason:'pas de réponse après 20 min',skip:true};\r\n    // 4. lire la réponse\r\n    setAct('Lecture de la réponse…');await sleep(250);\r\n    if(stOf(a.id).limited)return {ok:false,reason:'limite atteinte',partial:(CUR&&CUR.live)||W.preview||''};\r\n    let reply='';\r\n    for(let i=0;i<8&&!reply;i++){try{const c=await read(a);if(c.mode==='structured'){const l=c.msgs[c.msgs.length-1];if(l&&l.r==='ai'&&l.t)reply=l.t}}catch{}if(!reply)await sleep(300)}\r\n    if(!reply&&CUR&&CUR.raw)reply=CUR.raw;   // 10.0.29 : repli sur la derniere lecture en direct\r\n    if(!reply)LOG.unshift({ts:Date.now(),acc:a.p+' · '+a.n,type:'selector-warning',detail:'reponse non relue : ajoute des selecteurs de secours (Parametres > Reprise)'});\r\n    if(!reply)reply=(W.preview?W.preview+' […]\\n\\n':'')+'(AI Hub n\\'a pas pu relire la réponse complète sur cette clé : ouvre la clé dans la zone « Clés » pour la voir en entier, ou règle les sélecteurs dans Paramètres > Reprise.)';\r\n    try{const u=v.getURL();if(isChatUrl(u))ch.threads[a.id]=u}catch{}\r\n    setAct('Sauvegarde des fichiers…');\r\n    let H={ids:[],names:[],n:0,err:''},memo='';const hint=!(CUR&&CUR.local)&&/télécharger|download|sandbox:|fichiers?\\s+(partag|créé|présent)/i.test(reply);\r\n    for(let k=0;k<(CUR&&CUR.local?0:3);k++){try{H=await harvest(p,ch,a,v)}catch(x){H={ids:[],names:[],n:0,err:String(x&&x.message||x)}}\r\n      if(H.ids.length||!hint||a.p!=='Claude')break;setAct('Récupération du fichier présenté par Claude…');await sleep(2500)}\r\n    if(!H.ids.length&&hint){setAct('Téléchargement des fichiers depuis la page de '+a.p+'…');\r\n      try{const D=await harvestDom(p,ch,a,v,CUR.dl0||0);if(D.length)H={ids:D,names:D.map(id=>(fById(id)||{}).name).filter(Boolean),n:D.length,err:''};else H.err2=(D.notes||'')+(D.total!=null?' · boutons « Télécharger » sur la page : '+D.total+' (avant l\\'envoi : '+(CUR.dl0||0)+')':'')}catch(x){H.err2=String(x&&x.message||x).slice(0,80)}}\r\n    const warn=!H.ids.length&&hint?(a.p==='Claude'?'Claude a présenté un fichier mais AI Hub ne l\\'a pas récupéré':a.p+' semble avoir proposé un fichier, mais AI Hub ne l\\'a pas récupéré')+(H.err?' ('+H.err+')':'')+(H.err2?' · capture : '+H.err2:'')+'. '+(a.p==='Claude'?'Ouvre la clé dans la zone « Clés » pour le télécharger à la main.':'Ouvre la clé dans la zone « Clés » pour le télécharger à la main.'):'';\r\n    const sp=splitAct(reply);{const ex=extractCtx(sp.text);if(ex.text.trim())sp.text=ex.text;memo=ex.ctx}\r\n    let outText=cleanFiles(sp.text,H.names);if(!outText)outText=H.ids.length>1?'Voici les fichiers :':H.ids.length?'Voici le fichier :':reply;\r\n    return {ok:true,reply:outText,steps:sp.steps,fids:H.ids,warn,ctx:memo,sent:sendFiles,raw:reply}\r\n  }finally{setTimeout(()=>DRV.delete(a.id),30000)}}\r\n\r\n// ================= 2.6.4 : reprise de contexte, texte en direct, file d'attente, fichiers échangés =================\r\nconst QUEUE=[];let PAUSED=false;\r\nconst THUMB={};\r\nconst thumbOf=f=>THUMB[f.id]||(THUMB[f.id]=URL.createObjectURL(f.blob));\r\nconst fById=id=>FILES.find(f=>f.id===id)||TRASH.find(f=>f.id===id);\r\nconst idsOf=m=>m.fids||(m.files||[]).map(n=>{const f=FILES.find(x=>x.name===n);return f&&f.id}).filter(Boolean);\r\nconst SAVED={};\r\nconst kindCls=f=>{const e=(extOf(f.name)||'').toLowerCase();return /^(png|jpe?g|gif|webp|svg|bmp)$/.test(e)?'img':/^(zip|rar|7z|tar|gz)$/.test(e)?'zip':/^(pdf)$/.test(e)?'pdf':/^(docx?|odt|rtf)$/.test(e)?'doc':/^(xlsx?|csv|ods)$/.test(e)?'xls':/^(pptx?)$/.test(e)?'ppt':/^(py|js|ts|jsx|tsx|html?|css|json|java|c|cpp|cs|sh|bat|md|txt|aihubupdate|yml|yaml|xml)$/.test(e)?'code':'file'};\r\nconst fcx=f=>{const im=iconKind(f)==='image',ext=(extOf(f.name)||'fichier').toUpperCase();\r\n  return `<div class=\"fcx ${kindCls(f)}\" data-fx=\"${f.id}\"><div class=\"fcx-pv\">${im?`<img src=\"${thumbOf(f)}\" alt=\"\">`:`<span>${esc(ext.slice(0,5))}</span>`}</div><div class=\"fcx-b\"><b title=\"${esc(f.name)}\">${esc(f.name)}</b><small>${esc(ext)} · ${fmtSize(f.size)}${SAVED[f.id]?' · enregistré':''}</small></div><div class=\"fcx-a\"><button class=\"fcx-btn pri\" data-fxd=\"${f.id}\" type=\"button\">${IC('dl')}Télécharger</button>${SAVED[f.id]?`<button class=\"fcx-btn\" data-fxs=\"${f.id}\" type=\"button\">Afficher</button>`:`<button class=\"fcx-btn\" data-fxo=\"${f.id}\" type=\"button\">Aperçu</button>`}</div></div>`};\r\nconst fcards=ids=>{const fs=(ids||[]).map(fById).filter(Boolean);return fs.length?`<div class=\"mfc\">${fs.map(fcx).join('')}${fs.length>1?`<button class=\"fcx-all\" data-fxall=\"${fs.map(f=>f.id).join(',')}\" type=\"button\">${IC('dl')}Tout télécharger (${fs.length})</button>`:''}</div>`:''};\r\n$('ch-msgs').addEventListener('click',async e=>{\r\n  const mc=e.target.closest('[data-mcp]');if(mc){const c0=CH[chatProj],m0=c0&&c0.msgs.find(x=>x.id===mc.dataset.mcp);if(m0){try{await api.copy(m0.t)}catch{}const o=mc.innerHTML;mc.textContent='Copié';setTimeout(()=>{mc.innerHTML=o},1200)}return}\r\n  const rr=e.target.closest('[data-rr]');if(rr){rerun(rr.dataset.rr);return}\r\n  const d=e.target.closest('[data-fxd]');if(d){e.stopPropagation();dlFile(fById(d.dataset.fxd));return}\r\n  const s=e.target.closest('[data-fxs]');if(s){const p=SAVED[s.dataset.fxs];if(p&&window.api&&api.showItem)api.showItem(p);return}\r\n  const o=e.target.closest('[data-fxo]');if(o){openPrev(o.dataset.fxo);return}\r\n  const all=e.target.closest('[data-fxall]');if(all){for(const id of all.dataset.fxall.split(',')){dlFile(fById(id));await sleep(500)}return}\r\n  const c=e.target.closest('[data-fx]');if(c)openPrev(c.dataset.fx)});\r\naddEventListener('hub-saved',e=>{try{if(e.detail&&e.detail.id)SAVED[e.detail.id]=e.detail.path;drawMsgs(false)}catch{}});\r\n\r\n// ---------- tri : étapes de Claude / réponse / carte de fichier de la page ----------\r\n// 2.7.0 : ce que fait l'IA (titres de réflexion, durées, outils) est séparé de sa vraie réponse, pour toutes les plateformes\r\nconst NZ_DUR=/^\\d+(?:[.,]\\d+)?\\s*(?:s|sec|secs|secondes?|min|m)$/i;\r\nconst NZ_RUN=/^(?:en cours d['’]exécution|exécution en cours|running|in progress)$/i;\r\nconst NZ_CMD=/^(?:(?:a\\s+)?(?:exécuté|lancé)\\s+(?:une|un|\\d+)\\s+commandes?|(?:ran|executed)\\s+(?:a|an|\\d+)\\s+commands?)$/i;\r\nconst NZ_TIME=/^(?:maintenant|à l['’]instant|just now|now|il y a\\s+\\d+\\s*(?:s|sec|secondes?|min|minutes?|h|heures?|j|jours?)|\\d+\\s*(?:s|sec|seconds?|min|minutes?|h|hours?|d|days?)\\s+ago)$/i;\r\nconst NZ_GLY=/^[\\s\\u200b-\\u200f\\u2028-\\u202f\\u25a0-\\u25ff\\ue000-\\uf8ff\\ufffd\\u2190-\\u21ff]+$/;\r\nconst NZ_ROLE=/^(?:(?:chatgpt|gemini|claude|copilot|grok|deepseek|mistral|le chat|perplexity)\\s+(?:said|a dit|dit)|you said|vous avez dit|tu as dit|(?:afficher|masquer|show|hide)\\s+(?:le\\s+|la\\s+)?(?:raisonnement|réflexion|thinking|reasoning|thoughts?))\\s*:?$/i;   // libellés cachés ajoutés par certains sites\r\nconst NZ_THINK=/^(?:(?:a\\s+)?(?:réfléchi|pensé|raisonné|thought|reasoned|thinking)\\b[^.!?\\n]{0,70}\\b\\d+\\s*(?:s|sec|secs|seconds?|secondes?|min|minutes?)\\b[^.!?\\n]{0,14}|(?:deepthink|réflexion approfondie|pensée profonde)\\b[^.!?\\n]{0,40}|(?:réflexion|raisonnement|thinking|reasoning|analyse|searching|recherche|reading|lecture|browsing|navigation|searched|recherché)\\b[^.!?\\n]{0,50}(?:en cours|in progress|terminée?|done|\\.{3}|…))$/i;\r\nconst NZ_CHUNK=/^(?:a\\s+|et\\s+)?(?:exécuté|lu\\b|lire\\b|lecture|mémoire|fichiers?\\b|recherch|créé|consulté|modifié|une commande|\\d+\\s+(?:outils?|commandes?|fichiers?|pages?)|ran\\b|read\\b|searched|created|edited|used\\b|viewed)/i;\r\nconst NZ_ONE=/^(?:a\\s+exécuté|exécuté|mémoire\\s+(?:lue|mise)|fichiers?\\s+(?:créé|partagé|présenté)|lu\\s+\\d|lire\\s+\\d|ran\\s|read\\s+\\d|searched|created\\s)/i;\r\nconst NZ_V='(?:utilisé|listé|parcouru|vérifié|écrit|supprimé|déplacé|copié|installé|lancé|ouvert|chargé|récupéré|analysé|inspecté|affiché|testé|compilé|construit|édité|enregistré|généré|trouvé|cherché|exécuté|visité|navigué|mis à jour|lu|créé|modifié|consulté|recherché)';\r\nconst NZ_C2=new RegExp('^(?:(?:a|ont|et)\\\\s+)?'+NZ_V+'\\\\b','i');\r\nconst isSumm=l=>(l.length<170&&l.split(/,\\s*/).every(c=>NZ_CHUNK.test(c.trim()))&&(l.includes(',')||NZ_ONE.test(l)))||(l.length<120&&!/[.!?:;]$/.test(l.trim())&&/^(?:a|ont)\\s/i.test(l.trim())&&l.split(/,\\s*|\\s+et\\s+/).every(c=>NZ_C2.test(c.trim())));\r\nfunction splitAct(t){\r\n  const L=String(t||'').replace(/\\r/g,'').replace(/[\\u200b-\\u200f\\u2060\\ufeff]/g,'').replace(/\\u00a0/g,' ').split('\\n'),T=l=>l.trim();\r\n  const kind=L.map(l=>{const x=T(l);return !x?'blank':(NZ_DUR.test(x)||NZ_RUN.test(x)||NZ_CMD.test(x)||NZ_TIME.test(x)||NZ_GLY.test(l)||NZ_ROLE.test(x))?'noise':NZ_THINK.test(x)?'think':isSumm(x)?'summ':'text'});\r\n  // un titre de réflexion = la ligne de texte juste avant une durée (« 19 s ») ou « en cours d'exécution »\r\n  for(let i=0;i<L.length;i++){if(kind[i]!=='noise'||!(NZ_DUR.test(T(L[i]))||NZ_RUN.test(T(L[i]))))continue;\r\n    let j=i-1;while(j>=0&&(kind[j]==='noise'||kind[j]==='blank'))j--;if(j>=0&&kind[j]==='text')kind[j]='title'}\r\n  // le même titre répété (en-tête + ligne courante) n'est jamais du texte de réponse\r\n  const tset=new Set(L.filter((l,i)=>kind[i]==='title').map(l=>T(l).toLowerCase()));\r\n  for(let i=0;i<L.length;i++)if(kind[i]==='text'&&tset.has(T(L[i]).toLowerCase()))kind[i]='title';\r\n  const steps=[],seenS=new Set();let summ='';\r\n  for(let i=0;i<L.length;i++){if(kind[i]==='title'||kind[i]==='summ'||kind[i]==='think'){const x=T(L[i]),k=x.toLowerCase();if(!seenS.has(k)){seenS.add(k);steps.push(x)}if(kind[i]==='summ')summ=x}}\r\n  const running=L.some((l,i)=>kind[i]==='noise'&&NZ_RUN.test(T(l)));\r\n  let prev='';const keep=[];\r\n  for(let i=0;i<L.length;i++){if(kind[i]==='blank'){keep.push(L[i]);continue}if(kind[i]!=='text')continue;\r\n    const k=T(L[i]).toLowerCase();if(k.length>=8&&k===prev)continue;prev=k;keep.push(L[i])}\r\n  return {steps:steps.filter(s=>s.length>1),text:cleanCards(keep.join('\\n').replace(/\\n{3,}/g,'\\n\\n').trim()),summ,running}}\r\nfunction cleanCards(t){                                                  // « Titre / EXT / Télécharger » copié depuis la carte de la page de Claude\r\n  const L=String(t||'').split('\\n'),out=[];\r\n  const isDl=s=>/^(télécharger( tout)?|download( all)?)$/i.test(s.trim());\r\n  for(let i=0;i<L.length;i++){\r\n    if(isDl(L[i])){ // retire aussi la ligne « EXT » et le titre juste avant\r\n      while(out.length&&!out[out.length-1].trim())out.pop();\r\n      if(out.length&&/^[A-Z0-9]{2,12}$/.test(out[out.length-1].trim())){out.pop();while(out.length&&!out[out.length-1].trim())out.pop();\r\n        if(out.length&&out[out.length-1].trim().length<=90&&!/[.!?:]$/.test(out[out.length-1].trim()))out.pop()}\r\n      continue}\r\n    out.push(L[i])}\r\n  return out.join('\\n').replace(/\\n{3,}/g,'\\n\\n').trim()}\r\nfunction cleanFiles(t,names){let L=String(t||'').split('\\n');const nn=s=>s.toLowerCase().replace(/[^a-z0-9àâçéèêëîïôûùüÿ]+/g,'');\r\n  const bad=new Set();(names||[]).forEach(n=>{const base=n.replace(/\\.[^.]+$/,'');bad.add(nn(n));bad.add(nn(base))});\r\n  return L.filter(l=>!(l.trim()&&l.trim().length<=120&&bad.has(nn(l)))).join('\\n').replace(/\\n{3,}/g,'\\n\\n').trim()}\r\nconst stepsHtml=st=>st&&st.length?`<details class=\"steps\"><summary>${IC('swap')}<span>${st.length} étape${st.length>1?'s':''} de Claude</span></summary>${st.map(s=>`<div class=\"st\"><i>✓</i><span>${esc(s)}</span></div>`).join('')}</details>`:'';\r\n\r\n// ---------- activité en direct ----------\r\nfunction actText(){if(!CUR)return '';const s=Math.max(0,Math.round((Date.now()-(CUR.t0||Date.now()))/1000));return (CUR.act||'Branchement d\\'une clé…')+(s>=3?' · '+s+' s':'')}\r\nfunction setAct(t){if(!CUR)return;if(t)CUR.act=t;const s=document.querySelector('#ch-act span');if(s)s.textContent=actText()}\r\nsetInterval(()=>{if(CUR)setAct()},1000);\r\nfunction liveHtml(k){let h='';const st=CUR.steps||[];\r\n  const shown=CUR.live?st:st.slice(0,-1);if(shown.length)h+=`<div class=\"stk\">${shown.map(s=>`<div class=\"st\"><i>✓</i><span>${esc(s)}</span></div>`).join('')}</div>`;\r\n  if(CUR.live)h+=`<div class=\"m a live\" id=\"ch-live\"><div class=\"mk\"><i class=\"dot\" style=\"background:${k&&P[k.p]?P[k.p][1]:'var(--acc)'}\"></i>${esc(k?lbl(k):'IA')}</div><div class=\"b\">${liveBody(CUR.live)}</div></div>`;\r\n  return h+`<div class=\"ch-typing\" id=\"ch-act\"><i class=\"spin\"></i><span>${esc(actText())}</span></div>`}\r\nfunction liveDraw(){if(!CUR||CUR.pid!==chatProj)return;const box=$('ch-msgs'),el=$('ch-live');\r\n  if(!el)return drawMsgs(false);\r\n  const near=box.scrollHeight-box.scrollTop-box.clientHeight<170;\r\n  el.querySelector('.b').innerHTML=liveBody(CUR.live);setAct();\r\n  if(near)box.scrollTop=box.scrollHeight}\r\nasync function waitLive(W,a,n0){let busy=false,stop=false;\r\n  const tick=async()=>{if(busy||stop||W.done||!CUR)return;\r\n    if(W.started&&!CUR.live&&!(CUR.steps||[]).length)setAct(a.p+' réfléchit…');\r\n    if(!W.started)return;busy=true;\r\n    try{const c=await read(a);if(c.mode==='structured'&&c.msgs.length>n0){const l=c.msgs[c.msgs.length-1];\r\n      if(l&&l.r==='ai'&&l.t&&CUR&&l.t!==CUR.raw){CUR.raw=l.t;const sp=splitAct(l.t),was=(CUR.steps||[]).length,first=!CUR.live&&!!stripPartialCtx(sp.text);\r\n        CUR.steps=sp.steps;CUR.live=stripPartialCtx(sp.text);\r\n        CUR.act=CUR.live?a.p+' écrit…'+(sp.summ?' · '+sp.summ:''):(sp.steps.length?a.p+' · '+sp.steps[sp.steps.length-1]+(sp.running?' (exécution…)':''):CUR.act);\r\n        if(first||sp.steps.length!==was)drawMsgs(true);else liveDraw()}}}catch{}\r\n    busy=false};\r\n  const iv=setInterval(tick,1100);\r\n  try{return await W.promise}finally{stop=true;clearInterval(iv)}}\r\n\r\n// ---------- reprise de contexte : fichiers renvoyés à la nouvelle clé ----------\r\nfunction relayFiles(p,ch,text,explicit,upto,a,fresh){\r\n  const c=cfgC(),none={files:explicit,extra:[]};\r\n  if(!fresh&&!(ch.fseen&&ch.fseen[a.id]))return none;          // fil existant d'avant la 2.6.8 : on ne renvoie pas de fichiers au hasard\r\n  const seen=new Set(fresh?[]:(ch.fseen[a.id]||[])),from=fresh?0:(ch.seen[a.id]||0);\r\n  const ids=[],note=id=>{if(id&&!ids.includes(id))ids.push(id)},rec=new Set();\r\n  for(let i=Math.min(upto,ch.msgs.length)-1;i>=from;i--)idsOf(ch.msgs[i]).slice().reverse().forEach(note);\r\n  {let n=0;for(let i=Math.min(upto,ch.msgs.length)-1;i>=0&&n<2;i--){if(ch.msgs[i].r==='sys')continue;n++;idsOf(ch.msgs[i]).forEach(x=>rec.add(x))}}\r\n  const exch=ids.map(fById).filter(f=>f&&!f.del),have=new Set(explicit.map(f=>f.id)),low=text.toLowerCase(),extra=[];\r\n  const fam=f=>f.name.toLowerCase().replace(/\\.[a-z0-9]{1,12}$/,'').replace(/[\\d._\\-\\s]+/g,'');\r\n  const fams=new Set(explicit.map(fam));\r\n  const pool=exch.concat(FILES.filter(f=>f.proj===p.id&&!exch.includes(f)&&!f.del));\r\n  // 1. obligatoires : les fichiers cités dans la question (même déjà envoyés : la question en a besoin)\r\n  for(const f of pool){if(have.has(f.id))continue;const n=f.name.toLowerCase(),b=n.replace(/\\.[a-z0-9]{1,12}$/,'');\r\n    if(low.includes(n)||(b.length>=4&&low.includes(b))){extra.push(f);have.add(f.id);fams.add(fam(f))}}\r\n  // 2. récents : la version la plus récente de chaque famille, jamais ce que ce compte a déjà reçu, images seulement si elles sont toutes récentes\r\n  let k=0;for(const f of exch){if(k>=c.file)break;if(have.has(f.id)||seen.has(f.id))continue;\r\n    if(fams.has(fam(f)))continue;if(iconKind(f)==='image'&&!rec.has(f.id)&&ctxMode()!=='full')continue;\r\n    extra.push(f);have.add(f.id);fams.add(fam(f));k++}\r\n  let tot=explicit.reduce((s,f)=>s+f.size,0);const keep=[];\r\n  for(const f of extra){if(tot+f.size>c.bytes)continue;tot+=f.size;keep.push(f)}\r\n  return {files:explicit.concat(keep),extra:keep}}\r\n\r\n// ---------- sauvegarde automatique des fichiers donnés / générés ----------\r\nasync function markSent(p,files){let ch=false;\r\n  for(const f of files){const inProj=!!projOf(f);if(f.dir&&inProj)continue;\r\n    try{await FDB.put({...f,dir:f.dir||'sent',proj:inProj?f.proj:p.id});ch=true}catch{}}\r\n  if(ch)try{await loadFiles(false)}catch{}}\r\nconst WG='/mnt/user-data/outputs/';\r\nconst wgKey=(conv,f)=>conv+'|'+f.path+'|'+(f.created_at||'')+'|'+(f.size||0);\r\nconst listCode=conv=>`(async()=>{const C=${JSON.stringify(conv)};\r\n  const J=async u=>{const r=await fetch(u,{credentials:'include',headers:{accept:'application/json'}});if(!r.ok)throw new Error('HTTP '+r.status);return r.json()};\r\n  const orgs=await J('/api/organizations');const l=(Array.isArray(orgs)?orgs:[]).slice().sort((x,y)=>((y.capabilities||[]).includes('chat')?1:0)-((x.capabilities||[]).includes('chat')?1:0));\r\n  let err='';\r\n  for(const o of l){const base='/api/organizations/'+o.uuid+'/conversations/'+C+'/wiggle/list-files';\r\n    for(const q of ['?prefix='+encodeURIComponent('/mnt/user-data/outputs/'),'?prefix=']){\r\n      try{const r=await J(base+q);const fm=Array.isArray(r.files_metadata)&&r.files_metadata.length?r.files_metadata:(r.files||[]).map(p=>({path:typeof p==='string'?p:(p&&p.path)}));\r\n        return {org:o.uuid,files:fm.filter(f=>f&&f.path)}}catch(e){err=String(e&&e.message||e)}}}\r\n  throw new Error(err||'aucune organisation')})()`;\r\nconst getCode=(org,conv,path)=>`(async()=>{const r=await fetch('/api/organizations/'+${JSON.stringify(org)}+'/conversations/'+${JSON.stringify(conv)}+'/wiggle/download-file?path='+encodeURIComponent(${JSON.stringify(path)}),{credentials:'include'});\r\n  if(!r.ok)throw new Error('HTTP '+r.status);const bl=await r.blob();\r\n  const b64=await new Promise((ok,ko)=>{const fr=new FileReader();fr.onload=()=>ok(String(fr.result).split(',')[1]||'');fr.onerror=ko;fr.readAsDataURL(bl)});\r\n  return {b64,size:bl.size}})()`;\r\nconst convOf=(ch,a)=>{const m=/\\/chat\\/([0-9a-f-]{36})/.exec(ch.threads[a.id]||'');return m&&m[1]};\r\nasync function snapOutputs(ch,a,v,fresh){            // photo des fichiers déjà présents avant l'envoi : ce qui apparaît ensuite est « nouveau »\r\n  if(a.p!=='Claude')return null;if(fresh)return new Set();\r\n  const conv=convOf(ch,a);if(!conv)return new Set();\r\n  try{const L=await v.executeJavaScript(listCode(conv));return new Set((L.files||[]).filter(f=>f.path.startsWith(WG)).map(f=>wgKey(conv,f)))}catch{return null}}\r\nconst DL_FIND=\"const dlBtns=()=>{const ok=e=>{const t=(e.textContent||'').replace(/\\\\s+/g,' ').trim();return /^(télécharger|download)(\\\\s+(le|la|les|the|ce|cette|this)?\\\\s*(fichier|file|document|tout|all|zip|pdf|image)s?)?$/i.test(t)||(e.tagName==='A'&&(/^sandbox:/i.test(e.getAttribute('href')||'')||(e.hasAttribute('download')&&t.length<80)))};const all=[...document.querySelectorAll('button,a,[role=button]')].filter(ok);return all.filter(e=>!all.some(o=>o!==e&&e.contains(o)))};\";\r\nconst DL_COUNT_JS='(()=>{'+DL_FIND+'return dlBtns().length})()';\r\nfunction domCaptureJs(skip){return `(async()=>{${DL_FIND}\r\n const grabs=[],blobUrl=new Map();\r\n const oCreate=URL.createObjectURL,oClick=HTMLAnchorElement.prototype.click,oOpen=window.open,oDisp=EventTarget.prototype.dispatchEvent;\r\n const isDl=(el,h)=>el&&el.tagName==='A'&&(el.hasAttribute('download')||blobUrl.has(h)||/download|wiggle|\\\\/files\\\\//i.test(h));\r\n URL.createObjectURL=function(o){const u=oCreate.apply(this,arguments);try{if(o instanceof Blob)blobUrl.set(u,o)}catch(e){}return u};\r\n HTMLAnchorElement.prototype.click=function(){const h=this.href||'';if(isDl(this,h)){grabs.push({href:h,name:this.getAttribute('download')||''});return}return oClick.apply(this,arguments)};\r\n EventTarget.prototype.dispatchEvent=function(ev){try{if(ev&&ev.type==='click'&&this instanceof HTMLAnchorElement){const h=this.href||'';if(isDl(this,h)){grabs.push({href:h,name:this.getAttribute('download')||''});return true}}}catch(e){}return oDisp.apply(this,arguments)};\r\n window.open=function(u){grabs.push({href:String(u||''),name:''});return null};\r\n const out=[],notes=[],wait=async n0=>{for(let i=0;i<40&&grabs.length===n0;i++)await new Promise(r=>setTimeout(r,100))};\r\n try{\r\n  const btns=dlBtns().slice(${skip});\r\n  for(const b of btns){\r\n   let t='',lab='',el=b;for(let i=0;i<7&&el&&!t;i++){el=el.parentElement;if(!el)break;const ls=(el.innerText||'').split('\\\\n').map(x=>x.trim()).filter(x=>x&&!/^(télécharger|download)$/i.test(x)&&!/^[\\\\u25a0-\\\\u25ff\\\\ue000-\\\\uf8ff\\\\ufffd]+$/.test(x));if(ls.length>=1&&ls.length<=4){t=ls[0];lab=ls[1]||''}}\r\n   const n0=grabs.length;b.click();await wait(n0);\r\n   if(grabs.length===n0){await new Promise(r=>setTimeout(r,300));const mi=[...document.querySelectorAll('[role=menuitem],[role=option]')].find(e=>/télécharger|download/i.test(e.textContent||''));if(mi){mi.click();await wait(n0)}}\r\n   if(grabs.length===n0){notes.push('clic sans téléchargement : '+(t||'?'));continue}\r\n   const g=grabs[grabs.length-1];let blob=blobUrl.get(g.href),name=g.name;\r\n   if(!blob){try{const r=await fetch(g.href,{credentials:'include'});if(!r.ok){notes.push((t||'?')+' : HTTP '+r.status);continue}\r\n       const cd=r.headers.get('content-disposition')||'',m=cd.match(/filename\\\\*?=(?:UTF-8'')?\"?([^\";]+)\"?/i);if(m&&!name)name=decodeURIComponent(m[1]);blob=await r.blob()}catch(e){notes.push((t||'?')+' : '+String(e&&e.message||e).slice(0,40));continue}}\r\n   if(blob.size>${MAXF}){notes.push((t||'?')+' : trop gros');continue}\r\n   const u8=new Uint8Array(await blob.arrayBuffer());let s='';for(let i=0;i<u8.length;i+=0x8000)s+=String.fromCharCode.apply(null,u8.subarray(i,i+0x8000));\r\n   out.push({name,title:t,label:lab,type:blob.type||'',b64:btoa(s)})}\r\n }finally{URL.createObjectURL=oCreate;HTMLAnchorElement.prototype.click=oClick;window.open=oOpen;EventTarget.prototype.dispatchEvent=oDisp}\r\n return {files:out,notes,total:dlBtns().length}})()`}\r\nasync function harvestDom(p,ch,a,v,dl0){\r\n  const m=/\\/chat\\/([0-9a-f-]{36})/.exec(ch.threads[a.id]||'');\r\n  const r=await v.executeJavaScript(domCaptureJs(dl0||0)),ids=[];\r\n  for(const f of r.files||[]){\r\n    let name=f.name;\r\n    if(!name){const t=(f.title||'fichier').trim(),lab=(f.label||'').trim();name=/\\.[A-Za-z0-9]{1,10}$/.test(t)?t:t.replace(/\\s+/g,'-')+(/^[A-Za-z0-9]{1,12}$/.test(lab)?'.'+lab.toLowerCase():'')}\r\n    name=cleanName(name);\r\n    const id='scan-'+fnv([a.id,'dom',(m&&m[1])||'',name,(f.b64||'').length].join('|')),ex=FILES.find(x=>x.id===id);\r\n    if(!ex){const blob=b64Blob(f.b64,f.type||MIME[extOf(name).toLowerCase()]||'application/octet-stream');if(!blob.size||blob.size>MAXF)continue;\r\n      await FDB.put({id,name,type:blob.type,size:blob.size,added:Date.now(),proj:p.id,dir:'recv',blob,src:{p:'Claude',acc:a.n,conv:p.name,kind:'created'}})}\r\n    else if(ex.dir!=='recv'||!projOf(ex))await FDB.put({...ex,dir:'recv',proj:projOf(ex)?ex.proj:p.id});\r\n    ids.push(id)}\r\n  ids.notes=(r.notes||[]).join(' · ');ids.total=r.total;\r\n  if(ids.length){try{await loadFiles(false)}catch{}}\r\n  return ids}\r\nasync function harvest(p,ch,a,v,opt){opt=opt||{};\r\n  if(a.p!=='Claude')return {ids:[],names:[],n:0,err:''};\r\n  const conv=convOf(ch,a);if(!conv)return {ids:[],names:[],n:0,err:'conversation introuvable sur cette clé'};\r\n  let L;try{L=await v.executeJavaScript(listCode(conv))}catch(x){return {ids:[],names:[],n:0,err:String(x&&x.message||x)}}\r\n  const files=(L.files||[]).filter(f=>f.path.startsWith(WG)&&f.path.length>WG.length).sort((x,y)=>String(x.created_at).localeCompare(String(y.created_at)));\r\n  const before=(CUR&&CUR.before)||null,t0=(CUR&&CUR.t0)||Date.now(),ids=[],names=[];let err='';\r\n  for(const f of files.slice(-40)){\r\n    const name=cleanName(f.path.slice(WG.length).split('/').pop()),key=wgKey(conv,f),id='wg-'+fnv(key);\r\n    const created=before?!before.has(key):(Date.parse(f.created_at||'')||0)>=t0-180000;\r\n    const have=FILES.find(x=>x.id===id)||TRASH.find(x=>x.id===id);\r\n    if(!created&&!opt.all)continue;\r\n    if(!have){\r\n      if(f.size>MAXF){err='fichier trop gros : '+name;continue}\r\n      try{const r=await v.executeJavaScript(getCode(L.org,conv,f.path)),ext=extOf(name).toLowerCase(),blob=b64Blob(r.b64,MIME[ext]||f.content_type||'application/octet-stream');\r\n        if(!blob.size){err='fichier vide : '+name;continue}\r\n        await FDB.put({id,name,type:blob.type,size:blob.size,added:Date.now(),proj:p.id,dir:'recv',blob,src:{p:'Claude',acc:a.n,conv:p.name,kind:'created',path:f.path}})}\r\n      catch(x){err=name+' : '+String(x&&x.message||x);continue}}\r\n    else if(have.dir!=='recv'||!projOf(have))await FDB.put({...have,dir:'recv',proj:projOf(have)?have.proj:p.id});\r\n    if(created){ids.push(id);names.push(name)}}\r\n  if(ids.length||opt.all){try{await loadFiles(false)}catch{}}\r\n  return {ids,names,n:files.length,err}}\r\n\r\n// ---------- file d'attente ----------\r\nconst qb=document.createElement('div');qb.id='ch-queue';qb.hidden=true;$('ch-bar').insertBefore(qb,$('ch-chips'));\r\nfunction drawQueue(){qb.hidden=!QUEUE.length;\r\n  qb.innerHTML=QUEUE.length?`<div class=\"qh\"><span>${IC('swap')}${QUEUE.length} message${QUEUE.length>1?'s':''} en file${PAUSED?' · en pause':''}</span><span class=\"sp\"></span>${PAUSED&&!CUR?'<button data-qgo type=\"button\">Reprendre</button>':''}<button data-qclr type=\"button\">Vider</button></div>`\r\n    +QUEUE.map((m,i)=>`<div class=\"qi\"><i>${i+1}</i><span>${esc(m.text.slice(0,100))}</span>${m.ids.length?`<em>${IC('clip')}${m.ids.length}</em>`:''}${m.pid!==chatProj&&P0(m.pid)?`<em>${esc(P0(m.pid).name)}</em>`:''}<b data-qrm=\"${i}\" title=\"Retirer de la file\">${IC('x')}</b></div>`).join(''):''}\r\nqb.onclick=e=>{const rm=e.target.closest('[data-qrm]');\r\n  if(rm){QUEUE.splice(+rm.dataset.qrm,1);drawQueue();return}\r\n  if(e.target.closest('[data-qclr]')){QUEUE.length=0;PAUSED=false;drawQueue();return}\r\n  if(e.target.closest('[data-qgo]')&&!CUR&&QUEUE.length){PAUSED=false;const nx=QUEUE.shift();drawQueue();chatSend(nx)}};\r\n\r\n// ---------- 4.8.0 : panneau Tâches (cocher, Pause/Reprise) ----------\r\nconst tkb=document.createElement('div');tkb.id='ch-tasks';tkb.hidden=true;tkb.style.cssText='max-height:220px;overflow:auto;padding:6px 10px;border:1px solid rgba(128,128,128,.3);border-radius:10px;margin:6px 0;font-size:12px';$('ch-bar').insertBefore(tkb,$('ch-chips'));\r\nlet TKLIVE=null;\r\nasync function drawTasks(){const p=P0(chatProj);if(!p||!p.local){tkb.hidden=true;return}\r\n  let o=null;let stp='';try{const g=await api.localState({root:p.local.path,op:'get'});stp=((g&&g.st&&g.st.plan)||'').trim()}catch{}try{o=await api.localExec({root:p.local.path,verb:'task',arg:'list -a',opts:{}})}catch{}\r\n  const rows=String((o&&o.out)||'').split('\\n').map(l=>l.match(/^(\\d+) \\[(.)\\] (.*)$/)).filter(Boolean),run=!!CUR&&CUR.pid===p.id;\r\n  tkb.innerHTML=(stp?`<div style=\"margin-bottom:6px;opacity:.85\"><b>Plan</b> : ${esc(stp.slice(0,400))}</div>`:'')+`<div style=\"display:flex;gap:8px;align-items:center;margin-bottom:4px\"><b>Tâches</b><span class=\"sp\"></span>${run?`<button data-tkpause type=\"button\">${CUR.pause?'Reprendre':'Pause'}</button>`:''}<button data-tkclose type=\"button\">Fermer</button></div>`\r\n   +(rows.length?rows.map(m=>`<label style=\"display:flex;gap:6px;padding:2px 0${m[2]==='x'?';opacity:.6':''}\"><input type=\"checkbox\" data-tkid=\"${m[1]}\" ${m[2]==='x'?'checked':''}><span>${m[1]} ${m[2]==='~'?'▶ ':m[2]==='!'?'⚠ ':''}${esc(m[3])}</span></label>`).join(''):'<p class=\"dim\">Aucune tâche.</p>')}\r\ntkb.onclick=async e=>{const p=P0(chatProj);if(!p||!p.local)return;\r\n  if(e.target.closest('[data-tkclose]')){tkb.hidden=true;return}\r\n  if(e.target.closest('[data-tkpause]')&&CUR){CUR.pause=!CUR.pause;toast(CUR.pause?'Pause : le tour en cours se termine, puis AI Hub attend':'Reprise');try{drawStat()}catch{}drawTasks();return}\r\n  const cb=e.target.closest('[data-tkid]');if(cb){try{await api.localExec({root:p.local.path,verb:'task',arg:(cb.checked?'done ':'todo ')+cb.dataset.tkid,opts:{}})}catch{}drawTasks();try{drawStat()}catch{}}};\r\ndocument.addEventListener('click',e=>{if(e.target.closest('[data-tkp]')){tkb.hidden=!tkb.hidden;if(!tkb.hidden)drawTasks()}});\r\n\r\n\r\nasync function runTurn(p,ch,text,files){\r\n  const pendIdx=ch.msgs.length-1,skip=[],tried=new Set();let last='';\r\n  for(let n=0;n<=accs.length;n++){\r\n    const a=keyOrder(p,ch,skip)[0];\r\n    if(!a){addMsg(ch,{r:'sys',warn:true,t:accs.length?`Aucune clé ${p.only?p.only+' ':''}disponible${last?' ('+last+')':''}. ${p.only?`Mode « ${p.only} seul » : choisis « Toutes les plateformes » en haut à droite pour utiliser les autres, ou attends`:'Attends'} la fin d'une limite, reconnecte une clé ou ajoutes-en une.`:'Aucune clé : ajoute un compte IA dans la zone « Clés » à gauche.'});return false}\r\n    if(ch.key&&ch.key!==a.id){const o=find(ch.key);addMsg(ch,{r:'sys',t:`Clé changée : ${o?lbl(o):'—'} → ${lbl(a)}${last?' ('+last+')':''}${routeTag(ch)}`})}\r\n    ch.key=a.id;CUR.key=a.id;chSave(ch);drawKeyChip();renderList();drawMsgs(true);\r\n    const r=await driveKey(p,ch,a,pendIdx,text,files);\r\n    if(r.ok){(settings.lastUse=settings.lastUse||{})[a.id]=Date.now();save();CUR.live='';CUR.act='';addMsg(ch,{r:'ai',t:r.reply,k:{id:a.id,p:a.p,n:a.n},fids:r.fids||[],steps:r.steps||[]});if(r.ctx)ch.ctx={t:r.ctx,at:ch.msgs.length,by:a.id};if(CUR&&CUR.instFor===a.id)(ch.inst=ch.inst||{})[a.id]=1;noteSeen(ch,a,(r.sent||[]).concat((r.fids||[]).map(fById)));CUR.partial='';if(r.warn)addMsg(ch,{r:'sys',warn:true,t:r.warn});CUR.steps=[];ch.seen[a.id]=ch.msgs.length;chSave(ch);\r\n      if(!(showChat()&&chatProj===p.id&&document.hasFocus()))ping('done','Projet « '+p.name+' » : réponse prête',r.reply.replace(/\\s+/g,' ').slice(0,110),null);\r\n      return true}\r\n    if(r.cancel){addMsg(ch,{r:'sys',t:'Envoi interrompu.'});return false}\r\n    if(r.skip&&!tried.has(a.id)&&/page non prête|collage impossible/.test(r.reason||'')){tried.add(a.id);setAct('Nouvel essai sur '+lbl(a)+'…');try{view(a).reload()}catch{}await sleep(2500);n--;continue}\r\n    const s=stOf(a.id);\r\n    last=(r.reason==='limite atteinte'?'limite atteinte sur '+lbl(a)+(s.until?' jusqu\\'à '+hm(s.until):''):lbl(a)+' : '+(r.reason||'échec'));\r\n    if(r.partial&&r.partial.length>120)CUR.partial=r.partial;\r\n    skip.push(a.id)}\r\n  return false}\r\n\r\nconst lastAiIdx=arr=>{for(let k=arr.length-1;k>=0;k--)if(arr[k].r==='ai')return k;return -1};\r\nconst prevUserId=(arr,i)=>{for(let k=i-1;k>=0;k--)if(arr[k].r==='user')return arr[k].id;return ''};\r\nfunction rerun(id){const ch=CH[chatProj];if(!ch)return;const m=ch.msgs.find(x=>x.id===id&&x.r==='user');if(!m)return;\r\n  const ids=(m.fids||[]).filter(i=>FILES.some(f=>f.id===i));\r\n  toast(CUR?'Prompt relancé : mis en file d\\'attente':'Prompt relancé');chatSend({pid:chatProj,text:m.t,ids})}\r\nasync function chatSend(over){\r\n  const pid=over?over.pid:chatProj,p=P0(pid);if(!p)return;\r\n  const inp=$('ch-in'),ids=over?over.ids:PEND.slice();let text=over?over.text:inp.value.trim();\r\n  if(!text&&ids.length)text=ids.length>1?'Regarde les fichiers joints.':'Regarde le fichier joint.';if(!text)return;\r\n  if(!over){text=slInline(p,text);text=slFlags(p,text);if(modeOf(p)==='local'&&p.local&&p.local.path){text=menInject(p,text);if(settings.ctxAuto!==false&&!SL_RE.test(String(text).trim())){try{const e=window.hub380&&hub380.edCtx&&hub380.edCtx();\r\n    if(e&&String(text).indexOf('@'+e.rel)<0){text+='\\n\\n[FICHIER OUVERT dans l\\'éditeur d\\'AI Hub : '+e.rel+(e.line?(e.end>e.line?' (sélection lignes '+e.line+'-'+e.end+')':' (curseur ligne '+e.line+')'):'')+(e.dirty?' · modifications non enregistrées dans l\\'éditeur':'')+'. Lis-le avec @read si besoin.]'+(e.sel?'\\nSÉLECTION :\\n'+e.sel:'')}}catch{}}}}\r\n  if(modeOf(p)==='local')return LOCAL.send(p,text,ids,!!over);\r\n  if(!accs.length)return toast('Ajoute d\\'abord une clé (un compte IA) dans la zone « Clés » à gauche');\r\n  if(p.only&&!accs.some(a=>a.p===p.only))return toast('Aucune clé '+p.only+' : ajoutes-en une ou repasse sur « Toutes les plateformes » (en haut à droite)');\r\n  if(!over){inp.value='';autoGrow();PEND=[];drawChips();DRAFTS[pid]='';{const c0=CH[pid];if(c0&&c0.draft){c0.draft='';chSave(c0)}}}\r\n  if(CUR){QUEUE.push({pid,text,ids});drawQueue();toast('Message mis en file d\\'attente ('+QUEUE.length+')');return}\r\n  if(!over)PAUSED=false;\r\n  CUR={pid,key:null,cancel:false,t0:Date.now(),act:'Branchement d\\'une clé…',live:''};\r\n  try{\r\n    const ch=await chatOf(pid),files=ids.map(id=>FILES.find(f=>f.id===id)).filter(Boolean);\r\n    addMsg(ch,{r:'user',t:text,files:files.map(f=>f.name),fids:files.map(f=>f.id)});setBusy();\r\n    await markSent(p,files);\r\n    await runTurn(p,ch,text,files)}\r\n  catch(x){try{addMsg(await chatOf(pid),{r:'sys',warn:true,t:'Erreur : '+String(x&&x.message||x).slice(0,160)})}catch{}}\r\n  finally{CUR=null;document.querySelectorAll('webview.drv').forEach(v=>v.classList.remove('drv'));setBusy();renderList();if(chatProj===pid)$('ch-in').focus();\r\n    const nx=!PAUSED&&QUEUE.length?QUEUE.shift():null;drawQueue();if(nx)setTimeout(()=>chatSend(nx),600)}}\r\n$('ch-stop').onclick=async()=>{if(!CUR)return;CUR.cancel=true;if(QUEUE.length){PAUSED=true;drawQueue();toast('File d\\'attente en pause : clique sur Reprendre pour la relancer')}const a=find(CUR.key);\r\n  if(a){try{await view(a).executeJavaScript(`(()=>{const b=document.querySelector(${JSON.stringify(okSel(a,'stop'))});if(b)b.click()})()`)}catch{}\r\n    const w=WAIT[a.id];if(w)w.cancel()}};\r\n\r\n// ---------- branchement sur l'interface existante ----------\r\nconst _render=render;\r\nrender=function(){\r\n  if(!chatInit&&ready){chatInit=true;lastActive=active;const pj=PJ();chatProj=P0(settings.lastProj)?settings.lastProj:(pj[0]&&pj[0].id)||null}\r\n  else if(active!==lastActive){if(chatInit&&!quiet)keyRaw=true;lastActive=active}\r\n  _render();\r\n  const sc=showChat(),none=chatInit&&!sc&&!keyRaw&&!setOpen&&!filesOpen;\r\n  $('chat').classList.toggle('on',sc);\r\n  if(sc||none){$('empty').style.display=sc?'none':'grid';document.querySelector('.hbtns').style.visibility='hidden'}\r\n  if(sc){const p=P0(chatProj);if(window.u5Crumb)$('title').innerHTML=window.u5Crumb(p);else $('title').textContent='AI Hub';if(!wasOn||drawnFor!==chatProj)drawChat()}\r\n  else if(none)$('title').textContent='AI Hub';\r\n  if(none)document.querySelectorAll('webview.on').forEach(v=>v.classList.remove('on'));\r\n  wasOn=sc;renderProjs()};\r\nconst _renderList=renderList;\r\nrenderList=function(){_renderList();\r\n  const k=showChat()&&CH[chatProj]&&CH[chatProj].key;\r\n  if(k){const r=document.querySelector(`#list .acc[data-id=\"${k}\"]`);if(r)r.classList.add('inuse')}\r\n  renderProjs();if(chatProj&&!$('chat').hidden)drawKeyChip()};\r\nconst _af=attachFile;attachFile=function(f,a,o){if(!(o&&o.stay))keyRaw=true;return _af.apply(this,arguments)};\r\nconst _afs=attachFiles;attachFiles=function(f,a,o){if(!(o&&o.stay))keyRaw=true;return _afs.apply(this,arguments)};\r\n// Cliquer sur une clé dans la liste = voir sa vraie page (pour te connecter) ; cliquer sur un projet = revenir au chat\r\n$('list').addEventListener('click',e=>{\r\n  if(e.target.closest('[data-del],[data-ren]')){quiet=true;setTimeout(()=>quiet=false,1500);return}\r\n  if(e.target.closest('.acc')&&!e.target.closest('[data-q]'))keyRaw=true},true);\r\n$('add').lastChild&&($('add').lastChild.textContent='Ajouter une clé');\r\n\r\ntry{if(typeof ready!=='undefined'&&ready)setTimeout(()=>{try{render()}catch(x){console.error('rendu initial',x)}},0)}catch{}   // 7.0 : init() a déjà rendu avec l'ancien render : on relance le rendu complet (projets, chat) dès que ce module est branché\r\nwindow.hub260={_t:{splitAct,cleanFiles,cleanCards,stepsHtml,snapOutputs,relayFiles,drawQueue,fcards,liveHtml,harvest,markSent,QUEUE:()=>QUEUE,setCur:v=>{CUR=v}},send:chatSend,version:CV,projects:()=>PJ().map(p=>({id:p.id,name:p.name})),chat:pid=>CH[pid]||null,cur:()=>chatProj,P0,drawKeyChip,showChat,openProject,pickLocal,drawModeChip};\r\n}catch(x){console.error('module 2.6.0',x)}})();\r\n\r\n</script>\r\n<style id=\"css261\">\r\n/* ===== 2.6.1 : page Fichiers épurée (liste simple, projets à gauche, actions au survol) ===== */\r\n#files.fnew{padding:22px 32px 48px}\r\n#files.fnew .fhead{margin-bottom:14px;align-items:center;gap:16px}\r\n#files.fnew .fhead h2{font:600 20px var(--sans);letter-spacing:-.01em}\r\n#files.fnew .fhead p{font-size:12.5px;margin-top:1px}\r\n#files.fnew .fact{position:relative;gap:8px;flex-wrap:nowrap}\r\n#files.fnew .fsearch input{width:210px;font:inherit;font-size:13px;color:var(--txt);background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:6px 10px 6px 32px}\r\n#files.fnew .fsearch input:focus{width:260px;box-shadow:none;border-color:var(--line2)}\r\n#fhmenu{position:absolute;right:0;top:calc(100% + 6px);z-index:30;min-width:230px;padding:4px;background:var(--panel);border:1px solid var(--line);border-radius:10px;box-shadow:var(--shadow)}\r\n#fhmenu[hidden]{display:none}\r\n#fhmenu:not([hidden]){display:flex;flex-direction:column;gap:1px}\r\n#fhmenu .btn{width:100%;justify-content:flex-start;background:none;border:0;border-radius:7px;padding:7px 10px;font-size:13px;font-weight:400}\r\n#fhmenu .btn:hover{background:var(--hover)}\r\n\r\n#fwrap{display:grid;grid-template-columns:188px minmax(0,1fr);gap:28px;align-items:start}\r\n#fmain{min-width:0}\r\n#files.fnew #fprojs{display:flex;flex-direction:column;gap:1px;margin:0;position:sticky;top:0}\r\n#fprojs .pi{position:relative;display:flex;align-items:center}\r\n#fprojs .pb{flex:1;min-width:0;display:flex;align-items:center;gap:8px;font:inherit;font-size:13px;color:var(--dim);background:none;border:0;padding:6px 10px;border-radius:7px;cursor:pointer;text-align:left}\r\n#fprojs .pb span{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\r\n#fprojs .pb i{font-style:normal;font-size:11.5px;opacity:.7;font-variant-numeric:tabular-nums}\r\n#fprojs .pb .ic{width:14px;height:14px}\r\n#fprojs .pb:hover{background:var(--hover);color:var(--txt)}\r\n#fprojs .pi.on .pb{background:var(--sel);color:var(--txt);font-weight:500}\r\n#fprojs .pi .chipsel{position:absolute;right:4px;opacity:0;font-size:14px}\r\n#fprojs .pi:hover .chipsel,#fprojs .pi .chipsel.on{opacity:1}\r\n#fprojs .pi:hover .pb i{visibility:hidden}\r\n#fprojs .pgl{display:flex;align-items:center;justify-content:space-between;margin-top:14px;padding:0 4px 3px 10px;font-size:11px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:var(--dim)}\r\n#fprojs .pnew{display:grid;place-items:center;width:22px;height:22px;padding:0;border:0;border-radius:6px;background:none;color:var(--dim);cursor:pointer}\r\n#fprojs .pnew:hover{background:var(--hover);color:var(--txt)}\r\n#fprojs .psep{height:1px;background:var(--line);margin:10px 6px 6px}\r\n\r\n#files.fnew #ftools{gap:6px;margin:0 0 6px;padding-bottom:8px;border-bottom:1px solid var(--line);font-size:12.5px}\r\n#files.fnew #ftools select{background:transparent;border:0;color:var(--dim);padding:4px 6px;border-radius:6px;font-size:12.5px}\r\n#files.fnew #ftools select:hover{background:var(--hover);color:var(--txt);border:0}\r\n#ftools .fcnt{color:var(--dim);font-size:12.5px;margin-right:8px}\r\n#files.fnew #ftools .vt{border:0;gap:2px}\r\n#files.fnew #ftools .vt button{background:transparent;border-radius:6px;padding:3px 8px}\r\n#files.fnew #ftools .vt button.on{background:var(--sel);color:var(--txt)}\r\n\r\n#files.fnew #fpedit{background:none;border:0;border-bottom:1px solid var(--line);border-radius:0;padding:0 0 12px;margin:0 0 6px;gap:8px}\r\n#files.fnew #fpedit #pname{font:600 17px var(--sans);background:transparent;border:1px solid transparent;padding:4px 6px}\r\n#files.fnew #fpedit #pname:hover{border-color:var(--line)}\r\n#files.fnew #fpedit textarea{font-size:13px;background:transparent}\r\n#fpedit .pe-more summary{cursor:pointer;color:var(--dim);font-size:12.5px;padding:2px 0;list-style:none}\r\n#fpedit .pe-more summary::-webkit-details-marker{display:none}\r\n#fpedit .pe-more summary::before{content:'›';display:inline-block;width:12px;transition:transform .15s}\r\n#fpedit .pe-more[open] summary::before{transform:rotate(90deg)}\r\n#fpedit .pe-more .pe-row{margin:8px 0}\r\n#files.fnew :is(#fscan,#fauto,#ficols){background:transparent;border-radius:10px;margin-bottom:10px}\r\n\r\n/* liste (par défaut) */\r\n#files.fnew #fgrid{display:flex;flex-direction:column;gap:0}\r\n#files.fnew #fgrid .fcard{display:grid;grid-template-columns:22px 40px minmax(0,1fr) auto auto;align-items:center;gap:12px;min-height:56px;padding:8px 10px;background:transparent;border:0;border-bottom:1px solid var(--line);border-radius:0;box-shadow:none;transform:none;animation:none}\r\n#files.fnew #fgrid .fcard:hover{background:var(--hover);transform:none;box-shadow:none}\r\n#files.fnew #fgrid .fcard.sel{background:var(--soft);box-shadow:none}\r\n#files.fnew #fgrid .fck{position:static;display:flex;opacity:0;transition:opacity .12s}\r\n#files.fnew #fgrid .fcard:hover .fck,#files.fnew #fgrid .fcard.sel .fck,#fgrid.hassel .fck{opacity:1}\r\n#files.fnew #fgrid .fpv{width:40px;height:44px;display:grid;place-items:center;cursor:zoom-in;border-radius:8px;overflow:hidden}\r\n#files.fnew #fgrid .fpi{width:40px;height:40px;background:var(--hover)}\r\n#files.fnew #fgrid .fpi img{width:100%;height:100%;object-fit:cover;display:block;transform:none}\r\n#files.fnew #fgrid .ftile{width:34px;height:40px;margin:0;border-radius:8px;animation:none;box-shadow:none;border:1px solid color-mix(in srgb,var(--tint) 35%,transparent);background:color-mix(in srgb,var(--tint) 13%,var(--panel))}\r\n#files.fnew #fgrid .ftile::after{display:none}\r\n#files.fnew #fgrid .ftile *{animation:none!important}\r\n#files.fnew #fgrid .ftile .fic{width:18px;height:18px}\r\n#files.fnew #fgrid .fcard:hover .ftile{transform:none}\r\n#files.fnew #fgrid .fbody{min-width:0;display:flex;flex-direction:column;gap:2px}\r\n#files.fnew #fgrid .fname{font-size:13.5px;font-weight:500}\r\n#files.fnew #fgrid .fmeta{display:flex;align-items:center;gap:5px;font-size:12px;color:var(--dim);white-space:nowrap;overflow:hidden}\r\n#files.fnew #fgrid .ftag{font-size:11px;padding:0 6px;border-radius:5px;background:var(--hover);color:var(--dim)}\r\n#files.fnew #fgrid .ftag:hover{color:var(--acc)}\r\n#files.fnew #fgrid .ftag.add{opacity:0;background:none;border:1px dashed var(--line)}\r\n#files.fnew #fgrid .fcard:hover .ftag.add{opacity:1}\r\n#files.fnew #fgrid .fside{display:inline-flex;align-items:center;gap:5px;max-width:170px;font-size:12px;color:var(--dim);white-space:nowrap}\r\n#files.fnew #fgrid .fside span{overflow:hidden;text-overflow:ellipsis}\r\n#files.fnew #fgrid .fside .ic{width:12px;height:12px}\r\n#files.fnew #fgrid .fact2{margin:0;gap:2px}\r\n#files.fnew #fgrid .fact2 .btn{opacity:0;transition:opacity .12s,background .12s;flex:none}\r\n#files.fnew #fgrid .fcard:hover .fact2 .btn,#files.fnew #fgrid .fcard:focus-within .fact2 .btn,#files.fnew #fgrid .fstar.on{opacity:1}\r\n\r\n/* grille (au choix) */\r\n#files.fnew #fgrid.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(176px,1fr));gap:12px}\r\n#files.fnew #fgrid.grid .fcard{display:flex;flex-direction:column;align-items:stretch;gap:0;padding:0;min-height:0;position:relative;overflow:hidden;background:var(--panel);border:1px solid var(--line);border-radius:10px}\r\n#files.fnew #fgrid.grid .fcard:hover{background:var(--panel);border-color:var(--line2)}\r\n#files.fnew #fgrid.grid .fcard.sel{background:var(--soft);border-color:var(--acc)}\r\n#files.fnew #fgrid.grid .fck{position:absolute;top:8px;left:8px;z-index:2}\r\n#files.fnew #fgrid.grid .fpv{width:100%;height:112px;border-radius:0;background:var(--hover)}\r\n#files.fnew #fgrid.grid .fpi{width:100%;height:112px}\r\n#files.fnew #fgrid.grid .ftile{width:44px;height:52px}\r\n#files.fnew #fgrid.grid .fbody{padding:10px 12px 2px}\r\n#files.fnew #fgrid.grid .fside{padding:0 12px;max-width:none}\r\n#files.fnew #fgrid.grid .fact2{padding:6px 8px 8px}\r\n\r\n/* barre de sélection flottante */\r\n#files.fnew #fselbar{position:sticky;bottom:14px;z-index:6;margin:14px 0 0;background:var(--panel);border:1px solid var(--line2);border-radius:12px;box-shadow:var(--shadow);padding:8px 12px}\r\n#files.fnew #fselbar[hidden]{display:none}\r\n\r\n/* menu « ⋯ » d'un fichier */\r\n#fmore{position:fixed;z-index:90;min-width:210px;max-height:70vh;overflow:auto;padding:4px;background:var(--panel);border:1px solid var(--line);border-radius:10px;box-shadow:var(--shadow)}\r\n#fmore[hidden]{display:none}\r\n#fmore button{font:inherit;font-size:13px;color:var(--txt);width:100%;display:flex;align-items:center;gap:9px;padding:7px 10px;border:0;background:none;border-radius:7px;cursor:pointer;text-align:left}\r\n#fmore button:hover{background:var(--hover)}\r\n#fmore button.del{color:var(--err)}\r\n#fmore button.cur::after{content:'✓';margin-left:auto;color:var(--acc)}\r\n#fmore .mt{color:var(--dim);font-size:11px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;padding:6px 10px 3px}\r\n#fmore .msep{height:1px;background:var(--line);margin:4px 2px}\r\n\r\n#files.fnew #fempty .big{width:56px;height:56px;border-radius:14px;animation:none}\r\n#files.fnew #fempty h3{font:600 16px var(--sans)}\r\n#files.fnew #fempty p{font-size:13px}\r\n\r\n@media (max-width:900px){\r\n  #files.fnew{padding:18px 16px 40px}\r\n  #fwrap{grid-template-columns:1fr;gap:12px}\r\n  #files.fnew #fprojs{flex-direction:row;overflow-x:auto;position:static;padding-bottom:6px}\r\n  #fprojs .pi{flex:none}#fprojs .pgl,#fprojs .psep{display:none}\r\n  #files.fnew #fgrid:not(.grid) .fcard{grid-template-columns:22px 40px minmax(0,1fr) auto}\r\n  #files.fnew #fgrid .fside{display:none}\r\n}\r\n</style>\r\n<script>\r\n/* 2.6.1 — Page Fichiers épurée : projets à gauche, liste simple, actions au survol, menu « ⋯ ». Les données, la corbeille, les étiquettes, la sélection multiple et les raccourcis restent ceux de la 2.6.0. */\r\nObject.assign(ICONS,{more:'<circle cx=\"5\" cy=\"12\" r=\"1.3\"/><circle cx=\"12\" cy=\"12\" r=\"1.3\"/><circle cx=\"19\" cy=\"12\" r=\"1.3\"/>'});\r\nlet DET=null;\r\nconst fvw=()=>settings.fview==='grid'?'grid':'list';\r\n\r\n// ---------- structure : barre de projets à gauche, contenu à droite, outils rares dans un menu ----------\r\nlet fnewOK=false;\r\ntry{\r\n  const files=$('files'),head=files.querySelector('.fhead'),side=$('fprojs'),selbar=$('fselbar'),empty=$('fempty'),act=head.querySelector('.fact'),fa=$('fadd');\r\n  const btns=['fscanbtn','fautobtn','fcolbtn'].map(id=>$(id));\r\n  if(!files||!head||!side||!selbar||!empty||!act||!fa||btns.some(b=>!b))throw new Error('éléments de la page Fichiers introuvables');\r\n  const main=document.createElement('div'),wrap=document.createElement('div'),menu=document.createElement('div'),mb=document.createElement('button');\r\n  main.id='fmain';wrap.id='fwrap';menu.id='fhmenu';menu.hidden=true;\r\n  head.after(wrap);wrap.append(side,main);\r\n  [...files.children].forEach(el=>{if(el!==head&&el!==wrap&&el.id!=='fin')main.appendChild(el)});\r\n  main.insertBefore(selbar,empty);\r\n  btns.forEach(b=>menu.appendChild(b));\r\n  menu.insertAdjacentHTML('beforeend',`<button class=\"btn\" id=\"fdup2\" type=\"button\">${IC('copy')}Chercher les doublons</button>`);\r\n  mb.className='btn ghost ico';mb.id='fhmore';mb.type='button';mb.title='Plus d\\'options : scanner Claude, classement automatique, couleurs, doublons';mb.setAttribute('aria-label','Plus d\\'options');mb.innerHTML=IC('more');\r\n  act.insertBefore(mb,fa);act.appendChild(menu);\r\n  if(fa.lastChild&&fa.lastChild.nodeType===3)fa.lastChild.textContent='Ajouter';\r\n  mb.onclick=e=>{e.stopPropagation();menu.hidden=!menu.hidden};\r\n  menu.addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;if(b.id==='fdup2')dedupe();setTimeout(()=>{menu.hidden=true},0)});\r\n  document.addEventListener('click',e=>{if(!menu.hidden&&!e.target.closest('#fhmenu,#fhmore'))menu.hidden=true});\r\n  files.classList.add('fnew');fnewOK=true;\r\n}catch(x){console.error('2.6.1 structure',x)}\r\n\r\n// ---------- barre de projets (à gauche) ----------\r\nfunction drawProjs(){const el=$('fprojs');if(!el)return;\r\n  const cnt=id=>FILES.filter(f=>id==='none'?!projOf(f):f.proj===id).length;\r\n  const sa=id=>{const ids=catIds(id),all=ids.length&&ids.every(x=>SEL.has(x));return `<button class=\"chipsel${all?' on':''}\" data-pa=\"${id}\" title=\"${all?'Désélectionner':'Tout sélectionner'} dans cette catégorie\"${ids.length?'':' disabled'}>${all?'☑':'☐'}</button>`};\r\n  const it=(id,label,n,ic,sel=true)=>`<div class=\"pi${fproj===id?' on':''}\"><button class=\"pb\" data-pf=\"${id}\">${ic?IC(ic):''}<span>${label}</span><i>${n}</i></button>${sel?sa(id):''}</div>`;\r\n  el.innerHTML=it('all','Tous',FILES.length,'')+it('recent','Récents',viewList('recent').length,'',false)+it('fav','Favoris',FILES.filter(f=>f.fav).length,'',false)+it('none','Non classés',cnt('none'),'')+it('sent','Envoyés',FILES.filter(f=>f.dir==='sent').length,'',false)+it('recv','Reçus',FILES.filter(f=>f.dir==='recv').length,'',false)\r\n    +`<div class=\"pgl\"><span>Projets</span><button class=\"pnew\" data-pf=\"new\" title=\"Nouveau projet\" aria-label=\"Nouveau projet\">${IC('plus')}</button></div>`\r\n    +PJ().map(p=>it(p.id,esc(p.name),cnt(p.id),'folder')).join('')\r\n    +`<div class=\"psep\"></div>`+it('trash','Corbeille',TRASH.length,'trash',false);\r\n  drawPEdit()}\r\n\r\nfunction drawPEdit(){const el=$('fpedit'),p=PJ().find(x=>x.id===fproj);\r\n  if(!p){el.hidden=true;el.innerHTML='';delete el.dataset.pid;return}\r\n  if(el.dataset.pid===p.id&&!el.hidden)return;           // ne pas écraser la saisie en cours\r\n  el.dataset.pid=p.id;el.hidden=false;\r\n  el.innerHTML=`<div class=\"pe-row\"><input id=\"pname\" value=\"${esc(p.name)}\" maxlength=\"60\" placeholder=\"Nom du projet\" autocomplete=\"off\"><button class=\"btn sm\" id=\"patt\">${IC('clip')}Joindre tout le projet à…</button><button class=\"btn ghost sm del\" id=\"pdel\">${IC('trash')}Supprimer</button></div>\r\n    <textarea id=\"pdesc\" rows=\"2\" placeholder=\"Décris le projet en quelques mots (facultatif) : cela améliore le résumé donné à l'IA.\">${esc(p.desc||'')}</textarea>\r\n    <details class=\"pe-more\"><summary>Résumé donné à l'IA</summary><div class=\"pe-row\"><button class=\"btn sm\" id=\"psumb\">${IC('refresh')}Générer le résumé</button><span class=\"dim\" id=\"pstat\"></span></div><pre id=\"psum\"></pre></details>`;\r\n  showSum(p)}\r\n\r\n// ---------- barre d'outils : tri, type, vue ----------\r\nfunction drawTools(){const el=$('ftools');if(!el)return;const kc={};FILES.forEach(f=>{const k=kindOf(f);kc[k]=(kc[k]||0)+1});if(ftype&&!kc[ftype])ftype='';\r\n  const n=VIS.length;\r\n  el.innerHTML=`<span class=\"fcnt\">${n} élément${n>1?'s':''}</span><select id=\"fsort\" title=\"Trier\"><option value=\"new\">Plus récents</option><option value=\"old\">Plus anciens</option><option value=\"az\">Nom A → Z</option><option value=\"za\">Nom Z → A</option><option value=\"big\">Plus gros</option><option value=\"small\">Plus petits</option><option value=\"type\">Par type</option></select><select id=\"ftype\" title=\"Filtrer par type\"><option value=\"\">Tous les types</option>${Object.keys(FKINDS).filter(k=>kc[k]).map(k=>`<option value=\"${k}\">${FKINDS[k]} (${kc[k]})</option>`).join('')}</select><span class=\"sp\"></span>`\r\n    +(fproj==='trash'&&TRASH.length?`<button class=\"btn ghost sm del\" id=\"fempt\">${IC('trash')}Vider la corbeille</button>`:'')\r\n    +`<span class=\"vt\"><button data-v=\"list\" class=\"${fvw()==='list'?'on':''}\" title=\"Liste\">☰</button><button data-v=\"grid\" class=\"${fvw()==='grid'?'on':''}\" title=\"Grille\">▦</button></span>`;\r\n  $('fsort').value=settings.fsort||'new';$('ftype').value=ftype}\r\n\r\n// ---------- liste des fichiers ----------\r\nfunction drawFiles(anim=true){try{applyFcol()}catch{}\r\n  fUrls.forEach(u=>URL.revokeObjectURL(u));fUrls=[];\r\n  if(fproj!=='all'&&!['none','fav','recent','trash','sent','recv'].includes(fproj)&&!isProjId(fproj))fproj='all';\r\n  const tr=fproj==='trash';if(tr!==lastT){SEL.clear();lastT=tr}\r\n  const q=fq.trim().toLowerCase(),tot=FILES.reduce((s,f)=>s+f.size,0),n=accs.length;\r\n  const list=viewList(fproj).filter(f=>matchQ(f,q)&&(!ftype||kindOf(f)===ftype)).sort(sortP);VIS=list.map(f=>f.id);\r\n  $('fsub').textContent=FILES.length?`${FILES.length} fichier${FILES.length>1?'s':''} · ${fmtSize(tot)} · partagés entre tes ${n} compte${n>1?'s':''}`:'Ta bibliothèque est commune à tous tes comptes.';\r\n  $('fcount').textContent=FILES.length||'';\r\n  $('fempty').style.display=FILES.length||TRASH.length?'none':'grid';\r\n  const g=$('fgrid');g.classList.toggle('noanim',!anim);g.classList.toggle('list',fvw()==='list');g.classList.toggle('grid',fvw()==='grid');g.classList.toggle('hassel',SEL.size>0);\r\n  g.innerHTML=list.map((f,i)=>{const ik=iconKind(f);let pv;\r\n    if(ik==='image'){const u=URL.createObjectURL(f.blob);fUrls.push(u);pv=`<div class=\"fpv fpi\" data-prev=\"${f.id}\"><img src=\"${u}\" alt=\"\"></div>`}else pv=`<div class=\"fpv\" data-prevw=\"${f.id}\">${fileTile(f)}</div>`;\r\n    const d=new Date(f.added).toLocaleDateString('fr-FR',{day:'numeric',month:'short'}),pj=projOf(f);\r\n    const bits=[fileLabel(f),fmtSize(f.size),d];if(f.src)bits.push(f.src.kind==='created'?'Créé par Claude':'Joint');if(tr)bits.push(`supprimé dans ${Math.max(0,Math.ceil((TTL-(Date.now()-f.del))/DAY))} j`);\r\n    const tags=(f.tags||[]).map(t=>`<button class=\"ftag\" data-tag=\"${esc(t)}\" title=\"Clic : filtrer · clic droit : retirer\">#${esc(t)}</button>`).join('')+(tr?'':`<button class=\"ftag add\" data-addtag=\"${f.id}\" title=\"Ajouter une étiquette\">+ #</button>`);\r\n    const side=pj&&fproj!==pj.id?`<span class=\"fside\" title=\"Projet : ${esc(pj.name)}\">${IC('folder')}<span>${esc(pj.name)}</span></span>`:'<span class=\"fside\"></span>';\r\n    const acts=tr?`<button class=\"btn sm\" data-restore=\"${f.id}\">Restaurer</button><button class=\"btn ghost sm ico del\" data-purge=\"${f.id}\" title=\"Supprimer définitivement\">${IC('trash')}</button>`\r\n      :`<button class=\"btn sm\" data-att=\"${f.id}\" title=\"Joindre à une conversation\">${IC('clip')}Joindre</button><button class=\"btn ghost sm ico fstar${f.fav?' on':''}\" data-fav=\"${f.id}\" title=\"Favori\">${f.fav?'★':'☆'}</button><button class=\"btn ghost sm ico\" data-more=\"${f.id}\" title=\"Plus d'actions\" aria-label=\"Plus d'actions\">${IC('more')}</button>`;\r\n    return `<div class=\"fcard frw${SEL.has(f.id)?' sel':''}${DET===f.id?' cur':''}\" data-id=\"${f.id}\" style=\"--i:${i}\"><label class=\"fck\" title=\"Sélectionner (Maj+clic : plage)\"><input type=\"checkbox\" data-sel=\"${f.id}\"${SEL.has(f.id)?' checked':''}></label>${pv}<div class=\"fbody\"><div class=\"fname\" data-rn=\"${f.id}\" title=\"${esc(f.name)} · double-clic pour renommer\">${esc(f.name)}</div><div class=\"fmeta\" title=\"${esc((f.src&&f.src.conv)||'')}\"><span>${bits.map(esc).join(' · ')}</span>${tags}</div></div>${side}<div class=\"fact2\">${acts}</div></div>`}).join('')\r\n    +(!list.length&&(FILES.length||TRASH.length)?`<p class=\"dim\" style=\"padding:22px 4px\">${q?'Aucun fichier ne correspond.':tr?'La corbeille est vide.':fproj==='fav'?'Aucun favori : clique sur l\\'étoile d\\'un fichier.':'Aucun fichier dans cette sélection.'}</p>`:'');\r\n  drawTools();drawProjs();drawSel();pushMenu();try{if(typeof drawDet==='function')drawDet()}catch{}}\r\n\r\n// ---------- menu « ⋯ » d'un fichier ----------\r\ndocument.body.insertAdjacentHTML('beforeend','<div id=\"fmore\" hidden></div>');\r\nfunction closeMore(){const m=$('fmore');m.hidden=true;m.innerHTML='';m.dataset.id=''}\r\nfunction openMore(btn,id){const f=byId(id);if(!f)return;const m=$('fmore');\r\n  m.dataset.id=id;\r\n  m.innerHTML=`<button data-m=\"rn\">${IC('edit')}Renommer</button><button data-m=\"dl\">${IC('dl')}Télécharger</button><button data-m=\"tag\"># Ajouter une étiquette</button><div class=\"msep\"></div><div class=\"mt\">Projet</div><button data-m=\"mv\" data-p=\"\"${!projOf(f)?' class=\"cur\"':''}>Sans projet</button>${PJ().map(p=>`<button data-m=\"mv\" data-p=\"${p.id}\"${p.id===f.proj?' class=\"cur\"':''}>${IC('folder')}${esc(p.name)}</button>`).join('')}<div class=\"msep\"></div><button data-m=\"rm\" class=\"del\">${IC('trash')}Mettre à la corbeille</button>`;\r\n  m.hidden=false;const r=btn.getBoundingClientRect(),w=m.offsetWidth,h=m.offsetHeight;\r\n  m.style.left=Math.max(8,Math.min(r.right-w,innerWidth-w-8))+'px';m.style.top=(r.bottom+6+h>innerHeight?Math.max(8,r.top-h-6):r.bottom+6)+'px'}\r\n$('fgrid').addEventListener('click',e=>{const b=e.target.closest('[data-more]');if(!b)return;e.stopPropagation();const m=$('fmore');\r\n  if(!m.hidden&&m.dataset.id===b.dataset.more)return closeMore();openMore(b,b.dataset.more)});\r\n$('fmore').addEventListener('click',async e=>{const b=e.target.closest('button[data-m]');if(!b)return;const id=$('fmore').dataset.id,f=byId(id);closeMore();if(!f)return;\r\n  const m=b.dataset.m;\r\n  if(m==='rn')startRename(id);\r\n  else if(m==='dl')dlFile(f);\r\n  else if(m==='tag'){const el=document.querySelector(`.fcard[data-id=\"${id}\"] [data-addtag]`);if(el)inlineInput(el,'Étiquette',v=>addTag([id],v))}\r\n  else if(m==='rm')trashIds([id]);\r\n  else if(m==='mv'){try{await FDB.put({...f,proj:b.dataset.p,man:true,auto:false})}catch{return toast('Impossible de changer le projet')}await loadFiles(false);toast(b.dataset.p?'Fichier déplacé vers « '+((PJ().find(p=>p.id===b.dataset.p)||{}).name||'projet')+' »':'Fichier retiré du projet')}});\r\ndocument.addEventListener('click',e=>{if(!$('fmore').hidden&&!e.target.closest('#fmore,[data-more]'))closeMore()});\r\ndocument.addEventListener('keydown',e=>{if(e.key==='Escape'&&!$('fmore').hidden)closeMore()});\r\n$('files').addEventListener('scroll',()=>{if(!$('fmore').hidden)closeMore()},{passive:true});\r\naddEventListener('resize',()=>{if(!$('fmore').hidden)closeMore()});\r\n// la case à cocher met à jour l'affichage de la sélection (cases visibles dès qu'un fichier est choisi)\r\n$('fgrid').addEventListener('change',e=>{if(e.target.closest('input[data-sel]'))$('fgrid').classList.toggle('hassel',SEL.size>0)});\r\n\r\nif(fnewOK)try{drawFiles(false)}catch(x){console.error('2.6.1 draw',x)}\r\n</script>\r\n<style id=\"css263\">\r\n/* ===== 2.6.3 : interface type Cursor — épurée, neutre, animations douces ===== */\r\n:root{--sans:\"Inter\",\"Segoe UI Variable Text\",\"Segoe UI\",system-ui,-apple-system,Roboto,Helvetica,Arial,sans-serif;--serif:var(--sans);\r\n--bg:#ffffff;--side:#f6f6f6;--panel:#ffffff;--hover:rgba(0,0,0,.045);--sel:rgba(0,0,0,.075);--soft:rgba(0,0,0,.035);\r\n--line:#e7e7e7;--line2:#d2d2d2;--txt:#1b1b1b;--dim:#737373;--acc:#2a6df4;--btn:#1b1b1b;--btnh:#000;--btntx:#fff;\r\n--ok:#1f8a5b;--warn:#a8730f;--err:#c23d2e;--tbg:#1b1b1b;--ttx:#fff;\r\n--shadow:0 0 0 1px rgba(0,0,0,.03),0 8px 28px rgba(0,0,0,.12)}\r\n:root[data-theme=dark]{--bg:#181818;--side:#141414;--panel:#1f1f1f;--hover:rgba(255,255,255,.055);--sel:rgba(255,255,255,.09);--soft:rgba(255,255,255,.045);\r\n--line:#2a2a2a;--line2:#3b3b3b;--txt:#e8e8e8;--dim:#8c8c8c;--acc:#6ea8fe;--btn:#ececec;--btnh:#fff;--btntx:#141414;\r\n--ok:#5fb98a;--warn:#d9a95b;--err:#e5786a;--tbg:#ececec;--ttx:#141414;\r\n--shadow:0 0 0 1px rgba(255,255,255,.04),0 10px 32px rgba(0,0,0,.55)}\r\n@media (prefers-color-scheme:dark){:root[data-theme=system]{--bg:#181818;--side:#141414;--panel:#1f1f1f;--hover:rgba(255,255,255,.055);--sel:rgba(255,255,255,.09);--soft:rgba(255,255,255,.045);\r\n--line:#2a2a2a;--line2:#3b3b3b;--txt:#e8e8e8;--dim:#8c8c8c;--acc:#6ea8fe;--btn:#ececec;--btnh:#fff;--btntx:#141414;\r\n--ok:#5fb98a;--warn:#d9a95b;--err:#e5786a;--tbg:#ececec;--ttx:#141414;\r\n--shadow:0 0 0 1px rgba(255,255,255,.04),0 10px 32px rgba(0,0,0,.55)}}\r\nbody{font-size:13px;line-height:1.5}\r\nh1,.pane h2,.ch-empty h3,#ch-name,#empty h2,dialog h3,#fempty h3,.k-pad h3{font-family:var(--sans);font-weight:600;letter-spacing:-.012em}\r\n::-webkit-scrollbar{width:8px;height:8px}\r\n.btn{border-radius:6px;padding:5px 10px;font-size:13px;transition:background .15s,border-color .15s,color .15s,transform .12s var(--ease),opacity .15s}\r\n.btn:active:not(:disabled){transform:scale(.97)}\r\n.btn.pri,.k-btn{color:var(--btntx)}\r\n.sw:checked::after{background:var(--btntx)}\r\n.sw{background:var(--line2)}\r\nselect,input:not([type=checkbox]),textarea{border-radius:6px;padding:6px 9px;transition:border-color .15s,box-shadow .15s}\r\nselect:focus,input:not([type=checkbox]):focus,textarea:focus{outline:none;border-color:var(--line2);box-shadow:0 0 0 3px var(--hover)}\r\n:focus-visible{outline:1.5px solid var(--acc);outline-offset:1px}\r\n.card{border-radius:8px}dialog{border-radius:12px;animation:hpop .18s var(--ease)}\r\n.pill{border-radius:6px}.seg{border-radius:8px}.seg button{border-radius:6px}\r\n\r\n/* barre latérale */\r\naside{width:248px;padding:10px 8px;gap:6px;overflow:hidden;white-space:nowrap;transition:width .26s var(--ease),padding .26s var(--ease)}\r\n.brand{padding:0 4px 4px;gap:8px;min-height:32px}\r\n.brand>svg{width:18px;height:18px;color:var(--txt)}\r\n.brand #sbtog svg{width:17px;height:17px;color:inherit}\r\nh1{font-size:14px;letter-spacing:.01em}\r\n#sbtog{flex:none;width:30px;height:30px;padding:0;display:grid;place-items:center;border-radius:6px;color:var(--dim)}\r\n#sbtog:hover{color:var(--txt)}\r\n#sbtog .ic{width:17px;height:17px;transition:transform .26s var(--ease)}\r\naside.min #sbtog .ic{transform:scaleX(-1)}\r\n.brand:hover #sbtog svg{transform:none}aside.min .brand:hover #sbtog svg{transform:scaleX(-1)}\r\n#ch-send[hidden],#ch-stop[hidden]{display:none!important}\r\n.acc{border-radius:6px;min-height:30px;padding:5px 9px;font-size:13px}\r\n.acc:hover{transform:none}\r\n.grp{font-size:11px;letter-spacing:.04em;padding:12px 10px 3px}\r\n.acc.out,.grp.out{opacity:.36}\r\n#list .acc.inuse{box-shadow:inset 2px 0 0 var(--acc)}\r\naside #filesbtn,aside .foot #gear{border-radius:6px;padding:7px 10px}\r\naside .foot #themebtn{width:32px;height:32px;border-radius:6px;background:transparent;border-color:transparent}\r\naside .foot #themebtn:hover{background:var(--hover)}\r\naside.min{width:52px;padding:10px 6px}\r\naside.min .brand{padding:0;justify-content:center}\r\naside.min .brand>svg,aside.min .brand>h1{display:none}\r\naside.min #newproj,aside.min #filesbtn,aside.min #gear{font-size:0;gap:0;justify-content:center;padding:8px 0}\r\naside.min #filesbtn .pill,aside.min .pgrp,aside.min #keysbox,aside.min #plist .pn,aside.min #plist .acc b,aside.min #plist .acc .spin,aside.min .pempty{display:none}\r\naside.min #plist .acc{justify-content:center;padding:8px 0}\r\naside.min .foot{flex-direction:column;align-items:center}\r\naside.min .foot #themebtn{width:100%}\r\naside.min~main #fdrop,aside.min+main #fdrop{left:64px}\r\n\r\n/* barre du haut : titre à gauche, jauge + comptes à droite */\r\nheader{min-height:44px;padding:6px 12px;gap:10px;justify-content:flex-start;background:var(--bg)}\r\nheader strong{font-size:13px;font-weight:500;color:var(--dim)}\r\n.hbtns{margin-left:auto;flex:none}.hbtns[style*=\"hidden\"]{display:none}\r\nheader strong{flex:1 1 auto;min-width:0}\r\n#hright{display:flex;align-items:center;gap:8px;flex:none}\r\n#hacc{height:28px;padding:0 8px;gap:7px;border:1px solid var(--line);background:transparent;border-radius:6px;font-size:12.5px}\r\n#hacc:hover,#hacc.open{background:var(--hover);border-color:var(--line2)}\r\n#hacc .hl{max-width:190px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\r\n#hacc .hc{color:var(--dim);font-variant-numeric:tabular-nums;font-size:12px}\r\n#hacc .chev{width:13px;height:13px;color:var(--dim);transition:transform .2s var(--ease)}\r\n#hacc.open .chev{transform:rotate(180deg)}\r\n#hacc.bad{border-color:var(--err);color:var(--err)}\r\n/* la jauge « comptes dispo » : plus en bas à droite, intégrée à la barre, même thème */\r\n#q-glob{position:static!important;right:auto!important;bottom:auto!important;z-index:auto!important;display:flex;align-items:center;height:28px;padding:0 9px 0 7px!important;border-radius:6px!important;background:transparent!important;color:var(--txt)!important;border:1px solid var(--line);box-shadow:none!important;opacity:1!important;font-size:12.5px;transition:background .15s,border-color .15s}\r\n#q-glob:hover{background:var(--hover)!important;border-color:var(--line2)}\r\n#q-glob .gi{flex-direction:row!important;gap:7px!important;align-items:center}\r\n#q-glob .rg{width:18px!important;height:18px!important;min-width:18px!important}\r\n#q-glob .rg svg{width:18px!important;height:18px!important}\r\n#q-glob .gi>b{font-weight:600;font-variant-numeric:tabular-nums}\r\n#q-glob .gi small{font-size:12px!important;opacity:.7!important}\r\n#hmenu{position:fixed;z-index:300;min-width:290px;max-width:380px;max-height:72vh;overflow:auto;background:var(--panel);border:1px solid var(--line);border-radius:10px;box-shadow:var(--shadow);padding:5px;transform-origin:top right}\r\n#hmenu[hidden]{display:none}\r\n#hmenu:not([hidden]){animation:hpop .16s var(--ease)}\r\n@keyframes hpop{from{opacity:0;transform:translateY(-6px) scale(.97)}to{opacity:1;transform:none}}\r\n#hmenu .mt{color:var(--dim);font-size:11px;font-weight:600;letter-spacing:.04em;text-transform:uppercase;padding:8px 9px 3px}\r\n#hmenu button{display:flex;align-items:center;gap:9px;width:100%;text-align:left;background:transparent;border:0;color:var(--txt);font:inherit;padding:6px 9px;border-radius:6px;cursor:pointer;transition:background .12s}\r\n#hmenu button:hover{background:var(--hover)}\r\n#hmenu button .tx{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\r\n#hmenu button em{font-style:normal;color:var(--dim);font-size:11.5px;font-variant-numeric:tabular-nums}\r\n#hmenu button em.err{color:var(--err)}\r\n#hmenu button.on{background:var(--sel)}\r\n#hmenu button.on::after{content:'✓';color:var(--acc)}\r\n#hmenu .sep{height:1px;background:var(--line);margin:5px 4px}\r\n#hmenu .note{color:var(--dim);padding:8px 10px;line-height:1.45}\r\n\r\n/* le bloc de messages (toast) : en haut à droite, thème normal, ne gêne plus la barre Windows */\r\n#toast{top:56px;bottom:auto;left:auto;right:16px;transform:translateX(26px);opacity:0;background:var(--panel);color:var(--txt);border:1px solid var(--line2);border-left:3px solid var(--acc);border-radius:8px;padding:9px 14px;font-weight:400;font-size:13px;max-width:min(380px,60vw);box-shadow:var(--shadow);transition:opacity .22s var(--ease),transform .3s var(--ease)}\r\n#toast.show{opacity:1;transform:none}\r\n\r\n/* chat : barre plus haute, remontée au-dessus de la barre des tâches */\r\n#ch-top{padding:8px 20px}\r\n#ch-name{font-size:14px}\r\n#ch-bar{padding:8px 0 44px}\r\n#ch-box{display:grid;grid-template-columns:auto 1fr auto;grid-template-areas:\"in in in\" \"att . go\";gap:2px 6px;align-items:center;min-height:104px;padding:10px 10px 8px 12px;border-radius:12px;box-shadow:var(--shadow);transition:border-color .18s,box-shadow .18s}\r\n#ch-box:focus-within{border-color:var(--line2);box-shadow:var(--shadow),0 0 0 3px var(--hover)}\r\n#ch-in{grid-area:in;min-height:56px;max-height:260px;padding:2px 2px 6px;font:14px/1.55 var(--sans)}\r\n#ch-att{grid-area:att}#ch-send,#ch-stop{grid-area:go}\r\n#ch-send{border-radius:999px;padding:5px 14px}\r\n#ch-hint{font-size:11px;opacity:.8;margin-top:6px}\r\n.m.u .b{border-radius:12px;background:var(--sel);animation:uin .26s var(--ease) backwards}\r\n@keyframes uin{from{opacity:0;transform:translateY(8px) scale(.98)}to{opacity:1;transform:none}}\r\n.m .cb pre{border-radius:8px}\r\n.ch-typing .spin{width:8px;height:8px;border:0;border-radius:50%;background:var(--acc);animation:cpulse 1.1s ease-in-out infinite}\r\n.ch-typing span{background:linear-gradient(90deg,var(--dim) 30%,var(--txt) 50%,var(--dim) 70%) 200% 0/250% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:shim 1.8s linear infinite}\r\n@keyframes cpulse{0%,100%{transform:scale(.7);opacity:.5}50%{transform:scale(1.15);opacity:1}}\r\n@keyframes shim{to{background-position:-50% 0}}\r\n#ch-menu{border-radius:10px}\r\n\r\n/* animations : réglage « Réduire les animations » */\r\nhtml.rm *,html.rm *::before,html.rm *::after{animation-duration:.001ms!important;animation-delay:0s!important;transition-duration:.001ms!important}\r\nhtml.rm .spin,html.rm .ch-typing .spin{animation-duration:2.4s!important}\r\nhtml.noanim aside,html.noanim aside *{transition:none!important}\r\n@media (prefers-reduced-motion:reduce){#hmenu,dialog{animation:none}}\r\n</style>\r\n<script>\r\n/* 2.6.3 — Interface type Cursor : barre latérale repliable (Ctrl+B), comptes + « plateforme seule » en haut à droite, jauge et messages remontés en haut, animations. */\r\n(function(){try{\r\nconst V='2.6.3';\r\nObject.assign(ICONS,{panel:'<rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"2\"/><path d=\"M9 4v16\"/>',chev:'<path d=\"m6 9 6 6 6-6\"/>',layers:'<path d=\"m12 3 9 5-9 5-9-5 9-5Z\"/><path d=\"m3 13 9 5 9-5\"/>'});\r\nconst root=document.documentElement,hr=$('hright');\r\nconst H=()=>window.hub260||{};\r\nconst okKey=a=>{const s=stOf(a.id);return !s.limited&&s.logged!==false};\r\nconst proj=()=>{const h=H(),id=h.cur&&h.cur();return id&&h.P0?h.P0(id):null};\r\nconst only=()=>{const p=proj();return (p&&p.only)||''};\r\n\r\n// ---------- comptes en haut à droite : plateforme seule + clé du projet ----------\r\nconst btn=document.createElement('button');btn.id='hacc';btn.type='button';btn.className='btn';hr.appendChild(btn);\r\nconst menu=document.createElement('div');menu.id='hmenu';menu.hidden=true;document.body.appendChild(menu);\r\nwindow.u5Crumb=function(p){const n=(p&&(p.name||(p.local&&p.local.name)))||'AI Hub';return '<span class=\"u5-ttl\"><b>'+esc(n)+'</b></span>'};\r\nfunction drawHAcc(){\r\n  if(!accs.length){btn.innerHTML=IC('lock')+'<span class=\"hl\">Aucune clé</span>';btn.classList.add('bad');btn.title='Ajoute une clé (compte IA) dans la barre latérale';return}\r\n  btn.classList.remove('bad');const p=proj(),o=only(),pinA=p&&p.pin?find(p.pin):null,scope=o?accs.filter(a=>a.p===o):accs,free=scope.filter(okKey).length;\r\n  const lead=pinA?`<i class=\"dot\" style=\"background:${P[pinA.p][1]}\"></i>`:(o&&P[o]?`<i class=\"dot\" style=\"background:${P[o][1]}\"></i>`:IC('swap'));\r\n  const lab=pinA?'Compte · '+pinA.n:(o?'IA · '+o:'Automatique');\r\n  const lm=scope.filter(x=>stOf(x.id).limited),lu=lm.map(x=>stOf(x.id).until||0).filter(u=>u>Date.now()),limB=lm.length?'<span class=\"hlim\" title=\"'+lm.length+' clé(s) en limite'+(lu.length?' · la plus proche se libère à '+hm(Math.min(...lu)):'')+'\">⏳ '+lm.length+(lu.length?' · '+hm(Math.min(...lu)):'')+'</span>':'';\r\n  btn.innerHTML=`${lead}<span class=\"hl\">${esc(lab)}</span><span class=\"hc\">${pinA?'':free+'/'+scope.length}</span>${limB}${IC('chev').replace('class=\"ic\"','class=\"ic chev\"')}`;\r\n  btn.title=pinA?'Ce chat utilise toujours ce compte':(o?'Ce chat utilise seulement les comptes '+o+' (change tout seul entre eux)':'AI Hub choisit le compte et en change tout seul quand une limite est atteinte')}\r\nsetInterval(()=>{try{drawHAcc()}catch{}},20000);\r\nfunction closeH(){if(menu.hidden)return;menu.hidden=true;btn.classList.remove('open')}\r\nfunction openH(){\r\n  const p=proj(),o=only(),by={};accs.forEach(a=>{(by[a.p]??={n:0,f:0}).n++;if(okKey(a))by[a.p].f++});\r\n  let h='';\r\n  if(!p)h+='<div class=\"note\">Ouvre un projet pour choisir comment il utilise tes comptes.</div>';\r\n  else{const auto=!p.pin&&!o;\r\n    h+=`<div class=\"mt\">Comment choisir l'IA ?</div><button data-auto=\"1\" class=\"${auto?'on':''}\">${IC('swap')}<span class=\"tx\">Automatique</span><em>${accs.filter(okKey).length}/${accs.length} prêts</em></button>`;\r\n    h+=`<div class=\"sep\"></div><div class=\"mt\">Par IA (plateforme)</div>`;\r\n    h+=Object.keys(by).map(k=>`<button data-only=\"${esc(k)}\" class=\"${!p.pin&&o===k?'on':''}\"><i class=\"dot\" style=\"background:${P[k]?P[k][1]:'var(--dim)'}\"></i><span class=\"tx\">${esc(k)}</span><em>${by[k].f}/${by[k].n}</em></button>`).join('');\r\n    const cur=((H().chat&&H().chat(p.id))||{}).key;\r\n    h+=`<div class=\"sep\"></div><div class=\"mt\">Par compte</div>`;\r\n    h+=accs.map(a=>{const s=stOf(a.id);return `<button data-pin=\"${a.id}\" class=\"${p.pin===a.id?'on':''}\"><i class=\"dot\" style=\"background:${P[a.p][1]}\"></i><span class=\"tx\">${esc(a.p+' · '+a.n)}</span>${s.limited?'<em class=\"err\">limite</em>':s.logged===false?'<em class=\"err\">déconnecté</em>':cur===a.id?'<em>en cours</em>':''}</button>`}).join('')}\r\n  h+=`<div class=\"sep\"></div><button data-act=\"keys\">${IC('plus')}<span class=\"tx\">Gérer les comptes…</span></button>`;\r\n  menu.innerHTML=h;menu.hidden=false;btn.classList.add('open');\r\n  const r=btn.getBoundingClientRect();menu.style.top=(r.bottom+6)+'px';menu.style.right=Math.max(8,innerWidth-r.right)+'px';menu.style.left='auto'}\r\nbtn.onclick=e=>{e.stopPropagation();menu.hidden?openH():closeH()};\r\nmenu.addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;const p=proj();\r\n  if(b.dataset.route!==undefined){setRoute(b.dataset.route,p);closeH();drawHAcc();return}if(b.dataset.act==='routecfg'){closeH();routeCfg();return}if(b.dataset.act==='keys'){closeH();setSB(false);$('keysbox').classList.remove('min');return}\r\n  if(!p)return;\r\n  if(b.dataset.auto!==undefined){p.only='';p.pin='';try{setRoute('simple',p)}catch{}save();closeH();drawHAcc();dimKeys();try{H().drawKeyChip&&H().drawKeyChip()}catch{}toast('Automatique : AI Hub choisit le compte et en change tout seul');return}\r\n  if(b.dataset.only!==undefined){const v=b.dataset.only;p.only=v||'';p.pin=''\r\n    save();closeH();drawHAcc();dimKeys();try{H().drawKeyChip&&H().drawKeyChip()}catch{}\r\n    toast('IA '+v+' : seuls les comptes '+v+' sont utilisés');return}\r\n  if(b.dataset.pin!==undefined){p.pin=b.dataset.pin;save();closeH();try{H().drawKeyChip&&H().drawKeyChip()}catch{}drawHAcc()}});\r\ndocument.addEventListener('mousedown',e=>{if(!menu.hidden&&!e.target.closest('#hmenu,#hacc'))closeH()});\r\ndocument.addEventListener('keydown',e=>{if(e.key==='Escape')closeH()});\r\nwindow.addEventListener('resize',closeH);\r\n\r\n// plateformes hors mode « seul » : atténuées dans la liste des clés\r\nfunction dimKeys(){const o=only();\r\n  document.querySelectorAll('#list .acc[data-id]').forEach(r=>{const a=find(r.dataset.id);r.classList.toggle('out',!!(o&&a&&a.p!==o))});\r\n  document.querySelectorAll('#list .grp').forEach(g=>g.classList.toggle('out',!!(o&&g.textContent.trim()!==o)))}\r\nconst _r=render;render=function(){_r.apply(this,arguments);try{drawHAcc();dimKeys()}catch{}};\r\nconst _l=renderList;renderList=function(){_l.apply(this,arguments);try{dimKeys()}catch{}};\r\nsetInterval(()=>{try{drawHAcc()}catch{}},4000);\r\n\r\n// ---------- réglage : réduire les animations ----------\r\nconst rm=v=>root.classList.toggle('rm',!!v);\r\ntry{rm(localStorage.aihubRM)}catch{}\r\ntry{const card=$('preall').closest('.card');\r\n  if(card){card.insertAdjacentHTML('beforeend','<label class=\"opt\"><span><b>Réduire les animations</b><small>Coupe les transitions et animations de l\\'interface (repliage de la barre latérale, menus, messages).</small></span><input type=\"checkbox\" class=\"sw\" id=\"rmot\"></label>');\r\n    const c=$('rmot');c.checked=!!localStorage.aihubRM;c.onchange=()=>{try{localStorage.aihubRM=c.checked?'1':''}catch{}rm(c.checked)}}}catch{}\r\n\r\ndrawHAcc();dimKeys();\r\nwindow.hub263={version:V,sidebar:setSB,scope:only};\r\n\r\n}catch(x){console.error('module 2.6.3',x)}})();\r\n</script>\r\n<style id=\"css264\">\r\n/* ===== 2.6.4 : chat centré, texte en direct, file d'attente, fichiers échangés, panneau de détail, couleur d'accent ===== */\r\n#toast{top:122px}\r\n#chat{--col:min(840px,calc(100% - 56px));position:absolute}\r\n#ch-msgs{scrollbar-gutter:stable both-edges}\r\n#ch-msgs>*{width:var(--col)}\r\n#ch-bar>*{width:var(--col)}\r\n#ch-bar{padding:8px 0 40px}\r\n#ch-box{grid-template-columns:auto 1fr auto auto;grid-template-areas:\"in in in in\" \"att . stop go\"}\r\n#ch-stop{grid-area:stop}\r\n#ch-box #ch-in,#ch-box #ch-in:focus,#ch-box #ch-in:focus-visible{border:0!important;box-shadow:none!important;outline:none!important;background:transparent!important;padding:2px 4px 6px}\r\n#ch-hint{text-align:center}\r\n/* texte en direct */\r\n.m.live{animation:none}\r\n.m.live .caret{display:inline-block;width:7px;height:15px;margin-left:2px;vertical-align:-2px;background:var(--acc);border-radius:2px;animation:caretb 1s steps(2,start) infinite}\r\n@keyframes caretb{to{opacity:0}}\r\n/* fichiers dans les messages et le panneau « Échanges » */\r\n.mfc{display:flex;flex-wrap:wrap;gap:8px;margin-top:8px}\r\n.m.u .mfc{justify-content:flex-end}\r\n.fcx,.exr{display:flex;align-items:center;gap:10px;padding:6px 8px 6px 6px;border:1px solid var(--line);border-radius:10px;background:var(--panel);cursor:pointer;max-width:300px;min-width:0;transition:border-color .15s,background .15s,transform .18s var(--ease)}\r\n.fcx:hover,.exr:hover{border-color:var(--line2);background:var(--hover);transform:translateY(-1px)}\r\n.fcx-pv{width:40px;height:40px;border-radius:8px;overflow:hidden;flex:none;display:grid;place-items:center;background:var(--soft);color:var(--acc);font:600 10px var(--sans);letter-spacing:.03em}\r\n.fcx-pv img{width:100%;height:100%;object-fit:cover;display:block}\r\n.fcx-b{min-width:0;display:flex;flex-direction:column;flex:1}\r\n.fcx-b b{font-weight:500;font-size:12.5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\r\n.fcx-b small{font-size:11px;color:var(--dim)}\r\n.fcx-d{flex:none;display:grid;place-items:center;width:26px;height:26px;border:0;border-radius:6px;background:transparent;color:var(--dim);cursor:pointer}\r\n.fcx-d:hover{background:var(--sel);color:var(--txt)}\r\n@keyframes drin{from{opacity:0;transform:translateX(18px)}to{opacity:1;transform:none}}\r\n/* file d'attente */\r\n#ch-queue{margin-bottom:8px;border:1px solid var(--line);border-radius:10px;background:var(--panel);overflow:hidden;animation:drin .2s var(--ease)}\r\n#ch-queue[hidden]{display:none}\r\n#ch-queue .qh{display:flex;align-items:center;gap:8px;padding:6px 10px;font-size:12px;color:var(--dim);border-bottom:1px solid var(--line)}\r\n#ch-queue .qh>span:first-child{display:flex;align-items:center;gap:6px}\r\n#ch-queue .qh .sp{flex:1}\r\n#ch-queue .qh button{font:inherit;font-size:12px;color:var(--txt);background:var(--hover);border:0;border-radius:6px;padding:2px 10px;cursor:pointer}\r\n#ch-queue .qi{display:flex;align-items:center;gap:8px;padding:6px 10px;font-size:13px}\r\n#ch-queue .qi+.qi{border-top:1px solid var(--line)}\r\n#ch-queue .qi i{font-style:normal;color:var(--dim);font-size:11.5px;width:14px}\r\n#ch-queue .qi span{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\r\n#ch-queue .qi em{font-style:normal;color:var(--dim);font-size:11.5px;display:inline-flex;align-items:center;gap:3px}\r\n#ch-queue .qi b{cursor:pointer;color:var(--dim);line-height:0;padding:3px;border-radius:5px}\r\n#ch-queue .qi b:hover{color:var(--err);background:var(--hover)}\r\n/* page Fichiers : panneau de détail */\r\n#fwrap.det{grid-template-columns:188px minmax(0,1fr) 300px}\r\n#fdet{position:sticky;top:0;display:flex;flex-direction:column;gap:12px;padding:14px;border:1px solid var(--line);border-radius:12px;background:var(--panel);animation:drin .2s var(--ease);min-width:0;max-height:calc(100vh - 140px);overflow:auto}\r\n#fdet[hidden]{display:none}\r\n#fdet .fdh{display:flex;align-items:center;gap:8px}\r\n#fdet .fdh b{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:13.5px}\r\n#fdet .fdp{border:1px solid var(--line);border-radius:8px;background:var(--bg);overflow:hidden;display:grid;place-items:center;min-height:120px;max-height:260px}\r\n#fdet .fdp img{max-width:100%;max-height:260px;display:block}\r\n#fdet .fdp pre{margin:0;padding:10px;width:100%;max-height:260px;overflow:auto;font-size:11.5px;line-height:1.5;white-space:pre-wrap;word-break:break-word}\r\n#fdet .fdbig{padding:20px;transform:scale(1.5)}\r\n#fdet .fdi{display:grid;grid-template-columns:auto 1fr;gap:6px 12px;margin:0;font-size:12.5px}\r\n#fdet .fdi dt{color:var(--dim)}#fdet .fdi dd{margin:0;word-break:break-word}\r\n#fdet .fda{display:flex;flex-wrap:wrap;gap:6px}\r\n#fgrid .fcard.cur{background:var(--sel)!important}\r\n@media (max-width:1180px){#fwrap.det{grid-template-columns:1fr}#fdet{position:static;max-height:none}}\r\n/* réglage : couleur d'accentuation */\r\n.accopt{cursor:default;align-items:flex-start}\r\n#accs{display:flex;flex-wrap:wrap;gap:8px;justify-content:flex-end;max-width:300px}\r\n.sw2{width:24px;height:24px;border-radius:50%;border:2px solid transparent;background:var(--hover);color:var(--dim);font-size:12px;display:grid;place-items:center;cursor:pointer;padding:0;position:relative;transition:transform .15s var(--ease),box-shadow .15s}\r\n.sw2:hover{transform:scale(1.12)}\r\n.sw2.on{box-shadow:0 0 0 2px var(--bg),0 0 0 4px var(--acc)}\r\n.sw2.pick{background:conic-gradient(#ef4444,#eab308,#22c55e,#14b8a6,#4f8cff,#8b5cf6,#ec4899,#ef4444);overflow:hidden}\r\n.sw2.pick input{opacity:0;position:absolute;inset:-4px;width:34px;height:34px;cursor:pointer;border:0;padding:0}\r\n</style>\r\n<style id=\"css266\">\r\n/* ===== 2.6.6 : cartes de fichiers, étapes de Claude, bouton de synchronisation ===== */\r\n.mfc{flex-direction:column;align-items:stretch;gap:8px;max-width:520px}\r\n.m.u .mfc{align-items:flex-end}\r\n.fcx{padding:10px 12px;gap:12px;max-width:520px;width:100%;cursor:default;border-radius:12px}\r\n.fcx:hover{transform:none;background:var(--panel)}\r\n.fcx .fcx-pv{width:46px;height:46px;border-radius:10px;font-size:11px}\r\n.fcx.pdf .fcx-pv{background:color-mix(in srgb,#ef4444 14%,transparent);color:#ef4444}\r\n.fcx.doc .fcx-pv{background:color-mix(in srgb,#3b82f6 14%,transparent);color:#3b82f6}\r\n.fcx.xls .fcx-pv{background:color-mix(in srgb,#22c55e 14%,transparent);color:#22c55e}\r\n.fcx.ppt .fcx-pv{background:color-mix(in srgb,#f97316 14%,transparent);color:#f97316}\r\n.fcx.zip .fcx-pv{background:color-mix(in srgb,#eab308 16%,transparent);color:#ca8a04}\r\n.fcx.code .fcx-pv{background:color-mix(in srgb,#8b5cf6 14%,transparent);color:#8b5cf6}\r\n.fcx.img .fcx-pv{background:var(--hover)}\r\n.fcx-a{display:flex;gap:6px;flex:none}\r\n.fcx-btn,.fcx-all{font:inherit;font-size:12.5px;display:inline-flex;align-items:center;gap:6px;padding:6px 12px;border-radius:8px;border:1px solid var(--line2);background:transparent;color:var(--txt);cursor:pointer;transition:background .15s,filter .15s,transform .12s}\r\n.fcx-btn:hover,.fcx-all:hover{background:var(--hover)}\r\n.fcx-btn:active,.fcx-all:active{transform:scale(.97)}\r\n.fcx-btn.pri{background:var(--btn,var(--txt));color:var(--btntx,var(--bg));border-color:transparent;font-weight:500}\r\n.fcx-btn.pri:hover{background:var(--btnh,var(--btn,var(--txt)));filter:brightness(.93)}\r\n.fcx-all{align-self:flex-start}\r\n.fcx .ic,.fcx-all .ic{width:14px;height:14px}\r\n.lacts{display:flex;flex-direction:column;gap:2px;margin:6px 0 2px;font-size:12.5px}\r\n.la{display:flex;gap:8px;align-items:baseline;color:var(--dim);font-family:ui-monospace,Consolas,monospace}\r\n.la i{font-style:normal;width:12px;flex:none}.la.ok i{color:var(--acc)}.la.err{color:#e5484d}.la.err i{color:#e5484d}\r\n.la span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0}\r\ndetails.steps{margin:0 0 8px;font-size:12.5px;color:var(--dim)}\r\ndetails.steps summary{cursor:pointer;display:inline-flex;align-items:center;gap:6px;list-style:none;padding:3px 8px;border-radius:7px;transition:background .15s}\r\ndetails.steps summary::-webkit-details-marker{display:none}\r\ndetails.steps summary:hover{background:var(--hover)}\r\ndetails.steps summary .ic{width:13px;height:13px}\r\ndetails.steps[open]{animation:drin .18s var(--ease)}\r\n.st{display:flex;gap:8px;align-items:flex-start;font-size:12.5px;color:var(--dim);padding:2px 8px;line-height:1.45}\r\n.st i{font-style:normal;color:#4ec9a0;flex:none}\r\n.stk{width:var(--col);margin:0 auto 6px;display:flex;flex-direction:column;animation:drin .18s var(--ease)}\r\n@media (max-width:760px){.fcx{flex-wrap:wrap}.fcx-a{width:100%}}\r\n</style>\r\n<script>\r\n/* 2.6.4 — page Fichiers : Envoyés / Reçus + panneau de détail à droite ; réglage de la couleur d'accentuation. */\r\n(function(){try{\r\nconst root=document.documentElement;\r\n// ---------- couleur d'accentuation ----------\r\nconst PAL=[['Neutre',''],['Bleu','#4f8cff'],['Violet','#8b5cf6'],['Rose','#ec4899'],['Rouge','#ef4444'],['Orange','#f97316'],['Jaune','#eab308'],['Vert','#22c55e'],['Turquoise','#14b8a6'],['Terracotta','#d97757']];\r\nconst lum=c=>{const n=parseInt(c.slice(1),16),f=v=>{v/=255;return v<=.03928?v/12.92:Math.pow((v+.055)/1.055,2.4)};return .2126*f(n>>16&255)+.7152*f(n>>8&255)+.0722*f(n&255)};\r\nfunction applyAcc(c){const s=root.style,ps=['--acc','--soft','--btn','--btnh','--btntx'];\r\n  if(!/^#[0-9a-f]{6}$/i.test(c||'')){ps.forEach(p=>s.removeProperty(p));return}\r\n  s.setProperty('--acc',c);s.setProperty('--soft','color-mix(in srgb,'+c+' 15%,transparent)');s.setProperty('--btn',c);\r\n  s.setProperty('--btnh','color-mix(in srgb,'+c+' 84%,#000)');s.setProperty('--btntx',lum(c)>.5?'#111':'#fff')}\r\nlet shown;const getAcc=()=>{let v=settings.accent;if(v==null){try{v=localStorage.aihubAcc||''}catch{v=''}}return v||''};\r\nfunction syncAcc(){const c=getAcc();if(c===shown)return;shown=c;applyAcc(c);drawAccUI()}\r\nfunction setAcc(c){settings.accent=c||'';try{localStorage.aihubAcc=c||''}catch{}save();syncAcc()}\r\nfunction drawAccUI(){const box=document.getElementById('accs');if(!box)return;const c=getAcc().toLowerCase();\r\n  box.innerHTML=PAL.map(([n,h])=>`<button type=\"button\" class=\"sw2${(h||'')===c?' on':''}\" data-acc=\"${h}\" title=\"${n}\" style=\"${h?'background:'+h:''}\">${h?'':'∅'}</button>`).join('')\r\n    +`<label class=\"sw2 pick${c&&!PAL.some(p=>p[1]===c)?' on':''}\" title=\"Couleur libre\"><input type=\"color\" id=\"accpick\" value=\"${c||'#4f8cff'}\"></label>`}\r\ntry{const card=document.getElementById('preall').closest('.card');\r\n  if(card){card.insertAdjacentHTML('beforeend','<div class=\"opt accopt\"><span><b>Couleur d\\'accentuation</b><small>Boutons, sélections, indicateurs et notifications. « Neutre » garde le style Cursor par défaut.</small></span><div id=\"accs\"></div></div>');\r\n    const box=document.getElementById('accs');\r\n    box.addEventListener('click',e=>{const b=e.target.closest('[data-acc]');if(b)setAcc(b.dataset.acc)});\r\n    box.addEventListener('input',e=>{if(e.target.id==='accpick'){applyAcc(e.target.value);shown=e.target.value}});\r\n    box.addEventListener('change',e=>{if(e.target.id==='accpick')setAcc(e.target.value)});\r\n    drawAccUI()}}catch(x){console.error('accent ui',x)}\r\nconst _r=render;render=function(){_r.apply(this,arguments);try{syncAcc()}catch{}};\r\ntry{syncAcc()}catch{}\r\n\r\n// ---------- panneau de détail d'un fichier ----------\r\nconst wrap=document.getElementById('fwrap');\r\nif(wrap){\r\n  const det=document.createElement('aside');det.id='fdet';det.hidden=true;wrap.appendChild(det);\r\n  let url='',urlId='',tok=0;\r\n  const kb=n=>typeof fmtSize==='function'?fmtSize(n):n+' o';\r\n  const isText=f=>/^text\\/|json|javascript|xml|svg/.test(f.type||'')||/\\.(md|txt|py|js|json|html|css|csv|log|ya?ml|ts|jsx|tsx|java|c|cpp|cs|sh|bat|ini|toml)$/i.test(f.name);\r\n  window.drawDet=async function(){\r\n    const f=DET&&byId(DET);\r\n    if(!f){DET=null;det.hidden=true;wrap.classList.remove('det');return}\r\n    const my=++tok;wrap.classList.add('det');det.hidden=false;\r\n    const ik=iconKind(f),pj=projOf(f),dir=f.dir==='sent'?'Envoyé à l\\'IA':f.dir==='recv'?'Reçu de l\\'IA':'';\r\n    let pv='';\r\n    if(ik==='image'){if(urlId!==f.id){if(url)URL.revokeObjectURL(url);url=URL.createObjectURL(f.blob);urlId=f.id}pv=`<img src=\"${url}\" alt=\"\">`}\r\n    else if(isText(f)){let t='';try{t=await f.blob.slice(0,3000).text()}catch{}if(my!==tok)return;pv=`<pre>${esc(t)}${f.size>3000?'\\n…':''}</pre>`}\r\n    else pv=`<div class=\"fdbig\">${typeof fileTile==='function'?fileTile(f):''}</div>`;\r\n    const rows=[['Type',typeof fileLabel==='function'?fileLabel(f):(f.type||'—')],['Taille',kb(f.size)],['Ajouté',new Date(f.added).toLocaleString('fr-FR',{day:'numeric',month:'long',hour:'2-digit',minute:'2-digit'})],['Projet',pj?pj.name:'Aucun']];\r\n    if(dir)rows.push(['Sens',dir]);if(f.src&&f.src.conv)rows.push(['Conversation',f.src.conv]);if(f.src&&f.src.acc)rows.push(['Compte',(f.src.p||'')+' · '+f.src.acc]);\r\n    if((f.tags||[]).length)rows.push(['Étiquettes',f.tags.map(t=>'#'+t).join(' ')]);\r\n    det.innerHTML=`<div class=\"fdh\"><b title=\"${esc(f.name)}\">${esc(f.name)}</b><button class=\"btn ghost ico\" data-fdx type=\"button\" title=\"Fermer le panneau\">${IC('x')}</button></div><div class=\"fdp\">${pv}</div><dl class=\"fdi\">${rows.map(r=>`<dt>${esc(r[0])}</dt><dd>${esc(r[1])}</dd>`).join('')}</dl><div class=\"fda\"><button class=\"btn sm\" data-fdatt type=\"button\">${IC('clip')}Joindre à une conversation</button><button class=\"btn ghost sm\" data-fddl type=\"button\">${IC('dl')}Télécharger</button><button class=\"btn ghost sm\" data-fdbig type=\"button\">Agrandir</button></div>`};\r\n  det.addEventListener('click',e=>{const f=DET&&byId(DET);if(!f)return;\r\n    if(e.target.closest('[data-fdx]')){DET=null;document.querySelectorAll('#fgrid .fcard.cur').forEach(r=>r.classList.remove('cur'));drawDet();return}\r\n    if(e.target.closest('[data-fddl]'))return dlFile(f);\r\n    if(e.target.closest('[data-fdbig]'))return openPrev(f.id);\r\n    if(e.target.closest('[data-fdatt]')){const b=document.querySelector(`#fgrid .fcard[data-id=\"${f.id}\"] [data-att]`);if(b)b.click();else toast('Joindre : disponible hors corbeille')}});\r\n  document.getElementById('fgrid').addEventListener('click',e=>{\r\n    const row=e.target.closest('.fcard');if(!row||e.target.closest('button,input,label,textarea,select,[data-prev],[data-prevw]'))return;\r\n    DET=row.dataset.id;document.querySelectorAll('#fgrid .fcard.cur').forEach(r=>r.classList.remove('cur'));row.classList.add('cur');drawDet()});\r\n  document.addEventListener('keydown',e=>{if(e.key==='Escape'&&DET&&!document.querySelector('#fprev:not([hidden])')&&!e.target.closest('input,textarea')&&document.getElementById('files').classList.contains('on')){DET=null;document.querySelectorAll('#fgrid .fcard.cur').forEach(r=>r.classList.remove('cur'));drawDet()}});\r\n}\r\nwindow.hub264={version:'2.6.4'};\r\n}catch(x){console.error('module 2.6.4',x)}})();\r\n</script>\r\n<style id=\"css270\">\r\n/* ===== 2.7.0 ===== */\r\n.caret{display:none!important}\r\n.m .mact{opacity:0;transition:opacity .15s;margin-top:6px}\r\n.m:hover .mact{opacity:1}\r\n.m.u .mact{text-align:right}\r\n.mact button{display:inline-flex;align-items:center;gap:6px;border:0;background:none;color:var(--dim);font:inherit;font-size:12px;padding:3px 7px;border-radius:6px;cursor:pointer}\r\n.mact button:hover{background:var(--hover);color:var(--txt)}\r\n.mact .ic{width:13px;height:13px}\r\n\r\n/* 2.8.0 : sélecteur En ligne / Local, détails du relais */\r\n#ch-box{grid-template-columns:auto auto 1fr auto auto!important;grid-template-areas:\"in in in in in\" \"att mode . stop go\"!important}\r\n#ch-mode{grid-area:mode;display:inline-flex;align-items:center;gap:6px;font-size:12.5px;padding:4px 10px;border-radius:999px;color:var(--dim)}\r\n#ch-mode:hover{color:var(--txt)}#ch-mode.loc{color:var(--acc)}\r\n#ch-mode .ic{width:14px;height:14px}\r\n#ch-mode .kl{max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\r\n#ch-menu button .ic{width:15px;height:15px;margin-right:2px}\r\n.sysd summary{list-style:none;cursor:pointer;text-align:center}.sysd summary::-webkit-details-marker{display:none}\r\n.sysd summary span::after{content:' ▾';opacity:.6}.sysd[open] summary span::after{content:' ▴'}\r\n.sysd pre{margin:8px auto 0;max-width:640px;max-height:260px;overflow:auto;white-space:pre-wrap;text-align:left;font:11.5px/1.5 var(--mono,monospace);background:var(--soft);border:1px solid var(--line);border-radius:8px;padding:8px 10px;color:var(--dim)}\r\n\r\n/* 3.0.0 : moteur local complet — cartes d'actions repliables, historique, réglages */\r\n.lacts details.la{display:block}.lacts details.la summary{display:flex;gap:8px;align-items:baseline;cursor:pointer;list-style:none}\r\n.lacts details.la summary::-webkit-details-marker{display:none}.lacts details.la summary i{font-style:normal;width:12px;flex:none}\r\n.lacts details.la summary span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0}\r\n.lacts details.la summary:hover span{text-decoration:underline;text-decoration-color:var(--line)}\r\n.lacts details.la pre{margin:4px 0 6px 20px;padding:8px 10px;max-height:240px;overflow:auto;background:var(--bg2,rgba(127,127,127,.08));border:1px solid var(--line);border-radius:8px;font:12px/1.45 ui-monospace,Consolas,monospace;color:var(--txt);white-space:pre-wrap;word-break:break-word}\r\n.lchg{display:flex;gap:10px;align-items:center;margin-top:6px;padding-top:6px;border-top:1px dashed var(--line);font-size:12.5px;color:var(--dim)}\r\n.lchg span{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.lchg em{font-style:normal;color:var(--dim)}\r\n\r\n/* 3.7.0 : diffs, tokens */\r\n.ldfd{margin:2px 0 4px 20px;font-size:12.5px}.ldfd summary{cursor:pointer;color:var(--dim);list-style:none}.ldfd summary::-webkit-details-marker{display:none}.ldfd summary:hover{text-decoration:underline;text-decoration-color:var(--line)}\r\npre.ldf{margin:4px 0 6px;padding:6px 0;max-height:300px;overflow:auto;background:var(--bg2,rgba(127,127,127,.08));border:1px solid var(--line);border-radius:8px;font:12px/1.5 ui-monospace,Consolas,monospace;white-space:pre;color:var(--txt)}\r\npre.ldf .dl{display:block;padding:0 10px;min-width:max-content}pre.ldf .dl.a{background:rgba(46,160,67,.18);color:#2da44e}pre.ldf .dl.d{background:rgba(229,72,77,.16);color:#e5484d}pre.ldf .dl.h{color:var(--dim);font-style:italic;padding-top:3px}\r\n.pl{color:#2da44e;font-weight:600}.mn{color:#e5484d;font-weight:600}\r\n.ldfask{display:block!important}.ldfask .ldft{font-weight:600;margin-bottom:4px}.ldfb{display:flex;gap:8px;margin-top:6px}.ldfs{margin-top:6px;color:var(--dim);font-size:12.5px}\r\n.ltok{margin-top:4px;font-size:11.5px;color:var(--dim)}\r\n.lund{font:inherit;font-size:12px;padding:3px 10px;border-radius:8px;border:1px solid var(--line);background:transparent;color:var(--txt);cursor:pointer}.lund:hover{border-color:var(--acc);color:var(--acc)}\r\ndialog.wide{width:min(620px,92vw);max-height:84vh;flex-direction:column}\r\ndialog.wide:not([open]){display:none!important}\r\ndialog.wide[open]{display:flex}\r\n#lpane{overflow:auto;min-height:200px;flex:1;padding:2px 2px 6px}\r\n.ltabs{display:flex;gap:6px;margin:10px 0 8px;border-bottom:1px solid var(--line)}\r\n.ltabs button{font:inherit;padding:6px 12px;background:none;border:none;border-bottom:2px solid transparent;color:var(--dim);cursor:pointer}\r\n.ltabs button.on{color:var(--txt);border-bottom-color:var(--acc)}\r\n.lh{display:flex;gap:10px;align-items:center;padding:5px 0;border-bottom:1px solid var(--line);font-size:13px}\r\n.lh .lt{color:var(--dim);flex:none;font-size:12px}.lh b{flex:none;font-family:ui-monospace,Consolas,monospace;font-weight:500;min-width:52px}\r\n.lh .lp{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-family:ui-monospace,Consolas,monospace;font-size:12.5px}.lh .lp.wrap{white-space:normal;font-family:inherit}\r\n.lh .btn{padding:3px 10px;font-size:12px;flex:none}\r\n.lhl{max-height:300px;overflow:auto;margin:8px 0}.row.l{justify-content:flex-start;margin:8px 0}\r\n.lj{margin-top:8px;font-size:13px}.lj pre{max-height:200px;overflow:auto;font:12px/1.5 ui-monospace,Consolas,monospace;white-space:pre-wrap;color:var(--dim)}\r\n#lpane input[type=number]{width:120px}\r\n\r\n/* ===== 3.8.1 : interface type Cursor — explorateur | éditeur à onglets | chat ===== */\r\n#explorer{width:var(--exw,264px);flex:none;display:flex;flex-direction:column;background:var(--side);border-right:1px solid var(--line);min-width:0;position:relative;animation:pagein .25s var(--ease) backwards}\r\n#explorer[hidden]{display:none}\r\n#exsplit,#chsplit{position:absolute;top:0;bottom:0;width:7px;cursor:col-resize;z-index:30}\r\n#exsplit{right:-4px}#chsplit{display:none;right:calc(var(--cw,var(--cw0)) - 4px)}\r\n#exsplit:hover,#chsplit:hover,#exsplit.drag,#chsplit.drag{background:linear-gradient(90deg,transparent 2px,var(--acc) 2px,var(--acc) 4px,transparent 4px)}\r\n#views.split #chsplit{display:block}\r\n.xh{display:flex;align-items:center;gap:4px;padding:10px 10px 6px 14px}\r\n.xh b{flex:1;font-size:11px;letter-spacing:.07em;text-transform:uppercase;color:var(--dim);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:600}\r\n.xh button,.xr .xa button,#ed-h button{font:inherit;color:var(--dim);background:none;border:0;border-radius:7px;cursor:pointer;display:grid;place-items:center;min-width:26px;height:26px;padding:0 6px;font-size:12px}\r\n.xh button:hover,.xr .xa button:hover,#ed-h button:hover{background:var(--sel);color:var(--txt)}\r\n.xh .ic{width:15px;height:15px}\r\n.xs{display:flex;gap:6px;padding:0 10px 8px}\r\n#xq{flex:1;min-width:0;font:inherit;font-size:12.5px;color:var(--txt);background:var(--bg);border:1px solid var(--line);border-radius:8px;padding:5px 9px;outline:none}\r\n#xq:focus{border-color:var(--acc)}\r\n#xmode{font:inherit;font-size:11.5px;color:var(--dim);background:var(--bg);border:1px solid var(--line);border-radius:8px;padding:0 8px;cursor:pointer}\r\n#xmode.on{color:var(--acc);border-color:var(--acc)}\r\n#xtree{flex:1;overflow:auto;padding:0 0 12px;font-size:13px;user-select:none}\r\n.xr{display:flex;align-items:center;gap:6px;height:26px;padding-right:6px;cursor:pointer;color:var(--txt);border-radius:0;position:relative}\r\n.xr:hover{background:var(--sel)}.xr.on{background:var(--soft);color:var(--acc)}\r\n.xr .xc{width:12px;flex:none;color:var(--dim);font-style:normal;font-size:10px;text-align:center;transition:transform .12s}\r\n.xr.d.o .xc{transform:rotate(90deg)}\r\n.xr .xb{flex:none;min-width:22px;text-align:center;font-size:8.5px;font-weight:700;letter-spacing:.02em;border-radius:4px;padding:1px 3px;color:#fff;background:var(--c,#7a7f87)}\r\n.xr.d .xb{background:none;color:var(--dim)}.xr.d .xb .ic{width:15px;height:15px;display:block}\r\n.xr .xn{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\r\n.xr.chg .xn::after{content:\"\";display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--acc);margin-left:7px;vertical-align:middle}\r\n.xr .xa{display:none;gap:0}.xr:hover .xa{display:flex}\r\n.xr .xd{font-size:11px;color:var(--dim);flex:none}\r\n.xhit{padding:5px 12px;cursor:pointer;font-size:12px;border-bottom:1px solid var(--line)}\r\n.xhit:hover{background:var(--sel)}.xhit b{display:block;font-weight:600;font-size:12px;color:var(--txt);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\r\n.xhit span{display:block;color:var(--dim);font-family:ui-monospace,Consolas,monospace;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\r\n.xnote{padding:14px;color:var(--dim);font-size:12.5px;line-height:1.55}\r\n.xnote .btn{margin-top:10px}\r\n#tabs{display:flex;align-items:stretch;background:var(--side);border-bottom:1px solid var(--line);overflow-x:auto;overflow-y:hidden;flex:none;height:36px;scrollbar-width:none}\r\n#tabs[hidden]{display:none}\r\n.tb{display:flex;align-items:center;gap:7px;padding:0 8px 0 13px;border-right:1px solid var(--line);color:var(--dim);cursor:pointer;font-size:12.5px;white-space:nowrap;flex:none;max-width:220px;transition:background .12s}\r\n.tb:hover{background:var(--sel)}.tb.on{background:var(--bg);color:var(--txt);box-shadow:inset 0 -2px var(--acc)}\r\n.tb .tn{overflow:hidden;text-overflow:ellipsis}\r\n.tb b{display:grid;place-items:center;width:18px;height:18px;border-radius:5px;font-weight:400;font-size:14px;line-height:1;color:var(--dim)}\r\n.tb b:hover{background:var(--line);color:var(--txt)}\r\n.tb .dot{width:8px;height:8px;border-radius:50%;background:var(--acc);margin:0 5px}\r\n.tb.dirty b{display:none}.tb.dirty:hover b{display:grid}.tb.dirty:hover .dot{display:none}\r\n#editor{position:absolute;top:0;left:0;bottom:0;right:var(--cw,var(--cw0));display:none;flex-direction:column;background:var(--bg);min-width:0;z-index:4}\r\n#views.split #editor{display:flex}\r\n#views.split #chat{left:auto;width:var(--cw,var(--cw0));border-left:1px solid var(--line)}\r\n#views.split #ch-top{padding:8px 14px}#views.split #ch-desc{display:none}\r\n#views.split #ch-msgs>*,#views.split #ch-bar>*{width:calc(100% - 26px)}\r\n#ed-h{display:flex;align-items:center;gap:6px;padding:5px 10px 5px 16px;border-bottom:1px solid var(--line);font-size:12.5px;color:var(--dim)}\r\n#ed-h .pth{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-family:ui-monospace,Consolas,monospace;font-size:12px}\r\n#ed-h .stl{color:var(--err);font-size:12px}\r\n#ed-h .btn{padding:3px 10px;font-size:12px}\r\n#ed-b{flex:1;min-height:0;position:relative;display:flex}\r\n#egut{margin:0;padding:12px 8px 12px 0;width:52px;flex:none;text-align:right;overflow:hidden;color:var(--dim);font:13px/20px ui-monospace,Consolas,monospace;background:var(--bg);border-right:1px solid var(--line);user-select:none;opacity:.7}\r\n#ed{flex:1;min-width:0;resize:none;border:0;outline:0;background:var(--bg);color:var(--txt);font:13px/20px ui-monospace,Consolas,monospace;padding:12px 16px;white-space:pre;overflow:auto;tab-size:2}\r\n#ed-o{flex:1;display:grid;place-items:center;overflow:auto;padding:16px;color:var(--dim);text-align:center}\r\n#ed-o img{max-width:100%;max-height:100%;object-fit:contain;background:repeating-conic-gradient(var(--line) 0 25%,transparent 0 50%) 0 0/16px 16px;border-radius:8px}\r\n#status{display:flex;align-items:center;gap:16px;height:24px;padding:0 12px;font-size:11.5px;color:var(--dim);background:var(--side);border-top:1px solid var(--line);flex:none;white-space:nowrap;overflow:hidden}\r\n#status[hidden]{display:none}#status .sp{flex:1}#status a{cursor:pointer}#status a:hover{color:var(--txt)}\r\n#status .loc{color:var(--acc)}\r\n#qo{position:fixed;inset:0;z-index:120;background:rgba(0,0,0,.35);display:flex;justify-content:center;align-items:flex-start;padding-top:12vh;backdrop-filter:blur(2px)}\r\n#qo[hidden]{display:none}\r\n#qo .qb{width:min(620px,92vw);background:var(--panel);border:1px solid var(--line2);border-radius:14px;box-shadow:var(--shadow);overflow:hidden;animation:pagein .15s var(--ease) backwards}\r\n#qi{width:100%;box-sizing:border-box;font:inherit;font-size:15px;color:var(--txt);background:transparent;border:0;border-bottom:1px solid var(--line);padding:14px 16px;outline:none}\r\n#ql{max-height:46vh;overflow:auto;padding:6px}\r\n.qr{display:flex;gap:10px;align-items:baseline;padding:7px 11px;border-radius:9px;cursor:pointer;font-size:13.5px}\r\n.qr.on{background:var(--soft);color:var(--acc)}.qr em{font-style:normal;color:var(--dim);font-size:12px;margin-left:auto;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:55%;direction:rtl}\r\n.qh{padding:7px 14px;font-size:11.5px;color:var(--dim);border-top:1px solid var(--line)}\r\n#xdlg{border:1px solid var(--line2);border-radius:14px;background:var(--panel);color:var(--txt);padding:18px;width:min(420px,90vw)}\r\n#xdlg::backdrop{background:rgba(0,0,0,.4)}#xdlg h3{margin:0 0 10px;font:500 17px var(--serif)}\r\n#xdlg input{width:100%;box-sizing:border-box;font:inherit;color:var(--txt);background:var(--bg);border:1px solid var(--line);border-radius:9px;padding:8px 10px;outline:none}\r\n#xdlg input:focus{border-color:var(--acc)}#xdlg .row2{display:flex;justify-content:flex-end;gap:8px;margin-top:14px}\r\n@media(max-width:1100px){#explorer{--exw:220px}}\r\n\r\n/* 3.8.1 : explorateur dans la barre de gauche, chat plus étroit, pas de barre d'état */\r\n:root{--cw0:clamp(340px,34vw,500px)}\r\naside{width:var(--aw,264px);position:relative}aside.min{width:52px}\r\n#asplit{position:absolute;top:0;bottom:0;right:-4px;width:7px;cursor:col-resize;z-index:30}\r\naside.min #asplit{display:none}\r\n#asplit:hover,#asplit.drag{background:linear-gradient(90deg,transparent 2px,var(--acc) 2px,var(--acc) 4px,transparent 4px)}\r\n#explorer{width:auto;flex:1 1 auto;min-height:160px;border:0;background:none;animation:none;margin:0 -12px;border-top:1px solid var(--line);padding-top:2px}\r\naside.min #explorer{display:none}\r\n#plist{max-height:120px;overflow:auto;flex:none}\r\n.xl{padding:9px 14px 3px;font-size:10.5px;letter-spacing:.07em;text-transform:uppercase;color:var(--dim);font-weight:600}\r\n.xr .xd{max-width:84px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\r\n.xhit.back{color:var(--acc)}.xhit.back b{color:var(--acc)}\r\n#tabs{overflow:visible}\r\n#tl{display:flex;flex:1;min-width:0;overflow-x:auto;overflow-y:hidden;scrollbar-width:none}\r\n#tr{flex:none;display:flex;align-items:center;padding:0 8px;border-left:1px solid var(--line)}\r\n#tr button{font:inherit;font-size:12px;color:var(--dim);background:none;border:0;border-radius:7px;padding:4px 8px;cursor:pointer;white-space:nowrap}\r\n#tr button:hover{background:var(--sel);color:var(--txt)}\r\n#views.solo #chat{display:none!important}#views.solo #editor{right:0}#views.solo #chsplit{display:none}\r\n#views.split #ch-hint{display:none}\r\n#tabs .tb.gone .tn{text-decoration:line-through;opacity:.6}\r\n#ed-h{flex-wrap:nowrap}#ed-h .stl{flex:none;white-space:nowrap}#ed-pos{flex:none;font-size:11.5px;white-space:nowrap}\r\n#ed-h .eb{font:inherit;font-size:12px;white-space:nowrap;flex:none;color:var(--txt);background:var(--soft);border:1px solid var(--line);border-radius:8px;padding:3px 10px;cursor:pointer;display:inline-block;height:auto;min-width:0}\r\n#ed-h .eb:hover{border-color:var(--acc)}\r\n#ed-h .eb.pri{background:var(--txt);color:var(--bg);border-color:var(--txt)}\r\n#ed-h .eb[hidden],#ed-h .stl[hidden]{display:none}\r\n</style>\r\n<script>\r\n/* 3.8.1 — Un projet = un dossier. Explorateur, onglets + éditeur, chat à droite, Ctrl+P, recherche dans le projet. */\r\n(function(){try{\r\nconst H=window.hub260;if(!H||!window.api||!api.projTree)return;\r\nconst S={tabs:{},act:{},tree:{},open:{},chg:{},snap:{},sub:{},hv:{},q:'',mode:'name',hits:null,ex:true,last:null,shown:''};\r\nconst pid=()=>H.cur(),P=()=>H.P0(pid()),root=()=>{const p=P();return p&&p.local&&p.local.path||''};\r\nconst tabsOf=()=>S.tabs[pid()]||(S.tabs[pid()]=[]),actOf=()=>S.act[pid()]||'chat',cur=()=>tabsOf().find(t=>t.rel===actOf())||null;\r\nconst base=r=>r.split('/').pop(),extOf=r=>{const m=/\\.([A-Za-z0-9]+)$/.exec(r);return m?m[1].toLowerCase():''};\r\nconst col=e=>{let h=0;for(const c of e)h=(h*31+c.charCodeAt(0))%360;return e?`hsl(${h} 45% 46%)`:'#7a7f87'};\r\nconst vis=()=>{const p=P();return !!(p&&H.showChat())};\r\n\r\n// ---------- squelette (créé une fois) ----------\r\nconst ex=document.createElement('div');ex.id='explorer';ex.hidden=true;\r\nex.innerHTML=`<div class=\"xh\"><b id=\"xt\">Fichiers du projet</b><button id=\"xnf\" title=\"Nouveau fichier (termine par / pour créer un dossier)\">${IC('plus')}</button><button id=\"xrf\" title=\"Actualiser\">${IC('refresh')}</button></div>\r\n<div class=\"xs\"><input id=\"xq\" placeholder=\"Rechercher…  (Entrée : dans le texte)\" spellcheck=\"false\"></div><div id=\"xtree\"></div>`;\r\n{let dk=$('u5dock');if(!dk){dk=document.createElement('div');dk.id='u5dock';document.body.appendChild(dk)}dk.appendChild(ex);\r\n const hr0=$('hright'),tb0=document.createElement('button');tb0.id='u5dockbtn';tb0.type='button';tb0.className='btn ghost ic-only';tb0.title='Fichiers du projet (Ctrl+Maj+E)';tb0.setAttribute('aria-label','Fichiers du projet');tb0.innerHTML=IC('folder');tb0.hidden=true;if(hr0)hr0.insertBefore(tb0,hr0.firstChild);\r\n const dkOn=()=>{try{return localStorage.getItem('u5dock')==='1'}catch{return false}};      // R5 : tiroir fermé par défaut, ouvert à la demande\r\n window.u5DockSync=v=>{tb0.hidden=!v;const on=!!v&&dkOn();document.body.classList.toggle('u5-dock',on);tb0.classList.toggle('open',on)};\r\n tb0.onclick=()=>{try{localStorage.setItem('u5dock',dkOn()?'0':'1')}catch{}window.u5DockSync(!ex.hidden)};\r\n{const dk=$('u5dock'),bar=document.createElement('div');bar.id='u5tabs';bar.innerHTML='<button type=\"button\" data-t=\"f\" class=\"on\">Fichiers</button><button type=\"button\" data-t=\"t\">Tâches</button>';dk.insertBefore(bar,dk.firstChild);\r\n  const tp=document.createElement('pre');tp.id='u5tasks';tp.hidden=true;dk.appendChild(tp);\r\n  const load=async()=>{try{const r=root();if(!r||!window.api||!api.localExec){tp.textContent='(aucun dossier de travail)';return}const o=await api.localExec({root:r,verb:'task',arg:'list -a',opts:{}});tp.textContent=(o&&o.out)||'(aucune tâche : demande un gros projet à l\\'IA)'}catch{tp.textContent='(indisponible)'}};\r\n  const show=k=>{bar.querySelectorAll('button').forEach(x=>x.classList.toggle('on',x.dataset.t===k));ex.style.display=k==='f'?'':'none';tp.hidden=k!=='t';if(k==='t')load()};\r\n  bar.onclick=e=>{const x=e.target.closest('button');if(x)show(x.dataset.t)};\r\n  document.addEventListener('keydown',e=>{if(e.key==='Escape'&&document.body.classList.contains('u5-dock')&&!document.querySelector('dialog[open]')&&qo.hidden){try{localStorage.setItem('u5dock','0')}catch{}window.u5DockSync(!ex.hidden)}})}\r\n document.addEventListener('keydown',e=>{if((e.ctrlKey||e.metaKey)&&e.shiftKey&&!e.altKey&&(e.key==='E'||e.key==='e')){e.preventDefault();if(!tb0.hidden)tb0.click()}})}\r\nconst main=document.querySelector('main'),views=$('views');\r\nconst tabs=document.createElement('div');tabs.id='tabs';tabs.hidden=true;tabs.innerHTML='<div id=\"tl\"></div><div id=\"tr\"><button id=\"tchat\"></button></div>';main.insertBefore(tabs,views);\r\nconst ed=document.createElement('section');ed.id='editor';\r\ned.innerHTML=`<div id=\"ed-h\"><span class=\"pth\" id=\"ed-p\"></span><span id=\"ed-pos\"></span><span class=\"stl\" id=\"ed-s\" hidden>Modifié sur le disque</span><button class=\"eb\" id=\"ed-rl\" hidden>Recharger</button><button class=\"eb\" id=\"ed-at\" title=\"Ajouter au chat (Ctrl+L)\">@ chat</button><button class=\"eb pri\" id=\"ed-sv\" title=\"Enregistrer (Ctrl+S)\" hidden>Enregistrer</button></div><div id=\"ed-b\"></div>`;\r\nviews.appendChild(ed);\r\nconst chs=document.createElement('div');chs.id='chsplit';views.appendChild(chs);\r\nconst qo=document.createElement('div');qo.id='qo';qo.hidden=true;qo.innerHTML='<div class=\"qb\"><input id=\"qi\" spellcheck=\"false\" autocomplete=\"off\" placeholder=\"Chercher un projet ou une commande…  ( > commandes · / chat )\"><div id=\"ql\"></div><div class=\"qh\">Entrée ouvrir · ↑↓ choisir · Échap fermer · &gt; commandes · / commandes du chat</div></div>';document.body.appendChild(qo);\r\nconst xd=document.createElement('dialog');xd.id='xdlg';xd.innerHTML='<h3 id=\"xdt\"></h3><input id=\"xdi\" spellcheck=\"false\"><div class=\"row2\"><button class=\"btn\" id=\"xdc\">Annuler</button><button class=\"btn pri\" id=\"xdo\">OK</button></div>';document.body.appendChild(xd);\r\nconst askName=(t,v)=>new Promise(ok=>{$('xdt').textContent=t;$('xdi').value=v||'';let done=false;const fin=x=>{if(done)return;done=true;xd.close();ok(x)};\r\n  $('xdo').onclick=()=>fin($('xdi').value.trim());$('xdc').onclick=()=>fin(null);xd.oncancel=()=>fin(null);$('xdi').onkeydown=e=>{if(e.key==='Enter')fin($('xdi').value.trim())};xd.showModal();$('xdi').focus();$('xdi').select()});\r\n\r\n// ---------- tailles réglables ----------\r\nconst rs=(h,vr,min,max,fromRight,box)=>{h.onmousedown=e=>{e.preventDefault();h.classList.add('drag');const mv=ev=>{const r=box.getBoundingClientRect(),w=fromRight?r.right-ev.clientX:ev.clientX-r.left;\r\n    document.documentElement.style.setProperty(vr,Math.max(min,Math.min(max(),w))+'px')},up=()=>{h.classList.remove('drag');document.removeEventListener('mousemove',mv);document.removeEventListener('mouseup',up);\r\n    try{localStorage['hub'+vr]=getComputedStyle(document.documentElement).getPropertyValue(vr).trim()}catch{}};document.addEventListener('mousemove',mv);document.addEventListener('mouseup',up)}};\r\ntry{['--aw','--cw'].forEach(v=>{if(localStorage['hub'+v])document.documentElement.style.setProperty(v,localStorage['hub'+v])})}catch{}\r\nrs(chs,'--cw',320,()=>Math.max(380,views.clientWidth-320),true,views);\r\nchs.ondblclick=()=>{document.documentElement.style.removeProperty('--cw');try{localStorage['hub--cw']=''}catch{}};\r\n\r\n// ---------- arbre ----------\r\nconst openSet=()=>S.open[pid()]||(S.open[pid()]=new Set());\r\nconst subOf=id=>S.sub[id]||(S.sub[id]={}),hvOf=id=>S.hv[id]||(S.hv[id]=new Set());\r\nconst srt=a=>a;  // le tri est fait côté Windows (dossiers d'abord, puis nom)\r\nasync function loadSub(id,rel){const res=await api.projList({root:root(),rel});if(pid()!==id)return false;\r\n  if(res&&res.ok){subOf(id)[rel]=res.items;res.items.forEach(x=>{if(x.d)hvOf(id).add(x.p)});return true}delete subOf(id)[rel];return false}\r\nfunction flat(id,items){const sub=subOf(id),o=S.open[id]||new Set(),out=[];const add=a=>{for(const x of a){out.push(x);if(x.d&&x.h&&o.has(x.p)&&sub[x.p])add(sub[x.p])}};add(items);return out}\r\nasync function loadTree(quiet){const r=root();if(!r)return;const id=pid();\r\n  try{api.projWatch&&api.projWatch({root:r})}catch{}\r\n  const res=await api.projTree({root:r});if(pid()!==id)return;\r\n  if(!res||!res.ok){S.tree[id]={items:[],err:true};drawEx();return}\r\n  const hv=S.hv[id]=new Set(res.items.filter(x=>x.d&&x.h).map(x=>x.p));\r\n  const o=S.open[id]||new Set(),q=[...o].filter(p=>hv.has(p));\r\n  while(q.length){const p=q.shift();if(await loadSub(id,p)){(subOf(id)[p]||[]).forEach(x=>{if(x.d&&o.has(x.p))q.push(x.p)})}else o.delete(p)}\r\n  if(pid()!==id)return;\r\n  const all=flat(id,res.items),prev=S.snap[id],now={};all.forEach(x=>{if(!x.d)now[x.p]=x.s+':'+x.m});\r\n  const c=S.chg[id]||(S.chg[id]={});\r\n  if(prev){for(const p in now)if(prev[p]===undefined||prev[p]!==now[p])c[p]=1}\r\n  for(const p in c)if(now[p]===undefined&&!res.cut)delete c[p];\r\n  S.snap[id]=now;const key=all.map(x=>x.p+':'+(x.s||'')+':'+(x.m||'')+(x.h?'h':'')).join('|');\r\n  if(quiet&&S.tree[id]&&S.tree[id].key===key)return;S.tree[id]={items:res.items,all,cut:res.cut,key};drawEx()}\r\nfunction fuzzy(q,s){q=q.toLowerCase();s=s.toLowerCase();let i=0,sc=0,last=-2;for(let k=0;k<s.length&&i<q.length;k++)if(s[k]===q[i]){sc+=(k===last+1?3:1);if(k===0||'/._-'.includes(s[k-1]))sc+=3;last=k;i++}return i===q.length?sc-s.length*.02:-1}\r\nconst rowH=(x,dep,c,extra)=>{const e=extOf(x.p);return `<div class=\"xr${x.d?' d':''}${x.d&&extra==='o'?' o':''}${!x.d&&c[x.p]?' chg':''}${!x.d&&actOf()===x.p?' on':''}\" data-p=\"${esc(x.p)}\" data-d=\"${x.d?1:0}\" style=\"padding-left:${8+dep*14}px\"><i class=\"xc\">${x.d?'▸':''}</i><span class=\"xb\" style=\"--c:${col(e)}\">${x.d?IC('folder'):esc((e||'·').slice(0,4).toUpperCase())}</span><span class=\"xn\">${esc(base(x.p))}</span>${extra==='r'&&x.p.includes('/')?`<span class=\"xd\">${esc(x.p.slice(0,x.p.lastIndexOf('/')))}</span>`:''}<span class=\"xa\"><button data-xa=\"at\" title=\"Mentionner dans le chat\">@</button><button data-xa=\"ren\" title=\"Renommer\">✎</button><button data-xa=\"del\" title=\"Mettre à la corbeille\">×</button></span></div>`};\r\nfunction drawEx(){const id=pid(),p=P();const el=$('xtree');if(!p){el.innerHTML='';return}\r\n  const T0=S.tree[id],nf=T0&&(T0.all||T0.items)?(T0.all||T0.items).filter(x=>!x.d).length:0;$('xt').textContent='Fichiers du projet'+(nf?' · '+nf:'');\r\n  if(!root()){el.innerHTML='<div class=\"xnote\">Un projet = un dossier : ses fichiers sont ceux du dossier. Ce projet n\\'a pas encore de dossier.<br><button class=\"btn pri\" id=\"xpick\">Choisir le dossier</button></div>';return}\r\n  if(S.hits&&S.q.length>=2){el.innerHTML='<div class=\"xhit back\" data-back=\"1\"><b>← Retour aux fichiers</b></div>'+(S.hits.length?S.hits.map(h=>`<div class=\"xhit\" data-hp=\"${esc(h.p)}\" data-hl=\"${h.l}\"><b>${esc(h.p)} : ${h.l}</b><span>${esc(h.t)}</span></div>`).join(''):'<div class=\"xnote\">Aucun résultat dans le texte des fichiers.</div>');return}\r\n  const T=T0;if(!T){el.innerHTML='<div class=\"xnote\">Chargement…</div>';return}\r\n  if(T.err){el.innerHTML='<div class=\"xnote\">Dossier introuvable. Il a peut-être été déplacé ou supprimé.<br><button class=\"btn\" id=\"xpick\">Choisir un autre dossier</button></div>';return}\r\n  const q=S.q.trim().toLowerCase(),o=openSet(),c=S.chg[id]||{};let items=q?T.items:(T.all||T.items),rows=[];\r\n  if(q){const keep=new Set();items.forEach(x=>{if(!x.d&&x.p.toLowerCase().includes(q)){keep.add(x.p);let a=x.p;while(a.includes('/')){a=a.slice(0,a.lastIndexOf('/'));keep.add(a)}}});items=items.filter(x=>keep.has(x.p));rows.push('<div class=\"xl\">Entrée = chercher aussi dans le texte</div>')}\r\n  else if(nf>=12){const rec=T.items.filter(x=>!x.d).sort((a,b)=>(b.m||0)-(a.m||0)).slice(0,5);rows.push('<div class=\"xl\">Modifiés récemment</div>'+rec.map(x=>rowH(x,0,c,'r')).join('')+'<div class=\"xl\">Tous les fichiers</div>')}\r\n  let skip=null;for(const x of items){const dep=x.p.split('/').length-1;if(skip!==null){if(dep>skip)continue;skip=null}\r\n    const op=q||o.has(x.p);if(x.d&&!op)skip=dep;rows.push(rowH(x,dep,c,x.d&&op?'o':''))}\r\n  el.innerHTML=rows.join('')||'<div class=\"xnote\">Dossier vide. Demande à l\\'IA de créer des fichiers, ou ajoute-en avec le bouton +.</div>';\r\n  if(T.cut)el.insertAdjacentHTML('beforeend','<div class=\"xnote\">Liste limitée aux 20 000 premiers éléments (le dossier est plus gros).</div>')}\r\n$('xtree').onclick=async e=>{\r\n  if(e.target.id==='xpick'){const p=P();if(p&&await H.pickLocal(p)){S.last=null;sync()}return}\r\n  if(e.target.closest('[data-back]')){S.hits=null;S.q='';$('xq').value='';return drawEx()}const h=e.target.closest('.xhit');if(h)return openFile(h.dataset.hp,+h.dataset.hl);\r\n  const r=e.target.closest('.xr');if(!r)return;const rel=r.dataset.p,d=r.dataset.d==='1',b=e.target.closest('[data-xa]');\r\n  if(b){e.stopPropagation();const a=b.dataset.xa;\r\n    if(a==='at')return mention('@'+rel);\r\n    if(a==='ren'){const n=await askName('Renommer',rel);if(!n||n===rel)return;const res=await api.projOp({root:root(),op:'rename',rel,to:n});if(!res.ok)return toast(res.error||'Renommage impossible');\r\n      tabsOf().forEach(t=>{if(t.rel===rel)t.rel=n;else if(t.rel.startsWith(rel+'/'))t.rel=n+t.rel.slice(rel.length)});if(actOf()===rel)S.act[pid()]=n;{const o=openSet(),mv=[...o].filter(x=>x===rel||x.startsWith(rel+'/'));mv.forEach(x=>{o.delete(x);o.add(n+x.slice(rel.length))})}S.shown='';await loadTree();sync();return}\r\n    if(a==='del'){if(!confirm(`Mettre « ${rel} » à la corbeille ?`))return;const res=await api.projOp({root:root(),op:'delete',rel});if(!res.ok)return toast(res.error||'Suppression impossible');\r\n      S.tabs[pid()]=tabsOf().filter(t=>t.rel!==rel&&!t.rel.startsWith(rel+'/'));if(!cur()&&actOf()!=='chat')S.act[pid()]='chat';await loadTree();sync();return}}\r\n  if(d){const o=openSet(),id=pid();if(o.has(rel))o.delete(rel);else{o.add(rel);if(hvOf(id).has(rel)&&!subOf(id)[rel]){await loadSub(id,rel);const T=S.tree[id];if(T)T.all=flat(id,T.items)}}drawEx()}else openFile(rel)};\r\n$('xnf').onclick=async()=>{if(!root())return;const n=await askName('Nouveau fichier ou dossier (termine par / pour un dossier)','');if(!n)return;\r\n  if(n.endsWith('/')){const d=n.replace(/\\/+$/,'');const res=await api.projOp({root:root(),op:'mkdir',rel:d});if(!res.ok)return toast(res.error||'Création impossible');openSet().add(d);return loadTree()}\r\n  const res=await api.projSave({root:root(),rel:n,text:'',force:true});if(!res.ok)return toast(res.error||'Création impossible');await loadTree();openFile(n)};\r\n$('xrf').onclick=()=>{loadTree();checkDisk();toast('Explorateur actualisé')};\r\n$('xq').oninput=e=>{S.q=e.target.value;S.hits=null;drawEx()};\r\n$('xq').onkeydown=async e=>{if(e.key==='Enter'&&S.q.trim().length>=2){$('xtree').innerHTML='<div class=\"xnote\">Recherche dans le texte…</div>';const r=await api.projGrep({root:root(),q:S.q.trim()});S.hits=(r&&r.hits)||[];drawEx()}if(e.key==='Escape'){S.q='';$('xq').value='';S.hits=null;drawEx()}};\r\n\r\n// ---------- onglets + éditeur ----------\r\nasync function openFile(rel,line){const r=root();if(!r)return;const L=tabsOf();let t=L.find(x=>x.rel===rel);\r\n  if(!t){const res=await api.projRead({root:r,rel});if(!res||!res.ok)return toast('Lecture impossible'+(res&&res.error?' : '+res.error:''));\r\n    t={rel,kind:res.kind,text:res.text||'',orig:res.text||'',mtime:res.mtime,size:res.size,url:res.url,dirty:false};L.push(t)}\r\n  if(S.chg[pid()])delete S.chg[pid()][rel];S.act[pid()]=rel;if(line)t.goto=line;S.shown='';sync()}\r\nfunction drawTabs(){const L=tabsOf(),a=actOf();$('tchat').textContent=S.nochat?'Afficher le chat':'Masquer le chat';\r\n  $('tl').innerHTML=L.map(t=>`<div class=\"tb${a===t.rel?' on':''}${t.dirty?' dirty':''}${t.gone?' gone':''}\" data-t=\"${esc(t.rel)}\" title=\"${esc(t.rel)}\"><span class=\"tn\">${esc(base(t.rel))}</span>${t.dirty?'<i class=\"dot\"></i>':''}<b data-x=\"${esc(t.rel)}\" title=\"Fermer (Ctrl+W)\">×</b></div>`).join('')}\r\n$('tchat').onclick=()=>{S.nochat=!S.nochat;sync()};\r\ntabs.onclick=e=>{if(e.target.closest('#tr'))return;const x=e.target.closest('[data-x]');if(x){e.stopPropagation();return closeTab(x.dataset.x)}const t=e.target.closest('[data-t]');if(t){S.act[pid()]=t.dataset.t;if(t.dataset.t==='chat')S.nochat=false;S.shown='';sync()}};\r\ntabs.onauxclick=e=>{const t=e.target.closest('[data-t]');if(t&&e.button===1&&t.dataset.t!=='chat')closeTab(t.dataset.t)};\r\nfunction closeTab(rel){const t=tabsOf().find(x=>x.rel===rel);if(!t)return;if(t.dirty&&!confirm(`« ${base(rel)} » a des modifications non enregistrées. Fermer sans enregistrer ?`))return;\r\n  S.tabs[pid()]=tabsOf().filter(x=>x!==t);if(actOf()===rel){const L=tabsOf();S.act[pid()]=L.length?L[L.length-1].rel:'chat'}S.shown='';sync()}\r\nconst nl=s=>{let n=1;for(let i=0;i<s.length;i++)if(s.charCodeAt(i)===10)n++;return n};\r\nfunction gut(){const t=cur(),g=$('egut');if(!t||!g)return;const n=nl(t.text);if(g.dataset.n!=n){g.dataset.n=n;let s='';for(let i=1;i<=n;i++)s+=i+'\\n';g.textContent=s}}\r\nfunction drawEditor(){const t=cur(),on=vis()&&!!t&&!!root();views.classList.toggle('split',on);views.classList.toggle('solo',on&&!!S.nochat);if(!on)return;\r\n  $('ed-p').textContent=t.rel;$('ed-sv').hidden=!(t.kind==='text'&&t.dirty);$('ed-at').hidden=t.kind!=='text';$('ed-pos').textContent=t.kind==='text'?(S.pos||''):'';$('ed-s').textContent=t.gone?'Supprimé du disque':'Modifié sur le disque';$('ed-s').hidden=!(t.stale||t.gone);$('ed-rl').hidden=!t.stale||!!t.gone;\r\n  const key=pid()+'|'+t.rel+'|'+(t.ver||0);if(S.shown===key){gut();return}S.shown=key;const b=$('ed-b');\r\n  if(t.kind==='text'){b.innerHTML='<pre id=\"egut\"></pre><textarea id=\"ed\" spellcheck=\"false\" wrap=\"off\"></textarea>';const ta=$('ed');ta.value=t.text;gut();\r\n    ta.oninput=()=>{t.text=ta.value;const d=t.text!==t.orig;if(d!==t.dirty){t.dirty=d;drawTabs();$('ed-sv').hidden=!d}gut();pos()};ta.onscroll=()=>{$('egut').scrollTop=ta.scrollTop};ta.onclick=ta.onkeyup=pos;\r\n    ta.onkeydown=e=>{if(e.key==='Tab'){e.preventDefault();document.execCommand('insertText',false,'  ')}\r\n      else if(e.key==='Enter'&&!e.ctrlKey){const v=ta.value,s=ta.selectionStart,ls=v.lastIndexOf('\\n',s-1)+1,ind=/^[ \\t]*/.exec(v.slice(ls,s))[0];e.preventDefault();document.execCommand('insertText',false,'\\n'+ind)}};\r\n    if(t.goto){const l=t.goto;t.goto=0;let i=0;for(let k=1;k<l;k++){i=t.text.indexOf('\\n',i)+1;if(i===0)break}ta.focus();ta.setSelectionRange(i,i);ta.scrollTop=Math.max(0,(l-6)*20)}}\r\n  else if(t.kind==='img')b.innerHTML=`<div id=\"ed-o\"><img src=\"${t.url}\" alt=\"\"></div>`;\r\n  else b.innerHTML=`<div id=\"ed-o\"><div>${t.kind==='big'?'Fichier trop gros pour être affiché':'Fichier binaire, non affichable'} (${Math.round((t.size||0)/1024)} Ko).<br><br><button class=\"btn\" id=\"ed-sh\">Afficher dans le dossier</button></div></div>`;\r\n  const sh=$('ed-sh');if(sh)sh.onclick=()=>api.projOp({root:root(),op:'show',rel:t.rel})}\r\nfunction pos(){const ta=$('ed');if(!ta)return;const v=ta.value.slice(0,ta.selectionStart),l=nl(v),c=v.length-v.lastIndexOf('\\n');S.pos=`Ln ${l}, Col ${c}`;const q=$('ed-pos');if(q)q.textContent=S.pos}\r\nasync function save(t){t=t||cur();if(!t||t.kind!=='text'||!t.dirty)return;let res=await api.projSave({root:root(),rel:t.rel,text:t.text,mtime:t.mtime});\r\n  if(res&&res.conflict){if(!confirm('Ce fichier a été modifié sur le disque (par l\\'IA ou un autre programme) depuis son ouverture. Écraser avec ta version ?'))return;res=await api.projSave({root:root(),rel:t.rel,text:t.text,force:true})}\r\n  if(!res||!res.ok)return toast('Enregistrement impossible'+(res&&res.error?' : '+res.error:''));t.orig=t.text;t.dirty=false;t.stale=false;t.mtime=res.mtime;$('ed-sv').hidden=true;toast('Enregistré : '+base(t.rel));drawTabs();drawEditor();\r\n  if(S.tree[pid()]&&!S.tree[pid()].items.some(x=>x.p===t.rel))loadTree()}\r\n$('ed-sv').onclick=()=>save();$('ed-at').onclick=()=>mentionSel();\r\n$('ed-rl').onclick=async()=>{const t=cur();if(!t)return;const r=await api.projRead({root:root(),rel:t.rel});if(r&&r.ok&&r.kind==='text'){t.text=t.orig=r.text;t.mtime=r.mtime;t.dirty=t.stale=false;t.ver=(t.ver||0)+1;S.shown='';sync()}};\r\nasync function checkDisk(){const r=root();if(!r)return;let ch=false;for(const t of tabsOf()){if(t.kind!=='text')continue;const res=await api.projRead({root:r,rel:t.rel});if(!res||!res.ok){if(!t.gone&&res&&res.error&&/ENOENT|no such file/i.test(res.error)){t.gone=true;ch=true}continue}if(t.gone){t.gone=false;ch=true}if(res.kind!=='text'||res.mtime===t.mtime)continue;\r\n    if(!t.dirty){const keep=actOf()===t.rel&&$('ed')?{s:$('ed').selectionStart,y:$('ed').scrollTop}:null;t.text=t.orig=res.text;t.mtime=res.mtime;t.ver=(t.ver||0)+1;ch=true;S.shown='';if(keep)setTimeout(()=>{const ta=$('ed');if(ta){ta.setSelectionRange(Math.min(keep.s,ta.value.length),Math.min(keep.s,ta.value.length));ta.scrollTop=keep.y}},0)}\r\n    else if(!t.stale){t.stale=true;ch=true}}\r\n  if(ch){drawTabs();drawEditor()}}\r\n\r\n// ---------- mentions dans le chat (comme @ / Ctrl+L de Cursor) ----------\r\nfunction mention(txt){const i=$('ch-in');if(!i)return;S.act[pid()]=actOf();const v=i.value;i.value=v+(v&&!/\\s$/.test(v)?' ':'')+txt+' ';i.dispatchEvent(new Event('input',{bubbles:true}));i.focus();i.setSelectionRange(i.value.length,i.value.length)}\r\nfunction mentionSel(){const t=cur();if(!t)return;const ta=$('ed');let m='@'+t.rel;if(ta&&ta.selectionStart!==ta.selectionEnd){const a=nl(ta.value.slice(0,ta.selectionStart)),b=nl(ta.value.slice(0,ta.selectionEnd));m+=a===b?` (ligne ${a})`:` (lignes ${a}-${b})`}mention(m)}\r\n\r\n// ---------- palette : Ctrl+P (fichiers) / Ctrl+Maj+P (commandes) ----------\r\nconst menuCmd=k=>{$('ch-mode').click();setTimeout(()=>{const b=document.querySelector('#ch-menu [data-md=\"'+k+'\"]');if(b)b.click()},40)};\r\nconst CMDS=()=>[\r\n  {n:'Ouvrir un dossier (nouveau projet)',f:newFolderProject},{n:'Aller au chat en plein écran',f:()=>{S.act[pid()]='chat';S.shown='';sync()}},\r\n  {n:'Replier / ouvrir la barre latérale (Ctrl+B)',f:()=>{const b=$('sbtog');b&&b.click()}},{n:'Masquer / afficher le chat',f:()=>{S.nochat=!S.nochat;sync()}},{n:'Rechercher dans le projet (Ctrl+Maj+F)',f:()=>searchProj()},\r\n  {n:'Enregistrer le fichier (Ctrl+S)',f:()=>save()},{n:'Fermer l\\'onglet (Ctrl+W)',f:()=>{const t=cur();if(t)closeTab(t.rel)}},\r\n  {n:'Actualiser l\\'explorateur',f:()=>$('xrf').click()},{n:'Historique du dossier (annuler des changements)',f:()=>menuCmd('hist')},{n:'Règles du projet',f:()=>menuCmd('rules')},\r\n  {n:'Annuler le dernier tour de l\\'IA',f:()=>menuCmd('undo')},{n:'Afficher le dossier dans Windows',f:()=>root()&&api.projOp({root:root(),op:'show',rel:''})},\r\n  {n:'Basculer clair / sombre',f:()=>$('themebtn').click()},{n:'Paramètres',f:()=>$('gear').click()},{n:'Bibliothèque de fichiers (pièces jointes)',f:()=>$('filesbtn').click()}];\r\nlet QL=[],QI=0;\r\n\r\nfunction qOpen(pre){if(!qo.hidden&&!pre){qo.hidden=true;return}qo.hidden=false;QI=0;$('qi').value=pre||'';qDraw();$('qi').focus()}\r\nconst QSL=[['/aide','Liste des commandes gratuites'],['/tree','Arborescence du projet'],['/read','Lire un fichier ou une plage'],['/outline','Plan d\\'un fichier'],['/grep','Chercher du texte'],['/find','Trouver des fichiers'],['/run','Lancer une commande'],['/git','État git'],['/test','Lancer les tests'],['/ctx','Recherche par sens dans le projet'],['/refs','Définition et usages d\\'un symbole'],['/history','Historique git']];\r\nconst qSlash=c=>{const i=$('ch-in');if(!i)return;if(S.nochat){S.nochat=false;sync()}i.value=c+' ';i.dispatchEvent(new Event('input',{bubbles:true}));i.focus();try{i.setSelectionRange(i.value.length,i.value.length)}catch{}};\r\nconst QACT=()=>[{n:'Ajouter une clé (compte IA)',f:()=>$('add').click()},{n:'Reprendre la conversation sur un autre compte',f:()=>$('handoff').click()},{n:'Copier la conversation',f:()=>$('export').click()},{n:'Recharger le compte affiché',f:()=>$('reload').click()},{n:'Afficher / masquer les fichiers du projet (Ctrl+Maj+E)',f:()=>{const b=$('u5dockbtn');if(b&&!b.hidden)b.click()}}];\r\nfunction qDraw(){const v=$('qi').value,mode=v[0]==='>'?'c':v[0]==='/'?'s':'',q=(mode?v.slice(1):v).trim(),L=[];\r\n  const rk=(arr,tx)=>q?arr.map(o=>({o,s:fuzzy(q,String(tx(o)||''))})).filter(x=>x.s>=0).sort((a,b)=>b.s-a.s).map(x=>x.o):arr;\r\n  const add=(g,arr)=>arr.forEach(x=>L.push(Object.assign({g},x)));\r\n  if(mode==='s'){if(P())add('Commandes du chat',rk(QSL,c=>c[0]+' '+c[1]).map(c=>({t:c[0],d:c[1],f:()=>qSlash(c[0])})))}\r\n  else if(mode==='c'){add('Commandes',rk(CMDS().concat(QACT()),c=>c.n).map(c=>({t:c.n,f:c.f})))}\r\n  else{\r\n    add('Projets',rk(PJ(),p=>p.name).slice(0,q?6:5).map(p=>({t:p.name,d:p.id===pid()?'projet ouvert':'',f:()=>H.openProject(p.id)})));\r\n    if(P()){const T=(S.tree[pid()]||{items:[]}).items.filter(x=>!x.d),chg=S.chg[pid()]||{};\r\n      const fl=q?T.map(x=>({x,s:Math.max(fuzzy(q,x.p),fuzzy(q,base(x.p))+2)})).filter(y=>y.s>=0).sort((a,b)=>b.s-a.s).map(y=>y.x):T.slice().sort((a,b)=>(chg[b.p]?1:0)-(chg[a.p]?1:0));\r\n      add('Fichiers',fl.slice(0,q?20:8).map(x=>({t:base(x.p),d:x.p,f:()=>openFile(x.p)})))}\r\n    add('Commandes',rk(CMDS().concat(QACT()),c=>c.n).slice(0,q?8:4).map(c=>({t:c.n,f:c.f})));\r\n    if(q&&P())add('Commandes du chat',rk(QSL,c=>c[0]+' '+c[1]).slice(0,3).map(c=>({t:c[0],d:c[1],f:()=>qSlash(c[0])})))}\r\n  QL=L.slice(0,60);QI=Math.min(QI,Math.max(0,QL.length-1));let last='';\r\n  $('ql').innerHTML=QL.map((x,i)=>{const h=x.g!==last?(last=x.g,`<div class=\"qg\">${esc(x.g)}</div>`):'';return h+`<div class=\"qr${i===QI?' on':''}\" data-i=\"${i}\"><span>${esc(x.t)}</span>${x.d?`<em>${esc(x.d)}</em>`:''}</div>`}).join('')||'<div class=\"xnote\">Aucun résultat</div>'}\r\n$('qi').oninput=()=>{QI=0;qDraw()};\r\n$('qi').onkeydown=e=>{if(e.key==='ArrowDown'){e.preventDefault();QI=Math.min(QL.length-1,QI+1);qDraw();const r=document.querySelector('#ql .on');r&&r.scrollIntoView({block:'nearest'})}\r\n  else if(e.key==='ArrowUp'){e.preventDefault();QI=Math.max(0,QI-1);qDraw();const r=document.querySelector('#ql .on');r&&r.scrollIntoView({block:'nearest'})}\r\n  else if(e.key==='Enter'){e.preventDefault();const x=QL[QI];qo.hidden=true;x&&x.f()}else if(e.key==='Escape')qo.hidden=true};\r\n$('ql').onclick=e=>{const r=e.target.closest('.qr');if(!r)return;const x=QL[+r.dataset.i];qo.hidden=true;x&&x.f()};\r\nqo.onmousedown=e=>{if(e.target===qo)qo.hidden=true};\r\nfunction searchProj(){if(!root())return;setTimeout(()=>{$('xq').focus();$('xq').select()},50)}\r\n\r\n// ---------- un projet = un dossier ----------\r\nasync function newFolderProject(){const r=await api.localPick();if(!r||!r.ok)return;const dup=PJ().find(q=>q.local&&q.local.path===r.path);\r\n  if(dup){H.openProject(dup.id);return toast('Ce dossier est déjà le projet « '+dup.name+' »')}\r\n  const p={id:'p'+Date.now().toString(36),name:r.name,desc:'',mode:'local',local:{path:r.path,name:r.name}};PJ().push(p);save();H.openProject(p.id)}\r\n['newproj','newproj2'].forEach(id=>{const b=$(id);if(!b)return;b.onclick=newFolderProject;const n=[...b.childNodes].reverse().find(x=>x.nodeType===3&&x.textContent.trim());if(n)n.textContent='Ouvrir un dossier';b.title='Un projet = un dossier de ton PC'});\r\n{const b=$('filesbtn'),n=b&&[...b.childNodes].find(x=>x.nodeType===3&&/Fichiers/.test(x.textContent));if(n)n.textContent='Bibliothèque';if(b)b.title='Pièces jointes envoyées / reçues (les fichiers d\\'un projet sont ceux de son dossier)'}\r\n{const g=document.querySelector('.pgrp');if(g)g.textContent='Projets (dossiers)'}\r\n\r\n// ---------- synchronisation ----------\r\nfunction sync(){const p=P(),v=vis();ex.hidden=!v;try{window.u5DockSync&&window.u5DockSync(v)}catch{}tabs.hidden=!(v&&root()&&(tabsOf().length||S.nochat));\r\n  if(pid()!==S.last){S.last=pid();S.q='';S.hits=null;$('xq').value='';S.shown='';if(root())loadTree()}\r\n  if(!tabs.hidden)drawTabs();drawEx();drawEditor()}\r\nfunction edCtx(){try{const t=cur();if(!t||t.kind!=='text'||!root())return null;const ta=$('ed');let a=0,b=0,sel='';\r\n  if(ta&&actOf()===t.rel){const s0=ta.selectionStart,e0=ta.selectionEnd;a=nl(ta.value.slice(0,s0));b=nl(ta.value.slice(0,e0));if(e0>s0)sel=ta.value.slice(s0,e0).slice(0,2000)}\r\n  return {rel:t.rel,line:a,end:b,sel,dirty:!!t.dirty}}catch{return null}}\r\nwindow.hub380={sync,openFile,save,edCtx,version:'3.8.1'};\r\nnew MutationObserver(()=>sync()).observe($('chat'),{attributes:true,attributeFilter:['class']});\r\nlet wasRun=false;new MutationObserver(()=>{const run=!$('ch-stop').hidden;if(wasRun&&!run&&vis()){loadTree(true);checkDisk()}wasRun=run}).observe($('ch-stop'),{attributes:true,attributeFilter:['hidden']});\r\nsetInterval(()=>{if(vis()&&root()&&document.hasFocus()){loadTree(true);checkDisk()}},5000);\r\n{const nz=p=>String(p||'').replace(/[\\\\/]+$/,'').replace(/\\//g,'\\\\').toLowerCase();let tm=null;\r\n if(api.onProj)api.onProj(d=>{if(!root()||!d||nz(d.root)!==nz(root()))return;clearTimeout(tm);tm=setTimeout(()=>{loadTree(true);checkDisk()},60)})}\r\nwindow.addEventListener('focus',()=>{if(vis()&&root()){loadTree(true);checkDisk()}});\r\ndocument.addEventListener('keydown',e=>{if(!(e.ctrlKey||e.metaKey)||e.altKey)return;const k=e.key.toLowerCase();\r\n  if(k==='p'){e.preventDefault();qOpen(e.shiftKey?'>':'')}\r\n  else if(!vis())return;\r\n  else if(k==='s'&&cur()){e.preventDefault();save()}\r\n  else if(k==='w'&&cur()){e.preventDefault();closeTab(cur().rel)}\r\n  else if(k==='l'&&root()){e.preventDefault();cur()?mentionSel():($('ch-in')&&$('ch-in').focus())}\r\n  else if(k==='f'&&e.shiftKey&&root()){e.preventDefault();searchProj()}},true);\r\ntry{if(!localStorage.hub381){localStorage.hub381='1';if(!$('keysbox').classList.contains('min'))$('keystog').click()}}catch{}\r\nsync();\r\n}catch(x){console.error('module 3.8.1',x)}})();\r\n</script>\r\n<style id=\"css390\">\r\n/* 3.9.0 — page Fichiers simplifiée : une seule liste, 4 actions par fichier */\r\n#files.f39 #fwrap{display:block}\r\n#files.f39 #fprojs,#files.f39 #ftools,#files.f39 #fpedit,#files.f39 #fauto,#files.f39 #ficols,#files.f39 #fhmore,#files.f39 #fhmenu{display:none!important}\r\n#files.f39 #fgrid{display:flex;flex-direction:column;gap:0}\r\n#files.f39 .fact{gap:8px}\r\n.fr9{display:grid;grid-template-columns:22px 40px minmax(0,1fr) auto;align-items:center;gap:12px;min-height:58px;padding:8px 10px;border-bottom:1px solid var(--line);border-radius:8px}\r\n.fr9:hover{background:var(--hover)}.fr9.sel{background:var(--soft)}\r\n.fr9 .fk9{display:flex;opacity:0;transition:opacity .12s}\r\n.fr9:hover .fk9,.fr9.sel .fk9,#fgrid.hassel .fk9{opacity:1}\r\n.fpv9{width:40px;height:44px;display:grid;place-items:center;border:0;background:none;padding:0;cursor:zoom-in;border-radius:8px;overflow:hidden}\r\n.fpv9 img{width:40px;height:40px;object-fit:cover;border-radius:8px;background:var(--hover);display:block}\r\n.fb9{min-width:0;display:flex;flex-direction:column;gap:2px}\r\n.fn9{font-size:13.5px;font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;cursor:pointer}\r\n.fm9{font-size:12px;color:var(--dim);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\r\n.fa9{display:flex;gap:2px;align-items:center;flex:none}\r\n.ftr9{padding:16px 10px;color:var(--dim);font-size:12.5px;display:flex;gap:10px;align-items:center;flex-wrap:wrap}\r\n@media (max-width:760px){.fr9{grid-template-columns:22px 40px minmax(0,1fr)}.fa9{grid-column:2/-1}}\r\n/* 3.9.0 — page Mises à jour */\r\n.upcard{border:1px solid var(--line);border-radius:12px;padding:18px 20px;margin:14px 0 18px;background:var(--panel)}\r\n.upv{display:flex;align-items:baseline;gap:10px}\r\n.upn{color:var(--dim);font-size:13px}\r\n.upv b{font:500 30px var(--serif);letter-spacing:-.01em}\r\n.upbadge{font-size:11.5px;padding:2px 9px;border-radius:99px;background:var(--soft);color:var(--dim)}\r\n.upbadge.warn{background:color-mix(in srgb,#d98a00 18%,transparent);color:#a86400}\r\n.upcard .line{margin:14px 0 4px}\r\n.updet{margin-top:18px}.updet summary{cursor:pointer;color:var(--dim);font-size:13px;padding:4px 0}\r\n.updet[open] summary{margin-bottom:4px}\r\n\r\n</style>\r\n<script>\r\n/* 3.9.0 — page Fichiers simplifiée. Les données (FILES, FDB, loadFiles...) ne changent pas : seule l'interface est refaite. */\r\n(function(){try{\r\nconst files=$('files');if(!files)throw new Error('page Fichiers introuvable');\r\nfiles.classList.add('f39');\r\n// anciens écouteurs (étiquettes, favoris, corbeille, volet de détail...) retirés : on repart d'une liste et d'une barre propres\r\nconst swap=id=>{const o=$(id);if(!o)return null;const n=o.cloneNode(false);o.replaceWith(n);return n};\r\nconst g=swap('fgrid'),bar=swap('fselbar');\r\nconst act=files.querySelector('.fact'),fa=$('fadd'),sc=$('fscanbtn');\r\nif(act&&fa&&sc)act.insertBefore(sc,fa);                 // « Scanner Claude » reste visible, le reste du menu ⋯ disparaît\r\nconst sleep9=ms=>new Promise(r=>setTimeout(r,ms));\r\n\r\nwindow.drawFiles=function(anim){\r\n  try{applyFcol()}catch{}\r\n  fUrls.forEach(u=>URL.revokeObjectURL(u));fUrls=[];fproj='all';ftype='';\r\n  for(const id of [...SEL])if(!FILES.some(f=>f.id===id))SEL.delete(id);\r\n  const q=(fq||'').trim().toLowerCase(),list=FILES.filter(f=>matchQ(f,q)),tot=FILES.reduce((s,f)=>s+f.size,0);VIS=list.map(f=>f.id);\r\n  $('fsub').textContent=FILES.length?`${FILES.length} fichier${FILES.length>1?'s':''} · ${fmtSize(tot)} · disponibles sur tous tes comptes`:'Ta bibliothèque est commune à tous tes comptes.';\r\n  $('fcount').textContent=FILES.length||'';\r\n  $('fempty').style.display=FILES.length?'none':'grid';\r\n  const gr=$('fgrid');gr.classList.toggle('hassel',SEL.size>0);\r\n  gr.innerHTML=list.map(f=>{\r\n    let pv;\r\n    if(iconKind(f)==='image'){const u=URL.createObjectURL(f.blob);fUrls.push(u);pv=`<img src=\"${u}\" alt=\"\">`}else pv=fileTile(f);\r\n    const d=new Date(f.added).toLocaleDateString('fr-FR',{day:'numeric',month:'short'});\r\n    const bits=[fileLabel(f),fmtSize(f.size),d];if(f.src)bits.push(f.src.kind==='created'?'Créé par Claude':'Joint');\r\n    return `<div class=\"fr9${SEL.has(f.id)?' sel':''}\" data-id=\"${f.id}\"><label class=\"fk9\" title=\"Sélectionner (Maj+clic : plage)\"><input type=\"checkbox\" data-s=\"${f.id}\"${SEL.has(f.id)?' checked':''}></label>`\r\n      +`<button class=\"fpv9\" data-a=\"prev\" title=\"Aperçu\" type=\"button\">${pv}</button>`\r\n      +`<div class=\"fb9\"><div class=\"fn9\" data-a=\"prev\" title=\"${esc(f.name)}\">${esc(f.name)}</div><div class=\"fm9\">${esc(bits.join(' · '))}</div></div>`\r\n      +`<div class=\"fa9\"><button class=\"btn sm\" data-a=\"att\" data-att=\"${f.id}\" type=\"button\" title=\"Joindre à une conversation\">${IC('clip')}Joindre</button>`\r\n      +`<button class=\"btn ghost sm ico\" data-a=\"dl\" type=\"button\" title=\"Télécharger\" aria-label=\"Télécharger\">${IC('dl')}</button>`\r\n      +`<button class=\"btn ghost sm ico\" data-a=\"rn\" type=\"button\" title=\"Renommer (F2)\" aria-label=\"Renommer\">${IC('edit')}</button>`\r\n      +`<button class=\"btn ghost sm ico del\" data-a=\"del\" type=\"button\" title=\"Supprimer\" aria-label=\"Supprimer\">${IC('trash')}</button></div></div>`}).join('')\r\n    +(!list.length&&FILES.length?`<p class=\"dim\" style=\"padding:22px 10px\">Aucun fichier ne correspond à « ${esc(q)} ».</p>`:'')\r\n    +(TRASH.length?`<div class=\"ftr9\"><span>${TRASH.length} fichier${TRASH.length>1?'s':''} dans l'ancienne corbeille (effacé${TRASH.length>1?'s':''} définitivement après 30 jours)</span><button class=\"btn ghost sm\" data-a=\"restoreall\" type=\"button\">Tout restaurer</button><button class=\"btn ghost sm del\" data-a=\"emptytrash\" type=\"button\">Vider</button></div>`:'');\r\n  drawSel();try{pushMenu()}catch{}};\r\n\r\nwindow.drawSel=function(){const b=$('fselbar');if(!b)return;\r\n  if(!SEL.size){b.hidden=true;b.innerHTML='';return}\r\n  const s=SEL.size>1?'s':'';b.hidden=false;\r\n  b.innerHTML=`<b>${SEL.size} fichier${s} sélectionné${s}</b><button class=\"btn ghost sm\" data-b=\"all\" type=\"button\">Tout sélectionner (${VIS.length})</button><span class=\"sp\"></span>`\r\n    +`<button class=\"btn sm pri\" data-b=\"att\" data-att=\"*\" type=\"button\">${IC('clip')}Joindre à…</button><button class=\"btn sm\" data-b=\"dl\" type=\"button\">${IC('dl')}Télécharger</button><button class=\"btn ghost sm del\" data-b=\"del\" type=\"button\">${IC('trash')}Supprimer</button><button class=\"btn ghost sm\" data-b=\"none\" type=\"button\">Annuler</button>`};\r\nwindow.drawProjs=function(){};window.drawTools=function(){};window.drawPEdit=function(){};\r\n\r\n// suppression directe, avec confirmation (l'ancienne corbeille n'est plus utilisée)\r\nwindow.trashIds=async function(ids){ids=ids.filter(id=>FILES.some(f=>f.id===id));if(!ids.length)return;\r\n  const one=FILES.find(f=>f.id===ids[0]);\r\n  if(!confirm(ids.length===1?`Supprimer « ${one.name} » de la bibliothèque ?\\n(Les conversations où il a déjà été joint ne changent pas.)`:`Supprimer ces ${ids.length} fichiers de la bibliothèque ?`))return;\r\n  for(const id of ids){try{if(String(id).startsWith('scan-'))(settings.scanSkip??=[]).push(id);await FDB.del(id)}catch{}SEL.delete(id)}\r\n  save();await loadFiles(false);toast(ids.length===1?'Fichier supprimé':`${ids.length} fichiers supprimés`)};\r\nwindow.startRename=function(id){const f=byId(id),el=document.querySelector(`.fr9[data-id=\"${id}\"] .fn9`);if(!f||!el)return;\r\n  inlineInput(el,'Nom du fichier',v=>v!==f.name&&FDB.put({...f,name:v.slice(0,200)}),f.name)};\r\n\r\ng.addEventListener('click',async e=>{const b=e.target.closest('[data-a]');if(!b)return;const a=b.dataset.a;\r\n  if(a==='restoreall')return restoreIds(TRASH.map(f=>f.id));\r\n  if(a==='emptytrash')return purgeIds(TRASH.map(f=>f.id),true);\r\n  const row=b.closest('.fr9'),id=row&&row.dataset.id;if(!id)return;\r\n  if(a==='att'){$('fmenu').dataset.ids='';openFMenu(b,id)}\r\n  else if(a==='dl')dlFile(byId(id));\r\n  else if(a==='rn')startRename(id);\r\n  else if(a==='del')trashIds([id]);\r\n  else if(a==='prev')openPrev(id)});\r\ng.addEventListener('click',e=>{if(e.target.closest('input[data-s]'))shiftNext=e.shiftKey},true);\r\ng.addEventListener('change',e=>{const c=e.target.closest('input[data-s]');if(!c)return;const id=c.dataset.s;\r\n  c.checked?SEL.add(id):SEL.delete(id);\r\n  if(shiftNext&&lastSel&&lastSel!==id){const a=VIS.indexOf(lastSel),b=VIS.indexOf(id);if(a>=0&&b>=0)VIS.slice(Math.min(a,b),Math.max(a,b)+1).forEach(x=>SEL.add(x))}\r\n  lastSel=id;shiftNext=false;drawFiles(false)});\r\nbar.addEventListener('click',async e=>{const b=e.target.closest('[data-b]');if(!b)return;const ids=[...SEL];\r\n  if(b.dataset.b==='all'){VIS.forEach(x=>SEL.add(x));drawFiles(false)}\r\n  else if(b.dataset.b==='att'){$('fmenu').dataset.ids='';openMulti(b,ids.filter(x=>FILES.some(f=>f.id===x)))}\r\n  else if(b.dataset.b==='dl'){for(const x of ids){dlFile(byId(x));await sleep9(250)}}\r\n  else if(b.dataset.b==='del')trashIds(ids);\r\n  else if(b.dataset.b==='none'){SEL.clear();drawFiles(false)}});\r\ndrawFiles(false);\r\n}catch(x){console.error('module 3.9.0 fichiers',x)}})();\r\n\r\n</script>\r\n<style id=\"css400\">\r\n/* ===== 4.0.0 — refonte totale : un seul système de design pour toutes les interfaces ===== */\r\n:root{--sans:\"Inter\",\"Segoe UI Variable Text\",\"Segoe UI\",system-ui,-apple-system,Roboto,Helvetica,Arial,sans-serif;--serif:var(--sans);\r\n--mono:\"Cascadia Code\",Consolas,\"SF Mono\",Menlo,monospace;\r\n--r1:6px;--r2:10px;--r3:14px;--r4:20px;--ease:cubic-bezier(.2,.8,.2,1);\r\n--bg:#ffffff;--side:#f7f7f8;--panel:#ffffff;--raised:#f2f2f4;--hover:rgba(20,20,30,.05);--sel:rgba(20,20,30,.085);--soft:rgba(20,20,30,.04);\r\n--line:#e7e7ea;--line2:#d2d2d8;--txt:#18181b;--dim:#62626b;--acc:#4f5bd5;--btn:#18181b;--btnh:#000;--btntx:#fff;\r\n--ok:#1f8a5b;--warn:#9a6a0c;--err:#c23d2e;--tbg:#18181b;--ttx:#fff;\r\n--shadow:0 0 0 1px rgba(0,0,0,.04),0 12px 36px rgba(20,20,40,.14)}\r\n:root[data-theme=dark]{--bg:#121214;--side:#0d0d0f;--panel:#18181b;--raised:#202024;--hover:rgba(255,255,255,.055);--sel:rgba(255,255,255,.095);--soft:rgba(255,255,255,.045);\r\n--line:#26262b;--line2:#37373e;--txt:#ececef;--dim:#9a9aa4;--acc:#8b97ff;--btn:#ececef;--btnh:#fff;--btntx:#121214;\r\n--ok:#5fc08f;--warn:#e0b060;--err:#ef8878;--tbg:#ececef;--ttx:#121214;\r\n--shadow:0 0 0 1px rgba(255,255,255,.05),0 14px 40px rgba(0,0,0,.6)}\r\n@media (prefers-color-scheme:dark){:root[data-theme=system]{--bg:#121214;--side:#0d0d0f;--panel:#18181b;--raised:#202024;--hover:rgba(255,255,255,.055);--sel:rgba(255,255,255,.095);--soft:rgba(255,255,255,.045);\r\n--line:#26262b;--line2:#37373e;--txt:#ececef;--dim:#9a9aa4;--acc:#8b97ff;--btn:#ececef;--btnh:#fff;--btntx:#121214;\r\n--ok:#5fc08f;--warn:#e0b060;--err:#ef8878;--tbg:#ececef;--ttx:#121214;\r\n--shadow:0 0 0 1px rgba(255,255,255,.05),0 14px 40px rgba(0,0,0,.6)}}\r\nhtml,body{background:var(--bg)}\r\nbody{font:13.5px/1.55 var(--sans);letter-spacing:-.003em;color:var(--txt)}\r\n::selection{background:color-mix(in srgb,var(--acc) 32%,transparent)}\r\n::-webkit-scrollbar{width:10px;height:10px}::-webkit-scrollbar-thumb{background:var(--line2);border-radius:10px;border:3px solid transparent;background-clip:content-box}\r\n:focus-visible{outline:2px solid color-mix(in srgb,var(--acc) 70%,transparent);outline-offset:1px;border-radius:var(--r1)}\r\ncode{font-family:var(--mono);font-size:12.2px;background:var(--raised);border:1px solid var(--line);padding:1px 6px;border-radius:var(--r1)}\r\npre{font-family:var(--mono);font-size:12.2px}\r\n\r\n/* --- boutons --- */\r\n.btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:32px;padding:5px 13px;border-radius:var(--r2);border:1px solid var(--line2);background:var(--panel);color:var(--txt);font:500 13px var(--sans);cursor:pointer;transition:background .14s,border-color .14s,color .14s,transform .12s var(--ease),box-shadow .14s}\r\n.btn:hover:not(:disabled){background:var(--raised);border-color:var(--line2)}\r\n.btn:active:not(:disabled){transform:scale(.97)}\r\n.btn:disabled{opacity:.45;cursor:default}\r\n.btn.pri{background:var(--btn);border-color:transparent;color:var(--btntx);box-shadow:0 1px 2px rgba(0,0,0,.18)}\r\n.btn.pri:hover:not(:disabled){background:var(--btnh);border-color:transparent}\r\n.btn.ghost{background:transparent;border-color:transparent;color:var(--dim)}\r\n.btn.ghost:hover:not(:disabled){background:var(--hover);color:var(--txt);border-color:transparent}\r\n.btn.sm{min-height:28px;padding:3px 10px;font-size:12.5px;border-radius:var(--r1)}\r\n.btn.ico,.btn.ic-only{padding:0;width:32px;min-width:32px}.btn.sm.ico{width:28px;min-width:28px}\r\n.btn.wide{width:100%}.btn.left{justify-content:flex-start}\r\n.btn.del:hover:not(:disabled){color:var(--err);background:color-mix(in srgb,var(--err) 12%,transparent)}\r\n.btn .ic{width:16px;height:16px;opacity:.9}\r\n\r\n/* --- champs --- */\r\nselect,input:not([type=checkbox]):not([type=range]):not([type=file]),textarea{font:13px var(--sans);color:var(--txt);background:var(--panel);border:1px solid var(--line2);border-radius:var(--r2);padding:7px 11px;min-height:34px;transition:border-color .14s,box-shadow .14s}\r\nselect{padding-right:28px}\r\ntextarea{line-height:1.5}\r\nselect:hover,input:not([type=checkbox]):hover,textarea:hover{border-color:color-mix(in srgb,var(--txt) 28%,var(--line2))}\r\nselect:focus,input:not([type=checkbox]):focus,textarea:focus{outline:none;border-color:var(--acc);box-shadow:0 0 0 3px color-mix(in srgb,var(--acc) 22%,transparent)}\r\n::placeholder{color:var(--dim);opacity:.75}\r\n.sw{appearance:none;-webkit-appearance:none;position:relative;flex:none;width:36px;height:20px;min-height:0;padding:0;border:0;border-radius:99px;background:var(--line2);cursor:pointer;transition:background .18s}\r\n.sw::after{content:\"\";position:absolute;top:2px;left:2px;width:16px;height:16px;border-radius:50%;background:#fff;box-shadow:0 1px 3px rgba(0,0,0,.35);transition:transform .2s var(--ease)}\r\n.sw:checked{background:var(--acc)}.sw:checked::after{transform:translateX(16px);background:#fff}\r\n.seg{display:inline-flex;padding:3px;gap:2px;background:var(--raised);border:1px solid var(--line);border-radius:var(--r2)}\r\n.seg button{border:0;background:transparent;color:var(--dim);font:500 12.5px var(--sans);padding:4px 12px;border-radius:7px;cursor:pointer;transition:background .14s,color .14s}\r\n.seg button:hover{color:var(--txt)}.seg button.on,.seg button[aria-pressed=true]{background:var(--panel);color:var(--txt);box-shadow:0 1px 2px rgba(0,0,0,.2)}\r\n.pill{display:inline-flex;align-items:center;padding:2px 9px;border-radius:99px;background:var(--raised);border:1px solid var(--line);color:var(--dim);font-size:11.5px;font-weight:500}\r\n.pill.ok{color:var(--ok);border-color:color-mix(in srgb,var(--ok) 40%,transparent)}.pill.no{color:var(--err);border-color:color-mix(in srgb,var(--err) 40%,transparent)}\r\n.card{background:var(--panel);border:1px solid var(--line);border-radius:var(--r3);overflow:hidden;margin:8px 0 18px}\r\n.card.pad{padding:16px 18px}\r\n.opt{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:14px 18px;border-top:1px solid var(--line)}\r\n.card>.opt:first-child{border-top:0}\r\n.opt>span:first-child{display:flex;flex-direction:column;gap:2px;min-width:0}\r\n.opt b{font-weight:600;font-size:13.5px}.opt small{color:var(--dim);font-size:12.5px;line-height:1.45}\r\ndetails>summary{cursor:pointer;color:var(--dim);font-size:13px;padding:6px 0;list-style:none}\r\ndetails>summary::before{content:\"›\";display:inline-block;width:14px;transition:transform .18s}\r\ndetails[open]>summary::before{transform:rotate(90deg)}details>summary:hover{color:var(--txt)}\r\n.dim{color:var(--dim)}.warn{color:var(--warn)}\r\n\r\n/* --- barre latérale --- */\r\naside{width:252px;background:var(--side);border-right:1px solid var(--line);padding:12px 10px;gap:6px}\r\n.brand{gap:8px;padding:2px 4px 8px}\r\n.brand>svg{color:var(--acc);width:20px;height:20px}\r\nh1{font:650 14.5px var(--sans);letter-spacing:-.01em}\r\n#sbtog{border-radius:var(--r1)}\r\n#newproj{min-height:36px;border-radius:var(--r2);font-weight:600}\r\n.grp{font:600 10.5px var(--sans);letter-spacing:.07em;text-transform:uppercase;color:var(--dim);padding:14px 10px 4px}\r\n.acc{min-height:32px;padding:5px 10px;border-radius:var(--r1);gap:9px;color:color-mix(in srgb,var(--txt) 88%,transparent);transition:background .12s}\r\n.acc:hover{background:var(--hover)}\r\n.acc.on{background:var(--sel);color:var(--txt);font-weight:550}\r\n#plist .acc.prj .pic{display:grid;place-items:center;text-decoration:none;color:var(--dim)}\r\n#plist .acc.prj.on .pic{color:var(--acc)}\r\n#explorer{margin:6px 0;border:1px solid var(--line);border-radius:var(--r2);background:var(--panel);overflow:hidden}\r\n#explorer .xh{padding:8px 10px;font-size:11.5px;color:var(--dim);display:flex;align-items:center;gap:4px;border-bottom:1px solid var(--line)}\r\n#explorer .xh b{flex:1;font-weight:600;letter-spacing:.02em}\r\n#explorer .xs input{border:0;border-bottom:1px solid var(--line);border-radius:0;background:transparent;width:100%;min-height:30px;font-size:12.5px}\r\n#explorer .xs input:focus{box-shadow:none}\r\n#explorer .xnote{padding:12px;color:var(--dim);font-size:12.5px;white-space:normal;line-height:1.5}\r\n#explorer .xnote .btn{margin-top:10px;width:100%}\r\n#keysbox{margin-top:auto;border-top:1px solid var(--line);padding-top:6px}\r\n.keyshead{display:flex;align-items:center;gap:8px;width:100%;padding:7px 10px;border:0;background:transparent;color:var(--dim);font:600 11px var(--sans);letter-spacing:.06em;text-transform:uppercase;border-radius:var(--r1);cursor:pointer}\r\n.keyshead:hover{background:var(--hover);color:var(--txt)}.keyshead small{text-transform:none;letter-spacing:0;font-weight:400;opacity:.8}\r\n.keyshead em{font-style:normal;margin-left:auto;min-width:20px;text-align:center;padding:1px 7px;border-radius:99px;background:var(--raised);border:1px solid var(--line);font-size:11px}\r\n#list .acc .dot{box-shadow:0 0 0 3px color-mix(in srgb,currentColor 0%,transparent)}\r\naside .foot{display:flex;align-items:center;gap:4px;border-top:1px solid var(--line);padding-top:8px;margin-top:4px}\r\naside #filesbtn,aside .foot #gear{border-radius:var(--r1);padding:7px 10px;min-height:34px;font-weight:500;color:var(--txt)}\r\naside #filesbtn.on{background:var(--sel)}\r\naside #filesbtn .pill{margin-left:auto}\r\naside.min{width:56px;padding:10px 6px}\r\n\r\n/* --- en-tête principal --- */\r\nmain>header{min-height:48px;padding:0 18px;gap:12px;border-bottom:1px solid var(--line);background:var(--bg)}\r\n#title{font:600 13.5px var(--sans);letter-spacing:-.01em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0}\r\n#hright{display:flex;align-items:center;gap:8px;margin-left:auto}\r\n#q-glob .gi{display:flex;align-items:center;gap:7px;padding:4px 12px;border:1px solid var(--line2);border-radius:99px;background:var(--panel);cursor:pointer;font-size:12.5px;transition:background .14s}\r\n#q-glob .gi:hover{background:var(--raised)}#q-glob .gi small{color:var(--dim)}\r\n#hacc{border-radius:var(--r2)}\r\n/* 4.6.0 : haut à droite, une seule règle finale (avant : 3 blocs se contredisaient → double contour, hauteurs différentes, texte coupé) */\r\n#hright{display:flex;align-items:center;gap:8px;flex:none;margin-left:auto}\r\n#q-glob{position:static!important;border:0!important;background:transparent!important;box-shadow:none!important;padding:0!important;height:auto!important;opacity:1!important;color:var(--txt)!important}\r\n#q-glob .gi{height:30px;box-sizing:border-box;padding:0 12px 0 8px;gap:7px;border:1px solid var(--line2);border-radius:99px;background:var(--panel);white-space:nowrap}\r\n#q-glob .gi b{font-size:12.5px}#q-glob .gi small{font-size:12px;color:var(--dim);opacity:1}\r\n#hacc{height:30px;box-sizing:border-box;padding:0 12px;border-radius:99px;white-space:nowrap;gap:7px;border:1px solid var(--line2);background:var(--panel)}\r\n#hacc:hover,#hacc.open{background:var(--raised)}\r\n#hacc .hl{max-width:200px}\r\nmain>header strong{min-width:0;flex:1 1 auto;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\r\n@media (max-width:900px){#hacc .hl,#q-glob .gi small{display:none}}\r\n/* 4.7.0 : lignes de clés alignées : boutons dans la ligne (plus en position absolue), même largeur partout */\r\n.acc{display:flex!important;align-items:center;gap:8px}\r\n.acc>.dot,.acc>i.dot{flex:none}\r\n.acc>span{flex:1 1 auto;min-width:0}\r\n.acc b,.acc:hover b{position:static!important;transform:none!important;right:auto!important;top:auto!important;display:inline-flex!important;align-items:center;justify-content:center;flex:none;width:22px;height:22px;padding:0!important;opacity:0;background:transparent;border-radius:6px}\r\n.acc:hover b,.acc:focus-within b{opacity:1}\r\n.acc:hover b:hover{background:var(--hover)}\r\n.acc .qr{flex:none;margin:0!important}\r\n/* 4.11.0 : cartes d'instructions : erreurs en rouge, détail au clic, instruction en cours animée */\r\n.la.err>i,.la.err>span,.la.err summary{color:var(--err)}\r\n.la.err{border-color:var(--err)}\r\n.lchp{margin-top:6px;display:grid;gap:4px;animation:lchin .2s ease-out}\r\n@keyframes lchin{from{opacity:0;transform:translateY(-4px)}to{opacity:1;transform:none}}\r\n.lchf{display:flex;align-items:center;gap:10px;padding:5px 8px;border:1px solid var(--line);border-radius:8px;background:var(--panel);font-size:12.5px;transition:opacity .2s,border-color .2s}\r\n.lchf b{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:500}\r\n.lchf small,.lchf em{color:var(--dim);font-style:normal}\r\n.lchf.rej{opacity:.55;border-color:var(--err)}\r\n@media (prefers-reduced-motion:reduce){.lchp{animation:none}}\r\n.la.run>i{animation:caretb 1s steps(2,start) infinite}\r\n.la summary{cursor:pointer;list-style:none}.la summary::-webkit-details-marker{display:none}\r\n.la pre{max-height:260px;overflow:auto;white-space:pre-wrap;word-break:break-word}\r\n#empty{background:var(--bg)}\r\n#empty h2{font:650 26px/1.25 var(--sans);letter-spacing:-.02em;max-width:520px;margin:0 auto 10px}\r\n#empty p{color:var(--dim);max-width:460px;margin:0 auto 22px;line-height:1.6}\r\n#empty .ebtns{display:flex;gap:10px;justify-content:center}\r\n\r\n/* --- chat --- */\r\n#ch-top{padding:12px 24px;border-bottom:1px solid var(--line)}\r\n#ch-name{font:650 15px var(--sans);letter-spacing:-.01em}\r\n#ch-desc{font-size:12.5px;color:var(--dim)}\r\n.ch-act{display:flex;align-items:center;gap:4px}\r\n#ch-msgs{padding:28px 0 12px}\r\n.m{margin-bottom:22px}\r\n.m .b{font-size:14px;line-height:1.7}\r\n.m.u{align-items:flex-end}\r\n.m.u .b{background:var(--raised);border:1px solid var(--line);padding:10px 15px;border-radius:var(--r3) var(--r3) 4px var(--r3);max-width:86%}\r\n.m.a .mk{display:flex;align-items:center;gap:8px;font:600 12px var(--sans);color:var(--dim);margin-bottom:6px}\r\n.m .b p{margin:0 0 .7em}.m .b p:last-child{margin-bottom:0}\r\n.m .b ol,.m .b ul{padding-left:22px;margin:.4em 0 .8em}\r\n.m .b pre{background:var(--side);border:1px solid var(--line);border-radius:var(--r2);padding:12px 14px;overflow:auto;margin:.6em 0;line-height:1.55}\r\n.m .b pre code{background:none;border:0;padding:0}\r\n.m.s{align-items:center}\r\n.m.s>span{font-size:12px;color:var(--dim);background:var(--raised);border:1px solid var(--line);border-radius:99px;padding:3px 12px}\r\n.m.s.warn>span{color:var(--warn);border-color:color-mix(in srgb,var(--warn) 40%,transparent);background:color-mix(in srgb,var(--warn) 9%,transparent)}\r\n.ch-empty{text-align:center;padding:12vh 0 0}\r\n.ch-empty h3{font:650 22px var(--sans);letter-spacing:-.02em;margin-bottom:8px}.ch-empty p{color:var(--dim);max-width:460px;margin:0 auto;line-height:1.6}\r\n#ch-bar{padding:8px 0 22px}\r\n#ch-box{background:var(--panel);border:1px solid var(--line2);border-radius:var(--r4);padding:10px 12px;box-shadow:0 2px 14px rgba(0,0,0,.14);transition:border-color .15s,box-shadow .15s}\r\n#ch-box:focus-within{border-color:color-mix(in srgb,var(--acc) 65%,var(--line2));box-shadow:0 0 0 3px color-mix(in srgb,var(--acc) 16%,transparent),0 2px 14px rgba(0,0,0,.14)}\r\n#ch-box #ch-in,#ch-box #ch-in:focus,#ch-box #ch-in:hover{background:transparent;border:0;box-shadow:none;padding:6px 6px;font-size:14px;line-height:1.55;min-height:44px;max-height:220px}\r\n#ch-send{border-radius:99px;padding:5px 18px;font-weight:600}\r\n#ch-stop{border-radius:99px}\r\n#ch-hint{font-size:11.5px;color:var(--dim);text-align:center;margin-top:8px}\r\n#ch-chips{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:8px}\r\n#ch-chips:empty{display:none}\r\n#ch-chips .fc{display:inline-flex;align-items:center;gap:6px;padding:3px 6px 3px 11px;border-radius:99px;background:var(--raised);border:1px solid var(--line);font-size:12px}\r\n#ch-chips .fc b{display:grid;place-items:center;width:18px;height:18px;border-radius:50%;cursor:pointer;color:var(--dim)}\r\n#ch-chips .fc b:hover{background:var(--sel);color:var(--txt)}\r\n#ch-chips .fc b:empty::before{content:\"×\";font-weight:400;font-size:14px;line-height:1}\r\n\r\n/* --- page Fichiers --- */\r\n#files.fnew{padding:28px clamp(20px,4vw,48px) 56px}\r\n#files.fnew .fhead{display:flex;align-items:flex-end;justify-content:space-between;gap:18px;flex-wrap:wrap;margin-bottom:20px}\r\n#files.fnew .fhead h2{font:650 24px var(--sans);letter-spacing:-.02em}\r\n#files.fnew .fhead p{color:var(--dim);font-size:13px;margin-top:2px}\r\n#files.fnew .fact{display:flex;align-items:center;gap:8px;flex-wrap:wrap}\r\n#files.fnew .fsearch{position:relative;display:flex;align-items:center}\r\n#files.fnew .fsearch>span{position:absolute;left:11px;color:var(--dim);display:grid;pointer-events:none}\r\n#files.fnew .fsearch input{width:230px;padding-left:34px}\r\n#files.fnew .fsearch input:focus{width:280px}\r\n#files.f39 #fgrid,#files.fnew #fgrid{display:flex;flex-direction:column;gap:2px}\r\n#files.f39 #fgrid.v4-grid,#files.fnew #fgrid.v4-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:14px}\r\n.fr9{display:grid;grid-template-columns:24px 44px minmax(0,1fr) auto;align-items:center;gap:14px;min-height:62px;padding:9px 14px;border:1px solid transparent;border-radius:var(--r2);transition:background .12s,border-color .12s}\r\n.fr9:hover{background:var(--hover)}.fr9.sel{background:color-mix(in srgb,var(--acc) 12%,transparent);border-color:color-mix(in srgb,var(--acc) 40%,transparent)}\r\n.fr9 .fa9 .btn{opacity:.0;transition:opacity .12s}.fr9:hover .fa9 .btn,.fr9:focus-within .fa9 .btn,.fr9.sel .fa9 .btn{opacity:1}\r\n.fpv9{width:44px;height:44px;display:grid;place-items:center;border:0;background:none;padding:0;cursor:zoom-in;border-radius:var(--r2);overflow:hidden}\r\n.fpv9 img{width:44px;height:44px;object-fit:cover;border-radius:var(--r2);border:1px solid var(--line)}\r\n.fn9{font-size:13.5px;font-weight:550}.fm9{font-size:12px}\r\n#fgrid.v4-grid .fr9{grid-template-columns:1fr auto;grid-template-rows:auto auto auto;gap:10px 8px;padding:14px;min-height:0;background:var(--panel);border:1px solid var(--line);border-radius:var(--r3);align-items:start;position:relative}\r\n#fgrid.v4-grid .fr9:hover{border-color:var(--line2);background:var(--panel)}\r\n#fgrid.v4-grid .fr9.sel{border-color:var(--acc)}\r\n#fgrid.v4-grid .fk9{grid-column:2;grid-row:1;justify-self:end}\r\n#fgrid.v4-grid .fpv9{grid-column:1;grid-row:1;width:52px;height:52px}\r\n#fgrid.v4-grid .fpv9 img{width:52px;height:52px}\r\n#fgrid.v4-grid .fb9{grid-column:1/-1;grid-row:2}\r\n#fgrid.v4-grid .fa9{grid-column:1/-1;grid-row:3;justify-content:flex-start}\r\n#fgrid.v4-grid .fa9 .btn{opacity:1}\r\n#fgrid.v4-grid .fn9{white-space:normal;overflow-wrap:anywhere;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}\r\n.fk9 input{width:16px;height:16px;accent-color:var(--acc);cursor:pointer}\r\n#files.fnew #fselbar{position:sticky;bottom:18px;z-index:6;display:flex;align-items:center;gap:8px;margin:18px auto 0;max-width:760px;background:var(--raised);border:1px solid var(--line2);border-radius:var(--r3);box-shadow:var(--shadow);padding:9px 14px}\r\n#files.fnew #fselbar[hidden]{display:none}#fselbar .sp{flex:1}\r\n#fempty{place-items:center;text-align:center;padding:12vh 0}\r\n#fempty .big{width:60px;height:60px;border-radius:var(--r3);background:var(--raised);border:1px solid var(--line);display:grid;place-items:center;margin:0 auto 16px;color:var(--dim)}\r\n#fempty h3{font:650 18px var(--sans)}#fempty p{color:var(--dim);max-width:380px;margin:6px auto 18px}\r\n#fscan{background:var(--panel);border:1px solid var(--line);border-radius:var(--r3);padding:12px 16px}\r\n#fdrop{border-radius:var(--r4)}\r\n#fmenu,#ch-menu,.menu{background:var(--panel);border:1px solid var(--line2);border-radius:var(--r2);box-shadow:var(--shadow);padding:5px}\r\n#fmenu button,#ch-menu button{display:flex;align-items:center;gap:9px;width:100%;text-align:left;padding:7px 10px;border:0;background:transparent;color:var(--txt);border-radius:var(--r1);font:13px var(--sans);cursor:pointer}\r\n#fmenu button:hover,#ch-menu button:hover{background:var(--hover)}\r\n#fmenu .mt,#ch-menu .mt{font:600 10.5px var(--sans);letter-spacing:.07em;text-transform:uppercase;color:var(--dim);padding:7px 10px 4px}\r\n#fprev{background:rgba(0,0,0,.62);backdrop-filter:blur(6px)}\r\n#fprev .pvbox{background:var(--panel);border:1px solid var(--line2);border-radius:var(--r3);box-shadow:var(--shadow);overflow:hidden}\r\n#fprev .pvhead{display:flex;align-items:center;gap:6px;padding:10px 14px;border-bottom:1px solid var(--line)}\r\n\r\n/* --- paramètres --- */\r\n#set{background:var(--bg)}\r\n#set .snav{padding:28px 14px;border-right:1px solid var(--line);background:var(--side);display:flex;flex-direction:column;gap:2px}\r\n#set .snav h2{font:650 18px var(--sans);letter-spacing:-.01em;padding:0 12px 14px}\r\n#set .snav button{text-align:left;padding:8px 12px;border:0;border-radius:var(--r1);background:transparent;color:var(--dim);font:500 13.5px var(--sans);cursor:pointer;transition:background .12s,color .12s}\r\n#set .snav button:hover{background:var(--hover);color:var(--txt)}\r\n#set .snav button.on{background:var(--sel);color:var(--txt)}\r\n#set .sgrp{font:600 10.5px var(--sans);letter-spacing:.07em;text-transform:uppercase;color:var(--dim);padding:18px 12px 6px}\r\n#set .spanes{padding:0 clamp(20px,5vw,64px) 64px}\r\n#set .pane{max-width:780px;padding-top:32px}\r\n#set .pane h2{font:650 24px var(--sans);letter-spacing:-.02em;margin-bottom:6px}\r\n#set .pane h3{font:600 12px var(--sans);letter-spacing:.06em;text-transform:uppercase;color:var(--dim);margin:28px 0 8px}\r\n#set .pane p{color:var(--dim);line-height:1.6;margin:6px 0}\r\n#set .pane p.warn{color:var(--warn);background:color-mix(in srgb,var(--warn) 9%,transparent);border:1px solid color-mix(in srgb,var(--warn) 30%,transparent);border-radius:var(--r2);padding:10px 14px}\r\n#set .line{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:12px 0}\r\n#set textarea{width:100%;font-family:var(--mono);font-size:12.5px;min-height:200px;resize:vertical}\r\n#set pre{background:var(--panel);border:1px solid var(--line);border-radius:var(--r2);padding:14px 16px;overflow:auto;line-height:1.6;color:var(--dim)}\r\n.upcard{border-radius:var(--r3);padding:22px 24px;background:var(--panel)}\r\n.upv b{font:650 34px var(--sans);letter-spacing:-.03em}\r\n.upbadge{background:color-mix(in srgb,var(--ok) 14%,transparent);color:var(--ok)}\r\n.upbadge.warn{background:color-mix(in srgb,var(--warn) 16%,transparent);color:var(--warn)}\r\n\r\n/* --- dialogues, notifications, palette --- */\r\ndialog{background:var(--panel);color:var(--txt);border:1px solid var(--line2);border-radius:var(--r3);box-shadow:var(--shadow);padding:22px 24px;width:min(440px,calc(100vw - 32px))}\r\ndialog.wide{width:min(720px,calc(100vw - 32px))}\r\ndialog::backdrop{background:rgba(0,0,0,.5);backdrop-filter:blur(4px)}\r\ndialog h3{font:650 17px var(--sans);letter-spacing:-.01em;margin-bottom:12px}\r\ndialog label{display:block;font:600 12px var(--sans);color:var(--dim);margin:14px 0 6px}\r\ndialog label.inl{display:flex;align-items:center;gap:10px;font-weight:500;color:var(--txt)}\r\ndialog input:not([type=checkbox]),dialog select,dialog textarea{width:100%}\r\ndialog p{color:var(--dim);line-height:1.6;margin:6px 0}\r\ndialog .row{display:flex;justify-content:flex-end;gap:8px;margin-top:20px}\r\n.ltabs{display:flex;gap:4px;border-bottom:1px solid var(--line);margin-bottom:14px}\r\n.ltabs button{border:0;background:transparent;color:var(--dim);padding:8px 12px;font:500 13px var(--sans);cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-1px}\r\n.ltabs button.on{color:var(--txt);border-bottom-color:var(--acc)}\r\n#toast{top:auto;bottom:28px;left:50%;right:auto;transform:translate(-50%,16px);max-width:min(560px,calc(100vw - 32px));background:var(--tbg);color:var(--ttx);border:0;border-radius:var(--r2);padding:10px 16px;font-size:13px;box-shadow:var(--shadow);opacity:0;pointer-events:none;z-index:99;transition:opacity .2s,transform .26s var(--ease)}\r\n#toast.show{opacity:1;transform:translate(-50%,0)}\r\n#qo .qb{background:var(--panel);border:1px solid var(--line2);border-radius:var(--r3);box-shadow:var(--shadow);overflow:hidden}\r\n#qo #qi{width:100%;border:0;border-bottom:1px solid var(--line);border-radius:0;background:transparent;padding:14px 18px;font-size:15px;box-shadow:none}\r\n#qo .qh{padding:8px 16px;font-size:11.5px;color:var(--dim);border-top:1px solid var(--line)}\r\n#splash{background:var(--bg)}\r\n\r\n/* --- petites largeurs --- */\r\n@media (max-width:900px){aside{width:212px}#files.fnew .fsearch input,#files.fnew .fsearch input:focus{width:180px}#set .snav{padding:20px 8px}}\r\n@media (max-width:640px){\r\n  .fr9{grid-template-columns:24px 40px minmax(0,1fr);gap:10px}.fr9 .fa9{grid-column:2/-1}.fr9 .fa9 .btn{opacity:1}\r\n  .opt{flex-direction:column;align-items:flex-start;gap:10px}\r\n  main>header{padding:0 10px}#hacc .hl{display:none}\r\n}\r\n</style>\r\n<script>\r\n/* 4.0.0 — refonte totale. Aucune donnée n'est modifiée : seule l'interface change. fview ('grid'|'list') est déjà lu par toutes les versions. */\r\n(function(){try{\r\nconst g=$('fgrid'),act=document.querySelector('#files .fact');if(!g||!act)throw new Error('page Fichiers introuvable');\r\nconst view=()=>settings.fview==='grid'?'grid':'list';\r\nconst seg=document.createElement('span');seg.className='seg';seg.id='fv4';seg.setAttribute('role','group');seg.setAttribute('aria-label','Affichage');\r\nseg.innerHTML='<button type=\"button\" data-v=\"list\" title=\"Liste\">Liste</button><button type=\"button\" data-v=\"grid\" title=\"Grille\">Grille</button>';\r\nconst add=$('fadd');add?act.insertBefore(seg,add):act.appendChild(seg);\r\nfunction sync(){g.classList.remove('grid','list','noanim');g.classList.toggle('v4-grid',view()==='grid');\r\n  seg.querySelectorAll('button').forEach(b=>{const on=b.dataset.v===view();b.classList.toggle('on',on);b.setAttribute('aria-pressed',on)})}\r\nseg.onclick=e=>{const b=e.target.closest('[data-v]');if(!b||settings.fview===b.dataset.v)return;settings.fview=b.dataset.v;save();sync()};\r\nconst prev=window.drawFiles;\r\nwindow.drawFiles=function(){const r=prev.apply(this,arguments);sync();return r};\r\nsync();\r\n}catch(x){console.error('module 4.0.0 interface',x)}})();\r\n</script>\r\n<style>\r\n/* ===== 4.1.0 ===== */\r\n/* Barre latérale : plus de panneau « Fichiers du projet » ni de bouton « Nouveau projet » ; la liste des clés ne déborde plus */\r\n#explorer,#newproj,#fcount{display:none!important}\r\naside{min-height:0;max-height:100%;overflow:hidden}\r\naside>*{flex-shrink:0}\r\naside #plist{flex:1 1 0;min-height:84px;max-height:none;overflow-y:auto;overflow-x:hidden}\r\naside #keysbox{flex:0 1 auto;min-height:0;max-height:min(52%,calc(100vh - 300px));display:flex;flex-direction:column}\r\naside #keysbox .keyshead{flex:none}\r\naside #keysbody{flex:1 1 auto;min-height:0;display:flex;flex-direction:column;overflow:hidden}\r\naside #keysbody #add{flex:none}\r\naside #keysbox #list{flex:1 1 auto;min-height:0;overflow-y:auto;overflow-x:hidden;overscroll-behavior:contain}\r\naside #filesbtn,aside .foot{flex:none}\r\n\r\n/* Bibliothèque : projets → fichiers du dossier */\r\n#files.libnew:not(.liblegacy)>:not(#lib):not(#fin){display:none!important}\r\n#files.libnew.liblegacy>#lib{display:none}\r\n#libback{display:flex;align-items:center;gap:12px;margin-bottom:14px}#libback[hidden]{display:none}\r\n#lib{max-width:1040px;margin:0 auto}\r\n#lib .lh{display:flex;align-items:flex-end;gap:16px;margin-bottom:16px}\r\n#lib .lh h2{font:600 20px var(--sans);letter-spacing:-.01em}#lib .lh p{font-size:12.5px;margin-top:1px}\r\n#lib .lh .sp{flex:1}\r\n#lib .lq{position:relative}\r\n#lib .lq input,#lib .lq2 input{width:230px;font:inherit;font-size:13px;color:var(--txt);background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:6px 10px}\r\n#lib .lq input:focus,#lib .lq2 input:focus{outline:none;border-color:var(--line2)}\r\n#lib .lgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:10px}\r\n#lib .lp{display:flex;align-items:center;gap:12px;text-align:left;width:100%;padding:12px 14px;background:var(--panel);border:1px solid var(--line);border-radius:12px;color:var(--txt);font:inherit;cursor:pointer;transition:background .15s,border-color .15s}\r\n#lib .lp:hover{background:var(--hover);border-color:var(--line2)}\r\n#lib .lpi{display:grid;place-items:center;width:38px;height:38px;border-radius:10px;background:var(--soft);color:var(--acc);flex:none}\r\n#lib .lpi .ic{width:19px;height:19px}\r\n#lib .lpb{min-width:0;flex:1;display:flex;flex-direction:column;gap:1px}\r\n#lib .lpb b{font-weight:600;font-size:14px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\r\n#lib .lpb small{color:var(--dim);font-size:11.5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;direction:rtl;text-align:left}\r\n#lib .lpn{color:var(--dim);font-size:12px;font-variant-numeric:tabular-nums;white-space:nowrap}\r\n#lib .lleg{margin-top:22px;background:none;border:0;color:var(--dim);font:inherit;font-size:12.5px;cursor:pointer;padding:6px 2px}\r\n#lib .lleg:hover{color:var(--txt)}\r\n#lib .lnote{color:var(--dim);font-size:13px;padding:28px 6px;line-height:1.55}\r\n#lib .lnote .btn{margin-top:10px}\r\n#lib .lbc{display:flex;align-items:center;flex-wrap:wrap;gap:2px;margin-bottom:12px;font-size:13.5px;min-width:0}\r\n#lib .lbc button{background:none;border:0;color:var(--dim);font:inherit;padding:3px 7px;border-radius:6px;cursor:pointer;max-width:240px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\r\n#lib .lbc button:hover{background:var(--hover);color:var(--txt)}\r\n#lib .lbc button.cur{color:var(--txt);font-weight:600;cursor:default}\r\n#lib .lbc i{font-style:normal;color:var(--dim);opacity:.6}\r\n#lib .ltools{display:flex;align-items:center;gap:8px;margin-bottom:8px;padding-bottom:10px;border-bottom:1px solid var(--line)}\r\n#lib .ltools .sp{flex:1}#lib .ltools .cnt{color:var(--dim);font-size:12.5px}\r\n#lib .lrow{display:grid;grid-template-columns:40px minmax(0,1fr) 92px 120px 34px;align-items:center;gap:12px;min-height:46px;padding:5px 10px;border-bottom:1px solid var(--line);cursor:pointer;border-radius:0}\r\n#lib .lrow:hover{background:var(--hover)}\r\n#lib .lrow .lb{display:grid;place-items:center;width:34px;height:30px;border-radius:7px;font:600 9.5px var(--sans);letter-spacing:.02em;color:#fff;background:var(--c,#7a7f87)}\r\n#lib .lrow.d .lb{background:var(--soft);color:var(--acc)}#lib .lrow .lb .ic{width:17px;height:17px}\r\n#lib .lrow .ln{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:13.5px;font-weight:500}\r\n#lib .lrow .lm{color:var(--dim);font-size:12px;white-space:nowrap;font-variant-numeric:tabular-nums}\r\n#lib .lrow .lm.r{text-align:right}\r\n#lib .lrow .lx{opacity:0;transition:opacity .12s;background:none;border:0;color:var(--dim);cursor:pointer;display:grid;place-items:center;width:28px;height:28px;border-radius:6px}\r\n#lib .lrow:hover .lx{opacity:1}#lib .lrow .lx:hover{background:var(--sel);color:var(--txt)}\r\n@media(max-width:760px){#lib .lrow{grid-template-columns:40px minmax(0,1fr) 34px}#lib .lrow .lm{display:none}}\r\n#libpv{width:min(860px,92vw);height:min(78vh,720px);padding:0;border:1px solid var(--line);border-radius:14px;background:var(--panel);color:var(--txt);overflow:hidden;box-shadow:var(--shadow)}\r\n#libpv[open]{display:flex;flex-direction:column}\r\n#libpv::backdrop{background:rgba(0,0,0,.55)}\r\n#libpv .ph{display:flex;align-items:center;gap:8px;padding:10px 14px;border-bottom:1px solid var(--line)}\r\n#libpv .ph b{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:13.5px}\r\n#libpv .pb{flex:1;min-height:0;overflow:auto;display:grid;place-items:center}\r\n#libpv .pb img{max-width:100%;max-height:100%;object-fit:contain}\r\n#libpv .pb pre{margin:0;align-self:stretch;justify-self:stretch;padding:14px;white-space:pre-wrap;word-break:break-word;font:12.5px/1.5 ui-monospace,Consolas,monospace;overflow:auto;text-align:left}\r\n#libpv .pb .dim{padding:24px;text-align:center}\r\n\r\n/* Page Mises à jour (4.1.0) */\r\n.upnew{display:flex;align-items:center;gap:10px;margin:12px 0 2px;padding:10px 12px;border-radius:10px;background:color-mix(in srgb,var(--acc) 12%,transparent);border:1px solid color-mix(in srgb,var(--acc) 35%,transparent);font-size:13.5px}\r\n.upnew[hidden]{display:none}.upnew b{font-weight:600}\r\n.upbusy{height:3px;border-radius:3px;background:var(--line);overflow:hidden;margin:10px 0 2px}.upbusy[hidden]{display:none}\r\n.upbusy i{display:block;height:100%;width:32%;border-radius:3px;background:var(--acc);animation:upslide 1.1s ease-in-out infinite}\r\n@keyframes upslide{0%{margin-left:-32%}100%{margin-left:100%}}\r\n.upauto{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--dim);margin:0 0 6px;cursor:pointer}\r\n.updot{position:relative}\r\nhtml.upd-avail #gear::after,html.upd-avail #p-upd-tab::after,html.upd-avail [data-t=\"upd\"]::after{content:\"\";display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--acc);margin-left:8px;vertical-align:middle}\r\n</style>\r\n<script>\r\n/* 4.1.0 — Bibliothèque = tes projets ; dans un projet, les fichiers de son dossier (explorateur). Les pièces jointes des anciens échanges restent accessibles en bas. */\r\n(function(){try{\r\nconst files=$('files');if(!files)throw new Error('page Bibliothèque introuvable');\r\nfiles.classList.add('libnew');\r\nconst lib=document.createElement('div');lib.id='lib';\r\nconst back=document.createElement('div');back.id='libback';back.hidden=true;\r\nback.innerHTML='<button class=\"btn ghost sm\" id=\"libbk\" type=\"button\">← Retour aux projets</button><span class=\"dim\">Pièces jointes des échanges avec les IA</span>';\r\nfiles.prepend(lib);files.prepend(back);\r\nconst pv=document.createElement('dialog');pv.id='libpv';document.body.appendChild(pv);\r\nconst L={pid:null,rel:'',items:null,err:'',q:'',gen:0,cnt:{},wasOn:false};\r\nconst H=window.hub260||{};\r\nconst projs=()=>{try{return PJ()}catch{return []}};\r\nconst proj=id=>projs().find(p=>p.id===id)||null;\r\nconst rootOf=p=>(p&&p.local&&p.local.path)||'';\r\nconst ext=n=>{const m=/\\.([A-Za-z0-9]+)$/.exec(n);return m?m[1].toLowerCase():''};\r\nconst bn=r=>String(r).split('/').pop();\r\nconst colr=e=>{let h=0;for(const c of e)h=(h*31+c.charCodeAt(0))%360;return e?`hsl(${h} 45% 46%)`:'#7a7f87'};\r\nconst dt=m=>m?new Date(m).toLocaleDateString('fr-FR',{day:'numeric',month:'short',year:'numeric'}):'';\r\nconst sz=n=>{try{return fmtSize(n)}catch{return n+' o'}};\r\n\r\nfunction drawRoot(){\r\n  const q=L.q.trim().toLowerCase(),all=projs(),ps=all.filter(p=>!q||String(p.name||'').toLowerCase().includes(q)||rootOf(p).toLowerCase().includes(q));\r\n  const nleg=(typeof FILES!=='undefined'&&FILES&&FILES.length)||0;\r\n  lib.innerHTML=`<div class=\"lh\"><div><h2>Bibliothèque</h2><p class=\"dim\">${all.length?all.length+' projet'+(all.length>1?'s':''):'Aucun projet'}</p></div><div class=\"sp\"></div><div class=\"lq\"><input id=\"lq\" placeholder=\"Rechercher un projet…\" autocomplete=\"off\" spellcheck=\"false\" value=\"${esc(L.q)}\"></div></div>`\r\n   +(ps.length?`<div class=\"lgrid\">${ps.map(p=>{const r=rootOf(p),c=L.cnt[p.id];\r\n      return `<button class=\"lp\" type=\"button\" data-lp=\"${esc(p.id)}\"><span class=\"lpi\">${IC('folder')}</span><span class=\"lpb\"><b>${esc(p.name)}</b><small>${r?esc(r):'Aucun dossier choisi'}</small></span><span class=\"lpn\" data-cnt=\"${esc(p.id)}\">${c==null?'':c}</span></button>`}).join('')}</div>`\r\n     :`<div class=\"lnote\">${all.length?'Aucun projet ne correspond.':'Aucun projet pour l\\'instant. Un projet apparaît ici dès que tu en as un dans la liste de gauche ; ses fichiers sont ceux de son dossier.'}</div>`)\r\n   +(nleg?`<button class=\"lleg\" id=\"lleg\" type=\"button\">Pièces jointes des conversations (${nleg}) →</button>`:'');\r\n  countAll()}\r\n\r\nasync function countAll(){const g=++L.gen;\r\n  for(const p of projs()){if(g!==L.gen||L.pid)return;const r=rootOf(p);if(!r||L.cnt[p.id]!=null)continue;\r\n    try{const res=await api.projTree({root:r});if(g!==L.gen)return;\r\n      const n=res&&res.ok?res.items.filter(x=>!x.d).length:'—';L.cnt[p.id]=res&&res.ok?(n+(res.cut?'+':'')+' fichier'+(n>1?'s':'')):'dossier introuvable';\r\n      const el=lib.querySelector(`[data-cnt=\"${CSS.escape(p.id)}\"]`);if(el)el.textContent=L.cnt[p.id]}catch{}}}\r\n\r\nfunction crumbs(p){const parts=L.rel?L.rel.split('/'):[];\r\n  let h=`<button type=\"button\" data-bc=\"__root\">Projets</button><i>›</i><button type=\"button\" data-bc=\"\" class=\"${parts.length?'':'cur'}\">${esc(p.name)}</button>`;\r\n  parts.forEach((s,i)=>{const rel=parts.slice(0,i+1).join('/');h+=`<i>›</i><button type=\"button\" data-bc=\"${esc(rel)}\" class=\"${i===parts.length-1?'cur':''}\">${esc(s)}</button>`});return h}\r\n\r\nfunction drawProj(){const p=proj(L.pid);if(!p){L.pid=null;return drawRoot()}\r\n  const r=rootOf(p);\r\n  const head=`<div class=\"lbc\">${crumbs(p)}</div>`;\r\n  if(!r){lib.innerHTML=head+`<div class=\"lnote\">Ce projet n'a pas encore de dossier : ses fichiers sont ceux de son dossier.<br><button class=\"btn pri\" id=\"lpick\" type=\"button\">Choisir le dossier</button></div>`;return}\r\n  const q=L.q.trim().toLowerCase();let it=L.items;\r\n  const tools=`<div class=\"ltools\"><button class=\"btn ghost sm\" id=\"lup\" type=\"button\" ${L.rel?'':'disabled'} title=\"Dossier parent\">↑</button><span class=\"cnt\">${it?it.length+' élément'+(it.length>1?'s':''):''}</span><div class=\"sp\"></div><span class=\"lq2\"><input id=\"lq2\" placeholder=\"Filtrer ce dossier…\" autocomplete=\"off\" spellcheck=\"false\" value=\"${esc(L.q)}\"></span><button class=\"btn ghost sm\" id=\"lref\" type=\"button\" title=\"Actualiser\">${IC('refresh')}</button><button class=\"btn ghost sm\" id=\"lshow\" type=\"button\" title=\"Afficher le dossier dans l'explorateur Windows\">${IC('folder')}</button><button class=\"btn sm\" id=\"lopen\" type=\"button\">Ouvrir le projet</button></div>`;\r\n  let body;\r\n  if(L.err)body=`<div class=\"lnote\">${esc(L.err)}<br><button class=\"btn\" id=\"lpick\" type=\"button\">Choisir un autre dossier</button></div>`;\r\n  else if(!it)body='<div class=\"lnote\">Chargement…</div>';\r\n  else{if(q)it=it.filter(x=>bn(x.p).toLowerCase().includes(q));\r\n    body=it.length?it.map(x=>{const e=ext(x.p);\r\n      return `<div class=\"lrow${x.d?' d':''}\" data-p=\"${esc(x.p)}\" data-d=\"${x.d?1:0}\"><span class=\"lb\" style=\"--c:${colr(e)}\">${x.d?IC('folder'):esc((e||'·').slice(0,4).toUpperCase())}</span><span class=\"ln\" title=\"${esc(x.p)}\">${esc(bn(x.p))}</span><span class=\"lm\">${x.d?'Dossier':sz(x.s||0)}</span><span class=\"lm r\">${x.d?'':dt(x.m)}</span><button class=\"lx\" type=\"button\" data-sh=\"${esc(x.p)}\" title=\"Afficher dans l'explorateur Windows\">${IC('folder')}</button></div>`}).join('')\r\n      :`<div class=\"lnote\">${q?'Aucun fichier ne correspond.':'Ce dossier est vide.'}</div>`}\r\n  lib.innerHTML=head+tools+body}\r\n\r\nasync function load(){const p=proj(L.pid);if(!p)return;const r=rootOf(p);if(!r)return drawProj();\r\n  const g=++L.gen;L.err='';L.items=null;drawProj();\r\n  try{api.projWatch&&api.projWatch({root:r})}catch{}\r\n  const res=await api.projList({root:r,rel:L.rel});if(g!==L.gen)return;\r\n  if(res&&res.ok){L.items=res.items}else{L.items=[];L.err='Dossier introuvable. Il a peut-être été déplacé ou supprimé.'}\r\n  drawProj()}\r\nconst draw=()=>L.pid?drawProj():drawRoot();\r\nfunction openProj(id){L.pid=id;L.rel='';L.q='';L.items=null;load()}\r\nfunction toRoot(){L.pid=null;L.rel='';L.q='';L.items=null;L.cnt={};drawRoot()}\r\n\r\nasync function preview(rel){const p=proj(L.pid),r=rootOf(p);if(!p||!r)return;\r\n  pv.innerHTML=`<div class=\"ph\"><b>${esc(rel)}</b><button class=\"btn ghost sm\" data-pvs type=\"button\">Afficher dans le dossier</button><button class=\"btn ghost sm\" data-pvc type=\"button\">Copier le chemin</button><button class=\"btn ghost ico\" data-pvx type=\"button\" title=\"Fermer\">${IC('x')}</button></div><div class=\"pb\"><div class=\"dim\">Chargement…</div></div>`;\r\n  pv.dataset.rel=rel;if(!pv.open)pv.showModal();\r\n  const res=await api.projRead({root:r,rel});const b=pv.querySelector('.pb');if(!b||pv.dataset.rel!==rel)return;\r\n  if(!res||!res.ok)b.innerHTML=`<div class=\"dim\">${esc((res&&res.error)||'Lecture impossible')}</div>`;\r\n  else if(res.kind==='img')b.innerHTML=`<img src=\"${res.url}\" alt=\"\">`;\r\n  else if(res.kind==='text'){const pre=document.createElement('pre');pre.textContent=res.text;b.innerHTML='';b.appendChild(pre)}\r\n  else b.innerHTML=`<div class=\"dim\">${res.kind==='big'?'Fichier trop gros pour l\\'aperçu':'Fichier binaire : pas d\\'aperçu'} (${sz(res.size||0)}).<br>Utilise « Afficher dans le dossier » pour l'ouvrir avec une autre application.</div>`}\r\npv.addEventListener('click',e=>{\r\n  if(e.target===pv||e.target.closest('[data-pvx]')){pv.close();return}\r\n  const rel=pv.dataset.rel,p=proj(L.pid),r=rootOf(p);\r\n  if(e.target.closest('[data-pvs]')&&r){api.projOp({root:r,rel,op:'show'});return}\r\n  if(e.target.closest('[data-pvc]')&&r){const full=r.replace(/[\\\\/]+$/,'')+'\\\\'+rel.replace(/\\//g,'\\\\');try{api.copy(full);toast('Chemin copié')}catch{}}});\r\n\r\nlib.addEventListener('click',e=>{\r\n  const lp=e.target.closest('[data-lp]');if(lp){openProj(lp.dataset.lp);return}\r\n  if(e.target.closest('#lleg')){files.classList.add('liblegacy');back.hidden=false;try{drawFiles(false)}catch{}return}\r\n  const bc=e.target.closest('[data-bc]');if(bc){if(bc.dataset.bc==='__root')toRoot();else if(bc.dataset.bc!==L.rel){L.rel=bc.dataset.bc;L.q='';load()}return}\r\n  if(e.target.closest('#lup')){L.rel=L.rel.includes('/')?L.rel.slice(0,L.rel.lastIndexOf('/')):'';L.q='';load();return}\r\n  if(e.target.closest('#lref')){load();return}\r\n  const p=proj(L.pid),r=rootOf(p);\r\n  if(e.target.closest('#lshow')&&r){api.projOp({root:r,rel:L.rel,op:'show'});return}\r\n  if(e.target.closest('#lopen')&&p){try{H.openProject(p.id)}catch{}return}\r\n  if(e.target.closest('#lpick')&&p){(async()=>{try{if(await H.pickLocal(p)){L.cnt={};load()}}catch{}})();return}\r\n  const sh=e.target.closest('[data-sh]');if(sh){e.stopPropagation();if(r)api.projOp({root:r,rel:sh.dataset.sh,op:'show'});return}\r\n  const row=e.target.closest('.lrow');if(row){if(row.dataset.d==='1'){L.rel=row.dataset.p;L.q='';load()}else preview(row.dataset.p)}});\r\nlib.addEventListener('input',e=>{\r\n  if(e.target.id==='lq'){L.q=e.target.value;const pos=e.target.selectionStart;drawRoot();const i=$('lq');if(i){i.focus();try{i.setSelectionRange(pos,pos)}catch{}}}\r\n  if(e.target.id==='lq2'){L.q=e.target.value;const pos=e.target.selectionStart;drawProj();const i=$('lq2');if(i){i.focus();try{i.setSelectionRange(pos,pos)}catch{}}}});\r\n$('libbk').onclick=()=>{files.classList.remove('liblegacy');back.hidden=true;toRoot()};\r\n// ouverture de la page : toujours la liste des projets\r\ntry{$('filesbtn').addEventListener('click',()=>{if(!files.classList.contains('on')){files.classList.remove('liblegacy');back.hidden=true;L.pid=null;L.rel='';L.q='';L.items=null;L.cnt={}}},true)}catch{}\r\nnew MutationObserver(()=>{const on=files.classList.contains('on');if(on&&!L.wasOn&&!files.classList.contains('liblegacy'))draw();L.wasOn=on}).observe(files,{attributes:true,attributeFilter:['class']});\r\ntry{if(window.api&&api.onProj)api.onProj(d=>{if(files.classList.contains('on')&&L.pid&&!files.classList.contains('liblegacy')){const p=proj(L.pid);if(p&&d&&d.root&&rootOf(p)&&d.root.replace(/[\\\\/]+$/,'')===rootOf(p).replace(/[\\\\/]+$/,'')&&!pv.open)load()}})}catch{}\r\nwindow.addEventListener('focus',()=>{if(files.classList.contains('on')&&L.pid&&!pv.open)load()});\r\n}catch(x){console.error('module 4.1.0 bibliothèque',x)}})();\r\n\r\n/* 4.1.0 — mises à jour : même source que l'installeur (dernier paquet à la racine de github.com/XeroxYTB3/ai_hub) */\r\n(function(){try{\r\nconst msg=(t,cls)=>{const m=$('upmsg');if(!m)return;m.className=cls||'';m.textContent=t||''};\r\nconst busy=on=>{const b=$('upbusy');if(b)b.hidden=!on;['upcheck','upget','upsetup','upapply','uprev','uporig'].forEach(i=>{const e=$(i);if(e)e.disabled=!!on});if(!on){try{drawUpd()}catch{}}};\r\nlet last=null;\r\nconst flag=r=>{document.documentElement.classList.toggle('upd-avail',!!(r&&r.ok&&r.newer))};\r\nfunction paint(){const n=$('upnew'),g=$('upget'),c=$('upcheck');if(!n||!g||!c)return;\r\n  const r=last;g.hidden=true;n.hidden=true;c.textContent='Rechercher une mise à jour';\r\n  if(r&&r.ok&&r.newer){n.hidden=false;n.innerHTML=`Version <b>${esc(r.latest)}</b> disponible <span class=\"dim\">(tu as la ${esc(r.current)})</span>`;g.hidden=false;g.textContent='Installer la '+r.latest}\r\n  else if(r&&r.ok){msg('✔ AI Hub est à jour (version '+r.latest+').')}}\r\nasync function check(auto){\r\n  if(!window.api||!api.updCheck)return null;\r\n  if(!auto){busy(true);msg('Recherche sur github.com/XeroxYTB3/ai_hub…')}\r\n  let r;try{r=await api.updCheck()}catch(e){r={ok:false,error:e.message}}\r\n  last=window.__upd=r;flag(r);\r\n  if(!auto){busy(false);if(!r.ok)msg('✘ Impossible de vérifier : '+r.error+'. Vérifie ta connexion, ou installe un fichier .aihubupdate dans les options avancées.','warn');else{paint()}}\r\n  else paint();\r\n  return r}\r\nasync function install(){\r\n  busy(true);msg('Téléchargement et vérification de la dernière version…');\r\n  let r;try{r=await api.updFetch()}catch(e){r={ok:false,error:e.message}}\r\n  busy(false);\r\n  if(r&&r.ok&&r.uptodate){msg('✔ Déjà à jour (version '+r.version+').');return}\r\n  if(!r||!r.ok){msg('✘ '+((r&&r.error)||'échec'),'warn');\r\n    if(r&&r.launcherTooOld&&confirm('Ce lanceur est trop ancien pour installer une mise à jour. Télécharger et lancer l\\'installeur AI Hub ? (tes comptes, scripts et réglages sont conservés ; AI Hub va se fermer)'))setup();return}\r\n  last=null;flag(null);msg('✔ Version '+r.version+' installée.');paint();\r\n  if(confirm(`Version ${r.version} installée. Redémarrer maintenant pour l'essayer ?\\n(Si elle ne démarre pas correctement, l'app revient toute seule à la version précédente.)`))api.relaunch()}\r\nasync function setup(){busy(true);msg('Téléchargement de l\\'installeur…');let r;try{r=await api.updSetup()}catch(e){r={ok:false,error:e.message}}\r\n  busy(false);msg(r&&r.ok?'Installeur lancé : AI Hub se ferme…':'✘ '+((r&&r.error)||'échec'),r&&r.ok?'':'warn')}\r\nconst wire=(id,f)=>{const e=$(id);if(e)e.onclick=f};\r\nwire('upcheck',()=>check(false));wire('upget',install);\r\nwire('upsetup',()=>{if(confirm('Télécharger la dernière version de l\\'installeur depuis le dépôt et le lancer ? AI Hub va se fermer ; tes comptes, scripts et réglages sont conservés.'))setup()});\r\nconst au=$('upauto');if(au){try{au.checked=localStorage.hubUpdAuto!=='0'}catch{au.checked=true}au.onchange=()=>{try{localStorage.hubUpdAuto=au.checked?'1':'0'}catch{}}}\r\nconst d0=window.drawUpd;if(typeof d0==='function')window.drawUpd=async function(){await d0.apply(this,arguments);paint()};\r\n// vérification discrète au démarrage (désactivable) : un point apparaît sur Paramètres si une version est disponible\r\nsetTimeout(()=>{let on=true;try{on=localStorage.hubUpdAuto!=='0'}catch{}if(on)check(true).then(r=>{if(r&&r.ok&&r.newer&&typeof toast==='function')toast('Mise à jour '+r.latest+' disponible : Paramètres › Mises à jour')}).catch(()=>{})},9000);\r\n}catch(x){console.error('module 4.1.0 mises à jour',x)}})();\r\n\r\n/* 10.0.0 — lanceur : état, reconstruction depuis le ZIP (ai-hub-launcher-10.0.0.zip, GitHub ou copie intégrée), remplacement des fichiers de l'exe à la fermeture */\r\n(function(){try{\r\nconst lmsg=(t,cls)=>{const m=$('lnmsg');if(!m)return;m.className=cls||'';m.textContent=t||''};\r\nconst lbusy=on=>{['lnrebuild','lnpick','lnrestart'].forEach(i=>{const e=$(i);if(e)e.disabled=!!on})};\r\nlet lastInfo=null;\r\nasync function drawLn(){\r\n  if(!$('lncard')||!window.api||!api.launcherInfo)return;\r\n  let i;try{i=await api.launcherInfo()}catch(e){return}\r\n  lastInfo=i;\r\n  const pay=i.payload,ok=pay&&pay.ok,pend=i.swap&&(i.swap.state==='waiting'||i.swap.state==='running'),sr=i.swapResult;\r\n  $('lnver').textContent=i.version||'';\r\n  const bd=$('lnbadge');let warn=false,badge='À jour',sub='';\r\n  if(i.rebuilding){warn=true;badge='En cours…';sub='Reconstruction du lanceur depuis le ZIP…'}\r\n  else if(i.mode==='ancien'){warn=true;badge='À reconstruire';sub=(i.lastError?'La reconstruction a échoué : '+i.lastError+'. ':'')+'Dépose le fichier ai-hub-launcher-'+i.expected+'.zip dans Téléchargements (ou à côté de la mise à jour), puis clique « Reconstruire le lanceur ».'}\r\n  else if(i.mode==='physique'){sub='Lanceur '+i.version+' installé avec AI Hub. Il se met à jour tout seul avec les mises à jour (aucun exe à reconstruire).'}\r\n  else{\r\n    sub='Lanceur '+i.version+' reconstruit'+(pay&&pay.source?' depuis '+pay.source:'')+(pay&&pay.installedAt?' le '+new Date(pay.installedAt).toLocaleDateString('fr-FR',{day:'numeric',month:'long',year:'numeric'}):'')+'. ';\r\n    if(pend)sub+='Le fichier de lancement d\\'AI Hub sera remplacé à la fermeture de l\\'app (copie de secours faite avant).';\r\n    else if(i.swapPlan&&i.swapPlan.state==='impossible')sub+='Il tourne depuis les données d\\'AI Hub : '+i.swapPlan.detail;\r\n    else if(i.swapPlan&&i.swapPlan.state==='ok')sub+='Le lanceur de l\\'installation est à jour.';\r\n  }\r\n  if(sr&&sr.ok===false&&!pend){warn=true;badge=i.mode==='ancien'?badge:'À jour';sub+=' ⚠ Le dernier remplacement du lanceur de l\\'installation a échoué'+(sr.restored?' (ancien lanceur remis en place)':'')+' : '+(sr.error||'');}\r\n  bd.className='upbadge'+(warn?' warn':'');bd.textContent=badge;\r\n  $('lnsub').textContent=sub;\r\n  $('lnrestart').hidden=!pend;\r\n  $('lninfo').innerHTML='Version attendue : <b>'+esc(i.expected)+'</b>'+(i.exeVersion?' · lanceur de l\\'exe : <b>'+esc(i.exeVersion)+'</b>':'')+(i.physical&&i.physical.target?' · installation : <b>'+esc(i.physical.target)+'</b>'+(i.physical.version?' (lanceur '+esc(i.physical.version)+')':''):'')+(i.logFile?'<br>Journal : '+esc(i.logFile):'');\r\n  $('lnlog').textContent=(i.log||[]).join('\\n')||'—';\r\n  lbusy(!!i.rebuilding);\r\n}\r\nconst run=async(fn,txt)=>{lbusy(true);lmsg(txt);let r;try{r=await fn()}catch(e){r={ok:false,error:e.message}}\r\n  if(r&&r.cancelled){lmsg('');await drawLn();return}\r\n  lmsg(r&&r.ok?'✔ Lanceur '+r.version+' reconstruit ('+r.source+').':'✘ '+((r&&r.error)||'échec'),r&&r.ok?'':'warn');\r\n  await drawLn()};\r\nconst w=(id,f)=>{const e=$(id);if(e)e.onclick=f};\r\nw('lnrebuild',()=>run(()=>api.launcherRebuild(),'Recherche du ZIP du lanceur et reconstruction…'));\r\nw('lnpick',()=>run(()=>api.launcherPick(),'Reconstruction depuis le ZIP choisi…'));\r\nw('lnrestart',()=>{if(confirm('AI Hub va se fermer, remplacer son fichier de lancement (copie de secours faite avant), puis se rouvrir tout seul. Continuer ?'))api.launcherRestart()});\r\nif(api.onLauncher)api.onLauncher(ev=>{\r\n  if(ev.type==='done'&&ev.data&&typeof toast==='function')toast('Lanceur '+ev.data.version+' reconstruit');\r\n  \r\n  drawLn()});\r\nconst d1=window.drawUpd;if(typeof d1==='function')window.drawUpd=async function(){await d1.apply(this,arguments);drawLn()};\r\nsetTimeout(drawLn,1500);\r\n}catch(x){console.error('module 10.0.0 lanceur',x)}})();\r\n\r\n</script>\r\n<style id=\"ui5\">\r\n/* ===== 5.0 : jetons de design (U2). Ce bloc est le DERNIER <style> : il redéfinit palettes, espacements, rayons, ombres et durées. ===== */\r\n:root{color-scheme:light;\r\n--c-bg:#fbfbfa;--c-surface:#ffffff;--c-raised:#f3f3f1;--c-line:#e6e6e2;--c-text:#1c1c1a;--c-dim:#6b6b66;\r\n--c-acc:#4f5bd5;--c-ok:#187a4f;--c-err:#c23d2e;--c-warn:#8c600a;\r\n--s-1:4px;--s-2:8px;--s-3:12px;--s-4:16px;--s-5:20px;--s-6:24px;--s-7:32px;--s-8:40px;\r\n--r-s:6px;--r-m:10px;--r-l:14px;\r\n--sh-1:0 1px 2px rgba(20,20,20,.06),0 2px 8px rgba(20,20,20,.06);\r\n--sh-2:0 0 0 1px rgba(0,0,0,.04),0 12px 36px rgba(20,20,20,.14);\r\n--t-fast:120ms;--t-med:200ms;--ease:cubic-bezier(.2,.8,.2,1);\r\n--sans:\"Inter\",\"Segoe UI Variable Text\",\"Segoe UI\",system-ui,-apple-system,Roboto,Helvetica,Arial,sans-serif;--serif:var(--sans);\r\n--mono:\"Cascadia Code\",\"Cascadia Mono\",Consolas,\"SF Mono\",Menlo,monospace;\r\n/* anciens noms (utilisés par tout le code existant) : alignés sur les nouveaux jetons */\r\n--bg:var(--c-bg);--side:var(--c-raised);--panel:var(--c-surface);--raised:var(--c-raised);\r\n--line:var(--c-line);--line2:color-mix(in srgb,var(--c-text) 18%,var(--c-bg));\r\n--txt:var(--c-text);--dim:var(--c-dim);--acc:var(--c-acc);--ok:var(--c-ok);--err:var(--c-err);--warn:var(--c-warn);\r\n--hover:color-mix(in srgb,var(--c-text) 6%,transparent);--sel:color-mix(in srgb,var(--c-text) 10%,transparent);--soft:color-mix(in srgb,var(--c-acc) 10%,transparent);\r\n--btn:var(--c-text);--btnh:#000;--btntx:var(--c-bg);--tbg:var(--c-text);--ttx:var(--c-bg);\r\n--r1:var(--r-s);--r2:var(--r-m);--r3:var(--r-l);--r4:20px;--shadow:var(--sh-2)}\r\n:root[data-theme=dark]{color-scheme:dark;\r\n--c-bg:#141415;--c-surface:#1b1b1d;--c-raised:#111112;--c-line:#2a2a2d;--c-text:#ececea;--c-dim:#9b9b96;\r\n--c-acc:#8b97ff;--c-ok:#5fc08f;--c-err:#ef8878;--c-warn:#e0b060;\r\n--sh-1:0 1px 2px rgba(0,0,0,.35),0 2px 8px rgba(0,0,0,.3);\r\n--sh-2:0 0 0 1px rgba(255,255,255,.05),0 14px 40px rgba(0,0,0,.6);--btnh:#fff}\r\n@media (prefers-color-scheme:dark){:root[data-theme=system]{color-scheme:dark;\r\n--c-bg:#141415;--c-surface:#1b1b1d;--c-raised:#111112;--c-line:#2a2a2d;--c-text:#ececea;--c-dim:#9b9b96;\r\n--c-acc:#8b97ff;--c-ok:#5fc08f;--c-err:#ef8878;--c-warn:#e0b060;\r\n--sh-1:0 1px 2px rgba(0,0,0,.35),0 2px 8px rgba(0,0,0,.3);\r\n--sh-2:0 0 0 1px rgba(255,255,255,.05),0 14px 40px rgba(0,0,0,.6);--btnh:#fff}}\r\nhtml,body{background:var(--c-bg);color:var(--c-text);font-family:var(--sans)}\r\n:focus-visible{outline:2px solid color-mix(in srgb,var(--c-acc) 70%,transparent);outline-offset:1px}\r\n@media (prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;transition-duration:.01ms!important}}\r\n/* ===== U3 : coquille 3 zones (rail | centre | dock) : l'application tient toujours dans la fenêtre, jamais de défilement global ===== */\r\n:root{--rail-w:248px;--dock-w:0px;--top-h:40px}\r\nhtml,body{height:100%;margin:0;overflow:hidden}\r\nbody{display:grid;grid-template-columns:var(--rail-w) minmax(0,1fr) var(--dock-w);grid-template-rows:minmax(0,1fr);height:100vh;max-height:100vh;transition:grid-template-columns var(--t-med) var(--ease)}\r\nbody.u5-dock{--dock-w:320px}\r\nbody.u5-dock:not(:has(#u5dock #xtree>*)){--dock-w:0px}\r\nbody.u5-dock:not(:has(#u5dock #xtree>*))>#u5dock{display:none}\r\nbody>aside{grid-column:1;width:auto;min-width:0;min-height:0;max-height:100%;overflow:hidden;background:var(--c-raised);border-right:1px solid var(--c-line)}\r\nbody>aside.min{--rail-w:52px}\r\nbody>main{grid-column:2;display:flex;flex-direction:column;min-width:0;min-height:0;max-height:100%;overflow:hidden}\r\n/* U5 : barre supérieure = fil d'Ariane + un seul sélecteur d'IA + pastille de disponibilité */\r\n.u5-crumb{color:var(--c-dim);font-weight:400}\r\n.u5-sep{font-style:normal;color:var(--c-dim);opacity:.5;margin:0 7px}\r\nmain>header strong#title{display:flex;align-items:center;min-width:0;font-size:13.5px;font-weight:600;letter-spacing:-.01em}\r\nmain>header strong#title b{font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0}\r\n#hacc .hc{display:none}\r\nmain>header .hbtns{gap:2px}\r\nmain>header .hbtns .btn{height:28px;padding:0 9px;font-size:12.5px;background:transparent;border-color:transparent;color:var(--c-dim);box-shadow:none}\r\nmain>header .hbtns .btn:hover{background:var(--c-raised);color:var(--c-text)}\r\n#hright{gap:var(--s-2)}\r\nbody>main>header{flex:none;min-height:var(--top-h);height:var(--top-h);padding:0 var(--s-3);gap:var(--s-2);background:var(--c-bg);border-bottom:1px solid var(--c-line)}\r\nbody>main>#views{flex:1;min-height:0;position:relative}\r\nbody>#u5dock{grid-column:3;min-width:0;min-height:0;overflow:auto;background:var(--c-surface);border-left:1px solid var(--c-line);display:none}\r\nbody.u5-dock>#u5dock{display:flex;flex-direction:column}\r\n/* U9 : explorateur dans le dock droit */\r\n#u5dock #explorer{display:flex;flex-direction:column;flex:1;min-height:0;margin:0;padding:0;border:0;max-height:none;background:transparent}\r\n#u5dock #explorer[hidden]{display:none}\r\n#u5dock .xh{display:flex;align-items:center;gap:var(--s-1);height:40px;padding:0 var(--s-3) 0 var(--s-4);flex:none}\r\n#u5dock .xh b{flex:1;font-size:11.5px;font-weight:600;letter-spacing:.04em;text-transform:uppercase;color:var(--c-dim)}\r\n#u5dock .xh button{width:26px;height:26px;border:0;border-radius:var(--r-s);background:transparent;color:var(--c-dim);display:grid;place-items:center;cursor:pointer}\r\n#u5dock .xh button:hover{background:var(--c-raised);color:var(--c-text)}\r\n#u5dock .xs{padding:0 var(--s-3) var(--s-2);flex:none}\r\n#u5dock #xq{width:100%;box-sizing:border-box;height:30px;padding:0 var(--s-3);border:1px solid var(--c-line);border-radius:var(--r-m);background:var(--c-bg);color:var(--c-text);font-size:12.5px;outline:none}\r\n#u5dock #xq:focus{border-color:var(--c-acc)}\r\n#u5dock #xtree{flex:1;min-height:0;overflow:auto;padding:0 var(--s-2) var(--s-3)}\r\n#u5dock .xr{border-radius:var(--r-s)}\r\n#u5dock .xr:hover{background:var(--c-raised)}\r\n#u5dockbtn{width:30px;height:30px;padding:0;display:grid;place-items:center;border-radius:var(--r-m);color:var(--c-dim)}\r\n#u5dockbtn.open{background:var(--c-raised);color:var(--c-text)}\r\n#u5dockbtn[hidden]{display:none}\r\n/* ===== U10 : palette de commandes (#qo, ids inchangés) ===== */\r\n@keyframes u5pal{from{opacity:0;transform:translateY(-6px) scale(.985)}to{opacity:1;transform:none}}\r\n#qo{position:fixed;inset:0;z-index:300;display:flex;justify-content:center;align-items:flex-start;padding-top:12vh;background:color-mix(in srgb,var(--c-bg) 55%,transparent);backdrop-filter:blur(3px)}\r\n#qo[hidden]{display:none}\r\n#qo .qb{width:min(640px,calc(100% - var(--s-8)));max-height:min(60vh,480px);display:flex;flex-direction:column;background:var(--c-surface);border:1px solid var(--c-line);border-radius:var(--r-l);box-shadow:var(--sh-2);overflow:hidden;animation:u5pal var(--t-med) var(--ease)}\r\n#qo #qi{flex:none;border:0;border-bottom:1px solid var(--c-line);border-radius:0;background:transparent;color:var(--c-text);font:15px/1.4 var(--sans);padding:var(--s-4);outline:none;box-shadow:none}\r\n#qo #qi:focus,#qo #qi:focus-visible{outline:none;box-shadow:none}\r\n#qo #ql{overflow-y:auto;overscroll-behavior:contain;padding:var(--s-2)}\r\n#qo #ql .qg{padding:var(--s-2) var(--s-3) var(--s-1);font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--c-dim)}\r\n#qo #ql .qr{display:flex;align-items:baseline;gap:var(--s-3);padding:7px var(--s-3);border-radius:var(--r-m);cursor:pointer;font-size:13.5px}\r\n#qo #ql .qr span{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\r\n#qo #ql .qr em{margin-left:auto;font-style:normal;font-size:12px;color:var(--c-dim);max-width:50%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\r\n#qo #ql .qr:hover,#qo #ql .qr.on{background:var(--sel)}\r\n#qo #ql .qr.on{box-shadow:inset 2px 0 0 var(--c-acc)}\r\n#qo .qh{flex:none;padding:var(--s-2) var(--s-4);border-top:1px solid var(--c-line);font-size:11.5px;color:var(--c-dim)}\r\n/* ===== U15 : couleur d'accent au choix (Paramètres › Apparence) ===== */\r\n.u5acc{display:inline-flex;align-items:center;gap:var(--s-2);flex-wrap:wrap;justify-content:flex-end}\r\n.u5acc>button[data-acc]:not(.u5accreset){width:22px;height:22px;padding:0;border-radius:50%;border:2px solid var(--c-surface);background:var(--sw,var(--c-acc));box-shadow:0 0 0 1px var(--c-line);cursor:pointer;transition:transform var(--t-fast) var(--ease),box-shadow var(--t-fast) var(--ease)}\r\n.u5acc>button[data-acc]:not(.u5accreset):hover{transform:scale(1.12)}\r\n.u5acc>button[data-acc].on{box-shadow:0 0 0 2px var(--c-text)}\r\n.u5accpick{position:relative;width:22px;height:22px;border-radius:50%;overflow:hidden;box-shadow:0 0 0 1px var(--c-line);cursor:pointer;background:conic-gradient(#e5484d,#f5a524,#46a758,#3e63dd,#8e4ec6,#e5484d)}\r\n.u5accpick input{position:absolute;inset:-6px;width:40px;height:40px;opacity:0;cursor:pointer}\r\n.u5accreset{font-size:12px;padding:3px 10px;background:transparent;border:1px solid var(--c-line);border-radius:var(--r-m);color:var(--c-dim);cursor:pointer}\r\n.u5accreset:hover{color:var(--c-text);background:var(--c-raised)}\r\n/* U9 : onglets et éditeur */\r\n#tabs{display:flex;align-items:flex-end;gap:var(--s-1);height:36px;padding:0 var(--s-3);background:var(--c-surface);border-bottom:1px solid var(--c-line);flex:none}\r\n#tabs[hidden]{display:none}\r\n#tl{display:flex;gap:2px;min-width:0;flex:1;overflow-x:auto;scrollbar-width:none}\r\n#tl .tb{display:inline-flex;align-items:center;gap:var(--s-2);height:32px;padding:0 var(--s-3);border:0;border-radius:var(--r-s) var(--r-s) 0 0;background:transparent;color:var(--c-dim);font-size:12.5px;cursor:pointer;white-space:nowrap;position:relative;transition:background var(--t-fast),color var(--t-fast)}\r\n#tl .tb:hover{background:var(--c-raised);color:var(--c-text)}\r\n#tl .tb.on{background:var(--c-bg);color:var(--c-text)}\r\n#tl .tb.on::after{content:'';position:absolute;left:var(--s-2);right:var(--s-2);bottom:0;height:2px;border-radius:2px;background:var(--c-acc)}\r\n#tl .tb.dirty .tn::after{content:' ●';color:var(--c-acc)}\r\n#tr{flex:none;display:flex;align-items:center;height:32px}\r\n#editor{background:var(--c-bg)}\r\n#ed-h{display:flex;align-items:center;gap:var(--s-2);height:36px;padding:0 var(--s-4);border-bottom:1px solid var(--c-line);font-size:12px;color:var(--c-dim);flex:none}\r\n#ed-h .pth{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-family:var(--f-mono,ui-monospace,Consolas,monospace)}\r\n#ed-h .eb{height:26px;padding:0 var(--s-3);border:1px solid var(--c-line);border-radius:var(--r-s);background:transparent;color:var(--c-text);font-size:12px;cursor:pointer}\r\n#ed-h .eb:hover{background:var(--c-raised)}\r\n#ed-h .eb.pri{background:var(--c-acc);border-color:var(--c-acc);color:#fff}\r\n/* U13 : page Fichiers (en-tête, recherche, cartes, état vide) */\r\n#files{padding:var(--s-6) var(--s-8)}\r\n#files .fhead{display:flex;align-items:flex-end;justify-content:space-between;gap:var(--s-4);margin-bottom:var(--s-5);flex-wrap:wrap}\r\n#files .fhead h2{margin:0;font-size:20px;font-weight:650;letter-spacing:-.02em}\r\n#files .fhead p{margin:var(--s-1) 0 0;color:var(--c-dim);font-size:12.5px}\r\n#files .fact{display:flex;align-items:center;gap:var(--s-2);flex-wrap:wrap}\r\n#files .fsearch{display:flex;align-items:center;gap:var(--s-2);height:32px;padding:0 var(--s-3);border:1px solid var(--c-line);border-radius:var(--r-m);background:var(--c-surface);color:var(--c-dim)}\r\n#files .fsearch:focus-within{border-color:var(--c-acc)}\r\n#files #fq{border:0;outline:0;background:transparent;color:var(--c-text);font-size:13px;width:200px}\r\n#fprojs{display:flex;flex-wrap:wrap;gap:var(--s-2);margin-bottom:var(--s-4)}\r\n#fgrid.v4-grid .fr9{border-radius:var(--r-l);border:1px solid var(--c-line);background:var(--c-surface);transition:border-color var(--t-fast),transform var(--t-fast),box-shadow var(--t-fast)}\r\n#fgrid.v4-grid .fr9:hover{border-color:var(--c-acc);transform:translateY(-1px);box-shadow:var(--sh-1)}\r\n#fgrid.v4-grid .fr9.sel{border-color:var(--c-acc);box-shadow:0 0 0 1px var(--c-acc)}\r\n#fempty{color:var(--c-dim)}\r\n#fempty h3{margin:var(--s-3) 0 var(--s-2);color:var(--c-text);font-size:16px}\r\n#fempty p{max-width:420px;margin:0 auto var(--s-4);line-height:1.55;font-size:13px}\r\n/* U13 : bibliothèque (liste des projets, puis fichiers du dossier) */\r\n#files .lh{display:flex;align-items:flex-end;gap:var(--s-4);margin-bottom:var(--s-5)}\r\n#files .lh h2{margin:0;font-size:20px;font-weight:650;letter-spacing:-.02em}\r\n#files .lh p{margin:var(--s-1) 0 0;font-size:12.5px;color:var(--c-dim)}\r\n#files .lh .sp,#files .ltools .sp{flex:1}\r\n#files .lq input,#files .lq2 input{width:240px;height:32px;box-sizing:border-box;padding:0 var(--s-3);border:1px solid var(--c-line);border-radius:var(--r-m);background:var(--c-surface);color:var(--c-text);font-size:13px;outline:none}\r\n#files .lq input:focus,#files .lq2 input:focus{border-color:var(--c-acc)}\r\n#files .lgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:var(--s-3)}\r\n#files .lp{display:flex;align-items:center;gap:var(--s-3);padding:var(--s-4);text-align:left;border:1px solid var(--c-line);border-radius:var(--r-l);background:var(--c-surface);color:var(--c-text);cursor:pointer;transition:border-color var(--t-fast),transform var(--t-fast),box-shadow var(--t-fast)}\r\n#files .lp:hover{border-color:var(--c-acc);transform:translateY(-1px);box-shadow:var(--sh-1)}\r\n#files .lpi{display:grid;place-items:center;width:38px;height:38px;flex:none;border-radius:var(--r-m);background:var(--c-raised);color:var(--c-acc)}\r\n#files .lpb{display:flex;flex-direction:column;min-width:0;flex:1}\r\n#files .lpb b{font-size:14px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\r\n#files .lpb small{margin-top:2px;color:var(--c-dim);font-size:11.5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-family:var(--f-mono,ui-monospace,Consolas,monospace)}\r\n#files .lpn{flex:none;font-size:11.5px;color:var(--c-dim);font-variant-numeric:tabular-nums}\r\n#files .lnote{padding:var(--s-8) var(--s-4);text-align:center;color:var(--c-dim);font-size:13px;line-height:1.6;border:1px dashed var(--c-line);border-radius:var(--r-l)}\r\n#files .lnote .btn{margin-top:var(--s-3)}\r\n#files .lleg{margin-top:var(--s-5);background:transparent;border:0;color:var(--c-dim);font-size:12.5px;cursor:pointer}\r\n#files .lleg:hover{color:var(--c-text)}\r\n#files .lbc{display:flex;align-items:center;gap:var(--s-1);margin-bottom:var(--s-3);font-size:13px}\r\n#files .lbc button{border:0;background:transparent;color:var(--c-dim);padding:var(--s-1) var(--s-2);border-radius:var(--r-s);cursor:pointer}\r\n#files .lbc button:hover{background:var(--c-raised);color:var(--c-text)}\r\n#files .lbc button.cur{color:var(--c-text);font-weight:600}\r\n#files .lbc i{font-style:normal;color:var(--c-dim);opacity:.5}\r\n#files .ltools{display:flex;align-items:center;gap:var(--s-2);margin-bottom:var(--s-3)}\r\n#files .ltools .cnt{font-size:12px;color:var(--c-dim)}\r\n#files .lrow{display:grid;grid-template-columns:34px minmax(0,1fr) 90px 150px 28px;align-items:center;gap:var(--s-3);height:40px;padding:0 var(--s-3);border-radius:var(--r-m);cursor:pointer;font-size:13px}\r\n#files .lrow:hover{background:var(--c-raised)}\r\n#files .lrow .lb{display:grid;place-items:center;height:22px;border-radius:var(--r-s);background:color-mix(in srgb,var(--c,#888) 18%,transparent);color:var(--c,#888);font-size:9.5px;font-weight:700;letter-spacing:.02em}\r\n#files .lrow .ln{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\r\n#files .lrow.d .ln{font-weight:600}\r\n#files .lrow .lm{color:var(--c-dim);font-size:12px;font-variant-numeric:tabular-nums}\r\n#files .lrow .lm.r{text-align:right}\r\n#files .lrow .lx{opacity:0;border:0;background:transparent;color:var(--c-dim);cursor:pointer;border-radius:var(--r-s);height:26px}\r\n#files .lrow:hover .lx{opacity:1}\r\n/* U14 : accueil et premiers pas */\r\n#empty>div{max-width:560px;text-align:center}\r\n#empty h2{margin:0 0 var(--s-2);font-size:26px;font-weight:700;letter-spacing:-.03em}\r\n#empty p{margin:0 auto var(--s-5);max-width:460px;color:var(--c-dim);font-size:13.5px;line-height:1.6}\r\n#empty .ebtns{display:flex;justify-content:center;gap:var(--s-2);margin-bottom:var(--s-6)}\r\n.u5-steps{list-style:none;margin:0;padding:0;display:grid;gap:var(--s-2);text-align:left;counter-reset:u5s}\r\n.u5-steps li{counter-increment:u5s;display:grid;grid-template-columns:28px 1fr;column-gap:var(--s-3);padding:var(--s-3) var(--s-4);border:1px solid var(--c-line);border-radius:var(--r-l);background:var(--c-surface)}\r\n.u5-steps li::before{content:counter(u5s);grid-row:1/3;display:grid;place-items:center;width:28px;height:28px;border-radius:50%;background:var(--c-raised);color:var(--c-acc);font-weight:700;font-size:13px}\r\n.u5-steps b{font-size:13.5px;font-weight:600}\r\n.u5-steps span{font-size:12.5px;color:var(--c-dim);line-height:1.5}\r\n#splash{grid-column:1/-1}\r\n/* U4 : rail gauche : projets en haut, clés repliables, pied fixe (réglages + thème), défilement interne */\r\nbody>aside{display:flex;flex-direction:column;gap:var(--s-2);padding:var(--s-3)}\r\nbody>aside .brand{flex:none}\r\nbody>aside #newproj,body>aside #filesbtn{flex:none}\r\nbody>aside .pgrp{flex:none;margin:var(--s-2) 0 0;font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--c-dim)}\r\nbody>aside #plist{flex:1 1 0;min-height:80px;overflow-y:auto;overflow-x:hidden;overscroll-behavior:contain}\r\nbody>aside #keysbox{flex:0 1 auto;max-height:38%;min-height:0;display:flex;flex-direction:column;border-top:1px solid var(--c-line);padding-top:var(--s-2)}\r\nbody>aside #keysbox .keyshead{flex:none}\r\nbody>aside #keysbody{min-height:0;overflow-y:auto;overscroll-behavior:contain;display:flex;flex-direction:column;gap:var(--s-2);padding-top:var(--s-2)}\r\nbody>aside #keysbox .keyshead[aria-expanded=\"false\"]+#keysbody{display:none}\r\nbody>aside .foot{flex:none;display:flex;gap:var(--s-2);align-items:center;border-top:1px solid var(--c-line);padding-top:var(--s-2);margin-top:auto}\r\nbody>aside .foot #gear{flex:1;min-width:0}\r\nbody>aside.min #plist,body>aside.min #keysbox,body>aside.min .pgrp,body>aside.min .brand h1{display:none}\r\n/* U8 : actions, diffs, changements */\r\n.lacts{gap:var(--s-1);margin:var(--s-2) 0;font-size:12.5px}\r\n.lacts .la{padding:3px var(--s-2);border-radius:var(--r-s);border:1px solid transparent;transition:background var(--t-fast),border-color var(--t-fast)}\r\n.lacts .la:hover{background:var(--c-surface)}\r\n.lacts .la.ok i{color:var(--c-ok)}\r\n.lacts .la.err,.lacts .la.err>i,.lacts .la.err summary{color:var(--c-err)}\r\n.lacts .la.err{border-color:var(--c-err)}\r\n.lacts details.la pre{background:var(--c-surface);border:1px solid var(--c-line);border-radius:var(--r-s);font-family:Cascadia Code,Consolas,monospace}\r\npre.ldf{background:var(--c-surface);border:1px solid var(--c-line);border-radius:var(--r-s)}\r\npre.ldf .dl.a{background:color-mix(in srgb,var(--c-ok) 16%,transparent);color:var(--c-ok)}\r\npre.ldf .dl.d{background:color-mix(in srgb,var(--c-err) 14%,transparent);color:var(--c-err)}\r\n.lchg{border-top:1px solid var(--c-line);color:var(--c-dim)}\r\n.lchg .lund,.lchg button{border:1px solid var(--c-line);background:var(--c-raised);color:var(--c-text);border-radius:var(--r-s);padding:3px var(--s-2);cursor:pointer;transition:border-color var(--t-fast),color var(--t-fast)}\r\n.lchg .lund:hover{border-color:var(--c-err);color:var(--c-err)}\r\n.lchp{background:var(--c-surface);border:1px solid var(--c-line);border-radius:var(--r-m);padding:var(--s-2)}\r\n.ltok{color:var(--c-dim);font-size:11px}\r\n@media (prefers-reduced-motion:reduce){.lacts .la,.lchg button{transition:none}}\r\n/* U12 : Paramètres et Centre de contrôle : navigation latérale, pages en cartes */\r\n#set .snav{background:var(--c-raised);border-right:1px solid var(--c-line);padding:var(--s-5) var(--s-3);gap:var(--s-1)}\r\n#set .snav h2{font:600 15px var(--sans);color:var(--c-text);padding:0 var(--s-3) var(--s-3)}\r\n#set .snav button{border-radius:var(--r-s);color:var(--c-dim);padding:var(--s-2) var(--s-3);transition:background var(--t-fast),color var(--t-fast)}\r\n#set .snav button:hover{background:var(--c-surface);color:var(--c-text)}\r\n#set .snav button.on{background:var(--c-surface);color:var(--c-text);box-shadow:inset 2px 0 0 var(--c-acc)}\r\n#set .spanes{background:var(--c-bg);padding:0 clamp(16px,4vw,48px) var(--s-8)}\r\n#set .pane{max-width:760px;padding-top:var(--s-6)}\r\n#set .pane h2{font:600 22px var(--sans);color:var(--c-text);margin-bottom:var(--s-2)}\r\n#set .card,#p-cc .cc-card{background:var(--c-surface);border:1px solid var(--c-line);border-radius:var(--r-m);box-shadow:var(--sh-1);margin:var(--s-3) 0;padding:var(--s-1) var(--s-4)}\r\n#set .card:hover,#p-cc .cc-card:hover{border-color:var(--c-acc)}\r\n#set .opt{border-top:1px solid var(--c-line);padding:var(--s-3) var(--s-4);gap:var(--s-5)}\r\n#set .opt:first-child{border-top:0}\r\n#p-cc .cc-card{padding:var(--s-4)}\r\n#p-cc .cc-card h3{font:600 15px var(--sans);color:var(--c-text);margin:0 0 var(--s-1)}\r\n#p-cc .sub,#p-cc .cc-tip,#p-cc .cc-msg{color:var(--c-dim)}\r\n#p-cc .cc-pill.ok{color:var(--c-ok)}#p-cc .cc-pill.warn{color:var(--c-warn)}#p-cc .cc-pill.err{color:var(--c-err)}\r\n#p-cc .cc-dot.ok{background:var(--c-ok)}#p-cc .cc-dot.warn{background:var(--c-warn)}#p-cc .cc-dot.err{background:var(--c-err)}\r\n#p-cc .cc-bar>i{background:var(--c-acc)}\r\n@media (prefers-reduced-motion:reduce){#set .snav button{transition:none}}\r\n@media (max-width:900px){#set .snav{padding:var(--s-4) var(--s-2)}#set .pane{padding-top:var(--s-4)}}\r\n/* R3 : chat en canvas : colonne de 860 px, composer flottant en pilule */\r\n#chat{--col:min(860px,calc(100% - var(--s-8)))}\r\n#ch-msgs>*{width:var(--col)}\r\n#ch-bar{position:relative;padding:var(--s-2) 0 var(--s-4);background:linear-gradient(to top,var(--c-bg) 60%,transparent)}\r\n#ch-bar>*{width:var(--col)}\r\n#ch-box{display:flex;align-items:flex-end;gap:var(--s-2);padding:var(--s-2) var(--s-3);background:var(--c-surface);border:1px solid var(--c-line);border-radius:28px;box-shadow:var(--sh-2);transition:border-color var(--t-fast),box-shadow var(--t-fast)}\r\n#ch-box:focus-within{border-color:var(--c-acc);box-shadow:var(--sh-2),0 0 0 3px color-mix(in srgb,var(--c-acc) 18%,transparent)}\r\n#ch-box #ch-in{flex:1;min-width:0;border:0;background:transparent;box-shadow:none;outline:none;resize:none;padding:var(--s-2) var(--s-1);max-height:40vh}\r\n#ch-box .btn{border-radius:999px;flex:none}\r\n#ch-box #ch-mode,#ch-box #ch-att{border:0;background:transparent;color:var(--c-dim)}\r\n#ch-box #ch-mode:hover,#ch-box #ch-att:hover{background:var(--c-raised);color:var(--c-text)}\r\n#ch-chips{margin-bottom:var(--s-2)}\r\n#ch-hint{margin-top:var(--s-1);text-align:center;color:var(--c-dim);font-size:11.5px}\r\n@media (prefers-reduced-motion:reduce){#ch-box{transition:none}}\r\n@media (max-width:1100px){:root{--rail-w:216px}body.u5-dock{--dock-w:280px}}\r\n@media (max-height:780px){:root{--top-h:38px}}\r\n/* ===== U6 : chat sobre. Séparation nette utilisateur / IA, blocs de code, lignes d'activité, ancrage en bas (CSS seulement, aucun id ni classe renommé) ===== */\r\n#ch-msgs{display:flex;flex-direction:column;overflow-y:auto;overflow-x:hidden;overscroll-behavior:contain;padding:var(--s-6) 0 var(--s-3);scrollbar-width:thin;scrollbar-color:var(--c-line) transparent}\r\n#ch-msgs>*{width:min(780px,calc(100% - var(--s-8)));flex:none}\r\n#ch-msgs>.m:first-child{margin-top:auto}\r\n.m{margin-bottom:var(--s-5);animation:itemin var(--t-med) var(--ease) backwards}\r\n.m.a+.m.u,.m.u+.m.a{margin-top:var(--s-6)}\r\n.m.u .b{background:var(--c-raised);border:1px solid var(--c-line);color:var(--c-text);border-radius:var(--r-l) var(--r-l) var(--s-1) var(--r-l);padding:var(--s-3) var(--s-4);max-width:84%;font-size:14px;line-height:1.65}\r\n.m.a .b{padding:0;font-size:14px;line-height:1.7}\r\n.m.a .mk{font:600 11.5px var(--sans);letter-spacing:.02em;color:var(--c-dim);margin-bottom:var(--s-2)}\r\n.m.a .mk .dot{width:8px;height:8px;border-radius:50%;flex:none}\r\n.m .mf{margin-top:var(--s-2);font-size:12px;color:var(--c-dim)}\r\n.m.s{margin-bottom:var(--s-4)}\r\n.m.s>span{font-size:12px;color:var(--c-dim);background:var(--c-raised);border:1px solid var(--c-line);border-radius:99px;padding:3px var(--s-3)}\r\n.m .b h1,.m .b h2,.m .b h3{font-weight:650;letter-spacing:-.01em;line-height:1.3;margin:1.1em 0 .4em}\r\n.m .b h1{font-size:1.25em}.m .b h2{font-size:1.12em}.m .b h3{font-size:1.02em}\r\n.m .b blockquote{border-left:3px solid var(--c-line);margin:.6em 0;padding:0 var(--s-3);color:var(--c-dim)}\r\n.m .b a{color:var(--c-acc)}\r\n.m .b code{font-family:var(--mono);font-size:.9em;background:var(--c-raised);border:1px solid var(--c-line);border-radius:var(--r-s);padding:1px 5px}\r\n.m .b pre,.m .cb pre{background:var(--c-raised);border:1px solid var(--c-line);border-radius:var(--r-m);padding:var(--s-3) var(--s-4);font:12.5px/1.6 var(--mono);tab-size:2;overflow:auto;max-width:100%}\r\n.m .b pre code{background:none;border:0;padding:0;font:inherit}\r\n.m .cb .cbc{opacity:0;transition:opacity var(--t-fast) var(--ease);background:var(--c-surface);border-color:var(--c-line);border-radius:var(--r-s)}\r\n.m .cb:hover .cbc,.m .cb .cbc:focus-visible{opacity:1}\r\n.lacts{gap:1px;margin:var(--s-2) 0 var(--s-1);font-size:12px}\r\n.lacts .la{padding:2px 0;border:0;font-family:var(--mono);color:var(--c-dim)}\r\n.lacts .la.ok i{color:var(--c-ok)}\r\n.lacts .la.err,.lacts .la.err summary,.lacts .la.err>span{color:var(--c-err)}\r\n.lacts details.la summary:hover{color:var(--c-text)}\r\n.lacts details.la pre{background:var(--c-raised);border:1px solid var(--c-line);border-radius:var(--r-s);margin:var(--s-1) 0 var(--s-2) 20px;font:11.5px/1.5 var(--mono);max-height:240px}\r\n#ch-msgs>.m:last-child{margin-bottom:var(--s-2)}\r\n/* ===== U7 : barre de saisie (CSS seulement, ids inchangés) : zone extensible, puces, mode, envoyer / arrêter / file ===== */\r\n#ch-bar{flex:none;padding:var(--s-2) 0 var(--s-4)}\r\n#ch-bar>*{width:min(780px,calc(100% - var(--s-8)));margin-left:auto;margin-right:auto}\r\n#ch-box{display:grid!important;grid-template-columns:auto auto 1fr auto auto!important;grid-template-areas:\"in in in in in\" \"att mode . stop go\"!important;gap:var(--s-1) var(--s-2);align-items:center;min-height:0;padding:var(--s-3) var(--s-3) var(--s-2);background:var(--c-surface);border:1px solid var(--c-line);border-radius:var(--r-l);box-shadow:var(--sh-1);transition:border-color var(--t-fast) var(--ease),box-shadow var(--t-fast) var(--ease)}\r\n#ch-box:focus-within{border-color:color-mix(in srgb,var(--c-acc) 60%,var(--c-line));box-shadow:var(--sh-1),0 0 0 3px color-mix(in srgb,var(--c-acc) 16%,transparent)}\r\n#ch-box #ch-in,#ch-box #ch-in:focus,#ch-box #ch-in:focus-visible{grid-area:in;min-height:44px;max-height:min(260px,40vh);padding:var(--s-1) var(--s-1) var(--s-2);font:14px/1.55 var(--sans);background:transparent!important;border:0!important;box-shadow:none!important;outline:none!important;resize:none}\r\n#ch-att{grid-area:att}#ch-mode{grid-area:mode;font-size:12px;color:var(--c-dim)}\r\n#ch-stop{grid-area:stop}#ch-send{grid-area:go}\r\n#ch-send{border-radius:99px;padding:5px var(--s-4);font-weight:600;transition:transform var(--t-fast) var(--ease),opacity var(--t-fast)}\r\n#ch-send:active{transform:scale(.96)}\r\n#ch-stop{border-radius:99px}\r\n#ch-send[hidden],#ch-stop[hidden]{display:none!important}\r\n#ch-chips{display:flex;flex-wrap:wrap;gap:var(--s-2);margin-bottom:var(--s-2)}\r\n#ch-chips:empty{display:none}\r\n#ch-chips .fc{display:inline-flex;align-items:center;gap:var(--s-2);padding:2px var(--s-1) 2px var(--s-3);border-radius:99px;background:var(--c-raised);border:1px solid var(--c-line);font-size:12px;animation:itemin var(--t-med) var(--ease) backwards}\r\n#ch-hint{font-size:11px;color:var(--c-dim);text-align:center;margin-top:var(--s-2);opacity:.85}\r\n#views.split #ch-hint{display:none}\r\n/* ===== U11 : composants uniques (bouton, champ, interrupteur, menu, dialogue, toast), jetons seulement ===== */\r\n.btn{display:inline-flex;align-items:center;justify-content:center;gap:var(--s-2);min-height:32px;padding:5px var(--s-3);border-radius:var(--r-m);border:1px solid var(--c-line);background:var(--c-surface);color:var(--c-text);font:500 13px var(--sans);cursor:pointer;box-shadow:none;transition:background var(--t-fast) var(--ease),border-color var(--t-fast) var(--ease),transform var(--t-fast) var(--ease),opacity var(--t-fast)}\r\n.btn:hover:not(:disabled){background:var(--hover);border-color:color-mix(in srgb,var(--c-text) 22%,var(--c-line))}\r\n.btn:active:not(:disabled){transform:scale(.97)}\r\n.btn:disabled{opacity:.5;cursor:default}\r\n.btn.pri{background:var(--c-acc);border-color:transparent;color:#fff}\r\n.btn.pri:hover:not(:disabled){background:color-mix(in srgb,var(--c-acc) 86%,#000);border-color:transparent;box-shadow:none;transform:none}\r\n.btn.ghost{background:transparent;border-color:transparent;color:var(--c-dim)}\r\n.btn.ghost:hover:not(:disabled){background:var(--hover);color:var(--c-text)}\r\n.btn.sm{min-height:26px;padding:2px var(--s-2);font-size:12px}\r\n.btn:focus-visible,.sw:focus-visible{outline:2px solid color-mix(in srgb,var(--c-acc) 70%,transparent);outline-offset:2px}\r\nselect,input:not([type=checkbox]):not([type=range]):not([type=file]),textarea{font:13px var(--sans);color:var(--c-text);background:var(--c-surface);border:1px solid var(--c-line);border-radius:var(--r-m);padding:6px var(--s-3);transition:border-color var(--t-fast) var(--ease),box-shadow var(--t-fast) var(--ease)}\r\nselect:hover,input:not([type=checkbox]):hover,textarea:hover{border-color:color-mix(in srgb,var(--c-text) 22%,var(--c-line))}\r\nselect:focus,input:not([type=checkbox]):focus,textarea:focus{outline:none;border-color:var(--c-acc);box-shadow:0 0 0 3px color-mix(in srgb,var(--c-acc) 20%,transparent)}\r\n.sw{background:var(--c-line);transition:background var(--t-med) var(--ease)}\r\n.sw:checked{background:var(--c-acc)}\r\n#fmenu,#ch-menu,#hmenu,.menu{background:var(--c-surface);border:1px solid var(--c-line);border-radius:var(--r-m);box-shadow:var(--sh-2);padding:var(--s-1);animation:menuin var(--t-fast) var(--ease)}\r\ndialog{background:var(--c-surface);color:var(--c-text);border:1px solid var(--c-line);border-radius:var(--r-l);box-shadow:var(--sh-2);padding:var(--s-5) var(--s-6)}\r\ndialog[open]{animation:dlgin var(--t-med) var(--ease)}\r\ndialog::backdrop{background:rgba(0,0,0,.45);backdrop-filter:blur(3px)}\r\ndialog h3{font:650 17px var(--sans);letter-spacing:-.01em}\r\ndialog label{color:var(--c-dim);font:600 12px var(--sans)}\r\ndialog .row{display:flex;justify-content:flex-end;gap:var(--s-2);margin-top:var(--s-5)}\r\n#toast{background:var(--c-text);color:var(--c-bg);border:0;border-radius:var(--r-m);box-shadow:var(--sh-2);padding:var(--s-2) var(--s-4);font:500 13px var(--sans)}\r\n/* ===== U16 : finitions : durées 120-200 ms, mouvement réduit, focus visibles, raccourcis affichés ===== */\r\na,button,summary,[role=button],.fcard,.fc-item,#plist>*,#list>*,.snav button{transition-duration:var(--t-fast);transition-timing-function:var(--ease)}\r\n.fcard,.fc-item{transition-duration:var(--t-med)}\r\na:focus-visible,button:focus-visible,summary:focus-visible,[tabindex]:focus-visible,select:focus-visible,.snav button:focus-visible,#plist>*:focus-visible,#list>*:focus-visible{outline:2px solid color-mix(in srgb,var(--c-acc) 70%,transparent);outline-offset:2px;border-radius:var(--r-s)}\r\nkbd,.kbd,.kb{display:inline-block;font:500 11px/1 var(--mono);color:var(--c-dim);background:var(--c-raised);border:1px solid var(--c-line);border-bottom-width:2px;border-radius:var(--r-s);padding:2px 5px;margin-left:var(--s-2);vertical-align:middle}\r\n.menu [data-kb]::after,#ch-menu [data-kb]::after,#hmenu [data-kb]::after{content:attr(data-kb);margin-left:auto;padding-left:var(--s-4);font:500 11px var(--mono);color:var(--c-dim)}\r\n@media (prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-delay:0s!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}}\r\n/* ===== U17 : petites fenêtres (1024x640 et étroites) : dock en superposition, rail réduit, barres plus basses ===== */\r\n@media (max-width:1024px){\r\n  :root{--rail-w:200px}\r\n  body.u5-dock{--dock-w:0px}\r\n  body>#u5dock{position:fixed;top:var(--top-h);right:0;bottom:0;width:min(320px,88vw);z-index:60;box-shadow:-12px 0 32px rgba(0,0,0,.28)}\r\n  body.u5-dock>#u5dock{display:flex}\r\n  #ch-msgs>*{width:min(780px,calc(100% - var(--s-6)))}\r\n  main>header .hbtns .btn span,#hacc .hl{display:none}\r\n}\r\n@media (max-width:720px){\r\n  :root{--rail-w:56px}\r\n  body>aside:not(.min) #plist,body>aside:not(.min) #keysbox,body>aside:not(.min) .pgrp,body>aside:not(.min) .brand h1,body>aside:not(.min) .pn,body>aside:not(.min) #filesbtn .pill{display:none}\r\n  body>aside:not(.min) #newproj,body>aside:not(.min) #filesbtn,body>aside:not(.min) #gear{font-size:0;gap:0;justify-content:center;padding:8px 0}\r\n  .u5-crumb,.u5-sep{display:none}\r\n}\r\n@media (max-height:640px){\r\n  :root{--top-h:36px}\r\n  #ch-msgs{padding-top:var(--s-3)}\r\n  .m{margin-bottom:var(--s-3)}\r\n  #ch-bar{padding-bottom:var(--s-2)}\r\n  body>aside .brand{padding-top:var(--s-1);padding-bottom:var(--s-1)}\r\n}\r\n/* ===== R1 (5.2) : bandeau d'icônes 56 px ; le rail complet (248 px) s'ouvre en superposition (aside.u5-open) ===== */\r\n:root{--rail-w:56px}\r\nbody>aside{position:relative;z-index:80;overflow:visible;padding:var(--s-2) 6px;align-items:center}\r\nbody>aside .brand h1,body>aside .pgrp,body>aside #keysbox,body>aside #plist .pn,body>aside #plist .acc b,body>aside #plist .acc .spin,body>aside #filesbtn .pill,body>aside .pempty{display:none}\r\nbody>aside #newproj,body>aside #filesbtn,body>aside #gear{font-size:0;gap:0;justify-content:center;padding:8px 0;width:100%}\r\nbody>aside #plist{width:100%;margin:0;padding:0;overflow-y:auto;overflow-x:hidden}\r\nbody>aside #plist .acc{justify-content:center;padding:8px 0;border-radius:var(--r-m)}\r\nbody>aside .foot{flex-direction:column;align-items:center;gap:var(--s-1);width:100%}\r\nbody>aside .foot #themebtn{width:100%}\r\nbody>aside .brand{justify-content:center;padding:0}\r\nbody>aside.u5-open{position:fixed;top:0;left:0;bottom:0;width:248px;align-items:stretch;padding:var(--s-3) var(--s-2);box-shadow:var(--sh-2);animation:menuin var(--t-med) var(--ease)}\r\nbody>aside.u5-open .brand h1,body>aside.u5-open .pgrp,body>aside.u5-open #keysbox,body>aside.u5-open #plist .pn,body>aside.u5-open #filesbtn .pill{display:revert}\r\nbody>aside.u5-open #plist .acc{justify-content:flex-start;padding:6px var(--s-2)}\r\nbody>aside.u5-open #newproj,body>aside.u5-open #filesbtn,body>aside.u5-open #gear{font-size:inherit;gap:var(--s-2);justify-content:flex-start;padding:5px var(--s-3)}\r\nbody>aside.u5-open .foot{flex-direction:row;align-items:center}\r\nbody>aside.u5-open .brand{justify-content:flex-start;padding:var(--s-1) var(--s-2)}\r\n@media (max-width:1100px),(max-width:1024px),(max-width:720px){:root{--rail-w:56px}}\r\n/* ===== R2 : barre de commande centrale (Ctrl K) à la place du fil d'Ariane ; l'ancien bouton reste dans le DOM (contrat) mais caché ===== */\r\nmain>header strong#title{flex:1 1 auto;justify-content:center;min-width:0}\r\n/* ===== R4 : chaque tour de l'IA = une carte de chronologie (étapes ✔/✕ en ligne, diff, Changements, crédits) ===== */\r\n.lacts{position:relative;margin:var(--s-3) 0 var(--s-2);padding:var(--s-2) var(--s-3) var(--s-2) var(--s-5);background:var(--c-surface);border:1px solid var(--c-line);border-radius:var(--r-l);box-shadow:var(--sh-1);animation:itemin var(--t-med) var(--ease) backwards}\r\n.lacts::before{content:\"\";position:absolute;left:var(--s-3);top:var(--s-4);bottom:var(--s-4);width:2px;border-radius:2px;background:var(--c-line)}\r\n.lacts .la{position:relative;display:flex;align-items:center;gap:var(--s-2);padding:3px 0}\r\n.lacts .la>i,.lacts details.la>summary>i{position:relative;z-index:1;display:inline-grid;place-items:center;width:14px;height:14px;margin-left:calc(-1 * var(--s-4) - 7px);border-radius:50%;background:var(--c-surface);font-size:10px;line-height:1}\r\n.lacts .la.ok>i,.lacts details.la.ok>summary>i{color:var(--c-ok)}\r\n.lacts .la.err>i,.lacts details.la.err>summary>i{color:var(--c-err)}\r\n.lacts .la.run>i{color:var(--c-acc)}\r\n.lacts details.la{display:block}\r\n.lacts details.la>summary{display:flex;align-items:center;gap:var(--s-2);cursor:pointer;list-style:none}\r\n.lacts details.la>summary::-webkit-details-marker{display:none}\r\n.lacts .ldfd{margin:var(--s-1) 0 var(--s-1) 0}\r\n.lacts .ldfd>summary{font:500 11.5px var(--sans);color:var(--c-dim);cursor:pointer}\r\n.lacts .ldf{background:var(--c-raised);border:1px solid var(--c-line);border-radius:var(--r-s);max-height:260px;overflow:auto}\r\n.lacts .lchg{margin-top:var(--s-2);padding-top:var(--s-2);border-top:1px solid var(--c-line);border-top-style:solid}\r\n.lacts .ltok{margin-top:var(--s-1);font:500 11px var(--sans);color:var(--c-dim)}\r\n@media (prefers-reduced-motion:reduce){.lacts{animation:none}}\r\n/* ===== R7 : accueil de projet ===== */\r\n.u5h{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:var(--s-3);margin:var(--s-6) auto 0;max-width:640px;text-align:left}\r\n.u5h-c{background:var(--c-surface);border:1px solid var(--c-line);border-radius:var(--r-l);padding:var(--s-3) var(--s-4);box-shadow:var(--sh-1);animation:itemin var(--t-med) var(--ease) backwards}\r\n.u5h-c small{display:block;font:600 11px var(--sans);letter-spacing:.06em;text-transform:uppercase;color:var(--c-dim);margin-bottom:var(--s-1)}\r\n.u5h-c div{font-size:13px;line-height:1.5;color:var(--c-text);word-break:break-word}\r\n.u5h-a{display:flex;gap:var(--s-2);justify-content:center;margin-top:var(--s-5)}\r\n/* ===== R5 : inspecteur en tiroir à droite, ouvert à la demande, jamais réservé (la colonne de grille reste à 0) ===== */\r\nbody.u5-dock,body.u5-dock:not(:has(#u5dock #xtree>*)){--dock-w:0px}\r\nbody>#u5dock{position:fixed!important;top:var(--top-h);right:0;bottom:0;width:min(340px,90vw);z-index:60;display:flex!important;flex-direction:column;transform:translateX(104%);visibility:hidden;box-shadow:none;transition:transform 200ms var(--ease),visibility 0s linear 200ms}\r\nbody.u5-dock>#u5dock,body.u5-dock:not(:has(#u5dock #xtree>*))>#u5dock{transform:none;visibility:visible;box-shadow:-14px 0 36px rgba(0,0,0,.28);transition:transform 200ms var(--ease)}\r\n#u5tabs{display:flex;gap:var(--s-1);padding:var(--s-2) var(--s-3) 0;flex:none;border-bottom:1px solid var(--c-line)}\r\n#u5tabs button{border:0;background:transparent;color:var(--c-dim);font:600 12px var(--sans);padding:var(--s-2) var(--s-3);border-bottom:2px solid transparent;cursor:pointer;transition:color 120ms,border-color 120ms}\r\n#u5tabs button:hover{color:var(--c-text)}\r\n#u5tabs button.on{color:var(--c-text);border-bottom-color:var(--c-acc)}\r\n#u5tasks{flex:1;min-height:0;margin:0;padding:var(--s-3) var(--s-4);overflow:auto;font:12px/1.6 ui-monospace,Consolas,monospace;white-space:pre-wrap;word-break:break-word;color:var(--c-text)}\r\n#u5tasks[hidden]{display:none}\r\n@media (prefers-reduced-motion:reduce){body>#u5dock{transition:none}}\r\n/* R6 : nouvelle identité : palette chaude neutre + accent sarcelle, rayons plus doux, clair / sombre / système */\r\n:root{--c-bg:#f7f7f5;--c-surface:#ffffff;--c-raised:#efeee9;--c-line:#e2e0d9;--c-text:#1a1a18;--c-dim:#66655f;--c-acc:#0f766e;--c-on-acc:#ffffff;--c-ok:#166534;--c-err:#b42318;--c-warn:#92400e;--r-s:8px;--r-m:12px;--r-l:18px;--sh-1:0 1px 2px rgba(20,20,10,.06);--sh-2:0 6px 24px rgba(20,20,10,.10)}\r\n:root[data-theme=dark]{--c-bg:#0f1112;--c-surface:#171a1b;--c-raised:#0b0d0e;--c-line:#26292b;--c-text:#e8e8e5;--c-dim:#9a9b96;--c-acc:#5eead4;--c-on-acc:#06201c;--c-ok:#4ade80;--c-err:#f87171;--c-warn:#fbbf24;--sh-1:0 1px 2px rgba(0,0,0,.4);--sh-2:0 8px 28px rgba(0,0,0,.5)}\r\n@media (prefers-color-scheme:dark){:root[data-theme=system]{--c-bg:#0f1112;--c-surface:#171a1b;--c-raised:#0b0d0e;--c-line:#26292b;--c-text:#e8e8e5;--c-dim:#9a9b96;--c-acc:#5eead4;--c-on-acc:#06201c;--c-ok:#4ade80;--c-err:#f87171;--c-warn:#fbbf24;--sh-1:0 1px 2px rgba(0,0,0,.4);--sh-2:0 8px 28px rgba(0,0,0,.5)}}\r\nbody{font-family:\"Inter\",\"Segoe UI Variable Text\",\"Segoe UI\",system-ui,-apple-system,Roboto,Helvetica,Arial,sans-serif;line-height:1.5;-webkit-font-smoothing:antialiased}\r\npre,code,.lacts{font-family:\"Cascadia Code\",\"Cascadia Mono\",Consolas,monospace}\r\n.btn.pri,button.pri{background:var(--c-acc);border-color:var(--c-acc);color:var(--c-on-acc)}\r\n.btn.pri:hover{filter:brightness(1.08)}\r\n::selection{background:color-mix(in srgb,var(--c-acc) 30%,transparent)}\r\n</style>\r\n<style id=\"ui6\">\r\n/* ===== 6.0 N1 : jetons ui6 : couleurs, ombres, rayons, espacements, mouvement, typographie (dernier bloc de style : il prime) ===== */\r\n:root{color-scheme:light;\r\n--c-bg:#f6f6f3;--c-surface:#ffffff;--c-raised:#ecebe6;--c-line:#e0ded6;--c-text:#181816;--c-dim:#62615b;\r\n--c-acc:#0d7c70;--c-acc2:#6d5ef0;--c-on-acc:#ffffff;--c-ok:#15803d;--c-err:#b42318;--c-warn:#a35a0b;\r\n--c-glow:color-mix(in srgb,var(--c-acc) 28%,transparent);\r\n--r-s:8px;--r-m:12px;--r-l:18px;--r-xl:26px;\r\n--s-1:4px;--s-2:8px;--s-3:12px;--s-4:16px;--s-5:20px;--s-6:24px;--s-7:32px;--s-8:40px;\r\n--sh-1:0 1px 2px rgba(20,20,10,.06),0 2px 8px rgba(20,20,10,.05);\r\n--sh-2:0 8px 30px rgba(20,20,10,.12),0 0 0 1px rgba(20,20,10,.04);\r\n--sh-3:0 24px 64px rgba(20,20,10,.20);\r\n--ease:cubic-bezier(.2,.8,.2,1);--spring:cubic-bezier(.3,1.4,.5,1);--ease-in:cubic-bezier(.4,0,1,1);\r\n--t-fast:120ms;--t-med:220ms;--t-slow:420ms;--stagger:40ms;\r\n--sans:\"Inter\",\"Segoe UI Variable Text\",\"Segoe UI\",system-ui,-apple-system,Roboto,Helvetica,Arial,sans-serif;--serif:var(--sans);\r\n--mono:\"Cascadia Code\",\"Cascadia Mono\",Consolas,\"SF Mono\",Menlo,monospace;\r\n--fs-s:12px;--fs-m:14px;--fs-l:16px;--fs-xl:22px;--fs-2xl:32px}\r\n:root[data-theme=dark]{color-scheme:dark;\r\n--c-bg:#0e1011;--c-surface:#161819;--c-raised:#0a0b0c;--c-line:#25282a;--c-text:#e9e9e6;--c-dim:#9a9b95;\r\n--c-acc:#5eead4;--c-acc2:#a5a0ff;--c-on-acc:#052420;--c-ok:#4ade80;--c-err:#f87171;--c-warn:#fbbf24;\r\n--sh-1:0 1px 2px rgba(0,0,0,.45),0 2px 8px rgba(0,0,0,.3);--sh-2:0 8px 30px rgba(0,0,0,.5),0 0 0 1px rgba(255,255,255,.05);--sh-3:0 24px 64px rgba(0,0,0,.65)}\r\n@media (prefers-color-scheme:dark){:root[data-theme=system]{color-scheme:dark;\r\n--c-bg:#0e1011;--c-surface:#161819;--c-raised:#0a0b0c;--c-line:#25282a;--c-text:#e9e9e6;--c-dim:#9a9b95;\r\n--c-acc:#5eead4;--c-acc2:#a5a0ff;--c-on-acc:#052420;--c-ok:#4ade80;--c-err:#f87171;--c-warn:#fbbf24;\r\n--sh-1:0 1px 2px rgba(0,0,0,.45),0 2px 8px rgba(0,0,0,.3);--sh-2:0 8px 30px rgba(0,0,0,.5),0 0 0 1px rgba(255,255,255,.05);--sh-3:0 24px 64px rgba(0,0,0,.65)}}\r\nbody{font-family:var(--sans);font-size:var(--fs-m);line-height:1.5;-webkit-font-smoothing:antialiased;font-feature-settings:\"cv11\",\"ss01\"}\r\npre,code,.lacts{font-family:var(--mono)}\r\n/* mouvement : animations d'entrée réutilisables par les sections N2 à N8 */\r\n@keyframes u6in{from{opacity:0;transform:translateY(8px) scale(.985)}to{opacity:1;transform:none}}\r\n@keyframes u6fade{from{opacity:0}to{opacity:1}}\r\n@keyframes u6pulse{0%,100%{opacity:1}50%{opacity:.45}}\r\n@keyframes u6shimmer{from{background-position:-200% 0}to{background-position:200% 0}}\r\n.u6-in{animation:u6in var(--t-med) var(--ease) both;animation-delay:calc(var(--i,0)*var(--stagger))}\r\n@media (prefers-reduced-motion:reduce){:root{--t-fast:1ms;--t-med:1ms;--t-slow:1ms;--stagger:0ms}.u6-in{animation:none}*{scroll-behavior:auto!important}}\r\n/* ===== N2 : coquille : barre latérale flottante, barre du haut translucide, canvas, transitions de vue ===== */\r\nbody{background:var(--c-bg);gap:0}\r\nbody>aside{margin:var(--s-2) 0 var(--s-2) var(--s-2);height:calc(100vh - var(--s-4));max-height:calc(100vh - var(--s-4));background:var(--c-surface);border:1px solid var(--c-line);border-radius:var(--r-xl);box-shadow:var(--sh-1);transition:box-shadow var(--t-med) var(--ease),border-color var(--t-med) var(--ease)}\r\nbody>aside:hover{box-shadow:var(--sh-2)}\r\nbody>aside.u5-open{margin:0;height:100vh;max-height:100vh;border-radius:0 var(--r-xl) var(--r-xl) 0;box-shadow:var(--sh-3);animation:u6in var(--t-med) var(--ease) both}\r\nbody>main{background:transparent}\r\nbody>main>header{background:color-mix(in srgb,var(--c-bg) 78%,transparent);backdrop-filter:blur(12px) saturate(1.2);-webkit-backdrop-filter:blur(12px) saturate(1.2);border-bottom:1px solid color-mix(in srgb,var(--c-line) 70%,transparent)}\r\nbody>main>#views{background:var(--c-bg)}\r\n#chat.on,#files.on,#set.on,#lib.on{animation:u6in var(--t-slow) var(--ease) both}\r\nbody>aside #plist .acc{transition:background var(--t-fast),transform var(--t-fast) var(--spring)}\r\nbody>aside #plist .acc:hover{transform:scale(1.06)}\r\nbody>aside #plist .acc.on{background:color-mix(in srgb,var(--c-acc) 16%,transparent);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--c-acc) 40%,transparent)}\r\n@media (prefers-reduced-motion:reduce){body>aside.u5-open,#chat.on,#files.on,#set.on,#lib.on{animation:none}}\r\n\r\n/* ===== N3 : composants de base : boutons, champs, interrupteurs, pastilles, cartes, menus ; chaque état (survol, appui, focus) est animé ===== */\r\nbody .btn{display:inline-flex;align-items:center;justify-content:center;gap:var(--s-2);min-height:32px;padding:0 var(--s-4);border:1px solid var(--c-line);border-radius:var(--r-m);background:var(--c-surface);color:var(--c-text);font:600 var(--fs-s)/1 var(--sans);letter-spacing:.005em;cursor:pointer;box-shadow:var(--sh-1);transition:transform var(--t-fast) var(--spring),background var(--t-fast),border-color var(--t-fast),box-shadow var(--t-med) var(--ease),color var(--t-fast)}\r\nbody .btn:hover{border-color:color-mix(in srgb,var(--c-acc) 55%,var(--c-line));box-shadow:0 0 0 3px var(--c-glow),var(--sh-1);transform:translateY(-1px)}\r\nbody .btn:active{transform:translateY(0) scale(.96);box-shadow:var(--sh-1);transition-duration:60ms}\r\nbody .btn:focus-visible{outline:none;box-shadow:0 0 0 2px var(--c-bg),0 0 0 4px var(--c-acc)}\r\nbody .btn[disabled],body .btn:disabled{opacity:.45;cursor:not-allowed;transform:none;box-shadow:none}\r\nbody .btn.pri{background:linear-gradient(135deg,var(--c-acc),color-mix(in srgb,var(--c-acc) 70%,var(--c-acc2)));border-color:transparent;color:var(--c-on-acc);box-shadow:0 4px 14px var(--c-glow)}\r\nbody .btn.pri:hover{box-shadow:0 6px 22px var(--c-glow);filter:brightness(1.06)}\r\nbody .btn.ghost{background:transparent;border-color:transparent;box-shadow:none;color:var(--c-dim)}\r\nbody .btn.ghost:hover{background:var(--c-raised);color:var(--c-text);box-shadow:none;transform:none}\r\nbody .btn.ic-only,body .btn.ico{width:32px;padding:0}\r\nbody .btn .ic,body .btn svg{transition:transform var(--t-med) var(--spring)}\r\nbody .btn:hover .ic,body .btn:hover svg{transform:scale(1.12)}\r\nbody .btn.bad{border-color:var(--c-err);color:var(--c-err)}\r\n/* champs */\r\nbody input:not([type=checkbox]):not([type=radio]):not([type=range]),body select,body textarea{background:var(--c-bg);color:var(--c-text);border:1px solid var(--c-line);border-radius:var(--r-m);padding:8px var(--s-3);font:var(--fs-m)/1.45 var(--sans);transition:border-color var(--t-fast),box-shadow var(--t-med) var(--ease),background var(--t-fast)}\r\nbody input:not([type=checkbox]):not([type=radio]):hover,body select:hover,body textarea:hover{border-color:color-mix(in srgb,var(--c-acc) 35%,var(--c-line))}\r\nbody input:not([type=checkbox]):not([type=radio]):focus,body select:focus,body textarea:focus{outline:none;border-color:var(--c-acc);box-shadow:0 0 0 4px var(--c-glow);background:var(--c-surface)}\r\nbody ::placeholder{color:var(--c-dim);opacity:.8}\r\n/* interrupteurs */\r\nbody input.sw{-webkit-appearance:none;appearance:none;position:relative;flex:none;width:40px;height:24px;margin:0;border-radius:99px;border:1px solid var(--c-line);background:var(--c-raised);cursor:pointer;transition:background var(--t-med) var(--ease),border-color var(--t-med)}\r\nbody input.sw::before{content:\"\";position:absolute;top:2px;left:2px;width:18px;height:18px;border-radius:50%;background:var(--c-surface);box-shadow:0 1px 3px rgba(0,0,0,.35);transition:transform var(--t-med) var(--spring),width var(--t-fast)}\r\nbody input.sw:hover::before{width:21px}\r\nbody input.sw:checked{background:var(--c-acc);border-color:transparent}\r\nbody input.sw:checked::before{transform:translateX(16px)}\r\nbody input.sw:checked:hover::before{transform:translateX(13px)}\r\nbody input.sw:focus-visible{outline:none;box-shadow:0 0 0 2px var(--c-bg),0 0 0 4px var(--c-acc)}\r\n/* pastilles d'état et compteurs */\r\nbody .pill{display:inline-flex;align-items:center;gap:var(--s-1);padding:2px var(--s-2);border-radius:99px;background:color-mix(in srgb,var(--c-acc) 14%,transparent);color:var(--c-text);font:600 11px/1.6 var(--sans)}\r\nbody .dot{border-radius:50%}\r\nbody .dot.live,body .spin{animation:u6pulse 1.4s var(--ease) infinite}\r\n/* cartes et lignes d'options */\r\nbody .card,body .opt{background:var(--c-surface);border:1px solid var(--c-line);border-radius:var(--r-l);box-shadow:var(--sh-1);transition:transform var(--t-med) var(--ease),box-shadow var(--t-med) var(--ease),border-color var(--t-med)}\r\nbody .card:hover{transform:translateY(-2px);box-shadow:var(--sh-2);border-color:color-mix(in srgb,var(--c-acc) 30%,var(--c-line))}\r\nbody .opt{padding:var(--s-3) var(--s-4);gap:var(--s-4)}\r\nbody .opt:hover{border-color:color-mix(in srgb,var(--c-acc) 30%,var(--c-line))}\r\nbody .opt small{color:var(--c-dim)}\r\n/* lignes de clés : boutons toujours alignés, apparition douce des actions au survol */\r\nbody #list .acc{border-radius:var(--r-m);padding:6px var(--s-3);gap:var(--s-2);transition:background var(--t-fast),transform var(--t-fast) var(--spring)}\r\nbody #list .acc:hover{background:var(--c-raised);transform:translateX(2px)}\r\nbody #list .acc.on{background:color-mix(in srgb,var(--c-acc) 14%,transparent)}\r\nbody #list .acc b{opacity:0;transition:opacity var(--t-fast),background var(--t-fast)}\r\nbody #list .acc:hover b{opacity:1}\r\n/* menus */\r\nbody #hmenu{background:var(--c-surface);border:1px solid var(--c-line);border-radius:var(--r-l);box-shadow:var(--sh-3);padding:var(--s-2);transform-origin:top right;animation:u6in var(--t-med) var(--ease) both}\r\nbody #hmenu button{border-radius:var(--r-s);transition:background var(--t-fast),transform var(--t-fast) var(--ease)}\r\nbody #hmenu button:hover{background:var(--c-raised);transform:translateX(2px)}\r\nbody #hmenu button.on{background:color-mix(in srgb,var(--c-acc) 14%,transparent)}\r\n/* barres de défilement fines */\r\nbody *{scrollbar-width:thin;scrollbar-color:color-mix(in srgb,var(--c-dim) 40%,transparent) transparent}\r\n@media (prefers-reduced-motion:reduce){body .btn,body .card,body input.sw::before{transition:none}body .btn:hover,body .card:hover{transform:none}body .dot.live,body .spin{animation:none}}\r\n/* ===== N4 : chat : messages à ressort, curseur vivant, cartes d'actions en cascade, composer animé ===== */\r\n@keyframes u6spring{0%{opacity:0;transform:translateY(14px) scale(.97)}60%{opacity:1;transform:translateY(-2px) scale(1.005)}100%{opacity:1;transform:none}}\r\n@keyframes u6caret{0%,49%{opacity:1}50%,100%{opacity:0}}\r\n@keyframes u6dots{0%,80%,100%{transform:scale(.6);opacity:.4}40%{transform:scale(1);opacity:1}}\r\n#ch-msgs>.m{animation:u6spring var(--t-slow) var(--spring) both}\r\n#ch-msgs>.m.u .b{background:var(--c-acc);color:var(--c-on-acc);border-radius:var(--r-l) var(--r-l) var(--r-s) var(--r-l);box-shadow:var(--sh-1)}\r\n#ch-msgs>.m.a .b{border-radius:var(--r-l);transition:box-shadow var(--t-med) var(--ease)}\r\n#ch-msgs>.m.a:hover .b{box-shadow:var(--sh-1)}\r\n#ch-live .b::after,#ch-msgs .m.live .b::after{content:\"\";display:inline-block;width:2px;height:1.1em;margin-left:2px;vertical-align:text-bottom;background:var(--c-acc);animation:u6caret 1s steps(1) infinite}\r\n#ch-act i,#ch-stat i{animation:u6dots 1.2s var(--ease) infinite}\r\n.lacts .la{animation:u6in var(--t-med) var(--ease) both}\r\n.lacts .la:nth-child(1){animation-delay:0ms}.lacts .la:nth-child(2){animation-delay:40ms}.lacts .la:nth-child(3){animation-delay:80ms}.lacts .la:nth-child(4){animation-delay:120ms}.lacts .la:nth-child(5){animation-delay:160ms}.lacts .la:nth-child(6){animation-delay:200ms}.lacts .la:nth-child(n+7){animation-delay:240ms}\r\n.lacts .la.run>i{animation:u6pulse 1s var(--ease) infinite}\r\n.lacts .la.ok>i{animation:u6spring var(--t-slow) var(--spring) both}\r\n#ch-box{transition:border-color var(--t-fast),box-shadow var(--t-med) var(--ease),transform var(--t-med) var(--spring)}\r\n#ch-box:focus-within{transform:translateY(-2px);box-shadow:var(--sh-2),0 0 0 4px var(--c-glow)}\r\n#ch-send{transition:transform var(--t-fast) var(--spring),filter var(--t-fast),box-shadow var(--t-med)}\r\n#ch-send:hover{transform:translateY(-1px) scale(1.03);box-shadow:0 6px 18px var(--c-glow)}\r\n#ch-send:active{transform:scale(.94)}\r\n#ch-stop:not([hidden]){animation:u6in var(--t-med) var(--spring) both}\r\n#ch-chips>*{animation:u6in var(--t-med) var(--spring) both}\r\n@media (prefers-reduced-motion:reduce){#ch-msgs>.m,.lacts .la,#ch-chips>*,#ch-stop,#ch-box,#ch-send{animation:none!important;transition:none!important}}\r\n/* ===== N5 : palette Ctrl K, menus et dialogues : apparition à ressort, flou d'arrière-plan, lignes en cascade ===== */\r\n@keyframes u6pal{from{opacity:0;transform:translateY(-10px) scale(.97)}to{opacity:1;transform:none}}\r\n@keyframes u6dlg{from{opacity:0;transform:translateY(14px) scale(.96)}60%{opacity:1;transform:translateY(-2px) scale(1.005)}to{opacity:1;transform:none}}\r\n@keyframes u6back{from{opacity:0;backdrop-filter:blur(0)}to{opacity:1;backdrop-filter:blur(8px)}}\r\n#qo:not([hidden]){animation:u6fade var(--t-fast) var(--ease) both;background:color-mix(in srgb,var(--c-bg) 50%,transparent);backdrop-filter:blur(8px) saturate(1.1);-webkit-backdrop-filter:blur(8px) saturate(1.1)}\r\n#qo .qb{border-radius:var(--r-xl);box-shadow:var(--sh-3);animation:u6pal var(--t-med) var(--spring) both}\r\n#qo #qi{font-size:var(--fs-l);padding:var(--s-5) var(--s-5) var(--s-4)}\r\n#qo #ql .qr{line-height:1.45;min-height:32px;align-items:center;border-radius:var(--r-m);transition:background var(--t-fast),transform var(--t-fast) var(--ease);animation:u6in var(--t-med) var(--ease) both}\r\n#qo #ql .qr:nth-child(2){animation-delay:20ms}#qo #ql .qr:nth-child(3){animation-delay:40ms}#qo #ql .qr:nth-child(4){animation-delay:60ms}#qo #ql .qr:nth-child(5){animation-delay:80ms}#qo #ql .qr:nth-child(n+6){animation-delay:100ms}\r\n#qo #ql .qr:hover{transform:translateX(2px)}\r\n#qo #ql .qr.on{background:color-mix(in srgb,var(--c-acc) 14%,transparent);box-shadow:inset 3px 0 0 var(--c-acc)}\r\n#ch-menu,#fmenu,.menu{border-radius:var(--r-l);box-shadow:var(--sh-3);transform-origin:top left;animation:u6pal var(--t-med) var(--spring) both}\r\n#ch-menu button,#fmenu button,.menu button{border-radius:var(--r-s);transition:background var(--t-fast),transform var(--t-fast) var(--ease)}\r\n#ch-menu button:hover,#fmenu button:hover,.menu button:hover{background:var(--c-raised);transform:translateX(2px)}\r\ndialog{border-radius:var(--r-xl);box-shadow:var(--sh-3);border:1px solid var(--c-line)}\r\ndialog[open]{animation:u6dlg var(--t-slow) var(--spring) both}\r\ndialog::backdrop{background:color-mix(in srgb,var(--c-bg) 45%,rgba(0,0,0,.35));backdrop-filter:blur(8px);animation:u6back var(--t-med) var(--ease) both}\r\n#toast{border-radius:var(--r-l);box-shadow:var(--sh-3);transition:opacity var(--t-med) var(--ease),transform var(--t-slow) var(--spring)}\r\n@media (prefers-reduced-motion:reduce){#qo,#qo .qb,#qo #ql .qr,#ch-menu,#fmenu,.menu,dialog[open],dialog::backdrop{animation:none!important}}\r\n/* ===== N6 : Fichiers, Paramètres, Bibliothèque : grilles en cascade, onglets glissants ===== */\r\n#fgrid .fcard{animation:u6in var(--t-med) var(--ease) both;transition:transform var(--t-med) var(--spring),box-shadow var(--t-med) var(--ease),border-color var(--t-fast)}\r\n#fgrid .fcard:nth-child(1){animation-delay:0ms}#fgrid .fcard:nth-child(2){animation-delay:40ms}#fgrid .fcard:nth-child(3){animation-delay:80ms}#fgrid .fcard:nth-child(4){animation-delay:120ms}#fgrid .fcard:nth-child(5){animation-delay:160ms}#fgrid .fcard:nth-child(6){animation-delay:200ms}#fgrid .fcard:nth-child(7){animation-delay:240ms}#fgrid .fcard:nth-child(8){animation-delay:280ms}#fgrid .fcard:nth-child(n+9){animation-delay:320ms}\r\n#fgrid .fcard:hover{transform:translateY(-3px);box-shadow:var(--sh-2);border-color:var(--c-acc)}\r\n#fgrid .fcard:active{transform:scale(.98)}\r\n#fprojs>*,#fselbar>*{animation:u6in var(--t-med) var(--spring) both}\r\n#fempty .big{animation:u6pulse 2.4s var(--ease) infinite}\r\n#set .snav button{position:relative;transition:background var(--t-fast),color var(--t-fast),padding-left var(--t-med) var(--spring)}\r\n#set .snav button:hover{padding-left:calc(var(--s-3) + 3px)}\r\n#set .snav button::before{content:\"\";position:absolute;left:0;top:20%;bottom:20%;width:3px;border-radius:3px;background:var(--c-acc);transform:scaleY(0);transition:transform var(--t-med) var(--spring)}\r\n#set .snav button.on::before{transform:scaleY(1)}\r\n#set .pane.on{animation:u6in var(--t-med) var(--ease) both}\r\n#set .pane.on .card,#set .pane.on .cc-card{animation:u6in var(--t-med) var(--ease) both}\r\n#set .pane.on .card:nth-of-type(2),#set .pane.on .cc-card:nth-of-type(2){animation-delay:40ms}\r\n#set .pane.on .card:nth-of-type(3),#set .pane.on .cc-card:nth-of-type(3){animation-delay:80ms}\r\n#set .pane.on .card:nth-of-type(4),#set .pane.on .cc-card:nth-of-type(4){animation-delay:120ms}\r\n#set .pane.on .card:nth-of-type(n+5),#set .pane.on .cc-card:nth-of-type(n+5){animation-delay:160ms}\r\n#set .card,#p-cc .cc-card{transition:transform var(--t-med) var(--spring),border-color var(--t-fast),box-shadow var(--t-med)}\r\n#set .card:hover,#p-cc .cc-card:hover{transform:translateY(-1px);box-shadow:var(--sh-1)}\r\n@media (prefers-reduced-motion:reduce){#fgrid .fcard,#fprojs>*,#fselbar>*,#fempty .big,#set .pane.on,#set .pane.on .card,#set .pane.on .cc-card,#set .snav button,#set .snav button::before{animation:none!important;transition:none!important}}\r\n/* ===== N7 : accueil de projet et onboarding : aurore, cartes qui lévitent ===== */\r\n@keyframes u6aurora{0%{transform:translate(-6%,-4%) scale(1)}50%{transform:translate(6%,5%) scale(1.15)}100%{transform:translate(-6%,-4%) scale(1)}}\r\n@keyframes u6float{0%,100%{transform:translateY(0)}50%{transform:translateY(-4px)}}\r\n#empty{position:absolute;overflow:hidden;isolation:isolate}\r\n#empty::before,#empty::after{content:\"\";position:absolute;z-index:-1;width:60vmin;height:60vmin;border-radius:50%;filter:blur(70px);opacity:.35;pointer-events:none;animation:u6aurora 14s ease-in-out infinite}\r\n#empty::before{left:10%;top:8%;background:var(--c-acc)}\r\n#empty::after{right:8%;bottom:6%;background:var(--c-acc2);animation-delay:-7s}\r\n#empty h2{animation:u6in var(--t-slow) var(--ease) both}\r\n#empty p{animation:u6in var(--t-slow) var(--ease) 60ms both}\r\n#empty .ebtns{animation:u6in var(--t-slow) var(--ease) 120ms both}\r\n.u5-steps li{animation:u6in var(--t-slow) var(--spring) both;transition:transform var(--t-med) var(--spring),box-shadow var(--t-med),border-color var(--t-fast)}\r\n.u5-steps li:nth-child(1){animation-delay:160ms}.u5-steps li:nth-child(2){animation-delay:220ms}.u5-steps li:nth-child(3){animation-delay:280ms}\r\n.u5-steps li:hover{transform:translateY(-3px);box-shadow:var(--sh-2);border-color:var(--c-acc)}\r\n.u5-steps li::before{transition:background var(--t-fast),color var(--t-fast)}\r\n.u5-steps li:hover::before{background:var(--c-acc);color:var(--c-on-acc)}\r\n.ch-empty h3{animation:u6in var(--t-slow) var(--ease) both}\r\n.u5h-c{animation:u6in var(--t-slow) var(--spring) both,u6float 6s ease-in-out infinite;transition:box-shadow var(--t-med),border-color var(--t-fast)}\r\n.u5h-c:nth-child(2){animation-delay:60ms,1s}.u5h-c:nth-child(3){animation-delay:120ms,2s}.u5h-c:nth-child(4){animation-delay:180ms,3s}\r\n.u5h-c:hover{box-shadow:var(--sh-2);border-color:var(--c-acc)}\r\n.u5h-a .btn{animation:u6in var(--t-slow) var(--spring) 240ms both}\r\n@media (prefers-reduced-motion:reduce){#empty::before,#empty::after,#empty h2,#empty p,#empty .ebtns,.u5-steps li,.ch-empty h3,.u5h-c,.u5h-a .btn{animation:none!important}}\r\n/* ===== N8 : micro-interactions : lueur suivant la souris, anneau de tâches, célébration, shimmer ===== */\r\n.btn,.fcard,.cc-card,#set .card,#ch-box{--mx:50%;--my:50%}\r\n.btn.pri:hover,.fcard:hover,.cc-card:hover{background-image:radial-gradient(120px circle at var(--mx) var(--my),color-mix(in srgb,#fff 22%,transparent),transparent 70%)}\r\n.btn.pri:hover{background-color:var(--c-acc)}\r\n.u6-shimmer{background:linear-gradient(100deg,var(--c-raised) 30%,color-mix(in srgb,var(--c-surface) 70%,transparent) 50%,var(--c-raised) 70%);background-size:200% 100%;animation:u6shimmer 1.4s linear infinite;border-radius:var(--r-s);color:transparent!important}\r\n.u6-ring{--p:0;width:28px;height:28px;border-radius:50%;background:conic-gradient(var(--c-acc) calc(var(--p)*1%),var(--c-line) 0);display:inline-grid;place-items:center;transition:background var(--t-med)}\r\n.u6-ring::after{content:\"\";width:20px;height:20px;border-radius:50%;background:var(--c-surface)}\r\n@keyframes u6burst{0%{opacity:1;transform:translate(0,0) scale(1)}100%{opacity:0;transform:translate(var(--dx),var(--dy)) scale(.3)}}\r\n.u6-spark{position:fixed;z-index:9999;width:8px;height:8px;border-radius:50%;pointer-events:none;background:var(--c-acc);animation:u6burst 800ms var(--ease) forwards}\r\n.u6-spark:nth-child(3n){background:var(--c-acc2)}.u6-spark:nth-child(3n+1){background:var(--c-ok)}\r\n@media (prefers-reduced-motion:reduce){.u6-shimmer,.u6-spark{animation:none!important}}\r\n\r\n/* ===== V4 : barre du haut unique : nom du projet au centre, UN sélecteur d'IA à droite, actions secondaires en icônes avec infobulle ===== */\r\nbody>main>header{display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);align-items:center;gap:var(--s-3)}\r\nbody>main>header strong#title{grid-column:2;justify-content:center;min-width:0}\r\nbody>main>header .hbtns{grid-column:1;grid-row:1;justify-self:start;display:flex;gap:2px}\r\nbody>main>header #hright{grid-column:3;grid-row:1;justify-self:end;display:flex;align-items:center;gap:var(--s-2)}\r\nbody>main>header .hbtns .btn{font-size:0;gap:0;width:32px;min-width:32px;height:32px;padding:0;border-radius:var(--r-m);background:transparent;border-color:transparent;box-shadow:none;color:var(--c-dim)}\r\nbody>main>header .hbtns .btn svg,body>main>header .hbtns .btn .ic{width:17px!important;height:17px!important;font-size:0}\r\nbody>main>header .hbtns .btn:hover{background:var(--c-raised);color:var(--c-text);transform:none;box-shadow:none}\r\nbody:has(#chat.on) #export{display:none}\r\n@media (max-width:900px){body>main>header{grid-template-columns:auto minmax(0,1fr) auto}body>main>header strong#title{justify-content:flex-start}}\r\n/* ===== V5 : rail gauche : projets, Fichiers, Réglages, Thème ; infobulles ; aucune icône en double ===== */\r\nbody>aside .brand>svg{width:22px;height:22px;flex:none}\r\nbody>aside #newproj{display:none!important}\r\nbody>aside #filesbtn,body>aside #gear,body>aside #themebtn{position:relative;width:100%;min-height:36px;display:grid;place-items:center;padding:0;border-radius:var(--r-m);color:var(--c-dim)}\r\nbody>aside #filesbtn:hover,body>aside #gear:hover,body>aside #themebtn:hover{background:var(--c-raised);color:var(--c-text)}\r\nbody>aside .foot{border-top:1px solid var(--c-line);padding-top:var(--s-2);margin-top:auto}\r\nbody>aside #keystog{display:none}\r\nbody>aside #filesbtn[data-ic]::before,body>aside #gear[data-ic]::before{margin:0}\r\nbody>aside #filesbtn::after,body>aside #gear::after,body>aside #themebtn::after,body>aside .brand::after{position:absolute;left:calc(100% + var(--s-2));top:50%;transform:translateY(-50%) translateX(-4px);padding:4px var(--s-2);border-radius:var(--r-s);background:var(--c-text);color:var(--c-bg);font:500 12px var(--sans);white-space:nowrap;opacity:0;pointer-events:none;transition:opacity var(--t-fast),transform var(--t-fast) var(--ease);z-index:200}\r\nbody>aside .brand{position:relative}\r\nbody>aside .brand::after{content:\"Ouvrir le menu (Ctrl B)\"}\r\nbody>aside #filesbtn::after{content:\"Fichiers\"}\r\nbody>aside #gear::after{content:\"Paramètres\"}\r\nbody>aside #themebtn::after{content:\"Thème clair / sombre\"}\r\nbody>aside #filesbtn:hover::after,body>aside #gear:hover::after,body>aside #themebtn:hover::after,body>aside .brand:hover::after{opacity:1;transform:translateY(-50%)}\r\nbody>aside.u5-open #filesbtn,body>aside.u5-open #gear,body>aside.u5-open #themebtn{display:flex;justify-content:flex-start;padding:0 var(--s-3);gap:var(--s-2)}\r\nbody>aside.u5-open #filesbtn::after,body>aside.u5-open #gear::after,body>aside.u5-open #themebtn::after,body>aside.u5-open .brand::after{display:none}\r\nbody>aside.u5-open #keystog{display:flex}\r\n/* V10 : dans le bandeau réduit, les icônes Modifier / Supprimer d'un projet ne s'affichent plus au survol (elles interceptaient le clic) ; elles restent dans le rail déployé */\r\nbody>aside:not(.u5-open) #plist .acc b,body>aside:not(.u5-open) #plist .acc:hover b{display:none!important}\r\n/* V12 : le bandeau est déjà réduit : « Replier » (aside.min) ne doit plus cacher la liste des projets */\r\nbody>aside.min:not(.u5-open) #plist{display:block!important}\r\nbody>aside.min:not(.u5-open) #plist .acc{display:flex!important}\r\n\r\n/* ===== V6 : chat : lignes d'activité sobres, pied « Changements / Annuler ce tour » lisible, états vides calmes ===== */\r\n.lacts{display:flex;flex-direction:column;gap:2px;margin-top:var(--s-3);padding:0;border:0;background:transparent;font:12.5px/1.5 var(--mono)}\r\n.lacts .la{display:flex;align-items:center;gap:var(--s-2);padding:3px 0;border:0;background:transparent;color:var(--c-dim)}\r\n.lacts .la>i{flex:none;width:14px;text-align:center;font-style:normal;font-weight:700;color:var(--c-ok)}\r\n.lacts .la.err>i,.lacts .la.err span{color:var(--c-err)}\r\n.lacts .la.run>i{color:var(--c-acc)}\r\n.lacts .la span{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\r\n.lacts details.la{display:block}\r\n.lacts details.la>summary{display:flex;align-items:center;gap:var(--s-2);cursor:pointer;list-style:none;border-radius:var(--r-s);padding:3px var(--s-1);margin:0 calc(var(--s-1)*-1);transition:background var(--t-fast)}\r\n.lacts details.la>summary:hover{background:var(--c-raised);color:var(--c-text)}\r\n.lacts details.la>pre{margin:var(--s-1) 0 var(--s-2) 22px;padding:var(--s-3);max-height:240px;overflow:auto;white-space:pre-wrap;word-break:break-word;border:1px solid var(--c-line);border-radius:var(--r-m);background:var(--c-raised);color:var(--c-text);font:12px/1.55 var(--mono)}\r\n.lacts .ldfd{margin:2px 0 var(--s-1) 22px}\r\n.lacts .ldfd>summary{color:var(--c-acc);font:600 12px var(--sans);cursor:pointer}\r\n/* pied de tour : ce qui a changé et le bouton pour annuler, clairement séparés du reste */\r\n.lacts .lchg{display:flex;align-items:center;justify-content:space-between;gap:var(--s-3);margin-top:var(--s-3);padding:var(--s-2) var(--s-3);border:1px solid var(--c-line);border-radius:var(--r-m);background:var(--c-surface);color:var(--c-text);font:500 12.5px var(--sans)}\r\n.lacts .lchg>span{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\r\n.lacts .lchg>em{color:var(--c-dim);font-style:normal}\r\n.lacts .lchg .lund{flex:none;border:1px solid var(--c-line);border-radius:99px;background:transparent;color:var(--c-text);padding:3px var(--s-3);font:600 12px var(--sans);cursor:pointer;transition:background var(--t-fast),border-color var(--t-fast),color var(--t-fast)}\r\n.lacts .lchg .lund:hover{border-color:var(--c-err);color:var(--c-err);background:color-mix(in srgb,var(--c-err) 8%,transparent)}\r\n.lacts .ltok{margin-top:var(--s-1);color:var(--c-dim);font:11.5px var(--sans)}\r\n/* chat vide : un seul message calme, centré */\r\n.ch-empty{display:grid;place-items:center;text-align:center;gap:var(--s-2);padding:var(--s-8) var(--s-4);color:var(--c-dim)}\r\n.ch-empty h3{margin:0;color:var(--c-text);font:650 var(--fs-xl)/1.2 var(--sans);letter-spacing:-.02em}\r\n.ch-empty p{margin:0;max-width:46ch;line-height:1.6}\r\n/* ===== V7 : saisie : UNE ligne claire (joindre, mode, texte, envoyer / arrêter / file), sans chevauchement ===== */\r\n#ch-box{display:flex!important;flex-wrap:nowrap;align-items:flex-end;gap:var(--s-1);grid-template-columns:none!important;grid-template-areas:none!important;min-height:0;padding:var(--s-2) var(--s-2) var(--s-2) var(--s-3);border-radius:var(--r-xl)}\r\n#ch-box>*{grid-area:auto!important;flex:none}\r\n#ch-box #ch-att,#ch-box #ch-mode{align-self:flex-end;height:36px;min-height:36px}\r\n#ch-box #ch-att{width:36px;padding:0;display:grid;place-items:center}\r\n#ch-box #ch-mode{max-width:190px;padding:0 var(--s-3);overflow:hidden}\r\n#ch-box #ch-mode .kl{max-width:130px}\r\n#ch-box #ch-in,#ch-box #ch-in:focus,#ch-box #ch-in:focus-visible{flex:1 1 auto;min-width:0;width:auto;min-height:36px;max-height:min(220px,35vh);padding:7px var(--s-2);margin:0;line-height:1.5;align-self:center}\r\n#ch-box #ch-send,#ch-box #ch-stop{align-self:flex-end;height:36px;min-height:36px;padding:0 var(--s-4);white-space:nowrap}\r\n#ch-box #ch-stop:not([hidden])+#ch-send,#ch-box #ch-send:not([hidden]){margin-left:0}\r\n#ch-chips{width:var(--col,min(860px,calc(100% - var(--s-8))))}\r\n@media (max-width:720px){#ch-box #ch-mode .kl{display:none}#ch-box #ch-mode{max-width:44px;padding:0}}\r\n</style>\r\n<style id=\"sb10\">\r\n/* ===== 10.0.2 — BARRE DE CÔTÉ REFAITE : un seul composant (#sb), deux états (data-sb=\"rail\" | \"open\"), un seul bouton (#sbtog), un seul raccourci (Ctrl+B).\r\n   Rail = 48 px d'icônes ; ouverte = 256 px en superposition (jamais de décalage du contenu). Aucune règle des anciennes versions ne s'y applique. ===== */\r\nbody>#sb{grid-column:1;position:relative;z-index:80;min-width:0;min-height:0;display:block}\r\n#sb .sbp{position:absolute;top:8px;bottom:8px;left:8px;width:48px;display:flex;flex-direction:column;gap:4px;padding:8px 6px;overflow:hidden;white-space:nowrap;\r\n  background:var(--c-surface);border:1px solid var(--c-line);border-radius:var(--r-xl);box-shadow:none;\r\n  transition:width .22s var(--ease),padding .22s var(--ease),box-shadow .22s var(--ease)}\r\n#sb[data-sb=\"open\"] .sbp{width:256px;padding:8px;box-shadow:var(--sh-3)}\r\nhtml.noanim #sb .sbp{transition:none}\r\n@media (prefers-reduced-motion:reduce){#sb .sbp{transition:none}}\r\n#sb .sbp>*{flex:none;min-width:0}\r\n\r\n/* en-tête : le bouton est TOUJOURS au même endroit ; logo et nom n'apparaissent que ouverte */\r\n#sb .sb-head{display:flex;align-items:center;gap:8px;height:36px}\r\n#sb .sb-tog{width:34px;height:34px;min-height:0;padding:0;margin:0;flex:none;display:grid;place-items:center;border:0;border-radius:var(--r-m);background:transparent;color:var(--c-dim);cursor:pointer;font-size:0;gap:0}\r\n#sb .sb-tog:hover{background:var(--c-raised);color:var(--c-text)}\r\n#sb .sb-tog:focus-visible{outline:2px solid var(--c-acc);outline-offset:1px}\r\n#sb .sb-tog .ic{width:18px;height:18px;margin:0;opacity:1;transition:transform .22s var(--ease)}\r\n#sb[data-sb=\"open\"] .sb-tog .ic{transform:scaleX(-1)}\r\n#sb .sb-logo,#sb .sb-name{display:none}\r\n#sb[data-sb=\"open\"] .sb-logo{display:grid;place-items:center;width:22px;height:22px;color:var(--c-text);flex:none}\r\n#sb .sb-logo svg{width:22px;height:22px}\r\n#sb[data-sb=\"open\"] .sb-name{display:block;font-size:15px;font-weight:650;letter-spacing:-.01em;color:var(--c-text);margin:0}\r\n\r\n/* projets */\r\n#sb .sb-label{display:none;font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--c-dim);padding:10px 8px 2px}\r\n#sb[data-sb=\"open\"] .sb-label{display:block}\r\n#sb #newproj{display:none!important}\r\n#sb #plist{flex:1 1 0;min-height:60px;max-height:none;margin:0;padding:0;overflow-y:auto;overflow-x:hidden;overscroll-behavior:contain;display:flex;flex-direction:column;gap:2px}\r\n#sb #plist .acc{margin:0;transform:none;border-radius:var(--r-m);min-height:36px;transition:background .15s}\r\n#sb #plist .acc:hover{transform:none}\r\n#sb #plist .acc.on{background:color-mix(in srgb,var(--c-acc) 16%,transparent);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--c-acc) 40%,transparent)}\r\n#sb[data-sb=\"rail\"] #plist .acc{justify-content:center;padding:0;gap:0;width:100%}\r\n#sb[data-sb=\"rail\"] #plist .acc .pn,#sb[data-sb=\"rail\"] #plist .acc b,#sb[data-sb=\"rail\"] #plist .acc .spin,#sb[data-sb=\"rail\"] #plist .pempty{display:none!important}\r\n#sb[data-sb=\"open\"] #plist .acc{justify-content:flex-start;padding:6px 10px;gap:9px}\r\n\r\n/* clés (comptes IA) : seulement ouverte */\r\n#sb #keysbox{display:none;flex:0 1 auto;max-height:38%;min-height:0;flex-direction:column;border-top:1px solid var(--c-line);padding-top:8px;margin-top:4px}\r\n#sb[data-sb=\"open\"] #keysbox{display:flex}\r\n#sb #keysbox .keyshead{flex:none}\r\n#sb #keysbody{min-height:0;overflow-y:auto;overscroll-behavior:contain;display:flex;flex-direction:column;gap:6px;padding-top:6px}\r\n#sb #keysbox .keyshead[aria-expanded=\"false\"]+#keysbody{display:none}\r\n#sb #keysbody #add{flex:none}\r\n#sb #keysbox #list{flex:1 1 auto;min-height:0;overflow-y:auto;overflow-x:hidden;overscroll-behavior:contain}\r\n\r\n/* Bibliothèque / Paramètres / Thème */\r\n#sb #filesbtn,#sb #gear,#sb #themebtn{position:relative;width:100%;min-height:36px;margin:0;border-radius:var(--r-m);color:var(--c-dim);display:flex;align-items:center;justify-content:center;gap:0;padding:0;font-size:0;background:transparent;border-color:transparent}\r\n#sb #filesbtn:hover,#sb #gear:hover,#sb #themebtn:hover{background:var(--c-raised);color:var(--c-text)}\r\n#sb #filesbtn.on{background:var(--c-raised);color:var(--c-text)}\r\n#sb #filesbtn .pill{display:none}\r\n#sb .foot{display:flex;flex-direction:column;align-items:center;gap:4px;width:100%;border-top:1px solid var(--c-line);padding-top:8px;margin-top:auto}\r\n#sb[data-sb=\"open\"] #filesbtn,#sb[data-sb=\"open\"] #gear{font-size:14px;gap:8px;justify-content:flex-start;padding:0 12px}\r\n#sb[data-sb=\"open\"] #filesbtn .pill{display:inline-grid;margin-left:auto}\r\n#sb[data-sb=\"open\"] .foot{flex-direction:row}\r\n#sb[data-sb=\"open\"] .foot #gear{flex:1;min-width:0}\r\n#sb[data-sb=\"open\"] .foot #themebtn{width:36px;flex:none}\r\n#sb[data-sb=\"rail\"] .foot #themebtn{width:100%}\r\n/* le glisser-déposer de fichiers part du bord du rail */\r\n#fdrop{left:64px}\r\n#sb #sbnew{display:flex;align-items:center;justify-content:center;gap:0;width:100%;min-height:36px;padding:0;margin:0;border:1px dashed var(--c-line);border-radius:var(--r-m);background:transparent;color:var(--c-dim);cursor:pointer;font:600 13px var(--sans);white-space:nowrap}\r\n#sb #sbnew span{display:none}\r\n#sb[data-sb=\"open\"] #sbnew{justify-content:flex-start;gap:8px;padding:0 12px}\r\n#sb[data-sb=\"open\"] #sbnew span{display:inline}\r\n#sb #sbnew:hover{background:var(--c-raised);color:var(--c-text);border-color:var(--c-acc)}\r\n#sb #sbnew .ic{width:18px;height:18px;flex:none}\r\n/* 10.0.3 : barre de chat stable au survol, anneaux de quota uniformes, titre simple, menu / */\r\n#ch-box #ch-in:hover{min-height:36px;padding:7px var(--s-2);background:transparent;border:0;box-shadow:none}\r\n#ch-box,#ch-box:hover,#ch-box:focus-within{transform:none!important}\r\n#ch-box .btn:hover{transform:none!important}\r\n.acc .qr{width:20px!important;height:20px!important;min-width:20px!important;max-width:20px!important;margin:0 0 0 auto!important;overflow:hidden;transform:none!important}\r\n.acc .qr svg{width:20px!important;height:20px!important}\r\n.acc .qr:hover{transform:none!important}\r\n.u5-ttl{display:flex;justify-content:center;min-width:0;width:min(460px,100%)}\r\n.u5-ttl b{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:600;font-size:13px;color:var(--c-text)}\r\n.slmenu{background:var(--c-surface)!important;border-color:var(--c-line)!important;z-index:200!important}\r\n#ch-key{display:none!important}\r\n/* 10.0.7 : bloc final de la barre de chat (specificite superieure a toutes les regles empilees) */\r\nbody #ch-box{display:flex!important;flex-wrap:nowrap;align-items:flex-end;gap:var(--s-1);grid-template-columns:none!important;grid-template-areas:none!important;min-height:0;transform:none!important}\r\nbody #ch-box:hover,body #ch-box:focus-within{transform:none!important;min-height:0}\r\nbody #ch-box #ch-in,body #ch-box #ch-in:hover,body #ch-box #ch-in:focus{flex:1 1 auto;min-width:0;min-height:36px;max-height:min(220px,35vh);background:transparent;border:0;box-shadow:none}\r\n#hacc .hlim{color:var(--c-warn,#d97706);font-size:12px;font-variant-numeric:tabular-nums;white-space:nowrap}\r\n/* ===== 10.0.8 : animations (CSS seul, aucune logique modifiee ; coupees si Windows demande moins d'animations) ===== */\r\n@keyframes a8in{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}\r\n@keyframes a8pop{from{opacity:0;transform:translateY(6px) scale(.97)}to{opacity:1;transform:none}}\r\n@keyframes a8slide{from{opacity:.3;transform:translateX(-8px)}to{opacity:1;transform:none}}\r\n@keyframes a8pulse{0%,100%{opacity:1}50%{opacity:.45}}\r\n@keyframes a8glow{0%,100%{box-shadow:0 0 0 3px color-mix(in srgb,var(--c-acc,#0f766e) 14%,transparent)}50%{box-shadow:0 0 0 6px color-mix(in srgb,var(--c-acc,#0f766e) 26%,transparent)}}\r\n@keyframes a8check{0%{transform:scale(.4);opacity:0}60%{transform:scale(1.3)}100%{transform:scale(1);opacity:1}}\r\n@keyframes a8ring{0%{box-shadow:0 0 0 0 color-mix(in srgb,var(--c-err,#dc2626) 55%,transparent)}100%{box-shadow:0 0 0 9px transparent}}\r\n@keyframes a8dot{0%,100%{transform:scale(1)}50%{transform:scale(1.35)}}\r\n#files.on,#set.on,#empty>div{animation:a8in .35s ease both}\r\n.u5-steps li{animation:a8in .5s ease both}\r\n.u5-steps li:nth-child(2){animation-delay:.1s}.u5-steps li:nth-child(3){animation-delay:.2s}\r\n.slmenu:not([hidden]){animation:a8pop .16s ease both}\r\n#ch-msgs>.m.a:last-child .b,#ch-msgs>.m.s:last-child{animation:a8in .3s ease both}\r\n#sb[data-sb=\"open\"] #plist .acc{animation:a8slide .28s ease both}\r\n#sb[data-sb=\"open\"] #plist .acc:nth-child(2){animation-delay:.04s}#sb[data-sb=\"open\"] #plist .acc:nth-child(3){animation-delay:.08s}#sb[data-sb=\"open\"] #plist .acc:nth-child(4){animation-delay:.12s}#sb[data-sb=\"open\"] #plist .acc:nth-child(5){animation-delay:.16s}#sb[data-sb=\"open\"] #plist .acc:nth-child(n+6){animation-delay:.2s}\r\n#sb[data-sb=\"open\"] #keysbox,#sb[data-sb=\"open\"] .foot,#sb[data-sb=\"open\"] #sbnew{animation:a8in .3s .06s ease both}\r\n.btn{transition:background .15s,border-color .15s,box-shadow .2s,filter .15s,transform .15s}\r\nbody .btn:active{transform:scale(.96)}\r\n#gear .ic,#themebtn .ic,#reload .ic,#sb #sbnew .ic{transition:transform .35s cubic-bezier(.34,1.56,.64,1)}\r\n#gear:hover .ic{transform:rotate(90deg)}\r\n#themebtn:hover .ic{transform:rotate(25deg) scale(1.12)}\r\n#reload:hover .ic{transform:rotate(180deg)}\r\n#sb #sbnew:hover .ic{transform:rotate(90deg)}\r\n#hacc .hlim{animation:a8pulse 2s ease-in-out infinite}\r\n#ch-box:focus-within{animation:a8glow 2.6s ease-in-out infinite}\r\n#ch-send:not([hidden]):hover{filter:brightness(1.1);box-shadow:0 0 0 4px rgba(127,127,127,.22)}\r\n.la.ok i{animation:a8check .35s ease both}\r\n.qr.e{animation:a8ring 1.6s ease-out infinite}\r\n#list .acc.inuse .dot,#plist .acc .spin{animation:a8dot 1.6s ease-in-out infinite}\r\n.fcard,.cc-card{transition:transform .2s ease,box-shadow .2s ease,border-color .15s}\r\n.fcard:hover,.cc-card:hover{transform:translateY(-2px)}\r\n#tabs .tb{transition:background .15s,color .15s}\r\n#ch-msgs{scroll-behavior:smooth}\r\nhtml.noanim *,html.noanim *::before,html.noanim *::after{animation:none!important}\r\n@media (prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}\r\n#u5dockbtn{display:none!important}\r\n.lacts::before,.lacts:before{content:none!important;display:none!important}\r\n/* ===== 10.0.9 : icones coherentes (trait 1.6, 16px) ===== */\r\nsvg.ic{width:16px;height:16px;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}\r\n/* ===== 10.0.16 : icones de dossiers stables, pas d'animation rejouee a chaque redessin ===== */\r\n#sb[data-sb=\"open\"] #plist .acc{animation:none!important}\r\n#sb #plist .acc .pic{display:grid;place-items:center;width:18px;height:18px;flex:none;line-height:0}\r\n#sb #plist .acc .pic svg{width:16px;height:16px;display:block;flex:none}\r\n</style>\r\n<script>\r\n/* 10.0.2 — barre de côté : UN état (rail | ouverte), UN bouton (#sbtog), UN raccourci (Ctrl+B). Ouverte = superposition ; se ferme toute seule (Échap, clic ailleurs, choix d'un projet / de la bibliothèque / des paramètres). Elle démarre toujours en rail. */\r\n(function(){try{\r\nconst sb=document.getElementById('sb'),tog=document.getElementById('sbtog');if(!sb||!tog)return;\r\nconst isOpen=()=>sb.dataset.sb==='open';\r\ntog.innerHTML='<svg class=\"ic\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3.5\" y=\"4.5\" width=\"17\" height=\"15\" rx=\"2.5\"/><path d=\"M9.5 4.5v15\"/></svg>';\r\nconst set=on=>{on=!!on;if(on===isOpen())return;sb.dataset.sb=on?'open':'rail';tog.setAttribute('aria-expanded',String(on));\r\n  const t=on?'Replier la barre latérale (Ctrl+B)':'Ouvrir la barre latérale (Ctrl+B)';tog.title=t;tog.setAttribute('aria-label',t);\r\n  setTimeout(()=>window.dispatchEvent(new Event('resize')),260)};\r\nsb.dataset.sb='rail';tog.title='Ouvrir la barre latérale (Ctrl+B)';tog.setAttribute('aria-label',tog.title);tog.setAttribute('aria-expanded','false');\r\ntog.addEventListener('click',()=>set(!isOpen()));\r\n// info-bulles du rail (les libellés sont masqués quand elle est réduite)\r\nconst tip=(id,t)=>{const e=document.getElementById(id);if(e&&!e.title)e.title=t};tip('filesbtn','Bibliothèque');tip('gear','Paramètres');tip('themebtn','Thème clair / sombre');\r\ndocument.addEventListener('keydown',e=>{\r\n  if((e.ctrlKey||e.metaKey)&&!e.shiftKey&&!e.altKey&&(e.key==='b'||e.key==='B')){e.preventDefault();set(!isOpen());return}\r\n  if(e.key==='Escape'&&isOpen()&&!document.querySelector('dialog[open]')){set(false)}\r\n});\r\ndocument.addEventListener('mousedown',e=>{if(isOpen()&&!sb.contains(e.target)&&!(e.target.closest&&e.target.closest('#hubtt')))set(false)},true);\r\nsb.addEventListener('click',e=>{if(isOpen()&&e.target.closest('#plist .acc,#filesbtn,#gear')&&!e.target.closest('#plist b'))setTimeout(()=>set(false),0)},true);   // en capture : la liste peut se redessiner avant que le clic remonte\r\nconst nb=document.getElementById('sbnew');if(nb)nb.addEventListener('click',()=>{const b=document.getElementById('newproj');if(b)b.click()});\r\nwindow.sbSet=set;\r\n}catch(x){console.error('barre de côté',x)}})();\r\n</script>\r\n<script>\r\n/* N8 (u6) : lueur qui suit la souris + célébration de fin de tâche ; aucune logique métier, aucun id modifié */\r\n(function(){try{\r\ndocument.addEventListener('pointermove',function(e){var t=e.target&&e.target.closest&&e.target.closest('.btn.pri,.fcard,.cc-card');if(!t)return;var r=t.getBoundingClientRect();t.style.setProperty('--mx',(e.clientX-r.left)+'px');t.style.setProperty('--my',(e.clientY-r.top)+'px')},{passive:true});\r\nif(matchMedia('(prefers-reduced-motion:reduce)').matches)return;\r\nvar seen=0;function burst(){var x=innerWidth/2,y=innerHeight-120;for(var i=0;i<18;i++){var d=document.createElement('i');d.className='u6-spark';var a=Math.PI*(1+Math.random()),v=60+Math.random()*120;d.style.left=x+'px';d.style.top=y+'px';d.style.setProperty('--dx',Math.cos(a)*v+'px');d.style.setProperty('--dy',Math.sin(a)*v+'px');document.body.appendChild(d);setTimeout(function(n){n.remove()},900,d)}}\r\nvar box=document.getElementById('ch-msgs');if(box)new MutationObserver(function(){var n=box.querySelectorAll('.lacts .la.ok').length;var txt=box.lastElementChild&&box.lastElementChild.textContent||'';if(/TOUTES LES TÂCHES SONT FAITES|Agents terminés/.test(txt)&&seen!==-1){seen=-1;burst();setTimeout(function(){seen=0},4000)}}).observe(box,{childList:true,subtree:false});\r\n}catch(e){}})();\r\n</script>\r\n<style id=\"a17\">\r\n:root{--e17:cubic-bezier(.22,1,.36,1)}\r\n@keyframes a17page{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}\r\n@keyframes a17pop{from{opacity:0;transform:translateY(4px) scale(.98)}to{opacity:1;transform:none}}\r\n@keyframes a17fade{from{opacity:0}to{opacity:1}}\r\nbody #ch-box,body #ch-box:hover,body #ch-box:focus-within{transform:none!important;animation:none!important;outline:none!important}\r\nbody #ch-box{transition:border-color 160ms var(--e17),box-shadow 200ms var(--e17)}\r\nbody #ch-box:focus-within{border-color:color-mix(in srgb,var(--c-acc,#0f766e) 70%,var(--c-line,#888))!important;box-shadow:0 0 0 3px color-mix(in srgb,var(--c-acc,#0f766e) 18%,transparent)!important}\r\nbody #ch-in,body #ch-in:focus,body #ch-in:focus-visible{outline:none!important;box-shadow:none!important;border:0!important}\r\n#chat.on,#files.on,#set.on,#lib.on{animation:a17page 220ms var(--e17) both}\r\n.pane.on{animation:a17page 200ms var(--e17) both}\r\ndialog[open]{animation:a17pop 200ms var(--e17) both}\r\ndialog[open]::backdrop{animation:a17fade 200ms ease both}\r\n.slmenu:not([hidden]),#hmenu,.menu,#fmenu{animation:a17pop 160ms var(--e17) both}\r\n#ch-msgs>.m.a:last-child .b,#ch-msgs>.m.s:last-child{animation:a17page 220ms var(--e17) both}\r\nbody .btn{transition:background-color 160ms ease,border-color 160ms ease,box-shadow 200ms ease,transform 160ms var(--e17),filter 160ms ease,color 160ms ease}\r\nbody .btn:active{transform:scale(.97)}\r\n.fcard,.cc-card{transition:transform 200ms var(--e17),box-shadow 200ms ease,border-color 160ms ease}\r\n#hacc .hlim{animation:none}\r\n#fdrop{transition:opacity 180ms ease,transform 220ms var(--e17)}\r\n#fdrop.on{animation:none}\r\n#fdrop .ic{animation:none}\r\n#ch-msgs{scroll-behavior:smooth}\r\n@media (prefers-reduced-motion:reduce){#chat.on,#files.on,#set.on,#lib.on,.pane.on,dialog[open],dialog[open]::backdrop,.slmenu,#hmenu,.menu,#fmenu,#ch-msgs>.m{animation:none!important}}\r\n</style>\r\n<style id=\"f26\">\r\n/* 10.0.26 : fluidité. Bloc final : flous de fond supprimés, transitions de mise en page raccourcies, animations décoratives infinies coupées */\r\ndialog::backdrop,#qo,#fprev,#fdrop,body>header,.u6-bar{backdrop-filter:none!important;-webkit-backdrop-filter:none!important}\r\ndialog[open]::backdrop{animation:a17fade 140ms ease both!important;background:rgba(0,0,0,.5)!important}\r\n#qo{background:rgba(0,0,0,.45)!important}\r\n#ch-msgs{scroll-behavior:auto!important}\r\n#sb .sbp{transition:width .16s var(--ease),padding .16s var(--ease)!important;box-shadow:var(--sh-3);contain:layout style}\r\n#sb[data-sb=\"open\"] .sbp{box-shadow:var(--sh-3)}\r\naside{transition:width .16s var(--ease),padding .16s var(--ease)!important}\r\n.fsearch input{transition:border-color .12s,box-shadow .12s!important}\r\n#empty::before,#empty::after,.u6-aurora{animation:none!important}\r\nbody .btn{transition:background-color 120ms ease,border-color 120ms ease,transform 120ms var(--e17),color 120ms ease!important}\r\n.fcard,.cc-card{transition:transform 140ms var(--e17),border-color 120ms ease!important;contain:layout style}\r\n#chat.on,#files.on,#set.on,#lib.on,.pane.on,dialog[open],.slmenu:not([hidden]),#hmenu,.menu,#fmenu{animation-duration:140ms!important}\r\n#ch-msgs>.m{contain:layout style}\r\nhtml.noanim *,html.noanim *::before,html.noanim *::after{animation:none!important;transition:none!important}\r\n/* 10.0.37 : épuration des Paramètres > Mises à jour */\r\n#lncard,#p-upd details.updet,#p-upd .dev-only{display:none!important}\r\n/* 10.0.38 */\r\n#p-rel details.adv,#p-det .dev-only{display:none!important}\r\n#hubtt{position:fixed;inset:0;z-index:2000}\n#hubtt.dim{background:rgba(0,0,0,.6)}\n#hubtt .tt-hole{position:fixed;border-radius:12px;box-shadow:0 0 0 100vmax rgba(0,0,0,.6);outline:2px solid var(--c-acc,#0f766e);pointer-events:none;transition:left .25s ease,top .25s ease,width .25s ease,height .25s ease}\n#hubtt .tt-hole[hidden]{display:none}\n#hubtt .tt-card{position:fixed;box-sizing:border-box;padding:18px 20px;border-radius:16px;background:var(--c-surface,#fff);color:var(--c-text,#111);border:1px solid var(--c-line,#ddd);box-shadow:0 18px 50px rgba(0,0,0,.4);transition:left .25s ease,top .25s ease}\n#hubtt .tt-step{font-size:11.5px;letter-spacing:.04em;color:var(--c-dim,#777);margin-bottom:8px}\n#hubtt .tt-card h3{margin:0 0 6px;font-size:16px}\n#hubtt .tt-card p{margin:0 0 16px;font-size:13.5px;line-height:1.55;color:var(--c-dim,#666)}\n#hubtt .tt-btns{display:flex;gap:8px;align-items:center}\n#hubtt .tt-sp{flex:1}\n/* ===== 10.0.43 : interrupteurs propres et categories sans survol dans Parametres ===== */\nhtml body input.sw{-webkit-appearance:none;appearance:none;position:relative;flex:none;width:42px;height:24px;margin:0;padding:0;border:0;border-radius:999px;background:var(--c-line2,var(--line2));cursor:pointer;box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--c-text,#888) 22%,transparent);transition:background 140ms ease,box-shadow 140ms ease}\nhtml body input.sw::after{content:none!important}\nhtml body input.sw::before{content:\"\";position:absolute;top:3px;left:3px;width:18px;height:18px;border-radius:50%;background:#fff;box-shadow:0 1px 3px rgba(0,0,0,.35);transform:none;transition:transform 140ms ease}\nhtml body input.sw:hover::before,html body input.sw:active::before{width:18px}\nhtml body input.sw:checked{background:var(--c-acc,var(--acc));box-shadow:none}\nhtml body input.sw:checked::before,html body input.sw:checked:hover::before{transform:translateX(18px)}\nhtml body input.sw:focus-visible{outline:2px solid var(--c-acc,var(--acc));outline-offset:2px}\nhtml body #set .snav button:hover{background:transparent;color:var(--c-dim,var(--dim));padding-left:var(--s-3,12px);transform:none}\nhtml body #set .snav button.on:hover{background:var(--c-surface,var(--sel));color:var(--c-text,var(--txt))}\n/* ===== 10.0.45 : plus aucun survol sur les categories et cartes de Parametres ===== */\nhtml body #set .card:hover,html body #set .cc-card:hover,html body #p-cc .cc-card:hover,html body #set .card.pad:hover{border-color:var(--c-line,var(--line))!important;transform:none!important;box-shadow:var(--sh-1,none)!important;background:var(--c-surface,var(--panel))!important}\nhtml body #set .card,html body #set .cc-card,html body #p-cc .cc-card{transition:none!important}\nhtml body #set .opt:hover,html body #set .card .opt:hover{background:transparent!important;border-color:var(--c-line,var(--line))!important;transform:none!important}\nhtml body #set .snav button:hover,html body #set .snav button:focus{background:transparent;color:var(--c-dim,var(--dim));transform:none;box-shadow:none}\nhtml body #set .snav button.on:hover{background:var(--c-surface,var(--sel));color:var(--c-text,var(--txt))}\nhtml body #set .card::before,html body #set .card::after{background-image:none!important}\n</style>\r\n<script>\r\n/* 10.0.17 : focus du chat au retour de fenetre, #fdrop remis a zero, bouton Signaler un bug */\r\n(function(){try{\r\nvar ci=function(){return document.getElementById('ch-in')};\r\nvar chatOn=function(){var c=document.getElementById('chat');return !!(c&&c.classList.contains('on'))};\r\nvar refocus=function(){if(!chatOn()||document.querySelector('dialog[open]'))return;var i=ci();if(!i||i.disabled)return;\r\nvar ae=document.activeElement;if(ae&&ae!==i&&/^(INPUT|TEXTAREA|SELECT)$/.test(ae.tagName))return;\r\ntry{if(ae&&ae.tagName==='WEBVIEW')ae.blur()}catch(e){}\r\ntry{i.focus({preventScroll:true})}catch(e){}};\r\nwindow.addEventListener('focus',function(){setTimeout(refocus,40)});\r\ndocument.addEventListener('visibilitychange',function(){if(!document.hidden)setTimeout(refocus,40)});\r\nvar ch=document.getElementById('chat');if(ch)new MutationObserver(function(){if(chatOn())setTimeout(refocus,60)}).observe(ch,{attributes:true,attributeFilter:['class']});\r\ndocument.addEventListener('pointerdown',function(e){var t=e.target;if(!t||!t.closest||!t.closest('#ch-box')||t.closest('button'))return;setTimeout(function(){var i=ci();if(i&&document.activeElement!==i)try{i.focus({preventScroll:true})}catch(e){}},0)},true);\r\nvar dz=function(){var d=document.getElementById('fdrop');if(d)d.classList.remove('on')};\r\nwindow.addEventListener('blur',dz);document.addEventListener('dragend',dz,true);document.addEventListener('drop',dz,true);\r\ndocument.addEventListener('dragleave',function(e){if(!e.relatedTarget)dz()},true);\r\nvar cm=document.getElementById('cleanmode'),card=cm&&cm.closest('.card');\r\nif(card&&!document.getElementById('bugrep')){var n=document.createElement('div');n.className='card';\r\nn.innerHTML='<div class=\"opt nc\"><span><b>Signaler un bug</b><small>Ouvre GitHub avec la version et le système déjà remplis.</small></span><button id=\"bugrep\" class=\"btn\" type=\"button\">Signaler</button></div>';\r\ncard.parentNode.insertBefore(n,card.nextSibling);\r\ndocument.getElementById('bugrep').onclick=function(){var b='**Version** : AI Hub 10.0.34\\n**Système** : '+navigator.userAgent+'\\n\\n**Problème**\\n\\n\\n**Étapes pour reproduire**\\n\\n';\r\nvar u='https://github.com/XeroxYTB3/ai_hub/issues/new?title='+encodeURIComponent('[Bug] ')+'&body='+encodeURIComponent(b);\r\ntry{window.open(u,'_blank')}catch(e){location.href=u}}}\r\n}catch(e){console.error('10.0.17',e)}})();\r\n</script>\r\n<script>/* 10.0.38 */(function(){try{const hide=()=>{let dev=false;try{dev=!!(window.hub&&0)}catch{}document.querySelectorAll('#set details>summary').forEach(m=>{const t=(m.textContent||'').trim();if(/^(Modèle du message|API disponible)/.test(t)){const dv=document.getElementById('p-code');if(m.closest('details'))m.closest('details').classList.add('adv')}})};hide();setTimeout(hide,3000)}catch(e){}})();</script>\r\n<script>/* 10.0.40 : didacticiel guidé (les vrais boutons sont surlignés) */\n(function(){try{\nlet seen=false;try{seen=!!localStorage.hubTuto}catch{}\nconst ST=[\n{t:'Bienvenue dans AI Hub',p:'Tous tes comptes IA au même endroit : AI Hub change de compte tout seul quand une limite est atteinte. Visite guidée en quelques étapes.'},\n{s:'#sbtog',t:'La barre latérale',p:'Ce bouton ouvre et ferme la barre latérale (raccourci Ctrl+B). Fermée, elle reste en colonne d’icônes ; ouverte, elle passe par-dessus le contenu.'},\n{s:'#sbnew',sb:1,t:'Nouveau projet',p:'Un projet = un dossier de ton PC. L’IA peut lire ses fichiers, les modifier et vérifier son travail.'},\n{s:'#plist',sb:1,t:'Tes projets',p:'Clique un projet pour ouvrir son chat. Le crayon le renomme, la croix le supprime.'},\n{s:'#keysbox',sb:1,t:'Tes clés (comptes IA)',p:'Une clé = un compte Claude, ChatGPT, Gemini… « Ajouter une clé » et connecte-toi. Le petit cercle montre le quota utilisé de chaque compte.'},\n{s:'#filesbtn',sb:1,t:'La bibliothèque',p:'Les fichiers que tu ajoutes une fois restent disponibles sur tous tes comptes, prêts à être joints à une conversation.'},\n{s:'#gear',sb:1,t:'Les paramètres',p:'Thème, notifications, mode épuré des sites, reprise sur un autre compte, sauvegarde des comptes et mises à jour.'},\n{s:'#themebtn',sb:1,t:'Clair / sombre',p:'Bascule entre le thème clair et le thème sombre.'},\n{s:'#hacc',t:'Le choix de l’IA',p:'En haut à droite : laisse AI Hub choisir (Automatique), impose une plateforme ou un compte précis. Le badge ⏳ indique les comptes en limite et l’heure de retour.'},\n{s:'#ch-box',t:'La barre de message',p:'Écris ta demande ici, Entrée pour envoyer. Le trombone joint un fichier. Tape / pour la liste des réglages (/max, /auto, /web-search, /claude…) : flèches pour choisir, Entrée ou Tab pour valider.'},\n{s:'#ch-stat',t:'Les pastilles d’état',p:'Mode (local ou en ligne), compte utilisé, avancement des tâches, quantité de contexte envoyée et état en cours.'},\n{s:'#ch-new',t:'Nouveau chat',p:'Repart d’une conversation vide dans ce projet. « Copier » à côté copie toute la conversation.'},\n{t:'C’est parti',p:'Tu peux relancer cette visite à tout moment : Paramètres › Général › « Revoir le didacticiel ».'}];\nlet n=0,ov=null,hole=null,card=null,tk=0,lastSb=null;\nconst sleep=ms=>new Promise(r=>setTimeout(r,ms));\nconst ok=e=>{try{const r=e.getBoundingClientRect(),c=getComputedStyle(e);return r.width>4&&r.height>4&&c.visibility!=='hidden'&&c.display!=='none'}catch{return false}};\nconst sbSet=v=>{try{window.sbSet&&window.sbSet(v)}catch{}};\nfunction place(r){\n  const W=Math.min(340,innerWidth-24);card.style.width=W+'px';const h=card.offsetHeight;let x,y;\n  if(!r){x=(innerWidth-W)/2;y=(innerHeight-h)/2}\n  else if(r.right+16+W<=innerWidth-8&&r.left<innerWidth/3){x=r.right+16;y=Math.min(Math.max(12,r.top),innerHeight-h-12)}\n  else if(r.bottom+14+h<=innerHeight-8){x=Math.min(Math.max(12,r.left),innerWidth-W-12);y=r.bottom+14}\n  else{x=Math.min(Math.max(12,r.left),innerWidth-W-12);y=Math.max(12,r.top-h-14)}\n  card.style.left=x+'px';card.style.top=y+'px'}\nfunction draw(){\n  if(!ov)return;const st=ST[n],last=n===ST.length-1;\n  const e=st.s?document.querySelector(st.s):null,r=e&&ok(e)?e.getBoundingClientRect():null;\n  ov.classList.toggle('dim',!r);\n  if(r){hole.hidden=false;hole.style.left=(r.left-6)+'px';hole.style.top=(r.top-6)+'px';hole.style.width=(r.width+12)+'px';hole.style.height=(r.height+12)+'px'}else hole.hidden=true;\n  card.innerHTML='<div class=\"tt-step\">'+(n+1)+' / '+ST.length+'</div><h3>'+st.t+'</h3><p>'+st.p+'</p><div class=\"tt-btns\"><button class=\"btn ghost\" data-t=\"skip\">Passer</button><span class=\"tt-sp\"></span>'+(n?'<button class=\"btn\" data-t=\"prev\">Précédent</button>':'')+'<button class=\"btn pri\" data-t=\"next\">'+(last?'Terminer':'Suivant')+'</button></div>';\n  place(r)}\nasync function go(i,dir){\n  const my=++tk;if(!ov)return;\n  while(i>=0&&i<ST.length){\n    const st=ST[i];\n    if(!st.s){if(lastSb!==false){sbSet(false);lastSb=false}break}\n    const w=!!st.sb;sbSet(w);\n    if(lastSb!==w){lastSb=w;await sleep(320)}else await sleep(30);\n    if(my!==tk)return;\n    const e=document.querySelector(st.s);if(e&&ok(e))break;\n    i+=dir}\n  if(i>=ST.length)return done();\n  if(i<0)i=0;\n  n=i;draw()}\nconst kd=e=>{if(!ov)return;if(e.key==='Escape'){e.preventDefault();done()}else if(e.key==='ArrowRight'){e.preventDefault();n>=ST.length-1?done():go(n+1,1)}else if(e.key==='ArrowLeft'&&n>0){e.preventDefault();go(n-1,-1)}};\nfunction done(){try{localStorage.hubTuto='1'}catch{}tk++;if(ov){ov.remove();ov=null}document.removeEventListener('keydown',kd,true);removeEventListener('resize',draw);sbSet(false);lastSb=null}\nfunction start(){\n  if(ov)return;lastSb=null;ov=document.createElement('div');ov.id='hubtt';\n  hole=document.createElement('div');hole.className='tt-hole';hole.hidden=true;card=document.createElement('div');card.className='tt-card';\n  ov.appendChild(hole);ov.appendChild(card);document.body.appendChild(ov);\n  ov.addEventListener('click',e=>{const b=e.target.closest('[data-t]');if(!b)return;const t=b.dataset.t;\n    if(t==='skip')return done();if(t==='prev'&&n>0)return go(n-1,-1);if(t==='next')return n>=ST.length-1?done():go(n+1,1)});\n  document.addEventListener('keydown',kd,true);addEventListener('resize',draw);\n  n=0;draw()}\nwindow.hubTuto=start;\n{const g=document.getElementById('p-gen');if(g&&!document.getElementById('tutoredo')){g.insertAdjacentHTML('beforeend','<div class=\"line\" style=\"margin-top:14px\"><button class=\"btn\" id=\"tutoredo\" type=\"button\">Revoir le didacticiel</button></div>');document.getElementById('tutoredo').onclick=()=>{sbSet(false);start()}}}\nif(!seen)setTimeout(start,2500);\n}catch(e){}})();</script>\n<script>/* 10.0.42 : contrôle à distance (PC <-> téléphone / autre PC) via PeerJS */\n(function(){try{\nconst LS=(k,d)=>{try{const v=localStorage.getItem(k);return v===null?d:v}catch{return d}};\nconst SS=(k,v)=>{try{localStorage.setItem(k,v)}catch{}};\nconst rnd=n=>{const a=new Uint8Array(n);crypto.getRandomValues(a);return [...a].map(x=>(x%36).toString(36)).join('')};\nlet id=LS('hubRmId',''),key=LS('hubRmKey','');\nif(!/^aihub-[a-z0-9]{10,}$/.test(id)){id='aihub-'+rnd(14);SS('hubRmId',id)}\nif(!/^[a-z0-9]{16,}$/.test(key)){key=rnd(24);SS('hubRmKey',key)}\nconst isOn=()=>LS('hubRmOn','0')==='1',nm=()=>LS('hubRmName','Mon PC'),site=()=>LS('hubRmSite','https://xeroxytb3.github.io/ai_hub/');\nconst H=()=>window.hub260||{},$=i=>document.getElementById(i);\nconst projects=()=>{try{return (typeof settings!=='undefined'&&settings.projects)||[]}catch{return []}};\nlet peer=null,state='désactivé',conns=new Set(),loadP=null,fails=0;\nconst eq=(a,b)=>{if(a.length!==b.length)return false;let r=0;for(let i=0;i<a.length;i++)r|=a.charCodeAt(i)^b.charCodeAt(i);return r===0};\nfunction lib(u,t){if(window[t])return Promise.resolve();return new Promise((res,rej)=>{const s=document.createElement('script');s.src=u;s.onload=res;s.onerror=()=>rej(new Error('bibliothèque indisponible (hors ligne ?)'));document.head.appendChild(s)})}\nconst running=pid=>{const st=$('ch-stop');return !!(st&&!st.hidden&&H().cur&&H().cur()===pid)};\nconst actsTxt=m=>{try{const a=m.acts;if(!Array.isArray(a)||!a.length)return '';return '\\n'+a.slice(0,12).map(x=>'› '+String((x&&(x.t||x.title||x.verb))||'').slice(0,100)).join('\\n')}catch{return ''}};\nfunction plist(){return projects().map(p=>({id:p.id,name:String(p.name||'Projet').slice(0,80),local:!!(p.local||p.mode==='local'),run:running(p.id)}))}\nfunction snap(pid){\n  let ch=H().chat&&H().chat(pid);\n  if(!ch&&H().openProject){try{H().openProject(pid)}catch{}ch=H().chat&&H().chat(pid)}\n  const msgs=((ch&&ch.msgs)||[]).slice(-40).map(m=>({r:m.r==='user'?'user':m.r==='ai'?'ai':'sys',t:(String(m.t||'')+(m.r==='ai'?actsTxt(m):'')).slice(0,6000)}));\n  return {t:'chat',pid,msgs,run:running(pid)}}\nasync function rmSend(pid,text){\n  if(!H().openProject)throw new Error('moteur de projets indisponible');\n  const i=$('ch-in'),prev=i?i.value:'';\n  H().openProject(pid);await new Promise(r=>setTimeout(r,200));\n  i.value=text;i.dispatchEvent(new Event('input',{bubbles:true}));\n  $('ch-send').click();\n  if(prev)setTimeout(()=>{if(!i.value){i.value=prev;i.dispatchEvent(new Event('input',{bubbles:true}))}},400)}\nfunction handle(c,d){\n  if(!d||typeof d.t!=='string')return;\n  if(d.t==='list')return c.send({t:'projects',items:plist()});\n  if(d.t==='open'){if(!projects().some(p=>p.id===d.pid))return c.send({t:'err',m:'Projet introuvable'});c._pid=d.pid;c._sig='';return c.send(snap(d.pid))}\n  if(d.t==='send'){\n    const txt=typeof d.text==='string'?d.text.trim().slice(0,8000):'';\n    if(!txt||!projects().some(p=>p.id===d.pid))return c.send({t:'err',m:'Demande invalide'});\n    return rmSend(d.pid,txt).then(()=>c.send({t:'ack'})).catch(e=>c.send({t:'err',m:String(e&&e.message||e).slice(0,100)}))}\n  if(d.t==='stop'){const b=$('ch-stop');if(b&&!b.hidden&&H().cur&&H().cur()===d.pid)b.click()}}\nfunction onConn(c){\n  let ok=false;const tm=setTimeout(()=>{if(!ok)try{c.close()}catch{}},10000);\n  c.on('data',d=>{try{\n    if(!ok){\n      if(d&&d.t==='auth'&&typeof d.k==='string'&&fails<5&&eq(d.k,key)){ok=true;clearTimeout(tm);conns.add(c);c.send({t:'hello',name:nm()});draw()}\n      else{fails++;setTimeout(()=>{fails=Math.max(0,fails-1)},60000);try{c.send({t:'deny'})}catch{}setTimeout(()=>{try{c.close()}catch{}},300)}\n      return}\n    handle(c,d)}catch{}});\n  c.on('close',()=>{clearTimeout(tm);conns.delete(c);draw()});c.on('error',()=>{conns.delete(c);draw()})}\nsetInterval(()=>{if(!conns.size)return;let pl=null;\n  for(const c of conns){try{\n    if(pl===null)pl=plist();const ps=JSON.stringify(pl);if(c._ps!==ps){c._ps=ps;c.send({t:'projects',items:pl})}\n    if(c._pid){const s=snap(c._pid),sg=s.msgs.length+':'+((s.msgs[s.msgs.length-1]||{}).t||'').length+':'+(s.run?1:0);if(c._sig!==sg){c._sig=sg;c.send(s)}}}catch{}}},1500);\nfunction stopPeer(){conns.forEach(c=>{try{c.close()}catch{}});conns.clear();if(peer){try{peer.destroy()}catch{}peer=null}}\nconst retry=()=>setTimeout(()=>{if(isOn()&&!peer)start()},10000);\nasync function start(){\n  if(peer||!isOn())return;state='connexion…';draw();\n  try{await lib('https://cdnjs.cloudflare.com/ajax/libs/peerjs/1.5.4/peerjs.min.js','Peer')}catch(e){state=e.message;draw();retry();return}\n  peer=new Peer(id,{debug:0});\n  peer.on('open',()=>{state='en ligne';draw()});\n  peer.on('connection',onConn);\n  peer.on('disconnected',()=>{state='reconnexion…';draw();try{peer.reconnect()}catch{}});\n  peer.on('error',e=>{const t=e&&e.type||String(e);state='erreur : '+t;draw();if(t!=='peer-unavailable'){const p=peer;peer=null;try{p.destroy()}catch{}retry()}});\n  peer.on('close',()=>{peer=null;if(isOn())retry()})}\nfunction linkUrl(){return site().replace(/#.*$/,'')+'#pc='+id+'&k='+key+'&n='+encodeURIComponent(nm())}\nlet qrFor='';\nfunction draw(){\n  const st=$('rmst');if(!st)return;\n  st.textContent=isOn()?state+(conns.size?' · '+conns.size+' appareil(s) connecté(s)':''):'désactivé';\n  $('rmon').checked=isOn();const lk=linkUrl();$('rmlink').value=lk;{const rc=$('rmcode');if(rc)rc.value=id+'.'+key}\n  if(isOn()&&window.QRCode&&qrFor!==lk){qrFor=lk;const q=$('rmqr');q.textContent='';try{new QRCode(q,{text:lk,width:150,height:150})}catch{}}\n  $('rmqr').style.display=isOn()?'':'none'}\nconst g=$('p-gen');\nif(g&&!$('rmcard')){\n  g.insertAdjacentHTML('beforeend','<h3>Contrôle à distance</h3><div class=\"card pad\" id=\"rmcard\"><label class=\"opt\"><span><b>Autoriser le contrôle à distance</b><small>Envoie des demandes à tes projets depuis un téléphone ou un autre PC. AI Hub doit rester ouvert sur ce PC. Les commandes système demandent toujours ta confirmation ici.</small></span><input type=\"checkbox\" id=\"rmon\"></label><p class=\"dim\" style=\"margin:10px 0 4px\">État : <span id=\"rmst\"></span></p><div class=\"line\" style=\"margin:8px 0\"><input id=\"rmname\" placeholder=\"Nom de ce PC\" style=\"flex:1\"></div><div class=\"line\" style=\"margin:8px 0\"><input id=\"rmsite\" placeholder=\"Adresse de la page\" style=\"flex:1\"></div><div class=\"line\" style=\"margin:8px 0\"><input id=\"rmlink\" readonly style=\"flex:1\"><button class=\"btn\" id=\"rmcopy\" type=\"button\">Copier</button></div><div class=\"line\" style=\"margin:8px 0\"><input id=\"rmcode\" readonly style=\"flex:1\" title=\"Code à saisir sur la page si tu ne peux pas ouvrir le lien\"><button class=\"btn\" id=\"rmcopy2\" type=\"button\">Copier le code</button></div><div id=\"rmqr\" style=\"margin:10px 0;background:#fff;padding:8px;width:fit-content;border-radius:8px\"></div><p class=\"dim\">Ouvrir le lien sur l’autre appareil l’ajoute tout seul. Ce lien et ce code contiennent le secret : ne le partage qu’avec tes propres appareils.</p><div class=\"line\"><button class=\"btn\" id=\"rmnew\" type=\"button\">Générer un nouveau code</button></div></div>');\n  $('rmname').value=nm();$('rmsite').value=site();\n  $('rmon').onchange=e=>{\n    if(e.target.checked){if(!confirm('Autoriser le contrôle à distance ?\\n\\nTout appareil qui possède ton lien secret pourra envoyer des demandes à tes projets (l’IA peut alors modifier tes fichiers avec sauvegarde). Les commandes système demandent toujours ta confirmation sur ce PC.')){e.target.checked=false;return}SS('hubRmOn','1');lib('https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js','QRCode').then(draw).catch(()=>{});start()}\n    else{SS('hubRmOn','0');stopPeer();state='désactivé'}\n    draw()};\n  $('rmname').onchange=e=>{SS('hubRmName',(e.target.value||'Mon PC').slice(0,40));draw()};\n  $('rmsite').onchange=e=>{const v=(e.target.value||'').trim();if(/^https:\\/\\//.test(v))SS('hubRmSite',v);else e.target.value=site();draw()};\n  $('rmcopy').onclick=()=>{try{navigator.clipboard.writeText($('rmlink').value);if(typeof toast==='function')toast('Lien copié')}catch{$('rmlink').select()}};\n  {const c2=$('rmcopy2');if(c2)c2.onclick=()=>{try{navigator.clipboard.writeText($('rmcode').value);if(typeof toast==='function')toast('Code copié')}catch{$('rmcode').select()}}}\n  $('rmnew').onclick=()=>{if(!confirm('Générer un nouveau code ? Les appareils déjà associés devront rescanner le lien.'))return;key=rnd(24);SS('hubRmKey',key);qrFor='';conns.forEach(c=>{try{c.close()}catch{}});conns.clear();draw()};\n  draw()}\nif(isOn()){setTimeout(()=>{lib('https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js','QRCode').then(draw).catch(()=>{});start()},4000)}\nwindow.hubRemote={start,stop:()=>{SS('hubRmOn','0');stopPeer();state='désactivé';draw()}};\n}catch(e){}})();</script>\n</body></html>\r\n"}}}