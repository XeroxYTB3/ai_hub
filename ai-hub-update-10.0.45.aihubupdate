e', detail: 'dossier protégé en écriture (' + parent + ') : le lanceur reconstruit tourne depuis tes données, sans rien modifier à l\\'installation' };\r\n      const act = env.activeCore && env.activeCore();    // { dir, version } du noyau en cours : il devient le noyau d'origine du nouveau lanceur\r\n      if (!act || !act.dir) return { state: 'impossible', detail: 'noyau actif introuvable' };\r\n      const coreFiles = {};\r\n      for (const f of ['main-core.js', 'preload.js', 'webview-preload.js', 'index.html']) { try { coreFiles[f] = sha(fs.readFileSync(path.join(act.dir, f))); } catch { return { state: 'impossible', detail: 'noyau actif incomplet : ' + f }; } }\r\n      const old = readJob();\r\n      if (old && old.state === 'running' && old.helperPid && alive(old.helperPid)) return { state: 'running', detail: 'remplacement en cours' };   // (un assistant mort en plein travail ne bloque pas la suite)\r\n      const job = { v: 1, version: c.version, parentPid: process.pid, exe: process.execPath, args: process.argv.slice(1), target: ph.target, asar: ph.asar, stage: dir,\r\n        files: Object.fromEntries(Object.entries(c.files).filter(([r]) => isPayloadRel(r))), coreSrc: act.dir, coreFiles, coreVersion: act.version, userData, relaunch: false, state: 'waiting', createdAt: Date.now() };\r\n      fs.mkdirSync(SW, { recursive: true });\r\n      if (old && old.helperPid && alive(old.helperPid) && old.state === 'waiting') {   // un assistant attend déjà : il attendra cette instance-ci\r\n        job.helperPid = old.helperPid; atomicWrite(JOB(), JSON.stringify(job, null, 1)); log('Remplacement du lanceur déjà en attente (assistant ' + old.helperPid + ')');\r\n        return { state: 'pending', version: c.version, detail: 'sera fait à la fermeture d\\'AI Hub' };\r\n      }\r\n      atomicWrite(JOB(), JSON.stringify(job, null, 1));\r\n      const swapJs = path.join(dir, 'launcher', 'swap.js');\r\n      const child = cp.spawn(process.execPath, [swapJs, JOB()], { detached: true, stdio: 'ignore', windowsHide: true, env: Object.assign({}, process.env, { ELECTRON_RUN_AS_NODE: '1' }) });\r\n      child.on('error', (e) => log('⚠ assistant de remplacement : ' + e.message)); child.unref();\r\n      job.helperPid = child.pid; atomicWrite(JOB(), JSON.stringify(Object.assign(readJob() || job, { helperPid: child.pid }), null, 1));\r\n      log('Remplacement du lanceur de l\\'exe préparé (' + ph.target + ') : il sera fait à la fermeture d\\'AI Hub');\r\n      return { state: 'pending', version: c.version, detail: 'sera fait à la fermeture d\\'AI Hub' };\r\n    } catch (e) { log('⚠ remplacement du lanceur non préparé : ' + e.message); return { state: 'failed', detail: e.message }; }\r\n  }\r\n  // Demande à l'assistant de relancer AI Hub après le remplacement (utilisé quand on redémarre avec un remplacement en attente)\r\n  function relaunchViaSwap() {\r\n    const j = readJob(); if (!j || j.state !== 'waiting' || !j.helperPid || !alive(j.helperPid)) return false;\r\n    j.relaunch = true; atomicWrite(JOB(), JSON.stringify(j, null, 1)); return true;\r\n  }\r\n\r\n  function status() {\r\n    const c = readCurrent(), job = readJob(), res = readSwapResult(), ph = (() => { try { return physicalInfo(); } catch { return {}; } })();\r\n    return { expected: minVersion, payload: c ? { version: c.version, source: c.source, installedAt: c.installedAt, ok: verifyInstalled(c) } : null,\r\n      rebuilding: !!running, lastError, lastResult,\r\n      swap: job ? { state: job.state, version: job.version, target: job.target } : null, swapResult: res,\r\n      physical: { target: ph.target || null, version: ph.version || null, asar: !!ph.asar }, log: mem.slice(-60) };\r\n  }\r\n  function tailLog(n) { try { return fs.readFileSync(LOG, 'utf8').split('\\n').filter(Boolean).slice(-(n || 60)); } catch { return mem.slice(); } }\r\n\r\n  return { rebuild, loadPayload, readCurrent, verifyInstalled, stageSwap, relaunchViaSwap, status, tailLog, findLocalZips, localD