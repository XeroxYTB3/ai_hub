: ' + e.message); }\r\n      }\r\n      if (!chosen && embed) {\r\n        try { chosen = tryBuf('la copie intégrée à la mise à jour', Buffer.from(embed.zipB64, 'base64')); } catch (e) { log('✘ copie intégrée : ' + e.message); tried.push(e.message); }\r\n      }\r\n    }\r\n    if (!chosen) { const err = 'aucun ZIP de lanceur utilisable (' + (tried.slice(-3).join(' ; ') || 'rien trouvé') + ')'; throw new Error(err); }\r\n    const cur = installPayload(chosen, chosen.label);\r\n    log('✔ Lanceur ' + cur.version + ' installé dans ' + payloadDir(cur));\r\n    return { ok: true, version: cur.version, source: chosen.label };\r\n  }\r\n  function rebuild(opts) {\r\n    if (running) return running;\r\n    running = (async () => {\r\n      try { const r = await doRebuild(opts || {}); lastError = null; lastResult = r; emit('done', r); return r; }\r\n      catch (e) { lastError = String(e && e.message || e); log('✘ ' + lastError); const r = { ok: false, error: lastError }; emit('error', r); return r; }\r\n      finally { running = null; }\r\n    })();\r\n    return running;\r\n  }\r\n\r\n  // ---------- remplacement des fichiers du lanceur dans le dossier d'installation ----------\r\n  const JOB = () => path.join(SW, 'job.json'), RES = () => path.join(SW, 'result.json'), LOCK = () => path.join(SW, 'lock');\r\n  function readJob() { try { return JSON.parse(fs.readFileSync(JOB(), 'utf8')); } catch { return null; } }\r\n  function readSwapResult() { try { return JSON.parse(fs.readFileSync(RES(), 'utf8')); } catch { return null; } }\r\n  function physicalInfo() {                                // où et dans quel état est le lanceur « physique » (celui de l'exe)\r\n    const app = env.app;\r\n    let appPath = ''; try { appPath = app.getAppPath(); } catch {}\r\n    const bd = env.bundledDir && env.bundledDir(); const base = bd && path.basename(bd) === 'core' ? path.dirname(bd) : appPath;\r\n    const asar = /\\.asar$/i.test(base || '');\r\n    const target = asar ? path.join(proc