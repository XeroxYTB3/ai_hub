ach = () => {\r\n    if (ctx.launcher.mode !== 'ancien') return false;\r\n    const P = R.loadPayload(); if (!P || cmpV(P.version, want) < 0) return false;\r\n    try { P.boot.upgradeContext(ctx, { app, dir: path.join(P.dir, 'launcher') }); R.log('Lanceur ' + P.version + ' en service (lu depuis les données d\\'AI Hub)'); return true; }\r\n    catch (e) { R.log('⚠ lanceur reconstruit non attaché : ' + e.message); return false; }\r\n  };\r\n  const maintain = () => { if (ctx.launcher.mode === 'virtuel') plan = R.stageSwap(); return plan; };\r\n  const rebuild = async (opts) => { const r = await R.rebuild(opts); if (r && r.ok) { attach(); maintain(); } return r; };\r\n\r\n  try { attach(); if (ctx.launcher.mode !== 'ancien') maintain(); } catch (e) { try { R.log('⚠ ' + e.message); } catch {} }\r\n  try {                                                          // aucun lanceur assez récent (en service ou déjà reconstruit) : reconstruction automatique, sans bloquer le démarrage\r\n    const cur = R.readCurrent(), have = [ctx.launcher.mode !== 'ancien' ? ctx.launcher.version : '0.0.0', cur && R.verifyInstalled(cur) ? cur.version : '0.0.0'].reduce((a, b) => (cmpV(a, b) >= 0 ? a : b));\r\n    if (cmpV(have, want) < 0) app.whenReady().then(() => setTimeout(() => { rebuild({ auto: true }); }, 2500));\r\n  } catch {}\r\n\r\n  ipcMain.handle('launcher:info', () => Object.assign(R.status(), { version: ctx.launcher.version, mode: ctx.launcher.mode, exeVersion: ctx.launcher.exeVersion || (ctx.launcher.mode === 'ancien' ? ctx.launcher.version : null), swapPlan: plan, logFile: path.join(ud(), 'launcher', 'rebuild.log') }));\r\n  ipcMain.handle('launcher:rebuild', () => rebuild({}));\r\n  ipcMain.handle('launcher:pick', async () => {\r\n    const r = await dialog.showOpenDialog(getWin(), { filters: [{ name: 'ZIP du lanceur AI Hub', extensions: ['zip'] }], properties: ['openFile'] });\r\n    if (r.canceled || !r.filePaths[0]) return { ok: false, cancelled: true };\r\n    return rebuild({ file: r.filePaths[0] });\r\n  });\r\n  ipcMain.handle('launcher:restart', () => { ctx.relaunch(); return { ok: true }; });\r\n}\r\n\r\n// </LANCEUR>\r\n\r\n// 4.5.0 : écriture atomique au niveau du module (visible partout, y compris dans les gestionnaires IPC)\r\nfunction atomicWrite(f, data, enc) { const t = f + '.' + process.pid + '.tmp'; try { fs.writeFileSync(t, data, enc); fs.renameSync(t, f); } catch (e) { try { fs.unlinkSync(t); } catch {} fs.writeFileSync(f, data, enc); } }\r\nmodule.exports = function start(ctx0) {\r\nconst ctx = normalizeCtx(ctx0);\r\nlet win;\r\n// (Le dossier de données fixe est défini par le lanceur main.js)\r\nconst ud = () => app.getPath('userData');\r\nconst AIHUB_ICON_B64 = '';\r\nlet _icoPath = null;\r\nfunction aihubIcon() { if (_icoPath !== null) return _icoPath || undefined; try { fs.mkdirSync(ud(), { recursive: true }); const f = path.join(ud(), 'icon.ico'); const buf = Buffer.from(AIHUB_ICON_B64, 'base64'); let ok = false; try { ok = fs.statSync(f).size === buf.length; } catch {} if (!ok) fs.writeFileSync(f, buf); _icoPath = f; } catch { _icoPath = ''; } return _icoPath || undefined; }\r\nconst STATE = () => path.join(ud(), 'ai-hub-state.json');\r\nconst BK = () => path.join(ud(), 'backups');\r\nlet lastBk = 0;\r\n\r\n// Thème enregistré (lu avant d'ouvrir la fenêtre pour éviter un flash blanc/noir au démarrage)\r\nconst BG = { dark: '#121214', light: '#FFFFFF' };\r\nfunction savedTheme() { try { const t = JSON.parse(fs.readFileSync(STATE(), 'utf8')).settings.theme; return ['light', 'dark'].includes(t) ? t : 'system'; } catch { return 'system'; } }\r\nif (process.platform === 'win32') { try { app.setAppUserModelId('com.aihub.app'); } catch {}\r\n  // Windows affiche le nom du raccourci du menu Démarrer qui porte cet identifiant (sinon l'identifiant brut) : on le crée ou le met à jour\r\n  try {\r\n    const lnk = path.join(app.getPath('appData'), 'Microsoft', 'Windows', 'Start Menu', 'Programs', 'AI Hub.lnk');\r\n    const ico = aihubIcon() || path.join(__dirname, 'icon.ico');\r\n    const opt = { target: process.execPath, cwd: path.dirname(process.execPath), appUserModelId: 'com.aihub.app', description: 'AI Hub', icon: fs.existsSync(ico) ? ico : process.execPath, iconIndex: 0 };\r\n    let same = false;\r\n    try { const o = shell.readShortcutLink(lnk); same = o.target === opt.target && o.appUserModelId === opt.appUserModelId && o.icon === opt.icon; } catch {}\r\n    if (!same) shell.writeShortcutLink(lnk, fs.existsSync(lnk) ? 'replace' : 'create', opt);\r\n  } catch {} }   // nécessaire pour les notifications Windows\r\n\r\n// Retire le drapeau « automatisé » de Chromium (une des choses que regarde la page de connexion Google)\r\ntry { app.commandLine.appendSwitch('disable-blink-features', 'AutomationControlled'); } catch {}\r\n\r\n// Les sites ne peuvent pas envoyer leurs propres notifications ni demander la position : AI Hub centralise les notifications\r\nconst DENY = new Set(['notifications', 'geolocation', 'midi', 'midiSysex']);\r\napp.on('session-created', (s) => {\r\n  try {\r\n    s.setPermissionRequestHandler((_wc, perm, cb) => cb(!DENY.has(perm)));\r\n    s.setPermissionCheckHandler((_wc, perm) => !DENY.has(perm));\r\n  } catch {}\r\n});\r\n\r\n// Connexion Google (\"ce navigateur ou cette application ne sont peut-être pas sécurisés\") : on retire toute trace d'Electron\r\n// de l'identité du navigateur, dans les en-têtes réseau (User-Agent + sec-ch-ua) ET dans les fenêtres de connexion (popups).\r\nconst CHROME_FULL = process.versions.chrome || '130.0.0.0', CHROME_MAJOR = CHROME_FULL.split('.')[0];\r\nconst cleanUA = (ua) => String(ua || '').replace(/\\s?Electron\\/\\S+/, '').replace(/\\s?ai-hub\\/\\S+/, '').replace(/\\s?AI Hub\\/\\S+/i, '');\r\n// Client Hints d'un vrai Google Chrome (Electron n'annonce que « Chromium » + « Electron », ce que Google refuse)\r\nconst CH_BRANDS = '\"Chromium\";v=\"' + CHROME_MAJOR + '\", \"Google Chrome\";v=\"' + CHROME_MAJOR + '\", \"Not?A_Brand\";v=\"99\"';\r\nconst CH_FULL = '\"Chromium\";v=\"' + CHROME_FULL + '\", \"Google Chrome\";v=\"' + CHROME_FULL + '\", \"Not?A_Brand\";v=\"99.0.0.0\"';\r\nconst GOOGLE_HOST = /(^|\\.)(google\\.[a-z.]+|gstatic\\.com|googleapis\\.com|googleusercontent\\.com|youtube\\.com)$/i;\r\napp.on('session-created', (s) => {\r\n  try {\r\n    s.setUserAgent(cleanUA(s.getUserAgent()));\r\n    s.webRequest.onBeforeSendHeaders((d, cb) => {\r\n      const h = d.requestHeaders; let host = ''; try { host = new URL(d.url).hostname; } catch {}\r\n      let hasCh = false, hasFull = false;\r\n      for (const k of Object.keys(h)) {\r\n        if (/^user-agent$/i.test(k)) h[k] = cleanUA(h[k]);\r\n        else if (/^sec-ch-ua$/i.test(k)) { h[k] = CH_BRANDS; hasCh = true; }\r\n        else if (/^sec-ch-ua-full-version-list$/i.test(k)) { h[k] = CH_FULL; hasFull = true; }\r\n      }\r\n      if (GOOGLE_HOST.test(host) && /^https:/i.test(d.url)) { if (!hasCh) h['sec-ch-ua'] = CH_BRANDS; if (!hasFull) h['sec-ch-ua-full-version-list'] = CH_FULL; }\r\n      cb({ requestHeaders: h });\r\n    });\r\n  } catch {}\r\n});\r\napp.on('web-contents-created', (_e, wc) => { try { wc.setUserAgent(cleanUA(wc.getUserAgent())); } catch {} });\r\n\r\nfunction create() {\r\n  nativeTheme.themeSource = savedTheme();\r\n  const wa = (() => { try { return screen.getPrimaryDisplay().workArea; } catch { return { x: 0, y: 0, width: 1440, height: 900 }; } })();\r\n  const ww = Math.min(1440, wa.width), wh = Math.min(900, wa.height);   // la fenêtre ne dépasse plus l'écran (barre des tâches)\r\n  // 10.0.1 : UNE SEULE barre en haut (Windows) : la barre de titre native disparaît, l'en-tête de l'app porte réduire / agrandir / fermer\r\n  const TBO_ON = (process.platform === 'win32' || process.env.AIHUB_TBO === '1') && process.env.AIHUB_TBO !== '0';\r\n  const tboColors = () => (nativeTheme.shouldUseDarkColors ? { color: BG.dark, symbolColor: '#e6e6e6' } : { color: BG.light, symbolColor: '#1f1f1f' });\r\n  const TBO_OPTS = () => (TBO_ON ? { titleBarStyle: 'hidden', titleBarOverlay: Object.assign({ height: 40 }, tboColors()) } : {});\r\n  const TBO_CSS = 'main>header{-webkit-app-region:drag;padding-right:calc(100vw - env(titlebar-area-x,0px) - env(titlebar-area-width,100vw))!important}main>header button,main>header input,main>header select,main>header textarea,main>header a,main>header label,main>header [role=button],main>header [contenteditable],main>header .btn,main>header .u5-cmd,main>header #hright{-webkit-app-region:no-drag}';\r\n  win = new BrowserWindow({\r\n    x: wa.x + Math.round((wa.width - ww) / 2), y: wa.y + Math.round((wa.height - wh) / 2), width: ww, height: wh, minWidth: Math.min(900, wa.width), minHeight: Math.min(560, wa.height), backgroundColor: nativeTheme.shouldUseDarkColors ? BG.dark : BG.light, autoHideMenuBar: true, ...TBO_OPTS(),\r\n    icon: aihubIcon(),\r\n    webPreferences: { preload: path.join(__dirname, 'preload.js'), webviewTag: true, contextIsolation: true }\r\n  });\r\n  if (wa.width < 1700 || wa.height < 1000) { try { win.maximize(); } catch {} }\r\n  // 7.0 (V9) : la fenêtre reste dans la zone utile si l'écran ou la barre des tâches change (résolution, barre masquée / déplacée, écran débranché)\r\n  const fitWin = () => { try {\r\n    if (!win || win.isDestroyed() || win.isMaximized() || win.isFullScreen() || win.isMinimized()) return;\r\n    const b = win.getBounds(), w = screen.getDisplayMatching(b).workArea;\r\n    const nw = Math.min(b.width, w.width), nh = Math.min(b.height, w.height);\r\n    const nx = Math.max(w.x, Math.min(b.x, w.x + w.width - nw)), ny = Math.max(w.y, Math.min(b.y, w.y + w.height - nh));\r\n    if (nx !== b.x || ny !== b.y || nw !== b.width || nh !== b.height) win.setBounds({ x: nx, y: ny, width: nw, height: nh });\r\n  } catch {} };\r\n  try { screen.on('display-metrics-changed', fitWin); screen.on('display-removed', fitWin); win.on('unmaximize', () => setTimeout(fitWin, 60)); win.on('moved', fitWin); } catch {}\r\n  try { win.webContents.setWindowOpenHandler(({ url }) => { if (/^https:\\/\\/github\\.com\\//i.test(url)) { try { shell.openExternal(url); } catch {} return { action: 'deny' }; } return { action: 'allow' }; }); } catch {}\r\ntry { win.on('focus', () => { try { win.webContents.focus(); } catch {} }); } catch {}\r\nwin.loadFile(path.join(__dirname, 'index.html'));\r\n  if (TBO_ON) { win.webContents.on('dom-ready', () => { try { win.webContents.insertCSS(TBO_CSS); } catch {} });\n  // 10.0.43 : menu Edition (Ctrl+C/V/X/A/Z dans les champs de texte, la barre de menu reste masquee) + clic droit sur les champs\n  try { Menu.setApplicationMenu(Menu.buildFromTemplate([{ label: 'Edition', submenu: [{ role: 'undo' }, { role: 'redo' }, { type: 'separator' }, { role: 'cut' }, { role: 'copy' }, { role: 'paste' }, { role: 'selectAll' }] }])); } catch {}\n  win.webContents.on('context-menu', (_e, p) => { try { if (!p.isEditable && !p.selectionText) return; Menu.buildFromTemplate([{ role: 'cut', enabled: !!p.isEditable }, { role: 'copy' }, { role: 'paste', enabled: !!p.isEditable }, { type: 'separator' }, { role: 'selectAll' }]).popup({ window: win }); } catch {} }); try { nativeTheme.on('updated', () => { try { if (win && !win.isDestroyed()) win.setTitleBarOverlay(tboColors()); } catch {} }); } catch {} }\r\n  nativeTheme.on('updated', () => { try { win.setBackgroundColor(nativeTheme.shouldUseDarkColors ? BG.dark : BG.light); } catch {} });\r\n  win.webContents.on('render-process-gone', (_e, d) => { ctx.fatal('interface plantée : ' + (d && d.reason)); });\r\n}\r\n\r\n// ---------- 2.4.0 : détection par le réseau + historique local des conversations ----------\r\nconst NET_HOSTS = /(^|\\.)(claude\\.ai|chatgpt\\.com|openai\\.com|gemini\\.google\\.com)$/;\r\nconst COMPLETION = /\\/(completion|backend-api\\/(f\\/)?conversation|StreamGenerate)(\\/|$)/i;\r\napp.on('session-created', (s) => {\r\n  try {\r\n    s.webRequest.onCompleted((d) => {\r\n      try {\r\n        if (!win || win.isDestroyed() || !d.webContentsId) return;\r\n        const u = new URL(d.url);\r\n        if (!NET_HOSTS.test(u.hostname)) return;\r\n        const isComp = d.method === 'POST' && COMPLETION.test(u.pathname);\r\n        const bad = [429, 503, 529].includes(d.statusCode) && (isComp || /\\/(api|backend-api)\\//.test(u.pathname));\r\n        if (!isComp && !bad) return;\r\n        const h = d.responseHeaders || {};\r\n        const pick = (n) => { const k = Object.keys(h).find((x) => x.toLowerCase() === n); return k ? String([].concat(h[k])[0]) : null; };\r\n        let until = 0; const ra = pick('retry-after');\r\n        if (ra) { const n = Number(ra); until = isFinite(n) ? Date.now() + n * 1000 : (Date.parse(ra) || 0); }\r\n        const quota = {};\r\n        for (const k of Object.keys(h)) if (/ratelimit|usage|quota/i.test(k)) quota[k.toLowerCase()] = String([].concat(h[k])[0]).slice(0, 120);\r\n        win.webContents.send('net-event', { wc: d.webContentsId, status: d.statusCode, host: u.hostname, completion: isComp, until, quota, ts: Date.now() });\r\n      } catch {}\r\n    });\r\n  } catch {}\r\n});\r\n\r\n// Historique local : un fichier JSON (300 conversations max), recherche plein texte simple\r\nconst CV = () => path.join(ud(), 'conversations.json');\r\nlet cvCache = null, cvT = null;\r\nconst cvLoad = () => cvCache || (cvCache = (() => { try { const j = JSON.parse(fs.readFileSync(CV(), 'utf8')); return Array.isArray(j) ? j : []; } catch { return []; } })());\r\nconst cvWrite = () => { try { fs.writeFileSync(CV() + '.tmp', JSON.stringify(cvCache || [])); fs.renameSync(CV() + '.tmp', CV()); } catch {} };\r\nconst cvSave = () => { clearTimeout(cvT); cvT = setTimeout(cvWrite, 1500); };\r\napp.on('before-quit', () => { if (cvCache) cvWrite(); });\r\nipcMain.handle('conv:put', (_e, c) => {\r\n  if (!c || !c.key || !c.text) return false;\r\n  const l = cvLoad(), key = String(c.key).slice(0, 300), i = l.findIndex((x) => x.key === key);\r\n  if (i >= 0) l.splice(i, 1);\r\n  l.unshift({ key, acc: c.acc, platform: c.platform, name: c.name, url: String(c.url || '').slice(0, 500), title: String(c.title || '').slice(0, 160), ts: Date.now(), text: String(c.text).slice(-60000) });\r\n  if (l.length > 300) l.length = 300;\r\n  cvSave(); return true;\r\n});\r\nipcMain.handle('conv:search', (_e, q) => {\r\n  const terms = String(q || '').toLowerCase().split(/\\s+/).filter(Boolean).slice(0, 6);\r\n  if (!terms.length) return [];\r\n  const out = [];\r\n  for (const c of cvLoad()) {\r\n    const t = c.text.toLowerCase(), ti = (c.title || '').toLowerCase();\r\n    if (!terms.every((w) => t.includes(w) || ti.includes(w))) continue;\r\n    let score = 0; for (const w of terms) { score += (ti.includes(w) ? 5 : 0) + Math.min(10, t.split(w).length - 1); }\r\n    const p = Math.max(0, t.indexOf(terms[0]) - 60);\r\n    out.push({ score, key: c.key, acc: c.acc, platform: c.platform, name: c.name, url: c.url, title: c.title, ts: c.ts, snip: c.text.slice(p, p + 180).replace(/\\s+/g, ' ') });\r\n  }\r\n  return out.sort((a, b) => b.score - a.score || b.ts - a.ts).slice(0, 20);\r\n});\r\nipcMain.handle('conv:count', () => cvLoad().length);\r\nipcMain.handle('conv:clear', () => { cvCache = []; cvWrite(); return true; });\r\n\r\nipcMain.handle('copy', (_e, t) => clipboard.writeText(t));\r\n\r\n// ---------- 2.6.6 : enregistrement direct d'un fichier dans « Téléchargements » ----------\r\nipcMain.handle('save:file', async (_e, name, b64) => {\r\n  try {\r\n    const dir = app.getPath('downloads');\r\n    let base = String(name || 'fichier').replace(/[\\\\/:*?\"<>|\\u0000-\\u001f]/g, '_').replace(/^\\.+/, '').slice(0, 150) || 'fichier';\r\n    const ext = path.extname(base), stem = base.slice(0, base.length - ext.length);\r\n    let p = path.join(dir, base), n = 1;\r\n    while (fs.existsSync(p) && n < 500) { p = path.join(dir, stem + ' (' + n + ')' + ext); n++; }\r\n    const buf = Buffer.from(String(b64 || ''), 'base64');\r\n    if (buf.length > 500 * 1048576) return { ok: false, err: 'fichier trop gros' };\r\n    fs.writeFileSync(p, buf);\r\n    return { ok: true, path: p, name: path.basename(p) };\r\n  } catch (x) { return { ok: false, err: String((x && x.message) || x) }; }\r\n});\r\nipcMain.handle('show:item', (_e, p) => {\r\n  try { const dir = path.resolve(app.getPath('downloads')), r = path.resolve(String(p || '')); if (r.startsWith(dir + path.sep)) { shell.showItemInFolder(r); return true; } } catch {}\r\n  return false;\r\n});\r\nipcMain.handle('clear', (_e, p) => session.fromPartition(p).clearStorageData());\r\nipcMain.handle('wvpreload', () => pathToFileURL(path.join(__dirname, 'webview-preload.js')).href);\r\n// Notifications Windows : un clic ramène la fenêtre au premier plan et ouvre le compte concerné\r\nconst liveNotifs = new Set();\r\nipcMain.handle('notify', (_e, t, b, accId) => {\r\n  if (!Notification.isSupported()) return { ok: false, error: 'unsupported' };\r\n  try {\r\n    const n = new Notification({ title: String(t || 'AI Hub'), body: String(b || '') });\r\n    liveNotifs.add(n);                                   // garder une référence (sinon le clic peut être perdu)\r\n    n.on('close', () => liveNotifs.delete(n));\r\n    n.on('failed', () => liveNotifs.delete(n));\r\n    n.on('click', () => {\r\n      liveNotifs.delete(n);\r\n      if (!win) return;\r\n      if (win.isMinimized()) win.restore();\r\n      win.show(); win.focus();\r\n      win.webContents.send('notif-click', accId || null);\r\n    });\r\n    n.show();\r\n    return { ok: true };\r\n  } catch (e) { return { ok: false, error: e.message }; }\r\n});\r\n// 2.8.0 : mode local — choix du dossier de travail du projet (le moteur est dans la section 3.0.0, en bas de ce fichier)\r\nipcMain.handle('local:pick', async (_e, cur) => {\r\n  try {\r\n    const r = await dialog.showOpenDialog(win, { title: 'Choisir le dossier de travail (mode local)', defaultPath: cur || undefined, properties: ['openDirectory', 'createDirectory'] });\r\n    if (r.canceled || !r.filePaths || !r.filePaths[0]) return { cancelled: true };\r\n    const p = r.filePaths[0];\r\n    return { ok: true, path: p, name: path.basename(p) || p };\r\n  } catch (x) { return { ok: false, error: String(x && x.message || x) }; }\r\n});\r\nipcMain.handle('local:check', async (_e, p) => { try { return { ok: fs.statSync(String(p || '')).isDirectory() }; } catch { return { ok: false }; } });\r\nipcMain.handle('theme:set', (_e, t) => { nativeTheme.themeSource = ['light', 'dark'].includes(t) ? t : 'system'; return nativeTheme.shouldUseDarkColors; });\r\n\r\n// Export de tous les comptes : liste + cookies de chaque session, chiffré (AES-256-GCM) si mot de passe\r\nipcMain.handle('export', async (_e, { state, partitions, pass }) => {\r\n  const cookies = {};\r\n  for (const p of partitions) cookies[p] = await session.fromPartition(p).cookies.get({});\r\n  const data = JSON.stringify({ app: 'ai-hub', version: app.getVersion(), v: 1, exportedAt: new Date().toISOString(), state, cookies });\r\n  let out = data;\r\n  if (pass) {\r\n    const salt = crypto.randomBytes(16), iv = crypto.randomBytes(12);\r\n    const c = crypto.createCipheriv('aes-256-gcm', crypto.scryptSync(pass, salt, 32), iv);\r\n    const enc = Buffer.concat([c.update(data, 'utf8'), c.final()]);\r\n    out = JSON.stringify({ app: 'ai-hub', version: app.getVersion(), enc: 1, salt: salt.toString('base64'), iv: iv.toString('base64'), tag: c.getAuthTag().toString('base64'), data: enc.toString('base64') });\r\n  }\r\n  const r = await dialog.showSaveDialog(win, { defaultPath: 'ai-hub-comptes-' + new Date().toISOString().slice(0, 10) + '.json' });\r\n  if (r.canceled) return { ok: false };\r\n  fs.writeFileSync(r.filePath, out);\r\n  return { ok: true, path: r.filePath, encrypted: !!pass };\r\n});\r\n\r\nipcMain.handle('import', async (_e, pass) => {\r\n  const r = await dialog.showOpenDialog(win, { filters: [{ name: 'JSON', extensions: ['json'] }], properties: ['openFile'] });\r\n  if (r.canceled) return { ok: false };\r\n  let j = JSON.parse(fs.readFileSync(r.filePaths[0], 'utf8'));\r\n  const ver = j.version;\r\n  if (j.app && j.app !== 'ai-hub') return { ok: false, error: 'Ce fichier ne vient pas de AI Hub' };\r\n  if (j.enc) {\r\n    try {\r\n      const d = crypto.createDecipheriv('aes-256-gcm', crypto.scryptSync(pass || '', Buffer.from(j.salt, 'base64'), 32), Buffer.from(j.iv, 'base64'));\r\n      d.setAuthTag(Buffer.from(j.tag, 'base64'));\r\n      j = JSON.parse(Buffer.concat([d.update(Buffer.from(j.data, 'base64')), d.final()]).toString('utf8'));\r\n    } catch { return { ok: false, error: 'Mot de passe incorrect ou fichier corrompu' }; }\r\n  }\r\n  let n = 0;\r\n  for (const [p, list] of Object.entries(j.cookies || {})) for (const c of list) {\r\n    try {\r\n      const o = { url: `http${c.secure ? 's' : ''}://${c.domain.replace(/^\\./, '')}${c.path}`, name: c.name, value: c.value, path: c.path, secure: c.secure, httpOnly: c.httpOnly, sameSite: c.sameSite, expirationDate: c.expirationDate };\r\n      if (!c.hostOnly) o.domain = c.domain;\r\n      await session.fromPartition(p).cookies.set(o); n++;\r\n    } catch {}\r\n  }\r\n  return { ok: true, state: j.state, cookies: n, version: ver || j.version, current: app.getVersion() };\r\n});\r\n\r\n// Sauvegarde de l'état (comptes, code, détections) dans un fichier avec copies de secours\r\nconst count = (s) => { try { return (JSON.parse(s).accs || []).length; } catch { return -1; } };\r\nipcMain.handle('state:load', () => {\r\n  const files = [STATE()];\r\n  try { files.push(...fs.readdirSync(BK()).sort().reverse().map((f) => path.join(BK(), f))); } catch {}\r\n  for (const f of files) { try { return JSON.parse(fs.readFileSync(f, 'utf8')); } catch {} }\r\n  return null;\r\n});\r\nipcMain.handle('state:save', (_e, json) => {\r\n  fs.mkdirSync(BK(), { recursive: true });\r\n  try {\r\n    const old = fs.readFileSync(STATE(), 'utf8');\r\n    if (old !== json && (count(json) < count(old) || Date.now() - lastBk > 60000)) {\r\n      fs.writeFileSync(path.join(BK(), 'state-' + new Date().toISOString().replace(/[:.]/g, '-') + '.json'), old); lastBk = Date.now();\r\n      fs.readdirSync(BK()).sort().reverse().slice(40).forEach((f) => fs.unlinkSync(path.join(BK(), f)));\r\n    }\r\n  } catch {}\r\n  fs.writeFileSync(STATE() + '.tmp', json); fs.renameSync(STATE() + '.tmp', STATE());\r\n  return true;\r\n});\r\n// Sessions qui existent sur le disque mais ne sont plus dans la liste des comptes\r\nipcMain.handle('orphans', async (_e, known) => {\r\n  let names = []; try { names = fs.readdirSync(path.join(ud(), 'Partitions')); } catch {}\r\n  const out = [];\r\n  for (const n of names) {\r\n    if (!/^a\\d+$/.test(n) || known.includes(n)) continue;\r\n    const ck = await session.fromPartition('persist:' + n).cookies.get({});\r\n    if (ck.length) out.push({ id: n, domains: [...new Set(ck.map((c) => c.domain.replace(/^\\./, '')))] });\r\n  }\r\n  return out;\r\n});\r\nipcMain.handle('open-data', () => shell.openPath(ud()));\r\n\r\n\r\n// ---------- Résumé par Gemini (appel fait ici, dans le processus principal : pas de souci CORS) ----------\r\nipcMain.handle('gemini', async (_e, { key, model, system, prompt }) => {\r\n  if (!key) return { ok: false, error: 'Clé Gemini absente' };\r\n  const m = String(model || 'gemini-flash-latest').replace(/[^\\w.\\-]/g, '');\r\n  const ac = new AbortController(), to = setTimeout(() => ac.abort(), 90000);\r\n  try {\r\n    const r = await fetch((process.env.AIHUB_GEMINI_URL || 'https://generativelanguage.googleapis.com/v1beta/models/') + m + ':generateContent', {\r\n      method: 'POST', signal: ac.signal, headers: { 'Content-Type': 'application/json', 'x-goog-api-key': key },\r\n      body: JSON.stringify({ systemInstruction: system ? { parts: [{ text: system }] } : undefined, contents: [{ role: 'user', parts: [{ text: prompt }] }], generationConfig: { temperature: 0.2, maxOutputTokens: 8192 } })\r\n    });\r\n    const j = await r.json().catch(() => null);\r\n    if (!r.ok) return { ok: false, status: r.status, error: (j && j.error && j.error.message) || 'HTTP ' + r.status };\r\n    const c = j && j.candidates && j.candidates[0];\r\n    const text = ((c && c.content && c.content.parts) || []).map((p) => p.text || '').join('').trim();\r\n    if (!text) return { ok: false, error: 'Réponse vide (' + ((c && c.finishReason) || (j && j.promptFeedback && j.promptFeedback.blockReason) || '?') + ')' };\r\n    return { ok: true, text };\r\n  } catch (e) { return { ok: false, error: e.name === 'AbortError' ? 'Délai dépassé (90 s)' : e.message }; }\r\n  finally { clearTimeout(to); }\r\n});\r\n\r\n// ---------- Mises à jour (la logique est dans updater.js, testée à part) ----------\r\nconst backupState = (ver) => {                       // copie des données AVANT d'installer : on ne perd rien\r\n  try { fs.mkdirSync(BK(), { recursive: true }); fs.copyFileSync(STATE(), path.join(BK(), 'state-' + new Date().toISOString().replace(/[:.]/g, '-') + '-avant-maj-' + ver + '.json')); } catch {}\r\n};\r\nipcMain.handle('upd:info', () => Object.assign(ctx.updater.info(), { active: ctx.boot.version, rolledBack: ctx.boot.rolledBack, dataDir: ud(), launcher: ctx.launcher || null }));\r\nipcMain.handle('upd:apply', async () => {\r\n  const r = await dialog.showOpenDialog(win, { filters: [{ name: 'Mise à jour AI Hub', extensions: ['aihubupdate', 'json'] }], properties: ['openFile'] });\r\n  if (r.canceled) return { ok: false, cancelled: true };\r\n  try { return ctx.updater.install(ctx.updater.readPackage(r.filePaths[0]), { beforeInstall: backupState }); }\r\n  catch (e) { return { ok: false, error: 'Fichier illisible : ' + e.message }; }\r\n});\r\nipcMain.handle('upd:revert', (_e, to) => ctx.updater.revert(to));\r\nipcMain.handle('upd:healthy', () => ctx.updater.confirm());\r\n// ===== 4.1.0 : mise à jour depuis le dépôt GitHub (même source et même logique que l'installeur) =====\r\n// Le paquet le plus récent à la racine de github.com/XeroxYTB3/ai_hub est téléchargé, vérifié (sha256), puis installé par le lanceur\r\n// exactement comme un fichier choisi à la main (copie de sauvegarde avant, retour arrière automatique si le démarrage échoue).\r\nconst GH = { owner: 'XeroxYTB3', repo: 'ai_hub', setup: 'AI-Hub-Setup.exe' };\r\nconst GH_RAW = (name) => 'https://raw.githubusercontent.com/' + GH.owner + '/' + GH.repo + '/HEAD/' + encodeURIComponent(name);\r\nconst PKG_RE = /^ai-hub-update-(\\d+)[._](\\d+)[._](\\d+)\\.aihubupdate$/i;        // accepte 4_0_0 comme 3.9.0 (les deux existent dans le dépôt)\r\nconst verCmp = (a, b) => { for (let i = 0; i < 3; i++) if (a[i] !== b[i]) return a[i] > b[i] ? 1 : -1; return 0; };\r\nconst verOf = (s) => { const m = /(\\d+)[._](\\d+)[._](\\d+)/.exec(String(s || '')); return m ? [+m[1], +m[2], +m[3]] : null; };\r\nfunction pickLatest(names) {\r\n  let best = null;\r\n  for (const n of names) { const m = PKG_RE.exec(String(n)); if (!m) continue; const v = [+m[1], +m[2], +m[3]]; if (!best || verCmp(v, best.v) > 0) best = { name: String(n), v, version: v.join('.') }; }\r\n  return best;\r\n}\r\nasync function ghGet(url, ms, asBuf) {\r\n  const ac = new AbortController(), to = setTimeout(() => ac.abort(), ms || 20000);\r\n  try {\r\n    const r = await fetch(url, { signal: ac.signal, redirect: 'follow', headers: { 'User-Agent': 'AI-Hub-Updater', 'Accept': 'application/vnd.github+json, */*' } });\r\n    if (!r.ok) { const e = new Error('HTTP ' + r.status); e.status = r.status; throw e; }\r\n    return asBuf ? Buffer.from(await r.arrayBuffer()) : await r.text();\r\n  } catch (e) { if (e.name === 'AbortError') throw new Error('délai dépassé'); throw e; }\r\n  finally { clearTimeout(to); }\r\n}\r\nasync function ghLatest() {                                   // { name, version, v, hasSetup }\r\n  let names = [], setup = false, lastErr = '';\r\n  try { const j = JSON.parse(await ghGet('https://api.github.com/repos/' + GH.owner + '/' + GH.repo + '/contents/', 15000));\r\n    if (Array.isArray(j)) { names = j.filter((f) => f && f.type === 'file').map((f) => f.name); setup = names.includes(GH.setup); } }\r\n  catch (e) { lastErr = e.message; }\r\n  if (!pickLatest(names)) {                                    // repli : la page du dépôt (si l'API GitHub est limitée ou bloquée)\r\n    try { const h = await ghGet('https://github.com/' + GH.owner + '/' + GH.repo, 15000);\r\n      names = [...new Set(h.match(/ai-hub-update-\\d+[._]\\d+[._]\\d+\\.aihubupdate/gi) || [])]; setup = setup || h.includes(GH.setup); }\r\n    catch (e) { lastErr = lastErr || e.message; }\r\n  }\r\n  const best = pickLatest(names);\r\n  if (!best) throw new Error(lastErr ? 'dépôt injoignable (' + lastErr + ')' : 'aucune mise à jour trouvée dans le dépôt');\r\n  best.hasSetup = setup; return best;\r\n}\r\nconst curVersion = () => { let i = {}; try { i = ctx.updater.info() || {}; } catch {} return verOf(i.current) || verOf(ctx.boot && ctx.boot.version) || verOf(i.launcherVersion) || [0, 0, 0]; };\r\nasync function ghPackage(name) {                               // télécharge + vérifie, écrit dans un fichier temporaire\r\n  const txt = await ghGet(GH_RAW(name), 90000);\r\n  let pkg; try { pkg = JSON.parse(txt); } catch { throw new Error('paquet illisible'); }\r\n  if (!pkg || pkg.app !== 'ai-hub-update' || !pkg.files) throw new Error('ce n\\'est pas un paquet AI Hub');\r\n  const core = ['main-core.js', 'preload.js', 'webview-preload.js', 'index.html'];\r\n  for (const f of core) { const e = pkg.files[f]; if (!e || typeof e.content !== 'string') throw new Error('paquet incomplet (' + f + ')');\r\n    if (e.sha256 && crypto.createHash('sha256').update(e.content, 'utf8').digest('hex') !== e.sha256) throw new Error('téléchargement corrompu (' + f + ')'); }\r\n  const file = path.join(app.getPath('temp'), 'ai-hub-' + name);\r\n  fs.writeFileSync(file, txt, 'utf8'); return file;\r\n}\r\nipcMain.handle('upd:check', async () => {\r\n  try { const l = await ghLatest(), cur = curVersion();\r\n    return { ok: true, current: cur.join('.'), latest: l.version, name: l.name, newer: verCmp(l.v, cur) > 0, hasSetup: !!l.hasSetup, repo: GH.owner + '/' + GH.repo };\r\n  } catch (e) { return { ok: false, error: String(e && e.message || e) }; }\r\n});\r\nipcMain.handle('upd:fetch', async () => {                      // le nom du paquet n'est jamais fourni par la page : on le relit dans le dépôt\r\n  let file = null;\r\n  try { const l = await ghLatest(), cur = curVersion();\r\n    if (verCmp(l.v, cur) <= 0) return { ok: true, uptodate: true, version: cur.join('.') };\r\n    file = await ghPackage(l.name);\r\n    const r = ctx.updater.install(ctx.updater.readPackage(file), { beforeInstall: backupState });\r\n    if (r && r.ok === false) return Object.assign({ launcherTooOld: /lanceur/i.test(String(r.error || '')) }, r);\r\n    return r;\r\n  } catch (e) { return { ok: false, error: String(e && e.message || e) }; }\r\n  finally { try { if (file) fs.unlinkSync(file); } catch {} }\r\n});\r\nipcMain.handle('upd:setup', async () => {                      // dernier recours : relance l'installeur du dépôt (comptes, scripts et réglages restent dans le dossier de données)\r\n  try { const buf = await ghGet(GH_RAW(GH.setup), 120000, true);\r\n    if (buf.length < 100000 || buf[0] !== 0x4d || buf[1] !== 0x5a) throw new Error('installeur invalide');\r\n    const file = path.join(app.getPath('temp'), 'AI-Hub-Setup.exe'); fs.writeFileSync(file, buf);\r\n    const err = await shell.openPath(file); if (err) throw new Error(err);\r\n    setTimeout(() => { try { app.quit(); } catch {} }, 1500);\r\n    return { ok: true };\r\n  } catch (e) { return { ok: false, error: String(e && e.message || e) }; }\r\n});\r\nipcMain.handle('upd:fail', (_e, reason) => ctx.fatal('interface : ' + String(reason).slice(0, 200)));\r\nipcMain.handle('relaunch', () => { ctx.relaunch(); });\r\n// ---------- 2.5.4 : export du logiciel complet en ZIP (mode développeur) ----------\r\n// <PACK>\r\nconst zlib = require('zlib');\r\nconst CRC_T = (() => { const t = new Uint32Array(256); for (let n = 0; n < 256; n++) { let c = n; for (let k = 0; k < 8; k++) c = c & 1 ? 0xEDB88320 ^ (c >>> 1) : c >>> 1; t[n] = c >>> 0; } return t; })();\r\nconst crc32 = (b) => { let c = 0xFFFFFFFF; for (let i = 0; i < b.length; i++) c = CRC_T[(c ^ b[i]) & 255] ^ (c >>> 8); return (c ^ 0xFFFFFFFF) >>> 0; };\r\nfunction makeZip(entries) {                       // entries : [{ name, data: Buffer, mtime: Date }]\r\n  const parts = [], central = []; let off = 0;\r\n  for (const e of entries) {\r\n    const name = Buffer.from(e.name, 'utf8'), raw = e.data, def = zlib.deflateRawSync(raw), useDef = def.length < raw.length;\r\n    const body = useDef ? def : raw, method = useDef ? 8 : 0, crc = crc32(raw), d = e.mtime || new Date();\r\n    const dt = (((d.getFullYear() - 1980) << 9) | ((d.getMonth() + 1) << 5) | d.getDate()) & 0xFFFF, tm = ((d.getHours() << 11) | (d.getMinutes() << 5) | (d.getSeconds() >> 1)) & 0xFFFF;\r\n    const lh = Buffer.alloc(30);\r\n    lh.writeUInt32LE(0x04034b50, 0); lh.writeUInt16LE(20, 4); lh.writeUInt16LE(0x0800, 6); lh.writeUInt16LE(method, 8); lh.writeUInt16LE(tm, 10); lh.writeUInt16LE(dt, 12);\r\n    lh.writeUInt32LE(crc, 14); lh.writeUInt32LE(body.length, 18); lh.writeUInt32LE(raw.length, 22); lh.writeUInt16LE(name.length, 26);\r\n    parts.push(lh, name, body);\r\n    const ch = Buffer.alloc(46);\r\n    ch.writeUInt32LE(0x02014b50, 0); ch.writeUInt16LE(20, 4); ch.writeUInt16LE(20, 6); ch.writeUInt16LE(0x0800, 8); ch.writeUInt16LE(method, 10); ch.writeUInt16LE(tm, 12); ch.writeUInt16LE(dt, 14);\r\n    ch.writeUInt32LE(crc, 16); ch.writeUInt32LE(body.length, 20); ch.writeUInt32LE(raw.length, 24); ch.writeUInt16LE(name.length, 28); ch.writeUInt32LE(off, 42);\r\n    central.push(ch, name);\r\n    off += 30 + name.length + body.length;\r\n  }\r\n  const cd = Buffer.concat(central), end = Buffer.alloc(22);\r\n  end.writeUInt32LE(0x06054b50, 0); end.writeUInt16LE(entries.length, 8); end.writeUInt16LE(entries.length, 10); end.writeUInt32LE(cd.length, 12); end.writeUInt32LE(off, 16);\r\n  return Buffer.concat([...parts, cd, end]);\r\n}\r\nconst PACK_SKIP = /^(node_modules|\\.git|dist|out|release)$/i;\r\nfunction packWalk(root, rel, map, lim) {\r\n  let names; try { names = fs.readdirSync(path.join(root, rel)); } catch { return; }\r\n  for (const n of names) {\r\n    const r = rel ? rel + '/' + n : n, full = path.join(root, r);\r\n    let st; try { st = fs.statSync(full); } catch { continue; }\r\n    if (st.isDirectory()) { if (!PACK_SKIP.test(n)) packWalk(root, r, map, lim); continue; }\r\n    if (!st.isFile() || st.size > 40 * 1048576) continue;\r\n    if (lim.n >= 5000 || lim.bytes + st.size > 300 * 1048576) throw new Error('logiciel trop gros pour le ZIP (plus de 5000 fichiers ou 300 Mo)');\r\n    map.set(r, { name: r, data: fs.readFileSync(full), mtime: st.mtime }); lim.n++; lim.bytes += st.size;\r\n  }\r\n}\r\nfunction packApp(ver, appRoot, activeDir) {\r\n  const map = new Map(), lim = { n: 0, bytes: 0 };\r\n  packWalk(appRoot, '', map, lim);                                                  // lanceur + fichiers d'origine\r\n  if (path.resolve(activeDir) !== path.resolve(appRoot)) packWalk(activeDir, '', map, lim);   // version active : remplace les fichiers du même nom\r\n  const core = ['main-core.js', 'preload.js', 'webview-preload.js', 'index.html'];\r\n  if (core.every((f) => map.has(f))) {                                              // paquet de mise à jour prêt à réinstaller\r\n    const files = {};\r\n    for (const f of core) { const c = map.get(f).data.toString('utf8'); files[f] = { sha256: crypto.createHash('sha256').update(c, 'utf8').digest('hex'), content: c }; }\r\n    map.set('ai-hub-update-' + ver + '.aihubupdate', { name: 'ai-hub-update-' + ver + '.aihubupdate', data: Buffer.from(JSON.stringify({ app: 'ai-hub-update', format: 1, version: ver, notes: 'Export complet du logiciel', createdAt: new Date().toISOString(), requiresLauncher: null, files }), 'utf8') });\r\n  }\r\n  map.set('LISEZMOI-EXPORT.txt', { name: 'LISEZMOI-EXPORT.txt', data: Buffer.from(\r\n    'AI Hub - export du logiciel\\r\\nVersion : ' + ver + '\\r\\nCréé le : ' + new Date().toLocaleString('fr-FR') + '\\r\\n\\r\\n' +\r\n    'Contenu : les fichiers du logiciel dans leur état actuel (version active par-dessus les fichiers du lanceur).\\r\\n' +\r\n    'Ne contient PAS tes comptes, cookies, conversations ni ton code personnalisé (ils restent dans ' + ud() + ').\\r\\n\\r\\n' +\r\n    'Pour relancer depuis les sources : installer Node.js, puis dans ce dossier : npm install electron  puis  npx electron .\\r\\n' +\r\n    'Pour réinstaller cette version dans AI Hub : Paramètres > Mises à jour > Installer un fichier de mise à jour > ai-hub-update-' + ver + '.aihubupdate\\r\\n', 'utf8') });\r\n  const entries = [...map.values()];\r\n  return { buf: makeZip(entries), count: entries.length };\r\n}\r\n// </PACK>\r\nipcMain.handle('pack:zip', async () => {\r\n  try {\r\n    const info = ctx.updater.info(), boot = ctx.boot || {};\r\n    const ver = boot.version && boot.version !== 'bundled' ? boot.version : (info.launcherVersion || app.getVersion());\r\n    const r = await dialog.showSaveDialog(win, { defaultPath: 'ai-hub-' + ver + '-' + new Date().toISOString().slice(0, 10) + '.zip', filters: [{ name: 'ZIP', extensions: ['zip'] }] });\r\n    if (r.canceled || !r.filePath) return { ok: false, cancelled: true };\r\n    const res = packApp(ver, app.getAppPath(), __dirname);\r\n    fs.writeFileSync(r.filePath, res.buf);\r\n    try { shell.showItemInFolder(r.filePath); } catch {}\r\n    return { ok: true, path: r.filePath, files: res.count, size: res.buf.length, version: ver };\r\n  } catch (e) { return { ok: false, error: e.message }; }\r\n});\r\n\r\n// ---------- 2.5.5 : connexion via le vrai Google Chrome (Google refuse les fenêtres intégrées) ----------\r\n// On ouvre un vrai Chrome (profil temporaire, port de débogage local), tu t'y connectes normalement,\r\n// puis AI Hub lit les cookies du site concerné et les copie dans le compte. Le profil temporaire est supprimé ensuite.\r\n// <CHROME>\r\nconst http = require('http'), cp = require('child_process'), os = require('os');\r\nlet chromeProc = null, chromeDir = null;\r\nfunction chromePaths() {\r\n  const e = process.env, c = [];\r\n  if (process.platform === 'win32') {\r\n    for (const b of [e.LOCALAPPDATA, e.ProgramFiles, e['ProgramFiles(x86)']]) if (b) c.push(path.join(b, 'Google', 'Chrome', 'Application', 'chrome.exe'));\r\n    for (const b of [e['ProgramFiles(x86)'], e.ProgramFiles, e.LOCALAPPDATA]) if (b) c.push(path.join(b, 'Microsoft', 'Edge', 'Application', 'msedge.exe'));\r\n  } else if (process.platform === 'darwin') {\r\n    c.push('/Applications/Google Chrome.app/Contents/MacOS/Google Chrome', '/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge');\r\n  } else {\r\n    c.push('/usr/bin/google-chrome', '/usr/bin/google-chrome-stable', '/usr/bin/chromium', '/usr/bin/chromium-browser', '/usr/bin/microsoft-edge');\r\n  }\r\n  return c;\r\n}\r\nconst cdpJson = (port, p) => new Promise((res, rej) => {\r\n  const r = http.get({ host: '127.0.0.1', port, path: p, timeout: 3000 }, (m) => { let d = ''; m.on('data', (x) => { d += x; }); m.on('end', () => { try { res(JSON.parse(d)); } catch (e) { rej(e); } }); });\r\n  r.on('error', rej); r.on('timeout', () => r.destroy(new Error('délai dépassé')));\r\n});\r\n// cookie Chrome (protocole DevTools) -> cookie Electron ; null si à ignorer\r\nfunction toElectronCookie(c, hosts) {\r\n  const raw = String(c.domain || ''), dom = raw.replace(/^\\./, '').toLowerCase();\r\n  if (!dom || c.partitionKey || /^(cf_clearance|__cf_bm|_cfuvid)$/.test(c.name)) return null;\r\n  if (!hosts.some((h) => dom === h || dom.endsWith('.' + h))) return null;\r\n  const o = { url: 'http' + (c.secure ? 's' : '') + '://' + dom + (c.path || '/'), name: c.name, value: c.value, path: c.path || '/', secure: !!c.secure, httpOnly: !!c.httpOnly };\r\n  if (raw.startsWith('.')) o.domain = raw;\r\n  const ss = String(c.sameSite || '').toLowerCase();\r\n  o.sameSite = ss === 'none' ? 'no_restriction' : ss === 'lax' ? 'lax' : ss === 'strict' ? 'strict' : 'unspecified';\r\n  if (c.expires > 0) o.expirationDate = c.expires;\r\n  return o;\r\n}\r\nfunction chromeClean() {                           // supprime les profils temporaires oubliés (ils contiennent une session Google)\r\n  try { for (const n of fs.readdirSync(os.tmpdir())) if (/^ai-hub-chrome-\\d+$/.test(n)) { try { fs.rmSync(path.join(os.tmpdir(), n), { recursive: true, force: true, maxRetries: 8, retryDelay: 400 }); } catch {} } } catch {}\r\n}\r\nfunction chromeStop() {\r\n  const p = chromeProc, dir = chromeDir; chromeProc = null; chromeDir = null;\r\n  if (p && p.exitCode === null) {\r\n    try { if (process.platform === 'win32') cp.execFile('taskkill', ['/pid', String(p.pid), '/T', '/F'], () => {}); else p.kill('SIGTERM'); } catch {}\r\n  }\r\n  if (dir) setTimeout(() => { try { fs.rmSync(dir, { recursive: true, force: true, maxRetries: 8, retryDelay: 400 }); } catch {} }, 1500);\r\n}\r\n// </CHROME>\r\nipcMain.handle('chrome:start', async (_e, url) => {\r\n  try {\r\n    chromeStop(); chromeClean();\r\n    if (!/^https:\\/\\/[\\w.-]+(\\/|$)/i.test(String(url))) return { ok: false, error: 'adresse invalide' };\r\n    const exe = chromePaths().find((p) => { try { return fs.existsSync(p); } catch { return false; } });\r\n    if (!exe) return { ok: false, error: \"Google Chrome (ou Microsoft Edge) n'est pas installé sur cet ordinateur.\" };\r\n    const port = 9300 + Math.floor(Math.random() * 500);\r\n    chromeDir = path.join(os.tmpdir(), 'ai-hub-chrome-' + Date.now());\r\n    fs.mkdirSync(chromeDir, { recursive: true });\r\n    const proc = cp.spawn(exe, ['--user-data-dir=' + chromeDir, '--remote-debugging-port=' + port, '--remote-allow-origins=*', '--no-first-run', '--no-default-browser-check', String(url)], { stdio: 'ignore' });\r\n    chromeProc = proc; let dead = false; proc.on('exit', () => { dead = true; }); proc.on('error', () => { dead = true; });\r\n    for (let i = 0; i < 40; i++) {                  // attend que Chrome réponde (20 s max)\r\n      await new Promise((r) => setTimeout(r, 500));\r\n      if (dead) { chromeStop(); return { ok: false, error: 'Chrome s\\'est fermé au démarrage.' }; }\r\n      try { const v = await cdpJson(port, '/json/version'); if (v && v.webSocketDebuggerUrl) return { ok: true, port, browser: String(v.Browser || '') }; } catch {}\r\n    }\r\n    chromeStop(); return { ok: false, error: 'Chrome ne répond pas.' };\r\n  } catch (e) { chromeStop(); return { ok: false, error: e.message }; }\r\n});\r\nipcMain.handle('chrome:ws', async (_e, port) => {\r\n  try { const v = await cdpJson(Number(port), '/json/version'); return { ok: true, ws: v.webSocketDebuggerUrl }; }\r\n  catch { return { ok: false, error: 'Chrome ne répond plus (l\\'as-tu fermé ?). Clique « Ouvrir Chrome » pour recommencer.' }; }\r\n});\r\nipcMain.handle('chrome:import', async (_e, { partition, hosts, cookies }) => {\r\n  try {\r\n    if (!/^persist:a\\d+$/.test(String(partition))) return { ok: false, error: 'compte invalide' };\r\n    const ses = session.fromPartition(partition); let n = 0, skipped = 0;\r\n    for (const c of cookies || []) {\r\n      const o = toElectronCookie(c, (hosts || []).map((h) => String(h).toLowerCase()));\r\n      if (!o) { skipped++; continue; }\r\n      try { await ses.cookies.set(o); n++; } catch { skipped++; }\r\n    }\r\n    try { await ses.cookies.flushStore(); } catch {}\r\n    return { ok: true, imported: n, skipped };\r\n  } catch (e) { return { ok: false, error: e.message }; }\r\n});\r\nipcMain.handle('chrome:stop', () => { chromeStop(); return true; });\r\napp.on('before-quit', () => { chromeStop(); });\r\napp.whenReady().then(chromeClean);\r\n\r\n// 10.0.0 : lanceur reconstruit depuis le ZIP (système de mise à jour du lanceur 10, remplacement des fichiers de l'exe à la fermeture)\r\nlanceurAttach(ctx, () => win, ud);\r\n\r\n// Garde-fou : une nouvelle version qui ne confirme pas en 15 s est annulée\r\nif (ctx.updater.info().pending) setTimeout(() => { if (ctx.updater.info().pending) ctx.fatal('aucune confirmation de démarrage en 60 s'); }, 60000);   // 7.0 : 15 s était trop court sur un PC chargé (antivirus, 12 comptes) : la 6.0.1 a été annulée à tort\r\n\r\n// Une seule instance à la fois : empêche deux fenêtres d'écraser les mêmes données\r\nif (!app.requestSingleInstanceLock()) app.quit();\r\nelse {\r\n  app.on('second-instance', () => { if (win) { if (win.isMinimized()) win.restore(); win.show(); win.focus(); } });\r\n  app.whenReady().then(create);\r\n}\r\napp.on('window-all-closed', () => app.quit());\r\n};\r\n\r\n// ---------- 3.0.0 : moteur local complet (lecture, écriture sûre, commandes, mémoire, web) ----------\r\n// Tout chemin est résolu puis vérifié : il doit rester DANS le dossier du projet (pas de « .. », pas de chemin absolu, pas de lien qui sort).\r\n// Le dossier .aihub/ (mémo, journal, sauvegardes) appartient à AI Hub : l'IA ne peut ni le lire ni le modifier par les instructions.\r\nconst os = require('os'), cp = require('child_process');\r\nconst LOC_IGNORE = new Set(['node_modules', '.git', 'dist', 'build', '.aihub', '__pycache__', '.venv', '.next', '.cache']);\r\nlet LOC_IGN = LOC_IGNORE;\r\nconst LOC_MAXFILE = 200 * 1024, LOC_MAXOUT = 24000, LOC_MAXBACKUP = 100 * 1024 * 1024, LOC_UNDO_KEEP = 500;\r\nconst aihDir = (root) => path.join(fs.realpathSync(root), '.aihub');\r\nfunction locSafe(root, rel, forInternal) {\r\n  rel = String(rel == null || rel === '' ? '.' : rel).trim().replace(/\\\\/g, '/');\r\n  if (/^([a-zA-Z]:|\\/|~)/.test(rel)) throw new Error('chemin absolu refusé (utilise un chemin relatif au dossier)');\r\n  if (rel.split('/').some(s => s === '..')) throw new Error('« .. » refusé (reste dans le dossier du projet)');\r\n  const base = fs.realpathSync(root), full = path.resolve(base, rel);\r\n  const inside = f => f === base || f.startsWith(base + path.sep);\r\n  if (!inside(full)) throw new Error('chemin hors du dossier');\r\n  // on vérifie le plus proche parent existant : un lien symbolique ne doit pas faire sortir une écriture du dossier\r\n  let probe = full;\r\n  for (let i = 0; i < 64; i++) {\r\n    try { const real = fs.realpathSync(probe); if (!inside(real)) throw new Error('lien symbolique hors du dossier refusé'); break; }\r\n    catch (e) { if (e.code !== 'ENOENT') throw e; const up = path.dirname(probe); if (up === probe) break; probe = up; }\r\n  }\r\n  const r = path.relative(base, full).replace(/\\\\/g, '/') || '.';\r\n  if (!forInternal && r.split('/')[0].toLowerCase() === '.aihub') throw new Error('le dossier .aihub est réservé à AI Hub (mémo, journal, sauvegardes)');\r\n  return { base, full, rel: r };\r\n}\r\nfunction locCap(s, n) { s = String(s); if (s.length <= n) return s; const a = Math.floor(n * .55), b = n - a; return s.slice(0, a) + '\\n[… ' + (s.length - n) + ' caractères omis — redemande la partie utile avec @read début-fin ou @grep …]\\n' + s.slice(-b); }\r\nfunction locIsBinary(f) { try { const fd = fs.openSync(f, 'r'), buf = Buffer.alloc(4096), n = fs.readSync(fd, buf, 0, 4096, 0); fs.closeSync(fd); for (let i = 0; i < n; i++) if (buf[i] === 0) return true; return false; } catch { return true; } }\r\nfunction* locWalk(dir, base, maxDepth, depth = 0) {\r\n  let ents; try { ents = fs.readdirSync(dir, { withFileTypes: true }); } catch { return; }\r\n  ents.sort((x, y) => (y.isDirectory() - x.isDirectory()) || x.name.localeCompare(y.name));\r\n  for (const e of ents) {\r\n    if (e.isSymbolicLink() || LOC_IGN.has(e.name)) continue;\r\n    const full = path.join(dir, e.name), rel = path.relative(base, full).replace(/\\\\/g, '/');\r\n    yield { e, full, rel, depth };\r\n    if (e.isDirectory() && depth + 1 < maxDepth) yield* locWalk(full, base, maxDepth, depth + 1);\r\n  }\r\n}\r\nconst locArgs = s => (String(s || '').match(/\"[^\"]*\"|\\S+/g) || []).map(x => x.replace(/^\"|\"$/g, ''));\r\nconst locGlob = g => new RegExp('^' + String(g).replace(/[.+^${}()|[\\]\\\\]/g, '\\\\$&').replace(/\\*/g, '.*').replace(/\\?/g, '.') + '$', 'i');\r\nconst locSec = ms => (ms / 1000).toFixed(1).replace('.', ',') + ' s';\r\nconst nLines = s => s === '' ? 0 : String(s).split(/\\r?\\n/).length;\r\n\r\n// ---- journal, sauvegardes, annulation (tout vit dans .aihub/) ----\r\nfunction jlog(root, line) { try { const d = aihDir(root); fs.mkdirSync(d, { recursive: true }); fs.appendFileSync(path.join(d, 'journal.txt'), new Date().toISOString().slice(0, 19).replace('T', ' ') + ' ' + String(line).replace(/\\s+/g, ' ').slice(0, 300) + '\\n'); } catch {} }\r\nconst undoDir = (root) => path.join(aihDir(root), 'undo');\r\nfunction undoIndex(root) { try { const a = JSON.parse(fs.readFileSync(path.join(undoDir(root), 'index.json'), 'utf8')); return Array.isArray(a) ? a : []; } catch { return []; } }\r\nfunction undoSave(root, a) {\r\n  const d = undoDir(root); fs.mkdirSync(d, { recursive: true });\r\n  while (a.length > LOC_UNDO_KEEP) { const o = a.shift(); try { fs.rmSync(path.join(d, o.id), { recursive: true, force: true }); } catch {} }\r\n  fs.writeFileSync(path.join(d, 'index.json'), JSON.stringify(a));\r\n}\r\nlet undoSeq = 0;\r\nfunction dirSize(p, limit) { let n = 0; const st = fs.lstatSync(p); if (!st.isDirectory()) return st.size; for (const e of fs.readdirSync(p)) { n += dirSize(path.join(p, e), limit); if (n > limit) throw new Error('trop gros pour être sauvegardé (> ' + Math.round(limit / 1048576) + ' Mo) : utilise @run pour cette opération'); } return n; }\r\n// Enregistre une modification annulable. backup = chemin complet à sauvegarder avant d'agir (ou null si rien à sauvegarder).\r\nfunction undoPush(root, ctx, op, rel, rel2, backupFull) {\r\n  const id = Date.now().toString(36) + (undoSeq++).toString(36), e = { id, ts: Date.now(), turn: (ctx && ctx.turn) || 't0', op, rel, rel2: rel2 || '', bak: false };\r\n  if (backupFull && fs.existsSync(backupFull)) {\r\n    dirSize(backupFull, LOC_MAXBACKUP);\r\n    const dst = path.join(undoDir(root), id); fs.mkdirSync(dst, { recursive: true });\r\n    fs.cpSync(backupFull, path.join(dst, 'b'), { recursive: true }); e.bak = true; e.dir = fs.statSync(backupFull).isDirectory();\r\n  }\r\n  const a = undoIndex(root); a.push(e); undoSave(root, a); return e;\r\n}\r\nfunction undoDropLast(root, id) { const a = undoIndex(root).filter(x => x.id !== id); undoSave(root, a); try { fs.rmSync(path.join(undoDir(root), id), { recursive: true, force: true }); } catch {} }\r\nfunction undoOne(root, e) {\r\n  const base = fs.realpathSync(root), P = r => locSafe(root, r).full, bak = path.join(undoDir(root), e.id, 'b');\r\n  const restoreBak = (full) => { fs.mkdirSync(path.dirname(full), { recursive: true }); fs.rmSync(full, { recursive: true, force: true }); fs.cpSync(bak, full, { recursive: true }); };\r\n  if (e.op === 'write' || e.op === 'edit' || e.op === 'append') { const f = P(e.rel); if (e.bak) restoreBak(f); else fs.rmSync(f, { force: true }); return 'restauré ' + e.rel; }\r\n  if (e.op === 'delete') { const f = P(e.rel); if (fs.existsSync(f)) throw new Error(e.rel + ' existe déjà : rien restauré'); if (!e.bak) throw new Error('sauvegarde introuvable'); restoreBak(f); return 'récupéré ' + e.rel; }\r\n  if (e.op === 'mkdir') { const f = P(e.rel); try { fs.rmdirSync(f); } catch { throw new Error('dossier ' + e.rel + ' non vide ou déjà supprimé : laissé tel quel'); } return 'dossier retiré ' + e.rel; }\r\n  if (e.op === 'move') { const a = P(e.rel), b = P(e.rel2); if (!fs.existsSync(b)) throw new Error(e.rel2 + ' n\\'existe plus'); if (fs.existsSync(a)) throw new Error(e.rel + ' existe déjà'); fs.mkdirSync(path.dirname(a), { recursive: true }); try { fs.renameSync(b, a); } catch { fs.cpSync(b, a, { recursive: true }); fs.rmSync(b, { recursive: true, force: true }); } return 'remis ' + e.rel2 + ' → ' + e.rel; }\r\n  if (e.op === 'copy') { const t = P(e.rel2); if (e.bak) restoreBak(t); else fs.rmSync(t, { recursive: true, force: true }); return 'copie annulée ' + e.rel2; }\r\n  throw new Error('opération inconnue : ' + e.op);\r\n}\r\nfunction undoMany(root, list) { const out = []; let ok = 0; for (const e of list) { try { out.push('✔ ' + undoOne(root, e)); undoDropLast(root, e.id); ok++; } catch (x) { out.push('✕ ' + e.op + ' ' + e.rel + ' : ' + (x.message || x)); } } return { ok, out }; }\r\n\r\n// ---- éditions ----\r\nfunction parseEdit(body) {\r\n  const L = String(body || '').replace(/\\r/g, '').split('\\n'), pairs = []; let mode = '', s = [], r = [];\r\n  const flush = () => { if (mode === 'r') pairs.push({ s: s.join('\\n'), r: r.join('\\n') }); s = []; r = []; };\r\n  for (const l of L) {\r\n    const t = l.trim();\r\n    if (t === 'CHERCHE' || t === 'SEARCH') { flush(); mode = 's'; continue; }\r\n    if (t === 'REMPLACE' || t === 'REPLACE') { if (mode !== 's') throw new Error('REMPLACE sans CHERCHE avant'); mode = 'r'; continue; }\r\n    if (mode === 's') s.push(l); else if (mode === 'r') r.push(l);\r\n  }\r\n  flush();\r\n  if (!pairs.length) throw new Error('bloc invalide : écris CHERCHE, le texte à trouver, REMPLACE, puis le nouveau texte (entre <<< et >>>)');\r\n  return pairs;\r\n}\r\nfunction countOcc(h, n) { let c = 0, i = 0; while ((i = h.indexOf(n, i)) !== -1) { c++; i += n.length; } return c; }\r\n\r\n// ---- web ----\r\nfunction htmlToText(h) {\r\n  h = String(h).replace(/<(script|style|noscript|svg|template)[\\s\\S]*?<\\/\\1>/gi, ' ').replace(/<!--[\\s\\S]*?-->/g, ' ');\r\n  h = h.replace(/<(br|\\/p|\\/div|\\/li|\\/tr|\\/h[1-6]|\\/pre|\\/blockquote|\\/table|\\/section|\\/article)\\s*\\/?>/gi, '\\n').replace(/<li[^>]*>/gi, '\\n• ').replace(/<[^>]+>/g, ' ');\r\n  const ent = { amp: '&', lt: '<', gt: '>', quot: '\"', apos: \"'\", nbsp: ' ', laquo: '«', raquo: '»', hellip: '…', eacute: 'é', egrave: 'è', agrave: 'à', ecirc: 'ê', ccedil: 'ç' };\r\n  h = h.replace(/&(#x?[0-9a-f]+|[a-z]+);/gi, (m, e) => { if (e[0] === '#') { const n = e[1].toLowerCase() === 'x' ? parseInt(e.slice(2), 16) : parseInt(e.slice(1), 10); try { return String.fromCodePoint(n); } catch { return ' '; } } return ent[e.toLowerCase()] != null ? ent[e.toLowerCase()] : m; });\r\n  return h.replace(/[ \\t\\f\\v]+/g, ' ').replace(/ ?\\n ?/g, '\\n').replace(/\\n{3,}/g, '\\n\\n').trim();\r\n}\r\nfunction privateHost(h) { h = String(h).toLowerCase().replace(/^\\[|\\]$/g, ''); return h === 'localhost' || h.endsWith('.local') || h.endsWith('.internal') || /^(127\\.|10\\.|0\\.|169\\.254\\.|192\\.168\\.|172\\.(1[6-9]|2\\d|3[01])\\.)/.test(h) || h === '::1' || /^f[cd][0-9a-f]{2}:/.test(h) || /^fe80:/.test(h); }\r\nasync function locFetch(url, ms) {\r\n  const u = new URL(url); if (!/^https?:$/.test(u.protocol)) throw new Error('seules les adresses http(s) sont permises');\r\n  if (privateHost(u.hostname)) throw new Error('adresse locale ou privée refusée');\r\n  const f = globalThis.fetch || require('electron').net.fetch, ac = new AbortController(), t = setTimeout(() => ac.abort(), ms || 20000);\r\n  try {\r\n    const r = await f(u.href, { signal: ac.signal, redirect: 'follow', headers: { 'User-Agent': 'Mozilla/5.0 (AI Hub)', 'Accept': 'text/html,text/plain,application/json;q=0.9,*/*;q=0.5', 'Accept-Language': 'fr,en;q=0.8' } });\r\n    if (r.url) { try { if (privateHost(new URL(r.url).hostname)) throw new Error('redirection vers une adresse privée refusée'); } catch (e) { if (/refusée/.test(e.message)) throw e; } }\r\n    const ct = String(r.headers.get('content-type') || '');\r\n    if (/^(image|video|audio)\\//i.test(ct) || /application\\/(pdf|zip|octet-stream)/i.test(ct)) throw new Error('contenu non textuel (' + ct.split(';')[0] + ') : télécharge-le avec @run ou @script si besoin');\r\n    const raw = (await r.text()).slice(0, 2 * 1024 * 1024);\r\n    return { status: r.status, ct, raw, url: r.url || u.href };\r\n  } catch (e) { if (e.name === 'AbortError') throw new Error('délai dépassé (' + Math.round((ms || 20000) / 1000) + ' s)'); throw e; }\r\n  finally { clearTimeout(t); }\r\n}\r\nfunction parseSearch(html) {\r\n  const out = [], re = /<a[^>]+class=\"[^\"]*result__a[^\"]*\"[^>]*href=\"([^\"]+)\"[^>]*>([\\s\\S]*?)<\\/a>([\\s\\S]*?)(?=<a[^>]+class=\"[^\"]*result__a|$)/gi; let m;\r\n  while ((m = re.exec(html)) && out.length < 8) {\r\n    let href = m[1].replace(/&amp;/g, '&'); const q = /[?&]uddg=([^&]+)/.exec(href); if (q) { try { href = decodeURIComponent(q[1]); } catch {} } else if (href.startsWith('//')) href = 'https:' + href;\r\n    const sn = /class=\"[^\"]*result__snippet[^\"]*\"[^>]*>([\\s\\S]*?)<\\/(?:a|td|div)>/i.exec(m[3]);\r\n    out.push({ t: htmlToText(m[2]).slice(0, 140), u: href, s: sn ? htmlToText(sn[1]).slice(0, 220) : '' });\r\n  }\r\n  return out;\r\n}\r\n\r\n// ---- processus (commandes et scripts) ----\r\nfunction killTree(child) { try { if (process.platform === 'win32') cp.spawn('taskkill', ['/pid', String(child.pid), '/T', '/F'], { windowsHide: true }); else process.kill(-child.pid, 'SIGKILL'); } catch { try { child.kill('SIGKILL'); } catch {} } }\r\nfunction locProc(file, args, o) {\r\n  return new Promise((resolve) => {\r\n    const t0 = Date.now(); let head = '', tail = '', total = 0, done = false, timedOut = false;\r\n    const push = (d) => { const s = d.toString('utf8'); total += s.length; if (head.length < 30000) { head += s; if (head.length > 30000) { tail = head.slice(30000); head = head.slice(0, 30000); } } else { tail += s; if (tail.length > 30000) tail = tail.slice(-30000); } };\r\n    let child; try { child = cp.spawn(file, args, { cwd: o.cwd, shell: !!o.shell, windowsHide: true, detached: process.platform !== 'win32', stdio: ['ignore', 'pipe', 'pipe'], env: Object.assign({}, process.env, o.env || {}) }); }\r\n    catch (e) { return resolve({ code: -1, out: String(e.message || e), ms: 0, spawnErr: true }); }\r\n    LOC_PROCS.add(child);\r\n    const fin = (code, extra) => { if (done) return; done = true; clearTimeout(tm); LOC_PROCS.delete(child); const omitted = total - head.length - tail.length; resolve({ code, out: head + (omitted > 0 ? '\\n[… ' + omitted + ' caractères omis …]\\n' : '') + tail + (extra || ''), ms: Date.now() - t0, timedOut }); };\r\n    const tm = setTimeout(() => { timedOut = true; killTree(child); setTimeout(() => fin(-1, '\\n[arrêté : délai de ' + Math.round(o.timeout / 1000) + ' s dépassé]'), 800); }, o.timeout);\r\n    child.stdout.on('data', push); child.stderr.on('data', push);\r\n    child.on('error', (e) => { head += String(e.message || e); fin(-1); });\r\n    child.on('close', (code) => fin(code == null ? -1 : code));\r\n  });\r\n}\r\nconst LOC_PROCS = new Set();\r\nconst whichCache = {};\r\nfunction haveCmd(cmd, args) { const k = cmd + ' ' + (args || []).join(' '); if (k in whichCache) return whichCache[k]; try { const r = cp.spawnSync(cmd, args || ['--version'], { stdio: 'ignore', windowsHide: true, timeout: 8000 }); return whichCache[k] = !r.error && r.status === 0; } catch { return whichCache[k] = false; } }\r\nfunction interp(lang) {\r\n  const win = process.platform === 'win32';\r\n  if (lang === 'node') return haveCmd('node') ? { file: 'node', pre: [], env: {} } : { file: process.execPath, pre: [], env: { ELECTRON_RUN_AS_NODE: '1' } };\r\n  if (lang === 'python') { const c = win ? [['python', []], ['py', ['-3']], ['python3', []]] : [['python3', []], ['python', []]]; for (const [f, pre] of c) if (haveCmd(f, pre.concat('--version'))) return { file: f, pre, env: { PYTHONIOENCODING: 'utf-8', PYTHONUTF8: '1' } }; throw new Error('Python introuvable sur ce PC'); }\r\n  if (lang === 'powershell') { const c = win ? ['powershell', 'pwsh'] : ['pwsh', 'powershell']; for (const f of c) if (haveCmd(f, ['-NoProfile', '-Command', 'exit 0'])) return { file: f, pre: ['-NoProfile'].concat(win ? ['-ExecutionPolicy', 'Bypass'] : []), env: {}, ps: true }; throw new Error('PowerShell introuvable sur ce PC'); }\r\n  throw new Error('langage inconnu : ' + lang + ' (node, python ou powershell)');\r\n}\r\n// 4.11.0 : erreurs de compilation condensées en fichier:ligne (javac, gcc, tsc, rustc, python) avant la sortie complète\r\n// 5.1.0 : extrait de code (±4 lignes) autour des 3 premières erreurs : l'IA n'a plus besoin d'un tour de lecture pour les comprendre\r\nfunction cerrCode(P, root) {\r\n  if (!root || !P.length) return '';\r\n  let sn = ''; try {\r\n    const base = fs.realpathSync(root);\r\n    for (const [f, ln] of P.slice(0, 3)) {\r\n      const full = path.resolve(base, f);\r\n      if (!full.startsWith(base + path.sep) || !fs.existsSync(full) || fs.statSync(full).size > 400000) continue;\r\n      const Ls = fs.readFileSync(full, 'utf8').split(/\\r?\\n/), a = Math.max(0, ln - 4), b = Math.min(Ls.length, ln + 3);\r\n      sn += '--- ' + path.relative(base, full).replace(/\\\\/g, '/') + ' ' + (a + 1) + '-' + b + ' ---\\n' + Ls.slice(a, b).map((x, i) => (a + i + 1 === ln ? '>' : ' ') + (a + i + 1) + ' ' + x.slice(0, 200)).join('\\n') + '\\n';\r\n    }\r\n  } catch {}\r\n  return sn;\r\n}\r\nfunction cerrSum(out, ok, root) {\r\n  if (ok) return '';\r\n  const seen = new Set(), L = [], P = [], res = [/^\\s*([^\\s:()\"]+\\.[A-Za-z]{1,6}):(\\d+)(?::\\d+)?:\\s*(?:fatal\\s+)?error\\b[:\\s]*(.*)$/i, /^\\s*([^\\s:()\"]+\\.[A-Za-z]{1,6})\\((\\d+)(?:,\\d+)?\\):\\s*error\\s*(.*)$/i, /^\\s*-->\\s*([^\\s:]+):(\\d+)(?::\\d+)?()/, /^\\s*File \"([^\"]+)\", line (\\d+)()/];\r\n  for (const l of String(out || '').split('\\n')) for (const re of res) { const m = re.exec(l); if (m) { const k = m[1] + ':' + m[2]; if (!seen.has(k)) { seen.add(k); P.push([m[1], +m[2]]); L.push(k + (m[3] ? ' ' + m[3].trim().slice(0, 140) : '')); } break; } }\r\n  return L.length ? 'ERREURS À CORRIGER (' + L.length + ') fichier:ligne :\\n' + L.slice(0, 15).join('\\n') + (L.length > 15 ? '\\n…' : '') + '\\n' + cerrCode(P, root) + '---\\n' : '';\r\n}\r\nconst cmdOut = (r, t, name, root) => {\r\n  const ok = r.code === 0 && !r.timedOut, lab = r.timedOut ? 'délai dépassé' : 'code ' + r.code;\r\n  const sm = locSmart(r.out, ok ? 6000 : 9000);      // 4.2.0 : sans bruit (npm WARN, barres de progression, lignes répétées), erreurs et fin gardées\r\n  return { ok, title: name + ' (' + lab + ', ' + locSec(r.ms) + ')', out: (cerrSum(r.out, ok, root) + sm.out.trim()) || '(aucune sortie)', changed: true, saved: sm.saved };\r\n};\r\n\r\n// ---- 3.7.0 : suivi des lectures, diff, vérification automatique, carte du projet ----\r\n// Suivi des lectures : AI Hub retient la version (date + taille) que l'IA a lue en dernier. Si le fichier a changé depuis\r\n// (modification à la main, commande), @edit et @write refusent d'écraser et demandent une relecture.\r\nconst LOC_SEEN = new Map();\r\nconst realBase = (root) => { try { return fs.realpathSync(root); } catch { return String(root); } };\r\nconst seenKey = (root, rel) => realBase(root) + '|' + rel;\r\nfunction seenMark(root, rel, full) { try { const st = fs.statSync(full); LOC_SEEN.set(seenKey(root, rel), { m: st.mtimeMs, s: st.size }); } catch {} }\r\nfunction seenStale(root, rel, full) { const o = LOC_SEEN.get(seenKey(root, rel)); if (!o) return false; try { const st = fs.statSync(full); return st.mtimeMs !== o.m || st.size !== o.s; } catch { return false; } }\r\nfunction seenClear(root) { const b = realBase(root) + '|'; for (const k of [...LOC_SEEN.keys()]) if (k.startsWith(b)) LOC_SEEN.delete(k); }\r\nconst staleMsg = (rel) => rel + ' a changé depuis ta dernière lecture (modification à la main ou par une commande) : rien n\\'a été modifié, relis-le avec @read ' + rel + ' puis recommence';\r\n// numéros de lignes (1, 2, 3…) de toutes les occurrences d'un texte\r\nfunction occLines(h, n) { const out = []; let i = 0; while ((i = h.indexOf(n, i)) !== -1) { out.push(h.slice(0, i).split('\\n').length); i += Math.max(1, n.length); if (out.length >= 50) break; } return out; }\r\n\r\n// Diff ligne par ligne (contexte de 2 lignes). Renvoie { diff, add, del } ; diff = lignes préfixées « + », « - » ou « 2 espaces ».\r\nfunction lineDiff(a, b, ctx) {\r\n  ctx = ctx == null ? 2 : ctx;\r\n  const sp = (x) => { x = String(x == null ? '' : x).replace(/\\r\\n/g, '\\n'); return x === '' ? [] : x.split('\\n'); };\r\n  const A = sp(a), B = sp(b);\r\n  let s = 0; while (s < A.length && s < B.length && A[s] === B[s]) s++;\r\n  let ea = A.length, eb = B.length; while (ea > s && eb > s && A[ea - 1] === B[eb - 1]) { ea--; eb--; }\r\n  const a2 = A.slice(s, ea), b2 = B.slice(s, eb), ops = [];\r\n  for (let i = 0; i < s; i++) ops.push([' ', A[i]]);\r\n  const n = a2.length, m = b2.length;\r\n  if (n * m <= 4000000) {\r\n    const W = m + 1, dp = new Uint32Array((n + 1) * W);\r\n    for (let i = n - 1; i >= 0; i--) for (let j = m - 1; j >= 0; j--) dp[i * W + j] = a2[i] === b2[j] ? dp[(i + 1) * W + j + 1] + 1 : Math.max(dp[(i + 1) * W + j], dp[i * W + j + 1]);\r\n    let i = 0, j = 0;\r\n    while (i < n && j < m) { if (a2[i] === b2[j]) { ops.push([' ', a2[i]]); i++; j++; } else if (dp[(i + 1) * W + j] >= dp[i * W + j + 1]) { ops.push(['-', a2[i]]); i++; } else { ops.push(['+', b2[j]]); j++; } }\r\n    while (i < n) ops.push(['-', a2[i++]]); while (j < m) ops.push(['+', b2[j++]]);\r\n  } else { for (const x of a2) ops.push(['-', x]); for (const x of b2) ops.push(['+', x]); }\r\n  for (let i = ea; i < A.length; i++) ops.push([' ', A[i]]);\r\n  let add = 0, del = 0; const show = new Uint8Array(ops.length);\r\n  ops.forEach((o, i) => { if (o[0] !== ' ') { if (o[0] === '+') add++; else del++; for (let k = Math.max(0, i - ctx); k <= Math.min(ops.length - 1, i + ctx); k++) show[k] = 1; } });\r\n  if (!add && !del) return { diff: '', add: 0, del: 0 };\r\n  const out = []; let ln = 0, gap = true, shown = 0;\r\n  ops.forEach((o, i) => {\r\n    if (o[0] !== '-') ln++;\r\n    if (!show[i]) { gap = true; return; }\r\n    if (shown >= 220) return;\r\n    if (gap) { out.push('@@ ligne ' + (o[0] === '-' ? ln + 1 : ln) + ' @@'); gap = false; }\r\n    out.push(o[0] + ' ' + String(o[1]).slice(0, 220)); shown++;\r\n  });\r\n  if (shown >= 220) out.push('@@ … diff coupé à 220 lignes @@');\r\n  return { diff: out.join('\\n'), add, del };\r\n}\r\n\r\n// Vérification de syntaxe après chaque @write / @edit / @append. Renvoie null si rien à vérifier.\r\nasync function locVerify(root, rel, full) {\r\n  const ext = path.extname(rel).toLowerCase(), base = path.basename(rel).toLowerCase();\r\n  const lineOf = (n) => { try { return fs.readFileSync(full, 'utf8').split(/\\r?\\n/)[n - 1]; } catch { return ''; } };\r\n  const fail = (what, msg, line) => { let m = String(msg).replace(/\\s+/g, ' ').trim().slice(0, 240); if (line) { const src = String(lineOf(line) || '').trim().slice(0, 140); if (src) m += ' | ligne ' + line + ' : ' + src; } return { ok: false, what, msg: m, line: line || 0 }; };\r\n  try {\r\n    if (ext === '.json') {\r\n      if (/^(tsconfig|jsconfig).*\\.json$|^\\.(babelrc|eslintrc|prettierrc)/.test(base)) return null;     // JSON avec commentaires toléré par ces outils\r\n      const t = fs.readFileSync(full, 'utf8').replace(/^\\uFEFF/, '');\r\n      try { JSON.parse(t); return { ok: true, what: 'JSON valide' }; }\r\n      catch (e) { const m = /position (\\d+)/.exec(e.message); return fail('JSON.parse', e.message, m ? t.slice(0, +m[1]).split('\\n').length : 0); }\r\n    }\r\n    if (/^\\.(js|mjs|cjs)$/.test(ext)) {\r\n      const it = interp('node'), r = await locProc(it.file, it.pre.concat(['--check', full]), { cwd: realBase(root), timeout: 15000, env: it.env });\r\n      if (r.code === 0 && !r.timedOut) return { ok: true, what: 'node --check' };\r\n      if (r.timedOut || r.spawnErr) return null;\r\n      const o = String(r.out || ''), lm = /:(\\d+)\\s*$/m.exec(o), em = /^\\s*(?:\\w*Error): .*$/m.exec(o);\r\n      return fail('node --check', em ? em[0] : o.split('\\n').find(l => l.trim()) || 'erreur de syntaxe', lm ? +lm[1] : 0);\r\n    }\r\n    if (ext === '.py') {\r\n      let it; try { it = interp('python'); } catch { return null; }\r\n      const code = 'import ast,sys\\ntry:\\n    ast.parse(open(sys.argv[1],encoding=\"utf-8-sig\").read(),sys.argv[1])\\nexcept SyntaxError as e:\\n    print(\"SyntaxError: %s|%s\"%(e.msg,e.lineno)); sys.exit(1)\\n';\r\n      const r = await locProc(it.file, it.pre.concat(['-c', code, full]), { cwd: realBase(root), timeout: 15000, env: it.env });\r\n      if (r.code === 0 && !r.timedOut) return { ok: true, what: 'syntaxe Python' };\r\n      const m = /SyntaxError: (.*)\\|(\\d+)/.exec(r.out || ''); if (!m) return null;\r\n      return fail('syntaxe Python', 'SyntaxError: ' + m[1], +m[2]);\r\n    }\r\n    if (/^\\.(html?|xhtml)$/.test(ext)) {\r\n      const vm = require('vm'), t = fs.readFileSync(full, 'utf8'), re = /<script\\b([^>]*)>([\\s\\S]*?)<\\/script>/gi; let m, n = 0;\r\n      while ((m = re.exec(t))) {\r\n        const at = m[1]; if (/\\bsrc\\s*=/i.test(at) || !m[2].trim()) continue;\r\n        const ty = /\\btype\\s*=\\s*[\"']?([^\"'\\s>]+)/i.exec(at); if (ty && !/^(text|application)\\/(x-)?(javascript|ecmascript)$/i.test(ty[1])) continue;\r\n        n++; const startLine = t.slice(0, m.index + m[0].indexOf('>') + 1).split('\\n').length;\r\n        try { new vm.Script(m[2], { filename: rel, lineOffset: startLine - 1 }); }\r\n        catch (e) { const lm = /:(\\d+)\\s*$/.exec(String(e.stack || '').split('\\n')[0]); return fail('<script> n°' + n, e.message, lm ? +lm[1] : startLine); }\r\n      }\r\n      return n ? { ok: true, what: n + ' <script> contrôlé' + (n > 1 ? 's' : '') } : null;\r\n    }\r\n  } catch { return null; }\r\n  return null;\r\n}\r\n\r\n// ---- carte du projet (.aihub/index.json) : fichiers, tailles, dates, fonctions / classes / titres. Sans IA, sans embeddings. ----\r\nconst IDX_SKIP = /(^|\\/)(package-lock\\.json|yarn\\.lock|pnpm-lock\\.yaml|composer\\.lock)$|\\.(lock|min\\.js|min\\.css|map|png|jpe?g|gif|webp|ico|bmp|svg|woff2?|ttf|otf|eot|mp[34]|webm|mov|zip|gz|7z|rar|pdf|exe|dll|bin|sqlite|db|psd|aihubupdate)$/i;\r\nconst GEN_NAME = /^(package-lock\\.json|yarn\\.lock|pnpm-lock\\.yaml|composer\\.lock)$|\\.(lock|min\\.js|min\\.css|map|png|jpe?g|gif|webp|ico|bmp|svg|woff2?|ttf|otf|eot|mp[34]|webm|mov|zip|gz|7z|rar|pdf)$/i;\r\nconst IDX_KIND = { '.js': 'js', '.mjs': 'js', '.cjs': 'js', '.jsx': 'js', '.ts': 'js', '.tsx': 'js', '.vue': 'js', '.svelte': 'js', '.html': 'js', '.htm': 'js', '.py': 'py', '.go': 'go', '.rs': 'rs', '.java': 'cls', '.cs': 'cls', '.kt': 'cls', '.swift': 'cls', '.php': 'php', '.rb': 'rb', '.md': 'md' };\r\nfunction idxSymbols(kind, text, max) {\r\n  const L = text.split('\\n'), out = [], seen = new Set(); const add = (n, i) => { if (n && out.length < (max || 80) && !seen.has(n)) { seen.add(n); out.push([n, i + 1]); } };\r\n  for (let i = 0; i < L.length; i++) {\r\n    const l = L[i]; if (l.length > 3000) continue; let m;\r\n    if (kind === 'js') {\r\n      if ((m = /^\\s*(?:export\\s+(?:default\\s+)?)?(?:async\\s+)?function\\s*\\*?\\s*([A-Za-z_$][\\w$]*)/.exec(l))) add(m[1], i);\r\n      else if ((m = /^\\s*(?:export\\s+(?:default\\s+)?)?(?:abstract\\s+)?class\\s+([A-Za-z_$][\\w$]*)/.exec(l))) add(m[1], i);\r\n      else if ((m = /^\\s*(?:export\\s+)?(?:const|let|var)\\s+([A-Za-z_$][\\w$]*)\\s*=\\s*(?:async\\s*)?(?:function\\b|\\([^)]*\\)\\s*=>|[A-Za-z_$][\\w$]*\\s*=>)/.exec(l))) add(m[1], i);\r\n      else if ((m = /^\\s*(?:module\\.)?exports\\.([A-Za-z_$][\\w$]*)\\s*=/.exec(l))) add(m[1], i);\r\n      else if ((m = /^\\s*(?:export\\s+)?(?:interface|type|enum)\\s+([A-Za-z_$][\\w$]*)/.exec(l))) add(m[1], i);\r\n      else if ((m = /^(?:export\\s+)?const\\s+([A-Z][A-Z0-9_]{2,})\\s*=/.exec(l))) add(m[1], i);\r\n      else if ((m = /^\\s{0,4}(?:async\\s+)?([A-Za-z_$][\\w$]*)\\s*\\([^)]*\\)\\s*\\{\\s*$/.exec(l)) && !/^(if|for|while|switch|catch|function|return|else|with)$/.test(m[1])) add(m[1], i);\r\n      else if (l.length > 120) for (const mm of l.matchAll(/\\bfunction\\s+([A-Za-z_$][\\w$]*)\\s*\\(/g)) add(mm[1], i);     // code écrit sur de très longues lignes\r\n    } else if (kind === 'py') { if ((m = /^\\s*(?:async\\s+)?def\\s+(\\w+)/.exec(l)) || (m = /^\\s*class\\s+(\\w+)/.exec(l))) add(m[1], i); }\r\n    else if (kind === 'go') { if ((m = /^func\\s+(?:\\([^)]*\\)\\s*)?(\\w+)/.exec(l)) || (m = /^type\\s+(\\w+)/.exec(l))) add(m[1], i); }\r\n    else if (kind === 'rs') { if ((m = /^\\s*(?:pub(?:\\([^)]*\\))?\\s+)?(?:async\\s+)?fn\\s+(\\w+)/.exec(l)) || (m = /^\\s*(?:pub\\s+)?(?:struct|enum|trait)\\s+(\\w+)/.exec(l))) add(m[1], i); }\r\n    else if (kind === 'cls') { if ((m = /\\b(?:class|interface|enum|struct|record|object)\\s+([A-Za-z_]\\w*)/.exec(l))) add(m[1], i); else if ((m = /^\\s*(?:public|private|protected|internal|static|override|fun|func)\\b[^=;(]*?\\s(\\w+)\\s*\\(/.exec(l))) add(m[1], i); }\r\n    else if (kind === 'php') { if ((m = /\\bfunction\\s+(\\w+)/.exec(l)) || (m = /^\\s*(?:abstract\\s+|final\\s+)?class\\s+(\\w+)/.exec(l))) add(m[1], i); }\r\n    else if (kind === 'rb') { if ((m = /^\\s*def\\s+([\\w.?!]+)/.exec(l)) || (m = /^\\s*(?:class|module)\\s+(\\w+)/.exec(l))) add(m[1], i); }\r\n    else if (kind === 'md') { if ((m = /^#{1,3}\\s+(.{2,60})$/.exec(l))) add(m[1].trim(), i); }\r\n  }\r\n  return out;\r\n}\r\nfunction idxRole(text, kind) {\r\n  if (kind === 'js' && /<title>/i.test(text.slice(0, 4000))) { const t = /<title>([^<]{3,70})/i.exec(text); if (t) return t[1].trim(); }\r\n  for (const l0 of text.split('\\n').slice(0, 14)) {\r\n    const l = l0.trim(); let m;\r\n    if (kind === 'md' && (m = /^#\\s+(.+)$/.exec(l))) return m[1].slice(0, 70);\r\n    if ((m = /^(?:\\/\\/+|#(?!!)|--|;|\\*|\\/\\*+!?|<!--)\\s*(.{8,})$/.exec(l))) { const r = m[1].replace(/\\*\\/\\s*$|-->\\s*$/, '').trim(); if (r.length >= 8 && !/^(use strict|eslint|@ts-|global |-\\*-|vim:|shellcheck|copyright|license|tslint|prettier)/i.test(r)) return r.slice(0, 70); }\r\n    if (kind === 'py' && (m = /^\"\"\"\\s*(.{8,}?)\\s*(\"\"\"|$)/.exec(l))) return m[1].slice(0, 70);\r\n  }\r\n  return '';\r\n}\r\nconst idxPath = (root) => path.join(aihDir(root), 'index.json');\r\nfunction idxLoad(root) { try { const j = JSON.parse(fs.readFileSync(idxPath(root), 'utf8')); if (j && j.v === 1 && j.files && typeof j.files === 'object') return j; } catch {} return { v: 1, files: {} }; }\r\nfunction idxUpdate(root) {\r\n  const base = realBase(root), idx = idxLoad(root), seen = new Set(); let n = 0, changed = false, budget = 60 * 1024 * 1024;\r\n  for (const x of locWalk(base, base, 10)) {\r\n    if (x.e.isDirectory()) continue; if (++n > 4000) break;\r\n    if (IDX_SKIP.test(x.rel)) continue;\r\n    let st; try { st = fs.statSync(x.full); } catch { continue; }\r\n    const old = idx.files[x.rel], m = Math.floor(st.mtimeMs);\r\n    if (old && old.m === m && old.s === st.size) { seen.add(x.rel); continue; }\r\n    if (budget <= 0) continue;                       // gros dossier : le reste sera indexé à la prochaine demande\r\n    seen.add(x.rel);\r\n    const e = { m, s: st.size, y: [], r: '', l: 0 };\r\n    if (st.size <= 400 * 1024) {\r\n      if (locIsBinary(x.full)) e.b = 1;\r\n      else { let text = ''; try { text = fs.readFileSync(x.full, 'utf8'); budget -= text.length; } catch {} const kind = IDX_KIND[path.extname(x.rel).toLowerCase()]; if (kind) e.y = idxSymbols(kind, text); e.r = idxRole(text, kind); e.l = nLines(text); }\r\n    }\r\n    idx.files[x.rel] = e; changed = true;\r\n  }\r\n  for (const k of Object.keys(idx.files)) if (!seen.has(k)) { delete idx.files[k]; changed = true; }\r\n  if (changed) { try { const d = aihDir(root); fs.mkdirSync(d, { recursive: true }); const tmp = idxPath(root) + '.tmp'; fs.writeFileSync(tmp, JSON.stringify(idx)); fs.renameSync(tmp, idxPath(root)); } catch {} }\r\n  return idx;\r\n}\r\nconst IDX_STOP = new Set('le la les un une des de du et ou en dans sur pour par avec sans que qui est sont fais fait faire peux peut veux voudrais merci stp svp ce cet cette ces mon ma mes ton ta tes son sa ses notre votre leur leurs nous vous ils elles mais donc car ni ne pas plus tres aussi comme tout tous toute toutes fichier fichiers code projet dossier modifie modifier corrige corriger ajoute ajouter cree creer supprime supprimer change changer the and for with that this from into please can you make fix add create update remove file files folder'.split(' '));\r\nconst idxNorm = (s) => String(s || '').normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toLowerCase();\r\nfunction idxTokens(q) {\r\n  const out = new Set();\r\n  for (const w of String(q || '').split(/[^\\p{L}\\p{N}_.\\/-]+/u)) {\r\n    if (!w) continue; const n = idxNorm(w); if (n.length >= 3 && !IDX_STOP.has(n)) out.add(n);\r\n    for (const p of w.replace(/([a-z0-9])([A-Z])/g, '$1 $2').split(/[_.\\/\\- ]+/)) { const pn = idxNorm(p); if (pn.length >= 3 && !IDX_STOP.has(pn)) out.add(pn); }\r\n  }\r\n  return [...out].slice(0, 24);\r\n}\r\nfunction idxScore(rel, e, toks, qn) {\r\n  if (e.b) return 0;\r\n  const rl = rel.toLowerCase(), bn = path.basename(rl); let s = 0;\r\n  if (qn.includes(rl) || (bn.length >= 4 && bn.includes('.') && qn.includes(bn))) s += 20;\r\n  for (const t of toks) {\r\n    if (bn.includes(t)) s += 5; else if (rl.includes(t)) s += 2;\r\n    for (const [nm] of (e.y || [])) { const n = nm.toLowerCase(); if (n === t) { s += 6; break; } if (t.length >= 4 && n.includes(t)) { s += 3; break; } }\r\n  }\r\n  return s;\r\n}\r\nfunction idxMap(idx, n) {\r\n  const now = Date.now(), ent = [];\r\n  for (const [rel, e] of Object.entries(idx.files)) {\r\n    if (e.b || /^(license|licence|changelog|\\.gitignore|\\.gitattributes)/i.test(path.basename(rel))) continue;\r\n    const depth = rel.split('/').length - 1, bn = path.basename(rel).toLowerCase(); let sc = -10 * depth;\r\n    if (/^(package\\.json|readme|main\\.|index\\.|app\\.|server\\.|manifest|pyproject|cargo\\.toml|go\\.mod)/.test(bn)) sc += 50;\r\n    if (IDX_KIND[path.extname(bn)]) sc += 10;\r\n    if (now - e.m < 7 * 864e5) sc += 8;\r\n    sc += Math.min(8, Math.log2(1 + (e.l || 0)));\r\n    ent.push([rel, e, sc]);\r\n  }\r\n  ent.sort((a, b) => b[2] - a[2]);\r\n  return ent.slice(0, n).map(([rel, e]) => { const role = e.r || (e.y || []).slice(0, 4).map(x => x[0]).join(', ') || (e.l ? e.l + ' lignes' : ''); return (rel + (role ? ' — ' + role : '')).slice(0, 120); }).join('\\n');\r\n}\r\nfunction idxPre(root, idx, q, cap) {\r\n  const toks = idxTokens(q), qn = idxNorm(q), base = realBase(root), files = []; let used = 0, pre = '';\r\n  if (!toks.length || cap < 800) return { pre: '', files: [] };\r\n  if (CTX_ON) { try { const r = ctxPre(root, q, cap); if (r) return r; } catch {} }\r\n  const ranked = Object.entries(idx.files).map(([rel, e]) => [rel, e, idxScore(rel, e, toks, qn)]).filter(x => x[2] >= 4).sort((a, b) => b[2] - a[2]).slice(0, 4);\r\n  for (const [rel, e] of ranked) {\r\n    const remain = cap - used; if (remain < 600) break;\r\n    if (e.s > 400 * 1024) continue;\r\n    let text; try { text = fs.readFileSync(path.join(base, rel), 'utf8'); } catch { continue; }\r\n    const L = text.split('\\n'), N = L.length; let block = '';\r\n    if (text.length <= Math.min(remain - 120, Math.max(2500, Math.floor(cap / 3)))) block = '=== ' + rel + ' (' + N + ' lignes, fichier entier) ===\\n' + text;\r\n    else {\r\n      const hit = new Set(); const win = (a, b) => { for (let i = Math.max(0, a); i < Math.min(N, b); i++) hit.add(i); };\r\n      for (const [nm, ln] of (e.y || [])) { const n = nm.toLowerCase(); if (toks.some(t => n === t || (t.length >= 4 && n.includes(t)))) win(ln - 3, ln + 28); }\r\n      if (!hit.size) { let c = 0; for (let i = 0; i < N && c < 3; i++) { const l = L[i].toLowerCase(); if (L[i].length < 600 && toks.some(t => t.length >= 4 && l.includes(t))) { win(i - 8, i + 12); c++; } } }\r\n      if (!hit.size) win(0, 40);\r\n      const idxs = [...hit].sort((a, b) => a - b), parts = []; let a0 = -1, prev = -2;\r\n      for (const i of idxs) { if (i !== prev + 1) { if (a0 >= 0) parts.push([a0, prev]); a0 = i; } prev = i; } if (a0 >= 0) parts.push([a0, prev]);\r\n      const segs = []; let room = remain - 140;\r\n      for (const [a, b] of parts) { let seg = L.slice(a, b + 1).join('\\n'); if (seg.length > room) seg = seg.slice(0, Math.max(0, room)); if (seg.length < 80) break; segs.push('=== ' + rel + ' (lignes ' + (a + 1) + '-' + (b + 1) + ' sur ' + N + ') ===\\n' + seg); room -= seg.length + 60; if (room < 200) break; }\r\n      block = segs.join('\\n');\r\n    }\r\n    if (!block) continue;\r\n    pre += (pre ? '\\n' : '') + block; used += block.length; files.push(rel); seenMark(root, rel, path.join(base, rel));\r\n  }\r\n  return { pre: pre ? 'PRÉ-LECTURE (extraits des fichiers les plus probables, déjà lus : ne les relis pas avec @read, utilise-les directement) :\\n' + pre + '\\n' : '', files };\r\n}\r\nfunction projHasTest(root) {\r\n  try { const j = JSON.parse(fs.readFileSync(path.join(realBase(root), 'package.json'), 'utf8')), t = j && j.scripts && j.scripts.test; return !!t && !/no test specified/i.test(t); } catch { return false; }\r\n}\r\n\r\n// Remplacement d'un texte dans un fichier (@edit CHERCHE / REMPLACE) : exact d'abord, puis comparaison normalisée\r\n// (indentation, espaces de fin de ligne) avec réécriture à l'indentation du fichier ; si plusieurs endroits : numéros de lignes.\r\nfunction editPair(txt, p, i, rel) {\r\n  const n = countOcc(txt, p.s), nb = 'n°' + (i + 1);\r\n  if (n === 1) return txt.replace(p.s, () => p.r);\r\n  if (n > 1) { const ls = occLines(txt, p.s); throw new Error('texte CHERCHE ' + nb + ' apparaît ' + n + ' fois dans ' + rel + ' (lignes ' + ls.slice(0, 8).join(', ') + (n > 8 ? '…' : '') + ') (aucun fichier modifié) : ajoute des lignes autour pour le rendre unique, ou @read la zone puis @edit ' + rel + ' lignes ' + ls[0] + '-' + (ls[0] + nLines(p.s) - 1)); }\r\n  const F = txt.split('\\n'), S = p.s.replace(/\\r/g, '').split('\\n');\r\n  while (S.length && !S[0].trim()) S.shift(); while (S.length && !S[S.length - 1].trim()) S.pop();\r\n  const nz = (x) => x.trim().replace(/\\s+/g, ' '), Sn = S.map(nz), hits = [];\r\n  for (let i0 = 0; S.length && i0 + S.length <= F.length; i0++) { let ok = true; for (let j = 0; j < S.length; j++) if (nz(F[i0 + j]) !== Sn[j]) { ok = false; break; } if (ok) hits.push(i0); }\r\n  if (!hits.length) throw new Error('texte CHERCHE ' + nb + ' introuvable dans ' + rel + ' (aucun fichier modifié) : relis la zone avec @read puis recopie le texte exactement, ou utilise @edit ' + rel + ' lignes début-fin');\r\n  if (hits.length > 1) throw new Error('texte CHERCHE ' + nb + ' apparaît ' + hits.length + ' fois dans ' + rel + ' (indentation ignorée ; lignes ' + hits.slice(0, 8).map(h => h + 1).join(', ') + ') (aucun fichier modifié) : ajoute des lignes autour pour le rendre unique');\r\n  const h = hits[0], ind = (x) => /^[ \\t]*/.exec(x)[0], fInd = ind(F[h]), sInd = ind(S.find(x => x.trim()));\r\n  // correspondance indentation de la recherche -> indentation réelle du fichier (ligne par ligne)\r\n  const mp = new Map(); for (let j = 0; j < S.length; j++) { if (!S[j].trim()) continue; const si = ind(S[j]); if (!mp.has(si)) mp.set(si, ind(F[h + j])); }\r\n  const keys = [...mp.keys()].sort((x, y) => y.length - x.length);\r\n  let R = p.r.replace(/\\r/g, '').split('\\n'); while (R.length && !R[0].trim()) R.shift(); while (R.length && !R[R.length - 1].trim()) R.pop();\r\n  R = R.map(l => { if (!l.trim()) return ''; const li = ind(l), rest = l.slice(li.length); if (mp.has(li)) return mp.get(li) + rest; const k = keys.find(x => li.startsWith(x)); return k !== undefined ? mp.get(k) + li.slice(k.length) + rest : fInd + li + rest; });\r\n  F.splice(h, S.length, ...R);\r\n  return F.join('\\n');\r\n}\r\n\r\n// ---- 4.2.0 : économie de crédits ----\r\n// Lectures groupées, plan de fichier (@outline), lecture d'une seule fonction (fn:nom), cache « déjà lu, inchangé »,\r\n// recherche groupée par fichier, remplacement multi-fichiers (@replace), sorties de commandes compactées.\r\nconst LOC_RCACHE = new Map();\r\nconst LOC_ANSI = /\\x1b\\[[0-9;?]*[ -\\/]*[@-~]/g;\r\nconst cutTxt = (x, n) => { x = String(x == null ? '' : x).trim().replace(/\\s+/g, ' '); return x.length > n ? x.slice(0, n - 1) + '…' : x; };\r\n// Nettoie la sortie d'une commande : couleurs, barres de progression, avertissements npm, lignes identiques répétées.\r\n// Au-delà de cap : on garde le début, la FIN (le résumé y est presque toujours) et les lignes d'erreur avec leur contexte.\r\nfunction locSmart(out, cap) {\r\n  let s = String(out == null ? '' : out).replace(LOC_ANSI, '').replace(/\\r\\n/g, '\\n').replace(/\\r/g, '\\n');\r\n  const before = s.length;\r\n  const NOISE = /^\\s*(npm (WARN|warn|notice)\\b|\\(node:\\d+\\) |[⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏]|\\d{1,3}%\\s)/;\r\n  const L = [];\r\n  for (const l0 of s.split('\\n')) {\r\n    const l = l0.replace(/[ \\t]+$/, '');\r\n    if (NOISE.test(l)) continue;\r\n    const last = L.length - 1;\r\n    if (last >= 0 && l && L[last].t === l) { L[last].n++; continue; }\r\n    L.push({ t: l, n: 1 });\r\n  }\r\n  let lines = L.map(x => x.n > 1 ? x.t + '  (×' + x.n + ')' : x.t);\r\n  while (lines.length && !lines[0].trim()) lines.shift();\r\n  while (lines.length && !lines[lines.length - 1].trim()) lines.pop();\r\n  const prev = lines; lines = prev.filter((l, i) => l.trim() || (i && prev[i - 1].trim()));\r\n  let res = lines.join('\\n');\r\n  if (res.length > cap) {\r\n    const ln = res.split('\\n'), N = ln.length, keep = new Set();\r\n    const add = (a, b) => { for (let i = Math.max(0, a); i < Math.min(N, b); i++) keep.add(i); };\r\n    let tn = 0, tl = 0; while (tn < N && tl < cap * .35) { tl += ln[N - 1 - tn].length + 1; tn++; } add(N - tn, N);\r\n    let hn = 0, hl = 0; while (hn < N && hl < cap * .2) { hl += ln[hn].length + 1; hn++; } add(0, hn);\r\n    let used = 0; for (const i of keep) used += ln[i].length + 1;\r\n    const ERR = /(error|erreur|fail|✕|✖|exception|traceback|assert|expected|received|cannot |can't |not found|undefined|warning:|\\bat .*:\\d+:\\d+)/i;\r\n    for (let i = 0; i < N && used < cap * .95; i++) { if (keep.has(i) || !ERR.test(ln[i])) continue; for (let k = Math.max(0, i - 1); k <= Math.min(N - 1, i + 1); k++) if (!keep.has(k)) { keep.add(k); used += ln[k].length + 1; } }\r\n    const o = []; let last = -1;\r\n    for (let i = 0; i < N; i++) { if (!keep.has(i)) continue; if (i !== last + 1) o.push('[… ' + (i - last - 1) + ' lignes omises …]'); o.push(ln[i].length > 400 ? ln[i].slice(0, 400) + '…' : ln[i]); last = i; }\r\n    if (last < N - 1) o.push('[… ' + (N - 1 - last) + ' lignes omises …]');\r\n    res = o.join('\\n');\r\n  }\r\n  return { out: res, saved: Math.max(0, before - res.length) };\r\n}\r\n// Fichiers protégés par les règles du projet (même logique que côté interface) : @replace ne touche jamais à un fichier interdit.\r\nfunction locForbid(forbid, rel) {\r\n  const L = String(forbid || '').split(/[\\n,;]+/).map(x => x.trim().replace(/\\\\/g, '/').replace(/^\\.\\//, '')).filter(Boolean); if (!L.length) return '';\r\n  const p = String(rel || '').trim().replace(/\\\\/g, '/').replace(/^\\.\\//, ''); if (!p) return '';\r\n  const segs = p.split('/'), bn = segs[segs.length - 1];\r\n  const gre = g => new RegExp('^' + String(g).replace(/[.+^${}()|[\\]\\\\]/g, '\\\\$&').replace(/\\*\\*/g, '\\u0001').replace(/\\*/g, '[^/]*').replace(/\\u0001/g, '.*').replace(/\\?/g, '[^/]') + '$', 'i');\r\n  for (const g of L) {\r\n    const dir = g.endsWith('/'), gg = dir ? g.slice(0, -1) : g;\r\n    if (dir) { if (p === gg || p.startsWith(gg + '/') || (!gg.includes('/') && segs.includes(gg))) return g; }\r\n    else if (gg.includes('/')) { if (gre(gg).test(p) || p.startsWith(gg + '/')) return g; }\r\n    else if (gre(gg).test(bn) || segs.includes(gg)) return g;\r\n  }\r\n  return '';\r\n}\r\n// Motif de définition d'un symbole (fonction, classe, constante, titre markdown…) pour @read chemin fn:nom\r\nfunction locSymRe(name) {\r\n  const n = String(name).replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\r\n  return new RegExp(\r\n    '(?:\\\\b(?:function\\\\*?|class|interface|enum|struct|trait|type|def|func|fn|object|record|module)\\\\s+(?:\\\\([^)]*\\\\)\\\\s*)?' + n + '\\\\b)' +\r\n    '|(?:\\\\b(?:const|let|var)\\\\s+' + n + '\\\\s*=)' +\r\n    '|(?:^\\\\s*(?:export\\\\s+)?(?:async\\\\s+)?(?:static\\\\s+)?' + n + '\\\\s*(?:=\\\\s*(?:async\\\\s*)?(?:function\\\\b|\\\\([^)]*\\\\)\\\\s*=>|[\\\\w$]+\\\\s*=>)|\\\\([^)]*\\\\)\\\\s*(?::\\\\s*[\\\\w<>\\\\[\\\\], |]+)?\\\\s*\\\\{))' +\r\n    '|(?:^\\\\s*#{1,6}\\\\s+.*\\\\b' + n + '\\\\b)' +\r\n    '|(?:\\\\b' + n + '\\\\s*[:=]\\\\s*(?:async\\\\s*)?function\\\\b)' +\r\n    '|(?:^\\\\s*(?:module\\\\.)?exports\\\\.' + n + '\\\\s*=)');\r\n}\r\n// Dernière ligne du bloc qui commence à la ligne i (indentation pour Python, titres pour Markdown, accolades sinon)\r\nfunction locSymEnd(L, i, ext) {\r\n  const ind = x => /^[ \\t]*/.exec(x)[0].replace(/\\t/g, '    ').length, first = L[i];\r\n  if (ext === '.py' || (/^\\s*(async\\s+)?(def|class)\\b/.test(first) && !first.includes('{'))) {\r\n    const base = ind(first); let last = i;\r\n    for (let j = i + 1; j < L.length; j++) { if (!L[j].trim()) continue; if (ind(L[j]) <= base && !/^\\s*[)\\]}]/.test(L[j])) break; last = j; }\r\n    return last;\r\n  }\r\n  if (ext === '.md' || /^\\s*#{1,6}\\s/.test(first)) {\r\n    const lv = (/^\\s*(#+)/.exec(first) || ['', '#'])[1].length; let j = i + 1;\r\n    for (; j < L.length; j++) { const m = /^\\s*(#+)\\s/.exec(L[j]); if (m && m[1].length <= lv) break; }\r\n    return j - 1;\r\n  }\r\n  let depth = 0, seen = false;\r\n  for (let j = i; j < Math.min(L.length, i + 600); j++) {\r\n    const l = L[j].length > 3000 ? '' : L[j].replace(/([\"'`])(?:\\\\.|(?!\\1).)*\\1/g, '\"\"').replace(/\\/\\/.*$/, '');\r\n    for (const ch of l) { if (ch === '{') { depth++; seen = true; } else if (ch === '}') { depth--; if (seen && depth <= 0) return j; } }\r\n    if (!seen && j >= i + 6) break;\r\n  }\r\n  return Math.min(L.length - 1, i + 40);\r\n}\r\n// Lecture d'un fichier : plage début-fin, fonction (spec.sym) ou entier ; cache « déjà lu, inchangé » par conversation.\r\n// 5.1.0 : @read joint les définitions des fonctions appelées (index local) : l'IA n'a plus besoin d'un tour de lecture de suivi. Désactivable : créer .aihub/deps-off\r\nconst DEP_KIND = { js: 'js', mjs: 'js', cjs: 'js', jsx: 'js', ts: 'js', tsx: 'js', py: 'py', go: 'go', rs: 'rs', java: 'cls', kt: 'cls', cs: 'cls', php: 'php', rb: 'rb' };\r\nconst DEP_MAP = new Map();\r\nfunction depMap(root) {\r\n  const base = realBase(root), c0 = DEP_MAP.get(base);\r\n  if (c0 && Date.now() - c0.at < 30000) return c0.map;\r\n  const map = new Map(); let bytes = 0, n = 0;\r\n  try {\r\n    for (const rel of Object.keys(idxLoad(root).files)) {\r\n      const k = DEP_KIND[path.extname(rel).slice(1).toLowerCase()]; if (!k) continue;\r\n      if (++n > 1500 || bytes > 30e6) break;\r\n      let t; try { const full = path.join(base, rel), st = fs.statSync(full); if (st.size > 300000) continue; bytes += st.size; t = fs.readFileSync(full, 'utf8'); } catch { continue; }\r\n      for (const [nm, ln] of idxSymbols(k, t, 300)) if (!map.has(nm)) map.set(nm, [rel, ln]);\r\n    }\r\n  } catch {}\r\n  DEP_MAP.set(base, { at: Date.now(), map }); return map;\r\n}\r\nconst DEP_KW = new Set(['if', 'for', 'while', 'switch', 'catch', 'function', 'return', 'else', 'with', 'new', 'typeof', 'await', 'async', 'require', 'console', 'push', 'join', 'map', 'filter', 'forEach', 'slice', 'split', 'test', 'exec', 'replace', 'includes', 'indexOf', 'trim', 'toString', 'String', 'Number', 'Boolean', 'Array', 'Object', 'Promise', 'Error', 'JSON', 'Math', 'Date', 'Set', 'Map', 'parseInt', 'parseFloat', 'setTimeout', 'setInterval', 'print', 'range', 'len', 'self', 'super', 'this']);\r\nfunction locDeps(root, rel, body, from, to, zone) {\r\n  try {\r\n    if (!zone || body.length > 12000) return '';\r\n    const k = DEP_KIND[path.extname(rel).slice(1).toLowerCase()]; if (!k) return '';\r\n    if (fs.existsSync(path.join(aihDir(root), 'deps-off'))) return '';\r\n    const own = new Set(idxSymbols(k, body, 300).map(x => x[0])), map = depMap(root), seen = new Set(), parts = []; let size = 0;\r\n    for (const mm of body.matchAll(/\\b([A-Za-z_$][\\w$]{3,})\\s*\\(/g)) {\r\n      const nm = mm[1]; if (seen.has(nm) || own.has(nm) || DEP_KW.has(nm)) continue; seen.add(nm);\r\n      const d = map.get(nm); if (!d) continue; if (d[0] === rel && d[1] >= from && d[1] <= to) continue;\r\n      let t; try { t = fs.readFileSync(path.join(realBase(root), d[0]), 'utf8').split(/\\r?\\n/); } catch { continue; }\r\n      const chunk = t.slice(d[1] - 1, d[1] + 7).map(x => x.slice(0, 160)).join('\\n');\r\n      if (size + chunk.length > 1800) break; size += chunk.length; parts.push('--- ' + nm + ' : ' + d[0] + ':' + d[1] + ' ---\\n' + chunk);\r\n      if (parts.length >= 6) break;\r\n    }\r\n    return parts.length ? '\\n\\n[DÉFINITIONS LIÉES (jointes par AI Hub, ne les relis pas)]\\n' + parts.join('\\n') : '';\r\n  } catch { return ''; }\r\n}\r\nfunction locReadFile(root, relArg, spec, c, force) {\r\n  const s = locSafe(root, relArg); let st; try { st = fs.statSync(s.full); } catch { throw new Error(s.rel + ' n\\'existe pas'); }\r\n  if (st.isDirectory()) throw new Error('c\\'est un dossier : utilise @tree ' + s.rel);\r\n  if (locIsBinary(s.full)) throw new Error('fichier binaire (' + st.size + ' octets) : lecture refusée, utilise @stat');\r\n  const rg = /^(\\d+)?-(\\d+)?$/.exec(spec.range || ''), single = /^\\d+$/.test(spec.range || ''), range = !!rg || single;\r\n  if (st.size > LOC_MAXFILE * 5 && !rg && !spec.sym) throw new Error('fichier trop gros (' + Math.round(st.size / 1024) + ' Ko) : utilise @outline ' + s.rel + ' puis @read ' + s.rel + ' début-fin (ou fn:nom), ou @grep');\r\n  const sess = c && c.opts && c.opts.sess, tag = spec.sym ? 'fn:' + spec.sym : (spec.range || '');\r\n  const ck = sess ? sess + '|' + realBase(root) + '|' + s.rel + '|' + (tag || '*') : '';\r\n  if (ck && !force) {\r\n    const o = LOC_RCACHE.get(ck);\r\n    if (o && o.m === st.mtimeMs && o.s === st.size) {\r\n      seenMark(root, s.rel, s.full);\r\n      return { title: 'read ' + s.rel + (tag ? ' ' + tag : '') + ' (déjà lu, inchangé)', out: '(identique à ta lecture précédente dans cette conversation, fichier inchangé : réutilise ce que tu as déjà. Pour le recevoir à nouveau : @read -f ' + s.rel + (spec.range ? ' ' + spec.range : '') + ')', saved: o.len };\r\n    }\r\n  }\r\n  const lines = fs.readFileSync(s.full, 'utf8').split(/\\r?\\n/);\r\n  let from = 1, to = lines.length, cond = '', label = '';\r\n  if (spec.sym) {\r\n    const re = locSymRe(spec.sym), ext = path.extname(s.rel).toLowerCase(), hits = [];\r\n    for (let i = 0; i < lines.length; i++) { if (lines[i].length > 4000) continue; if (re.test(lines[i])) hits.push(i); }\r\n    if (!hits.length) throw new Error('« ' + spec.sym + ' » introuvable dans ' + s.rel + ' : essaie @outline ' + s.rel + ' ou @grep ' + spec.sym);\r\n    const i0 = hits[0], e0 = Math.min(locSymEnd(lines, i0, ext), i0 + 399);\r\n    from = i0 + 1; to = e0 + 1; label = ', ' + spec.sym + (hits.length > 1 ? ', autres définitions : lignes ' + hits.slice(1, 6).map(x => x + 1).join('/') : '');\r\n  } else if (rg) { from = Math.max(1, parseInt(rg[1], 10) || 1); to = Math.min(lines.length, parseInt(rg[2], 10) || lines.length); }\r\n  else if (single) { from = Math.max(1, parseInt(spec.range, 10)); }\r\n  if (from > lines.length) throw new Error('ligne ' + from + ' hors du fichier (' + lines.length + ' lignes)');\r\n  let body = lines.slice(from - 1, to).join('\\n');\r\n  // fichier long lu en entier : on garde le début, la fin et les lignes qui contiennent les mots de la demande\r\n  const toks = ((c && c.opts && c.opts.focus) || []).map(x => String(x).toLowerCase()).filter(x => x.length >= 3).slice(0, 12);\r\n  if (!range && !spec.sym && body.length > 20000 && toks.length) {\r\n    const keep = new Set(), win = (x, y) => { for (let i = Math.max(0, x); i < Math.min(lines.length, y); i++) keep.add(i); };\r\n    win(0, 60); win(lines.length - 40, lines.length); let size = 0; for (const i of keep) size += lines[i].length + 1;\r\n    for (let i = 0; i < lines.length && size < 16000; i++) { if (keep.has(i) || lines[i].length > 800) continue; const l = lines[i].toLowerCase(); if (toks.some(x => l.includes(x))) { const add = []; for (let k = Math.max(0, i - 3); k < Math.min(lines.length, i + 4); k++) if (!keep.has(k)) add.push(k); for (const k of add) { keep.add(k); size += lines[k].length + 1; } } }\r\n    const out = []; let last = -1;\r\n    for (let i = 0; i < lines.length; i++) { if (!keep.has(i)) continue; if (i !== last + 1) out.push('[… lignes ' + (last + 2) + '-' + i + ' omises …]'); out.push(lines[i]); last = i; }\r\n    if (last < lines.length - 1) out.push('[… lignes ' + (last + 2) + '-' + lines.length + ' omises …]');\r\n    body = '[fichier long : début, fin et lignes proches de la demande. Pour une zone précise : @outline ' + s.rel + ' puis @read ' + s.rel + ' début-fin ou fn:nom]\\n' + out.join('\\n'); cond = ', condensé';\r\n  }\r\n  seenMark(root, s.rel, s.full);\r\n  const deps = locDeps(root, s.rel, body, from, to, !!(range || spec.sym)); if (ck) { LOC_RCACHE.set(ck, { m: st.mtimeMs, s: st.size, len: body.length }); if (LOC_RCACHE.size > 600) LOC_RCACHE.delete(LOC_RCACHE.keys().next().value); }\r\n  if (spec.num && !cond) body = lines.slice(from - 1, to).map((l, i) => (from + i) + '│ ' + l).join('\\n');\r\n  return { title: 'read ' + s.rel + ' (' + (to - from + 1) + ' lignes' + (range || spec.sym ? ', ' + from + '-' + to : '') + ' sur ' + lines.length + cond + label + ')', out: body + deps };\r\n}\r\n// Plan d'un fichier : une ligne par fonction / classe / titre / clé, avec son numéro de ligne.\r\nfunction locOutline(root, relArg) {\r\n  const s = locSafe(root, relArg); let st; try { st = fs.statSync(s.full); } catch { throw new Error(s.rel + ' n\\'existe pas'); }\r\n  if (st.isDirectory()) throw new Error(s.rel + ' est un dossier : utilise @tree ' + s.rel);\r\n  if (locIsBinary(s.full)) throw new Error(s.rel + ' est binaire');\r\n  if (st.size > 3 * 1024 * 1024) throw new Error(s.rel + ' est trop gros (' + Math.round(st.size / 1024) + ' Ko) : utilise @grep');\r\n  const text = fs.readFileSync(s.full, 'utf8'), L = text.split(/\\r?\\n/), ext = path.extname(s.rel).toLowerCase(), kind = IDX_KIND[ext], out = [];\r\n  let n = 0;\r\n  if (ext === '.json') {\r\n    try { const j = JSON.parse(text.replace(/^\\uFEFF/, '')); const ks = Array.isArray(j) ? ['(tableau de ' + j.length + ' éléments)'] : Object.keys(j).slice(0, 80).map(k => k + ' : ' + (Array.isArray(j[k]) ? 'tableau[' + j[k].length + ']' : j[k] && typeof j[k] === 'object' ? 'objet{' + Object.keys(j[k]).length + '}' : typeof j[k])); for (const k of ks) { out.push(k); n++; } }\r\n    catch (e) { out.push('(JSON invalide : ' + cutTxt(e.message, 100) + ')'); }\r\n  } else if (ext === '.css' || ext === '.scss' || ext === '.less') {\r\n    for (let i = 0; i < L.length && n < 160; i++) { const m = /^([^\\s@}{/*][^{]{0,100})\\{\\s*/.exec(L[i]) || /^(@(?:media|keyframes|font-face)[^{]{0,80})\\{/.exec(L[i]); if (m) { out.push((i + 1) + '  ' + cutTxt(m[1], 90)); n++; } }\r\n  } else if (kind) {\r\n    for (const [nm, ln] of idxSymbols(kind, text, 220)) { const src = L[ln - 1] || ''; out.push(ln + '  ' + (src.length > 170 ? nm + '  (ligne très longue)' : cutTxt(src, 100))); n++; }\r\n    out.sort((x, y) => parseInt(x, 10) - parseInt(y, 10));\r\n    if (/^\\.(html?|vue|svelte)$/.test(ext)) for (let i = 0; i < L.length; i++) { const m = /<(script|style)\\b/i.exec(L[i]); if (m) { let j = i; const cl = new RegExp('</' + m[1] + '>', 'i'); while (j < L.length && !cl.test(L[j])) j++; out.unshift('<' + m[1].toLowerCase() + '> lignes ' + (i + 1) + '-' + (j + 1)); i = j; } }\r\n  }\r\n  const total = out.length, shown = out.slice(0, 170);\r\n  if (total > 170) shown.push('… (+' + (total - 170) + ' autres)');\r\n  return { rel: s.rel, text: '=== ' + s.rel + ' (' + L.length + ' lignes, ' + Math.round(st.size / 1024 * 10) / 10 + ' Ko, ' + total + ' repères) ===\\n' + (shown.join('\\n') || 'aucun repère détecté : @read ' + s.rel + ' 1-60 ou @grep texte ' + s.rel), n: total };\r\n}\r\n\r\n// <CTX> Contexte ULTRA (4.10) : index local BM25 + vecteurs hachés + synonymes FR/EN. Aucun réseau, aucun crédit. Données : .aihub/ctx.json (v:2)\r\nconst CTX_DIM = 128, CTX_MAXCHUNKS = 60000, CTX_FILE_MAX = 1536 * 1024;   // plus large que l'ancien index (400 Ko) : les gros fichiers d'interface sont découpés en blocs\r\nconst CTX_GROUPS = [\r\n  ['connexion', 'login', 'signin', 'auth', 'authentification', 'authenticate', 'session', 'logout', 'deconnexion'],\r\n  ['supprimer', 'delete', 'remove', 'effacer', 'suppression', 'retirer'],\r\n  ['erreur', 'error', 'bug', 'exception', 'echec', 'fail', 'failure', 'crash', 'plantage'],\r\n  ['dossier', 'folder', 'directory', 'repertoire'],\r\n  ['envoyer', 'send', 'envoi', 'submit', 'poster', 'post'],\r\n  ['lire', 'read', 'lecture', 'charger', 'load', 'ouvrir', 'open'],\r\n  ['ecrire', 'write', 'ecriture', 'sauvegarder', 'save', 'enregistrer', 'sauvegarde'],\r\n  ['chercher', 'search', 'find', 'recherche', 'trouver', 'grep'],\r\n  ['compte', 'account', 'cle', 'key', 'token'],\r\n  ['limite', 'limit', 'quota', 'plafond'],\r\n  ['afficher', 'display', 'show', 'render', 'dessiner', 'draw', 'affichage'],\r\n  ['message', 'msg', 'chat', 'conversation', 'discussion'],\r\n  ['maj', 'update', 'upgrade', 'miseajour', 'patch', 'version'],\r\n  ['reponse', 'response', 'reply', 'answer', 'resultat', 'result'],\r\n  ['parametre', 'setting', 'settings', 'config', 'configuration', 'option', 'reglage', 'preference'],\r\n  ['fenetre', 'window', 'dialog', 'dialogue', 'popup', 'modal'],\r\n  ['bouton', 'button', 'btn', 'clic', 'click'],\r\n  ['image', 'img', 'photo', 'picture', 'capture', 'screenshot'],\r\n  ['piece', 'attach', 'attachment', 'joint', 'upload', 'televerser'],\r\n  ['file', 'queue', 'attente', 'pending'],\r\n  ['style', 'css', 'couleur', 'color', 'theme', 'design'],\r\n  ['test', 'verifier', 'verify', 'check', 'controle', 'validation', 'valider'],\r\n];\r\nconst CTX_GRP = new Map(); CTX_GROUPS.forEach((g, i) => g.forEach(w => { if (!CTX_GRP.has(w)) CTX_GRP.set(w, '~g' + i); }));\r\nconst ctxH = (s) => { let h = 2166136261; for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 16777619); } return h >>> 0; };\r\nfunction ctxStem(w) { if (w.length <= 4) return w; const r = w.replace(/(ements|ement|ations|ation|ings|ing|ed|es|s)$/, ''); return r.length >= 4 ? r : w; }\r\nfunction ctxTokens(text, max) {\r\n  const out = [], s = String(text || '').slice(0, max || 8000).replace(/([a-z0-9])([A-Z])/g, '$1 $2');\r\n  for (const w0 of s.split(/[^\\p{L}\\p{N}]+/u)) {\r\n    if (!w0) continue; const w = idxNorm(w0); if (w.length < 2 || w.length > 40 || IDX_STOP.has(w)) continue;\r\n    const st = ctxStem(w); out.push(st); const g = CTX_GRP.get(w) || CTX_GRP.get(st); if (g) out.push(g);\r\n  }\r\n  return out;\r\n}\r\nfunction ctxVec(toks) {\r\n  const v = new Float32Array(CTX_DIM), tf = new Map();\r\n  for (const t of toks) tf.set(t, (tf.get(t) || 0) + 1);\r\n  for (const [t, c] of tf) { const h = ctxH(t); v[h % CTX_DIM] += ((h >>> 16) & 1 ? -1 : 1) * (1 + Math.log(c)); }\r\n  for (let i = 0; i + 1 < Math.min(toks.length, 400); i++) { const h = ctxH(toks[i] + '_' + toks[i + 1]); v[h % CTX_DIM] += ((h >>> 16) & 1 ? -0.5 : 0.5); }\r\n  let mx = 0; for (let i = 0; i < CTX_DIM; i++) mx = Math.max(mx, Math.abs(v[i]));\r\n  const q = new Int8Array(CTX_DIM); if (mx > 0) for (let i = 0; i < CTX_DIM; i++) q[i] = Math.round(v[i] / mx * 127);\r\n  return Buffer.from(q.buffer).toString('base64');\r\n}\r\nconst ctxUnpack = (b64) => { const b = Buffer.from(b64 || '', 'base64'); return new Int8Array(b.buffer, b.byteOffset, Math.min(b.length, CTX_DIM)); };\r\nfunction ctxCos(a, b) { let d = 0, na = 0, nb = 0; const n = Math.min(a.length, b.length); for (let i = 0; i < n; i++) { d += a[i] * b[i]; na += a[i] * a[i]; nb += b[i] * b[i]; } return na && nb ? d / Math.sqrt(na * nb) : 0; }\r\n// Découpage : un bloc par fonction/classe (si le fichier en a au moins 2), sinon fenêtres de 40 lignes qui se chevauchent\r\nfunction ctxChunk(rel, text, kind) {\r\n  const L = text.split('\\n'), N = L.length, syms = kind ? idxSymbols(kind, text, 200) : [], pieces = [];\r\n  const windows = (a, b, sym) => { for (let s = a; s <= b; s += 32) { pieces.push({ a: s, b: Math.min(b, s + 39), y: sym || '' }); if (s + 39 >= b) break; } };\r\n  if (syms.length >= 2) {\r\n    const S = syms.map(x => [x[0], x[1] - 1]).sort((p, q) => p[1] - q[1]);\r\n    if (S[0][1] > 0) windows(0, S[0][1] - 1, '');\r\n    for (let i = 0; i < S.length; i++) { const a = S[i][1], b = (i + 1 < S.length ? S[i + 1][1] : N) - 1; if (b < a) continue; if (b - a > 70) windows(a, b, S[i][0]); else pieces.push({ a, b, y: S[i][0] }); }\r\n  } else windows(0, N - 1, '');\r\n  const pt = ctxTokens(rel, 300), out = [];\r\n  for (const p of pieces.slice(0, 600)) {\r\n    const body = L.slice(p.a, p.b + 1).join('\\n'), toks = ctxTokens(body, 6000).concat(pt, ctxTokens(p.y, 100), ctxTokens(p.y, 100)), tf = {};\r\n    for (const t of toks) tf[t] = (tf[t] || 0) + 1;\r\n    const top = Object.entries(tf).sort((x, y) => y[1] - x[1]).slice(0, 80), t = {}; for (const [k, c] of top) t[k] = c;\r\n    out.push({ a: p.a + 1, b: p.b + 1, y: p.y, n: toks.length, t, v: ctxVec(toks) });\r\n  }\r\n  return out;\r\n}\r\nconst ctxPath = (root) => path.join(aihDir(root), 'ctx.json');\r\nconst CTX_MEM = new Map();\r\nfunction ctxBuild(root, mem) {\r\n  const base = realBase(root); let idx = mem && mem.idx;\r\n  if (!idx) { try { const j = JSON.parse(fs.readFileSync(ctxPath(root), 'utf8')); if (j && j.v === 2 && j.files) idx = j; } catch {} }\r\n  if (!idx) idx = { v: 2, files: {} };\r\n  const seen = new Set(); let n = 0, changed = false, budget = 60 * 1024 * 1024, total = 0;\r\n  for (const x of locWalk(base, base, 10)) {\r\n    if (x.e.isDirectory()) continue; if (++n > 4000) break;\r\n    if (IDX_SKIP.test(x.rel)) continue;\r\n    let st; try { st = fs.statSync(x.full); } catch { continue; }\r\n    if (st.size > CTX_FILE_MAX) continue;\r\n    const old = idx.files[x.rel], m = Math.floor(st.mtimeMs);\r\n    if (old && old.m === m && old.s === st.size) { seen.add(x.rel); total += old.c.length; continue; }\r\n    if (budget <= 0 || total >= CTX_MAXCHUNKS) continue;\r\n    if (locIsBinary(x.full)) continue;\r\n    let text = ''; try { text = fs.readFileSync(x.full, 'utf8'); budget -= text.length; } catch { continue; }\r\n    const kind = IDX_KIND[path.extname(x.rel).toLowerCase()], c = ctxChunk(x.rel, text, kind);\r\n    idx.files[x.rel] = { m, s: st.size, l: nLines(text), c }; seen.add(x.rel); total += c.length; changed = true;\r\n  }\r\n  for (const k of Object.keys(idx.files)) if (!seen.has(k)) { delete idx.files[k]; changed = true; }\r\n  if (changed) { try { fs.mkdirSync(aihDir(root), { recursive: true }); const tmp = ctxPath(root) + '.tmp'; fs.writeFileSync(tmp, JSON.stringify(idx)); fs.renameSync(tmp, ctxPath(root)); } catch {} }\r\n  const df = Object.create(null); let N = 0, len = 0;\r\n  for (const e of Object.values(idx.files)) for (const c of e.c) { N++; len += c.n; for (const k in c.t) df[k] = (df[k] || 0) + 1; }\r\n  const by = {};\r\n  for (const rel of Object.keys(idx.files)) (by[path.basename(rel)] = by[path.basename(rel)] || []).push(rel);\r\n  const groups = Object.values(by).filter(g => g.length > 1 && g.length <= 6);\r\n  const gk = groups.map(g => g.map(r => r + '@' + idx.files[r].m).sort().join(',')).sort().join(';');\r\n  let dup = mem && mem.gk === gk && mem.dup;\r\n  if (!dup) {\r\n    dup = new Set();   // copies anciennes d'un même fichier (au moins 60 % de lignes communes avec une copie plus récente) : ignorées par la recherche\r\n    const sig = (rel) => { const s = new Set(); try { for (const l of fs.readFileSync(path.join(base, rel), 'utf8').split('\\n')) { const t = l.trim(); if (t.length > 20) s.add(t); } } catch {} return s; };\r\n    for (const g0 of groups) {\r\n      const g = g0.slice().sort((a, b) => idx.files[b].m - idx.files[a].m), S = g.map(sig);\r\n      for (let i = 1; i < g.length; i++) for (let j = 0; j < i; j++) {\r\n        if (S[i].size < 5) break; let c = 0; for (const t of S[i]) if (S[j].has(t)) c++;\r\n        if (c / S[i].size >= 0.6) { dup.add(g[i]); break; }\r\n      }\r\n    }\r\n  }\r\n  return { idx, df, N, avg: N ? len / N : 1, at: Date.now(), gk, dup };\r\n}\r\nfunction ctxLoad(root) {\r\n  const base = realBase(root); let m = CTX_MEM.get(base);\r\n  if (m && Date.now() - m.at < 15000) return m;\r\n  m = ctxBuild(root, m); CTX_MEM.set(base, m); return m;\r\n}\r\n// Recherche : BM25 + cosinus des vecteurs + bonus (symbole, chemin, fichier récent) ; au plus 2 blocs par fichier\r\nfunction ctxSearch(root, q, n, extra) {\r\n  const M = ctxLoad(root), toks = [...new Set(ctxTokens(q, 600))], now = Date.now();\r\n  if (!toks.length || !M.N) return [];\r\n  const qv = ctxUnpack(ctxVec(ctxTokens(q, 600))), K1 = 1.2, B = 0.75, hits = [];\r\n  for (const [rel, e] of Object.entries(M.idx.files)) {\r\n    if (M.dup && M.dup.has(rel)) continue;\r\n    const rl = idxNorm(rel), rec = now - e.m < 7 * 864e5 ? 0.5 : 0, ex = (extra && extra.has && extra.has(rel)) ? 2 : 0;\r\n    for (const c of e.c) {\r\n      let bm = 0;\r\n      for (const t of toks) { const f = c.t[t]; if (!f) continue; const d = M.df[t] || 1, idf = Math.log(1 + (M.N - d + 0.5) / (d + 0.5)); bm += idf * (f * (K1 + 1)) / (f + K1 * (1 - B + B * c.n / M.avg)); }\r\n      const cos = ctxCos(qv, c._v || (c._v = ctxUnpack(c.v)));\r\n      let sc = bm + 6 * Math.max(0, cos) + rec + ex;\r\n      if (c.y) { const yn = idxNorm(c.y); if (toks.some(t => yn === t || (t.length >= 4 && yn.includes(t)))) sc += 3; }\r\n      if (toks.some(t => t.length >= 4 && rl.includes(t))) sc += 1.5;\r\n      if (sc > 1.5) hits.push({ rel, a: c.a, b: c.b, y: c.y, score: sc, m: e.m, bn: path.basename(rel) });\r\n    }\r\n  }\r\n  hits.sort((x, y) => y.score - x.score);\r\n  const per = {}, out = [];\r\n  // copies d'un même fichier (ancienne version dans un autre dossier) : on ne garde que la plus récente\r\n  const tw = new Map(), uniq = [];\r\n  for (const h of hits) {\r\n    const k = h.bn + '|' + h.y + '|' + (h.b - h.a) + (h.y ? '' : '|' + h.a), o = tw.get(k);\r\n    if (o && o.rel !== h.rel) { if (h.m > o.m) { const i = uniq.indexOf(o); if (i >= 0) uniq[i] = h; tw.set(k, h); } continue; }\r\n    if (!o) tw.set(k, h); uniq.push(h);\r\n  }\r\n  for (const h of uniq) { if ((per[h.rel] = (per[h.rel] || 0) + 1) > 2) continue; out.push(h); if (out.length >= (n || 6)) break; }\r\n  return out;\r\n}\r\nfunction ctxSnippet(root, h, maxChars) {\r\n  try { const L = fs.readFileSync(path.join(realBase(root), h.rel), 'utf8').split('\\n'); let s = L.slice(h.a - 1, h.b).join('\\n'); if (s.length > maxChars) s = s.slice(0, Math.max(0, maxChars - 1)) + '…'; return s; } catch { return ''; }\r\n}\r\n// ---- 5 : contexte git (fichiers non commités, branche), cache 60 s, 0 réseau ----\r\nlet CTX_ON = true;\r\nconst CTX_GIT = new Map();\r\nfunction ctxGitRun(root, args, ms) {\r\n  try { return cp.execFileSync('git', ['-c', 'core.quotepath=false'].concat(args), { cwd: realBase(root), windowsHide: true, timeout: ms || 6000, maxBuffer: 4 * 1024 * 1024, stdio: ['ignore', 'pipe', 'ignore'], encoding: 'utf8' }); } catch { return null; }\r\n}\r\nfunction ctxGit(root) {\r\n  const base = realBase(root), c = CTX_GIT.get(base);\r\n  if (c && Date.now() - c.at < 60000) return c.v;\r\n  const v = { ok: false, dirty: new Set(), branch: '' };\r\n  const top = ctxGitRun(root, ['rev-parse', '--show-prefix'], 3000);\r\n  if (top !== null) {\r\n    v.ok = true; const pre = top.trim();\r\n    const st = ctxGitRun(root, ['status', '--porcelain', '-uall'], 8000) || '';\r\n    for (const l of st.split('\\n')) {\r\n      if (l.length < 4) continue; let p = l.slice(3).trim(); const ar = p.indexOf(' -> '); if (ar >= 0) p = p.slice(ar + 4);\r\n      p = p.replace(/^\"|\"$/g, ''); if (pre) { if (!p.startsWith(pre)) continue; p = p.slice(pre.length); } v.dirty.add(p);\r\n    }\r\n    v.branch = (ctxGitRun(root, ['rev-parse', '--abbrev-ref', 'HEAD'], 3000) || '').trim();\r\n  }\r\n  CTX_GIT.set(base, { at: Date.now(), v }); return v;\r\n}\r\nfunction ctxLog(root, rel, n) {\r\n  const out = ctxGitRun(root, ['log', '-n', String(n || 8), '--date=short', '--pretty=format:%h  %ad  %an  %s'].concat(rel ? ['--', rel] : []), 8000);\r\n  return out === null ? null : out.trim();\r\n}\r\n// ---- 7 : pré-lecture par blocs pertinents (BM25 + vecteurs + git) ; null = repli sur l'ancien classement ----\r\nfunction ctxPre(root, q, cap) {\r\n  const g = ctxGit(root), hits = ctxSearch(root, q, 8, g.dirty); if (!hits.length) return null;\r\n  let used = 0, pre = ''; const files = [];\r\n  for (const h of hits) {\r\n    const remain = cap - used - 160; if (remain < 300) break;\r\n    if (LOC_SEEN.has(seenKey(root, h.rel)) && !g.dirty.has(h.rel)) continue;      // 4.12 (J2) : fichier déjà lu et inchangé : pas de doublon dans la pré-lecture\r\n    const snip = ctxSnippet(root, h, Math.min(remain, 1800)); if (!snip) continue;\r\n    pre += (pre ? '\\n' : '') + '=== ' + h.rel + ' (lignes ' + h.a + '-' + h.b + (h.y ? ', ' + h.y : '') + (g.dirty.has(h.rel) ? ', modifié non commité' : '') + ') ===\\n' + snip;\r\n    used += snip.length + 90; if (!files.includes(h.rel)) files.push(h.rel);\r\n  }\r\n  if (!pre) return null;\r\n  return { pre: 'PRÉ-LECTURE CONTEXTE (blocs les plus pertinents de l\\'index local, extraits seulement : @read la zone si tu as besoin du fichier complet) :\\n' + pre + '\\n', files };\r\n}\r\n// ---- 8 : résumé compact et STABLE du projet, ajouté à la CARTE (aucune heure, aucun git, chiffres arrondis : la CARTE reste « inchangée » d'un tour à l'autre) ----\r\nfunction ctxDigest(idx) {\r\n  const dirs = new Map(), ext = new Map(), keys = []; let nf = 0, nl = 0;\r\n  for (const [rel, e] of Object.entries(idx.files)) {\r\n    if (e.b) continue;\r\n    nf++; nl += e.l || 0;\r\n    const parts = rel.split('/'), top = parts.length > 1 ? parts.slice(0, Math.min(2, parts.length - 1)).join('/') : '.';\r\n    const d = dirs.get(top) || { n: 0, l: 0 }; d.n++; d.l += e.l || 0; dirs.set(top, d);\r\n    const x = path.extname(rel).slice(1).toLowerCase(); if (x) ext.set(x, (ext.get(x) || 0) + (e.l || 0));\r\n    if (parts.length <= 2 && /^(readme|plan|package\\.json|pyproject|build\\.|manifest|cargo\\.toml|go\\.mod|makefile)/i.test(parts[parts.length - 1])) keys.push(rel);\r\n  }\r\n  if (!nf) return '';\r\n  const tl = [...ext.entries()].sort((a, b) => b[1] - a[1]).slice(0, 4).map(([x, l]) => x + ' ' + (5 * Math.round(20 * l / Math.max(1, nl))) + '%').join(', ');\r\n  const dl = [...dirs.entries()].sort((a, b) => b[1].l - a[1].l).slice(0, 6).map(([d, v]) => (d === '.' ? 'racine' : d + '/') + ' (' + v.n + ' f)').join(', ');\r\n  return ('RÉSUMÉ : ' + nf + ' fichiers texte, ~' + Math.max(1, Math.round(nl / 1000)) + 'k lignes (' + tl + '). Dossiers : ' + dl + '.' + (keys.length ? ' Clés : ' + keys.slice(0, 6).join(', ') + '.' : '') + ' @ctx question = recherche par sens dans tout le projet.').slice(0, 700);\r\n}\r\n// </CTX>\r\nconst LOC_VERBS = {\r\n  ctx(root, a) {\r\n    let n = 6; const q = String(a || '').replace(/(?:^|\\s)-n\\s*(\\d+)/, (m, d) => { n = Math.max(1, Math.min(12, +d)); return ' '; }).trim();\r\n    if (!q) throw new Error('question manquante, exemple : @ctx où gère-t-on la connexion ?');\r\n    const g = ctxGit(root), hits = ctxSearch(root, q, n, g.dirty);\r\n    if (!hits.length) return { title: 'ctx (0 résultat)', out: 'aucun bloc pertinent : reformule avec d\\'autres mots, ou @grep un mot précis' };\r\n    const per = Math.max(500, Math.floor(9000 / hits.length));\r\n    const parts = hits.map(h => '=== ' + h.rel + ' (lignes ' + h.a + '-' + h.b + (h.y ? ', ' + h.y : '') + (g.dirty.has(h.rel) ? ', modifié non commité' : '') + ', score ' + h.score.toFixed(1) + ') ===\\n' + ctxSnippet(root, h, per));\r\n    return { title: 'ctx ' + q.slice(0, 50) + ' (' + hits.length + ' blocs)', out: parts.join('\\n') };\r\n  },\r\n  refs(root, a) {\r\n    const t = locArgs(a).filter(x => !x.startsWith('-')), sym = (t[0] || '').trim();\r\n    if (!/^[\\w$.]{2,60}$/.test(sym)) throw new Error('symbole manquant ou invalide, exemple : @refs maFonction');\r\n    const M = ctxLoad(root), base = realBase(root), esc = sym.replace(/[.$]/g, '\\\\$&');\r\n    const re = new RegExp('(^|[^\\\\w$])' + esc + '(?![\\\\w$])');\r\n    const def = new RegExp('^\\\\s*(?:export\\\\s+)?(?:default\\\\s+)?(?:async\\\\s+)?(?:function\\\\*?|class|const|let|var|def|interface|type|enum|struct|fn|func)\\\\s+' + esc + '(?![\\\\w$])|^\\\\s*(?:async\\\\s+|static\\\\s+|get\\\\s+|set\\\\s+)*' + esc + '\\\\s*\\\\([^)]*\\\\)\\\\s*\\\\{|(?:^|[\\\\s,{])' + esc + '\\\\s*[:=]\\\\s*(?:async\\\\s*)?(?:function|\\\\(|[\\\\w$]+\\\\s*=>)');\r\n    const defs = [], refs = {}; let nRef = 0, cut = false; const t0 = Date.now();\r\n    for (const rel of Object.keys(M.idx.files)) {\r\n      if (Date.now() - t0 > 4000) { cut = true; break; }\r\n      let text; try { text = fs.readFileSync(path.join(base, rel), 'utf8'); } catch { continue; }\r\n      if (!text.includes(sym)) continue;\r\n      const L = text.split('\\n');\r\n      for (let i = 0; i < L.length; i++) {\r\n        const l = L[i]; if (l.length > 400 || !l.includes(sym) || !re.test(l)) continue;\r\n        const row = rel + ':' + (i + 1) + '  ' + l.trim().slice(0, 140);\r\n        if (def.test(l)) { if (defs.length < 8) defs.push(row); } else { (refs[rel] = refs[rel] || []).push(row); nRef++; }\r\n      }\r\n    }\r\n    const out = ['DÉFINITIONS (' + defs.length + ') :'].concat(defs.length ? defs.map(x => '  ' + x) : ['  (aucune trouvée)']);\r\n    const files = Object.keys(refs).sort((x, y) => refs[y].length - refs[x].length); out.push('RÉFÉRENCES : ' + nRef + ' dans ' + files.length + ' fichier(s)');\r\n    let shown = 0;\r\n    for (const f of files) { const r = refs[f]; for (const row of r.slice(0, 3)) { out.push('  ' + row); shown++; } if (r.length > 3) out.push('  … +' + (r.length - 3) + ' autres dans ' + f); if (shown >= 30) { out.push('  … (liste coupée : précise avec @grep ' + sym + ' chemin)'); break; } }\r\n    if (cut) out.push('(analyse interrompue après 4 s : résultats partiels)');\r\n    return { title: 'refs ' + sym + ' (' + defs.length + ' déf., ' + nRef + ' réf.)', out: out.join('\\n') };\r\n  },\r\n  diff(root, a) { // 4.11.0 : modifications non commitées (git diff)\r\n    const t = locArgs(a).filter(x => !x.startsWith('-')), g = ctxGit(root);\r\n    if (!g.ok) throw new Error('ce dossier n\\'est pas un dépôt git');\r\n    const args = ['diff', '--no-color', '-U2']; if (t[0]) args.push('--', locSafe(root, t[0]).rel);\r\n    const r = cp.spawnSync('git', args, { cwd: realBase(root), encoding: 'utf8', timeout: 20000, windowsHide: true, maxBuffer: 8e6 }), out = String(r.stdout || '').trim();\r\n    return { title: 'diff ' + (t[0] || '(tout)'), out: out ? locCap(out, 9000) : '(aucune différence non commitée)' };\r\n  },\r\n  async test(root, a, c) { // 4.11.0 : détecte et lance les tests du projet (300 s)\r\n    const base = fs.realpathSync(root), has = (f) => fs.existsSync(path.join(base, f)), win = process.platform === 'win32', py = win ? 'python' : 'python3';\r\n    let cmd = String(a || '').trim();\r\n    if (/^[^\\s\"]+\\.(js|mjs|cjs|py)$/i.test(cmd)) { try { if (fs.statSync(locSafe(root, cmd).full).isFile()) cmd = /\\.py$/i.test(cmd) ? py + ' -m pytest -q ' + cmd : 'node --test ' + cmd; } catch {} } // 10.0.13 : @test fichier\r\n    if (!cmd) {\r\n      let req = ''; try { req = fs.readFileSync(path.join(base, 'requirements.txt'), 'utf8'); } catch {}\r\n      let top = []; try { top = fs.readdirSync(base); } catch {}\r\n      if (projHasTest(root)) cmd = 'npm test';\r\n      else if (has('pytest.ini') || has('conftest.py') || /pytest/i.test(req)) cmd = py + ' -m pytest -q';\r\n      else if (top.some(f => /^test_.*\\.py$/.test(f)) || has('tests')) cmd = py + ' -m unittest discover';\r\n      else if (win && has('gradlew.bat')) cmd = 'gradlew.bat test';\r\n      else if (has('gradlew')) cmd = './gradlew test';\r\n      else if (has('pom.xml')) cmd = 'mvn -q test';\r\n      else if (has('Cargo.toml')) cmd = 'cargo test';\r\n      else if (has('go.mod')) cmd = 'go test ./...';\r\n      else if (has('test') || top.some(f => /\\.test\\.js$/.test(f))) cmd = 'node --test';\r\n    }\r\n    if (!cmd) throw new Error('aucun test détecté : écris des tests (@scaffold node en crée un) ou @test commande');\r\n    const r = await locProc(win ? 'chcp 65001>nul & ' + cmd : cmd, [], { cwd: base, shell: true, timeout: 300000 });\r\n    return cmdOut(r, c, 'test ' + cmd.slice(0, 60), root);\r\n  },\r\n  scaffold(root, a) { // 4.11.0 : squelettes de projet (node, python, html, mc-fabric, mc-forge) ; ne remplace jamais un fichier existant\r\n    const t = locArgs(a), kind = String(t[0] || '').toLowerCase(), nm = String(t[1] || '').replace(/[^\\w.-]/g, ''), F = SCAF[kind];\r\n    if (!F) throw new Error('@scaffold ' + Object.keys(SCAF).join(' | ') + ' [nom du dossier]');\r\n    const pre = nm ? nm + '/' : '', files = F(nm || 'demo'), made = [];\r\n    for (const rel of Object.keys(files)) { const s = locSafe(root, pre + rel); if (fs.existsSync(s.full)) continue; fs.mkdirSync(path.dirname(s.full), { recursive: true }); fs.writeFileSync(s.full, files[rel], 'utf8'); made.push(s.rel); }\r\n    if (!made.length) throw new Error('rien créé : les fichiers existent déjà');\r\n    return { title: 'scaffold ' + kind + ' (' + made.length + ' fichiers)', out: 'créés :\\n' + made.join('\\n') + (/^mc-/.test(kind) ? '\\nvérifie les versions (Minecraft, loader, mappings) puis lance gradle wrapper si gradlew est absent' : ''), changed: true, rels: made };\r\n  },\r\n  history(root, a) {\r\n    const raw = String(a || ''), nm = /(?:^|\\s)-n\\s*(\\d+)/.exec(raw), n = nm ? Math.max(1, Math.min(30, +nm[1])) : 8;\r\n    const t = locArgs(raw.replace(/(?:^|\\s)-n\\s*\\d+/, ' ')).filter(x => !x.startsWith('-')), g = ctxGit(root);\r\n    if (!g.ok) throw new Error('ce dossier n\\'est pas un dépôt git');\r\n    if (t[0]) { const s = locSafe(root, t[0]), log = ctxLog(root, s.rel, n); return { title: 'history ' + s.rel, out: (g.dirty.has(s.rel) ? '⚠ modifié, non commité\\n' : '') + (log || '(aucun commit pour ce fichier)') }; }\r\n    const dirty = [...g.dirty].slice(0, 40), log = ctxLog(root, '', n);\r\n    return { title: 'history (' + (g.branch || 'git') + ')', out: 'NON COMMITÉS (' + g.dirty.size + ') :\\n' + (dirty.length ? dirty.map(x => '  ' + x).join('\\n') : '  (rien)') + (g.dirty.size > 40 ? '\\n  …' : '') + '\\n\\nDERNIERS COMMITS :\\n' + (log || '(aucun)') };\r\n  },\r\n  tree(root, a, c) {\r\n    const t = locArgs(a), s = locSafe(root, t[0] || '.'), depth = Math.max(1, Math.min(6, parseInt(t[1], 10) || 2)), noGen = !!(c && c.opts && c.opts.noGen);\r\n    if (!fs.statSync(s.full).isDirectory()) throw new Error('ce n\\'est pas un dossier');\r\n    const out = []; let n = 0;\r\n    for (const x of locWalk(s.full, s.full, depth)) { if (noGen && !x.e.isDirectory() && GEN_NAME.test(x.e.name)) continue; if (++n > 200) { out.push('… (liste coupée à 200 entrées, précise un sous-dossier)'); break; }\r\n      out.push('  '.repeat(x.depth) + x.e.name + (x.e.isDirectory() ? '/' : '')); }\r\n    return { title: 'tree ' + s.rel + ' (' + Math.min(n, 200) + ' entrées)', out: out.join('\\n') || '(dossier vide)' };\r\n  },\r\n  read(root, a, c) {\r\n    let force = false;\r\n    let num = false; // 10.0.14 : -n = numéros de ligne\r\n    const t = locArgs(a).filter(x => { if (x === '-f' || x === '--force') { force = true; return false; } if (x === '-n') { num = true; force = true; return false; } return true; });\r\n    if (!t[0]) throw new Error('chemin manquant');\r\n    const isRg = x => /^(\\d+)?-(\\d+)?$/.test(x || '') || /^\\d+$/.test(x || '');\r\n    const symM = /^(?:fn|sym|symbole|function|class|def):(.+)$/i.exec(t[1] || '');\r\n    if (t.length === 1 || (t.length === 2 && (isRg(t[1]) || symM))) return locReadFile(root, t[0], symM ? { sym: symM[1], num } : { range: isRg(t[1]) ? t[1] : '', num }, c, force);\r\n    // lecture groupée : @read a.js b.js:10-40 c.js#maFonction  (une seule instruction, un seul tour)\r\n    const list = t.slice(0, 8), per = Math.floor(20000 / list.length), parts = [], names = []; let saved = 0, okN = 0;\r\n    for (const x of list) {\r\n      let m, p = x, spec = {};\r\n      if ((m = /^(.+?):(\\d*-\\d*|\\d+)$/.exec(x))) { p = m[1]; spec = { range: m[2] }; } else if ((m = /^(.+?)#([\\w$.]+)$/.exec(x))) { p = m[1]; spec = { sym: m[2] }; }\r\n      try { spec.num = num; const r = locReadFile(root, p, spec, c, force); okN++; saved += r.saved || 0; names.push(p); parts.push('=== ' + r.title.replace(/^read /, '') + ' ===\\n' + (r.out.length > per ? locCap(r.out, per) : r.out)); }\r\n      catch (e) { parts.push('✕ ' + x + ' : ' + (e.message || e)); }\r\n    }\r\n    if (!okN) throw new Error(parts.join('\\n'));\r\n    if (t.length > 8) parts.push('(' + (t.length - 8) + ' fichiers en plus ignorés : 8 maximum par @read)');\r\n    return { title: 'read ×' + okN + ' (' + names.join(', ').slice(0, 90) + ')', out: parts.join('\\n'), saved };\r\n  },\r\n  outline(root, a) {\r\n    const t = locArgs(a).filter(x => !x.startsWith('-')); if (!t[0]) throw new Error('chemin manquant');\r\n    const parts = [], errs = []; let n = 0;\r\n    for (const x of t.slice(0, 6)) { try { const r = locOutline(root, x); parts.push(r.text); n++; } catch (e) { errs.push('✕ ' + x + ' : ' + (e.message || e)); } }\r\n    if (!n) throw new Error(errs.join('\\n'));\r\n    return { title: 'outline ' + t.slice(0, 3).join(' ') + (t.length > 3 ? '…' : ''), out: parts.concat(errs).join('\\n') };\r\n  },\r\n  find(root, a) { // 10.0.10 : -m = plus récents d'abord (avec date), -n N = nombre max (300)\r\n    let byDate = false, lim = 80; const t = [], tk = locArgs(a);\r\n    for (let i = 0; i < tk.length; i++) { const x = tk[i]; if (x === '-m') byDate = true; else if (x === '-n' && /^\\d+$/.test(tk[i + 1] || '')) lim = Math.max(1, Math.min(300, +tk[++i])); else t.push(x); }\r\n    if (!t[0]) throw new Error('motif manquant (ex. *.js ; -m = plus récents d\\'abord ; -n 150 = nombre max)');\r\n    const re = locGlob(t[0]), byPath = t[0].includes('/'), all = []; let seen = 0;\r\n    for (const x of locWalk(root, root, 12)) { if (++seen > 8000) break; if (x.e.isDirectory()) continue;\r\n      if (re.test(byPath ? x.rel : x.e.name)) { let mt = 0; if (byDate) { try { mt = fs.statSync(x.full).mtimeMs; } catch {} } all.push({ rel: x.rel, mt }); if (!byDate && all.length > lim) break; } }\r\n    if (byDate) all.sort((p, q) => q.mt - p.mt);\r\n    const more = all.length > lim, out = all.slice(0, lim).map(f => byDate ? new Date(f.mt).toISOString().slice(0, 16).replace('T', ' ') + '  ' + f.rel : f.rel);\r\n    if (more) out.push('… (' + lim + ' premiers résultats, précise le motif ou -n)');\r\n    return { title: 'find ' + t[0] + ' (' + Math.min(all.length, lim) + (more ? '+' : '') + ' résultats)', out: out.join('\\n') || 'aucun fichier' };\r\n  },\r\n  grep(root, a) {\r\n    const tk = locArgs(a), t = []; let rx = false, cs = false, lo = false, ww = false, ctx = 0, cA = -1, cB = -1, glob = '';\r\n    for (let i = 0; i < tk.length; i++) {\r\n      const x = tk[i];\r\n      if (x === '-r') rx = true; else if (x === '-w') ww = true; else if (x === '-s') cs = true; else if (x === '-l') lo = true;\r\n      else if (/^-C\\d{1,2}$/.test(x)) ctx = Math.min(12, +x.slice(2)); else if (x === '-C' && /^\\d{1,2}$/.test(tk[i + 1] || '')) ctx = Math.min(12, +tk[++i]);\r\n      else if (/^-[AB]\\d{1,2}$/.test(x)) { if (x[1] === 'A') cA = Math.min(12, +x.slice(2)); else cB = Math.min(12, +x.slice(2)); }\r\n      else if ((x === '-A' || x === '-B') && /^\\d{1,2}$/.test(tk[i + 1] || '')) { if (x === '-A') cA = Math.min(12, +tk[++i]); else cB = Math.min(12, +tk[++i]); }\r\n      else if ((x === '-g' || x === '--include') && tk[i + 1]) glob = tk[++i];\r\n      else t.push(x);\r\n    }\r\n    if (!t[0]) throw new Error('texte manquant');\r\n    if (ww) { if (!rx) t[0] = t[0].replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&'); t[0] = '\\\\b(?:' + t[0] + ')\\\\b'; rx = true; } // 10.0.13 : -w = mot entier\r\n    const s = locSafe(root, t[1] || '.');\r\n    let test;\r\n    if (rx) { let re; try { re = new RegExp(t[0].slice(0, 300), cs ? '' : 'i'); } catch (e) { throw new Error('expression régulière invalide : ' + e.message); } test = l => { const m = re.exec(l); return m ? m.index : -1; }; }\r\n    else { const nd = cs ? t[0] : t[0].toLowerCase(); test = l => (cs ? l : l.toLowerCase()).indexOf(nd); }\r\n    const gre = glob ? locGlob(glob) : null, groups = []; let files = 0, total = 0;\r\n    const scan = (f, rel) => {\r\n      if (gre && !gre.test(path.basename(rel))) return;\r\n      try {\r\n        const st = fs.statSync(f); if (st.size > 1024 * 1024 || locIsBinary(f)) return; files++;\r\n        const Ls = fs.readFileSync(f, 'utf8').split(/\\r?\\n/), hits = [];\r\n        for (let i = 0; i < Ls.length; i++) { const k = test(Ls[i]); if (k >= 0) hits.push([i, k]); }\r\n        if (hits.length) { total += hits.length; groups.push({ rel, L: Ls, hits }); }\r\n      } catch {}\r\n    };\r\n    const st0 = fs.statSync(s.full);\r\n    if (st0.isDirectory()) { for (const x of locWalk(s.full, realBase(root), 12)) { if (!x.e.isDirectory() && files < 3000) scan(x.full, x.rel); } }\r\n    else scan(s.full, s.rel);\r\n    const win = (line, k) => { const l = String(line); if (l.length <= 170) return l.trim(); const a0 = Math.max(0, k - 60); return (a0 ? '…' : '') + l.slice(a0, a0 + 170).trim() + '…'; };\r\n    let budget = 80, trunc = false; const out = [];\r\n    for (const g of groups) {\r\n      if (lo) { if (out.length >= 100) { trunc = true; break; } out.push(g.rel + ' (' + g.hits.length + ')'); continue; }\r\n      if (budget <= 0) { trunc = true; break; }\r\n      out.push('# ' + g.rel + (g.hits.length > 1 ? ' (' + g.hits.length + ')' : ''));\r\n      const shown = new Set(); let last = -2;\r\n      for (const [i, k] of g.hits) {\r\n        if (budget <= 0) { trunc = true; break; }\r\n        const bB = cB >= 0 ? cB : ctx, aA = cA >= 0 ? cA : ctx;\r\n        for (let j = Math.max(0, i - bB); j <= Math.min(g.L.length - 1, i + aA); j++) {\r\n          if (shown.has(j)) continue; shown.add(j);\r\n          if ((bB || aA) && last !== -2 && j !== last + 1) out.push('  --');\r\n          out.push('  ' + (j + 1) + (j === i ? ': ' : '- ') + win(g.L[j], j === i ? k : 0)); last = j;\r\n        }\r\n        budget--;\r\n      }\r\n    }\r\n    if (trunc) out.push('… (résultats coupés, ' + total + ' au total : précise le texte, le dossier, -g *.js ou -l)');\r\n    return { title: 'grep ' + cutTxt(t[0], 40) + ' (' + total + ' résultat' + (total > 1 ? 's' : '') + ', ' + groups.length + ' fichier' + (groups.length > 1 ? 's' : '') + ')', out: out.join('\\n') || 'aucun résultat dans ' + files + ' fichiers' };\r\n  },\r\n  stat(root, a) { // 10.0.11 : plusieurs chemins d'un coup (20 max), nombre de lignes des fichiers texte\r\n    const t = locArgs(a).filter(x => !x.startsWith('-')); if (!t[0]) throw new Error('chemin manquant');\r\n    const rows = [];\r\n    for (const x of t.slice(0, 20)) {\r\n      const s = locSafe(root, x); let st;\r\n      try { st = fs.statSync(s.full); } catch { rows.push(s.rel + ' : n\\'existe pas'); continue; }\r\n      const kind = st.isDirectory() ? 'dossier' : locIsBinary(s.full) ? 'fichier binaire' : 'fichier texte';\r\n      let ln = ''; if (kind === 'fichier texte' && st.size <= 2 * 1048576) { try { ln = ' · ' + nLines(fs.readFileSync(s.full, 'utf8')) + ' lignes'; } catch {} }\r\n      rows.push((t.length > 1