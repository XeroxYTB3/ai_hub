body == null) throw new Error('bloc manquant : entre <<< et >>> mets CHERCHE, le texte à trouver, REMPLACE, le nouveau texte');\r\n    const s = locSafe(root, t[0]);\r\n    let st; try { st = fs.statSync(s.full); } catch { throw new Error(s.rel + ' n\\'existe pas : utilise @write pour le créer'); }\r\n    if (st.isDirectory()) throw new Error(s.rel + ' est un dossier'); if (locIsBinary(s.full)) throw new Error('fichier binaire : modification refusée');\r\n    if (st.size > LOC_MAXFILE * 5) throw new Error('fichier trop gros pour @edit (' + Math.round(st.size / 1024) + ' Ko) : utilise @script');\r\n    if (seenStale(root, s.rel, s.full)) throw new Error(staleMsg(s.rel));\r\n    let txt = fs.readFileSync(s.full, 'utf8'); const crlf = txt.includes('\\r\\n'); if (crlf) txt = txt.replace(/\\r\\n/g, '\\n');\r\n    const old = txt; let what;\r\n    if (/^(lignes|ligne|lines|line)$/i.test(t[1] || '')) {      // @edit chemin lignes 12-18 : remplace ces lignes par le texte du bloc\r\n      const lm = /^(\\d+)(?:-(\\d+))?$/.exec(t[2] || ''); if (!lm) throw new Error('usage : @edit ' + s.rel + ' lignes 12-18 puis le nouveau texte entre <<< et >>>');\r\n      if (!LOC_SEEN.has(seenKey(root, s.rel))) throw new Error('lis d\\'abord ces lignes avec @read ' + s.rel + ' ' + lm[1] + '-' + (lm[2] || lm[1]) + ' (les numéros de lignes doivent venir d\\'une lecture récente)');\r\n      const hadNl = txt.endsWith('\\n'), F = txt.split('\\n'); if (hadNl) F.pop();\r\n      const from = +lm[1], to = +(lm[2] || lm[1]);\r\n      if (from < 1 || to < from || to > F.length) throw new Error('lignes ' + from + '-' + to + ' hors du fichier (' + F.length + ' lignes) : aucun fichier modifié');\r\n      const R = c.body === '' ? [] : String(c.body).replace(/\\r/g, '').split('\\n');\r\n      F.splice(from - 1, to - from + 1, ...R); txt = F.join('\\n') + (hadNl ? '\\n' : ''); what = 'lignes ' + from + '-' + to;\r\n    } else {\r\n      const pairs = parseEdit(c.body);\r\n      pairs.forEach((p, i) => { if (!p.s.trim()) throw new Error('CHERCHE n°' + (i + 1) + ' est vide'); txt = editPair(txt, p, i, s.rel); });\r\n      what = pairs.length + ' modification' + (pairs.length > 1 ? 's' : '');\r\n    }\r\n    const df = lineDiff(old, txt), title = 'edit ' + s.rel + ' (' + what + ')';\r\n    if (c.opts && c.opts.dry) return { title, out: '', diff: df, dry: true, rels: [s.rel] };\r\n    undoPush(root, c, 'edit', s.rel, '', s.full);\r\n    atomicWrite(s.full, crlf ? txt.replace(/\\n/g, '\\r\\n') : txt, 'utf8'); seenMark(root, s.rel, s.full);\r\n    return { title, out: '', changed: true, rels: [s.rel], diff: df };\r\n  },\r\n  append(root, a, c) {\r\n    const t = locArgs(a); if (!t[0]) throw new Error('chemin manquant');\r\n    if (c.body == null) throw new Error('contenu manquant : mets le texte entre <<< et >>>');\r\n    const s = locSafe(root, t[0]); let ex = false, cur = '';\r\n    try { const st = fs.statSync(s.full); if (st.isDirectory()) throw new Error(s.rel + ' est un dossier'); if (st.size + Buffer.byteLength(c.body) > LOC_MAXFILE * 5) throw new Error('fichier trop gros'); ex = true; cur = fs.readFileSync(s.full, 'utf8'); } catch (e) { if (e.code !== 'ENOENT') throw e; }\r\n    const piece = (cur && !/\\n$/.test(cur) && !/^\\r?\\n/.test(c.body) ? '\\n' : '') + c.body, df = lineDiff(cur, cur + piece), title = 'append ' + s.rel + ' (+' + nLines(c.body) + ' lignes)';\r\n    if (c.opts && c.opts.dry) return { title, out: '', diff: df, dry: true, rels: [s.rel] };\r\n    undoPush(root, c, 'append', s.rel, '', ex ? s.full : null);\r\n    fs.mkdirSync(path.dirname(s.full), { recursive: true });\r\n    fs.appendFileSync(s.full, piece, 'utf8'); seenMark(root, s.rel, s.full);\r\n    return { title, out: '', changed: true, rels: [s.rel], diff: df };\r\n  },\r\n  async replace(root, a, c) {\r\n    const t = [], tk = locArgs(a); let word = false, preview = false;\r\n    for (const x of tk) { if (x === '-w') word = true; else if (x === '-n') preview = true; else t.push(x); }\r\n    if (c.body == null) throw new Error('bloc manquant : entre <<< et >>> mets CHERCHE, le texte à trouver, REMPLACE, le nouveau texte (plusieurs paires possibles)');\r\n    const trimNl = x => String(x).replace(/\\r/g, '').replace(/^\\n+|\\n+$/g, '');\r\n    const pairs = parseEdit(c.body).map(p => ({ s: trimNl(p.s), r: trimNl(p.r) }));\r\n    pairs.forEach((p, i) => { if (!p.s.trim()) throw new Error('CHERCHE n°' + (i + 1) + ' est vide'); });\r\n    const s = locSafe(root, t[0] || '.'), glob = t[1] ? locGlob(t[1]) : null, forbid = c.opts && c.opts.forbid, dry = !!(c.opts && c.opts.dry);\r\n    const files = [], st0 = fs.statSync(s.full);\r\n    if (st0.isDirectory()) { let n = 0; for (const x of locWalk(s.full, realBase(root), 12)) { if (x.e.isDirectory()) continue; if (++n > 4000) break; if (IDX_SKIP.test(x.rel)) continue; if (glob && !glob.test(x.e.name)) continue; files.push(x); } }\r\n    else files.push({ full: s.full, rel: s.rel, e: { name: path.basename(s.rel) } });\r\n    const esc = z => z.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&'), res = [], rels = [], diffs = []; let total = 0, add = 0, del = 0, skipped = 0;\r\n    for (const x of files) {\r\n      if (rels.length >= 60) { res.push('… limite de 60 fichiers par @replace : relance pour la suite'); break; }\r\n      if (locForbid(forbid, x.rel)) { skipped++; continue; }\r\n      let st; try { st = fs.statSync(x.full); } catch { continue; } if (st.size > 1024 * 1024 || locIsBinary(x.full)) continue;\r\n      let txt = fs.readFileSync(x.full, 'utf8'); const crlf = txt.includes('\\r\\n'); if (crlf) txt = txt.replace(/\\r\\n/g, '\\n');\r\n      const old = txt; let n = 0;\r\n      for (const p of pairs) {\r\n        if (word) { const re = new RegExp('(?<![\\\\w$])' + esc(p.s) + '(?![\\\\w$])', 'g'); txt = txt.replace(re, () => { n++; return p.r; }); }\r\n        else { const k = countOcc(txt, p.s); if (k) { n += k; txt = txt.split(p.s).join(p.r); } }\r\n      }\r\n      if (!n || txt === old) continue;\r\n      total += n; const df = lineDiff(old, txt); add += df.add; del += df.del; res.push(x.rel + ' (×' + n + ')'); rels.push(x.rel);\r\n      if (diffs.length < 3 && df.diff) diffs.push('--- ' + x.rel + '\\n' + df.diff);\r\n      if (!preview && !dry) { undoPush(root, c, 'edit', x.rel, '', x.full); atomicWrite(x.full, crlf ? txt.replace(/\\n/g, '\\r\\n') : txt, 'utf8'); seenMark(root, x.rel, x.full); }\r\n    }\r\n    const lab = '“' + cutTxt(pairs[0].s, 28) + '” → “' + cutTxt(pairs[0].r, 28) + '”' + (pairs.length > 1 ? ' (+' + (pairs.length - 1) + ')' : '');\r\n    if (!rels.length) throw new Error('replace ' + lab + ' : aucune occurrence' + (word ? ' (mot entier)' : '') + ' dans ' + files.length + ' fichiers examinés' + (skipped ? ' (' + skipped + ' protégés ignorés)' : '') + ' : rien n\\'a été modifié');\r\n    const list = res.length > 40 ? res.slice(0, 40).concat('… (+' + (res.length - 40) + ' autres fichiers)') : res, df2 = { diff: diffs.join('\\n'), add, del };\r\n    if (dry) return { title: 'replace ' + lab, out: '', diff: df2, dry: true, rels };\r\n    if (preview) return { title: 'replace -n ' + lab + ' (aperçu : ' + total + ' remplacements, ' + rels.length + ' fichiers)', out: 'APERÇU, rien n\\'a été écrit :\\n' + list.join('\\n') + (skipped ? '\\n(' + skipped + ' fichiers protégés ignorés)' : '') };\r\n    const bad = [];\r\n    if (!(c.opts && c.opts.verify === false)) for (const rel of rels.slice(0, 15)) { const v = await locVerify(root, rel, locSafe(root, rel).full); if (v && !v.ok) bad.push('VÉRIF ✕ ' + rel + ' : ' + v.what + ' — ' + v.msg); }\r\n    return { ok: !bad.length, title: 'replace ' + lab + ' (' + total + ' remplacement' + (total > 1 ? 's' : '') + ', ' + rels.length + ' fichier' + (rels.length > 1 ? 's' : '') + (bad.length ? ' · vérif ✕' : '') + ')',\r\n      out: list.join('\\n') + (skipped ? '\\n(' + skipped + ' fichiers protégés ignorés)' : '') + (bad.length ? '\\n' + bad.join('\\n') + '\\nCes fichiers contiennent une erreur après le remplacement : corrige-les tout de suite (@read puis @edit) ou annule avec @undo.' : ''),\r\n      changed: true, rels, diff: df2 };\r\n  },\r\n  mkdir(root, a, c) {\r\n    const t = locArgs(a); if (!t[0]) throw new Error('chemin manquant');\r\n    const s = locSafe(root, t[0]);\r\n    if (fs.existsSync(s.full)) { if (fs.statSync(s.full).isDirectory()) return { title: 'mkdir ' + s.rel + ' (existe déjà)', out: '' }; throw new Error(s.rel + ' est un fichier'); }\r\n    undoPush(root, c, 'mkdir', s.rel, '', null); fs.mkdirSync(s.full, { recursive: true });\r\n    return { title: 'mkdir ' + s.rel, out: '', changed: true, rels: [s.rel + '/'] };\r\n  },\r\n  move(root, a, c) {\r\n    const t = locArgs(a); if (t.length < 2) throw new Error('usage : @move source cible');\r\n    const s = locSafe(root, t[0]), d = locSafe(root, t[1]);\r\n    if (s.rel === '.') throw new Error('impossible de déplacer le dossier du projet');\r\n    if (!fs.existsSync(s.full)) throw new Error(s.rel + ' n\\'existe pas');\r\n    if (fs.existsSync(d.full)) throw new Error(d.rel + ' existe déjà : choisis un autre nom ou @delete d\\'abord');\r\n    if (d.full.startsWith(s.full + path.sep)) throw new Error('on ne peut pas déplacer un dossier dans lui-même');\r\n    undoPush(root, c, 'move', s.rel, d.rel, null); fs.mkdirSync(path.dirname(d.full), { recursive: true });\r\n    try { fs.renameSync(s.full, d.full); } catch { fs.cpSync(s.full, d.full, { recursive: true }); fs.rmSync(s.full, { recursive: true, force: true }); }\r\n    return { title: 'move ' + s.rel + ' → ' + d.rel, out: '', changed: true, rels: [s.rel, d.rel] };\r\n  },\r\n  copy(root, a, c) {\r\n    const t = locArgs(a); if (t.length < 2) throw new Error('usage : @copy source cible');\r\n    const s = locSafe(root, t[0]), d = locSafe(root, t[1]);\r\n    if (!fs.existsSync(s.full)) throw new Error(s.rel + ' n\\'existe pas');\r\n    const sd = fs.statSync(s.full).isDirectory();\r\n    if (sd && (d.full === s.full || d.full.startsWith(s.full + path.sep))) throw new Error('on ne peut pas copier un dossier dans lui-même');\r\n    let ex = false; if (fs.existsSync(d.full)) { if (sd || fs.statSync(d.full).isDirectory()) throw new Error(d.rel + ' existe déjà'); ex = true; }\r\n    dirSize(s.full, LOC_MAXBACKUP);\r\n    undoPush(root, c, 'copy', s.rel, d.rel, ex ? d.full : null); fs.mkdirSync(path.dirname(d.full), { recursive: true });\r\n    fs.cpSync(s.full, d.full, { recursive: true, filter: (p) => !LOC_IGN.has(path.basename(p)) || p === s.full });\r\n    return { title: 'copy ' + s.rel + ' → ' + d.rel + (ex ? ' (remplacé)' : ''), out: '', changed: true, rels: [d.rel] };\r\n  },\r\n  delete(root, a, c) {\r\n    const t = locArgs(a); if (!t[0]) throw new Error('chemin manquant');\r\n    const s = locSafe(root, t[0]);\r\n    if (s.rel === '.') throw new Error('impossible de supprimer le dossier du projet');\r\n    if (s.rel.split('/')[0].toLowerCase() === '.git') throw new Error('le dossier .git ne se supprime pas par @delete');\r\n    if (!fs.existsSync(s.full)) throw new Error(s.rel + ' n\\'existe pas');\r\n    const dir = fs.statSync(s.full).isDirectory();\r\n    undoPush(root, c, 'delete', s.rel, '', s.full);      // refuse si trop gros pour être sauvegardé\r\n    fs.rmSync(s.full, { recursive: true, force: true });\r\n    return { title: 'delete ' + s.rel + (dir ? '/ (dossier)' : ''), out: 'sauvegardé : récupérable avec @undo', changed: true, rels: [s.rel] };\r\n  },\r\n  undo(root, a) {\r\n    const n = Math.max(1, Math.min(20, parseInt(locArgs(a)[0], 10) || 1)), idx = undoIndex(root);\r\n    if (!idx.length) throw new Error('rien à annuler');\r\n    const r = undoMany(root, idx.slice(-n).reverse()); seenClear(root);\r\n    return { ok: r.ok > 0, title: 'undo ' + n + ' (' + r.ok + ' annulée' + (r.ok > 1 ? 's' : '') + ')', out: r.out.join('\\n'), changed: true };\r\n  },\r\n\r\n  // ----- les passe-partout -----\r\n  task(root, a, c) { // 4.3.0 : tableau de tâches partagé (.aihub/tasks.json), lu par toutes les clés : gros projets découpés et repris par n'importe quel compte\r\n    const f = path.join(aihDir(root), 'tasks.json'); let T = [];\r\n    try { T = JSON.parse(fs.readFileSync(f, 'utf8')); if (!Array.isArray(T)) T = []; } catch {}\r\n    const m = String(a || '').trim().match(/^(\\S+)\\s*([\\s\\S]*)$/), op = m ? m[1].toLowerCase() : 'list', arg = m ? m[2].trim() : '';\r\n    const save = () => { fs.mkdirSync(path.dirname(f), { recursive: true }); atomicWrite(f, JSON.stringify(T), 'utf8'); };\r\n    const mark = { todo: '[ ]', doing: '[~]', done: '[x]', blocked: '[!]' };\r\n    const show = (all) => { const nd = T.filter(x => x.s === 'done').length, o = ['TÂCHES ' + nd + '/' + T.length + ' faites'], todo = T.filter(x => x.s !== 'done');\r\n      const lst = (all ? T : todo.slice(0, 14).concat(T.filter(x => x.s === 'done').slice(-3))).slice().sort((x, y) => x.id - y.id);\r\n      lst.forEach(x => o.push(x.id + ' ' + mark[x.s] + ' ' + x.t + (x.d && x.d.length ? ' [après ' + x.d.join(',') + ']' : '') + (x.n ? ' → ' + x.n : '')));\r\n      if (!all && todo.length > 14) o.push('… +' + (todo.length - 14) + ' autres à faire (@task list -a)'); return o.join('\\n'); };\r\n    if (op === 'list') return { title: 'task list (' + T.length + ')', out: T.length ? show(/-a\\b/.test(arg)) : '(aucune tâche : découpe le projet avec @task add)' };\r\n    if (op === 'add') {\r\n      const items = (c.body != null ? String(c.body).split(/\\r?\\n/) : [arg]).map(s => s.trim().replace(/^([-*•]|\\d+[.)])\\s+/, '').slice(0, 160)).filter(Boolean);\r\n      if (!items.length) throw new Error('tâche manquante : @task add titre (ou plusieurs lignes entre <<< et >>>)');\r\n      if (T.length + items.length > 400) throw new Error('400 tâches maximum');\r\n      let id = T.reduce((n, x) => Math.max(n, x.id), 0); items.forEach(t0 => { let d = [], p = 2; const t = t0.replace(/\\s*\\[(?:après|apres|after|dep)\\s*:?\\s*([\\d,\\s]+)\\]/ig, (_m, g) => { d = d.concat(g.split(',').map(s => parseInt(s, 10)).filter(Boolean)); return ''; }).replace(/\\s*\\[p([123])\\]/ig, (_m, g) => { p = +g; return ''; }).trim(); T.push({ id: ++id, t, s: 'todo', n: '', d, p }); }); save();\r\n      return { title: 'task add (' + items.length + ' tâche' + (items.length > 1 ? 's' : '') + ')', out: show(false) };\r\n    }\r\n    if (op === 'next') { // 4.11.0 : prochaine tâche prête (dépendances faites, priorité p1 < p2 < p3)\r\n      const dn = new Set(T.filter(x => x.s === 'done').map(x => x.id)), doing = T.filter(x => x.s === 'doing'), o = [];\r\n      const ready = T.filter(x => x.s === 'todo' && (x.d || []).every(i => dn.has(i))).sort((x, y) => (x.p || 2) - (y.p || 2) || x.id - y.id);\r\n      if (doing.length) o.push('EN COURS : ' + doing.map(x => x.id + ' ' + x.t).join(' | '));\r\n      o.push(ready.length ? 'PROCHAINES (dépendances faites) :\\n' + ready.slice(0, 5).map(x => x.id + ' ' + x.t).join('\\n') : (T.some(x => x.s === 'todo') ? 'aucune tâche prête : des dépendances ne sont pas faites ou sont bloquées' : 'plus rien à faire'));\r\n      return { title: 'task next', out: o.join('\\n') };\r\n    }\r\n    if (op === 'clear') { T = []; save(); return { title: 'task clear', out: 'liste vidée' }; }\r\n    if (op === 'start' || op === 'done' || op === 'block' || op === 'todo') {\r\n      const mm = arg.match(/^(\\d+(?:\\s*,\\s*\\d+)*)\\s*([\\s\\S]*)$/); if (!mm) throw new Error('numéro manquant : @task ' + op + ' N [note]');\r\n      const ids = mm[1].split(',').map(x => parseInt(x, 10)), note = mm[2].trim().slice(0, 200), s = { start: 'doing', done: 'done', block: 'blocked', todo: 'todo' }[op];\r\n      const miss = ids.filter(i => !T.some(x => x.id === i)); if (miss.length) throw new Error('tâche inconnue : ' + miss.join(', '));\r\n      T.forEach(x => { if (ids.includes(x.id)) { x.s = s; if (note) x.n = note; } }); save();\r\n      const left = T.filter(x => x.s !== 'done').length;\r\n      return { title: 'task ' + op + ' ' + ids.join(','), out: left ? show(false) : 'TOUTES LES TÂCHES SONT FAITES (' + T.length + '/' + T.length + ') : vérifie le projet puis @done' };\r\n    }\r\n    throw new Error('@task add (ligne [après:3,4] [p1]) | next | start N | done N [note] | block N raison | list [-a] | clear');\r\n  },\r\n  async run(root, a, c) {\r\n    const cmd = String(a || '').trim(); if (!cmd) throw new Error('commande manquante');\r\n    const full = process.platform === 'win32' ? 'chcp 65001>nul & ' + cmd : cmd;\r\n    const r = await locProc(full, [], { cwd: fs.realpathSync(root), shell: true, timeout: ((c.opts && c.opts.timeout) || 120) * 1000 });\r\n    return cmdOut(r, c, 'run ' + cmd.slice(0, 70), root);\r\n  },\r\n  async build(root, a, c) { // 4.8.0 : détecte le système de build du projet et le lance (300 s) ; « auto » = après @task done, sans erreur si rien à construire\r\n    const base = fs.realpathSync(root), has = (f) => fs.existsSync(path.join(base, f)), win = process.platform === 'win32', want = String(a || '').trim();\r\n    let cmd = want && want !== 'auto' ? want : '';\r\n    if (!cmd) {\r\n      let pj = null; try { pj = JSON.parse(fs.readFileSync(path.join(base, 'package.json'), 'utf8')); } catch {}\r\n      if (win && has('gradlew.bat')) cmd = 'gradlew.bat build';\r\n      else if (has('gradlew')) cmd = './gradlew build';\r\n      else if (has('build.gradle') || has('build.gradle.kts')) cmd = 'gradle build';\r\n      else if (has('pom.xml')) cmd = 'mvn -q package';\r\n      else if (has('Cargo.toml')) cmd = 'cargo build';\r\n      else if (pj && pj.scripts && pj.scripts.build) cmd = 'npm run build';\r\n      else if (projHasTest(root)) cmd = 'npm test';\r\n      else if (has('pyproject.toml') || has('setup.py') || has('requirements.txt')) cmd = (win ? 'python' : 'python3') + ' -m compileall -q .';\r\n    }\r\n    if (!cmd) { if (want === 'auto') return { title: 'build (rien à construire)', out: 'aucun système de build détecté : ignoré' }; throw new Error('aucun système de build détecté (gradle, maven, npm, python, cargo) : @build commande pour en donner un'); }\r\n    const full = win ? 'chcp 65001>nul & ' + cmd : cmd;\r\n    const r = await locProc(full, [], { cwd: base, shell: true, timeout: 300000 });\r\n    return cmdOut(r, c, 'build ' + cmd.slice(0, 60), root);\r\n  },\r\n  async tool(root, a, c) { // 10.0.15 : registre d'outils de l'IA (.aihub/tools) + paquets npm/pip ; confirmations côté interface\r\n    const t = locArgs(a), sub = String(t[0] || '').toLowerCase(), base = fs.realpathSync(root), TD = path.join(aihDir(root), 'tools'), win = process.platform === 'win32';\r\n    const NAME = /^[A-Za-z0-9_-]{1,40}$/, EXT = { node: '.js', python: '.py', powershell: '.ps1' };\r\n    const norm = (l) => String(l || '').toLowerCase().replace(/^(js|javascript)$/, 'node').replace(/^(py|python3)$/, 'python').replace(/^(ps|ps1|pwsh)$/, 'powershell');\r\n    const all = () => { let r = []; try { r = fs.readdirSync(TD).filter(f => f.endsWith('.json')); } catch {} const o = []; for (const f of r) { try { o.push(JSON.parse(fs.readFileSync(path.join(TD, f), 'utf8'))); } catch {} } return o; };\r\n    const get = (n) => { if (!NAME.test(n || '')) throw new Error('nom d\\'outil invalide (lettres, chiffres, - et _, 40 max)'); const m = all().find(y => y.name === n); if (!m || !EXT[m.lang]) throw new Error('outil « ' + n + ' » inconnu : @tool list'); return m; };\r\n    if (sub === 'list' || sub === 'search') {\r\n      const q = t.slice(1).join(' ').toLowerCase(), l = all().filter(y => !q || (y.name + ' ' + (y.desc || '') + ' ' + y.lang).toLowerCase().includes(q));\r\n      return { title: 'tool ' + sub + ' (' + l.length + ')', out: l.map(y => y.name + ' [' + y.lang + '] ' + (y.desc || '')).join('\\n') || 'aucun outil : @tool new nom node|python|powershell description (code entre <<< et >>>)' };\r\n    }\r\n    if (sub === 'new') {\r\n      const n = t[1], L = norm(t[2]);\r\n      if (!NAME.test(n || '') || !EXT[L]) throw new Error('@tool new nom node|python|powershell [description] puis le code entre <<< et >>>');\r\n      if (c.body == null || !String(c.body).trim()) throw new Error('code manquant : mets-le entre <<< et >>>');\r\n      if (Buffer.byteLength(String(c.body), 'utf8') > 60000) throw new Error('outil trop gros (60 Ko maximum)');\r\n      fs.mkdirSync(TD, { recursive: true });\r\n      fs.writeFileSync(path.join(TD, n + EXT[L]), (L === 'powershell' && win ? '\\ufeff' : '') + c.body, 'utf8');\r\n      fs.writeFileSync(path.join(TD, n + '.json'), JSON.stringify({ name: n, lang: L, desc: t.slice(3).join(' ').slice(0, 200), created: new Date().toISOString() }));\r\n      return { title: 'tool new ' + n + ' (' + L + ', ' + nLines(c.body) + ' lignes)', out: 'outil enregistré dans .aihub/tools : @tool run ' + n + ' arguments' };\r\n    }\r\n    if (sub === 'run') {\r\n      const m = get(t[1]), it = interp(m.lang), f = path.join(TD, m.name + EXT[m.lang]);\r\n      if (!fs.existsSync(f)) throw new Error('fichier de l\\'outil introuvable : @tool new ' + m.name);\r\n      const args = it.pre.concat(it.ps ? ['-File', f] : [f], t.slice(2));\r\n      const env = Object.assign({ NODE_PATH: [path.join(TD, 'node_modules'), path.join(base, 'node_modules')].join(path.delimiter), PYTHONPATH: path.join(TD, 'pylib'), AIHUB_PROJECT: base }, it.env);\r\n      const r = await locProc(it.file, args, { cwd: base, timeout: ((c.opts && c.opts.timeout) || 120) * 1000, env });\r\n      return cmdOut(r, c, 'tool run ' + m.name, root);\r\n    }\r\n    if (sub === 'help') {\r\n      const m = get(t[1]); let head = ''; try { head = fs.readFileSync(path.join(TD, m.name + EXT[m.lang]), 'utf8').split(/\\r?\\n/).slice(0, 25).join('\\n'); } catch {}\r\n      return { title: 'tool help ' + m.name, out: m.name + ' [' + m.lang + '] ' + (m.desc || '') + '\\n--- début du code ---\\n' + head };\r\n    }\r\n    if (sub === 'delete') {\r\n      const m = get(t[1]); for (const e of [EXT[m.lang], '.json']) { try { fs.unlinkSync(path.join(TD, m.name + e)); } catch {} }\r\n      return { title: 'tool delete ' + m.name, out: 'outil supprimé' };\r\n    }\r\n    if (sub === 'pkg') {\r\n      const k = String(t[1] || '').toLowerCase(), n = t[2] || ''; let cmd;\r\n      if (k === 'npm') { if (!/^(@[a-z0-9._~-]+\\/)?[a-z0-9._~-]+(@[\\w.^~*-]+)?$/i.test(n)) throw new Error('nom de paquet npm invalide'); cmd = 'npm install --no-audit --no-fund --prefix \"' + TD + '\" ' + n; }\r\n      else if (k === 'pip') { if (!/^[A-Za-z0-9._-]+(==[\\w.*]+)?$/.test(n)) throw new Error('nom de paquet pip invalide'); cmd = (win ? 'python' : 'python3') + ' -m pip install --disable-pip-version-check --target \"' + path.join(TD, 'pylib') + '\" ' + n; }\r\n      else throw new Error('@tool pkg npm|pip nom');\r\n      fs.mkdirSync(TD, { recursive: true });\r\n      const r = await locProc(win ? 'chcp 65001>nul & ' + cmd : cmd, [], { cwd: base, shell: true, timeout: 180000 });\r\n      return cmdOut(r, c, 'tool pkg ' + k + ' ' + n, root);\r\n    }\r\n    throw new Error('@tool list | search mot | new nom langage [description] | run nom args | help nom | delete nom | pkg npm|pip nom');\r\n  },\r\n  async script(root, a, c) {\r\n    const lang = locArgs(a)[0]; if (!lang) throw new Error('langage manquant : @script node, python ou powershell');\r\n    if (c.body == null || !String(c.body).trim()) throw new Error('programme manquant : mets le code entre <<< et >>>');\r\n    const L = String(lang).toLowerCase().replace(/^(js|javascript)$/, 'node').replace(/^(py|python3)$/, 'python').replace(/^(ps|ps1|pwsh)$/, 'powershell'), it = interp(L);\r\n    const ext = { node: '.js', python: '.py', powershell: '.ps1' }[L], tmp = fs.mkdtempSync(path.join(os.tmpdir(), 'aihub-')), f = path.join(tmp, 'script' + ext);\r\n    fs.writeFileSync(f, (L === 'powershell' && process.platform === 'win32' ? '\\ufeff' : '') + c.body, 'utf8');\r\n    try {\r\n      const args = it.pre.concat(it.ps ? ['-File', f] : [f]), base = fs.realpathSync(root);\r\n      const r = await locProc(it.file, args, { cwd: base, timeout: ((c.opts && c.opts.timeout) || 60) * 1000, env: Object.assign({ NODE_PATH: path.join(base, 'node_modules') }, it.env) });\r\n      return cmdOut(r, c, 'script ' + L + ' (' + nLines(c.body) + ' lignes)', root);\r\n    } finally { try { fs.rmSync(tmp, { recursive: true, force: true }); } catch {} }\r\n  },\r\n  open(root, a) {\r\n    const t = String(a || '').trim(); if (!t) throw new Error('chemin ou adresse manquant');\r\n    if (/^https?:\\/\\//i.test(t)) { let u; try { u = new URL(t); } catch { throw new Error('adresse invalide'); } shell.openExternal(u.href); return { title: 'open ' + u.href.slice(0, 80), out: 'ouvert dans le navigateur' }; }\r\n    const s = locSafe(root, t.replace(/^\"|\"$/g, '')); if (!fs.existsSync(s.full)) throw new Error(s.rel + ' n\\'existe pas');\r\n    if (/\\.(exe|bat|cmd|com|msi|ps1|psm1|vbs|vbe|js|jse|wsf|wsh|scr|lnk|hta|jar|sh|command|app|appimage|reg|dll|cpl)$/i.test(s.full)) throw new Error('ouvrir un programme est refusé : utilise @run (avec confirmation)');\r\n    shell.openPath(s.full); return { title: 'open ' + s.rel, out: 'ouvert avec le programme par défaut' };\r\n  },\r\n  async web(root, a) {\r\n    const url = locArgs(a)[0]; if (!url) throw new Error('adresse manquante');\r\n    const r = await locFetch(/^https?:/i.test(url) ? url : 'https://' + url, 20000);\r\n    const txt = /html|xml/i.test(r.ct) || /^\\s*</.test(r.raw) ? htmlToText(r.raw) : r.raw.trim();\r\n    if (r.status >= 400) throw new Error('la page répond ' + r.status);\r\n    return { title: 'web ' + r.url.slice(0, 80) + ' (' + txt.length + ' caractères)', out: locCap(txt, 14000) || '(page vide)' };\r\n  },\r\n  async search(root, a) {\r\n    const q = String(a || '').trim(); if (!q) throw new Error('texte de recherche manquant');\r\n    const r = await locFetch('https://html.duckduckgo.com/html/?q=' + encodeURIComponent(q), 20000), res = parseSearch(r.raw);\r\n    if (!res.length) throw new Error('aucun résultat lisible (le moteur a peut-être refusé la requête) : réessaie avec d\\'autres mots ou @web sur une adresse précise');\r\n    return { title: 'search ' + q.slice(0, 60) + ' (' + res.length + ' résultats)', out: res.map((x, i) => (i + 1) + '. ' + x.t + ' — ' + x.u + (x.s ? '\\n   ' + x.s : '')).join('\\n') };\r\n  }\r\n};\r\n// 4.11.0 : modèles de @scaffold\r\nconst SCAF = {\r\n  node: (n) => ({ 'package.json': JSON.stringify({ name: n.toLowerCase(), version: '1.0.0', main: 'src/index.js', scripts: { start: 'node src/index.js', test: 'node --test' } }, null, 2) + '\\n', 'src/index.js': \"function hello(name) { return 'Bonjour ' + name; }\\nmodule.exports = { hello };\\nif (require.main === module) console.log(hello('monde'));\\n\", 'test/index.test.js': \"const test = require('node:test');\\nconst assert = require('node:assert');\\nconst { hello } = require('../src/index.js');\\ntest('hello', () => assert.strictEqual(hello('A'), 'Bonjour A'));\\n\", '.gitignore': 'node_modules\\n' }),\r\n  python: () => ({ 'main.py': \"def hello(name):\\n    return 'Bonjour ' + name\\n\\n\\nif __name__ == '__main__':\\n    print(hello('monde'))\\n\", 'test_main.py': \"import unittest\\nfrom main import hello\\n\\n\\nclass T(unittest.TestCase):\\n    def test_hello(self):\\n        self.assertEqual(hello('A'), 'Bonjour A')\\n\\n\\nif __name__ == '__main__':\\n    unittest.main()\\n\", 'requirements.txt': '', '.gitignore': '__pycache__\\n.venv\\n' }),\r\n  html: (n) => ({ 'index.html': '<!doctype html>\\n<html lang=\"fr\">\\n<head>\\n<meta charset=\"utf-8\">\\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\\n<title>' + n + '</title>\\n<link rel=\"stylesheet\" href=\"style.css\">\\n</head>\\n<body>\\n<h1>' + n + '</h1>\\n<script src=\"script.js\"></script>\\n</body>\\n</html>\\n', 'style.css': 'body { font-family: system-ui, sans-serif; margin: 2rem; }\\n', 'script.js': \"console.log('prêt');\\n\" }),\r\n  'mc-fabric': (n) => { const id = n.toLowerCase().replace(/[^a-z0-9_]/g, '_'), pk = 'com.example.' + id, cl = id.replace(/(^|_)(\\w)/g, (_m, _a, b) => b.toUpperCase()) + 'Mod';\r\n    return {\r\n      'settings.gradle': \"pluginManagement {\\n    repositories {\\n        maven { url = 'https://maven.fabricmc.net/' }\\n        mavenCentral()\\n        gradlePluginPortal()\\n    }\\n}\\n\",\r\n      'gradle.properties': ['org.gradle.jvmargs=-Xmx2G', 'minecraft_version=1.21.1', 'yarn_mappings=1.21.1+build.3', 'loader_version=0.16.5', 'fabric_version=0.102.0+1.21.1', 'mod_version=1.0.0', 'maven_group=' + pk, 'archives_base_name=' + id, ''].join('\\n'),\r\n      'build.gradle': [\"plugins {\", \"    id 'fabric-loom' version '1.7-SNAPSHOT'\", \"    id 'maven-publish'\", \"}\", \"version = project.mod_version\", \"group = project.maven_group\", \"base { archivesName = project.archives_base_name }\", \"dependencies {\", \"    minecraft \\\"com.mojang:minecraft:${project.minecraft_version}\\\"\", \"    mappings \\\"net.fabricmc:yarn:${project.yarn_mappings}:v2\\\"\", \"    modImplementation \\\"net.fabricmc:fabric-loader:${project.loader_version}\\\"\", \"    modImplementation \\\"net.fabricmc.fabric-api:fabric-api:${project.fabric_version}\\\"\", \"}\", \"processResources {\", \"    inputs.property 'version', project.version\", \"    filesMatching('fabric.mod.json') { expand 'version': project.version }\", \"}\", \"tasks.withType(JavaCompile).configureEach { it.options.release = 21 }\", \"java { withSourcesJar() }\", \"\"].join('\\n'),\r\n      'src/main/resources/fabric.mod.json': JSON.stringify({ schemaVersion: 1, id, version: '${version}', name: n, description: '', authors: [], environment: '*', entrypoints: { main: [pk + '.' + cl] }, depends: { fabricloader: '>=0.16.0', minecraft: '~1.21.1', java: '>=21', 'fabric-api': '*' } }, null, 2) + '\\n',\r\n      ['src/main/java/' + pk.replace(/\\./g, '/') + '/' + cl + '.java']: 'package ' + pk + ';\\n\\nimport net.fabricmc.api.ModInitializer;\\n\\npublic class ' + cl + ' implements ModInitializer {\\n    public static final String MOD_ID = \"' + id + '\";\\n\\n    @Override\\n    public void onInitialize() {\\n        System.out.println(\"' + n + ' chargé\");\\n    }\\n}\\n',\r\n      '.gitignore': '.gradle\\nbuild\\nrun\\n.idea\\n' }; },\r\n  'mc-forge': (n) => { const id = n.toLowerCase().replace(/[^a-z0-9_]/g, '_'), pk = 'com.example.' + id, cl = id.replace(/(^|_)(\\w)/g, (_m, _a, b) => b.toUpperCase()) + 'Mod';\r\n    return {\r\n      'settings.gradle': \"pluginManagement {\\n    repositories {\\n        gradlePluginPortal()\\n        maven { url = 'https://maven.minecraftforge.net/' }\\n    }\\n}\\n\",\r\n      'gradle.properties': 'org.gradle.jvmargs=-Xmx2G\\n',\r\n      'build.gradle': [\"plugins {\", \"    id 'java'\", \"    id 'net.minecraftforge.gradle' version '[6.0,6.2)'\", \"}\", \"group = '\" + pk + \"'\", \"version = '1.0.0'\", \"base { archivesName = '\" + id + \"' }\", \"java.toolchain.languageVersion = JavaLanguageVersion.of(17)\", \"minecraft {\", \"    mappings channel: 'official', version: '1.20.1'\", \"}\", \"dependencies {\", \"    minecraft 'net.minecraftforge:forge:1.20.1-47.2.0'\", \"}\", \"\"].join('\\n'),\r\n      'src/main/resources/META-INF/mods.toml': ['modLoader=\"javafml\"', 'loaderVersion=\"[47,)\"', 'license=\"MIT\"', '[[mods]]', 'modId=\"' + id + '\"', 'version=\"1.0.0\"', 'displayName=\"' + n + '\"', 'description=\\'\\'\\'' + n + '\\'\\'\\'', ''].join('\\n'),\r\n      ['src/main/java/' + pk.replace(/\\./g, '/') + '/' + cl + '.java']: 'package ' + pk + ';\\n\\nimport net.minecraftforge.fml.common.Mod;\\n\\n@Mod(' + cl + '.MOD_ID)\\npublic class ' + cl + ' {\\n    public static final String MOD_ID = \"' + id + '\";\\n\\n    public ' + cl + '() {\\n        System.out.println(\"' + n + ' chargé\");\\n    }\\n}\\n',\r\n      '.gitignore': '.gradle\\nbuild\\nrun\\n.idea\\n' }; }\r\n};\r\nlet LOC_TURNW = { turn: '', n: 0 };\r\nconst LOC_WRITES = new Set(['write', 'edit', 'append', 'replace', 'mkdir', 'move', 'copy', 'delete', 'undo', 'scaffold']);\r\nipcMain.handle('local:exec', async (_e, p) => {\r\n  p = p || {}; const root = p.root, verb = String(p.verb || ''), arg = p.arg || '', t0 = Date.now(), opts = p.opts || {};\r\n  try {\r\n    if (!root || !fs.statSync(root).isDirectory()) return { ok: false, title: verb, out: 'le dossier du projet est introuvable' };\r\n    const f = Object.prototype.hasOwnProperty.call(LOC_VERBS, verb) ? LOC_VERBS[verb] : null; if (!f) return { ok: false, title: verb, out: 'instruction inconnue' };\r\n    // 4.12 (H1) : verrous de fichiers pour les agents en parallèle (actifs seulement si opts.agent est fourni : un seul agent = aucun verrou)\r\n    { const lk = lockClaim(root, opts.agent, opts.task, verb, arg); if (lk) return { ok: false, title: verb + ' ' + String(arg).split('\\n')[0].slice(0, 50), out: lk }; }\r\n    // 4.11.0 (C5) : plafond d'écriture : un gros fichier se livre par morceaux (@write puis @append), jamais d'un seul bloc géant coupé par la page\r\n    if ((verb === 'write' || verb === 'append') && p.hasBody) {\r\n      const sz = Buffer.byteLength(String(p.body || ''), 'utf8'), tk = String(p.turn || 't0');\r\n      if (sz > 60000) return { ok: false, title: verb + ' ' + String(arg).split('\\n')[0].slice(0, 50), out: 'bloc trop gros (' + Math.round(sz / 1024) + ' Ko, maximum 60 Ko par instruction) : écris les ~300 premières lignes avec @write puis le reste avec @append, un morceau par instruction' };\r\n      LOC_TURNW = LOC_TURNW.turn === tk ? LOC_TURNW : { turn: tk, n: 0 }; LOC_TURNW.n += sz;\r\n      if (LOC_TURNW.n > 240000) return { ok: false, title: verb + ' ' + String(arg).split('\\n')[0].slice(0, 50), out: 'plafond d\\'écriture du tour atteint (240 Ko) : termine ce tour, la suite au tour suivant' };\r\n    }\r\n    LOC_IGN = new Set([...LOC_IGNORE, ...((opts.ignore || []).map(x => String(x).trim()).filter(Boolean))]);\r\n    const r = await f(root, arg, { body: p.hasBody ? String(p.body == null ? '' : p.body) : null, turn: p.turn || 't0', opts });\r\n    const cap = (d) => d && d.diff ? { d: locCap(d.diff, 6000), a: d.add, r: d.del } : (d ? { d: '', a: d.add || 0, r: d.del || 0 } : undefined);\r\n    if (r.dry) return { ok: true, title: r.title, out: '', dry: true, diff: cap(r.diff), rels: r.rels || [] };\r\n    // 3.7.0 : contrôle automatique après @write / @edit / @append (désactivable dans les réglages du dossier)\r\n    if (r.ok !== false && opts.verify !== false && (verb === 'write' || verb === 'edit' || verb === 'append') && r.rels && r.rels[0]) {\r\n      const rel = r.rels[0], v = await locVerify(root, rel, locSafe(root, rel).full);\r\n      if (v) {\r\n        r.check = v;\r\n        if (v.ok) r.title += ' · vérif ✔';\r\n        else { r.title += ' · vérif ✕'; r.ok = false; r.out = 'VÉRIF ✕ ' + rel + ' : ' + v.what + ' — ' + v.msg + '\\nLe fichier a été écrit mais contient une erreur : corrige-le tout de suite (@read ' + rel + ' autour de la ligne, puis @edit), ne passe pas à autre chose.'; }\r\n      }\r\n    }\r\n    const ok = r.ok !== false;\r\n    if (verb !== 'tree' && verb !== 'read' && verb !== 'find' && verb !== 'grep' && verb !== 'stat' && verb !== 'outline') jlog(root, (ok ? 'ok  ' : 'err ') + r.title);\r\n    return { ok, title: r.title, out: locCap(r.out || '', LOC_MAXOUT), saved: r.saved || 0, ms: Date.now() - t0, changed: !!r.changed && LOC_WRITES.has(verb), rels: r.rels || [], diff: cap(r.diff), check: r.check ? { ok: r.check.ok, what: r.check.what } : undefined };\r\n  } catch (x) {\r\n    const msg = String(x && x.message || x); try { if (root && fs.existsSync(root) && !/introuvable/.test(msg)) jlog(root, 'err ' + verb + ' ' + String(arg).slice(0, 60) + ' : ' + msg); } catch {}\r\n    return { ok: false, title: verb + (arg ? ' ' + String(arg).split('\\n')[0].slice(0, 60) : ''), out: msg };\r\n  }\r\n});\r\n\r\n// ---- 4.12 (J1) : vérification automatique de fin de tour : syntaxe de tous les fichiers touchés, résumée en une ligne (0 crédit, sans repasser par l'IA) ----\r\nipcMain.handle('local:verifyTurn', async (_e, p) => {\r\n  try {\r\n    p = p || {}; const root = p.root, rels = [...new Set((p.rels || []).map(String))].slice(0, 25); let ok = 0; const bad = [];\r\n    for (const rel of rels) { let s; try { s = locSafe(root, rel); if (!fs.existsSync(s.full) || fs.statSync(s.full).isDirectory()) continue; } catch { continue; } const v = await locVerify(root, rel, s.full); if (!v) continue; if (v.ok) ok++; else bad.push(rel + ' (' + v.what + ' : ' + String(v.msg).slice(0, 100) + ')'); }\r\n    return { ok: !bad.length, checked: ok + bad.length, bad, line: bad.length ? 'Vérif du tour ✕ ' + bad.join(' ; ') : (ok ? 'Vérif du tour ✔ ' + ok + ' fichier' + (ok > 1 ? 's' : '') + ' valide' + (ok > 1 ? 's' : '') : '') };\r\n  } catch (x) { return { ok: true, checked: 0, bad: [], line: '', error: String(x && x.message || x) }; }\r\n});\r\n\r\n// ---- 4.12 (G2) : mode API optionnel (Gemini, Claude, OpenAI) : appel en flux avec https natif, sans dépendance. La clé n'est jamais écrite dans le journal. ----\r\nconst apxHttps = require('https'), apxHttp = require('http');\r\nconst APX = { reqs: new Map() };\r\nconst APX_DEF = { Claude: 'claude-sonnet-5-5', ChatGPT: 'gpt-5', Gemini: 'gemini-flash-latest' };\r\nfunction apxBuild(p) {\r\n  const plat = String(p.plat || ''), key = String(p.key || ''), model = String(p.model || APX_DEF[plat] || '');\r\n  const prompt = String(p.prompt || ''), imgs = Array.isArray(p.images) ? p.images.filter(x => x && x.b64 && /^image\\//.test(x.type || '')) : [];\r\n  const maxT = Math.max(16, Math.min(32000, Number(p.maxTokens) || 8192));\r\n  if (plat === 'Gemini') {\r\n    const parts = imgs.map(x => ({ inlineData: { mimeType: x.type, data: x.b64 } })).concat([{ text: prompt }]);\r\n    return { host: 'generativelanguage.googleapis.com', path: '/v1beta/models/' + encodeURIComponent(model) + ':streamGenerateContent?alt=sse', headers: { 'x-goog-api-key': key }, body: { contents: [{ role: 'user', parts }], generationConfig: { maxOutputTokens: maxT } } };\r\n  }\r\n  if (plat === 'Claude') {\r\n    const content = imgs.map(x => ({ type: 'image', source: { type: 'base64', media_type: x.type, data: x.b64 } })).concat([{ type: 'text', text: prompt }]);\r\n    return { host: 'api.anthropic.com', path: '/v1/messages', headers: { 'x-api-key': key, 'anthropic-version': '2023-06-01' }, body: { model, max_tokens: maxT, stream: true, messages: [{ role: 'user', content }] } };\r\n  }\r\n  if (plat === 'ChatGPT') {\r\n    const content = imgs.length ? imgs.map(x => ({ type: 'image_url', image_url: { url: 'data:' + x.type + ';base64,' + x.b64 } })).concat([{ type: 'text', text: prompt }]) : prompt;\r\n    return { host: 'api.openai.com', path: '/v1/chat/completions', headers: { authorization: 'Bearer ' + key }, body: { model, stream: true, messages: [{ role: 'user', content }] } };\r\n  }\r\n  return null;\r\n}\r\nfunction apxDelta(plat, j) {\r\n  try {\r\n    if (plat === 'Gemini') return ((j.candidates && j.candidates[0] && j.candidates[0].content && j.candidates[0].content.parts) || []).map(x => x.text || '').join('');\r\n    if (plat === 'Claude') return j.type === 'content_block_delta' && j.delta && j.delta.type === 'text_delta' ? (j.delta.text || '') : '';\r\n    if (plat === 'ChatGPT') return (j.choices && j.choices[0] && j.choices[0].delta && j.choices[0].delta.content) || '';\r\n  } catch {}\r\n  return '';\r\n}\r\nfunction apxSse(plat, st, chunk, onDelta) {\r\n  st.buf += chunk; let i;\r\n  while ((i = st.buf.indexOf('\\n')) >= 0) {\r\n    const line = st.buf.slice(0, i).replace(/\\r$/, ''); st.buf = st.buf.slice(i + 1);\r\n    if (!line.startsWith('data:')) continue; const d = line.slice(5).trim(); if (!d || d === '[DONE]') continue;\r\n    let j; try { j = JSON.parse(d); } catch { continue; }\r\n    if (j && j.error) { st.err = String(j.error.message || JSON.stringify(j.error)).slice(0, 300); continue; }\r\n    const t = apxDelta(plat, j); if (t) onDelta(t);\r\n  }\r\n}\r\nfunction apxAsk(p, onDelta) {\r\n  return new Promise((resolve) => {\r\n    const b = apxBuild(p); if (!b) return resolve({ ok: false, error: 'plateforme sans mode API : ' + p.plat });\r\n    if (!p.key) return resolve({ ok: false, auth: true, error: 'clé API manquante' });\r\n    const data = JSON.stringify(b.body); let host = b.host, port, mod = apxHttps;\r\n    if (p.base) { const m = /^([^:]+):(\\d+)$/.exec(String(p.base)); if (!m) return resolve({ ok: false, error: 'base invalide' }); host = m[1]; port = +m[2]; mod = apxHttp; }    // p.base : seulement pour les tests\r\n    let text = '', status = 0, errBody = '', done = false, cancelled = false, idle = null; const st = { buf: '', err: '' };\r\n    const fin = (r) => { if (done) return; done = true; clearTimeout(idle); if (p.id) APX.reqs.delete(p.id); resolve(r); };\r\n    const req = mod.request({ host, port, path: b.path, method: 'POST', headers: Object.assign({ 'content-type': 'application/json', 'content-length': Buffer.byteLength(data), accept: 'text/event-stream' }, b.headers) }, (res) => {\r\n      status = res.statusCode || 0; res.setEncoding('utf8');\r\n      res.on('data', (c) => { bump(); if (status >= 400) { errBody += c; return; } apxSse(p.plat, st, c, (t) => { text += t; try { onDelta && onDelta(t); } catch {} }); });\r\n      res.on('end', () => {\r\n        if (status >= 400) {\r\n          let msg = errBody.slice(0, 400); try { const j = JSON.parse(errBody); const m = j.error && (j.error.message || j.error); if (m) msg = typeof m === 'string' ? m : JSON.stringify(m).slice(0, 300); } catch {}\r\n          return fin({ ok: false, status, limited: status === 429 || status === 529 || (status !== 401 && status !== 403 && /quota|rate.?limit|exceeded|overloaded/i.test(msg)), auth: status === 401 || status === 403, error: 'HTTP ' + status + ' : ' + msg });\r\n        }\r\n        if (st.err && !text) return fin({ ok: false, status, limited: /quota|rate.?limit|overload|exceed/i.test(st.err), error: st.err });\r\n        fin({ ok: true, status, text });\r\n      });\r\n      res.on('error', (e) => fin({ ok: false, cancel: cancelled, partial: text, error: cancelled ? 'annulé' : String(e && e.message || e) }));\r\n      res.on('close', () => fin({ ok: false, cancel: cancelled, partial: text, error: cancelled ? 'annulé' : 'connexion interrompue' }));      // coupure après le début de la réponse (sans effet si la réponse s'est bien terminée)\r\n    });\r\n    const bump = () => { clearTimeout(idle); idle = setTimeout(() => { try { req.destroy(); } catch {} fin({ ok: false, partial: text, error: 'aucune réponse depuis 120 s' }); }, 120000); };\r\n    if (p.id) APX.reqs.set(p.id, { cancel: () => { cancelled = true; try { req.destroy(); } catch {} } });\r\n    req.on('error', (e) => fin({ ok: false, cancel: cancelled, partial: text, error: cancelled ? 'annulé' : String(e && e.message || e) }));\r\n    req.write(data); req.end(); bump();\r\n  });\r\n}\r\nipcMain.handle('local:apiAsk', async (e, p) => {\r\n  p = p || {}; const id = String(p.id || ''), sender = e && e.sender;\r\n  try { return await apxAsk(p, (t) => { try { sender.send('api-delta', { id, d: t }); } catch {} }); } catch (x) { return { ok: false, error: String(x && x.message || x) }; }\r\n});\r\nipcMain.handle('local:apiCancel', (_e, p) => { const r = APX.reqs.get(String(p && p.id || '')); if (r) { r.cancel(); return { ok: true }; } return { ok: false }; });\r\n\r\n// ---- 4.12 (H1) : verrous de fichiers (.aihub/locks.json), expirent seuls après 15 min ----\r\nconst LOCK_TTL = 15 * 60 * 1000;\r\nconst locksFile = (root) => path.join(aihDir(root), 'locks.json');\r\nconst lockRel = (s) => String(s || '').trim().replace(/^[\"']|[\"']$/g, '').replace(/\\\\/g, '/').replace(/^\\.\\//, '').toLowerCase();\r\nfunction locksLoad(root) {\r\n  try { const j = JSON.parse(fs.readFileSync(locksFile(root), 'utf8')), now = Date.now(), f = {}; for (const [k, v] of Object.entries(j.files || {})) if (v && now - v.ts < LOCK_TTL) f[k] = v; return { files: f }; } catch { return { files: {} }; }\r\n}\r\nfunction locksSave(root, L) { try { fs.mkdirSync(aihDir(root), { recursive: true }); atomicWrite(locksFile(root), JSON.stringify(L), 'utf8'); } catch {} }\r\nfunction lockTargets(verb, arg) {\r\n  const first = String(arg || '').split('\\n')[0].trim(); if (!first) return [];\r\n  if (verb === 'move') return first.split(/\\s+/).slice(0, 2).map(lockRel).filter(Boolean);\r\n  if (verb === 'copy') return first.split(/\\s+/).slice(1, 2).map(lockRel).filter(Boolean);\r\n  return [lockRel(first.replace(/\\s+lignes\\s+\\d+\\s*-\\s*\\d+\\s*$/i, ''))].filter(Boolean);\r\n}\r\n// vérifie ET réserve en une seule étape synchrone (deux agents ne peuvent pas passer en même temps)\r\nfunction lockClaim(root, agent, task, verb, arg) {\r\n  if (!agent || !LOC_WRITES.has(verb) || verb === 'undo' || verb === 'scaffold' || verb === 'replace') return '';\r\n  const L = locksLoad(root), T = lockTargets(verb, arg), now = Date.now();\r\n  for (const t of T) { const h = L.files[t]; if (h && h.agent !== agent) return 'fichier « ' + t + ' » en cours de modification par un autre agent (' + (h.task || h.agent) + ') : choisis un autre fichier ou attends la fin de sa tâche'; }\r\n  if (!T.length) return '';\r\n  for (const t of T) L.files[t] = { agent: String(agent), task: String(task || ''), ts: now };\r\n  locksSave(root, L); return '';\r\n}\r\nipcMain.handle('local:locks', (_e, p) => { try { return { ok: true, files: locksLoad(p.root).files }; } catch (x) { return { ok: false, files: {}, error: String(x && x.message || x) }; } });\r\nipcMain.handle('local:unlock', (_e, p) => {\r\n  try { p = p || {}; const L = locksLoad(p.root); let n = 0; for (const k of Object.keys(L.files)) if (!p.agent || L.files[k].agent === String(p.agent)) { delete L.files[k]; n++; } locksSave(p.root, L); return { ok: true, n }; } catch (x) { return { ok: false, n: 0, error: String(x && x.message || x) }; }\r\n});\r\n\r\n// ---- confirmation (fenêtre native, impossible à contourner depuis une page web) ----\r\nipcMain.handle('local:confirm', async (_e, p) => {\r\n  p = p || {};\r\n  try {\r\n    const parent = BrowserWindow.getFocusedWindow() || BrowserWindow.getAllWindows()[0];\r\n    const buttons = p.always ? ['Autoriser', 'Toujours autoriser', 'Refuser'] : ['Autoriser', 'Refuser'];\r\n    const r = await dialog.showMessageBox(parent, { type: 'question', buttons, defaultId: buttons.length - 1, cancelId: buttons.length - 1, noLink: true, title: 'AI Hub — autorisation', message: String(p.title || 'L\\'IA veut agir').slice(0, 200), detail: String(p.detail || '').slice(0, 1800) });\r\n    const c = buttons[r.response]; return { choice: c === 'Autoriser' ? 'once' : c === 'Toujours autoriser' ? 'always' : 'no' };\r\n  } catch { return { choice: 'no' }; }\r\n});\r\n\r\n// ---- mémoire du dossier, journal, besoins, réglages, annulation ciblée, git ----\r\nconst needsFile = (root) => path.join(aihDir(root), 'needs.txt');\r\nipcMain.handle('local:memo', (_e, p) => {\r\n  try { const d = aihDir(p.root), f = path.join(d, 'memo.txt');\r\n    if (p.op === 'set') { fs.mkdirSync(d, { recursive: true }); atomicWrite(f, String(p.text || '').slice(0, 2000), 'utf8'); return { ok: true }; }\r\n    return { ok: true, text: fs.existsSync(f) ? fs.readFileSync(f, 'utf8').trim() : '' }; } catch (x) { return { ok: false, text: '', error: String(x.message || x) }; }\r\n});\r\nipcMain.handle('local:needs', (_e, p) => {\r\n  try { const d = aihDir(p.root), f = needsFile(p.root); fs.mkdirSync(d, { recursive: true });\r\n    const read = () => fs.existsSync(f) ? fs.readFileSync(f, 'utf8').split('\\n').filter(Boolean) : [];\r\n    if (p.op === 'add') fs.appendFileSync(f, new Date().toISOString().slice(0, 16).replace('T', ' ') + ' | ' + String(p.text || '').replace(/\\s+/g, ' ').slice(0, 300) + '\\n');\r\n    else if (p.op === 'remove') { const a = read(); a.splice(Number(p.index), 1); fs.writeFileSync(f, a.join('\\n') + (a.length ? '\\n' : '')); }\r\n    else if (p.op === 'clear') fs.writeFileSync(f, '');\r\n    return { ok: true, list: read().map(l => { const i = l.indexOf(' | '); return i > 0 ? { at: l.slice(0, i), t: l.slice(i + 3) } : { at: '', t: l }; }) };\r\n  } catch (x) { return { ok: false, list: [], error: String(x.message || x) }; }\r\n});\r\nipcMain.handle('local:history', (_e, p) => {\r\n  try { const d = aihDir(p.root), jf = path.join(d, 'journal.txt');\r\n    const j = fs.existsSync(jf) ? fs.readFileSync(jf, 'utf8').split('\\n').filter(Boolean).slice(-150).reverse() : [];\r\n    return { ok: true, journal: j, undo: undoIndex(p.root).slice(-80).reverse().map(e => ({ id: e.id, ts: e.ts, turn: e.turn, op: e.op, rel: e.rel, rel2: e.rel2 })) };\r\n  } catch (x) { return { ok: false, journal: [], undo: [], error: String(x.message || x) }; }\r\n});\r\nipcMain.handle('local:undo', (_e, p) => {\r\n  try { const idx = undoIndex(p.root); let list = [];\r\n    if (p.id) list = idx.filter(e => e.id === p.id);\r\n    else if (p.turn) list = idx.filter(e => e.turn === p.turn).reverse();\r\n    else if (p.last) { const lt = idx.length ? idx[idx.length - 1].turn : null; list = idx.filter(e => e.turn === lt).reverse(); }\r\n    if (!list.length) return { ok: false, out: 'rien à annuler' };\r\n    const r = undoMany(p.root, list); seenClear(p.root); jlog(p.root, 'undo ' + r.ok + '/' + list.length + ' annulation(s) demandée(s) par l\\'utilisateur');\r\n    return { ok: r.ok > 0, out: r.out.join('\\n'), n: r.ok };\r\n  } catch (x) { return { ok: false, out: String(x.message || x) }; }\r\n});\r\n// 4.11 (E2) : panneau « Changements » : fichiers modifiés par tour + refus d'un seul fichier (réutilise l'annulation existante)\r\nipcMain.handle('local:turnDiff', (_e, p) => {\r\n  try { const idx = undoIndex(p.root), turn = p.turn || (idx.length ? idx[idx.length - 1].turn : null), seen = new Map();\r\n    for (const e of idx) if (e.turn === turn) { const k = e.rel || ''; if (!seen.has(k)) seen.set(k, { rel: e.rel, rel2: e.rel2 || '', ops: [], id: e.id }); seen.get(k).ops.push(e.op); }\r\n    return { ok: true, turn, files: [...seen.values()].slice(0, 80) };\r\n  } catch (x) { return { ok: false, files: [], error: String(x.message || x) }; }\r\n});\r\nipcMain.handle('local:rejectFile', (_e, p) => {\r\n  try { const idx = undoIndex(p.root), list = idx.filter(e => e.turn === p.turn && (e.rel === p.rel || e.rel2 === p.rel)).reverse();\r\n    if (!list.length) return { ok: false, out: 'rien à annuler pour ' + p.rel };\r\n    const r = undoMany(p.root, list); seenClear(p.root); jlog(p.root, 'undo ' + r.ok + '/' + list.length + ' ' + p.rel + ' refusé par l\\'utilisateur');\r\n    return { ok: r.ok > 0, out: r.out.join('\\n'), n: r.ok };\r\n  } catch (x) { return { ok: false, out: String(x.message || x) }; }\r\n});\r\n// 10.0.23 : refus par bloc (hunk) : compare l'original (sauvegarde d'annulation du tour) au fichier actuel\r\nfunction hunkDiff(a, b) {\r\n  const sp = (x) => { x = String(x == null ? '' : x).replace(/\\r\\n/g, '\\n'); return x === '' ? [] : x.split('\\n'); };\r\n  const A = sp(a), B = sp(b);\r\n  let s = 0; while (s < A.length && s < B.length && A[s] === B[s]) s++;\r\n  let ea = A.length, eb = B.length; while (ea > s && eb > s && A[ea - 1] === B[eb - 1]) { ea--; eb--; }\r\n  const a2 = A.slice(s, ea), b2 = B.slice(s, eb), n = a2.length, m = b2.length, ops = [];\r\n  if (n * m <= 4000000) {\r\n    const W = m + 1, dp = new Uint32Array((n + 1) * W);\r\n    for (let i = n - 1; i >= 0; i--) for (let j = m - 1; j >= 0; j--) dp[i * W + j] = a2[i] === b2[j] ? dp[(i + 1) * W + j + 1] + 1 : Math.max(dp[(i + 1) * W + j], dp[i * W + j + 1]);\r\n    let i = 0, j = 0;\r\n    while (i < n && j < m) { if (a2[i] === b2[j]) { ops.push('='); i++; j++; } else if (dp[(i + 1) * W + j] >= dp[i * W + j + 1]) { ops.push('-'); i++; } else { ops.push('+'); j++; } }\r\n    while (i < n) { ops.push('-'); i++; } while (j < m) { ops.push('+'); j++; }\r\n  } else { for (let k = 0; k < n; k++) ops.push('-'); for (let k = 0; k < m; k++) ops.push('+'); }\r\n  const hs = []; let ai = s, bi = s, cur = null;\r\n  const close = () => { if (cur) { cur.a1 = ai; cur.b1 = bi; hs.push(cur); cur = null; } };\r\n  for (const o of ops) {\r\n    if (o === '=') { close(); ai++; bi++; continue; }\r\n    if (!cur) cur = { a0: ai, b0: bi, l: [] };\r\n    if (o === '-') { cur.l.push('- ' + String(A[ai]).slice(0, 220)); ai++; } else { cur.l.push('+ ' + String(B[bi]).slice(0, 220)); bi++; }\r\n  }\r\n  close();\r\n  hs.forEach((h, i) => { h.i = i; h.t = '@@ ligne ' + (h.b0 + 1) + ' @@\\n' + h.l.slice(0, 80).join('\\n'); });\r\n  return { A, B, hs };\r\n}\r\nfunction hunkCtx(p) {\r\n  const L = undoIndex(p.root).filter(e => e.turn === p.turn && e.rel === p.rel && /^(write|edit|append)$/.test(e.op));\r\n  if (!L.length) return { err: 'aucune modification enregistrée pour ' + p.rel };\r\n  if (!L[0].bak) return { created: true };\r\n  const full = locSafe(p.root, p.rel).full, bak = path.join(undoDir(p.root), L[0].id, 'b');\r\n  return { orig: fs.readFileSync(bak, 'utf8'), cur: fs.readFileSync(full, 'utf8'), full };\r\n}\r\nipcMain.handle('local:turnHunks', (_e, p) => {\r\n  try { const c = hunkCtx(p); if (c.err) return { ok: false, out: c.err }; if (c.created) return { ok: true, created: true, hunks: [] };\r\n    return { ok: true, hunks: hunkDiff(c.orig, c.cur).hs.slice(0, 60).map(h => ({ i: h.i, t: h.t })) };\r\n  } catch (x) { return { ok: false, out: String(x.message || x) }; }\r\n});\r\nipcMain.handle('local:rejectHunk', (_e, p) => {\r\n  try { const c = hunkCtx(p); if (c.err || c.created) return { ok: false, out: c.err || 'fichier créé par l\\'IA : refuse-le en entier' };\r\n    const d = hunkDiff(c.orig, c.cur), h = d.hs[Number(p.i)];\r\n    if (!h) return { ok: false, out: 'bloc introuvable (le fichier a changé) : rouvre le panneau' };\r\n    const eol = c.cur.includes('\\r\\n') ? '\\r\\n' : '\\n';\r\n    atomicWrite(c.full, d.B.slice(0, h.b0).concat(d.A.slice(h.a0, h.a1), d.B.slice(h.b1)).join(eol));\r\n    seenClear(p.root); jlog(p.root, 'undo bloc ligne ' + (h.b0 + 1) + ' de ' + p.rel + ' refusé par l\\'utilisateur');\r\n    return { ok: true, n: 1 };\r\n  } catch (x) { return { ok: false, out: String(x.message || x) }; }\r\n});\r\nipcMain.handle('local:cfg', (_e, p) => {      // copie lisible des réglages dans .aihub/config.json (les autorisations, elles, restent dans AI Hub)\r\n  try { const d = aihDir(p.root); fs.mkdirSync(d, { recursive: true }); atomicWrite(path.join(d, 'config.json'), JSON.stringify(p.cfg || {}, null, 2)); return { ok: true }; } catch (x) { return { ok: false, error: String(x.message || x) }; }\r\n});\r\nfunction git(root, args) { return new Promise((res) => cp.execFile('git', args, { cwd: root, windowsHide: true, timeout: 30000, maxBuffer: 4 * 1024 * 1024 }, (err, so, se) => res({ ok: !err, out: String(so || ''), err: String(se || (err && err.message) || '') }))); }\r\nipcMain.handle('local:git', async (_e, p) => {      // point de sauvegarde avant que l'IA agisse (dépôt git seulement)\r\n  try {\r\n    const root = fs.realpathSync(p.root); if (!fs.existsSync(path.join(root, '.git'))) return { ok: true, repo: false };\r\n    try { const ex = path.join(root, '.git', 'info', 'exclude'); const cur = fs.existsSync(ex) ? fs.readFileSync(ex, 'utf8') : ''; if (!/^\\.aihub\\/?$/m.test(cur)) { fs.mkdirSync(path.dirname(ex), { recursive: true }); fs.appendFileSync(ex, (cur && !cur.endsWith('\\n') ? '\\n' : '') + '.aihub/\\n'); } } catch {}\r\n    const st = await git(root, ['status', '--porcelain']); if (!st.ok) return { ok: false, repo: true, error: st.err.slice(0, 120) };\r\n    if (!st.out.trim()) return { ok: true, repo: true, committed: false };\r\n    const add = await git(root, ['add', '-A']); if (!add.ok) return { ok: false, repo: true, error: add.err.slice(0, 120) };\r\n    const hasName = (await git(root, ['config', 'user.name'])).out.trim(), pre = hasName ? [] : ['-c', 'user.name=AI Hub', '-c', 'user.email=aihub@localhost'];\r\n    const cm = await git(root, pre.concat(['commit', '--no-verify', '-m', String(p.label || 'AI Hub : point de sauvegarde').slice(0, 100)]));\r\n    jlog(root, (cm.ok ? 'ok  ' : 'err ') + 'git ' + (p.label || 'point de sauvegarde'));\r\n    return { ok: cm.ok, repo: true, committed: cm.ok, error: cm.ok ? '' : cm.err.slice(0, 120) };\r\n  } catch (x) { return { ok: false, error: String(x.message || x) }; }\r\n});\r\n\r\n// 4.11 (C2) : conventions de PLAN.md + tâche en cours/prochaine + 3 dernières faites, injectées dans la CARTE (court, stable)\r\nfunction ctxBrief(root) {\r\n  try {\r\n    const base = realBase(root), o = [];\r\n    try { const pm = fs.readFileSync(path.join(base, 'PLAN.md'), 'utf8'), m = /^##\\s*Conventions[^\\n]*\\n([\\s\\S]*?)(?=\\n##\\s|$)/im.exec(pm); if (m && m[1].trim()) o.push('CONVENTIONS (PLAN.md) : ' + m[1].trim().replace(/\\s+/g, ' ').slice(0, 800)); } catch {}\r\n    try {\r\n      const T = JSON.parse(fs.readFileSync(path.join(aihDir(root), 'tasks.json'), 'utf8'));\r\n      if (Array.isArray(T) && T.length) {\r\n        const dn = new Set(T.filter(x => x.s === 'done').map(x => x.id)), doing = T.filter(x => x.s === 'doing');\r\n        const nx = doing.concat(T.filter(x => x.s === 'todo' && (x.d || []).every(i => dn.has(i))).sort((x, y) => (x.p || 2) - (y.p || 2) || x.id - y.id)).slice(0, 2);\r\n        o.push('TÂCHES ' + dn.size + '/' + T.length + (nx.length ? ' · SUIVANTE : ' + nx.map(x => x.id + ' ' + x.t.slice(0, 90)).join(' | ') : '') + ' · FAITES RÉCEMMENT : ' + T.filter(x => x.s === 'done').slice(-3).map(x => x.id + ' ' + x.t.slice(0, 40)).join(' ; '));\r\n      }\r\n    } catch {}\r\n    return o.length ? o.join('\\n') + '\\n' : '';\r\n  } catch { return ''; }\r\n}\r\n// ---- 3.7.0 : carte du projet + pré-lecture, règles du projet ----\r\nipcMain.handle('local:index', (_e, p) => {\r\n  try {\r\n    p = p || {}; const root = p.root; if (!root || !fs.statSync(root).isDirectory()) return { ok: false };\r\n    LOC_IGN = new Set([...LOC_IGNORE, ...((p.ignore || []).map(x => String(x).trim()).filter(Boolean))]);\r\n    try { CTX_ON = !fs.existsSync(path.join(aihDir(root), 'ctx-off')); } catch {}   // interrupteur : créer le fichier .aihub/ctx-off désactive le contexte ULTRA\r\n    const idx = idxUpdate(root), pr = idxPre(root, idx, p.query || '', Math.max(0, Math.min(14000, +p.cap || 0)));\r\n    return { ok: true, count: Object.keys(idx.files).length, map: ctxBrief(root) + idxMap(idx, Math.max(4, Math.min(20, +p.mapN || 15))) + (CTX_ON ? (() => { try { const dg = ctxDigest(idx); return dg ? '\\n' + dg : ''; } catch { return ''; } })() : ''), pre: pr.pre, preFiles: pr.files, test: projHasTest(root) };\r\n  } catch (x) { return { ok: false, error: String(x.message || x) }; }\r\n});\r\nipcMain.handle('local:rules', (_e, p) => {\r\n  try { const d = aihDir(p.root), f = path.join(d, 'rules.md');\r\n    if (p.op === 'set') { fs.mkdirSync(d, { recursive: true }); atomicWrite(f, String(p.text || '').replace(/\\r/g, '').slice(0, 1500), 'utf8'); return { ok: true }; }\r\n    return { ok: true, text: fs.existsSync(f) ? fs.readFileSync(f, 'utf8').slice(0, 1500) : '' };\r\n  } catch (x) { return { ok: false, text: '', error: String(x.message || x) }; }\r\n});\r\n\r\nipcMain.handle('local:kill', () => { let n = 0; for (const c of [...LOC_PROCS]) { try { c.__killed = true; killTree(c); n++; } catch {} } return { ok: true, n }; });\r\n\r\n// ---- 3.1.0 : état de reprise (.aihub/state.json) : tâche en cours, plan, derniers tours, derniers résultats ----\r\n// Un autre compte (ou une conversation neuve, ou l'app relancée) reprend EXACTEMENT là où le précédent s'est arrêté.\r\nconst stFile = (root) => path.join(aihDir(root), 'state.json');\r\nfunction stRead(root) { try { const s = JSON.parse(fs.readFileSync(stFile(root), 'utf8')); return s && typeof s === 'object' ? s : {}; } catch { return {}; } }\r\nfunction stWrite(root, s) { const d = aihDir(root); fs.mkdirSync(d, { recursive: true }); const tmp = stFile(root) + '.tmp'; fs.writeFileSync(tmp, JSON.stringify(s)); fs.renameSync(tmp, stFile(root)); }\r\nipcMain.handle('local:state', (_e, p) => {\r\n  try {\r\n    p = p || {}; let s = stRead(p.root);\r\n    if (p.op === 'task') {\r\n      const t = s.task;\r\n      if (p.keep && t && t.status !== 'done') { t.status = 'running'; }\r\n      else s = { task: { text: String(p.text || '').slice(0, 1500), at: Date.now(), status: 'running' }, plan: '', rounds: [], n: 0, lastResults: '' };\r\n      stWrite(p.root, s);\r\n    } else if (p.op === 'round') {\r\n      s.rounds = s.rounds || []; s.n = (s.n || 0) + 1;\r\n      s.rounds.push({ n: s.n, acc: String(p.acc || '').slice(0, 30), talk: String(p.talk || '').slice(0, 200), acts: (p.acts || []).slice(0, 12).map(a => ({ ok: !!a.ok, t: String(a.t || '').slice(0, 80) })), at: Date.now() });\r\n      if (s.rounds.length > 40) s.rounds.shift();\r\n      s.lastResults = String(p.results || '').slice(-20000);\r\n      if (!s.task) s.task = { text: '', at: Date.now(), status: 'running' };\r\n      if (p.status) s.task.status = p.status;\r\n      if (p.status === 'done') s.lastResults = '';\r\n      stWrite(p.root, s);\r\n    } else if (p.op === 'plan') { s.plan = String(p.text || '').slice(0, 1600); stWrite(p.root, s); }\r\n    else if (p.op === 'status') { if (!s.task) s.task = { text: '', at: Date.now() }; s.task.status = String(p.status || 'running'); if (p.status === 'done') s.lastResults = ''; stWrite(p.root, s); }\r\n    else if (p.op === 'results') { s.lastResults = String(p.results || '').slice(-20000); stWrite(p.root, s); }\r\n    else if (p.op === 'reset') { s = {}; stWrite(p.root, s); }\r\n    return { ok: true, st: s };\r\n  } catch (x) { return { ok: false, st: {}, error: String(x.message || x) }; }\r\n});\r\n\r\n// ===== 3.8.0 : explorateur du dossier du projet (un projet = un dossier ; ses fichiers = ceux du dossier) =====\r\nconst PJ_IGN = new Set(['node_modules', '.git', '.aihub', '.hg', '.svn', 'dist', 'build', '__pycache__', '.venv', 'venv', '.next', '.cache', 'target', '.idea', '.vs', 'coverage']);\r\nconst PJ_IMG = { png: 'image/png', jpg: 'image/jpeg', jpeg: 'image/jpeg', gif: 'image/gif', webp: 'image/webp', svg: 'image/svg+xml', ico: 'image/x-icon', bmp: 'image/bmp' };\r\nconst pjSafe = (root, rel) => {            // chemin toujours à l'intérieur du dossier du projet\r\n  const r = path.resolve(String(root || '')), f = path.resolve(r, String(rel || ''));\r\n  if (f !== r && !f.startsWith(r + path.sep)) throw new Error('Chemin hors du projet');\r\n  return f;\r\n};\r\nconst pjIsText = (buf) => { const n = Math.min(buf.length, 4000); for (let i = 0; i < n; i++) if (buf[i] === 0) return false; return true; };\r\nconst pjSort = (a, b) => (b.isDirectory() - a.isDirectory()) || a.name.localeCompare(b.name, 'fr', { numeric: true });\r\nfunction pjKind(dir, e) {                          // { d, f, lnk } — suit les liens symboliques\r\n  let d = e.isDirectory(), f = e.isFile(), lnk = false;\r\n  if (e.isSymbolicLink()) { try { const q = fs.statSync(path.join(dir, e.name)); d = q.isDirectory(); f = q.isFile(); lnk = true; } catch { return null; } }\r\n  return { d, f, lnk };\r\n}\r\nfunction pjWalk(root, cb, cap) {\r\n  let n = 0; const rec = (dir, rel, depth) => {\r\n    if (n >= cap || depth > 40) return;\r\n    let ents; try { ents = fs.readdirSync(dir, { withFileTypes: true }); } catch { return; }\r\n    ents.sort(pjSort);\r\n    for (const e of ents) {\r\n      if (n >= cap) return;\r\n      const r = rel ? rel + '/' + e.name : e.name, f = path.join(dir, e.name), k = pjKind(dir, e);\r\n      if (!k) continue;\r\n      if (k.d) { const heavy = k.lnk || PJ_IGN.has(e.name); n++; if (cb(heavy ? { p: r, d: true, h: 1 } : { p: r, d: true }) === false) return; if (!heavy) rec(f, r, depth + 1); }\r\n      else if (k.f) { n++; let s = 0, m = 0; try { const q = fs.statSync(f); s = q.size; m = Math.round(q.mtimeMs); } catch {} if (cb({ p: r, d: false, s, m }) === false) return; }\r\n    }\r\n  };\r\n  rec(root, '', 0);\r\n}\r\nipcMain.handle('proj:tree', (_e, p) => {\r\n  try { const root = pjSafe(p && p.root, ''); if (!fs.statSync(root).isDirectory()) return { ok: false };\r\n    const items = []; pjWalk(root, (x) => { items.push(x); }, 20000);\r\n    return { ok: true, items, cut: items.length >= 20000 };\r\n  } catch (x) { return { ok: false, error: String(x.message || x) }; }\r\n});\r\nipcMain.handle('proj:read', (_e, p) => {\r\n  try { const f = pjSafe(p.root, p.rel), st = fs.statSync(f), ext = path.extname(f).slice(1).toLowerCase();\r\n    if (!st.isFile()) return { ok: false, error: 'Pas un fichier' };\r\n    if (PJ_IMG[ext] && st.size < 4e6) return { ok: true, kind: 'img', url: 'data:' + PJ_IMG[ext] + ';base64,' + fs.readFileSync(f).toString('base64'), mtime: st.mtimeMs, size: st.size };\r\n    if (st.size > 250000) return { ok: true, kind: 'big', size: st.size, mtime: st.mtimeMs };\r\n    const buf = fs.readFileSync(f); if (!pjIsText(buf)) return { ok: true, kind: 'bin', size: st.size, mtime: st.mtimeMs };\r\n    return { ok: true, kind: 'text', text: buf.toString('utf8').replace(/^\\uFEFF/, ''), mtime: st.mtimeMs, size: st.size };\r\n  } catch (x) { return { ok: false, error: String(x.message || x) }; }\r\n});\r\nipcMain.handle('proj:save', (_e, p) => {\r\n  try { const f = pjSafe(p.root, p.rel); let exists = false, cur = 0;\r\n    try { cur = fs.statSync(f).mtimeMs; exists = true; } catch {}\r\n    if (exists && p.mtime && !p.force && Math.abs(cur - p.mtime) > 2) return { ok: false, conflict: true, mtime: cur };\r\n    fs.mkdirSync(path.dirname(f), { recursive: true });\r\n    atomicWrite(f, String(p.text == null ? '' : p.text), 'utf8');\r\n    return { ok: true, mtime: fs.statSync(f).mtimeMs };\r\n  } catch (x) { return { ok: false, error: String(x.message || x) }; }\r\n});\r\nipcMain.handle('proj:op', async (_e, p) => {\r\n  try { const f = pjSafe(p.root, p.rel);\r\n    if (p.op === 'mkdir') fs.mkdirSync(f, { recursive: true });\r\n    else if (p.op === 'rename') { const t = pjSafe(p.root, p.to); if (fs.existsSync(t)) return { ok: false, error: 'Ce nom existe déjà' }; fs.mkdirSync(path.dirname(t), { recursive: true }); fs.renameSync(f, t); }\r\n    else if (p.op === 'delete') { if (f === path.resolve(p.root)) return { ok: false }; await shell.trashItem(f); }\r\n    else if (p.op === 'show') shell.showItemInFolder(f);\r\n    else return { ok: false };\r\n    return { ok: true };\r\n  } catch (x) { return { ok: false, error: String(x.message || x) }; }\r\n});\r\nipcMain.handle('proj:grep', (_e, p) => {\r\n  try { const root = pjSafe(p.root, ''), q = String(p.q || '').toLowerCase(); if (q.length < 2) return { ok: true, hits: [] };\r\n    const hits = []; let files = 0;\r\n    pjWalk(root, (x) => {\r\n      if (x.d) return; if (hits.length >= 200) return false; if ((x.s || 0) > 300000) return;\r\n      let buf; try { buf = fs.readFileSync(path.join(root, x.p)); } catch { return; } if (!pjIsText(buf)) return; files++;\r\n      const lines = buf.toString('utf8').split('\\n');\r\n      for (let i = 0; i < lines.length && hits.length < 200; i++) { const L = lines[i]; if (L.length < 4000 && L.toLowerCase().includes(q)) hits.push({ p: x.p, l: i + 1, t: L.trim().slice(0, 160) }); }\r\n    }, 20000);\r\n    return { ok: true, hits, files, cut: hits.length >= 200 };\r\n  } catch (x) { return { ok: false, error: String(x.message || x) }; }\r\n});\r\n\r\n// ---------- 3.8.2 : un dossier = ce qu'affiche l'explorateur, en temps réel ----------\r\nipcMain.handle('proj:list', (_e, p) => {          // un seul niveau d'un dossier (dossiers lourds : node_modules, dist, .git…)\r\n  try { const rel = String(p.rel || ''), dir = pjSafe(p.root, rel), ents = fs.readdirSync(dir, { withFileTypes: true }), items = [];\r\n    ents.sort(pjSort);\r\n    for (const e of ents) { if (items.length >= 5000) break; const r = rel ? rel + '/' + e.name : e.name, k = pjKind(dir, e); if (!k) continue;\r\n      if (k.d) items.push({ p: r, d: true, h: 1 });\r\n      else if (k.f) { let s = 0, mt = 0; try { const q = fs.statSync(path.join(dir, e.name)); s = q.size; mt = Math.round(q.mtimeMs); } catch {} items.push({ p: r, d: false, s, m: mt }); } }\r\n    return { ok: true, items, cut: ents.length > 5000 };\r\n  } catch (x) { return { ok: false, error: String(x.message || x) }; }\r\n});\r\nconst pjW = { root: null, w: null, t: null };\r\nfunction pjUnwatch() { try { if (pjW.w) pjW.w.close(); } catch {} clearTimeout(pjW.t); pjW.w = null; pjW.root = null; }\r\nipcMain.handle('proj:watch', (_e, p) => {\r\n  try { const root = pjSafe(p && p.root, '');\r\n    if (pjW.w && pjW.root === root) return { ok: true };\r\n    pjUnwatch(); if (!fs.statSync(root).isDirectory()) return { ok: false };\r\n    pjW.root = root;\r\n    pjW.w = fs.watch(root, { recursive: true, persistent: false }, (_ev, name) => {\r\n      const seg = String(name || '').split(/[\\\\/]/); if (seg.includes('.git') || seg.includes('.aihub')) return;\r\n      clearTimeout(pjW.t); pjW.t = setTimeout(() => { try { if (win && !win.isDestroyed()) win.webContents.send('proj-changed', { root }); } catch {} }, 200);\r\n    });\r\n    pjW.w.on('error', () => { pjUnwatch(); });\r\n    return { ok: true };\r\n  } catch (x) { pjUnwatch(); return { ok: false, error: String(x.message || x) }; }\r\n});\r\napp.on('before-quit', pjUnwatch);\r\n"}, "preload.js": {"sha256": "9986e7da720482c490aa84b0208a05268a2ca071c890340fc8c5dda03c914026", "content": "/*\n * ⚠ RÈGLE N°1 — MISE À JOUR UNIVERSELLE (à lire AVANT toute modification de ce fichier)\n * Cette mise à jour doit TOUJOURS être compatible, PEU IMPORTE la version actuellement installée :\n * version d'origine de l'exe, ancienne, récente, ou même plus récente que celle-ci. N'importe qui doit\n * pouvoir l'installer, depuis n'importe quelle version, sans rien perdre (comptes, scripts, réglages).\n * Pour cela, TOUJOURS :\n *  1. Livrer un paquet COMPLET : les 4 fichiers (main-core.js, preload.js, webview-preload.js, index.html), jamais un paquet partiel.\n *  2. requiresLauncher = null. Ne rien supposer du lanceur (voir normalizeCtx dans main-core.js) et ne jamais exiger un lanceur plus récent.\n *  3. Garder les 4 fichiers cohérents entre eux (preload.js <-> main-core.js <-> index.html).\n *  4. Savoir lire les données écrites par N'IMPORTE QUELLE version : champ absent = valeur par défaut ; ne jamais supprimer ni réécrire un champ inconnu.\n *  5. Ne rien écrire qu'une version plus ancienne ne puisse relire (le retour arrière doit toujours marcher).\n *  6. Numéro de version strictement supérieur au précédent ; un numéro déjà publié n'est jamais réutilisé.\n */\nconst { contextBridge, ipcRenderer } = require('electron');\nconst i = (c) => (...a) => ipcRenderer.invoke(c, ...a);\ncontextBridge.exposeInMainWorld('api', {\n  copy: i('copy'), clear: i('clear'), wvpreload: i('wvpreload'), notify: i('notify'),\n  exportAll: i('export'), importAll: i('import'),\n  stateLoad: i('state:load'), stateSave: i('state:save'), orphans: i('orphans'), openData: i('open-data'),\n  gemini: i('gemini'), updInfo: i('upd:info'), updApply: i('upd:apply'), updRevert: i('upd:revert'),\n  updHealthy: i('upd:healthy'), updCheck: i('upd:check'), updFetch: i('upd:fetch'), updSetup: i('upd:setup'), updFail: i('upd:fail'), relaunch: i('relaunch'), launcherInfo: i('launcher:info'), launcherRebuild: i('launcher:rebuild'), launcherPick: i('launcher:pick'), launcherRestart: i('launcher:restart'), packZip: i('pack:zip'), chromeStart: i('chrome:start'), chromeWs: i('chrome:ws'), chromeImport: i('chrome:import'), chromeStop: i('chrome:stop'),\n  setTheme: i('theme:set'), localPick: i('local:pick'), projTree: i('proj:tree'), projRead: i('proj:read'), projSave: i('proj:save'), projOp: i('proj:op'), projGrep: i('proj:grep'), projList: i('proj:list'), projWatch: i('proj:watch'), localCheck: i('local:check'), localExec: i('local:exec'), localConfirm: i('local:confirm'), localMemo: i('local:memo'), localNeeds: i('local:needs'), localHistory: i('local:history'), localUndo: i('local:undo'), localHunks: i('local:turnHunks'), localRejectHunk: i('local:rejectHunk'), localCfg: i('local:cfg'), localGit: i('local:git'), localKill: i('local:kill'), localIndex: i('local:index'), localRules: i('local:rules'), localState: i('local:state'), localTurnDiff: i('local:turnDiff'), localLocks: i('local:locks'), localUnlock: i('local:unlock'), localVerifyTurn: i('local:verifyTurn'), localRejectFile: i('local:rejectFile'), localApiAsk: i('local:apiAsk'), localApiCancel: i('local:apiCancel'), saveFile: i('save:file'), showItem: i('show:item'), convPut: i('conv:put'), convSearch: i('conv:search'), convCount: i('conv:count'), convClear: i('conv:clear'),\n  onLauncher: (cb) => ipcRenderer.on('launcher-event', (_e, d) => cb(d)),\n  onNet: (cb) => ipcRenderer.on('net-event', (_e, d) => cb(d)), onNotifClick: (cb) => ipcRenderer.on('notif-click', (_e, id) => cb(id)),\n  onProj: (cb) => ipcRenderer.on('proj-changed', (_e, d) => cb(d)),\n  onApiDelta: (cb) => ipcRenderer.on('api-delta', (_e, d) => cb(d))\n});\n"}, "webview-preload.js": {"sha256": "6dd83b8fa3918129f706b131eded923f7921db73444d1260dbfbdf7c87f3295e", "content": "/*\n * ⚠ RÈGLE N°1 — MISE À JOUR UNIVERSELLE (à lire AVANT toute modification de ce fichier)\n * Cette mise à jour doit TOUJOURS être compatible, PEU IMPORTE la version actuellement installée :\n * version d'origine de l'exe, ancienne, récente, ou même plus récente que celle-ci. N'importe qui doit\n * pouvoir l'installer, depuis n'importe quelle version, sans rien perdre (comptes, scripts, réglages).\n * Pour cela, TOUJOURS :\n *  1. Livrer un paquet COMPLET : les 4 fichiers (main-core.js, preload.js, webview-preload.js, index.html), jamais un paquet partiel.\n *  2. requiresLauncher = null. Ne rien supposer du lanceur (voir normalizeCtx dans main-core.js) et ne jamais exiger un lanceur plus récent.\n *  3. Garder les 4 fichiers cohérents entre eux (preload.js <-> main-core.js <-> index.html).\n *  4. Savoir lire les données écrites par N'IMPORTE QUELLE version : champ absent = valeur par défaut ; ne jamais supprimer ni réécrire un champ inconnu.\n *  5. Ne rien écrire qu'une version plus ancienne ne puisse relire (le retour arrière doit toujours marcher).\n *  6. Numéro de version strictement supérieur au précédent ; un numéro déjà publié n'est jamais réutilisé.\n */\n// Tourne DANS chaque page de chat : détecte les événements et les envoie à l'app\nconst { ipcRenderer, webFrame } = require('electron');\nlet cfg = { detectors: [], idle: 120, sel: {} };\n\n// Sélecteurs par défaut + sélecteurs de secours ajoutés dans Paramètres > Détections (cfg.sel)\nconst BASE = {\n  user: '[data-testid=\"user-message\"],user-query,[data-message-author-role=\"user\"],article[data-turn=\"user\"],section[data-turn=\"user\"],[data-turn=\"user\"],[data-chatgpt-search-unit-key$=\":user\"],.ds-message .ds-collapsible-text',\n  ai: '.font-claude-response,.font-claude-message,[data-testid=\"assistant-message\"],[data-is-streaming],model-response,[data-message-author-role]:not([data-message-author-role=\"user\"]),article[data-turn=\"assistant\"],section[data-turn=\"assistant\"],[data-turn=\"assistant\"],.markdown.prose,message-content,.response-container,[data-chatgpt-search-unit-key$=\":assistant\"],.ds-assistant-message-main-content',   // aligné sur index.html\n  comp: '[contenteditable=\"true\"],textarea',\n  stop: '[data-testid=\"stop-button\"],button[aria-label*=\"Stop\" i],button[aria-label*=\"Arrêter\" i],button[aria-label*=\"Interrompre\" i]',\n  send: '[data-testid=\"send-button\"],button[aria-label*=\"Send\" i],button[aria-label*=\"Envoyer\" i]'\n};\nconst S = Object.assign({}, BASE);\nlet SKIP = '';\nfunction applySel() {\n  const sel = cfg.sel || {};\n  for (const k of Object.keys(BASE)) {\n    let extra = (sel[k] || '').trim();\n    if (extra) { try { document.querySelector(extra); } catch { ipcRenderer.sendToHost('hub-event', { type: 'selector-invalid', detail: { key: k, value: extra }, url: location.href, ts: Date.now() }); extra = ''; } }\n    S[k] = extra ? BASE[k] + ',' + extra : BASE[k];\n  }\n  SKIP = S.user + ',' + S.ai + ',' + S.comp + ',nav,aside,script,style,noscript';\n}\napplySel();\nipcRenderer.on('hub:config', (_e, c) => { cfg = c; applySel(); });\n\n// Limite atteinte : gérée à part (machine à états persistante, voir poll). Textes FR + EN de Claude, ChatGPT, Gemini...\nconst LIMIT_RE = /(you('|’)?ve (hit|reached|exceeded) (your|the|our|this) [\\w\\s-]{0,25}(limit|cap)|you (have|had) (hit|reached|exceeded) (your|the|our) [\\w\\s-]{0,25}(limit|cap)|you('|’)?re out of [\\w\\s-]{0,15}messages|usage (limit|cap)|message (limit|cap)|limit reached|out of (free )?messages|limite (d['’]utilisation|de messages|quotidienne|horaire|atteinte|dépassée)|vous avez (atteint|dépassé) (votre|la) limite|vous avez (épuisé|atteint) (vos|votre) [\\w\\s'’-]{0,25}(messages|quota|limite)|quota (épuisé|dépassé|exceeded)|(n['’]avez|il n['’]y a) plus de messages|plus de messages (gratuits|disponibles)|plus aucun message|come back (later|tomorrow)|reviens? plus tard)/i;\n// Heure de retour annoncée par le site : « jusqu'à 13:40 », « until 1:40 PM », « resets at 14:00 »...\nfunction parseUntil(s) {\n  const m = String(s || '').match(/(?:jusqu['’]?\\s*(?:à|a)|until|resets?(?:\\s+at)?|reviens?\\s+(?:à|at)|back\\s+at)\\s+(\\d{1,2})(?:\\s*[:h]\\s*(\\d{2}))?\\s*(a\\.?m\\.?|p\\.?m\\.?)?/i);\n  if (!m) return 0;\n  let h = +m[1], mi = +(m[2] || 0); const ap = (m[3] || '').toLowerCase().replace(/\\./g, '');\n  if (ap === 'pm' && h < 12) h += 12; if (ap === 'am' && h === 12) h = 0;\n  if (h > 23 || mi > 59) return 0;\n  const d = new Date(); d.setHours(h, mi, 0, 0);\n  if (d.getTime() <= Date.now() - 60000) d.setDate(d.getDate() + 1);   // déjà passée aujourd'hui : c'est demain\n  return d.getTime();\n}\n// [événement, regex, événement de fin]\nconst PAT = [\n  ['limit-soon', /(\\d+|few) messages? (remaining|left)|il vous reste \\d+ message|\\d+ messages? restants?/i],\n  ['rate-limit', /(too many (requests|messages)|rate limit|trop de (requêtes|messages)|slow down|ralentissez)/i],\n  ['overloaded', /(overloaded|at capacity|high demand|forte demande|surcharg|temporarily unavailable|service unavailable|temporairement indisponible)/i],\n  ['error', /(something went wrong|an error occurred|une erreur (est survenue|s['’]est produite)|network error|erreur réseau|failed to (load|send|generate)|impossible de (générer|envoyer)|unable to (send|generate))/i],\n  ['chat-too-long', /(conversation (is )?too long|conversation trop longue|context (window|limit)|maximum (conversation )?length|longueur maximale|start a new (chat|conversation)|commencez une nouvelle conversation)/i],\n  ['captcha', /(verify (that )?you are human|verifying you are human|vérifiez que vous êtes (un )?humain|checking your browser|just a moment|vérification de sécurité)/i, 'captcha-cleared']\n];\nconst LOGIN_BTN = /^(log ?in|sign ?in|se connecter|connexion|continue with (google|email)|continuer avec (google|e-?mail))$/im;\n\nconst emit = (type, detail) => ipcRenderer.sendToHost('hub-event', { type, detail, url: location.href, ts: Date.now() });\nconst q = (s) => { try { return [...document.querySelectorAll(s)]; } catch { return []; } };\nconst vis = (e) => e && e.offsetParent !== null;\nemit('page-start');\nconst flags = {};\nconst edge = (k, on, onT, offT, d) => {\n  if (on && !flags[k]) { flags[k] = 1; emit(onT, d); }\n  else if (!on && flags[k]) { flags[k] = 0; if (offT) emit(offT); }\n};\n// Texte court de TOUTE la page : uniquement pour la détection de connexion et les pages sans conversation (captcha, erreur plein écran)\nfunction pageTexts() {\n  const out = [], w = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT); let n;\n  while ((n = w.nextNode())) {\n    const t = n.nodeValue.trim();\n    if (t.length > 2 && t.length < 300) { const p = n.parentElement; if (p && !p.closest(SKIP)) out.push(t); }\n  }\n  return out.join('\\n');\n}\n\n// Texte court des ZONES D'INTERFACE seulement (alertes, fenêtres, bandeau autour de la zone de saisie).\n// La conversation n'est JAMAIS lue : même si les sélecteurs de messages changent, un échange qui parle de\n// \"limite atteinte\" ne peut plus déclencher de fausse alerte. On exclut aussi toute zone qui défile (= la conversation).\nconst ZONE_ALERT = '[role=\"alert\"],[role=\"status\"],[role=\"alertdialog\"],[role=\"dialog\"],[aria-modal=\"true\"],[aria-live=\"assertive\"],[data-testid*=\"limit\" i],[data-testid*=\"banner\" i],[data-testid*=\"toast\" i],[data-testid*=\"error\" i],[class*=\"toast\" i],[class*=\"banner\" i],[class*=\"snackbar\" i]';\nlet scrollMemo = new WeakMap();\nconst isScroller = (el) => {\n  let r = scrollMemo.get(el);\n  if (r === undefined) {\n    try { const cs = getComputedStyle(el); r = /(auto|scroll)/.test(cs.overflowY) && el.clientHeight > 120 && el.scrollHeight > el.clientHeight + 40; } catch { r = false; }\n    scrollMemo.set(el, r);\n  }\n  return r;\n};\nconst inTranscript = (el, root) => { for (let e = el; e; e = e.parentElement) { if (isScroller(e)) return true; if (e === root) break; } return false; };\nconst hasMsg = (el) => { try { return !!el.querySelector(S.user + ',' + S.ai) || !!el.closest(S.user + ',' + S.ai); } catch { return false; } };\nfunction zoneTexts() {\n  scrollMemo = new WeakMap();\n  const roots = new Set(q(ZONE_ALERT));\n  const c = q(S.comp).find(vis);\n  if (c) {                                    // bandeau juste au-dessus / autour de la zone de saisie\n    let p = c;\n    for (let i = 0; i < 5 && p.parentElement && p.parentElement !== document.body; i++) {\n      const n = p.parentElement;\n      if (isScroller(n) || hasMsg(n)) break;\n      p = n;\n    }\n    roots.add(p);\n  }\n  const UPG = /^(mettre à niveau|upgrade|passer (à|au) |s['’]abonner|subscribe|get (pro|max|plus))/i;\n  for (const b of q('button,a')) {            // le bandeau de limite contient presque toujours un bouton d'abonnement\n    if (!vis(b)) continue;\n    const t = (b.textContent || '').trim();\n    if (t.length > 40 || !UPG.test(t)) continue;\n    let p = b;\n    for (let i = 0; i < 4 && p.parentElement && p.parentElement !== document.body; i++) {\n      const n = p.parentElement;\n      if (isScroller(n) || hasMsg(n)) break;\n      p = n;\n    }\n    roots.add(p);\n  }\n  const out = new Set();\n  for (const root of roots) {\n    if (!root.isConnected || hasMsg(root)) continue;\n    const w = document.createTreeWalker(root, NodeFilter.SHOW_TEXT); let n;\n    while ((n = w.nextNode())) {\n      const t = n.nodeValue.trim();\n      if (t.length < 3 || t.length >= 300) continue;\n      const el = n.parentElement;\n      if (!el || !el.getClientRects().length || el.closest(SKIP) || inTranscript(el, root)) continue;\n      out.add(t);\n    }\n  }\n  return [...out].join('\\n');\n}\n\n// État stable : il faut N relevés consécutifs pour passer à \"actif\" (évite les clignotements)\nconst cnt = {};\nfunction stable(k, raw, nOn, nOff) {\n  const c = cnt[k] || (cnt[k] = { on: false, a: 0, b: 0 });\n  if (raw) { c.b = 0; if (!c.on && ++c.a >= nOn) c.on = true; }\n  else { c.a = 0; if (c.on && ++c.b >= nOff) c.on = false; }\n  return c.on;\n}\n\n// ---------- Limite : mémoire persistante (la limite reste marquée tant qu'elle n'est pas vraiment levée) ----------\n// Sources : (1) texte du bandeau, (2) réponse réseau 429 / \"exceeded_limit\" du site (fiable, indépendante de l'affichage).\n// Elle n'est levée que si : un message est ensuite envoyé avec succès, l'IA a répondu, le bandeau disparaît sur la même\n// page sans changement de conversation (limite réinitialisée), ou après 6 h. Changer de conversation ne la lève plus.\nconst lim = { on: false, ts: 0, src: '', until: 0 };\nlet lastNav = Date.now(), missSince = 0;      // dernière navigation ; début de l'absence du bandeau\nconst LIM_TTL = 6 * 3600 * 1000;\nfunction setLim(on, src, match, until) {\n  if (on === lim.on) return;\n  lim.on = on; lim.src = on ? src : ''; lim.until = on ? (until || 0) : 0; lim.ts = Date.now(); missSince = 0;\n  if (on) emit('limit-hit', { match: String(match || '').slice(0, 120), source: src, until: lim.until || undefined });\n  else emit('limit-cleared');\n}\n// L'app dit que l'heure de retour est passée : on oublie la limite sans bruit (elle sera redétectée si elle est encore là)\nipcRenderer.on('hub:limit-reset', () => { lim.on = false; lim.src = ''; lim.until = 0; lim.ts = Date.now(); missSince = 0; if (cnt.dom) { cnt.dom.on = false; cnt.dom.a = 0; cnt.dom.b = 0; } });\n\n// Crochet réseau injecté dans la page (monde principal) : voit les réponses du site aux envois de messages\nconst NONCE = Math.random().toString(36).slice(2) + Date.now().toString(36);\nfunction netHook(N) {\n  const WATCH = /(completion|\\/conversation(\\?|$)|\\/f\\/conversation|StreamGenerate|generateContent|\\/responses(\\?|$))/i;\n  const STRONG = /exceeded_limit|message_limit|usage[ _]limit|(reached|hit|exceeded)[^\"]{0,40}limit|limit[^\"]{0,30}(reached|exceeded)|clear_in|resets?_?at|quota|daily limit|hourly limit/i;\n  const post = (o) => { try { o.__aihub = N; window.postMessage(o, '*'); } catch (e) {} };\n  const of = window.fetch;\n  if (typeof of !== 'function' || of.__aihub) return;\n  window.fetch = function () {\n    const a = arguments, p = of.apply(this, a);\n    try {\n      const url = String((a[0] && a[0].url) || a[0] || ''), m = String((a[1] && a[1].method) || (a[0] && a[0].method) || 'GET').toUpperCase();\n      if (m === 'POST' && WATCH.test(url)) p.then((r) => {\n        if (r.ok) return post({ kind: 'ok' });\n        if (r.status === 429 || r.status >= 400) r.clone().text().then((t) => {\n          const strong = STRONG.test(t || '');\n          if (r.status === 429 || strong) post({ kind: strong ? 'limit' : 'rate', status: r.status, body: String(t || '').slice(0, 160) });\n        }).catch(() => { if (r.status === 429) post({ kind: 'rate', status: 429, body: '' }); });\n      }).catch(() => {});\n    } catch (e) {}\n    return p;\n  };\n  window.fetch.__aihub = true;\n}\n// Pour les sites qui détectent Electron / un navigateur intégré (connexion Google) : on enlève les marques\nfunction cleanIdentity() {\n  try {\n    const ua = navigator.userAgent || '';\n    const major = (/Chrome\\/(\\d+)/.exec(ua) || [])[1] || '130', full = (/Chrome\\/([\\d.]+)/.exec(ua) || [])[1] || (major + '.0.0.0');\n    const brands = [{ brand: 'Chromium', version: major }, { brand: 'Google Chrome', version: major }, { brand: 'Not?A_Brand', version: '99' }];\n    const fvl = [{ brand: 'Chromium', version: full }, { brand: 'Google Chrome', version: full }, { brand: 'Not?A_Brand', version: '99.0.0.0' }];\n    const u = navigator.userAgentData;\n    if (u) Object.defineProperty(Navigator.prototype, 'userAgentData', { configurable: true, get() {\n      return new Proxy(u, { get(t, k) {\n        if (k === 'brands') return brands;\n        if (k === 'toJSON') return () => ({ brands, mobile: t.mobile, platform: t.platform });\n        if (k === 'getHighEntropyValues') return (h) => t.getHighEntropyValues(h).then((r) => { if (r) { r.brands = brands; r.fullVersionList = fvl; } return r; });\n        const v = t[k]; return typeof v === 'function' ? v.bind(t) : v;\n      } });\n    } });\n    if (!window.chrome) window.chrome = {};\n    const c = window.chrome;\n    if (!c.runtime) c.runtime = {};\n    if (!c.app) c.app = { isInstalled: false, InstallState: { DISABLED: 'disabled', INSTALLED: 'installed', NOT_INSTALLED: 'not_installed' }, RunningState: { CANNOT_RUN: 'cannot_run', READY_TO_RUN: 'ready_to_run', RUNNING: 'running' } };\n    if (!c.csi) c.csi = () => ({ startE: Date.now(), onloadT: Date.now(), pageT: performance.now(), tran: 15 });\n    if (!c.loadTimes) c.loadTimes = () => ({ requestTime: Date.now() / 1000, navigationType: 'Other', connectionInfo: 'h2', npnNegotiatedProtocol: 'h2', wasAlternateProtocolAvailable: false, wasFetchedViaSpdy: true, wasNpnNegotiated: tr