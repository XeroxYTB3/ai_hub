{"app": "ai-hub-update", "format": 1, "version": "10.0.45", "notes": "10.0.45 : plus de survol sur les cartes et categories de Parametres", "createdAt": "2026-10-17T21:20:57.000Z", "requiresLauncher": null, "files": {"main-core.js": {"sha256": "55e79db2965a6fbf94e716af1c85a0d0b06f413c34a1fb271c0001a9e0efeead", "content": "/*\r\n * ⚠ RÈGLE N°1 — MISE À JOUR UNIVERSELLE (à lire AVANT toute modification de ce fichier)\r\n * Cette mise à jour doit TOUJOURS être compatible, PEU IMPORTE la version actuellement installée :\r\n * version d'origine de l'exe, ancienne, récente, ou même plus récente que celle-ci. N'importe qui doit\r\n * pouvoir l'installer, depuis n'importe quelle version, sans rien perdre (comptes, scripts, réglages).\r\n * Pour cela, TOUJOURS :\r\n *  1. Livrer un paquet COMPLET : les 4 fichiers (main-core.js, preload.js, webview-preload.js, index.html), jamais un paquet partiel.\r\n *  2. requiresLauncher = null. Ne rien supposer du lanceur (voir normalizeCtx dans main-core.js) et ne jamais exiger un lanceur plus récent.\r\n *  3. Garder les 4 fichiers cohérents entre eux (preload.js <-> main-core.js <-> index.html).\r\n *  4. Savoir lire les données écrites par N'IMPORTE QUELLE version : champ absent = valeur par défaut ; ne jamais supprimer ni réécrire un champ inconnu.\r\n *  5. Ne rien écrire qu'une version plus ancienne ne puisse relire (le retour arrière doit toujours marcher).\r\n *  6. Numéro de version strictement supérieur au précédent ; un numéro déjà publié n'est jamais réutilisé.\r\n */\r\nconst { app, BrowserWindow, ipcMain, session, clipboard, dialog, Notification, shell, nativeTheme, screen, Menu } = require('electron');   // 10.0.0 : lanceur reconstruit depuis le ZIP (voir <LANCEUR>)\r\nconst path = require('path'), fs = require('fs'), crypto = require('crypto');\r\nconst { pathToFileURL } = require('url');\r\n\r\n// UNIVERSEL : ce noyau doit démarrer avec N'IMPORTE QUEL lanceur (ancien, incomplet...). On complète tout ce qui manque.\r\nfunction normalizeCtx(c) {\r\n  c = c || {};\r\n  const lost = 'Ce lanceur ne gère pas les mises à jour : réinstalle AI Hub avec le dernier installeur.';\r\n  const stub = {\r\n    info: () => ({ launcherVersion: app.getVersion(), current: 'bundled', previous: 'bundled', pending: null, bad: [], history: [], versions: [] }),\r\n    install: () => ({ ok: false, error: lost }), revert: () => ({ ok: false, error: lost }),\r\n    confirm: () => false, fail: () => false, readPackage: () => { throw new Error(lost); }\r\n  };\r\n  return Object.assign({}, c, {\r\n    updater: c.updater || stub,\r\n    boot: c.boot || { version: 'bundled', dir: __dirname, rolledBack: null },\r\n    launcherVersion: c.launcherVersion || app.getVersion(),\r\n    relaunch: typeof c.relaunch === 'function' ? c.relaunch : () => { app.relaunch(); app.exit(0); },\r\n    fatal: typeof c.fatal === 'function' ? c.fatal : () => false\r\n  });\r\n}\r\n\r\n// <LANCEUR>\r\n// 10.0.0 — LANCEUR : le noyau sait reconstruire le lanceur d'AI Hub à partir du ZIP (ai-hub-launcher-10.0.0.zip),\r\n// de GitHub ou de sa copie intégrée, sans aucune action manuelle. Voir launcher/rebuild.js (même code, intégré ici\r\n// pour que la toute première reconstruction marche avec N'IMPORTE QUEL ancien lanceur).\r\nconst LZIP = (function () { const module = { exports: {} };\r\n// zip.js : lecture et écriture de fichiers ZIP, sans aucune dépendance (zlib + Buffer).\r\n// Lecture sûre : pas de chemin absolu, pas de « .. », pas de ZIP64, limites de taille, CRC vérifié.\r\nconst zlib = require('zlib');\r\n\r\nconst LIM = { files: 3000, entry: 120 * 1048576, total: 400 * 1048576 };\r\nconst CRC_T = (() => { const t = new Uint32Array(256); for (let n = 0; n < 256; n++) { let c = n; for (let k = 0; k < 8; k++) c = c & 1 ? 0xEDB88320 ^ (c >>> 1) : c >>> 1; t[n] = c >>> 0; } return t; })();\r\nconst crc32 = (b) => { let c = 0xFFFFFFFF; for (let i = 0; i < b.length; i++) c = CRC_T[(c ^ b[i]) & 255] ^ (c >>> 8); return (c ^ 0xFFFFFFFF) >>> 0; };\r\n\r\nfunction safeName(n) {\r\n  n = String(n).replace(/\\\\/g, '/');\r\n  if (!n || n.includes('\\0') || n.startsWith('/') || /^[a-zA-Z]:/.test(n)) throw new Error('chemin refusé dans le ZIP : ' + n);\r\n  if (n.split('/').some((s) => s === '..')) throw new Error('chemin refusé dans le ZIP (..) : ' + n);\r\n  return n;\r\n}\r\n\r\n// Retourne [{ name, data: Buffer }] (les dossiers sont ignorés)\r\nfunction readZip(buf, limits) {\r\n  const lim = Object.assign({}, LIM, limits || {});\r\n  if (!Buffer.isBuffer(buf) || buf.length < 22) throw new Error('ce n\\'est pas un fichier ZIP');\r\n  let eocd = -1;\r\n  for (let i = buf.length - 22, stop = Math.max(0, buf.length - 22 - 65535); i >= stop; i--) if (buf.readUInt32LE(i) === 0x06054b50) { eocd = i; break; }\r\n  if (eocd < 0) throw new Error('ce n\\'est pas un fichier ZIP (fin de fichier introuvable)');\r\n  const count = buf.readUInt16LE(eocd + 10), cdSize = buf.readUInt32LE(eocd + 12), cdOff = buf.readUInt32LE(eocd + 16);\r\n  if (count === 0xFFFF || cdOff === 0xFFFFFFFF || cdSize === 0xFFFFFFFF) throw new Error('ZIP64 non géré');\r\n  if (count > lim.files) throw new Error('trop de fichiers dans le ZIP (' + count + ')');\r\n  if (cdOff + cdSize > buf.length) throw new Error('ZIP tronqué ou corrompu');\r\n  const out = []; let p = cdOff, total = 0;\r\n  for (let k = 0; k < count; k++) {\r\n    if (p + 46 > buf.length || buf.readUInt32LE(p) !== 0x02014b50) throw new Error('ZIP corrompu (répertoire central)');\r\n    const flags = buf.readUInt16LE(p + 8), method = buf.readUInt16LE(p + 10), crc = buf.readUInt32LE(p + 16);\r\n    const csize = buf.readUInt32LE(p + 20), usize = buf.readUInt32LE(p + 24);\r\n    const nl = buf.readUInt16LE(p + 28), el = buf.readUInt16LE(p + 30), cl = buf.readUInt16LE(p + 32), lo = buf.readUInt32LE(p + 42);\r\n    const rawName = buf.toString('utf8', p + 46, p + 46 + nl); p += 46 + nl + el + cl;\r\n    if (rawName.endsWith('/')) continue;                                  // dossier\r\n    const name = safeName(rawName);\r\n    if (flags & 1) throw new Error('ZIP chiffré non géré : ' + name);\r\n    if (csize === 0xFFFFFFFF || usize === 0xFFFFFFFF) throw new Error('ZIP64 non géré : ' + name);\r\n    if (usize > lim.entry) throw new Error('fichier trop gros dans le ZIP : ' + name);\r\n    total += usize; if (total > lim.total) throw new Error('ZIP trop gros une fois décompressé');\r\n    if (lo + 30 > buf.length || buf.readUInt32LE(lo) !== 0x04034b50) throw new Error('ZIP corrompu (en-tête local) : ' + name);\r\n    const start = lo + 30 + buf.readUInt16LE(lo + 26) + buf.readUInt16LE(lo + 28);\r\n    if (start + csize > buf.length) throw new Error('ZIP tronqué : ' + name);\r\n    const raw = buf.subarray(start, start + csize);\r\n    let data;\r\n    if (method === 0) data = Buffer.from(raw);\r\n    else if (method === 8) data = zlib.inflateRawSync(raw, { maxOutputLength: lim.entry + 1 });\r\n    else throw new Error('méthode de compression non gérée (' + method + ') : ' + name);\r\n    if (data.length !== usize) throw new Error('taille incorrecte : ' + name);\r\n    if (crc32(data) !== crc) throw new Error('somme de contrôle incorrecte (ZIP corrompu) : ' + name);\r\n    out.push({ name, data });\r\n  }\r\n  return out;\r\n}\r\n\r\n// entries : [{ name, data: Buffer, mtime?: Date }]\r\nfunction makeZip(entries) {\r\n  const locals = [], central = []; let off = 0;\r\n  for (const e of entries) {\r\n    const name = Buffer.from(safeName(e.name), 'utf8'), raw = Buffer.isBuffer(e.data) ? e.data : Buffer.from(e.data);\r\n    const def = zlib.deflateRawSync(raw, { level: 9 }), useDef = def.length < raw.length, body = useDef ? def : raw, method = useDef ? 8 : 0;\r\n    const crc = crc32(raw), d = e.mtime || new Date(Date.UTC(2026, 9, 14, 12, 0, 0));\r\n    const time = (d.getUTCHours() << 11) | (d.getUTCMinutes() << 5) | (d.getUTCSeconds() >> 1);\r\n    const date = (((d.getUTCFullYear() - 1980) & 127) << 9) | ((d.getUTCMonth() + 1) << 5) | d.getUTCDate();\r\n    const lh = Buffer.alloc(30); lh.writeUInt32LE(0x04034b50, 0); lh.writeUInt16LE(20, 4); lh.writeUInt16LE(0x0800, 6); lh.writeUInt16LE(method, 8);\r\n    lh.writeUInt16LE(time, 10); lh.writeUInt16LE(date, 12); lh.writeUInt32LE(crc, 14); lh.writeUInt32LE(body.length, 18); lh.writeUInt32LE(raw.length, 22); lh.writeUInt16LE(name.length, 26);\r\n    const ch = Buffer.alloc(46); ch.writeUInt32LE(0x02014b50, 0); ch.writeUInt16LE(20, 4); ch.writeUInt16LE(20, 6); ch.writeUInt16LE(0x0800, 8); ch.writeUInt16LE(method, 10);\r\n    ch.writeUInt16LE(time, 12); ch.writeUInt16LE(date, 14); ch.writeUInt32LE(crc, 16); ch.writeUInt32LE(body.length, 20); ch.writeUInt32LE(raw.length, 24); ch.writeUInt16LE(name.length, 28); ch.writeUInt32LE(off, 42);\r\n    locals.push(lh, name, body); central.push(ch, name); off += 30 + name.length + body.length;\r\n  }\r\n  const cd = Buffer.concat(central), end = Buffer.alloc(22);\r\n  end.writeUInt32LE(0x06054b50, 0); end.writeUInt16LE(entries.length, 8); end.writeUInt16LE(entries.length, 10); end.writeUInt32LE(cd.length, 12); end.writeUInt32LE(off, 16);\r\n  return Buffer.concat([...locals, cd, end]);\r\n}\r\n\r\nmodule.exports = { readZip, makeZip, crc32, safeName };\r\n\r\nreturn module.exports; })();\r\nconst LREBUILD = (function () { const module = { exports: {} };\r\n// rebuild.js : reconstruction du lanceur d'AI Hub.\r\n// Trouve le ZIP du lanceur (à côté / Téléchargements / dépôt GitHub / copie intégrée à la mise à jour), le vérifie\r\n// (empreintes, syntaxe, essai dans un processus séparé), l'installe dans <données>/launcher/<version>/, puis prépare\r\n// le remplacement des fichiers du lanceur dans le dossier d'installation (fait à la fermeture, avec copie de secours).\r\n// Ce fichier est à la fois : (1) intégré dans le noyau de la mise à jour (première reconstruction) et\r\n// (2) livré dans le ZIP (lanceur reconstruit). Il n'utilise pas Electron directement : tout passe par `env`.\r\nconst fs = require('fs'), path = require('path'), os = require('os'), cp = require('child_process'), crypto = require('crypto'), vm = require('vm');\r\n\r\nconst VERSION_RE = /^\\d+\\.\\d+\\.\\d+(-[\\w.]+)?$/;\r\nconst ZIP_RE = /^ai-hub-launcher-(\\d+)[._](\\d+)[._](\\d+).*\\.zip$/i;\r\nconst REQUIRED = ['main.js', 'package.json', 'updater.js', 'launcher/boot.js', 'launcher/updater.js', 'launcher/rebuild.js', 'launcher/zip.js', 'launcher/swap.js'];\r\nconst isPayloadRel = (r) => r === 'main.js' || r === 'package.json' || r === 'updater.js' || r.startsWith('launcher/');\r\nconst MAX_ZIP = 80 * 1048576;\r\nconst sha = (b) => crypto.createHash('sha256').update(b).digest('hex');\r\nconst nums = (v) => String(v).split(/[.-]/).slice(0, 3).map((n) => parseInt(n, 10) || 0);\r\nconst cmp = (a, b) => { const x = nums(a), y = nums(b); for (let i = 0; i < 3; i++) if ((x[i] || 0) !== (y[i] || 0)) return (x[i] || 0) - (y[i] || 0); return 0; };\r\nconst alive = (pid) => { try { process.kill(pid, 0); return true; } catch (e) { return e.code === 'EPERM'; } };\r\nfunction atomicWrite(file, data) {\r\n  fs.mkdirSync(path.dirname(file), { recursive: true });\r\n  const tmp = file + '.' + process.pid + '.tmp'; fs.writeFileSync(tmp, data);\r\n  try { fs.renameSync(tmp, file); } catch (e) { try { fs.writeFileSync(file, data); fs.unlinkSync(tmp); } catch { throw e; } }\r\n}\r\nfunction syntaxErr(name, code) {\r\n  try { new vm.Script('(function(exports,require,module,__filename,__dirname){' + code + '\\n})', { filename: name }); return null; } catch (e) { return name + ' : ' + e.message; }\r\n}\r\n\r\nfunction createRebuilder(env) {\r\n  const zip = env.zip || require('./zip.js');\r\n  const userData = env.userData, L = path.join(userData, 'launcher'), CUR = path.join(L, 'current.json'), LOG = path.join(L, 'rebuild.log'), SW = path.join(L, 'swap');\r\n  const embed = env.embed || null;                       // { version, hashes: { rel: sha256 }, zipB64 }\r\n  const minVersion = env.minVersion || (embed && embed.version) || '0.0.0';\r\n  const gh = Object.assign({ owner: 'XeroxYTB3', repo: 'ai_hub', api: 'https://api.github.com', raw: 'https://raw.githubusercontent.com', page: 'https://github.com' }, env.github || {});\r\n  const mem = [];                                        // dernières lignes du journal (pour l'écran)\r\n  let running = null, lastError = null, lastResult = null;\r\n\r\n  const log = (m) => {\r\n    const line = '[' + new Date().toISOString().replace('T', ' ').slice(0, 19) + '] ' + m;\r\n    mem.push(line); if (mem.length > 120) mem.shift();\r\n    try { fs.mkdirSync(L, { recursive: true }); try { if (fs.statSync(LOG).size > 200000) fs.writeFileSync(LOG, mem.join('\\n') + '\\n'); } catch {} fs.appendFileSync(LOG, line + '\\n'); } catch {}\r\n    try { env.emit && env.emit('log', line); } catch {}\r\n  };\r\n  const emit = (type, data) => { try { env.emit && env.emit(type, data); } catch {} };\r\n\r\n  // ---------- état du lanceur reconstruit ----------\r\n  function readCurrent() {\r\n    try { const c = JSON.parse(fs.readFileSync(CUR, 'utf8')); if (c && VERSION_RE.test(String(c.version)) && c.files && typeof c.files === 'object') return c; } catch {}\r\n    return null;\r\n  }\r\n  function verifyInstalled(c) {\r\n    if (!c) return false;\r\n    const dir = path.join(L, c.version);\r\n    try { for (const [rel, h] of Object.entries(c.files)) if (sha(fs.readFileSync(path.join(dir, rel))) !== h) return false; return true; } catch { return false; }\r\n  }\r\n  function payloadDir(c) { return path.join(L, (c || readCurrent()).version); }\r\n  // Charge le lanceur reconstruit (après vérification de chaque fichier). null si absent ou abîmé.\r\n  function loadPayload() {\r\n    const c = readCurrent();\r\n    if (!c) return null;\r\n    if (!verifyInstalled(c)) { log('Lanceur reconstruit ' + c.version + ' : fichiers abîmés, ignoré'); return null; }\r\n    try { const m = require(path.join(payloadDir(c), 'launcher', 'boot.js')); return { boot: m, version: c.version, dir: payloadDir(c), current: c }; }\r\n    catch (e) { log('Lanceur reconstruit ' + c.version + ' : chargement impossible (' + e.message + ')'); return null; }\r\n  }\r\n\r\n  // ---------- validation d'un ZIP ----------\r\n  function validate(entries, label) {\r\n    const mf = entries.find((e) => e.name === 'manifest.json') || entries.find((e) => /^[^/]+\\/manifest\\.json$/.test(e.name));\r\n    if (!mf) throw new Error('manifest.json absent (ce n\\'est pas le ZIP du lanceur)');\r\n    const prefix = mf.name.slice(0, mf.name.length - 'manifest.json'.length);\r\n    let man; try { man = JSON.parse(mf.data.toString('utf8')); } catch { throw new Error('manifest.json illisible'); }\r\n    if (!man || man.app !== 'ai-hub-launcher' || man.format !== 1) throw new Error('ce ZIP n\\'est pas un lanceur AI Hub');\r\n    if (!VERSION_RE.test(String(man.version))) throw new Error('version invalide : ' + man.version);\r\n    if (cmp(man.version, minVersion) < 0) throw new Error('version ' + man.version + ' trop ancienne (' + minVersion + ' ou plus récente requise)');\r\n    if (!man.files || typeof man.files !== 'object') throw new Error('liste de fichiers absente');\r\n    for (const r of REQUIRED) if (!man.files[r]) throw new Error('fichier obligatoire absent du manifeste : ' + r);\r\n    const byName = new Map(entries.map((e) => [e.name, e.data])), files = new Map();\r\n    for (const [rel, h] of Object.entries(man.files)) {\r\n      zip.safeName(rel);\r\n      const d = byName.get(prefix + rel);\r\n      if (!d) throw new Error('fichier manquant dans le ZIP : ' + rel);\r\n      if (sha(d) !== h) throw new Error('empreinte incorrecte (ZIP modifié ou abîmé) : ' + rel);\r\n      if (rel.endsWith('.js')) { const e = syntaxErr(rel, d.toString('utf8')); if (e) throw new Error('erreur de syntaxe — ' + e); }\r\n      files.set(rel, d);\r\n    }\r\n    if (embed && man.version === embed.version)           // même version que celle prévue par la mise à jour : les fichiers doivent être identiques\r\n      for (const [rel, h] of Object.entries(embed.hashes)) if (man.files[rel] !== h) throw new Error('ne correspond pas à cette mise à jour (' + rel + ' différent)');\r\n    return { manifest: man, files, label };\r\n  }\r\n\r\n  // ---------- sources ----------\r\n  function localDirs() {\r\n    const out = [path.join(L, 'zip'), L, path.join(userData, 'updates')], g = (n) => { try { return env.app.getPath(n); } catch { return null; } };\r\n    for (const n of ['downloads', 'desktop', 'documents', 'home', 'exe', 'temp']) { const p = g(n); if (p) out.push(n === 'exe' ? path.dirname(p) : p); }\r\n    const h = os.homedir(); for (const s of ['Downloads', 'Téléchargements', 'Desktop', 'Bureau', 'Documents']) out.push(path.join(h, s));\r\n    out.push(...(env.extraDirs || []), process.cwd());\r\n    return [...new Set(out.filter(Boolean).map((d) => path.resolve(d)))];\r\n  }\r\n  function findLocalZips() {\r\n    const found = [];\r\n    for (const d of localDirs()) {\r\n      let names; try { names = fs.readdirSync(d); } catch { continue; }\r\n      const drop = d === path.join(L, 'zip');\r\n      for (const n of names) {\r\n        const m = ZIP_RE.exec(n); if (!m && !(drop && /\\.zip$/i.test(n))) continue;\r\n        const f = path.join(d, n); let st; try { st = fs.statSync(f); } catch { continue; }\r\n        if (st.isFile() && st.size > 1000 && st.size <= MAX_ZIP) found.push({ file: f, v: m ? [+m[1], +m[2], +m[3]] : [0, 0, 0], mtime: st.mtimeMs });\r\n      }\r\n    }\r\n    return found.sort((a, b) => cmp(b.v.join('.'), a.v.join('.')) || b.mtime - a.mtime).slice(0, 12);\r\n  }\r\n  async function http(url, ms, asBuf) {\r\n    const ac = new AbortController(), to = setTimeout(() => ac.abort(), ms);\r\n    try {\r\n      const r = await (env.fetch || fetch)(url, { signal: ac.signal, redirect: 'follow', headers: { 'User-Agent': 'AI-Hub-Launcher', Accept: 'application/vnd.github+json, */*' } });\r\n      if (!r.ok) throw new Error('HTTP ' + r.status);\r\n      if (asBuf) { const n = +r.headers.get('content-length') || 0; if (n > MAX_ZIP) throw new Error('fichier trop gros'); const b = Buffer.from(await r.arrayBuffer()); if (b.length > MAX_ZIP) throw new Error('fichier trop gros'); return b; }\r\n      return await r.text();\r\n    } catch (e) { throw new Error(e.name === 'AbortError' ? 'délai dépassé' : e.message); } finally { clearTimeout(to); }\r\n  }\r\n  async function ghLatestZip() {\r\n    let names = [], err = '';\r\n    try { const j = JSON.parse(await http(gh.api + '/repos/' + gh.owner + '/' + gh.repo + '/contents/', 12000)); if (Array.isArray(j)) names = j.filter((f) => f && f.type === 'file').map((f) => f.name); } catch (e) { err = e.message; }\r\n    const pick = (ns) => { let b = null; for (const n of ns) { const m = ZIP_RE.exec(String(n)); if (m && (!b || cmp(m.slice(1, 4).join('.'), b.version) > 0)) b = { name: String(n), version: m.slice(1, 4).join('.') }; } return b; };\r\n    let best = pick(names);\r\n    if (!best) { try { const h = await http(gh.page + '/' + gh.owner + '/' + gh.repo, 12000); best = pick([...new Set(h.match(/ai-hub-launcher-\\d+[._]\\d+[._]\\d+[^\"'<>\\s]*\\.zip/gi) || [])]); } catch (e) { err = err || e.message; } }\r\n    if (!best) throw new Error(err ? 'dépôt injoignable (' + err + ')' : 'aucun ZIP de lanceur dans le dépôt');\r\n    return best;\r\n  }\r\n\r\n  // ---------- essai dans un processus séparé ----------\r\n  function selfTest(dir) {\r\n    const code = 'try{const b=require(' + JSON.stringify(path.join(dir, 'launcher', 'boot.js')) + ');process.stdout.write(String(b.selftest()))}catch(e){process.stderr.write(String(e&&e.stack||e));process.exit(3)}';\r\n    try {\r\n      const out = cp.execFileSync(process.execPath, ['-e', code], { env: Object.assign({}, process.env, { ELECTRON_RUN_AS_NODE: '1' }), timeout: 25000, windowsHide: true, encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'] });\r\n      if (String(out).trim() !== 'ok') throw Object.assign(new Error('résultat inattendu : ' + String(out).slice(0, 80)), { status: 3 });\r\n      return { ok: true };\r\n    } catch (e) {\r\n      if (e.status === 3 || /^Error|SyntaxError|TypeError/.test(String(e.stderr || '').slice(0, 40))) return { ok: false, error: String(e.stderr || e.message).split('\\n').slice(0, 3).join(' | ').slice(0, 300) };\r\n      return { ok: true, warn: 'essai séparé impossible (' + (e.code || e.message) + ')' };\r\n    }\r\n  }\r\n\r\n  // ---------- installation du lanceur reconstruit (données) ----------\r\n  function installPayload(v, source) {\r\n    const ver = v.manifest.version, tmp = path.join(L, ver + '.tmp'), dst = path.join(L, ver), hashes = {};\r\n    fs.rmSync(tmp, { recursive: true, force: true }); fs.mkdirSync(tmp, { recursive: true });\r\n    for (const [rel, data] of v.files) {\r\n      if (!isPayloadRel(rel)) continue;\r\n      const f = path.join(tmp, rel); fs.mkdirSync(path.dirname(f), { recursive: true }); fs.writeFileSync(f, data);\r\n      if (sha(fs.readFileSync(f)) !== sha(data)) throw new Error('écriture incorrecte : ' + rel);\r\n      hashes[rel] = sha(data);\r\n    }\r\n    fs.writeFileSync(path.join(tmp, 'manifest.json'), JSON.stringify(v.manifest, null, 1)); hashes['manifest.json'] = sha(fs.readFileSync(path.join(tmp, 'manifest.json')));\r\n    const st = selfTest(tmp);\r\n    if (!st.ok) { fs.rmSync(tmp, { recursive: true, force: true }); throw new Error('essai du lanceur échoué : ' + st.error); }\r\n    if (st.warn) log('⚠ ' + st.warn);\r\n    const old = readCurrent();\r\n    fs.rmSync(dst, { recursive: true, force: true }); fs.renameSync(tmp, dst);\r\n    atomicWrite(CUR, JSON.stringify({ format: 1, version: ver, files: hashes, source, installedAt: Date.now(), previous: old && old.version !== ver ? old.version : (old && old.previous) || null }, null, 1));\r\n    try {                                                    // ne garde que les 3 dernières versions (et celle d'un remplacement en attente)\r\n      const job = readJob()