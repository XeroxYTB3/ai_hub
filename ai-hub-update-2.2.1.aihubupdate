{"app":"ai-hub-update","format":1,"version":"2.2.1","notes":"Limite atteinte : détection permanente, la conversation n'est plus lue, limite mémorisée, détection réseau 429 ; connexion Google : identité Electron masquée","createdAt":"2026-10-06T20:25:27.272Z","requiresLauncher":null,"files":{"webview-preload.js":{"sha256":"7872966a9f5b3aa2c73f415a482f30b013ab40f64cd3e906aabbfa4a9f224606","content":"// Tourne DANS chaque page de chat : détecte les événements et les envoie à l'app\nconst { ipcRenderer, webFrame } = require('electron');\nlet cfg = { detectors: [], idle: 120, sel: {} };\n\n// Sélecteurs par défaut + sélecteurs de secours ajoutés dans Paramètres > Détections (cfg.sel)\nconst BASE = {\n  user: '[data-testid=\"user-message\"],user-query,[data-message-author-role=\"user\"]',\n  ai: '.font-claude-response,model-response,[data-message-author-role]:not([data-message-author-role=\"user\"])',   // aligné sur index.html\n  comp: '[contenteditable=\"true\"],textarea',\n  stop: '[data-testid=\"stop-button\"],button[aria-label*=\"Stop\" i],button[aria-label*=\"Arrêter\" i],button[aria-label*=\"Interrompre\" i]',\n  send: '[data-testid=\"send-button\"],button[aria-label*=\"Send\" i],button[aria-label*=\"Envoyer\" i]'\n};\nconst S = Object.assign({}, BASE);\nlet SKIP = '';\nfunction applySel() {\n  const sel = cfg.sel || {};\n  for (const k of Object.keys(BASE)) {\n    let extra = (sel[k] || '').trim();\n    if (extra) { try { document.querySelector(extra); } catch { ipcRenderer.sendToHost('hub-event', { type: 'selector-invalid', detail: { key: k, value: extra }, url: location.href, ts: Date.now() }); extra = ''; } }\n    S[k] = extra ? BASE[k] + ',' + extra : BASE[k];\n  }\n  SKIP = S.user + ',' + S.ai + ',' + S.comp + ',nav,aside,script,style,noscript';\n}\napplySel();\nipcRenderer.on('hub:config', (_e, c) => { cfg = c; applySel(); });\n\n// Limite atteinte : gérée à part (machine à états persistante, voir poll). Textes FR + EN de Claude, ChatGPT, Gemini...\nconst LIMIT_RE = /(you('|’)?ve (hit|reached|exceeded) (your|the|our|this) [\\w\\s-]{0,25}(limit|cap)|you (have|had) (hit|reached|exceeded) (your|the|our) [\\w\\s-]{0,25}(limit|cap)|you('|’)?re out of [\\w\\s-]{0,15}messages|usage (limit|cap)|message (limit|cap)|limit reached|out of (free )?messages|limite (d['’]utilisation|de messages|quotidienne|horaire|atteinte|dépassée)|vous avez (atteint|dépassé) (votre|la) limite|vous avez (épuisé|atteint) (vos|votre) [\\w\\s'’-]{0,25}(messages|quota|limite)|quota (épuisé|dépassé|exceeded)|(n['’]avez|il n['’]y a) plus de messages|plus de messages (gratuits|disponibles)|plus aucun message|come back (later|tomorrow)|reviens? plus tard)/i;\n// [événement, regex, événement de fin]\nconst PAT = [\n  ['limit-soon', /(\\d+|few) messages? (remaining|left)|il vous reste \\d+ message|\\d+ messages? restants?/i],\n  ['rate-limit', /(too many (requests|messages)|rate limit|trop de (requêtes|messages)|slow down|ralentissez)/i],\n  ['overloaded', /(overloaded|at capacity|high demand|forte demande|surcharg|temporarily unavailable|service unavailable|temporairement indisponible)/i],\n  ['error', /(something went wrong|an error occurred|une erreur (est survenue|s['’]est produite)|network error|erreur réseau|failed to (load|send|generate)|impossible de (générer|envoyer)|unable to (send|generate))/i],\n  ['chat-too-long', /(conversation (is )?too long|conversation trop longue|context (window|limit)|maximum (conversation )?length|longueur maximale|start a new (chat|conversation)|commencez une nouvelle conversation)/i],\n  ['captcha', /(verify (that )?you are human|verifying you are human|vérifiez que vous êtes (un )?humain|checking your browser|just a moment|vérification de sécurité)/i, 'captcha-cleared']\n];\nconst LOGIN_BTN = /^(log ?in|sign ?in|se connecter|connexion|continue with (google|email)|continuer avec (google|e-?mail))$/im;\n\nconst emit = (type, detail) => ipcRenderer.sendToHost('hub-event', { type, detail, url: location.href, ts: Date.now() });\nconst q = (s) => { try { return [...document.querySelectorAll(s)]; } catch { return []; } };\nconst vis = (e) => e && e.offsetParent !== null;\nemit('page-start');\nconst flags = {};\nconst edge = (k, on, onT, offT, d) => {\n  if (on && !flags[k]) { flags[k] = 1; emit(onT, d); }\n  else if (!on && flags[k]) { flags[k] = 0; if (offT) emit(offT); }\n};\n// Texte court de TOUTE la page : uniquement pour la détection de connexion et les pages sans conversation (captcha, erreur plein écran)\nfunction pageTexts() {\n  const out = [], w = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT); let n;\n  while ((n = w.nextNode())) {\n    const t = n.nodeValue.trim();\n    if (t.length > 2 && t.length < 300) { const p = n.parentElement; if (p && !p.closest(SKIP)) out.push(t); }\n  }\n  return out.join('\\n');\n}\n\n// Texte court des ZONES D'INTERFACE seulement (alertes, fenêtres, bandeau autour de la zone de saisie).\n// La conversation n'est JAMAIS lue : même si les sélecteurs de messages changent, un échange qui parle de\n// \"limite atteinte\" ne peut plus déclencher de fausse alerte. On exclut aussi toute zone qui défile (= la conversation).\nconst ZONE_ALERT = '[role=\"alert\"],[role=\"status\"],[role=\"alertdialog\"],[role=\"dialog\"],[aria-modal=\"true\"],[aria-live=\"assertive\"],[data-testid*=\"limit\" i],[data-testid*=\"banner\" i],[data-testid*=\"toast\" i],[data-testid*=\"error\" i],[class*=\"toast\" i],[class*=\"banner\" i],[class*=\"snackbar\" i]';\nlet scrollMemo = new WeakMap();\nconst isScroller = (el) => {\n  let r = scrollMemo.get(el);\n  if (r === undefined) {\n    try { const cs = getComputedStyle(el); r = /(auto|scroll)/.test(cs.overflowY) && el.clientHeight > 120 && el.scrollHeight > el.clientHeight + 40; } catch { r = false; }\n    scrollMemo.set(el, r);\n  }\n  return r;\n};\nconst inTranscript = (el, root) => { for (let e = el; e; e = e.parentElement) { if (isScroller(e)) return true; if (e === root) break; } return false; };\nconst hasMsg = (el) => { try { return !!el.querySelector(S.user + ',' + S.ai) || !!el.closest(S.user + ',' + S.ai); } catch { return false; } };\nfunction zoneTexts() {\n  scrollMemo = new WeakMap();\n  const roots = new Set(q(ZONE_ALERT));\n  const c = q(S.comp).find(vis);\n  if (c) {                                    // bandeau juste au-dessus / autour de la zone de saisie\n    let p = c;\n    for (let i = 0; i < 5 && p.parentElement && p.parentElement !== document.body; i++) {\n      const n = p.parentElement;\n      if (isScroller(n) || hasMsg(n)) break;\n      p = n;\n    }\n    roots.add(p);\n  }\n  const out = new Set();\n  for (const root of roots) {\n    if (!root.isConnected || hasMsg(root)) continue;\n    const w = document.createTreeWalker(root, NodeFilter.SHOW_TEXT); let n;\n    while ((n = w.nextNode())) {\n      const t = n.nodeValue.trim();\n      if (t.length < 3 || t.length >= 300) continue;\n      const el = n.parentElement;\n      if (!el || !el.getClientRects().length || el.closest(SKIP) || inTranscript(el, root)) continue;\n      out.add(t);\n    }\n  }\n  return [...out].join('\\n');\n}\n\n// État stable : il faut N relevés consécutifs pour passer à \"actif\" (évite les clignotements)\nconst cnt = {};\nfunction stable(k, raw, nOn, nOff) {\n  const c = cnt[k] || (cnt[k] = { on: false, a: 0, b: 0 });\n  if (raw) { c.b = 0; if (!c.on && ++c.a >= nOn) c.on = true; }\n  else { c.a = 0; if (c.on && ++c.b >= nOff) c.on = false; }\n  return c.on;\n}\n\n// ---------- Limite : mémoire persistante (la limite reste marquée tant qu'elle n'est pas vraiment levée) ----------\n// Sources : (1) texte du bandeau, (2) réponse réseau 429 / \"exceeded_limit\" du site (fiable, indépendante de l'affichage).\n// Elle n'est levée que si : un message est ensuite envoyé avec succès, l'IA a répondu, le bandeau disparaît sur la même\n// page sans changement de conversation (limite réinitialisée), ou après 6 h. Changer de conversation ne la lève plus.\nconst lim = { on: false, ts: 0, src: '' };\nlet lastNav = Date.now(), missSince = 0;      // dernière navigation ; début de l'absence du bandeau\nconst LIM_TTL = 6 * 3600 * 1000;\nfunction setLim(on, src, match) {\n  if (on === lim.on) return;\n  lim.on = on; lim.src = on ? src : ''; lim.ts = Date.now(); missSince = 0;\n  if (on) emit('limit-hit', { match: String(match || '').slice(0, 120), source: src });\n  else emit('limit-cleared');\n}\n\n// Crochet réseau injecté dans la page (monde principal) : voit les réponses du site aux envois de messages\nconst NONCE = Math.random().toString(36).slice(2) + Date.now().toString(36);\nfunction netHook(N) {\n  const WATCH = /(completion|\\/conversation(\\?|$)|\\/f\\/conversation|StreamGenerate|generateContent|\\/responses(\\?|$))/i;\n  const STRONG = /exceeded_limit|message_limit|usage[ _]limit|(reached|hit|exceeded)[^\"]{0,40}limit|limit[^\"]{0,30}(reached|exceeded)|clear_in|resets?_?at|quota|daily limit|hourly limit/i;\n  const post = (o) => { try { o.__aihub = N; window.postMessage(o, '*'); } catch (e) {} };\n  const of = window.fetch;\n  if (typeof of !== 'function' || of.__aihub) return;\n  window.fetch = function () {\n    const a = arguments, p = of.apply(this, a);\n    try {\n      const url = String((a[0] && a[0].url) || a[0] || ''), m = String((a[1] && a[1].method) || (a[0] && a[0].method) || 'GET').toUpperCase();\n      if (m === 'POST' && WATCH.test(url)) p.then((r) => {\n        if (r.ok) return post({ kind: 'ok' });\n        if (r.status === 429 || r.status >= 400) r.clone().text().then((t) => {\n          const strong = STRONG.test(t || '');\n          if (r.status === 429 || strong) post({ kind: strong ? 'limit' : 'rate', status: r.status, body: String(t || '').slice(0, 160) });\n        }).catch(() => { if (r.status === 429) post({ kind: 'rate', status: 429, body: '' }); });\n      }).catch(() => {});\n    } catch (e) {}\n    return p;\n  };\n  window.fetch.__aihub = true;\n}\n// Pour les sites qui détectent Electron / un navigateur intégré (connexion Google) : on enlève les marques\nfunction cleanIdentity() {\n  try {\n    const u = navigator.userAgentData;\n    if (u && u.brands && u.brands.some((b) => /electron/i.test(b.brand))) {\n      const brands = u.brands.filter((b) => !/electron/i.test(b.brand));\n      Object.defineProperty(Navigator.prototype, 'userAgentData', { configurable: true, get() {\n        return new Proxy(u, { get(t, k) {\n          if (k === 'brands') return brands;\n          if (k === 'toJSON') return () => ({ brands, mobile: t.mobile, platform: t.platform });\n          const v = t[k]; return typeof v === 'function' ? v.bind(t) : v;\n        } });\n      } });\n    }\n    if (!window.chrome) window.chrome = { runtime: {} };\n  } catch (e) {}\n}\ntry { webFrame.executeJavaScript('(' + cleanIdentity.toString() + ')();(' + netHook.toString() + ')(' + JSON.stringify(NONCE) + ');').catch(() => {}); } catch {}\nlet lastRate = 0;\nwindow.addEventListener('message', (e) => {\n  const d = e.data;\n  if (!d || d.__aihub !== NONCE) return;\n  if (d.kind === 'limit') setLim(true, 'network', d.status + ' ' + d.body);\n  else if (d.kind === 'rate') { if (Date.now() - lastRate > 15000) { lastRate = Date.now(); emit('rate-limit', { match: d.status + ' ' + d.body, source: 'network' }); } }\n  else if (d.kind === 'ok') { if (lim.on) setLim(false); }\n});\n\nlet lastUrl = location.href, pu = null, lastLen = 0, lastGrow = 0, recentSend = 0, lastTyping = 0, lastAct = Date.now();\nlet gen = false, genStart = 0, genSeen = 0, lg = null, lgCount = 0, t0 = Date.now();\n\ndocument.addEventListener('keydown', (e) => {\n  lastAct = Date.now();\n  if (e.key === 'Enter' && !e.shiftKey && e.target.closest && e.target.closest(S.comp)) {\n    const t = (e.target.value || e.target.innerText || '').trim();\n    if (t) { recentSend = Date.now(); emit('send-attempt', { via: 'enter', preview: t.slice(0, 200) }); }\n  }\n}, true);\ndocument.addEventListener('click', (e) => {\n  lastAct = Date.now();\n  if (e.target.closest && e.target.closest(S.send)) {\n    const c = q(S.comp)[0]; const t = c ? (c.value || c.innerText || '').trim() : '';\n    recentSend = Date.now(); emit('send-attempt', { via: 'click', preview: t.slice(0, 200) });\n  }\n}, true);\ndocument.addEventListener('input', (e) => {\n  lastAct = Date.now();\n  if (e.target.closest && e.target.closest(S.comp) && Date.now() - lastTyping > 3000) emit('typing');\n  lastTyping = Date.now();\n}, true);\ndocument.addEventListener('visibilitychange', () => emit(document.hidden ? 'tab-hidden' : 'tab-visible'));\nwindow.addEventListener('offline', () => emit('offline'));\nwindow.addEventListener('online', () => emit('online'));\nwindow.addEventListener('load', () => emit('page-loaded', { title: document.title }));\n\nfunction poll() {\n  if (!document.body) return;\n  const now = Date.now();\n  // URL / navigation\n  if (location.href !== lastUrl) {\n    emit('url-changed', { from: lastUrl, to: location.href }); lastUrl = location.href; lastNav = now;\n    if (/^\\/(new|app|chat)?\\/?$/.test(location.pathname)) emit('new-chat');\n    else if (/\\/(chat|c|chats|app|thread|search)\\/[\\w-]{8,}/.test(location.pathname)) emit('chat-opened');\n  }\n  // connexion\n  const comp = q(S.comp).some(vis), pw = q('input[type=password]').some(vis);\n  const cur = comp && !pw ? true : (!comp && (pw || LOGIN_BTN.test(pageTexts())) && now - t0 > 2500 ? false : null);\n  if (cur !== null) {\n    if (cur === lg) lgCount = 0; else if (++lgCount >= 2) {\n      if (cur) emit('logged-in'); else { emit('login-required'); if (lg === true) emit('session-expired'); }\n      lg = cur; lgCount = 0;\n    }\n  }\n  // messages + génération\n  const users = q(S.user), ais = q(S.ai), u = users.length;\n  if (pu === null || u < pu) pu = u;\n  else if (u === pu + 1) {\n    pu = u; recentSend = now;\n    emit('message-sent', { count: u, preview: (users[u - 1].innerText || '').trim().slice(0, 200) });\n  } else pu = u;\n  const last = ais[ais.length - 1], len = last ? last.textContent.length : 0;\n  if (len > lastLen && now - recentSend < 90000) lastGrow = now;\n  lastLen = len;\n  const stopOn = q(S.stop).some(vis);\n  const g = stopOn || now - lastGrow < 1500;\n  if (g) genSeen = now;\n  if (g && !gen) { gen = true; genStart = now; emit('response-started', { via: stopOn ? 'stop-button' : 'text-growth' }); }\n  else if (!g && gen && now - genSeen > 1200) {\n    gen = false;\n    if (lim.on && genStart > lim.ts && len >= 20) setLim(false);\n    emit('response-complete', { chars: len, seconds: Math.round((now - genStart) / 100) / 10, userMessages: u, aiMessages: ais.length, preview: last ? last.textContent.trim().slice(0, 300) : '' });\n  }\n  // bannières / erreurs\n  // Pages sans conversation ni zone de saisie (captcha, erreur plein écran) : toute la page ; sinon seulement les zones d'interface\n  const bare = !comp && users.length === 0 && ais.length === 0;\n  const txt = bare ? pageTexts() : zoneTexts();\n  const lm = txt.match(LIMIT_RE);\n  const domOn = stable('dom', !!lm, 3, 5);          // 3 relevés consécutifs pour s'activer\n  if (lm) missSince = 0; else if (!missSince) missSince = now;\n  if (domOn && !lim.on && now - lim.ts > 10000) setLim(true, 'page', lm && lm[0]);\n  // bandeau disparu SANS changement de conversation autour de ce moment = limite réinitialisée ; sinon on garde la limite\n  else if (lim.on && lim.src === 'page' && !lm && missSince && now - missSince > 4000 && lastNav < missSince - 3000) setLim(false);\n  if (lim.on && now - lim.ts > LIM_TTL) setLim(false);\n  for (const [type, re, off] of PAT) { const m = txt.match(re); const on = stable(type, !!m, 2, 3); edge('p' + type, on, type, off, m && { match: m[0].slice(0, 120) }); }\n  // détecteurs personnalisés\n  for (const d of cfg.detectors || []) {\n    if (!d.name || !d.value || (d.host !== '*' && !location.hostname.endsWith(d.host))) continue;\n    let on = false;\n    try { on = d.kind === 'selector' ? q(d.value).length > 0 : new RegExp(d.value, 'i').test(txt); } catch {}\n    edge('c' + d.name, on, d.name, d.name + '-gone', {});\n  }\n  // inactivité\n  edge('idle', !gen && now - lastAct > (cfg.idle || 120) * 1000, 'idle', 'active', {});\n}\nsetInterval(poll, 800);\n"},"main-core.js":{"sha256":"7df81781468bf64b5f9f1bd3b35c92a8949c536ad4782b1320804d4da8468df9","content":"const { app, BrowserWindow, ipcMain, session, clipboard, dialog, Notification, shell, nativeTheme } = require('electron');\nconst path = require('path'), fs = require('fs'), crypto = require('crypto');\nconst { pathToFileURL } = require('url');\n\nmodule.exports = function start(ctx) {\nlet win;\n// (Le dossier de données fixe est défini par le lanceur main.js)\nconst ud = () => app.getPath('userData');\nconst STATE = () => path.join(ud(), 'ai-hub-state.json');\nconst BK = () => path.join(ud(), 'backups');\nlet lastBk = 0;\n\n// Thème enregistré (lu avant d'ouvrir la fenêtre pour éviter un flash blanc/noir au démarrage)\nconst BG = { dark: '#262624', light: '#FAF9F5' };\nfunction savedTheme() { try { const t = JSON.parse(fs.readFileSync(STATE(), 'utf8')).settings.theme; return ['light', 'dark'].includes(t) ? t : 'system'; } catch { return 'system'; } }\nif (process.platform === 'win32') { try { app.setAppUserModelId('com.aihub.app'); } catch {} }   // nécessaire pour les notifications Windows\n\n// Les sites ne peuvent pas envoyer leurs propres notifications ni demander la position : AI Hub centralise les notifications\nconst DENY = new Set(['notifications', 'geolocation', 'midi', 'midiSysex']);\napp.on('session-created', (s) => {\n  try {\n    s.setPermissionRequestHandler((_wc, perm, cb) => cb(!DENY.has(perm)));\n    s.setPermissionCheckHandler((_wc, perm) => !DENY.has(perm));\n  } catch {}\n});\n\n// Connexion Google (\"ce navigateur ou cette application ne sont peut-être pas sécurisés\") : on retire toute trace d'Electron\n// de l'identité du navigateur, dans les en-têtes réseau (User-Agent + sec-ch-ua) ET dans les fenêtres de connexion (popups).\nconst cleanUA = (ua) => String(ua || '').replace(/\\s?Electron\\/\\S+/, '').replace(/\\s?ai-hub\\/\\S+/, '').replace(/\\s?AI Hub\\/\\S+/i, '');\napp.on('session-created', (s) => {\n  try {\n    s.setUserAgent(cleanUA(s.getUserAgent()));\n    s.webRequest.onBeforeSendHeaders((d, cb) => {\n      const h = d.requestHeaders;\n      for (const k of Object.keys(h)) {\n        if (/^user-agent$/i.test(k)) h[k] = cleanUA(h[k]);\n        else if (/^sec-ch-ua(-full-version-list)?$/i.test(k)) h[k] = String(h[k]).replace(/,?\\s*\"[^\"]*electron[^\"]*\";v=\"[^\"]*\"/ig, '').replace(/^\\s*,\\s*/, '');\n      }\n      cb({ requestHeaders: h });\n    });\n  } catch {}\n});\napp.on('web-contents-created', (_e, wc) => { try { wc.setUserAgent(cleanUA(wc.getUserAgent())); } catch {} });\n\nfunction create() {\n  nativeTheme.themeSource = savedTheme();\n  win = new BrowserWindow({\n    width: 1440, height: 900, backgroundColor: nativeTheme.shouldUseDarkColors ? BG.dark : BG.light, autoHideMenuBar: true,\n    icon: fs.existsSync(path.join(__dirname, 'icon.ico')) ? path.join(__dirname, 'icon.ico') : undefined,\n    webPreferences: { preload: path.join(__dirname, 'preload.js'), webviewTag: true, contextIsolation: true }\n  });\n  win.loadFile(path.join(__dirname, 'index.html'));\n  nativeTheme.on('updated', () => { try { win.setBackgroundColor(nativeTheme.shouldUseDarkColors ? BG.dark : BG.light); } catch {} });\n  win.webContents.on('render-process-gone', (_e, d) => { ctx.fatal('interface plantée : ' + (d && d.reason)); });\n}\n\nipcMain.handle('copy', (_e, t) => clipboard.writeText(t));\nipcMain.handle('clear', (_e, p) => session.fromPartition(p).clearStorageData());\nipcMain.handle('wvpreload', () => pathToFileURL(path.join(__dirname, 'webview-preload.js')).href);\n// Notifications Windows : un clic ramène la fenêtre au premier plan et ouvre le compte concerné\nconst liveNotifs = new Set();\nipcMain.handle('notify', (_e, t, b, accId) => {\n  if (!Notification.isSupported()) return { ok: false, error: 'unsupported' };\n  try {\n    const n = new Notification({ title: String(t || 'AI Hub'), body: String(b || '') });\n    liveNotifs.add(n);                                   // garder une référence (sinon le clic peut être perdu)\n    n.on('close', () => liveNotifs.delete(n));\n    n.on('failed', () => liveNotifs.delete(n));\n    n.on('click', () => {\n      liveNotifs.delete(n);\n      if (!win) return;\n      if (win.isMinimized()) win.restore();\n      win.show(); win.focus();\n      win.webContents.send('notif-click', accId || null);\n    });\n    n.show();\n    return { ok: true };\n  } catch (e) { return { ok: false, error: e.message }; }\n});\nipcMain.handle('theme:set', (_e, t) => { nativeTheme.themeSource = ['light', 'dark'].includes(t) ? t : 'system'; return nativeTheme.shouldUseDarkColors; });\n\n// Export de tous les comptes : liste + cookies de chaque session, chiffré (AES-256-GCM) si mot de passe\nipcMain.handle('export', async (_e, { state, partitions, pass }) => {\n  const cookies = {};\n  for (const p of partitions) cookies[p] = await session.fromPartition(p).cookies.get({});\n  const data = JSON.stringify({ app: 'ai-hub', version: app.getVersion(), v: 1, exportedAt: new Date().toISOString(), state, cookies });\n  let out = data;\n  if (pass) {\n    const salt = crypto.randomBytes(16), iv = crypto.randomBytes(12);\n    const c = crypto.createCipheriv('aes-256-gcm', crypto.scryptSync(pass, salt, 32), iv);\n    const enc = Buffer.concat([c.update(data, 'utf8'), c.final()]);\n    out = JSON.stringify({ app: 'ai-hub', version: app.getVersion(), enc: 1, salt: salt.toString('base64'), iv: iv.toString('base64'), tag: c.getAuthTag().toString('base64'), data: enc.toString('base64') });\n  }\n  const r = await dialog.showSaveDialog(win, { defaultPath: 'ai-hub-comptes-' + new Date().toISOString().slice(0, 10) + '.json' });\n  if (r.canceled) return { ok: false };\n  fs.writeFileSync(r.filePath, out);\n  return { ok: true, path: r.filePath, encrypted: !!pass };\n});\n\nipcMain.handle('import', async (_e, pass) => {\n  const r = await dialog.showOpenDialog(win, { filters: [{ name: 'JSON', extensions: ['json'] }], properties: ['openFile'] });\n  if (r.canceled) return { ok: false };\n  let j = JSON.parse(fs.readFileSync(r.filePaths[0], 'utf8'));\n  const ver = j.version;\n  if (j.app && j.app !== 'ai-hub') return { ok: false, error: 'Ce fichier ne vient pas de AI Hub' };\n  if (j.enc) {\n    try {\n      const d = crypto.createDecipheriv('aes-256-gcm', crypto.scryptSync(pass || '', Buffer.from(j.salt, 'base64'), 32), Buffer.from(j.iv, 'base64'));\n      d.setAuthTag(Buffer.from(j.tag, 'base64'));\n      j = JSON.parse(Buffer.concat([d.update(Buffer.from(j.data, 'base64')), d.final()]).toString('utf8'));\n    } catch { return { ok: false, error: 'Mot de passe incorrect ou fichier corrompu' }; }\n  }\n  let n = 0;\n  for (const [p, list] of Object.entries(j.cookies || {})) for (const c of list) {\n    try {\n      const o = { url: `http${c.secure ? 's' : ''}://${c.domain.replace(/^\\./, '')}${c.path}`, name: c.name, value: c.value, path: c.path, secure: c.secure, httpOnly: c.httpOnly, sameSite: c.sameSite, expirationDate: c.expirationDate };\n      if (!c.hostOnly) o.domain = c.domain;\n      await session.fromPartition(p).cookies.set(o); n++;\n    } catch {}\n  }\n  return { ok: true, state: j.state, cookies: n, version: ver || j.version, current: app.getVersion() };\n});\n\n// Sauvegarde de l'état (comptes, code, détections) dans un fichier avec copies de secours\nconst count = (s) => { try { return (JSON.parse(s).accs || []).length; } catch { return -1; } };\nipcMain.handle('state:load', () => {\n  const files = [STATE()];\n  try { files.push(...fs.readdirSync(BK()).sort().reverse().map((f) => path.join(BK(), f))); } catch {}\n  for (const f of files) { try { return JSON.parse(fs.readFileSync(f, 'utf8')); } catch {} }\n  return null;\n});\nipcMain.handle('state:save', (_e, json) => {\n  fs.mkdirSync(BK(), { recursive: true });\n  try {\n    const old = fs.readFileSync(STATE(), 'utf8');\n    if (old !== json && (count(json) < count(old) || Date.now() - lastBk > 60000)) {\n      fs.writeFileSync(path.join(BK(), 'state-' + new Date().toISOString().replace(/[:.]/g, '-') + '.json'), old); lastBk = Date.now();\n      fs.readdirSync(BK()).sort().reverse().slice(40).forEach((f) => fs.unlinkSync(path.join(BK(), f)));\n    }\n  } catch {}\n  fs.writeFileSync(STATE() + '.tmp', json); fs.renameSync(STATE() + '.tmp', STATE());\n  return true;\n});\n// Sessions qui existent sur le disque mais ne sont plus dans la liste des comptes\nipcMain.handle('orphans', async (_e, known) => {\n  let names = []; try { names = fs.readdirSync(path.join(ud(), 'Partitions')); } catch {}\n  const out = [];\n  for (const n of names) {\n    if (!/^a\\d+$/.test(n) || known.includes(n)) continue;\n    const ck = await session.fromPartition('persist:' + n).cookies.get({});\n    if (ck.length) out.push({ id: n, domains: [...new Set(ck.map((c) => c.domain.replace(/^\\./, '')))] });\n  }\n  return out;\n});\nipcMain.handle('open-data', () => shell.openPath(ud()));\n\n\n// ---------- Résumé par Gemini (appel fait ici, dans le processus principal : pas de souci CORS) ----------\nipcMain.handle('gemini', async (_e, { key, model, system, prompt }) => {\n  if (!key) return { ok: false, error: 'Clé Gemini absente' };\n  const m = String(model || 'gemini-flash-latest').replace(/[^\\w.\\-]/g, '');\n  const ac = new AbortController(), to = setTimeout(() => ac.abort(), 90000);\n  try {\n    const r = await fetch((process.env.AIHUB_GEMINI_URL || 'https://generativelanguage.googleapis.com/v1beta/models/') + m + ':generateContent', {\n      method: 'POST', signal: ac.signal, headers: { 'Content-Type': 'application/json', 'x-goog-api-key': key },\n      body: JSON.stringify({ systemInstruction: system ? { parts: [{ text: system }] } : undefined, contents: [{ role: 'user', parts: [{ text: prompt }] }], generationConfig: { temperature: 0.2, maxOutputTokens: 8192 } })\n    });\n    const j = await r.json().catch(() => null);\n    if (!r.ok) return { ok: false, status: r.status, error: (j && j.error && j.error.message) || 'HTTP ' + r.status };\n    const c = j && j.candidates && j.candidates[0];\n    const text = ((c && c.content && c.content.parts) || []).map((p) => p.text || '').join('').trim();\n    if (!text) return { ok: false, error: 'Réponse vide (' + ((c && c.finishReason) || (j && j.promptFeedback && j.promptFeedback.blockReason) || '?') + ')' };\n    return { ok: true, text };\n  } catch (e) { return { ok: false, error: e.name === 'AbortError' ? 'Délai dépassé (90 s)' : e.message }; }\n  finally { clearTimeout(to); }\n});\n\n// ---------- Mises à jour (la logique est dans updater.js, testée à part) ----------\nconst backupState = (ver) => {                       // copie des données AVANT d'installer : on ne perd rien\n  try { fs.mkdirSync(BK(), { recursive: true }); fs.copyFileSync(STATE(), path.join(BK(), 'state-' + new Date().toISOString().replace(/[:.]/g, '-') + '-avant-maj-' + ver + '.json')); } catch {}\n};\nipcMain.handle('upd:info', () => Object.assign(ctx.updater.info(), { active: ctx.boot.version, rolledBack: ctx.boot.rolledBack, dataDir: ud() }));\nipcMain.handle('upd:apply', async () => {\n  const r = await dialog.showOpenDialog(win, { filters: [{ name: 'Mise à jour AI Hub', extensions: ['aihubupdate', 'json'] }], properties: ['openFile'] });\n  if (r.canceled) return { ok: false, cancelled: true };\n  try { return ctx.updater.install(ctx.updater.readPackage(r.filePaths[0]), { beforeInstall: backupState }); }\n  catch (e) { return { ok: false, error: 'Fichier illisible : ' + e.message }; }\n});\nipcMain.handle('upd:revert', (_e, to) => ctx.updater.revert(to));\nipcMain.handle('upd:healthy', () => ctx.updater.confirm());\nipcMain.handle('upd:fail', (_e, reason) => ctx.fatal('interface : ' + String(reason).slice(0, 200)));\nipcMain.handle('relaunch', () => { ctx.relaunch(); });\n// Garde-fou : une nouvelle version qui ne confirme pas en 15 s est annulée\nif (ctx.updater.info().pending) setTimeout(() => { if (ctx.updater.info().pending) ctx.fatal('aucune confirmation de démarrage en 15 s'); }, 15000);\n\n// Une seule instance à la fois : empêche deux fenêtres d'écraser les mêmes données\nif (!app.requestSingleInstanceLock()) app.quit();\nelse {\n  app.on('second-instance', () => { if (win) { if (win.isMinimized()) win.restore(); win.show(); win.focus(); } });\n  app.whenReady().then(create);\n}\napp.on('window-all-closed', () => app.quit());\n};\n"}}}