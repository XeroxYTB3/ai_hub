{"app": "ai-hub-update", "format": 1, "version": "2.2.6", "notes": "Icônes de fichiers redessinées : couleurs vives par type, animations plus visibles (globe qui tourne, soleil, accolades, couvercle de zip, lignes qui s'écrivent, égaliseur…), reflet au survol, et couleurs personnalisables par type (bouton Couleurs). Inclut projets + bouton Claude. Paquet complet.", "createdAt": "2026-10-07T07:42:10.961284Z", "requiresLauncher": null, "files": {"main-core.js": {"sha256": "7df81781468bf64b5f9f1bd3b35c92a8949c536ad4782b1320804d4da8468df9", "content": "const { app, BrowserWindow, ipcMain, session, clipboard, dialog, Notification, shell, nativeTheme } = require('electron');\nconst path = require('path'), fs = require('fs'), crypto = require('crypto');\nconst { pathToFileURL } = require('url');\n\nmodule.exports = function start(ctx) {\nlet win;\n// (Le dossier de données fixe est défini par le lanceur main.js)\nconst ud = () => app.getPath('userData');\nconst STATE = () => path.join(ud(), 'ai-hub-state.json');\nconst BK = () => path.join(ud(), 'backups');\nlet lastBk = 0;\n\n// Thème enregistré (lu avant d'ouvrir la fenêtre pour éviter un flash blanc/noir au démarrage)\nconst BG = { dark: '#262624', light: '#FAF9F5' };\nfunction savedTheme() { try { const t = JSON.parse(fs.readFileSync(STATE(), 'utf8')).settings.theme; return ['light', 'dark'].includes(t) ? t : 'system'; } catch { return 'system'; } }\nif (process.platform === 'win32') { try { app.setAppUserModelId('com.aihub.app'); } catch {} }   // nécessaire pour les notifications Windows\n\n// Les sites ne peuvent pas envoyer leurs propres notifications ni demander la position : AI Hub centralise les notifications\nconst DENY = new Set(['notifications', 'geolocation', 'midi', 'midiSysex']);\napp.on('session-created', (s) => {\n  try {\n    s.setPermissionRequestHandler((_wc, perm, cb) => cb(!DENY.has(perm)));\n    s.setPermissionCheckHandler((_wc, perm) => !DENY.has(perm));\n  } catch {}\n});\n\n// Connexion Google (\"ce navigateur ou cette application ne sont peut-être pas sécurisés\") : on retire toute trace d'Electron\n// de l'identité du navigateur, dans les en-têtes réseau (User-Agent + sec-ch-ua) ET dans les fenêtres de connexion (popups).\nconst cleanUA = (ua) => String(ua || '').replace(/\\s?Electron\\/\\S+/, '').replace(/\\s?ai-hub\\/\\S+/, '').replace(/\\s?AI Hub\\/\\S+/i, '');\napp.on('session-created', (s) => {\n  try {\n    s.setUserAgent(cleanUA(s.getUserAgent()));\n    s.webRequest.onBeforeSendHeaders((d, cb) => {\n      const h = d.requestHeaders;\n      for (const k of Object.keys(h)) {\n        if (/^user-agent$/i.test(k)) h[k] = cleanUA(h[k]);\n        else if (/^sec-ch-ua(-full-version-list)?$/i.test(k)) h[k] = String(h[k]).replace(/,?\\s*\"[^\"]*electron[^\"]*\";v=\"[^\"]*\"/ig, '').replace(/^\\s*,\\s*/, '');\n      }\n      cb({ requestHeaders: h });\n    });\n  } catch {}\n});\napp.on('web-contents-created', (_e, wc) => { try { wc.setUserAgent(cleanUA(wc.getUserAgent())); } catch {} });\n\nfunction create() {\n  nativeTheme.themeSource = savedTheme();\n  win = new BrowserWindow({\n    width: 1440, height: 900, backgroundColor: nativeTheme.shouldUseDarkColors ? BG.dark : BG.light, autoHideMenuBar: true,\n    icon: fs.existsSync(path.join(__dirname, 'icon.ico')) ? path.join(__dirname, 'icon.ico') : undefined,\n    webPreferences: { preload: path.join(__dirname, 'preload.js'), webviewTag: true, contextIsolation: true }\n  });\n  win.loadFile(path.join(__dirname, 'index.html'));\n  nativeTheme.on('updated', () => { try { win.setBackgroundColor(nativeTheme.shouldUseDarkColors ? BG.dark : BG.light); } catch {} });\n  win.webContents.on('render-process-gone', (_e, d) => { ctx.fatal('interface plantée : ' + (d && d.reason)); });\n}\n\nipcMain.handle('copy', (_e, t) => clipboard.writeText(t));\nipcMain.handle('clear', (_e, p) => session.fromPartition(p).clearStorageData());\nipcMain.handle('wvpreload', () => pathToFileURL(path.join(__dirname, 'webview-preload.js')).href);\n// Notifications Windows : un clic ramène la fenêtre au premier plan et ouvre le compte concerné\nconst liveNotifs = new Set();\nipcMain.handle('notify', (_e, t, b, accId) => {\n  if (!Notification.isSupported()) return { ok: false, error: 'unsupported' };\n  try {\n    const n = new Notification({ title: String(t || 'AI Hub'), body: String(b || '') });\n    liveNotifs.add(n);                                   // garder une référence (sinon le clic peut être perdu)\n    n.on('close', () => liveNotifs.delete(n));\n    n.on('failed', () => liveNotifs.delete(n));\n    n.on('click', () => {\n      liveNotifs.delete(n);\n      if (!win) return;\n      if (win.isMinimized()) win.restore();\n      win.show(); win.focus();\n      win.webContents.send('notif-click', accId || null);\n    });\n    n.show();\n    return { ok: true };\n  } catch (e) { return { ok: false, error: e.message }; }\n});\nipcMain.handle('theme:set', (_e, t) => { nativeTheme.themeSource = ['light', 'dark'].includes(t) ? t : 'system'; return nativeTheme.shouldUseDarkColors; });\n\n// Export de tous les comptes : liste + cookies de chaque session, chiffré (AES-256-GCM) si mot de passe\nipcMain.handle('export', async (_e, { state, partitions, pass }) => {\n  const cookies = {};\n  for (const p of partitions) cookies[p] = await session.fromPartition(p).cookies.get({});\n  const data = JSON.stringify({ app: 'ai-hub', version: app.getVersion(), v: 1, exportedAt: new Date().toISOString(), state, cookies });\n  let out = data;\n  if (pass) {\n    const salt = crypto.randomBytes(16), iv = crypto.randomBytes(12);\n    const c = crypto.createCipheriv('aes-256-gcm', crypto.scryptSync(pass, salt, 32), iv);\n    const enc = Buffer.concat([c.update(data, 'utf8'), c.final()]);\n    out = JSON.stringify({ app: 'ai-hub', version: app.getVersion(), enc: 1, salt: salt.toString('base64'), iv: iv.toString('base64'), tag: c.getAuthTag().toString('base64'), data: enc.toString('base64') });\n  }\n  const r = await dialog.showSaveDialog(win, { defaultPath: 'ai-hub-comptes-' + new Date().toISOString().slice(0, 10) + '.json' });\n  if (r.canceled) return { ok: false };\n  fs.writeFileSync(r.filePath, out);\n  return { ok: true, path: r.filePath, encrypted: !!pass };\n});\n\nipcMain.handle('import', async (_e, pass) => {\n  const r = await dialog.showOpenDialog(win, { filters: [{ name: 'JSON', extensions: ['json'] }], properties: ['openFile'] });\n  if (r.canceled) return { ok: false };\n  let j = JSON.parse(fs.readFileSync(r.filePaths[0], 'utf8'));\n  const ver = j.version;\n  if (j.app && j.app !== 'ai-hub') return { ok: false, error: 'Ce fichier ne vient pas de AI Hub' };\n  if (j.enc) {\n    try {\n      const d = crypto.createDecipheriv('aes-256-gcm', crypto.scryptSync(pass || '', Buffer.from(j.salt, 'base64'), 32), Buffer.from(j.iv, 'base64'));\n      d.setAuthTag(Buffer.from(j.tag, 'base64'));\n      j = JSON.parse(Buffer.concat([d.update(Buffer.from(j.data, 'base64')), d.final()]).toString('utf8'));\n    } catch { return { ok: false, error: 'Mot de passe incorrect ou fichier corrompu' }; }\n  }\n  let n = 0;\n  for (const [p, list] of Object.entries(j.cookies || {})) for (const c of list) {\n    try {\n      const o = { url: `http${c.secure ? 's' : ''}://${c.domain.replace(/^\\./, '')}${c.path}`, name: c.name, value: c.value, path: c.path, secure: c.secure, httpOnly: c.httpOnly, sameSite: c.sameSite, expirationDate: c.expirationDate };\n      if (!c.hostOnly) o.domain = c.domain;\n      await session.fromPartition(p).cookies.set(o); n++;\n    } catch {}\n  }\n  return { ok: true, state: j.state, cookies: n, version: ver || j.version, current: app.getVersion() };\n});\n\n// Sauvegarde de l'état (comptes, code, détections) dans un fichier avec copies de secours\nconst count = (s) => { try { return (JSON.parse(s).accs || []).length; } catch { return -1; } };\nipcMain.handle('state:load', () => {\n  const files = [STATE()];\n  try { files.push(...fs.readdirSync(BK()).sort().reverse().map((f) => path.join(BK(), f))); } catch {}\n  for (const f of files) { try { return JSON.parse(fs.readFileSync(f, 'utf8')); } catch {} }\n  return null;\n});\nipcMain.handle('state:save', (_e, json) => {\n  fs.mkdirSync(BK(), { recursive: true });\n  try {\n    const old = fs.readFileSync(STATE(), 'utf8');\n    if (old !== json && (count(json) < count(old) || Date.now() - lastBk > 60000)) {\n      fs.writeFileSync(path.join(BK(), 'state-' + new Date().toISOString().replace(/[:.]/g, '-') + '.json'), old); lastBk = Date.now();\n      fs.readdirSync(BK()).sort().reverse().slice(40).forEach((f) => fs.unlinkSync(path.join(BK(), f)));\n    }\n  } catch {}\n  fs.writeFileSync(STATE() + '.tmp', json); fs.renameSync(STATE() + '.tmp', STATE());\n  return true;\n});\n// Sessions qui existent sur le disque mais ne sont plus dans la liste des comptes\nipcMain.handle('orphans', async (_e, known) => {\n  let names = []; try { names = fs.readdirSync(path.join(ud(), 'Partitions')); } catch {}\n  const out = [];\n  for (const n of names) {\n    if (!/^a\\d+$/.test(n) || known.includes(n)) continue;\n    const ck = await session.fromPartition('persist:' + n).cookies.get({});\n    if (ck.length) out.push({ id: n, domains: [...new Set(ck.map((c) => c.domain.replace(/^\\./, '')))] });\n  }\n  return out;\n});\nipcMain.handle('open-data', () => shell.openPath(ud()));\n\n\n// ---------- Résumé par Gemini (appel fait ici, dans le processus principal : pas de souci CORS) ----------\nipcMain.handle('gemini', async (_e, { key, model, system, prompt }) => {\n  if (!key) return { ok: false, error: 'Clé Gemini absente' };\n  const m = String(model || 'gemini-flash-latest').replace(/[^\\w.\\-]/g, '');\n  const ac = new AbortController(), to = setTimeout(() => ac.abort(), 90000);\n  try {\n    const r = await fetch((process.env.AIHUB_GEMINI_URL || 'https://generativelanguage.googleapis.com/v1beta/models/') + m + ':generateContent', {\n      method: 'POST', signal: ac.signal, headers: { 'Content-Type': 'application/json', 'x-goog-api-key': key },\n      body: JSON.stringify({ systemInstruction: system ? { parts: [{ text: system }] } : undefined, contents: [{ role: 'user', parts: [{ text: prompt }] }], generationConfig: { temperature: 0.2, maxOutputTokens: 8192 } })\n    });\n    const j = await r.json().catch(() => null);\n    if (!r.ok) return { ok: false, status: r.status, error: (j && j.error && j.error.message) || 'HTTP ' + r.status };\n    const c = j && j.candidates && j.candidates[0];\n    const text = ((c && c.content && c.content.parts) || []).map((p) => p.text || '').join('').trim();\n    if (!text) return { ok: false, error: 'Réponse vide (' + ((c && c.finishReason) || (j && j.promptFeedback && j.promptFeedback.blockReason) || '?') + ')' };\n    return { ok: true, text };\n  } catch (e) { return { ok: false, error: e.name === 'AbortError' ? 'Délai dépassé (90 s)' : e.message }; }\n  finally { clearTimeout(to); }\n});\n\n// ---------- Mises à jour (la logique est dans updater.js, testée à part) ----------\nconst backupState = (ver) => {                       // copie des données AVANT d'installer : on ne perd rien\n  try { fs.mkdirSync(BK(), { recursive: true }); fs.copyFileSync(STATE(), path.join(BK(), 'state-' + new Date().toISOString().replace(/[:.]/g, '-') + '-avant-maj-' + ver + '.json')); } catch {}\n};\nipcMain.handle('upd:info', () => Object.assign(ctx.updater.info(), { active: ctx.boot.version, rolledBack: ctx.boot.rolledBack, dataDir: ud() }));\nipcMain.handle('upd:apply', async () => {\n  const r = await dialog.showOpenDialog(win, { filters: [{ name: 'Mise à jour AI Hub', extensions: ['aihubupdate', 'json'] }], properties: ['openFile'] });\n  if (r.canceled) return { ok: false, cancelled: true };\n  try { return ctx.updater.install(ctx.updater.readPackage(r.filePaths[0]), { beforeInstall: backupState }); }\n  catch (e) { return { ok: false, error: 'Fichier illisible : ' + e.message }; }\n});\nipcMain.handle('upd:revert', (_e, to) => ctx.updater.revert(to));\nipcMain.handle('upd:healthy', () => ctx.updater.confirm());\nipcMain.handle('upd:fail', (_e, reason) => ctx.fatal('interface : ' + String(reason).slice(0, 200)));\nipcMain.handle('relaunch', () => { ctx.relaunch(); });\n// Garde-fou : une nouvelle version qui ne confirme pas en 15 s est annulée\nif (ctx.updater.info().pending) setTimeout(() => { if (ctx.updater.info().pending) ctx.fatal('aucune confirmation de démarrage en 15 s'); }, 15000);\n\n// Une seule instance à la fois : empêche deux fenêtres d'écraser les mêmes données\nif (!app.requestSingleInstanceLock()) app.quit();\nelse {\n  app.on('second-instance', () => { if (win) { if (win.isMinimized()) win.restore(); win.show(); win.focus(); } });\n  app.whenReady().then(create);\n}\napp.on('window-all-closed', () => app.quit());\n};\n"}, "preload.js": {"sha256": "c9cba307cc3b093b88a142efcf2f5d2ef71450d89bc50d248e48d0a5fd63e99f", "content": "const { contextBridge, ipcRenderer } = require('electron');\nconst i = (c) => (...a) => ipcRenderer.invoke(c, ...a);\ncontextBridge.exposeInMainWorld('api', {\n  copy: i('copy'), clear: i('clear'), wvpreload: i('wvpreload'), notify: i('notify'),\n  exportAll: i('export'), importAll: i('import'),\n  stateLoad: i('state:load'), stateSave: i('state:save'), orphans: i('orphans'), openData: i('open-data'),\n  gemini: i('gemini'), updInfo: i('upd:info'), updApply: i('upd:apply'), updRevert: i('upd:revert'),\n  updHealthy: i('upd:healthy'), updFail: i('upd:fail'), relaunch: i('relaunch'),\n  setTheme: i('theme:set'), onNotifClick: (cb) => ipcRenderer.on('notif-click', (_e, id) => cb(id))\n});\n"}, "webview-preload.js": {"sha256": "561d6fa915695637d18854650b9404d1d27793e360f9de3c822e4d118e2beffc", "content": "// Tourne DANS chaque page de chat : détecte les événements et les envoie à l'app\nconst { ipcRenderer, webFrame } = require('electron');\nlet cfg = { detectors: [], idle: 120, sel: {} };\n\n// Sélecteurs par défaut + sélecteurs de secours ajoutés dans Paramètres > Détections (cfg.sel)\nconst BASE = {\n  user: '[data-testid=\"user-message\"],user-query,[data-message-author-role=\"user\"]',\n  ai: '.font-claude-response,model-response,[data-message-author-role]:not([data-message-author-role=\"user\"])',   // aligné sur index.html\n  comp: '[contenteditable=\"true\"],textarea',\n  stop: '[data-testid=\"stop-button\"],button[aria-label*=\"Stop\" i],button[aria-label*=\"Arrêter\" i],button[aria-label*=\"Interrompre\" i]',\n  send: '[data-testid=\"send-button\"],button[aria-label*=\"Send\" i],button[aria-label*=\"Envoyer\" i]'\n};\nconst S = Object.assign({}, BASE);\nlet SKIP = '';\nfunction applySel() {\n  const sel = cfg.sel || {};\n  for (const k of Object.keys(BASE)) {\n    let extra = (sel[k] || '').trim();\n    if (extra) { try { document.querySelector(extra); } catch { ipcRenderer.sendToHost('hub-event', { type: 'selector-invalid', detail: { key: k, value: extra }, url: location.href, ts: Date.now() }); extra = ''; } }\n    S[k] = extra ? BASE[k] + ',' + extra : BASE[k];\n  }\n  SKIP = S.user + ',' + S.ai + ',' + S.comp + ',nav,aside,script,style,noscript';\n}\napplySel();\nipcRenderer.on('hub:config', (_e, c) => { cfg = c; applySel(); });\n\n// Limite atteinte : gérée à part (machine à états persistante, voir poll). Textes FR + EN de Claude, ChatGPT, Gemini...\nconst LIMIT_RE = /(you('|’)?ve (hit|reached|exceeded) (your|the|our|this) [\\w\\s-]{0,25}(limit|cap)|you (have|had) (hit|reached|exceeded) (your|the|our) [\\w\\s-]{0,25}(limit|cap)|you('|’)?re out of [\\w\\s-]{0,15}messages|usage (limit|cap)|message (limit|cap)|limit reached|out of (free )?messages|limite (d['’]utilisation|de messages|quotidienne|horaire|atteinte|dépassée)|vous avez (atteint|dépassé) (votre|la) limite|vous avez (épuisé|atteint) (vos|votre) [\\w\\s'’-]{0,25}(messages|quota|limite)|quota (épuisé|dépassé|exceeded)|(n['’]avez|il n['’]y a) plus de messages|plus de messages (gratuits|disponibles)|plus aucun message|come back (later|tomorrow)|reviens? plus tard)/i;\n// [événement, regex, événement de fin]\nconst PAT = [\n  ['limit-soon', /(\\d+|few) messages? (remaining|left)|il vous reste \\d+ message|\\d+ messages? restants?/i],\n  ['rate-limit', /(too many (requests|messages)|rate limit|trop de (requêtes|messages)|slow down|ralentissez)/i],\n  ['overloaded', /(overloaded|at capacity|high demand|forte demande|surcharg|temporarily unavailable|service unavailable|temporairement indisponible)/i],\n  ['error', /(something went wrong|an error occurred|une erreur (est survenue|s['’]est produite)|network error|erreur réseau|failed to (load|send|generate)|impossible de (générer|envoyer)|unable to (send|generate))/i],\n  ['chat-too-long', /(conversation (is )?too long|conversation trop longue|context (window|limit)|maximum (conversation )?length|longueur maximale|start a new (chat|conversation)|commencez une nouvelle conversation)/i],\n  ['captcha', /(verify (that )?you are human|verifying you are human|vérifiez que vous êtes (un )?humain|checking your browser|just a moment|vérification de sécurité)/i, 'captcha-cleared']\n];\nconst LOGIN_BTN = /^(log ?in|sign ?in|se connecter|connexion|continue with (google|email)|continuer avec (google|e-?mail))$/im;\n\nconst emit = (type, detail) => ipcRenderer.sendToHost('hub-event', { type, detail, url: location.href, ts: Date.now() });\nconst q = (s) => { try { return [...document.querySelectorAll(s)]; } catch { return []; } };\nconst vis = (e) => e && e.offsetParent !== null;\nemit('page-start');\nconst flags = {};\nconst edge = (k, on, onT, offT, d) => {\n  if (on && !flags[k]) { flags[k] = 1; emit(onT, d); }\n  else if (!on && flags[k]) { flags[k] = 0; if (offT) emit(offT); }\n};\n// Texte court de TOUTE la page : uniquement pour la détection de connexion et les pages sans conversation (captcha, erreur plein écran)\nfunction pageTexts() {\n  const out = [], w = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT); let n;\n  while ((n = w.nextNode())) {\n    const t = n.nodeValue.trim();\n    if (t.length > 2 && t.length < 300) { const p = n.parentElement; if (p && !p.closest(SKIP)) out.push(t); }\n  }\n  return out.join('\\n');\n}\n\n// Texte court des ZONES D'INTERFACE seulement (alertes, fenêtres, bandeau autour de la zone de saisie).\n// La conversation n'est JAMAIS lue : même si les sélecteurs de messages changent, un échange qui parle de\n// \"limite atteinte\" ne peut plus déclencher de fausse alerte. On exclut aussi toute zone qui défile (= la conversation).\nconst ZONE_ALERT = '[role=\"alert\"],[role=\"status\"],[role=\"alertdialog\"],[role=\"dialog\"],[aria-modal=\"true\"],[aria-live=\"assertive\"],[data-testid*=\"limit\" i],[data-testid*=\"banner\" i],[data-testid*=\"toast\" i],[data-testid*=\"error\" i],[class*=\"toast\" i],[class*=\"banner\" i],[class*=\"snackbar\" i]';\nlet scrollMemo = new WeakMap();\nconst isScroller = (el) => {\n  let r = scrollMemo.get(el);\n  if (r === undefined) {\n    try { const cs = getComputedStyle(el); r = /(auto|scroll)/.test(cs.overflowY) && el.clientHeight > 120 && el.scrollHeight > el.clientHeight + 40; } catch { r = false; }\n    scrollMemo.set(el, r);\n  }\n  return r;\n};\nconst inTranscript = (el, root) => { for (let e = el; e; e = e.parentElement) { if (isScroller(e)) return true; if (e === root) break; } return false; };\nconst hasMsg = (el) => { try { return !!el.querySelector(S.user + ',' + S.ai) || !!el.closest(S.user + ',' + S.ai); } catch { return false; } };\nfunction zoneTexts() {\n  scrollMemo = new WeakMap();\n  const roots = new Set(q(ZONE_ALERT));\n  const c = q(S.comp).find(vis);\n  if (c) {                                    // bandeau juste au-dessus / autour de la zone de saisie\n    let p = c;\n    for (let i = 0; i < 5 && p.parentElement && p.parentElement !== document.body; i++) {\n      const n = p.parentElement;\n      if (isScroller(n) || hasMsg(n)) break;\n      p = n;\n    }\n    roots.add(p);\n  }\n  const out = new Set();\n  for (const root of roots) {\n    if (!root.isConnected || hasMsg(root)) continue;\n    const w = document.createTreeWalker(root, NodeFilter.SHOW_TEXT); let n;\n    while ((n = w.nextNode())) {\n      const t = n.nodeValue.trim();\n      if (t.length < 3 || t.length >= 300) continue;\n      const el = n.parentElement;\n      if (!el || !el.getClientRects().length || el.closest(SKIP) || inTranscript(el, root)) continue;\n      out.add(t);\n    }\n  }\n  return [...out].join('\\n');\n}\n\n// État stable : il faut N relevés consécutifs pour passer à \"actif\" (évite les clignotements)\nconst cnt = {};\nfunction stable(k, raw, nOn, nOff) {\n  const c = cnt[k] || (cnt[k] = { on: false, a: 0, b: 0 });\n  if (raw) { c.b = 0; if (!c.on && ++c.a >= nOn) c.on = true; }\n  else { c.a = 0; if (c.on && ++c.b >= nOff) c.on = false; }\n  return c.on;\n}\n\n// ---------- Limite : mémoire persistante (la limite reste marquée tant qu'elle n'est pas vraiment levée) ----------\n// Sources : (1) texte du bandeau, (2) réponse réseau 429 / \"exceeded_limit\" du site (fiable, indépendante de l'affichage).\n// Elle n'est levée que si : un message est ensuite envoyé avec succès, l'IA a répondu, le bandeau disparaît sur la même\n// page sans changement de conversation (limite réinitialisée), ou après 6 h. Changer de conversation ne la lève plus.\nconst lim = { on: false, ts: 0, src: '' };\nlet lastNav = Date.now(), missSince = 0;      // dernière navigation ; début de l'absence du bandeau\nconst LIM_TTL = 6 * 3600 * 1000;\nfunction setLim(on, src, match) {\n  if (on === lim.on) return;\n  lim.on = on; lim.src = on ? src : ''; lim.ts = Date.now(); missSince = 0;\n  if (on) emit('limit-hit', { match: String(match || '').slice(0, 120), source: src });\n  else emit('limit-cleared');\n}\n\n// Crochet réseau injecté dans la page (monde principal) : voit les réponses du site aux envois de messages\nconst NONCE = Math.random().toString(36).slice(2) + Date.now().toString(36);\nfunction netHook(N) {\n  const WATCH = /(completion|\\/conversation(\\?|$)|\\/f\\/conversation|StreamGenerate|generateContent|\\/responses(\\?|$))/i;\n  const STRONG = /exceeded_limit|message_limit|usage[ _]limit|(reached|hit|exceeded)[^\"]{0,40}limit|limit[^\"]{0,30}(reached|exceeded)|clear_in|resets?_?at|quota|daily limit|hourly limit/i;\n  const post = (o) => { try { o.__aihub = N; window.postMessage(o, '*'); } catch (e) {} };\n  const of = window.fetch;\n  if (typeof of !== 'function' || of.__aihub) return;\n  window.fetch = function () {\n    const a = arguments, p = of.apply(this, a);\n    try {\n      const url = String((a[0] && a[0].url) || a[0] || ''), m = String((a[1] && a[1].method) || (a[0] && a[0].method) || 'GET').toUpperCase();\n      if (m === 'POST' && WATCH.test(url)) p.then((r) => {\n        if (r.ok) return post({ kind: 'ok' });\n        if (r.status === 429 || r.status >= 400) r.clone().text().then((t) => {\n          const strong = STRONG.test(t || '');\n          if (r.status === 429 || strong) post({ kind: strong ? 'limit' : 'rate', status: r.status, body: String(t || '').slice(0, 160) });\n        }).catch(() => { if (r.status === 429) post({ kind: 'rate', status: 429, body: '' }); });\n      }).catch(() => {});\n    } catch (e) {}\n    return p;\n  };\n  window.fetch.__aihub = true;\n}\n// Pour les sites qui détectent Electron / un navigateur intégré (connexion Google) : on enlève les marques\nfunction cleanIdentity() {\n  try {\n    const u = navigator.userAgentData;\n    if (u && u.brands && u.brands.some((b) => /electron/i.test(b.brand))) {\n      const brands = u.brands.filter((b) => !/electron/i.test(b.brand));\n      Object.defineProperty(Navigator.prototype, 'userAgentData', { configurable: true, get() {\n        return new Proxy(u, { get(t, k) {\n          if (k === 'brands') return brands;\n          if (k === 'toJSON') return () => ({ brands, mobile: t.mobile, platform: t.platform });\n          const v = t[k]; return typeof v === 'function' ? v.bind(t) : v;\n        } });\n      } });\n    }\n    if (!window.chrome) window.chrome = { runtime: {} };\n  } catch (e) {}\n}\ntry { webFrame.executeJavaScript('(' + cleanIdentity.toString() + ')();(' + netHook.toString() + ')(' + JSON.stringify(NONCE) + ');').catch(() => {}); } catch {}\nlet lastRate = 0;\nwindow.addEventListener('message', (e) => {\n  const d = e.data;\n  if (!d || d.__aihub !== NONCE) return;\n  if (d.kind === 'limit') setLim(true, 'network', d.status + ' ' + d.body);\n  else if (d.kind === 'rate') { if (Date.now() - lastRate > 15000) { lastRate = Date.now(); emit('rate-limit', { match: d.status + ' ' + d.body, source: 'network' }); } }\n  else if (d.kind === 'ok') { if (lim.on) setLim(false); }\n});\n\nlet lastUrl = location.href, pu = null, lastLen = 0, lastGrow = 0, recentSend = 0, lastTyping = 0, lastAct = Date.now();\nlet gen = false, genStart = 0, genSeen = 0, lg = null, lgCount = 0, t0 = Date.now();\n\ndocument.addEventListener('keydown', (e) => {\n  lastAct = Date.now();\n  if (e.key === 'Enter' && !e.shiftKey && e.target.closest && e.target.closest(S.comp)) {\n    const t = (e.target.value || e.target.innerText || '').trim();\n    if (t) { recentSend = Date.now(); emit('send-attempt', { via: 'enter', preview: t.slice(0, 200) }); }\n  }\n}, true);\ndocument.addEventListener('click', (e) => {\n  lastAct = Date.now();\n  if (e.target.closest && e.target.closest(S.send)) {\n    const c = q(S.comp)[0]; const t = c ? (c.value || c.innerText || '').trim() : '';\n    recentSend = Date.now(); emit('send-attempt', { via: 'click', preview: t.slice(0, 200) });\n  }\n}, true);\ndocument.addEventListener('input', (e) => {\n  lastAct = Date.now();\n  if (e.target.closest && e.target.closest(S.comp) && Date.now() - lastTyping > 3000) emit('typing');\n  lastTyping = Date.now();\n}, true);\ndocument.addEventListener('visibilitychange', () => emit(document.hidden ? 'tab-hidden' : 'tab-visible'));\nwindow.addEventListener('offline', () => emit('offline'));\nwindow.addEventListener('online', () => emit('online'));\nwindow.addEventListener('load', () => emit('page-loaded', { title: document.title }));\n\nfunction poll() {\n  if (!document.body) return;\n  const now = Date.now();\n  // URL / navigation\n  if (location.href !== lastUrl) {\n    emit('url-changed', { from: lastUrl, to: location.href }); lastUrl = location.href; lastNav = now;\n    if (/^\\/(new|app|chat)?\\/?$/.test(location.pathname)) emit('new-chat');\n    else if (/\\/(chat|c|chats|app|thread|search)\\/[\\w-]{8,}/.test(location.pathname)) emit('chat-opened');\n  }\n  // connexion\n  const comp = q(S.comp).some(vis), pw = q('input[type=password]').some(vis);\n  const cur = comp && !pw ? true : (!comp && (pw || LOGIN_BTN.test(pageTexts())) && now - t0 > 2500 ? false : null);\n  if (cur !== null) {\n    if (cur === lg) lgCount = 0; else if (++lgCount >= 2) {\n      if (cur) emit('logged-in'); else { emit('login-required'); if (lg === true) emit('session-expired'); }\n      lg = cur; lgCount = 0;\n    }\n  }\n  // messages + génération\n  const users = q(S.user), ais = q(S.ai), u = users.length;\n  if (pu === null || u < pu) pu = u;\n  else if (u === pu + 1) {\n    pu = u; recentSend = now;\n    emit('message-sent', { count: u, preview: (users[u - 1].innerText || '').trim().slice(0, 200) });\n  } else pu = u;\n  const last = ais[ais.length - 1], len = last ? last.textContent.length : 0;\n  if (len > lastLen && now - recentSend < 90000) lastGrow = now;\n  lastLen = len;\n  const stopOn = q(S.stop).some(vis);\n  const g = stopOn || now - lastGrow < 1500;\n  if (g) genSeen = now;\n  if (g && !gen) { gen = true; genStart = now; emit('response-started', { via: stopOn ? 'stop-button' : 'text-growth' }); }\n  else if (!g && gen && now - genSeen > 1200) {\n    gen = false;\n    if (lim.on && genStart > lim.ts && len >= 20) setLim(false);\n    emit('response-complete', { chars: len, seconds: Math.round((now - genStart) / 100) / 10, userMessages: u, aiMessages: ais.length, preview: last ? last.textContent.trim().slice(0, 300) : '' });\n  }\n  // bannières / erreurs\n  // Pages sans conversation ni zone de saisie (captcha, erreur plein écran) : toute la page ; sinon seulement les zones d'interface\n  const bare = !comp && users.length === 0 && ais.length === 0;\n  const txt = bare ? pageTexts() : zoneTexts();\n  const lm = txt.match(LIMIT_RE);\n  const domOn = stable('dom', !!lm, 3, 5);          // 3 relevés consécutifs pour s'activer\n  if (lm) missSince = 0; else if (!missSince) missSince = now;\n  if (domOn && !lim.on && now - lim.ts > 10000) setLim(true, 'page', lm && lm[0]);\n  // bandeau disparu SANS changement de conversation autour de ce moment = limite réinitialisée ; sinon on garde la limite\n  else if (lim.on && lim.src === 'page' && !lm && missSince && now - missSince > 4000 && lastNav < missSince - 3000) setLim(false);\n  if (lim.on && now - lim.ts > LIM_TTL) setLim(false);\n  for (const [type, re, off] of PAT) { const m = txt.match(re); const on = stable(type, !!m, 2, 3); edge('p' + type, on, type, off, m && { match: m[0].slice(0, 120) }); }\n  // détecteurs personnalisés\n  for (const d of cfg.detectors || []) {\n    if (!d.name || !d.value || (d.host !== '*' && !location.hostname.endsWith(d.host))) continue;\n    let on = false;\n    try { on = d.kind === 'selector' ? q(d.value).length > 0 : new RegExp(d.value, 'i').test(txt); } catch {}\n    edge('c' + d.name, on, d.name, d.name + '-gone', {});\n  }\n  // inactivité\n  edge('idle', !gen && now - lastAct > (cfg.idle || 120) * 1000, 'idle', 'active', {});\n}\nsetInterval(poll, 800);\n\n// ---------- 2.2.4 : bouton « Fichiers AI Hub » dans la barre de saisie de Claude ----------\n// Affiche la bibliothèque de fichiers d'AI Hub (triée par projets) directement dans Claude.\n// L'app envoie la liste (noms seulement) ; un clic renvoie le choix à l'app, qui joint le fichier.\nlet MENU = { projects: [], files: [] };\nlet hbtn = null, hmenu = null, hlist = null, hq = '';\nipcRenderer.on('hub:menu', (_e, d) => { if (d) MENU = d; if (hmenu) drawHubMenu(); });\nconst ATT = 'button[aria-label*=\"Add files\" i],button[aria-label*=\"Ajouter des fichiers\" i],button[aria-label*=\"Attach\" i],button[aria-label*=\"Joindre\" i],button[aria-label*=\"Upload\" i],[data-testid=\"input-menu-trigger\"],[data-testid=\"file-upload\"]';\nconst hsvg = () => {\n  const ns = 'http://www.w3.org/2000/svg', s = document.createElementNS(ns, 'svg'), p = document.createElementNS(ns, 'path');\n  for (const [k, v] of [['viewBox', '0 0 24 24'], ['width', '18'], ['height', '18'], ['fill', 'none'], ['stroke', 'currentColor'], ['stroke-width', '1.8'], ['stroke-linecap', 'round'], ['stroke-linejoin', 'round']]) s.setAttribute(k, v);\n  p.setAttribute('d', 'M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z'); s.appendChild(p); return s;\n};\nfunction ensureHubBtn() {\n  try {\n    if (!document.body || !/(^|\\.)claude\\.ai$/.test(location.hostname)) return;\n    const comp = q(S.comp).find(vis);\n    if (!comp) { if (hbtn) hbtn.style.display = 'none'; closeHubMenu(); return; }\n    if (!hbtn) {\n      hbtn = document.createElement('button'); hbtn.type = 'button'; hbtn.setAttribute('data-aihub', '1');\n      hbtn.setAttribute('aria-label', 'Joindre un fichier AI Hub'); hbtn.title = 'Joindre un fichier de tes projets AI Hub';\n      hbtn.appendChild(hsvg());\n      hbtn.addEventListener('mousedown', (e) => e.preventDefault());\n      hbtn.addEventListener('click', (e) => { e.preventDefault(); e.stopPropagation(); toggleHubMenu(); });\n    }\n    let att = null, el = comp;\n    for (let i = 0; i < 10 && el && !att; i++, el = el.parentElement) att = [...el.querySelectorAll(ATT)].find((b) => b !== hbtn && vis(b));\n    if (att) {\n      if (hbtn.dataset.mode !== 'inline' || hbtn.previousElementSibling !== att) {\n        hbtn.style.cssText = ''; hbtn.className = att.className; att.insertAdjacentElement('afterend', hbtn); hbtn.dataset.mode = 'inline';\n      }\n      hbtn.style.display = '';\n    } else {\n      if (hbtn.dataset.mode !== 'float' || hbtn.parentElement !== document.body) {\n        hbtn.className = ''; document.body.appendChild(hbtn); hbtn.dataset.mode = 'float';\n        hbtn.style.cssText = 'position:fixed;z-index:2147483000;width:34px;height:34px;border-radius:10px;border:1px solid rgba(128,128,128,.35);background:rgba(128,128,128,.12);color:inherit;cursor:pointer;display:flex;align-items:center;justify-content:center;padding:0';\n      }\n      const r = comp.getBoundingClientRect();\n      hbtn.style.left = Math.max(6, r.left) + 'px'; hbtn.style.top = Math.max(6, r.top - 40) + 'px'; hbtn.style.display = 'flex';\n    }\n  } catch {}\n}\nsetInterval(ensureHubBtn, 700);\n\nconst hDark = () => {\n  for (const e of [document.body, document.documentElement]) {\n    const m = (getComputedStyle(e).backgroundColor || '').match(/[\\d.]+/g);\n    if (m && m.length >= 3 && !(m.length > 3 && +m[3] === 0)) return (+m[0] * 299 + +m[1] * 587 + +m[2] * 114) / 1000 < 128;\n  }\n  return matchMedia('(prefers-color-scheme: dark)').matches;\n};\nconst hSize = (n) => n < 1024 ? n + ' o' : n < 1048576 ? Math.round(n / 1024) + ' Ko' : (n / 1048576).toFixed(1).replace('.', ',') + ' Mo';\nfunction hel(tag, css, text) { const e = document.createElement(tag); if (css) e.style.cssText = css; if (text != null) e.textContent = text; return e; }\nconst onHubDown = (e) => { if (hmenu && !hmenu.contains(e.target) && !(hbtn && hbtn.contains(e.target))) closeHubMenu(); };\nconst onHubKey = (e) => { if (e.key === 'Escape') closeHubMenu(); };\nfunction closeHubMenu() {\n  if (hmenu) { hmenu.remove(); hmenu = null; hlist = null; }\n  document.removeEventListener('mousedown', onHubDown, true); document.removeEventListener('keydown', onHubKey, true);\n}\nfunction toggleHubMenu() {\n  if (hmenu) return closeHubMenu();\n  ipcRenderer.sendToHost('hub-attach-open');      // l'app renvoie la liste à jour (hub:menu)\n  const dark = hDark();\n  hmenu = hel('div', 'position:fixed;z-index:2147483647;width:330px;max-height:62vh;overflow:auto;box-sizing:border-box;padding:6px;border-radius:12px;font:13px/1.35 system-ui,-apple-system,Segoe UI,sans-serif;box-shadow:0 8px 30px rgba(0,0,0,.28);border:1px solid ' + (dark ? '#4a4843' : '#e4e1d6') + ';background:' + (dark ? '#2b2a27' : '#fff') + ';color:' + (dark ? '#ece9e0' : '#1f1e1d'));\n  hmenu.dataset.dark = dark ? '1' : '';\n  hmenu.appendChild(hel('div', 'font-size:11px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;opacity:.6;padding:6px 10px 4px', 'Joindre depuis AI Hub'));\n  if ((MENU.files || []).length > 8) {\n    const inp = hel('input', 'width:calc(100% - 12px);margin:2px 6px 6px;padding:6px 9px;border-radius:8px;border:1px solid ' + (dark ? '#4a4843' : '#d8d4c8') + ';background:transparent;color:inherit;font:inherit;box-sizing:border-box;outline:none');\n    inp.placeholder = 'Rechercher…'; inp.value = hq; inp.addEventListener('input', () => { hq = inp.value; drawHubMenu(); });\n    hmenu.appendChild(inp);\n  }\n  hlist = hel('div', ''); hmenu.appendChild(hlist);\n  document.body.appendChild(hmenu); drawHubMenu();\n  const r = hbtn.getBoundingClientRect();\n  hmenu.style.left = Math.max(8, Math.min(r.left, innerWidth - 338)) + 'px';\n  if (r.top > innerHeight / 2) hmenu.style.bottom = Math.max(8, innerHeight - r.top + 8) + 'px'; else hmenu.style.top = (r.bottom + 8) + 'px';\n  document.addEventListener('mousedown', onHubDown, true); document.addEventListener('keydown', onHubKey, true);\n}\nfunction drawHubMenu() {\n  if (!hlist) return;\n  const dark = !!hmenu.dataset.dark, hov = dark ? 'rgba(255,255,255,.08)' : 'rgba(31,30,29,.06)', pick = (o) => { ipcRenderer.sendToHost('hub-attach-pick', o); closeHubMenu(); };\n  const files = (MENU.files || []).filter((f) => !hq || f.name.toLowerCase().includes(hq.toLowerCase()));\n  hlist.textContent = '';\n  if (!(MENU.files || []).length) { hlist.appendChild(hel('div', 'padding:10px;opacity:.7', 'Aucun fichier. Ajoute-en dans AI Hub > Fichiers (tu peux les classer par projet).')); return; }\n  if (!files.length) { hlist.appendChild(hel('div', 'padding:10px;opacity:.7', 'Aucun fichier ne correspond.')); return; }\n  const groups = (MENU.projects || []).map((p) => ({ p, f: files.filter((x) => x.proj === p.id) })).concat([{ p: null, f: files.filter((x) => !x.proj) }]).filter((g) => g.f.length);\n  for (const g of groups) {\n    const head = hel('div', 'display:flex;align-items:center;gap:8px;padding:8px 10px 3px');\n    head.appendChild(hel('span', 'flex:1;font-weight:600;font-size:12.5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap', g.p ? g.p.name : 'Sans projet'));\n    if (g.p) {\n      const b = hel('button', 'border:0;background:none;color:#c6613f;font:inherit;font-size:11.5px;cursor:pointer;padding:2px 4px;border-radius:6px', 'contexte seul');\n      b.title = 'Ajoute seulement le résumé du projet dans la zone de message'; b.addEventListener('click', () => pick({ pid: g.p.id })); head.appendChild(b);\n    }\n    hlist.appendChild(head);\n    for (const f of g.f) {\n      const row = hel('button', 'display:flex;align-items:center;gap:9px;width:100%;padding:7px 10px;border:0;background:none;color:inherit;font:inherit;text-align:left;cursor:pointer;border-radius:8px');\n      const ext = ((f.name.includes('.') ? f.name.split('.').pop() : 'file') || 'file').slice(0, 4).toUpperCase();\n      row.appendChild(hel('span', 'flex:none;min-width:34px;text-align:center;font-size:10px;font-weight:700;padding:3px 4px;border-radius:6px;background:' + (dark ? 'rgba(198,97,63,.22)' : 'rgba(198,97,63,.12)') + ';color:#c6613f', ext));\n      row.appendChild(hel('span', 'flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap', f.name));\n      row.appendChild(hel('span', 'flex:none;font-size:11.5px;opacity:.55', hSize(f.size)));\n      row.addEventListener('mouseenter', () => { row.style.background = hov; }); row.addEventListener('mouseleave', () => { row.style.background = 'none'; });\n      row.addEventListener('click', () => pick({ fid: f.id })); hlist.appendChild(row);\n    }\n  }\n}\n"}, "index.html": {"sha256": "d9c56a479665e27e7a4fcf5e68afbe36c9a39fecb108fb36b7c53101733eef16", "content": "<!DOCTYPE html>\n<html lang=\"fr\" data-theme=\"system\"><head><meta charset=\"UTF-8\"><title>AI Hub</title>\n<script>/* garde-fou : une erreur au démarrage d'une version en essai la fait annuler tout de suite */\nwindow.__healthy=false;(()=>{const f=m=>{if(!window.__healthy&&window.api)window.api.updFail(String(m))};addEventListener('error',e=>f(e.message));addEventListener('unhandledrejection',e=>f(e.reason&&e.reason.message||e.reason))})();</script>\n<style>\n/* ===== Thème : palette inspirée de claude.ai (fond crème, accent terracotta ; sombre = gris chaud) ===== */\n:root{color-scheme:light;\n--bg:#FAF9F5;--side:#F3F1EA;--panel:#FFFFFF;--hover:rgba(31,30,29,.06);--sel:rgba(31,30,29,.09);\n--line:#E4E1D6;--line2:#CFCBBE;--txt:#1F1E1D;--dim:#6F6D66;--acc:#C6613F;--btn:#B5532F;--btnh:#9E4527;\n--soft:rgba(198,97,63,.10);--ok:#2F7D5B;--warn:#A9691A;--err:#B3412F;--tbg:#1F1E1D;--ttx:#FAF9F5;\n--shadow:0 1px 2px rgba(31,30,29,.06),0 8px 28px rgba(31,30,29,.12);\n--serif:\"Iowan Old Style\",\"Palatino Linotype\",Palatino,\"Book Antiqua\",Georgia,serif;\n--sans:system-ui,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif}\n:root[data-theme=dark]{color-scheme:dark;\n--bg:#262624;--side:#1F1E1D;--panel:#30302E;--hover:rgba(250,249,245,.06);--sel:rgba(250,249,245,.10);\n--line:#3D3C38;--line2:#57554E;--txt:#F2F0E8;--dim:#A3A198;--acc:#E08A6B;--btn:#B5532F;--btnh:#C65F39;\n--soft:rgba(224,138,107,.14);--ok:#6CC59A;--warn:#E0B060;--err:#EE8A78;--tbg:#F2F0E8;--ttx:#1F1E1D;\n--shadow:0 1px 2px rgba(0,0,0,.3),0 8px 28px rgba(0,0,0,.45)}\n@media (prefers-color-scheme:dark){:root[data-theme=system]{color-scheme:dark;\n--bg:#262624;--side:#1F1E1D;--panel:#30302E;--hover:rgba(250,249,245,.06);--sel:rgba(250,249,245,.10);\n--line:#3D3C38;--line2:#57554E;--txt:#F2F0E8;--dim:#A3A198;--acc:#E08A6B;--btn:#B5532F;--btnh:#C65F39;\n--soft:rgba(224,138,107,.14);--ok:#6CC59A;--warn:#E0B060;--err:#EE8A78;--tbg:#F2F0E8;--ttx:#1F1E1D;\n--shadow:0 1px 2px rgba(0,0,0,.3),0 8px 28px rgba(0,0,0,.45)}}\n\n*{box-sizing:border-box;margin:0}\nhtml,body{height:100%}\nbody{display:flex;background:var(--bg);color:var(--txt);font:14px/1.5 var(--sans);-webkit-font-smoothing:antialiased}\n::-webkit-scrollbar{width:10px;height:10px}::-webkit-scrollbar-thumb{background:var(--line);border-radius:10px;border:2px solid transparent;background-clip:content-box}::-webkit-scrollbar-thumb:hover{background:var(--line2);background-clip:content-box}\n:focus-visible{outline:2px solid var(--acc);outline-offset:2px}\n.ic{width:16px;height:16px;flex:none}\ncode{font:12.5px Consolas,monospace;background:var(--hover);padding:1px 5px;border-radius:5px}\n\n/* barre latérale */\naside{width:264px;background:var(--side);border-right:1px solid var(--line);display:flex;flex-direction:column;padding:14px 12px;gap:10px;flex:none}\n.brand{display:flex;align-items:center;gap:10px;padding:4px 8px 6px}\n.brand svg{width:26px;height:26px;color:var(--acc)}\nh1{font:500 22px var(--serif);letter-spacing:-.01em}\n#list{flex:1;overflow:auto;margin:0 -4px;padding:0 4px}\n.grp{color:var(--dim);font-size:11.5px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;padding:14px 10px 4px}\n.acc{display:flex;align-items:center;gap:9px;padding:7px 10px;border-radius:8px;cursor:pointer;min-height:34px}\n.acc:hover{background:var(--hover)}.acc.on{background:var(--sel);font-weight:500}\n.dot{width:8px;height:8px;border-radius:50%;flex:none}\n.acc span{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.acc b{display:none;font-weight:400;color:var(--dim);padding:3px;border-radius:6px;line-height:0}\n.acc:hover b{display:block}.acc b:hover{color:var(--txt);background:var(--hover)}.acc b[data-del]:hover{color:var(--err)}\n.bd{display:inline-flex;font-style:normal;color:var(--dim)}.bd.err{color:var(--err)}.bd.warn{color:var(--warn)}\n.spin{width:12px;height:12px;border:2px solid var(--line2);border-top-color:var(--acc);border-radius:50%;animation:rot .8s linear infinite;flex:none}\n@keyframes rot{to{transform:rotate(360deg)}}\n\n/* boutons et champs */\n.btn{font:inherit;font-weight:500;color:var(--txt);background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:7px 12px;cursor:pointer;display:inline-flex;align-items:center;gap:7px;transition:background .12s,border-color .12s}\n.btn:hover{background:var(--hover);border-color:var(--line2)}\n.btn.pri{background:var(--btn);border-color:var(--btn);color:#fff}.btn.pri:hover{background:var(--btnh);border-color:var(--btnh)}\n.btn.ghost{background:transparent;border-color:transparent}.btn.ghost:hover{background:var(--hover)}\n.btn.wide{width:100%;justify-content:center}.btn.wide.left{justify-content:flex-start}\n.btn:disabled{opacity:.5;cursor:default}\nselect,input:not([type=checkbox]),textarea{padding:8px 10px;background:var(--panel);color:var(--txt);border:1px solid var(--line);border-radius:8px;font:inherit}\nselect{padding-right:6px}\ntextarea,pre{font:13px Consolas,monospace}\ninput::placeholder,textarea::placeholder{color:var(--dim)}\npre{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:12px;overflow:auto;white-space:pre-wrap;line-height:1.5}\ndetails{margin:12px 0}summary{cursor:pointer;color:var(--acc);font-weight:500}\n\n/* zone principale */\nmain{flex:1;display:flex;flex-direction:column;min-width:0}\nheader{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 16px;border-bottom:1px solid var(--line);min-height:56px}\nheader strong{font-weight:500;font-size:15px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.hbtns{display:flex;gap:6px;flex:none}\n#ask{display:flex;align-items:center;gap:12px;flex-wrap:wrap;padding:10px 16px;background:var(--soft);border-bottom:1px solid var(--line)}\n#ask[hidden]{display:none}#ask span{flex:1;min-width:200px}\n#views{flex:1;position:relative;background:var(--bg)}\nwebview{position:absolute;inset:0;width:100%;height:100%;display:none;background:var(--bg)}\nwebview.on{display:flex}\n#empty{position:absolute;inset:0;display:grid;place-items:center;text-align:center;padding:40px}\n#empty div{max-width:420px}\n#empty h2{font:500 28px var(--serif);letter-spacing:-.01em;margin-bottom:8px}\n#empty p{color:var(--dim);margin-bottom:18px}\n#bar{position:absolute;top:0;left:0;right:0;height:2px;z-index:6;overflow:hidden;display:none}\n#bar.on{display:block}#bar i{display:block;height:100%;width:35%;background:var(--acc);animation:slide 1s infinite ease-in-out}\n@keyframes slide{from{transform:translateX(-100%)}to{transform:translateX(300%)}}\n\n/* paramètres */\n#set{position:absolute;inset:0;z-index:5;background:var(--bg);display:none}\n#set.on{display:grid;grid-template-columns:250px 1fr}\n.snav{border-right:1px solid var(--line);background:var(--side);padding:22px 12px;display:flex;flex-direction:column;gap:2px;overflow:auto}\n.snav h2{font:500 22px var(--serif);padding:0 10px 14px}\n.snav button{font:inherit;text-align:left;background:none;border:0;color:var(--dim);padding:8px 10px;border-radius:8px;cursor:pointer}\n.snav button:hover{background:var(--hover);color:var(--txt)}.snav button.on{background:var(--sel);color:var(--txt);font-weight:500}\n.sgrp{color:var(--dim);font-size:11.5px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;padding:16px 10px 4px}\n.dev-only{display:none}body.dev .dev-only{display:block}\n.spanes{overflow:auto}\n.pane{display:none;padding:28px 40px 56px;max-width:840px}.pane.on{display:block}\n.pane h2{font:500 28px var(--serif);letter-spacing:-.01em;margin-bottom:6px}\n.pane h3{font-size:14px;font-weight:600;margin:26px 0 6px}\n.pane p,.dim,.lead{color:var(--dim);line-height:1.55}\n.pane p{margin:4px 0}\n.warn{color:var(--warn);margin:8px 0}\n.card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:4px 18px;margin:8px 0}\n.card.pad{padding:16px 18px}\n.opt{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:14px 0;border-bottom:1px solid var(--line);cursor:pointer}\n.opt:last-child{border-bottom:0}.opt.nc{cursor:default}\n.opt b{font-weight:500}.opt small{display:block;color:var(--dim);font-size:12.5px;margin-top:2px;line-height:1.45}\n.opt.off{opacity:.55}\n.sw{appearance:none;-webkit-appearance:none;width:38px;height:22px;padding:0;border:0;border-radius:22px;background:var(--line2);position:relative;cursor:pointer;flex:none;transition:background .15s}\n.sw::after{content:\"\";position:absolute;top:3px;left:3px;width:16px;height:16px;border-radius:50%;background:#fff;transition:transform .15s;box-shadow:0 1px 2px rgba(0,0,0,.25)}\n.sw:checked{background:var(--btn)}.sw:checked::after{transform:translateX(16px)}\n.seg{display:inline-flex;background:var(--hover);border-radius:10px;padding:3px;gap:2px}\n.seg button{font:inherit;border:0;background:none;color:var(--dim);padding:5px 14px;border-radius:8px;cursor:pointer}\n.seg button.on{background:var(--panel);color:var(--txt);box-shadow:0 1px 2px rgba(0,0,0,.14);font-weight:500}\n.line{display:flex;gap:8px;align-items:center;margin:10px 0;flex-wrap:wrap}\n.pill{display:inline-block;font-size:12px;font-weight:500;padding:2px 9px;border-radius:20px;background:var(--hover);color:var(--dim)}\n.pill.ok{background:rgba(47,125,91,.14);color:var(--ok)}.pill.no{background:rgba(179,65,47,.13);color:var(--err)}\n#code{width:100%;height:42vh;resize:vertical;white-space:pre;tab-size:2}\n.ev{display:grid;grid-template-columns:170px 1fr;gap:3px 12px;font-size:13px}.ev code{color:var(--acc);background:none;padding:0}\n.row2{display:grid;grid-template-columns:1.1fr 1fr 2fr 1fr auto;gap:6px;margin:6px 0}\n#logl{max-height:46vh;overflow:auto}\n#custom{width:100%;height:190px;resize:vertical}\n\n/* fenêtres, bulle */\ndialog{margin:auto;background:var(--panel);color:var(--txt);border:1px solid var(--line);border-radius:16px;padding:22px;width:380px;box-shadow:var(--shadow)}\ndialog::backdrop{background:rgba(0,0,0,.45)}\ndialog h3{font:500 20px var(--serif);margin-bottom:6px}\ndialog label{display:block;margin:14px 0 4px;color:var(--dim)}\ndialog label.inl{display:flex;align-items:center;gap:8px;color:var(--txt)}\ndialog select,dialog input:not([type=checkbox]){width:100%}\n.row{display:flex;gap:8px;justify-content:flex-end;margin-top:20px}\n#toast{position:fixed;bottom:24px;left:50%;transform:translate(-50%,20px);background:var(--tbg);color:var(--ttx);padding:10px 16px;border-radius:10px;font-weight:500;opacity:0;pointer-events:none;transition:.2s;z-index:99;max-width:70vw;box-shadow:var(--shadow)}\n#toast.show{opacity:1;transform:translate(-50%,0)}\n@media (prefers-reduced-motion:reduce){#toast{transition:none}.spin{animation-duration:2.4s}}\n\n/* écran de démarrage */\n#splash{position:fixed;inset:0;z-index:50;background:var(--bg);display:flex;flex-direction:column;align-items:center;justify-content:center;transition:opacity .5s,transform .5s}\n#splash.out{opacity:0;transform:scale(1.04);pointer-events:none}\n#splash svg{width:150px;height:150px;overflow:visible}\n#splash .ln{stroke:var(--acc);stroke-width:4;stroke-linecap:round;stroke-dasharray:140;stroke-dashoffset:140;animation:draw .7s ease-out forwards}\n#splash .nd,#splash .ct,#splash .rg{transform-box:fill-box;transform-origin:center}\n#splash .nd{fill:var(--acc);transform:scale(0);animation:pop .45s cubic-bezier(.2,1.6,.4,1) forwards}\n#splash .ct{fill:var(--txt);animation:beat 1.4s ease-in-out .9s infinite}\n#splash .rg{fill:none;stroke:var(--acc);stroke-width:2;opacity:0;animation:ring 1.6s ease-out .9s infinite}\n#splash .wm{margin-top:24px;font:500 24px var(--serif);letter-spacing:.3em;text-indent:.3em;opacity:0;transform:translateY(8px);animation:rise .6s .7s forwards}\n@keyframes draw{to{stroke-dashoffset:0}}@keyframes pop{to{transform:scale(1)}}@keyframes beat{50%{transform:scale(1.18)}}\n@keyframes ring{0%{opacity:.7;transform:scale(1)}100%{opacity:0;transform:scale(3.4)}}@keyframes rise{to{opacity:1;transform:none}}\n@media (prefers-reduced-motion:reduce){#splash *{animation-duration:.01s!important;animation-delay:0s!important}}\n\n/* ===== 2.2.2 : animations, thème, page Fichiers ===== */\n:root{--ease:cubic-bezier(.2,.8,.2,1);--spring:cubic-bezier(.3,1.4,.5,1)}\n.themeswap,.themeswap *{transition:background-color .38s ease,color .38s ease,border-color .38s ease,fill .38s ease,stroke .38s ease,box-shadow .38s ease!important}\n@keyframes pagein{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}\n@keyframes fadein{from{opacity:0}to{opacity:1}}\n@keyframes itemin{from{opacity:0;transform:translateX(-10px)}to{opacity:1;transform:none}}\n@keyframes cardin{from{opacity:0;transform:translateY(16px) scale(.97)}to{opacity:1;transform:none}}\n@keyframes dlgin{from{opacity:0;transform:translateY(14px) scale(.96)}to{opacity:1;transform:none}}\n@keyframes menuin{from{opacity:0;transform:translateY(-6px) scale(.96)}to{opacity:1;transform:none}}\n@keyframes askin{from{opacity:0;transform:translateY(-8px)}to{opacity:1;transform:none}}\n@keyframes floaty{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}\n@keyframes pulsebd{0%,100%{border-color:var(--acc)}50%{border-color:transparent}}\n\n.brand svg{transition:transform .8s var(--spring)}.brand:hover svg{transform:rotate(60deg) scale(1.06)}\n.acc{transition:background .15s,transform .2s var(--ease)}.acc:hover{transform:translateX(2px)}\n.acc.enter{animation:itemin .42s var(--ease) backwards;animation-delay:calc(var(--i,0)*50ms)}\n.grp.enter{animation:fadein .6s ease backwards}\n.acc.on .dot{box-shadow:0 0 0 3px var(--soft)}.dot{transition:box-shadow .25s}\n.btn{transition:background .15s,border-color .15s,transform .18s var(--ease),box-shadow .22s}\n.btn:active{transform:scale(.97)}\n.btn.pri:hover{box-shadow:0 5px 16px rgba(181,83,47,.30);transform:translateY(-1px)}\n.btn.pri:active{transform:scale(.97)}\n.btn.on{background:var(--sel)}\n#set.on{animation:pagein .36s var(--ease) backwards}\n.pane.on{animation:pagein .4s var(--ease) backwards}\n#empty>div{animation:pagein .7s var(--ease) backwards}\n.sw{transition:background .2s}.sw::after{transition:transform .28s var(--spring),width .15s}\n.sw:active::after{width:20px}.sw:checked:active::after{transform:translateX(12px)}\n.card{transition:border-color .2s,box-shadow .25s}.card:hover{border-color:var(--line2)}\n.seg{position:relative}\n.seg .ind{position:absolute;top:3px;bottom:3px;left:0;width:var(--w,0);transform:translateX(var(--x,0));background:var(--panel);border-radius:8px;box-shadow:0 1px 2px rgba(0,0,0,.14);transition:transform .32s var(--spring),width .32s var(--ease);pointer-events:none}\n.seg button{position:relative;z-index:1;transition:color .2s}\n.seg button.on{background:none!important;box-shadow:none!important}\ndialog[open]{animation:dlgin .3s var(--ease)}\ndialog[open]::backdrop{animation:fadein .25s ease;backdrop-filter:blur(2px)}\n#ask:not([hidden]){animation:askin .4s var(--ease)}\n\n.foot{display:flex;gap:6px;align-items:center}\n.foot #gear{flex:1;min-width:0;width:auto}\n.btn.ic-only{padding:8px;line-height:0}\n.tg{position:relative;width:16px;height:16px;display:block}\n.tg>span{position:absolute;inset:0;display:block;transition:transform .6s var(--spring),opacity .3s ease}\n.tg .moon{opacity:0;transform:rotate(-80deg) scale(.3)}\n:root[data-eff=dark] .tg .sun{opacity:0;transform:rotate(80deg) scale(.3)}\n:root[data-eff=dark] .tg .moon{opacity:1;transform:none}\n#filesbtn .pill{margin-left:auto}.pill:empty{display:none}\n\n#files{position:absolute;inset:0;z-index:5;background:var(--bg);display:none;overflow:auto;padding:30px 40px 56px}\n#files.on{display:block;animation:pagein .38s var(--ease) backwards}\n.fhead{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;flex-wrap:wrap;margin-bottom:22px}\n.fhead h2{font:500 30px var(--serif);letter-spacing:-.01em}\n.fhead p{color:var(--dim);margin-top:4px;max-width:540px}\n.fact{display:flex;gap:10px;align-items:center;flex-wrap:wrap}\n.fsearch{position:relative;display:flex;align-items:center}\n.fsearch .ic{position:absolute;left:11px;color:var(--dim);pointer-events:none}\n.fsearch input{padding-left:34px;width:220px;transition:border-color .15s,box-shadow .2s,width .28s var(--ease)}\n.fsearch input:focus{outline:none;border-color:var(--acc);box-shadow:0 0 0 3px var(--soft);width:280px}\n#fgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:14px}\n.fcard{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:14px;display:flex;flex-direction:column;gap:6px;min-width:0;transition:transform .26s var(--ease),box-shadow .26s,border-color .2s;animation:cardin .5s var(--ease) backwards;animation-delay:calc(min(var(--i,0),14)*38ms)}\n.fcard:hover{transform:translateY(-3px);box-shadow:var(--shadow);border-color:var(--line2)}\n#fgrid.noanim .fcard{animation:none}\n.ftile{width:46px;height:46px;border-radius:12px;display:grid;place-items:center;font:600 12px var(--sans);letter-spacing:.04em;color:var(--tint,var(--dim));background:var(--soft);background:color-mix(in srgb,var(--tint,var(--dim)) 15%,transparent);margin-bottom:6px;transition:transform .35s var(--spring)}\n.fcard:hover .ftile{transform:scale(1.08) rotate(-3deg)}\n.k-image{--tint:#5B8FD0}.k-pdf{--tint:#D4604A}.k-doc{--tint:#4F86D9}.k-sheet{--tint:#3F9A6A}.k-code{--tint:#9A78D2}.k-zip{--tint:#C4902F}.k-txt{--tint:#8A877D}\n.fthumb{height:112px;border-radius:10px;overflow:hidden;background:var(--hover);margin-bottom:6px}\n.fthumb img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .6s var(--ease)}\n.fcard:hover .fthumb img{transform:scale(1.06)}\n.fname{font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.fmeta{color:var(--dim);font-size:12.5px}\n.fact2{display:flex;gap:4px;align-items:center;margin-top:8px}\n.fact2 .btn.sm:first-child{flex:1;justify-content:center}\n.btn.sm{padding:5px 9px;font-size:13px}.btn.ico{padding:6px;line-height:0}\n.btn.ico.del:hover{color:var(--err)}\n#fempty{display:none;place-items:center;text-align:center;padding:70px 20px}\n#fempty>div{max-width:380px}\n#fempty .big{width:84px;height:84px;margin:0 auto 18px;border-radius:24px;display:grid;place-items:center;color:var(--acc);background:var(--soft);animation:floaty 3.4s ease-in-out infinite}\n#fempty .big .ic{width:38px;height:38px}\n#fempty h3{font:500 22px var(--serif);margin-bottom:6px}\n#fempty p{color:var(--dim);margin-bottom:16px}\n#fdrop{position:fixed;top:68px;left:276px;right:12px;bottom:12px;border:2px dashed var(--acc);border-radius:20px;background:var(--soft);backdrop-filter:blur(3px);display:grid;place-items:center;text-align:center;opacity:0;pointer-events:none;transform:scale(.985);transition:opacity .2s,transform .28s var(--ease);z-index:7}\n#fdrop.on{opacity:1;transform:none;animation:pulsebd 1.5s ease-in-out infinite}\n#fdrop b{display:block;font:500 22px var(--serif);margin-top:10px}#fdrop span{color:var(--dim)}\n#fdrop .ic{width:42px;height:42px;color:var(--acc);animation:floaty 1.6s ease-in-out infinite}\n#fmenu{position:fixed;z-index:80;width:260px;max-height:50vh;overflow:auto;background:var(--panel);border:1px solid var(--line);border-radius:12px;box-shadow:var(--shadow);padding:6px}\n#fmenu[hidden]{display:none}#fmenu.in{animation:menuin .18s var(--ease)}\n#fmenu .mt{color:var(--dim);font-size:11.5px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;padding:6px 10px 4px}\n#fmenu button{font:inherit;color:var(--txt);width:100%;display:flex;align-items:center;gap:9px;padding:8px 10px;border:0;background:none;border-radius:8px;cursor:pointer;text-align:left;transition:background .12s}\n#fmenu button:hover{background:var(--hover)}\n#fmenu button span{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n#fmenu button em{font-style:normal;font-size:11.5px;color:var(--acc);font-weight:500}\n@media (prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-delay:0s!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}\n/* 2.2.4 : projets */\n#fprojs{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 16px}\n.chip{font:inherit;font-size:13px;color:var(--txt);background:var(--panel);border:1px solid var(--line);border-radius:999px;padding:5px 12px;cursor:pointer;display:inline-flex;align-items:center;gap:6px;transition:background .15s,border-color .15s,transform .18s var(--ease)}\n.chip:hover{background:var(--hover);transform:translateY(-1px)}\n.chip .ic{width:14px;height:14px}\n.chip i{font-style:normal;font-size:11.5px;color:var(--dim)}\n.chip.on{background:var(--soft);border-color:var(--acc);color:var(--acc)}.chip.on i{color:var(--acc)}\n.chip.add{border-style:dashed;color:var(--dim)}\n#fpedit{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:14px;margin:0 0 18px;display:flex;flex-direction:column;gap:10px}\n#fpedit[hidden]{display:none}\n#fpedit .pe-row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}\n#fpedit input,#fpedit textarea{font:inherit;color:var(--txt);background:var(--bg);border:1px solid var(--line);border-radius:8px;padding:7px 10px;outline:none;min-width:0}\n#fpedit input{flex:1}#fpedit textarea{resize:vertical;width:100%;box-sizing:border-box}\n#fpedit input:focus,#fpedit textarea:focus{border-color:var(--acc)}\n#psum{margin:0;white-space:pre-wrap;font:12.5px/1.5 inherit;color:var(--dim);background:var(--bg);border:1px solid var(--line);border-radius:8px;padding:9px 11px;max-height:190px;overflow:auto}\n.psel{font:inherit;font-size:12px;color:var(--dim);background:var(--bg);border:1px solid var(--line);border-radius:8px;padding:4px 6px;margin-top:2px;max-width:100%;cursor:pointer}\n.psel:hover{border-color:var(--acc)}\n/* 2.2.6 : cartes fichiers façon Claude, icônes animées, couleurs personnalisables */\n#fgrid{grid-template-columns:repeat(auto-fill,minmax(290px,1fr))}\n.fcard .frow{display:flex;gap:13px;align-items:center;min-width:0}\n.fcard .fbody{min-width:0;flex:1;display:flex;flex-direction:column;gap:1px}\n.ftile{--sp:2.6s;width:52px;height:60px;flex:none;margin:0;border-radius:13px;color:var(--tint);display:grid;place-items:center;position:relative;overflow:hidden;\n  border:1px solid color-mix(in srgb,var(--tint) 55%,transparent);\n  background:linear-gradient(160deg,color-mix(in srgb,var(--tint) 38%,var(--panel)),color-mix(in srgb,var(--tint) 9%,var(--panel)) 85%);\n  box-shadow:0 0 0 0 color-mix(in srgb,var(--tint) 0%,transparent),inset 0 1px 0 color-mix(in srgb,var(--tint) 35%,transparent);\n  animation:ficGlow calc(var(--sp)*1.6) ease-in-out infinite;transition:transform .35s var(--spring)}\n.ftile::after{content:\"\";position:absolute;inset:0;background:linear-gradient(115deg,transparent 35%,color-mix(in srgb,var(--tint) 40%,#fff) 50%,transparent 65%);opacity:0;transform:translateX(-100%)}\n.fcard:hover .ftile{--sp:1s;transform:translateY(-2px) rotate(-2.5deg) scale(1.05)}\n.fcard:hover .ftile::after{animation:ficShine 1.1s ease-out}\n.fic{width:26px;height:26px;overflow:visible;position:relative;z-index:1;filter:drop-shadow(0 0 5px color-mix(in srgb,var(--tint) 55%,transparent))}\n.fic *{transform-box:fill-box;transform-origin:center}\n.fcard .fthumb{width:52px;height:60px;flex:none;margin:0;border-radius:13px;border:1px solid var(--line)}\n@keyframes ficGlow{0%,100%{box-shadow:0 0 0 0 color-mix(in srgb,var(--tint) 0%,transparent),inset 0 1px 0 color-mix(in srgb,var(--tint) 35%,transparent)}50%{box-shadow:0 0 16px 0 color-mix(in srgb,var(--tint) 38%,transparent),inset 0 1px 0 color-mix(in srgb,var(--tint) 35%,transparent)}}\n@keyframes ficShine{to{transform:translateX(100%);opacity:.55}}\n@keyframes ficSpinA{0%{transform:scaleX(1)}50%{transform:scaleX(.04)}100%{transform:scaleX(1)}}\n@keyframes ficSpinB{0%{transform:scaleX(.04)}50%{transform:scaleX(1)}100%{transform:scaleX(.04)}}\n@keyframes ficSun{0%,100%{transform:translate(0,0) scale(1)}50%{transform:translate(7px,-1px) scale(1.25)}}\n@keyframes ficDraw{0%{stroke-dasharray:1 1;stroke-dashoffset:1}55%,85%{stroke-dasharray:1 1;stroke-dashoffset:0}100%{stroke-dasharray:1 1;stroke-dashoffset:-1}}\n@keyframes ficBrL{0%,100%{transform:translateX(0) rotate(0)}50%{transform:translateX(-2.8px) rotate(-7deg)}}\n@keyframes ficBrR{0%,100%{transform:translateX(0) rotate(0)}50%{transform:translateX(2.8px) rotate(7deg)}}\n@keyframes ficChL{0%,100%{transform:translateX(0)}50%{transform:translateX(-3px)}}\n@keyframes ficChR{0%,100%{transform:translateX(0)}50%{transform:translateX(3px)}}\n@keyframes ficSlash{0%,100%{transform:rotate(0) scaleY(1)}50%{transform:rotate(14deg) scaleY(1.12)}}\n@keyframes ficLid{0%,18%,100%{transform:rotate(0) translateY(0)}45%,70%{transform:rotate(-16deg) translate(-1px,-2.5px)}}\n@keyframes ficItem{0%,18%,100%{transform:translateY(2px);opacity:0}45%,70%{transform:translateY(-5px);opacity:1}}\n@keyframes ficZip{0%,100%{opacity:1}50%{opacity:.2}}\n@keyframes ficCell{0%,100%{opacity:0}40%{opacity:.5}}\n@keyframes ficBar{0%,100%{transform:scaleY(.3)}50%{transform:scaleY(1.15)}}\n@keyframes ficPlay{0%,100%{transform:scale(1)}50%{transform:scale(1.28)}}\n@keyframes ficRing{0%{transform:scale(.6);opacity:.9}100%{transform:scale(2.1);opacity:0}}\n@keyframes ficFold{0%,100%{transform:rotate(0)}50%{transform:rotate(-14deg) scale(1.2)}}\n.ik-web .a{animation:ficSpinA var(--sp) linear infinite}.ik-web .b{animation:ficSpinB var(--sp) linear infinite}\n.ik-vector .a,.ik-image .a{animation:ficSun calc(var(--sp)*1.5) ease-in-out infinite}\n.ik-vector .b,.ik-image .b{animation:ficDraw calc(var(--sp)*1.4) ease-in-out infinite}\n.ik-braces .a{animation:ficBrL var(--sp) ease-in-out infinite}.ik-braces .b{animation:ficBrR var(--sp) ease-in-out infinite}\n.ik-code .a{animation:ficChL var(--sp) ease-in-out infinite}.ik-code .b{animation:ficChR var(--sp) ease-in-out infinite}.ik-code .c{animation:ficSlash var(--sp) ease-in-out infinite}\n.ik-zip .a{animation:ficLid calc(var(--sp)*1.5) ease-in-out infinite;transform-origin:left bottom}.ik-zip .c{animation:ficItem calc(var(--sp)*1.5) ease-in-out infinite}.ik-zip .b{animation:ficZip var(--sp) ease-in-out infinite}\n.ik-pdf .a,.ik-pdf .b,.ik-doc .a,.ik-doc .b,.ik-doc .c,.ik-txt .a,.ik-txt .b,.ik-txt .c,.ik-file .b{stroke-dasharray:1 1;animation:ficDraw calc(var(--sp)*1.6) ease-in-out infinite}\n.ik-pdf .b,.ik-doc .b,.ik-txt .b{animation-delay:.25s}.ik-doc .c,.ik-txt .c{animation-delay:.5s}\n.ik-sheet .a{animation:ficCell calc(var(--sp)*1.5) ease-in-out infinite}.ik-sheet .b{animation:ficCell calc(var(--sp)*1.5) .3s ease-in-out infinite}.ik-sheet .c{animation:ficCell calc(var(--sp)*1.5) .6s ease-in-out infinite}\n.ik-audio .a,.ik-audio .b,.ik-audio .c{animation:ficBar calc(var(--sp)*.55) ease-in-out infinite}.ik-audio .b{animation-delay:.15s}.ik-audio .c{animation-delay:.3s}\n.ik-video .a{animation:ficPlay var(--sp) ease-in-out infinite}.ik-video .b{animation:ficRing var(--sp) ease-out infinite}\n.ik-file .a{animation:ficFold calc(var(--sp)*1.2) ease-in-out infinite;transform-origin:top right}\n#ficols{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:14px;margin:0 0 18px}\n#ficols[hidden]{display:none}\n.fc-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px;flex-wrap:wrap}\n.fc-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:10px}\n.fc-item{display:flex;align-items:center;gap:11px;padding:8px;border:1px solid var(--line);border-radius:12px;cursor:pointer}\n.fc-item .ftile{width:40px;height:46px;border-radius:10px}.fc-item .fic{width:21px;height:21px}\n.fc-n{flex:1;font-size:13px;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.fc-item input[type=color]{width:34px;height:30px;padding:0;border:1px solid var(--line);border-radius:8px;background:none;cursor:pointer}\n</style></head><body>\n<div id=\"splash\"><svg viewBox=\"0 0 120 120\"><g>\n<line class=\"ln\" x1=\"60\" y1=\"60\" x2=\"60\" y2=\"14\" style=\"animation-delay:.1s\"/><line class=\"ln\" x1=\"60\" y1=\"60\" x2=\"20\" y2=\"94\" style=\"animation-delay:.25s\"/><line class=\"ln\" x1=\"60\" y1=\"60\" x2=\"100\" y2=\"94\" style=\"animation-delay:.4s\"/>\n<circle class=\"nd\" cx=\"60\" cy=\"14\" r=\"9\" style=\"animation-delay:.35s\"/><circle class=\"nd\" cx=\"20\" cy=\"94\" r=\"9\" style=\"animation-delay:.5s\"/><circle class=\"nd\" cx=\"100\" cy=\"94\" r=\"9\" style=\"animation-delay:.65s\"/>\n<circle class=\"rg\" cx=\"60\" cy=\"60\" r=\"11\"/><circle class=\"ct\" cx=\"60\" cy=\"60\" r=\"13\"/></g></svg><div class=\"wm\">AI HUB</div></div>\n\n<aside>\n  <div class=\"brand\"><svg viewBox=\"0 0 120 120\" fill=\"currentColor\" stroke=\"currentColor\"><line x1=\"60\" y1=\"60\" x2=\"60\" y2=\"18\" stroke-width=\"7\" stroke-linecap=\"round\"/><line x1=\"60\" y1=\"60\" x2=\"24\" y2=\"92\" stroke-width=\"7\" stroke-linecap=\"round\"/><line x1=\"60\" y1=\"60\" x2=\"96\" y2=\"92\" stroke-width=\"7\" stroke-linecap=\"round\"/><circle cx=\"60\" cy=\"16\" r=\"12\" stroke=\"none\"/><circle cx=\"22\" cy=\"94\" r=\"12\" stroke=\"none\"/><circle cx=\"98\" cy=\"94\" r=\"12\" stroke=\"none\"/><circle cx=\"60\" cy=\"60\" r=\"15\" stroke=\"none\"/></svg><h1>AI Hub</h1></div>\n  <button id=\"add\" class=\"btn pri wide\" data-ic=\"plus\">Ajouter un compte</button>\n  <div id=\"list\"></div>\n  <button id=\"filesbtn\" class=\"btn ghost wide left\" data-ic=\"folder\">Fichiers<span class=\"pill\" id=\"fcount\"></span></button>\n  <div class=\"foot\"><button id=\"gear\" class=\"btn ghost wide left\" data-ic=\"sliders\">Paramètres</button><button id=\"themebtn\" class=\"btn ghost ic-only\" title=\"Basculer clair / sombre\" aria-label=\"Basculer clair / sombre\"></button></div>\n</aside>\n\n<main>\n  <header><strong id=\"title\">Aucun compte sélectionné</strong>\n    <div class=\"hbtns\"><button id=\"reload\" class=\"btn ghost\" data-ic=\"refresh\">Recharger</button><button id=\"handoff\" class=\"btn\" data-ic=\"swap\">Reprendre ailleurs</button><button id=\"export\" class=\"btn\" data-ic=\"copy\">Copier la conversation</button></div></header>\n  <div id=\"ask\" hidden><span id=\"asktxt\"></span><button id=\"askyes\" class=\"btn pri\">Reprendre</button><button id=\"askno\" class=\"btn\">Ignorer</button></div>\n  <div id=\"views\"><div id=\"bar\"><i></i></div>\n  <div id=\"empty\"><div><h2>Tous tes comptes IA, au même endroit</h2><p>Chaque compte garde sa session : tu n'as plus à te reconnecter.</p><button id=\"add2\" class=\"btn pri\" data-ic=\"plus\">Ajouter un compte</button></div></div>\n\n  <section id=\"files\">\n    <div class=\"fhead\">\n      <div><h2>Fichiers</h2><p id=\"fsub\"></p></div>\n      <div class=\"fact\"><div class=\"fsearch\"><span data-ic=\"search\"></span><input id=\"fq\" placeholder=\"Rechercher un fichier…\" autocomplete=\"off\"></div><button id=\"fcolbtn\" class=\"btn\" data-ic=\"sliders\">Couleurs</button><button id=\"fadd\" class=\"btn pri\" data-ic=\"plus\">Ajouter des fichiers</button></div>\n    </div>\n    <div id=\"ficols\" hidden></div><div id=\"fprojs\"></div><div id=\"fpedit\" hidden></div>\n    <div id=\"fgrid\"></div>\n    <div id=\"fempty\"><div><div class=\"big\" data-ic=\"folder\"></div><h3>Aucun fichier pour l'instant</h3><p>Ajoute un fichier une seule fois : il sera disponible sur tous tes comptes, prêt à être joint à n'importe quelle conversation.</p><button id=\"fadd2\" class=\"btn pri\" data-ic=\"plus\">Ajouter des fichiers</button></div></div>\n    <input type=\"file\" id=\"fin\" multiple hidden>\n  </section>\n  <div id=\"fdrop\"><div><div data-ic=\"upload\"></div><b>Dépose tes fichiers ici</b><span>Ils seront disponibles sur tous tes comptes</span></div></div>\n  <div id=\"fmenu\" hidden></div>\n  <section id=\"set\">\n    <nav class=\"snav\"><h2>Paramètres</h2>\n      <button data-t=\"gen\" class=\"on\">Général</button>\n      <button data-t=\"acc\">Comptes et sauvegarde</button>\n      <button data-t=\"rel\">Reprise sur un autre compte</button>\n      <button data-t=\"upd\">Mises à jour</button>\n      <div class=\"dev-only\"><div class=\"sgrp\">Développeur</div>\n        <button data-t=\"code\" style=\"width:100%\">Code personnalisé</button><button data-t=\"det\" style=\"width:100%\">Détections</button><button data-t=\"log\" style=\"width:100%\">Journal en direct</button></div>\n    </nav>\n    <div class=\"spanes\">\n\n    <div class=\"pane on\" id=\"p-gen\">\n      <h2>Général</h2>\n      <h3>Apparence</h3>\n      <div class=\"card\"><div class=\"opt nc\"><span><b>Thème</b><small>« Système » suit le thème de Windows. Les sites (Claude, ChatGPT…) qui suivent le thème du système changent aussi.</small></span>\n        <span class=\"seg\" id=\"theme\"><button data-th=\"system\">Système</button><button data-th=\"light\">Clair</button><button data-th=\"dark\">Sombre</button></span></div></div>\n\n      <h3>Notifications</h3>\n      <div class=\"card pad\"><div class=\"line\" style=\"margin:0\"><span id=\"nstate\" class=\"pill\"></span><button id=\"nauth\" class=\"btn\"></button><button id=\"ntest\" class=\"btn\">Envoyer un test</button></div>\n        <p id=\"nhint\" style=\"margin-top:10px\"></p></div>\n      <div class=\"card\" id=\"ntypes\">\n        <label class=\"opt\"><span><b>Réponse terminée</b><small>Quand l'IA finit de répondre sur un compte que tu ne regardes pas.</small></span><input type=\"checkbox\" class=\"sw\" data-n=\"done\"></label>\n        <label class=\"opt\"><span><b>Limite atteinte</b><small>Quand un compte n'a plus de messages.</small></span><input type=\"checkbox\" class=\"sw\" data-n=\"limit\"></label>\n        <label class=\"opt\"><span><b>Reprise sur un autre compte</b><small>Quand une conversation est transférée (ou ne peut pas l'être).</small></span><input type=\"checkbox\" class=\"sw\" data-n=\"handoff\"></label>\n        <label class=\"opt\"><span><b>Compte déconnecté</b><small>Quand une session expire.</small></span><input type=\"checkbox\" class=\"sw\" data-n=\"logout\"></label>\n      </div>\n\n      <h3>Options</h3>\n      <div class=\"card\">\n        <label class=\"opt\"><span><b>Garder tous les comptes chargés en arrière-plan</b><small>Nécessaire pour détecter les limites et les réponses sur les comptes qui ne sont pas affichés.</small></span><input type=\"checkbox\" class=\"sw\" id=\"preall\"></label>\n        <label class=\"opt\"><span><b>Mode développeur</b><small>Active l'onglet « Code personnalisé » (scripts JavaScript), les détections personnalisées et le journal en direct. Désactivé : aucun script n'est exécuté.</small></span><input type=\"checkbox\" class=\"sw\" id=\"dev\"></label>\n      </div>\n    </div>\n\n    <div class=\"pane\" id=\"p-acc\">\n      <h2>Comptes et sauvegarde</h2>\n      <h3>Fichier de comptes</h3>\n      <p>Enregistre tes comptes, leurs sessions connectées et tes réglages dans UN fichier. Charge-le dans une autre instance de AI Hub (autre PC, réinstallation) : les comptes arrivent déjà connectés. Les comptes déjà présents sont conservés.</p>\n      <p class=\"warn\">Ce fichier donne accès à tes comptes sans mot de passe. Mets un mot de passe de chiffrement, et ne le partage jamais.</p>\n      <div class=\"line\"><input id=\"pass\" type=\"password\" placeholder=\"Mot de passe de chiffrement\" autocomplete=\"off\" style=\"width:260px\">\n        <button id=\"exp\" class=\"btn pri\">Enregistrer dans un fichier</button><button id=\"imp\" class=\"btn\">Charger depuis un fichier</button></div>\n      <p id=\"msg\"></p>\n      <h3>Sécurité des données</h3>\n      <p>Les comptes sont enregistrés avec des copies de secours automatiques, et une seule fenêtre AI Hub peut tourner à la fois. Si un compte a disparu de la liste, sa session existe peut-être encore :</p>\n      <div class=\"line\"><button id=\"recover\" class=\"btn\">Retrouver les comptes perdus</button><button id=\"opendata\" class=\"btn\">Ouvrir le dossier des données</button></div>\n    </div>\n\n    <div class=\"pane\" id=\"p-rel\">\n      <h2>Reprise sur un autre compte</h2>\n      <p class=\"lead\">Quand un compte atteint sa limite, AI Hub reprend la conversation sur un autre compte et prépare le message de reprise.</p>\n      <div class=\"card\">\n        <label class=\"opt\"><span><b>Reprise automatique</b><small>Détecte la limite et lance la reprise sans que tu aies à intervenir.</small></span><input type=\"checkbox\" class=\"sw\" data-r=\"enabled\"></label>\n        <div class=\"opt nc\"><span><b>Quand la limite est atteinte</b></span><select data-r=\"mode\"><option value=\"auto\">Reprendre tout de suite</option><option value=\"ask\">Me demander d'abord</option></select></div>\n        <label class=\"opt\"><span><b>Même plateforme seulement</b><small>Ex. de Claude vers un autre compte Claude.</small></span><input type=\"checkbox\" class=\"sw\" data-r=\"samePlatform\"></label>\n        <label class=\"opt\"><span><b>Envoyer le message automatiquement</b><small>Sinon, le message est collé dans la zone de saisie et tu valides toi-même (recommandé pour commencer).</small></span><input type=\"checkbox\" class=\"sw\" data-r=\"send\"></label>\n      </div>\n      <h3>Contenu transmis</h3>\n      <div class=\"card\">\n        <label class=\"opt\"><span><b>Résumer les longues conversations avec Gemini</b><small id=\"sumnote\"></small></span><input type=\"checkbox\" class=\"sw\" data-r=\"summary\"></label>\n        <div class=\"opt nc\"><span><b>Consigne donnée à l'IA</b></span><select data-r=\"tpl\"><option value=\"continue\">Continuer directement le travail</option><option value=\"ready\">Répondre « Prêt » et attendre</option></select></div>\n        <div class=\"opt nc\"><span><b>Taille maximale</b><small>En caractères. Au-delà, les messages du milieu sont omis (le début et la fin sont gardés).</small></span><input type=\"number\" data-r=\"maxChars\" min=\"5000\" max=\"300000\" step=\"5000\" style=\"width:110px\"></div>\n      </div>\n      <details><summary>Modèle du message (avancé)</summary>\n        <p>Laisse vide pour utiliser le modèle intégré. Variables : <code>{plateforme}</code> <code>{compte}</code> <code>{contexte}</code> <code>{suite}</code> <code>{date}</code></p>\n        <textarea id=\"custom\" data-r=\"custom\" spellcheck=\"false\" placeholder=\"[REPRISE] Voici le contexte :&#10;{contexte}&#10;&#10;{suite}\"></textarea></details>\n\n      <h3>Résumé par IA (Gemini)</h3>\n      <p>La conversation est envoyée à Google pour être résumée. Sans clé, ou si Gemini ne répond pas, la conversation est transmise en entier (tronquée si trop longue). La clé est stockée dans le fichier de données de l'app (et dans le fichier de comptes exporté, chiffré si tu mets un mot de passe).</p>\n      <div class=\"line\"><input id=\"gkey\" type=\"password\" placeholder=\"Clé API Gemini\" autocomplete=\"off\" style=\"width:300px\"><input id=\"gmodel\" placeholder=\"modèle\" style=\"width:200px\"><button id=\"gtest\" class=\"btn\">Tester</button></div>\n      <p id=\"gmsg\"></p>\n\n      <h3>Dernières reprises</h3>\n      <pre id=\"hlist\">Aucune reprise pour l'instant.</pre>\n\n      <details><summary>Lecture des conversations (si un site a changé)</summary>\n        <p>Si un site change son code et que l'app ne lit plus la conversation (icône d'alerte dans la liste des comptes), ajoute ici des sélecteurs CSS : ils s'ajoutent aux sélecteurs d'origine, sans mise à jour de l'app. Sépare plusieurs sélecteurs par des virgules. Pour en trouver un : clic droit sur l'élément dans Chrome &gt; Inspecter.</p>\n        <div class=\"line\"><select id=\"selplat\"></select></div>\n        <div class=\"line\"><input id=\"sel-user\" placeholder=\"Tes messages\" style=\"flex:1\"><input id=\"sel-ai\" placeholder=\"Réponses de l'IA\" style=\"flex:1\"></div>\n        <div class=\"line\"><input id=\"sel-comp\" placeholder=\"Zone de saisie\" style=\"flex:1\"><input id=\"sel-stop\" placeholder=\"Bouton Stop\" style=\"flex:1\"><input id=\"sel-send\" placeholder=\"Bouton Envoyer\" style=\"flex:1\"></div>\n        <div class=\"line\"><button id=\"selsave\" class=\"btn pri\">Enregistrer les sélecteurs</button><button id=\"diag\" class=\"btn\">Tester les sélecteurs (comptes chargés)</button></div>\n        <pre id=\"diagout\" style=\"display:none\"></pre></details>\n    </div>\n\n    <div class=\"pane\" id=\"p-upd\">\n      <h2>Mises à jour</h2>\n      <h3>Version</h3><div id=\"upinfo\" class=\"dim\"></div>\n      <p>Une mise à jour est un fichier <code>.aihubupdate</code>. Avant de l'installer, tes données sont copiées dans les sauvegardes. Si la nouvelle version ne démarre pas correctement, l'app revient toute seule à la précédente.</p>\n      <div class=\"line\"><button id=\"upapply\" class=\"btn pri\">Installer un fichier de mise à jour</button><button id=\"uprev\" class=\"btn\">Revenir à la version précédente</button><button id=\"uporig\" class=\"btn\">Revenir à la version d'origine</button></div>\n      <p id=\"upmsg\"></p>\n      <h3>Versions installées</h3><pre id=\"upvers\"></pre>\n      <h3>Historique</h3><pre id=\"uphist\"></pre>\n    </div>\n\n    <div class=\"pane\" id=\"p-code\">\n      <h2>Code personnalisé</h2>\n      <p>Mode développeur. Ton code s'exécute dans l'app avec un accès complet à tes comptes et réagit aux événements. Il est relancé à chaque enregistrement et au démarrage. La reprise sur un autre compte est déjà intégrée (onglet « Reprise ») : inutile de la refaire ici, ou tu risques une double reprise.</p>\n      <textarea id=\"code\" spellcheck=\"false\"></textarea>\n      <div class=\"line\"><button id=\"savecode\" class=\"btn pri\">Enregistrer et activer</button><button id=\"resetcode\" class=\"btn\">Remettre l'exemple</button><span id=\"cst\" class=\"dim\"></span></div>\n      <details open><summary>API disponible</summary><pre>on('limit-hit', async ev =&gt; { ... })     // '*' = tous les événements ; once(...) = une seule fois\nev = { type, detail, url, ts, account:{id,platform,name} }\n\nhub.accounts                  liste des comptes     hub.active   compte affiché\nhub.state(id?)                { gen, limited, logged, last, lastAt }\nhub.switchTo(nom|id|n°|\"Claude:nom\")                 hub.next({samePlatform, skipLimited, dir})\nhub.available({samePlatform, from})                  premier compte non limité\nhub.handoff(from?, {to, send, summary})              reprise intégrée : renvoie { ok, to, mode, chars } ou { ok:false, error }\nhub.getConversation(compte?)                         texte de la conversation (null s'il n'y en a pas)\nhub.getMessages(compte?)     hub.health(compte?)     messages lus / diagnostic des sélecteurs\nhub.exportConversation(compte?)                      idem + copie dans le presse-papiers\nhub.newChat(compte?)                                 ouvre une nouvelle conversation\nhub.paste(texte, {account, send})                    écrit dans la zone de saisie (send:true = Entrée)\nhub.send(compte?)             hub.continueOn(compte, {from, send})   (ancien nom de handoff)\nhub.summarize(texte, {platform})   hub.aiEnabled     résumé Gemini (null sans clé)\nhub.runInPage(js, compte?)   hub.reload(compte?)     hub.notify(msg)   hub.copy(texte)\nhub.log(...)   hub.store.get(k) / hub.store.set(k,v)   hub.setLimited(c, bool)   hub.rename(c, nom)   await sleep(ms)</pre></details>\n    </div>\n\n    <div class=\"pane\" id=\"p-det\">\n      <h2>Détections</h2>\n      <h3>Événements détectés automatiquement</h3>\n      <div class=\"ev\" id=\"evlist\"></div>\n      <h3>Tes propres détections</h3>\n      <p>Un événement est émis quand le sélecteur CSS existe dans la page (ou que le texte correspond à la regex), et <code>nom-gone</code> quand il disparaît.</p>\n      <div id=\"dets\"></div>\n      <div class=\"line\"><button id=\"adddet\" class=\"btn\">Ajouter une détection</button><button id=\"savedet\" class=\"btn pri\">Enregistrer</button></div>\n    </div>\n\n    <div class=\"pane\" id=\"p-log\">\n      <h2>Journal en direct</h2>\n      <div id=\"logst\" class=\"dim\"></div>\n      <div class=\"line\"><input id=\"lf\" placeholder=\"Filtrer (ex. limit, handoff, claude…)\"><button id=\"logclr\" class=\"btn\">Vider</button><button id=\"logcp\" class=\"btn\">Copier en JSON</button></div>\n      <pre id=\"logl\"></pre>\n    </div>\n\n    </div>\n  </section></div>\n</main>\n\n<dialog id=\"dlg\"><h3>Nouveau compte</h3>\n  <label for=\"plat\">Plateforme</label><select id=\"plat\"></select>\n  <label for=\"name\">Nom du compte</label><input id=\"name\" placeholder=\"ex. perso, lycée, projet\" autocomplete=\"off\">\n  <div class=\"row\"><button id=\"cancel\" class=\"btn\">Annuler</button><button id=\"ok\" class=\"btn pri\">Ajouter</button></div></dialog>\n<dialog id=\"dlg2\"><h3>Renommer le compte</h3><label for=\"rname\">Nom</label><input id=\"rname\" autocomplete=\"off\">\n  <div class=\"row\"><button id=\"rcancel\" class=\"btn\">Annuler</button><button id=\"rok\" class=\"btn pri\">Enregistrer</button></div></dialog>\n<dialog id=\"dlgH\"><h3>Reprendre sur un autre compte</h3>\n  <p class=\"dim\" id=\"hsrc\"></p>\n  <label for=\"hto\">Compte de destination</label><select id=\"hto\"></select>\n  <label for=\"hmode\">Contenu transmis</label><select id=\"hmode\"><option value=\"sum\">Résumé + derniers échanges (si Gemini est configuré)</option><option value=\"full\">Conversation complète</option></select>\n  <label class=\"inl\"><input type=\"checkbox\" class=\"sw\" id=\"hsend\"> Envoyer le message automatiquement</label>\n  <div class=\"row\"><button id=\"hcancel\" class=\"btn\">Annuler</button><button id=\"hok\" class=\"btn pri\">Reprendre</button></div></dialog>\n<dialog id=\"dlgN\"><h3>Activer les notifications ?</h3>\n  <p class=\"dim\">AI Hub peut t'envoyer une notification Windows quand une réponse est terminée sur un autre compte, quand une limite est atteinte ou quand une conversation est reprise ailleurs. Tu peux choisir les types de notifications dans Paramètres &gt; Général.</p>\n  <div class=\"row\"><button id=\"nno\" class=\"btn\">Refuser</button><button id=\"nlater\" class=\"btn\">Plus tard</button><button id=\"nyes\" class=\"btn pri\" autofocus>Autoriser</button></div></dialog>\n<div id=\"toast\"></div>\n<script>\nconst P={Claude:['https://claude.ai/new','#e0905f'],ChatGPT:['https://chatgpt.com','#3ecf9e'],Gemini:['https://gemini.google.com','#6e9bff'],'Le Chat':['https://chat.mistral.ai','#ff8a3d'],Copilot:['https://copilot.microsoft.com','#a98bff'],Perplexity:['https://www.perplexity.ai','#35c4d6'],Grok:['https://grok.com','#8a8a98'],DeepSeek:['https://chat.deepseek.com','#5b7cff']};\nconst ICONS={plus:'<path d=\"M5 12h14M12 5v14\"/>',sliders:'<path d=\"M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6\"/>',edit:'<path d=\"M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z\"/>',x:'<path d=\"M18 6 6 18M6 6l12 12\"/>',copy:'<rect x=\"9\" y=\"9\" width=\"13\" height=\"13\" rx=\"2\"/><path d=\"M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1\"/>',refresh:'<path d=\"M3 12a9 9 0 0 1 15-6.7L21 8M21 3v5h-5M21 12a9 9 0 0 1-15 6.7L3 16M3 21v-5h5\"/>',swap:'<path d=\"m16 3 4 4-4 4M20 7H4M8 21l-4-4 4-4M4 17h16\"/>',lock:'<rect x=\"3\" y=\"11\" width=\"18\" height=\"11\" rx=\"2\"/><path d=\"M7 11V7a5 5 0 0 1 10 0v4\"/>',warn:'<path d=\"m21.7 18-8-14a2 2 0 0 0-3.4 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.7-3Z\"/><path d=\"M12 9v4M12 17h.01\"/>',ban:'<circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"m4.9 4.9 14.2 14.2\"/>'};\nconst IC=n=>`<svg class=\"ic\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">${ICONS[n]||''}</svg>`;\nObject.assign(ICONS,{\nfolder:'<path d=\"M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z\"/>',\nclip:'<path d=\"m21.4 11-9.2 9.2a5.5 5.5 0 0 1-7.8-7.8l9.2-9.2a3.7 3.7 0 0 1 5.2 5.2l-9.2 9.2a1.8 1.8 0 0 1-2.6-2.6l8.5-8.5\"/>',\ndl:'<path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3\"/>',\nupload:'<path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12\"/>',\ntrash:'<path d=\"M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6M10 11v6M14 11v6\"/>',\nsearch:'<circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/>',\nsun:'<circle cx=\"12\" cy=\"12\" r=\"4\"/><path d=\"M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4\"/>',\nmoon:'<path d=\"M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z\"/>'});\nlet filesOpen=false;\nconst seenA=new Set(),seenG=new Set();                       // animation d'entrée : seulement la 1re fois qu'un élément apparaît\nconst entA=id=>seenA.has(id)?'':(seenA.add(id),'enter'),entG=p=>seenG.has(p)?'':(seenG.add(p),'enter');\n\nconst EVENTS=[['page-loaded','une page finit de charger'],['url-changed','l\\'adresse change (detail: from, to)'],['new-chat','une nouvelle conversation s\\'ouvre'],['chat-opened','une ancienne conversation s\\'ouvre'],['logged-in','le compte est connecté'],['login-required','page de connexion affichée'],['session-expired','déconnecté alors qu\\'il était connecté'],['typing','tu commences à écrire'],['send-attempt','Entrée ou clic sur Envoyer (detail: preview)'],['message-sent','ta question est apparue dans la conversation'],['response-started','l\\'IA commence à répondre'],['response-complete','la réponse est terminée (chars, seconds, preview)'],['limit-hit','limite de messages / d\\'utilisation atteinte'],['limit-cleared','le message de limite a disparu'],['limit-soon','\"il vous reste N messages\"'],['rate-limit','trop de requêtes'],['overloaded','service surchargé / indisponible'],['error','erreur « something went wrong » etc.'],['chat-too-long','conversation trop longue'],['captcha','vérification « êtes-vous humain »'],['captcha-cleared','vérification passée'],['idle','aucune activité depuis 2 min'],['active','reprise après inactivité'],['tab-hidden','le compte n\\'est plus affiché'],['tab-visible','le compte est affiché'],['offline','plus de connexion internet'],['online','connexion revenue'],['code-error','(journal seulement) erreur dans ton code'],['handoff-*','(journal seulement) reprise sur un autre compte : ok, skip, fail'],['mon-nom','tes détections personnalisées (+ mon-nom-gone)']];\nconst EXAMPLE=`// Mode développeur : ton code réagit aux événements des comptes.\n// La reprise sur un autre compte est intégrée (Paramètres > Reprise) : inutile de la refaire ici.\n\n// Exemple : compter les messages envoyés par jour et par compte\n// on('message-sent', ev => {\n//   const jour = new Date().toISOString().slice(0, 10);\n//   const cle = 'msgs-' + ev.account.id + '-' + jour;\n//   hub.store.set(cle, (hub.store.get(cle) || 0) + 1);\n// });\n\n// Exemple : lancer une reprise à la main après une erreur\n// on('error', ev => hub.handoff(ev.account.id));\n`;\n// Ancien exemple (2.1) : s'il n'a pas été modifié, on le remplace pour ne pas doubler la reprise intégrée\nconst isOldExample=c=>/continueOn\\(cible/.test(c)&&c.length<1000;\nconst UA=navigator.userAgent.replace(/\\s?Electron\\/\\S+/,'').replace(/\\s?ai-hub\\/\\S+/,'');\nconst COMPOSER='[contenteditable=\"true\"],textarea';\nconst GEM='gemini-flash-latest';\nconst $=id=>document.getElementById(id);\nconst esc=s=>String(s).replace(/[&<>\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]));\nconst LS=(k,d)=>{try{const v=JSON.parse(localStorage[k]);return v??d}catch{return d}};\nconst sleep=ms=>new Promise(r=>setTimeout(r,ms));\nconst DEF=()=>({preloadAll:false,theme:'system',devMode:false,\n  notif:{enabled:null,on:{done:true,limit:true,handoff:true,logout:true}},\n  relay:{enabled:true,mode:'auto',samePlatform:true,send:false,summary:true,summaryAbove:15000,tpl:'continue',maxChars:60000,custom:''},\n  gemini:{key:'',model:GEM},selectors:{},projects:[],fcol:{}});\nfunction mergeSettings(s){const d=DEF();s=s||{};\n  return {...d,...s,notif:{...d.notif,...(s.notif||{}),on:{...d.notif.on,...((s.notif||{}).on||{})}},relay:{...d.relay,...(s.relay||{})},gemini:{...d.gemini,...(s.gemini||{})},selectors:s.selectors||{},projects:Array.isArray(s.projects)?s.projects:[],fcol:s.fcol&&typeof s.fcol==='object'?s.fcol:{}}}\nlet accs=[],active=null,detectors=[],settings=DEF(),userCode=EXAMPLE,store={},ready=false;\nlet PRE='',setOpen=false,tab='gen';  // filesOpen : voir plus haut\nconst st={},LOG=[],H={},HAND=[];\nconst stOf=id=>st[id]??={gen:false,limited:false,logged:null,last:'',lastAt:0};\nconst pub=a=>a&&{id:a.id,platform:a.p,name:a.n};\nconst save=()=>{if(ready)api.stateSave(JSON.stringify({v:3,accs,active,detectors,settings,code:userCode,store}))};\nconst toast=t=>{const e=$('toast');e.textContent=t;e.classList.add('show');clearTimeout(toast._t);toast._t=setTimeout(()=>e.classList.remove('show'),3200)};\nconst find=x=>x==null?null:typeof x==='object'?accs.find(a=>a.id===x.id)||null:accs.find(a=>a.id===x)||accs.find(a=>a.n.toLowerCase()===String(x).toLowerCase())||accs.find(a=>(a.p+':'+a.n).toLowerCase()===String(x).toLowerCase())||(/^\\d+$/.test(x)?accs[+x-1]:null)||null;\n$('plat').innerHTML=Object.keys(P).map(k=>`<option>${k}</option>`).join('');\ndocument.querySelectorAll('[data-ic]').forEach(e=>e.insertAdjacentHTML('afterbegin',IC(e.dataset.ic)));\n\n// ---------- thème ----------\nconst mq=matchMedia('(prefers-color-scheme:dark)');\nconst effTheme=()=>{const t=settings.theme||'system';return t==='system'?(mq.matches?'dark':'light'):t};\nfunction applyTheme(animate){const t=settings.theme||'system',h=document.documentElement;\n  if(animate===true){h.classList.add('themeswap');clearTimeout(applyTheme._t);applyTheme._t=setTimeout(()=>h.classList.remove('themeswap'),480)}   // fondu doux entre clair et sombre\n  h.dataset.theme=t;h.dataset.eff=effTheme();\n  document.querySelectorAll('#theme button').forEach(b=>b.classList.toggle('on',b.dataset.th===t));try{api.setTheme(t)}catch{}}\nmq.addEventListener('change',()=>{if((settings.theme||'system')==='system')applyTheme(true)});\ndocument.querySelectorAll('#theme button').forEach(b=>b.onclick=()=>{settings.theme=b.dataset.th;save();applyTheme(true)});\n\n// ---------- 2.2.2 : sélecteur animé, bouton de thème, fichiers partagés ----------\nfunction fitSeg(s){let ind=s.querySelector(':scope>.ind');if(!ind){s.insertAdjacentHTML('afterbegin','<i class=\"ind\"></i>')}\n  const b=s.querySelector('button.on');if(!b||!b.offsetWidth)return;s.style.setProperty('--x',b.offsetLeft+'px');s.style.setProperty('--w',b.offsetWidth+'px')}\ndocument.querySelectorAll('.seg').forEach(s=>{fitSeg(s);const f=()=>requestAnimationFrame(()=>fitSeg(s));\n  new ResizeObserver(f).observe(s);new MutationObserver(f).observe(s,{subtree:true,attributes:true,attributeFilter:['class'],childList:true})});\n$('themebtn').innerHTML='<span class=\"tg\"><span class=\"sun\">'+IC('sun')+'</span><span class=\"moon\">'+IC('moon')+'</span></span>';\n$('themebtn').onclick=()=>{settings.theme=effTheme()==='dark'?'light':'dark';save();applyTheme(true)};\n\n// Bibliothèque de fichiers commune à tous les comptes (stockée localement dans l'appli, IndexedDB)\nconst FDB={db:null,\n  open(){return this.db||(this.db=new Promise((ok,ko)=>{const r=indexedDB.open('aihub-files',1);r.onupgradeneeded=()=>r.result.createObjectStore('files',{keyPath:'id'});r.onsuccess=()=>ok(r.result);r.onerror=()=>ko(r.error)}))},\n  async tx(mode,fn){const db=await this.open();return new Promise((ok,ko)=>{const t=db.transaction('files',mode);let r;try{r=fn(t.objectStore('files'))}catch(x){return ko(x)}\n    t.oncomplete=()=>ok(r&&r.result);t.onerror=()=>ko(t.error);t.onabort=()=>ko(t.error)})},\n  all(){return this.tx('readonly',s=>s.getAll())},put(f){return this.tx('readwrite',s=>s.put(f))},del(id){return this.tx('readwrite',s=>s.delete(id))}};\nlet FILES=[],fq='',fUrls=[];\nconst MAXF=100*1048576;\nconst fmtSize=n=>n<1024?n+' o':n<1048576?Math.round(n/1024)+' Ko':(n/1048576).toFixed(1).replace('.',',')+' Mo';\nconst extOf=n=>n.includes('.')?n.split('.').pop():'';\nconst kindOf=f=>{const e=extOf(f.name).toLowerCase(),t=f.type||'';\n  if(t.startsWith('image/'))return'image';if(e==='pdf')return'pdf';if(/^(docx?|odt|rtf)$/.test(e))return'doc';if(/^(xlsx?|csv|tsv|ods)$/.test(e))return'sheet';\n  if(/^(js|ts|jsx|tsx|py|java|c|cpp|cs|go|rs|rb|php|html|css|json|xml|ya?ml|sh|bat|sql|md)$/.test(e))return'code';if(/^(zip|rar|7z|tar|gz)$/.test(e))return'zip';return'txt'};\nasync function loadFiles(anim=true){try{FILES=(await FDB.all()||[]).sort((a,b)=>b.added-a.added)}catch{FILES=[]}drawFiles(anim)}\nfunction drawFiles(anim=true){applyFcol();\n  fUrls.forEach(u=>URL.revokeObjectURL(u));fUrls=[];\n  const q=fq.trim().toLowerCase(),list=FILES.filter(f=>(!q||f.name.toLowerCase().includes(q))&&(fproj==='all'||(fproj==='none'?!projOf(f):f.proj===fproj))).sort(sortP),tot=FILES.reduce((s,f)=>s+f.size,0),n=accs.length;\n  $('fsub').textContent=FILES.length?`${FILES.length} fichier${FILES.length>1?'s':''} · ${fmtSize(tot)} · disponibles sur ${n} compte${n>1?'s':''}`:'Ta bibliothèque est commune à tous tes comptes.';\n  $('fcount').textContent=FILES.length||'';\n  $('fempty').style.display=FILES.length?'none':'grid';\n  $('fgrid').classList.toggle('noanim',!anim);\n  $('fgrid').innerHTML=list.map((f,i)=>{const ik=iconKind(f);let top;\n    if(ik==='image'){const u=URL.createObjectURL(f.blob);fUrls.push(u);top=`<div class=\"fthumb\"><img src=\"${u}\" alt=\"\"></div>`}else top=fileTile(f);\n    const d=new Date(f.added).toLocaleDateString('fr-FR',{day:'numeric',month:'short'});\n    return `<div class=\"fcard\" style=\"--i:${i}\"><div class=\"frow\">${top}<div class=\"fbody\"><div class=\"fname\" title=\"${esc(f.name)}\">${esc(f.name)}</div><div class=\"fmeta\">${esc(fileLabel(f))}</div><div class=\"fmeta\">${fmtSize(f.size)} · ${d}</div>${projSel(f)}</div></div>\n      <div class=\"fact2\"><button class=\"btn sm\" data-att=\"${f.id}\">${IC('clip')}Joindre à…</button><button class=\"btn ghost sm ico\" data-dl=\"${f.id}\" title=\"Enregistrer sous\">${IC('dl')}</button><button class=\"btn ghost sm ico del\" data-rm=\"${f.id}\" title=\"Supprimer\">${IC('trash')}</button></div></div>`}).join('')\n    +(q&&!list.length?'<p class=\"dim\">Aucun fichier ne correspond.</p>':'')+(!q&&FILES.length&&!list.length?'<p class=\"dim\">Aucun fichier dans cette sélection : classe un fichier avec le menu « Sans projet » de sa carte.</p>':'');\n  drawProjs();pushMenu();\n}\nasync function addFiles(list){let ok=0,big=0;\n  for(const f of list){if(f.size>MAXF){big++;continue}\n    try{await FDB.put({id:'f'+Date.now().toString(36)+Math.random().toString(36).slice(2,6),name:f.name,type:f.type||'',size:f.size,added:Date.now(),proj:(fproj!=='all'&&fproj!=='none'?fproj:''),blob:f});ok++}catch{}}\n  await loadFiles();\n  toast(ok?`${ok} fichier${ok>1?'s ajoutés':' ajouté'} à la bibliothèque`+(big?` (${big} trop gros, 100 Mo max)`:''):big?'Fichier trop gros (100 Mo maximum)':'Impossible d\\'ajouter le fichier')}\nfunction openFMenu(btn,id){const m=$('fmenu');if(!accs.length)return toast('Ajoute d\\'abord un compte');\n  const by={};accs.forEach(a=>(by[a.p]??=[]).push(a));\n  m.innerHTML='<div class=\"mt\">Joindre à…</div>'+Object.keys(by).map(p=>by[p].map(a=>`<button data-acc=\"${a.id}\"><i class=\"dot\" style=\"background:${P[p][1]}\"></i><span>${esc(p)} · ${esc(a.n)}</span>${a.id===active?'<em>actif</em>':''}</button>`).join('')).join('');\n  m.dataset.file=id;m.hidden=false;\n  const r=btn.getBoundingClientRect();m.style.left=Math.max(12,Math.min(r.left,innerWidth-272))+'px';m.style.top=(r.bottom+6)+'px';\n  const h=m.offsetHeight;if(r.bottom+6+h>innerHeight-12)m.style.top=Math.max(12,r.top-h-6)+'px';\n  m.classList.remove('in');void m.offsetWidth;m.classList.add('in')}\nconst closeFMenu=()=>{$('fmenu').hidden=true};\ndocument.addEventListener('mousedown',e=>{if(!e.target.closest('#fmenu')&&!e.target.closest('[data-att]'))closeFMenu()});\ndocument.addEventListener('keydown',e=>{if(e.key==='Escape')closeFMenu()});\n$('fmenu').onclick=e=>{const b=e.target.closest('[data-acc]');if(!b)return;const id=$('fmenu').dataset.file;closeFMenu();attachFile(id,b.dataset.acc)};\n// Joint le fichier à la zone de message du compte choisi (champ d'envoi de fichier de la page, sinon collage dans la zone de saisie)\nasync function attachFile(fid,accId,o={}){const f=FILES.find(x=>x.id===fid),a=find(accId);if(!f||!a)return;\n  if(!o.stay){active=a.id;setOpen=false;filesOpen=false;save();render()}\n  const v=view(a);for(let i=0;i<60&&!v._ready;i++)await sleep(250);\n  if(!v._ready)return toast(`La page de ${a.p} n'est pas prête, réessaie dans un instant`);\n  if(f.size>25*1048576)toast('Gros fichier : le transfert peut prendre un moment…');\n  let b64;try{b64=await new Promise((ok,ko)=>{const r=new FileReader();r.onload=()=>ok(String(r.result).split(',')[1]||'');r.onerror=ko;r.readAsDataURL(f.blob)})}catch{return toast('Lecture du fichier impossible')}\n  const js=ATTACH_JS+'('+JSON.stringify(b64)+','+JSON.stringify(f.name)+','+JSON.stringify(f.type||'')+')';\n  try{const r=await v.executeJavaScript(js);\n    if(r!=='none'&&f.proj)addProjectContext(a,f.proj,f).catch(x=>toast('Contexte du projet non ajouté : '+String(x&&x.message||x).slice(0,60)));\n    toast(r==='none'?`Aucune zone de message trouvée sur ${a.p} : ouvre une conversation puis réessaie`:`Fichier transmis à ${a.p} · ${a.n}. Vérifie qu'il apparaît dans la zone de message.`)}\n  catch(x){toast('Impossible de joindre le fichier : '+String(x&&x.message||x).slice(0,80))}}\nconst ATTACH_JS=`(async(b64,name,type)=>{\n  const bin=atob(b64),u8=new Uint8Array(bin.length);for(let i=0;i<bin.length;i++)u8[i]=bin.charCodeAt(i);\n  const file=new File([u8],name,{type:type||'application/octet-stream'}),dt=new DataTransfer();dt.items.add(file);\n  const look=()=>({inp:[...document.querySelectorAll('input[type=file]')].find(i=>!i.disabled),box:document.querySelector('div[contenteditable=\"true\"],textarea,[role=textbox]')});\n  let t={};for(let i=0;i<32;i++){t=look();if(t.inp||t.box)break;await new Promise(r=>setTimeout(r,250))}\n  if(t.inp){t.inp.files=dt.files;t.inp.dispatchEvent(new Event('input',{bubbles:true}));t.inp.dispatchEvent(new Event('change',{bubbles:true}));return 'input'}\n  if(t.box){t.box.focus();t.box.dispatchEvent(new ClipboardEvent('paste',{clipboardData:dt,bubbles:true,cancelable:true}));return 'paste'}\n  return 'none'})`;\n$('fgrid').onclick=async e=>{const at=e.target.closest('[data-att]'),dl=e.target.closest('[data-dl]'),rm=e.target.closest('[data-rm]');\n  if(at)return openFMenu(at,at.dataset.att);\n  if(dl){const f=FILES.find(x=>x.id===dl.dataset.dl);if(!f)return;const a=document.createElement('a');a.href=URL.createObjectURL(f.blob);a.download=f.name;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),5000);return}\n  if(rm){const f=FILES.find(x=>x.id===rm.dataset.rm);if(!f||!confirm(`Supprimer « ${f.name} » de la bibliothèque ? (Les conversations où il a déjà été joint ne changent pas.)`))return;\n    await FDB.del(f.id);await loadFiles()}};\n$('filesbtn').onclick=()=>{filesOpen=!filesOpen;setOpen=false;render();if(filesOpen)loadFiles()};\nconst pickFiles=()=>$('fin').click();$('fadd').onclick=pickFiles;$('fadd2').onclick=pickFiles;\n$('fin').onchange=e=>{const l=[...e.target.files];e.target.value='';if(l.length)addFiles(l)};\n$('fq').oninput=e=>{fq=e.target.value;drawFiles(false)};\nlet dragN=0;const isFileDrag=e=>e.dataTransfer&&[...e.dataTransfer.types].includes('Files');\n$('files').addEventListener('dragenter',e=>{if(!isFileDrag(e))return;e.preventDefault();dragN++;$('fdrop').classList.add('on')});\n$('files').addEventListener('dragover',e=>{if(isFileDrag(e))e.preventDefault()});\n$('files').addEventListener('dragleave',()=>{dragN=Math.max(0,dragN-1);if(!dragN)$('fdrop').classList.remove('on')});\n$('files').addEventListener('drop',e=>{e.preventDefault();dragN=0;$('fdrop').classList.remove('on');if(e.dataTransfer.files.length)addFiles([...e.dataTransfer.files])});\ndocument.addEventListener('dragover',e=>e.preventDefault());document.addEventListener('drop',e=>e.preventDefault());   // jamais d'ouverture d'un fichier lâché à côté\n\n// ---------- 2.2.6 : icônes animées par type de fichier, couleurs personnalisables ----------\nconst FI_SVG=b=>`<svg class=\"fic\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">${b}</svg>`;\nconst PG='<path d=\"M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8Z\"/><path d=\"M14 3v5h5\"/>';\nconst FI={\n  web:{n:'HTML / web',t:'#F0629A',l:'Code',s:FI_SVG('<circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M3 12h18\"/><ellipse class=\"a\" cx=\"12\" cy=\"12\" rx=\"4.4\" ry=\"9\"/><ellipse class=\"b\" cx=\"12\" cy=\"12\" rx=\"4.4\" ry=\"9\"/>')},\n  vector:{n:'SVG',t:'#8B7CFF',l:'Image',s:FI_SVG('<rect x=\"3.5\" y=\"4\" width=\"17\" height=\"16\" rx=\"3\"/><circle class=\"a\" cx=\"9\" cy=\"9.5\" r=\"1.8\"/><path class=\"b\" pathLength=\"1\" d=\"m4 18 5-5 3.5 3.5 3-3L20 17\"/>')},\n  image:{n:'Images',t:'#4DA3FF',l:'Image',s:FI_SVG('<rect x=\"3.5\" y=\"4\" width=\"17\" height=\"16\" rx=\"3\"/><circle class=\"a\" cx=\"9\" cy=\"9.5\" r=\"1.8\"/><path class=\"b\" pathLength=\"1\" d=\"m4 18 5-5 3.5 3.5 3-3L20 17\"/>')},\n  braces:{n:'JSON / YAML / XML',t:'#F5A524',l:'Code',s:FI_SVG('<path class=\"a\" d=\"M9 4C6.5 4 7 7 7 9s-.5 3-3 3c2.5 0 3 1 3 3s-.5 5 2 5\"/><path class=\"b\" d=\"M15 4c2.5 0 2 3 2 5s.5 3 3 3c-2.5 0-3 1-3 3s.5 5-2 5\"/>')},\n  code:{n:'Code',t:'#2FC9A6',l:'Code',s:FI_SVG('<path class=\"a\" d=\"m8 7-5 5 5 5\"/><path class=\"b\" d=\"m16 7 5 5-5 5\"/><path class=\"c\" d=\"m13.5 5-3 14\"/>')},\n  zip:{n:'Archives',t:'#9C9AA6',l:'Archive',s:FI_SVG('<rect class=\"c\" x=\"9.8\" y=\"9\" width=\"4.4\" height=\"3.2\" rx=\".8\" fill=\"currentColor\" stroke=\"none\"/><path class=\"a\" d=\"M3.5 4.5h17v4h-17z\"/><path d=\"M5 8.5V18a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8.5\"/><path class=\"b\" d=\"M10 13.5h4\"/>')},\n  pdf:{n:'PDF',t:'#F0603F',l:'Document',s:FI_SVG(PG+'<path class=\"a\" pathLength=\"1\" d=\"M8.5 12.5h7\"/><path class=\"b\" pathLength=\"1\" d=\"M8.5 16h5\"/>')},\n  doc:{n:'Word / documents',t:'#5B8DEF',l:'Document',s:FI_SVG(PG+'<path class=\"a\" pathLength=\"1\" d=\"M8.5 12h7\"/><path class=\"b\" pathLength=\"1\" d=\"M8.5 15h7\"/><path class=\"c\" pathLength=\"1\" d=\"M8.5 18h4\"/>')},\n  sheet:{n:'Tableurs / CSV',t:'#3DBE7A',l:'Tableur',s:FI_SVG('<rect class=\"a\" x=\"10.2\" y=\"4.6\" width=\"9.6\" height=\"4.8\" rx=\".5\" fill=\"currentColor\" stroke=\"none\"/><rect class=\"b\" x=\"10.2\" y=\"10.6\" width=\"9.6\" height=\"3.8\" rx=\".5\" fill=\"currentColor\" stroke=\"none\"/><rect class=\"c\" x=\"10.2\" y=\"15.6\" width=\"9.6\" height=\"3.8\" rx=\".5\" fill=\"currentColor\" stroke=\"none\"/><rect x=\"3.5\" y=\"4\" width=\"17\" height=\"16\" rx=\"2.5\"/><path d=\"M3.5 10h17M3.5 15h17M9.5 4v16\"/>')},\n  txt:{n:'Texte / Markdown',t:'#E3B341',l:'Texte',s:FI_SVG('<path class=\"a\" pathLength=\"1\" d=\"M5 7h14\"/><path class=\"b\" pathLength=\"1\" d=\"M5 12h14\"/><path class=\"c\" pathLength=\"1\" d=\"M5 17h9\"/>')},\n  audio:{n:'Audio',t:'#2FC4C0',l:'Audio',s:FI_SVG('<path class=\"a\" d=\"M4.5 10v4\"/><path class=\"b\" d=\"M8.5 6v12\"/><path class=\"c\" d=\"M12.5 4v16\"/><path class=\"b\" d=\"M16.5 7.5v9\"/><path class=\"a\" d=\"M20.5 10.5v3\"/>')},\n  video:{n:'Vidéo',t:'#D55CE0',l:'Vidéo',s:FI_SVG('<rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"3\"/><circle class=\"b\" cx=\"12\" cy=\"12\" r=\"4.6\"/><path class=\"a\" d=\"m10.6 9.8 3.8 2.2-3.8 2.2Z\" fill=\"currentColor\"/>')},\n  file:{n:'Autres fichiers',t:'#A3A3B0',l:'Fichier',s:FI_SVG(PG.replace('<path d=\"M14 3v5h5\"/>','<path class=\"a\" d=\"M14 3v5h5\"/>')+'<path class=\"b\" pathLength=\"1\" d=\"M8.5 14h7\"/>')}\n};\nfunction iconKind(f){const e=extOf(f.name).toLowerCase(),t=f.type||'';\n  if(/^(html?|xhtml)$/.test(e))return'web';if(e==='svg')return'vector';\n  if(t.startsWith('image/')||/^(png|jpe?g|gif|webp|bmp|ico|avif|heic)$/.test(e))return'image';\n  if(/^(json|jsonc|json5|ya?ml|toml|xml)$/.test(e))return'braces';\n  if(/^(js|mjs|cjs|ts|jsx|tsx|py|java|c|h|cpp|hpp|cs|go|rs|rb|php|css|scss|sh|bat|ps1|sql|kt|swift|lua|gd|glsl|vue)$/.test(e))return'code';\n  if(/^(zip|rar|7z|tar|gz|tgz|bz2|xz|jar|apk)$/.test(e))return'zip';if(e==='pdf')return'pdf';\n  if(/^(docx?|odt|rtf|pages)$/.test(e))return'doc';if(/^(xlsx?|csv|tsv|ods|numbers)$/.test(e))return'sheet';\n  if(/^(txt|md|markdown|log|ini|cfg|rst)$/.test(e)||t.startsWith('text/'))return'txt';\n  if(t.startsWith('audio/')||/^(mp3|wav|ogg|flac|m4a|aac)$/.test(e))return'audio';\n  if(t.startsWith('video/')||/^(mp4|webm|mov|mkv|avi)$/.test(e))return'video';\n  return'file'}\n// Couleurs : par défaut celles de FI, remplaçables par type (settings.fcol), appliquées via des variables CSS\nconst fcolOf=ik=>{const c=(settings.fcol||{})[ik];return /^#[0-9a-f]{6}$/i.test(c||'')?c:FI[ik].t};\nfunction applyFcol(){for(const ik in FI)document.documentElement.style.setProperty('--fc-'+ik,fcolOf(ik))}\nconst fileTile=f=>{const ik=iconKind(f);return `<div class=\"ftile ik-${ik}\" style=\"--tint:var(--fc-${ik})\">${FI[ik].s}</div>`};\nconst fileLabel=f=>{const d=FI[iconKind(f)],e=(extOf(f.name)||'').toUpperCase();return d.l+(e?' · '+e.slice(0,5):'')};\nfunction drawFcols(){const el=$('ficols');if(!el)return;\n  el.innerHTML='<div class=\"fc-head\"><b>Couleurs des fichiers</b><button class=\"btn ghost sm\" id=\"fcreset\">Rétablir les couleurs d\\'origine</button></div><div class=\"fc-grid\">'\n    +Object.keys(FI).map(ik=>`<label class=\"fc-item\"><span class=\"ftile ik-${ik}\" style=\"--tint:var(--fc-${ik})\">${FI[ik].s}</span><span class=\"fc-n\">${esc(FI[ik].n)}</span><input type=\"color\" data-fc=\"${ik}\" value=\"${fcolOf(ik)}\"></label>`).join('')+'</div>'}\n$('ficols').addEventListener('input',e=>{const i=e.target.closest('[data-fc]');if(!i)return;\n  (settings.fcol??={})[i.dataset.fc]=i.value;applyFcol();clearTimeout(drawFcols._t);drawFcols._t=setTimeout(save,300)});\n$('ficols').addEventListener('click',e=>{if(!e.target.closest('#fcreset'))return;settings.fcol={};save();applyFcol();drawFcols()});\n$('fcolbtn').onclick=()=>{const el=$('ficols');el.hidden=!el.hidden;if(!el.hidden)drawFcols()};\n\n// ---------- 2.2.4 : projets (tri des fichiers) + bouton « Fichiers AI Hub » dans la barre de saisie de Claude ----------\nlet fproj='all';\nconst PJ=()=>settings.projects||(settings.projects=[]);\nconst projOf=f=>PJ().find(p=>p.id===f.proj)||null;\nconst pjIdx=f=>{const i=PJ().findIndex(p=>p.id===f.proj);return i<0?1e6:i};\nconst sortP=(a,b)=>fproj==='all'?(pjIdx(a)-pjIdx(b)||b.added-a.added):b.added-a.added;\nconst projSel=f=>`<select class=\"psel\" data-pj=\"${f.id}\" title=\"Projet de ce fichier\"><option value=\"\">Sans projet</option>${PJ().map(p=>`<option value=\"${p.id}\"${p.id===f.proj?' selected':''}>${esc(p.name)}</option>`).join('')}</select>`;\nfunction drawProjs(){const el=$('fprojs');if(!el)return;\n  const cnt=id=>FILES.filter(f=>id==='none'?!projOf(f):f.proj===id).length;\n  el.innerHTML=`<button class=\"chip ${fproj==='all'?'on':''}\" data-pf=\"all\">Tous<i>${FILES.length}</i></button><button class=\"chip ${fproj==='none'?'on':''}\" data-pf=\"none\">Sans projet<i>${cnt('none')}</i></button>`\n    +PJ().map(p=>`<button class=\"chip ${fproj===p.id?'on':''}\" data-pf=\"${p.id}\">${IC('folder')}${esc(p.name)}<i>${cnt(p.id)}</i></button>`).join('')\n    +`<button class=\"chip add\" data-pf=\"new\">${IC('plus')}Projet</button>`;\n  drawPEdit()}\nfunction drawPEdit(){const el=$('fpedit'),p=PJ().find(x=>x.id===fproj);\n  if(!p){el.hidden=true;el.innerHTML='';delete el.dataset.pid;return}\n  if(el.dataset.pid===p.id&&!el.hidden)return;           // ne pas écraser la saisie en cours\n  el.dataset.pid=p.id;el.hidden=false;\n  el.innerHTML=`<div class=\"pe-row\"><input id=\"pname\" value=\"${esc(p.name)}\" maxlength=\"60\" placeholder=\"Nom du projet\" autocomplete=\"off\"><button class=\"btn ghost sm del\" id=\"pdel\">${IC('trash')}Supprimer le projet</button></div>\n    <textarea id=\"pdesc\" rows=\"3\" placeholder=\"Décris le projet en quelques mots (facultatif) : à quoi servent ces fichiers ? Cela améliore le résumé donné à Claude.\">${esc(p.desc||'')}</textarea>\n    <div class=\"pe-row\"><button class=\"btn sm\" id=\"psumb\">${IC('refresh')}Générer le résumé</button><span class=\"dim\" id=\"pstat\"></span></div><pre id=\"psum\"></pre>`;\n  showSum(p)}\nfunction showSum(p){const s=$('psum');if(!s)return;s.textContent=p.sum||'Pas encore de résumé : il est créé automatiquement la première fois que tu joins un fichier de ce projet (Gemini si ta clé est enregistrée, sinon un résumé par mots-clés).';\n  $('pstat').textContent=p.sum?'Source : '+p.how:''}\n$('fprojs').onclick=e=>{const b=e.target.closest('[data-pf]');if(!b)return;\n  if(b.dataset.pf==='new'){const p={id:'p'+Date.now().toString(36),name:'Nouveau projet',desc:''};PJ().push(p);fproj=p.id;save();drawFiles(false);setTimeout(()=>{const i=$('pname');if(i){i.focus();i.select()}},60);return}\n  fproj=b.dataset.pf;drawFiles(false)};\n$('fpedit').addEventListener('change',e=>{const p=PJ().find(x=>x.id===fproj);if(!p)return;\n  if(e.target.id==='pname'){p.name=e.target.value.trim()||'Projet';e.target.value=p.name;save();drawFiles(false)}\n  if(e.target.id==='pdesc'){p.desc=e.target.value;save()}});\n$('fpedit').addEventListener('click',async e=>{const p=PJ().find(x=>x.id===fproj);if(!p)return;\n  if(e.target.closest('#pdel')){if(!confirm(`Supprimer le projet « ${p.name} » ? Ses fichiers restent dans la bibliothèque (sans projet).`))return;\n    for(const f of FILES.filter(x=>x.proj===p.id))try{await FDB.put({...f,proj:''})}catch{}\n    settings.projects=PJ().filter(x=>x.id!==p.id);fproj='all';save();await loadFiles(false);return}\n  if(e.target.closest('#psumb')){$('pstat').textContent='Génération…';try{await projSummary(p,true)}catch{}showSum(p)}});\n$('fgrid').addEventListener('change',async e=>{const s=e.target.closest('select[data-pj]');if(!s)return;\n  const f=FILES.find(x=>x.id===s.dataset.pj);if(!f)return;\n  try{await FDB.put({...f,proj:s.value})}catch{return toast('Impossible de changer le projet')}\n  await loadFiles(false)});\n\n// Résumé d'un projet : Gemini si une clé est enregistrée, sinon repli par mots-clés. Mis en cache tant que les fichiers ne changent pas.\nconst STOPW=new Set('avec dans pour that this from have with います les des une est sur par pas plus comme mais vous nous leur ils elles cette ces aux the and for are was not you your but can will var let const function return true false null undefined import export class else then when what which about into over html json text file name type data'.split(' '));\nasync function sampleOf(f){const k=kindOf(f),e=extOf(f.name).toLowerCase();\n  if(f.size>3*1048576||!(k==='code'||k==='txt'||/^(csv|tsv|md|txt|log|ini|cfg|toml)$/.test(e)))return '';\n  try{return (await f.blob.slice(0,6000).text()).replace(/\\0/g,'').slice(0,5000)}catch{return ''}}\nfunction keywordsOf(texts,n=12){const c={};\n  for(const t of texts)for(const w of (String(t).toLowerCase().match(/[a-zà-ÿ][a-zà-ÿ0-9_]{3,}/g)||[]))if(!STOPW.has(w))c[w]=(c[w]||0)+1;\n  return Object.entries(c).sort((a,b)=>b[1]-a[1]).slice(0,n).map(x=>x[0])}\nfunction fallbackProj(p,fl,samples){\n  const kinds={};fl.forEach(f=>{const k=kindOf(f);kinds[k]=(kinds[k]||0)+1});\n  const kw=keywordsOf(fl.map(f=>f.name.replace(/[._-]/g,' ')).concat(samples,[p.desc||'',p.name]));\n  return (p.desc&&p.desc.trim()?p.desc.trim()+'\\n':'')+`Projet « ${p.name} » : ${fl.length} fichier${fl.length>1?'s':''}`+(Object.keys(kinds).length?' ('+Object.entries(kinds).map(([k,n])=>n+' '+k).join(', ')+')':'')+'.\\n'\n    +'Fichiers : '+fl.slice(0,25).map(f=>f.name).join(', ')+(fl.length>25?'…':'')+'.'+(kw.length?'\\nMots-clés : '+kw.join(', ')+'.':'')}\nasync function projSummary(p,force){\n  const fl=FILES.filter(f=>f.proj===p.id),g=settings.gemini||{},sig=(p.desc||'')+'|'+p.name+'|'+fl.map(f=>f.id+':'+f.size).sort().join(',')+'|'+(g.key?'g':'k');\n  if(!force&&p.sum&&p.sig===sig)return {text:p.sum,how:p.how};\n  const samples=[];let tot=0;\n  for(const f of fl){if(tot>24000)break;const s=await sampleOf(f);if(s){samples.push(s);tot+=s.length}}\n  let text='',how='';\n  if(g.key){toast('Résumé du projet « '+p.name+' » par Gemini…');\n    const prompt=`Résume en 120 mots maximum, en français, ce projet pour qu'une IA comprenne de quoi il s'agit quand elle reçoit l'un de ses fichiers. Dis à quoi sert le projet et le rôle probable de chaque fichier. N'invente rien : si tu ne sais pas, dis-le.\\nNom du projet : ${p.name}\\nDescription de l'utilisateur : ${p.desc||'aucune'}\\nFichiers : ${fl.map(f=>f.name+' ('+fmtSize(f.size)+')').join(', ')||'aucun'}\\n`\n      +(samples.length?'\\nExtraits de fichiers texte :\\n'+samples.map((s,i)=>'--- extrait '+(i+1)+' ---\\n'+s).join('\\n'):'');\n    try{const r=await api.gemini({key:g.key,model:g.model||GEM,system:'Tu écris des résumés de projet courts, fidèles et factuels.',prompt});\n      if(r&&r.ok&&r.text){text=String(r.text).trim();how='Gemini'}else LOG.unshift({ts:Date.now(),acc:'code',type:'summary-error',detail:'résumé de projet : '+((r&&r.error)||'échec')})}\n    catch(x){LOG.unshift({ts:Date.now(),acc:'code',type:'summary-error',detail:String(x&&x.message||x)})}}\n  if(!text){text=fallbackProj(p,fl,samples);how='mots-clés'}\n  p.sum=text;p.sig=sig;p.how=how;save();return {text,how}}\n\n// Texte ajouté dans la zone de message quand on joint un fichier d'un projet : Claude sait d'où il vient.\nconst ANN={};\nasync function addProjectContext(a,pid,f){\n  const p=PJ().find(x=>x.id===pid);if(!p)return;\n  await sleep(700);\n  const v=view(a);let url='';try{url=v.getURL()}catch{}\n  const chat=/\\/(chat|c)\\/[\\w-]{8,}/.test(url),key=a.id+'|'+pid;\n  let txt;\n  if(chat&&ANN[key]===url)txt=`[Projet « ${p.name} »${f?' · fichier joint : '+f.name:''}]\\n\\n`;\n  else{const s=await projSummary(p);\n    txt=`[CONTEXTE DU PROJET « ${p.name} »]\\n${s.text}\\n`+(f?`\\nFichier joint maintenant : ${f.name} (il fait partie de ce projet).\\n`:'')+`\\n`;\n    if(chat)ANN[key]=url}\n  await hub.paste(txt,{account:a.id});\n  toast(f?`Fichier et contexte du projet « ${p.name} » ajoutés`:`Contexte du projet « ${p.name} » ajouté`)}\nfunction pushMenu(only){\n  const d={projects:PJ().map(p=>({id:p.id,name:p.name})),files:FILES.map(f=>({id:f.id,name:f.name,size:f.size,proj:projOf(f)?f.proj:'',k:kindOf(f)}))};\n  document.querySelectorAll('webview').forEach(v=>{if(only&&v!==only)return;\n    const a=accs.find(x=>x.id===v.dataset.id);if(!a||a.p!=='Claude'||!v._ready)return;try{v.send('hub:menu',d)}catch{}})}\nasync function onMenuPick(a,p){\n  if(!p)return;\n  if(p.fid)return attachFile(p.fid,a.id,{stay:true});\n  if(p.pid)return addProjectContext(a,p.pid,null)}\n\n\n// ---------- notifications ----------\n// Le système (Windows) n'affiche une notification que si l'utilisateur a autorisé AI Hub ici ; sinon, simple bulle dans l'app.\nfunction ping(type,title,body,accId,o={}){\n  const N=settings.notif;if(type!=='script'&&N.on[type]===false)return;\n  const focused=document.hasFocus();\n  if(focused||o.toast)toast(title+(body?' — '+body:''));\n  if(!focused&&N.enabled===true)api.notify(title,body||'',accId||null).catch(()=>{});\n}\nfunction drawNotif(){\n  const N=settings.notif,on=N.enabled===true;\n  $('nstate').textContent=on?'Autorisées':N.enabled===false?'Refusées':'Pas encore demandé';\n  $('nstate').className='pill '+(on?'ok':N.enabled===false?'no':'');\n  $('nauth').textContent=on?'Désactiver':'Autoriser les notifications';\n  $('nauth').classList.toggle('pri',!on);$('ntest').disabled=!on;\n  $('nhint').textContent=on?'Si rien ne s\\'affiche : Paramètres Windows > Système > Notifications > AI Hub, et vérifie que le mode « Ne pas déranger » est désactivé.':'Les notifications ne s\\'affichent que lorsque la fenêtre AI Hub n\\'est pas au premier plan.';\n  document.querySelectorAll('[data-n]').forEach(el=>{el.checked=N.on[el.dataset.n]!==false;el.closest('.opt').classList.toggle('off',!on)});\n}\nasync function testNotif(){const r=await api.notify('AI Hub','Les notifications fonctionnent.',null);\n  if(!r.ok)toast('Notifications non prises en charge par ce système.');return r.ok}\nasync function setNotif(v){settings.notif.enabled=v;save();drawNotif();if(v){const ok=await testNotif();if(!ok){settings.notif.enabled=false;save();drawNotif()}}}\n$('nauth').onclick=()=>setNotif(settings.notif.enabled!==true);\n$('ntest').onclick=testNotif;\ndocument.querySelectorAll('[data-n]').forEach(el=>el.onchange=()=>{settings.notif.on[el.dataset.n]=el.checked;save()});\n$('nyes').onclick=()=>{$('dlgN').close();setNotif(true)};\n$('nno').onclick=()=>{$('dlgN').close();setNotif(false)};\n$('nlater').onclick=()=>$('dlgN').close();\napi.onNotifClick(id=>{if(id&&find(id)){active=id;setOpen=false;filesOpen=false;save();render()}});\n\n// ---------- vues (une par compte) ----------\nconst cfg=p=>({idle:120,sel:(settings.selectors||{})[p]||{},detectors:settings.devMode?detectors.map(d=>({...d,host:d.site&&d.site!=='*'&&P[d.site]?new URL(P[d.site][0]).hostname:'*'})):[]});\nconst pushCfg=()=>document.querySelectorAll('webview').forEach(v=>{const a=find(v.dataset.id);if(a)try{v.send('hub:config',cfg(a.p))}catch{}});\n\nfunction view(a){\n  let v=document.querySelector(`webview[data-id=\"${a.id}\"]`);\n  if(!v){v=document.createElement('webview');v.dataset.id=a.id;\n    v.setAttribute('partition','persist:'+a.id);v.setAttribute('useragent',UA);v.setAttribute('allowpopups','');v.setAttribute('preload',PRE);\n    v.addEventListener('ipc-message',e=>{if(e.channel==='hub-event')handle(a,e.args[0]);else if(e.channel==='hub-attach-open')pushMenu(v);else if(e.channel==='hub-attach-pick')onMenuPick(a,e.args[0]).catch(x=>toast('Impossible de joindre : '+String(x&&x.message||x).slice(0,80)))});\n    v.addEventListener('did-start-loading',()=>{v._ld=true;bar()});v.addEventListener('did-stop-loading',()=>{v._ld=false;bar()});\n    v.addEventListener('dom-ready',()=>{v._ready=true;try{v.send('hub:config',cfg(a.p))}catch{}pushMenu(v)});\n    v.src=P[a.p][0];$('views').appendChild(v);}\n  return v;\n}\nconst bar=()=>{const v=document.querySelector(`webview[data-id=\"${active}\"]`);$('bar').classList.toggle('on',!!(v&&v._ld&&!setOpen&&!filesOpen))};\n\nfunction handle(a,ev){\n  const s=stOf(a.id),t=ev.type;\n  if(t==='page-start'){s.limited=false;s.gen=false;s.logged=null;return renderList()}\n  if(t==='response-started')s.gen=true;if(t==='response-complete')s.gen=false;\n  if(t==='limit-hit')s.limited=true;if(t==='limit-cleared')s.limited=false;\n  if(t==='logged-in')s.logged=true;if(t==='login-required')s.logged=false;\n  s.last=t;s.lastAt=ev.ts;\n  LOG.unshift({ts:ev.ts,acc:a.p+' · '+a.n,type:t,detail:ev.detail,url:ev.url});if(LOG.length>500)LOG.pop();\n  const e={...ev,account:pub(a)};\n  (H[t]||[]).concat(H['*']||[]).forEach(fn=>run(fn,e));          // scripts perso (vide si le mode développeur est désactivé)\n  if(t==='limit-hit')onLimit(a);\n  else if(t==='response-complete')onDone(a,ev);\n  else if(t==='session-expired')ping('logout','Compte déconnecté',a.p+' · '+a.n,a.id);\n  renderList();if(setOpen&&tab==='log')drawLog();\n}\nconst codeErr=x=>{LOG.unshift({ts:Date.now(),acc:'code',type:'code-error',detail:String(x&&x.message||x)});$('cst').textContent='Erreur : '+String(x&&x.message||x)};\nconst run=async(fn,e)=>{try{await fn(e)}catch(x){codeErr(x)}};\nfunction onDone(a,ev){\n  if(a.id===active&&!setOpen&&document.hasFocus())return;          // tu regardes déjà ce compte\n  const d=ev.detail||{};if((d.chars||0)<20)return;\n  ping('done',a.p+' · '+a.n+' a répondu',(d.preview||'').replace(/\\s+/g,' ').slice(0,110),a.id);\n}\n\n// ---------- liste des comptes ----------\nconst badges=s=>(s.gen?'<i class=\"spin\" title=\"L\\'IA répond\"></i>':'')+(s.limited?`<em class=\"bd err\" title=\"Limite atteinte\">${IC('ban')}</em>`:'')+(s.logged===false?`<em class=\"bd\" title=\"Déconnecté\">${IC('lock')}</em>`:'')+(s.degraded?`<em class=\"bd warn\" title=\"Conversation non reconnue : sélecteurs à vérifier (Paramètres > Reprise)\">${IC('warn')}</em>`:'');\nfunction renderList(){\n  const by={};accs.forEach(a=>(by[a.p]??=[]).push(a));\n  $('list').innerHTML=Object.keys(by).map(p=>`<div class=\"grp ${entG(p)}\">${esc(p)}</div>`+by[p].map((a,i)=>{const s=stOf(a.id);\n    return `<div class=\"acc ${a.id===active&&!setOpen&&!filesOpen?'on':''} ${entA(a.id)}\" style=\"--i:${i}\" data-id=\"${a.id}\"><i class=\"dot\" style=\"background:${P[p][1]}\"></i><span>${esc(a.n)}</span>${badges(s)}<b data-ren=\"${a.id}\" title=\"Renommer\">${IC('edit')}</b><b data-del=\"${a.id}\" title=\"Supprimer\">${IC('x')}</b></div>`}).join('')).join('');\n}\nfunction render(){\n  renderList();if(!PRE)return;\n  if(settings.preloadAll)accs.forEach(view);\n  document.querySelectorAll('webview').forEach(v=>v.classList.toggle('on',v.dataset.id===active));\n  const a=find(active);\n  $('title').textContent=filesOpen?'Fichiers':setOpen?'Paramètres':a?`${a.p} · ${a.n}`:'Aucun compte sélectionné';\n  $('empty').style.display=a?'none':'grid';\n  document.querySelector('.hbtns').style.visibility=(setOpen||filesOpen||!a)?'hidden':'visible';\n  $('set').classList.toggle('on',setOpen&&!filesOpen);$('files').classList.toggle('on',filesOpen);$('filesbtn').classList.toggle('on',filesOpen);\n  if(a)view(a).classList.add('on');\n  bar();\n}\n$('list').onclick=async e=>{\n  const rn=e.target.closest('[data-ren]'),d=e.target.closest('[data-del]');\n  if(rn){renId=rn.dataset.ren;$('rname').value=find(renId).n;$('dlg2').showModal();$('rname').focus();return}\n  if(d){const id=d.dataset.del,a=find(id);if(!confirm(`Supprimer ${a.p} · ${a.n} et sa session ?`))return;\n    document.querySelector(`webview[data-id=\"${id}\"]`)?.remove();await api.clear('persist:'+id);delete st[id];\n    accs=accs.filter(x=>x.id!==id);if(active===id)active=accs[0]?.id||null;save();return render();}\n  const r=e.target.closest('.acc');if(r){active=r.dataset.id;setOpen=false;filesOpen=false;save();render();}\n};\nconst openAdd=()=>{$('name').value='';$('dlg').showModal();$('name').focus()};\n$('add').onclick=openAdd;$('add2').onclick=openAdd;\n$('cancel').onclick=()=>$('dlg').close();\n$('ok').onclick=()=>{const n=$('name').value.trim();if(!n)return $('name').focus();\n  const a={id:'a'+Date.now(),p:$('plat').value,n};accs.push(a);active=a.id;setOpen=false;filesOpen=false;save();$('dlg').close();render();};\n$('name').onkeydown=e=>{if(e.key==='Enter')$('ok').click()};\n$('reload').onclick=()=>hub.reload();\n\n// ---------- lecture des conversations ----------\n// Sélecteurs d'origine (alignés sur webview-preload.js) + sélecteurs de secours de Paramètres > Reprise\nconst SELB={user:'[data-testid=\"user-message\"],user-query,[data-message-author-role=\"user\"]',ai:'.font-claude-response,model-response,[data-message-author-role]:not([data-message-author-role=\"user\"])',comp:COMPOSER,stop:'[data-testid=\"stop-button\"],button[aria-label*=\"Stop\" i],button[aria-label*=\"Arrêter\" i],button[aria-label*=\"Interrompre\" i]',send:'[data-testid=\"send-button\"],button[aria-label*=\"Send\" i],button[aria-label*=\"Envoyer\" i]'};\nconst selOf=(p,k)=>{const x=((settings.selectors||{})[p]||{})[k];return x&&x.trim()?SELB[k]+','+x.trim():SELB[k]};\nconst isChatUrl=u=>{try{return /\\/(chat|c|chats|app|thread|search|s)\\/[\\w-]{8,}/.test(new URL(u).pathname)}catch{return false}};\n// Une conversation est « reconnue » dès qu'on trouve au moins UN de tes messages (la limite peut empêcher toute réponse de l'IA)\nconst EXTRACT=a=>`(()=>{const ok=s=>{try{document.querySelector(s);return true}catch{return false}};\nconst U=${JSON.stringify(selOf(a.p,'user'))},A=${JSON.stringify(selOf(a.p,'ai'))};\nconst UU=ok(U)?U:${JSON.stringify(SELB.user)},AA=ok(A)?A:${JSON.stringify(SELB.ai)};\nconst els=[...document.querySelectorAll(UU+','+AA)];\nconst top=els.filter(e=>!els.some(o=>o!==e&&o.contains(e)));\nconst out=top.map(e=>({r:e.matches(UU)?'user':'ai',t:e.innerText.trim()})).filter(m=>m.t);\nif(out.some(m=>m.r==='user'))return {mode:'structured',msgs:out,url:location.href};\nconst m=document.querySelector('main')||document.body;\nreturn {mode:'raw',msgs:[{r:'raw',t:(m.innerText||'').trim()}],url:location.href};})()`;\nasync function read(a){\n  const r=await view(a).executeJavaScript(EXTRACT(a)),s=stOf(a.id);\n  if(r.mode==='raw'&&r.msgs[0]&&r.msgs[0].t&&isChatUrl(r.url)){        // page de conversation mais messages non reconnus\n    if(!s.degraded)LOG.unshift({ts:Date.now(),acc:a.p+' · '+a.n,type:'selector-warning',detail:'messages non reconnus : texte brut utilisé. Ajoute des sélecteurs de secours (Paramètres > Reprise).'});\n    s.degraded=true;renderList()}\n  else if(r.mode==='structured'&&s.degraded){s.degraded=false;renderList()}\n  return r}\n\n// ---------- construction du message de reprise ----------\nconst fmt=m=>(m.r==='user'?'👤 Moi : ':'🤖 IA : ')+m.t;\n// Garde le début (objectif) + la fin ; supprime des messages entiers au milieu\nfunction fit(msgs,max){\n  const all=msgs.map(fmt),size=s=>s.length+2;\n  if(all.reduce((n,s)=>n+size(s),0)<=max)return {text:all.join('\\n\\n'),cut:0};\n  const head=all[0].slice(0,Math.min(4000,Math.floor(max*.15)));\n  let budget=max-head.length-80,i=all.length-1;const tail=[];\n  while(i>0&&budget>200){const s=all[i];\n    if(size(s)<=budget){tail.unshift(s);budget-=size(s);i--}\n    else{tail.unshift('[…début du message tronqué…] '+s.slice(-(budget-40)));budget=0;i--;break}}\n  return {text:head+'\\n\\n[…'+i+' message(s) intermédiaire(s) omis…]\\n\\n'+tail.join('\\n\\n'),cut:i};\n}\nconst fitTail=(msgs,max)=>{const out=[];let n=0;for(let i=msgs.length-1;i>=0;i--){const s=fmt(msgs[i]);if(n+s.length>max&&out.length)break;out.unshift(n+s.length>max?s.slice(-max):s);n+=s.length}return {text:out.join('\\n\\n')}};\nconst TPL_CONTINUE=`[REPRISE AUTOMATIQUE] Cette conversation vient d'un autre compte {plateforme} ({compte}) qui a atteint sa limite. Tu es le relais : tu reprends le travail exactement là où il en est, sans perte.\n\n{contexte}\n\n## INSTRUCTIONS\n1. Ne dis pas bonjour, ne résume pas ce que je viens de te donner et ne repose pas de question dont la réponse figure déjà plus haut. Travaille directement.\n2. {suite}\n3. Réponds de façon concise et directe, dans le même registre et la même langue que la conversation.\n4. Si une information dont tu as besoin manque dans ce transfert, dis-le en une phrase au lieu de l'inventer.`;\nconst TPL_READY=`[CONTEXTE : conversation exportée depuis {plateforme}]\nVoici l'historique d'une conversation précédente. Lis-le en entier, retiens le contexte, réponds seulement « Prêt », puis continue la discussion à partir de là.\n\n{contexte}\n`;\nconst fill=(tpl,v)=>tpl.replace(/\\{(\\w+)\\}/g,(m,k)=>v[k]??m);\nconst ctxFull=(msgs,max)=>{const f=fit(msgs,max);return {ctx:'## CONVERSATION'+(f.cut?` (${f.cut} messages intermédiaires omis)`:'')+'\\n--- DÉBUT ---\\n'+f.text+'\\n--- FIN ---',how:f.cut?'tronqué':'complet'}};\nasync function buildHandoff(src,conv,o){\n  const R=settings.relay,msgs=conv.msgs.filter(m=>m.t);let ctx='',how='';\n  if(conv.mode==='raw'){ctx='## CONVERSATION (texte brut de la page)\\n--- DÉBUT ---\\n'+msgs[0].t.slice(-R.maxChars)+'\\n--- FIN ---';how='texte brut'}\n  else{\n    const full=msgs.map(fmt).join('\\n\\n');\n    if((o.summary??R.summary)&&hub.aiEnabled&&full.length>R.summaryAbove){\n      toast('Résumé de la conversation par Gemini…');\n      const sum=await hub.summarize(full,{platform:src.p});\n      if(sum){ctx='## RÉSUMÉ DE LA CONVERSATION\\n'+sum+'\\n\\n## FIN DE LA CONVERSATION (telle quelle)\\n'+fitTail(msgs,Math.min(8000,Math.floor(R.maxChars/4))).text;how='résumé'}\n    }\n    if(!ctx){const c=ctxFull(msgs,R.maxChars);ctx=c.ctx;how=c.how}\n  }\n  const last=msgs[msgs.length-1];\n  const suite=last&&last.r==='user'?'Ma dernière demande n\\'a pas reçu de réponse : réponds-y maintenant.'\n    :stOf(src.id).gen?'Ta dernière réponse a été interrompue par la limite : reprends-la exactement là où elle s\\'arrête, sans la recommencer.'\n    :'Continue la tâche en cours dans la logique de la fin de la conversation, avec la prochaine étape concrète. Si rien n\\'est en attente, dis-le en une ligne et attends ma prochaine demande.';\n  const tpl=R.custom&&R.custom.trim()?R.custom:R.tpl==='ready'?TPL_READY:TPL_CONTINUE;\n  const text=fill(tpl,{plateforme:src.p,compte:src.n,contexte:ctx,suite,date:new Date().toLocaleString()});\n  return {text,how,chars:text.length};\n}\n// Texte copié par le bouton « Copier la conversation » (modèle « Prêt », sans résumé)\nasync function exportPack(a){\n  const conv=await read(a);\n  if(conv.mode==='raw'&&(!isChatUrl(conv.url)||!conv.msgs[0]||!conv.msgs[0].t))return null;\n  const msgs=conv.msgs.filter(m=>m.t);if(!msgs.length)return null;\n  const body=conv.mode==='raw'?'--- DÉBUT ---\\n'+msgs[0].t.slice(-settings.relay.maxChars)+'\\n--- FIN ---':ctxFull(msgs,settings.relay.maxChars).ctx;\n  return {mode:conv.mode,n:msgs.length,txt:fill(TPL_READY,{plateforme:a.p,contexte:body})};\n}\n$('export').onclick=async()=>{\n  const a=find(active);if(!a)return toast('Sélectionne un compte d\\'abord');\n  try{const r=await exportPack(a);if(!r)return toast('Aucune conversation trouvée sur cette page');\n    await api.copy(r.txt);toast(r.mode==='raw'?'Copié : texte brut de la page (format du site non reconnu)':`Copié : ${r.n} messages. Colle-le ailleurs !`);\n  }catch(e){toast('Export impossible : '+e.message)}\n};\n\n// ---------- reprise sur un autre compte ----------\nlet HQ=Promise.resolve(),LASTANY=0;const LASTH={};\nconst enqueue=f=>{const p=HQ.then(f);HQ=p.catch(x=>hlog('fail',null,String(x&&x.message||x)));return p};   // une reprise à la fois\nconst hlog=(type,src,detail)=>LOG.unshift({ts:Date.now(),acc:src?src.p+' · '+src.n:'app',type:'handoff-'+type,detail});\nconst pickTarget=(src,visited=[])=>accs.find(x=>x.id!==src.id&&!visited.includes(x.id)&&!stOf(x.id).limited&&stOf(x.id).logged!==false&&(!settings.relay.samePlatform||x.p===src.p))||null;\nconst okSel=(a,k)=>{try{document.createDocumentFragment().querySelector(selOf(a.p,k));return selOf(a.p,k)}catch{return SELB[k]}};\n// Attend que la zone de saisie soit visible (page chargée). Renvoie true, 'login' ou false.\nasync function waitComposer(a,ms){\n  const v=view(a),t0=Date.now(),C=JSON.stringify(okSel(a,'comp'));\n  while(Date.now()-t0<ms){\n    try{const r=await v.executeJavaScript(`(()=>({c:[...document.querySelectorAll(${C})].some(e=>e.getClientRects().length>0),pw:!!document.querySelector('input[type=password]')}))()`);\n      if(r.c)return true;if(r.pw&&Date.now()-t0>4000)return 'login'}catch{}\n    await sleep(500)}\n  return false}\nfunction onLimit(a){\n  const R=settings.relay,dst=R.enabled?pickTarget(a):null;\n  if(!dst){ping('limit','Limite atteinte',a.p+' · '+a.n+(R.enabled?' — aucun autre compte disponible':''),a.id,{toast:true});return}\n  if(R.mode==='ask'){ping('limit','Limite atteinte sur '+a.p+' · '+a.n,'Ouvre AI Hub pour reprendre sur '+dst.n,a.id);return askBanner(a,dst)}\n  enqueue(()=>handoff(a.id,{to:dst.id,auto:true}));\n}\nfunction askBanner(src,dst){const b=$('ask');b.hidden=false;b.dataset.src=src.id;b.dataset.dst=dst.id;\n  $('asktxt').innerHTML=`Limite atteinte sur <b>${esc(src.p)} · ${esc(src.n)}</b>. Reprendre la conversation sur <b>${esc(dst.p)} · ${esc(dst.n)}</b> ?`}\n$('askyes').onclick=()=>{const b=$('ask');b.hidden=true;enqueue(()=>handoff(b.dataset.src,{to:b.dataset.dst}))};\n$('askno').onclick=()=>{$('ask').hidden=true};\n\nasync function handoff(fromId,o={}){\n  const R=settings.relay,src=find(fromId||active),now=Date.now();\n  const fail=(msg,silent)=>{hlog('fail',src,msg);HAND.unshift({ts:now,from:src,ok:false,err:msg});\n    if(silent)ping('limit','Limite atteinte',src.p+' · '+src.n,src.id,{toast:true});else ping('handoff','Reprise impossible',msg,src&&src.id,{toast:true});return {ok:false,error:msg}};\n  if(!src)return {ok:false,error:'compte introuvable'};\n  // garde-fous contre les boucles et les doublons (limit-hit se redéclenche à chaque rechargement de page)\n  if(o.auto&&(now-(LASTH[src.id]||0)<300000||now-LASTANY<20000)){hlog('skip',src,'reprise récente : ignorée');return {ok:false,error:'reprise récente'}}\n  let dst=o.to?find(o.to):pickTarget(src);\n  if(!dst)return fail('aucun autre compte disponible'+(R.samePlatform?' sur '+src.p:''));\n  let conv;try{conv=await read(src)}catch(e){return fail('lecture impossible : '+e.message)}\n  const text0=conv.msgs[0]&&conv.msgs[0].t;\n  if(conv.mode==='raw'){\n    if(!text0||!isChatUrl(conv.url))return fail('aucune conversation à reprendre sur '+src.p+' · '+src.n,o.auto);\n    if(o.auto)return fail('conversation non reconnue sur '+src.n+' (sélecteurs à vérifier) : reprise annulée');\n    if(!confirm('Le format de la conversation n\\'est pas reconnu : AI Hub transmettrait le texte brut de la page (avec des éléments d\\'interface). Continuer ?'))return {ok:false,cancelled:true};\n  }\n  const built=await buildHandoff(src,conv,o),visited=[src.id];\n  for(let i=0;i<accs.length&&dst;i++){\n    toast('Reprise : '+src.n+' → '+dst.n+'…');\n    hub.switchTo(dst);await hub.newChat(dst);\n    const w=await waitComposer(dst,25000);\n    if(w===true)await sleep(1500);   // la limite peut s'afficher juste après le chargement\n    if(w!==true||stOf(dst.id).limited||stOf(dst.id).logged===false){\n      hlog('skip',dst,w==='login'||stOf(dst.id).logged===false?'déconnecté':w?'limite atteinte':'page non prête');\n      visited.push(dst.id);dst=o.strict?null:pickTarget(src,visited);continue}\n    let r=await hub.paste(built.text,{account:dst,send:false});\n    if(!r.len){await sleep(1200);r=await hub.paste(built.text,{account:dst,send:false})}\n    if(!r.len){await api.copy(built.text);return fail('collage impossible sur '+dst.n+' : le message est copié dans le presse-papiers (Ctrl+V)')}\n    const send=o.send??R.send;if(send){await sleep(500);await hub.send(dst.id)}\n    LASTH[src.id]=Date.now();LASTANY=Date.now();\n    HAND.unshift({ts:Date.now(),from:src,to:dst,how:built.how,chars:built.chars,sent:!!send,ok:true});if(HAND.length>20)HAND.pop();\n    hlog('ok',src,{to:dst.p+' · '+dst.n,mode:built.how,chars:built.chars,sent:!!send});\n    ping('handoff','Reprise sur '+dst.p+' · '+dst.n,send?'Message envoyé ('+built.how+').':'Message prêt dans la zone de saisie : relis-le et valide.',dst.id,{toast:true});\n    if(setOpen&&tab==='rel')drawRel();\n    return {ok:true,to:pub(dst),mode:built.how,chars:built.chars,n:conv.msgs.length};\n  }\n  return fail('aucun compte disponible : '+(accs.length>1?'tous sont limités, déconnectés ou non prêts':'ajoute un autre compte'));\n}\n// fenêtre « Reprendre ailleurs » (manuel)\n$('handoff').onclick=()=>{const a=find(active);if(!a)return toast('Sélectionne un compte d\\'abord');\n  const others=accs.filter(x=>x.id!==a.id);if(!others.length)return toast('Ajoute un autre compte pour reprendre la conversation.');\n  const sorted=[...others].sort((x,y)=>(x.p===a.p?0:1)-(y.p===a.p?0:1)||(stOf(x.id).limited?1:0)-(stOf(y.id).limited?1:0));\n  $('hsrc').textContent='Depuis '+a.p+' · '+a.n;\n  $('hto').innerHTML=sorted.map(x=>`<option value=\"${x.id}\">${esc(x.p)} · ${esc(x.n)}${stOf(x.id).limited?' (limite atteinte)':''}${stOf(x.id).logged===false?' (déconnecté)':''}</option>`).join('');\n  $('hmode').value=settings.relay.summary&&hub.aiEnabled?'sum':'full';$('hsend').checked=!!settings.relay.send;\n  $('dlgH').dataset.src=a.id;$('dlgH').showModal()};\n$('hcancel').onclick=()=>$('dlgH').close();\n$('hok').onclick=()=>{const d=$('dlgH');d.close();\n  enqueue(()=>handoff(d.dataset.src,{to:$('hto').value,strict:true,send:$('hsend').checked,summary:$('hmode').value==='sum'})).then(r=>{if(!r.ok&&!r.cancelled&&r.error&&!/^reprise récente/.test(r.error))toast('Reprise impossible : '+r.error)}).catch(x=>toast('Reprise impossible : '+(x&&x.message||x)))};\n\n// ---------- API pour ton code (mode développeur) ----------\nconst hub={\n  get accounts(){return accs.map(pub)},get active(){return pub(find(active))},\n  state:id=>st[(find(id||active)||{}).id],\n  switchTo(x){const a=find(x);if(!a)return null;active=a.id;setOpen=false;filesOpen=false;save();render();return pub(a)},\n  available(o={}){const f=find(o.from||active);return pub(accs.find(a=>a.id!==(f&&f.id)&&!stOf(a.id).limited&&(!o.samePlatform||a.p===(f&&f.p))))||null},\n  next(o={}){const n=accs.length,i=accs.findIndex(a=>a.id===active),d=o.dir||1,cur=find(active);\n    for(let k=1;k<=n;k++){const a=accs[(((i+k*d)%n)+n)%n];\n      if(a.id!==active&&(o.skipLimited===false||!stOf(a.id).limited)&&(!o.samePlatform||a.p===cur?.p))return hub.switchTo(a)}return null},\n  async getConversation(x){const a=find(x||active);const r=a&&await exportPack(a);return r&&r.txt},\n  async exportConversation(x){const t=await hub.getConversation(x);if(t){await api.copy(t);toast('Conversation copiée')}return t},\n  async newChat(x){const a=find(x||active),v=view(a);\n    if(!v._ready)await Promise.race([new Promise(r=>v.addEventListener('dom-ready',r,{once:true})),sleep(15000)]);\n    v.loadURL(P[a.p][0]);await new Promise(r=>{v.addEventListener('did-stop-loading',r,{once:true});setTimeout(r,15000)})},\n  async paste(text,o={}){const a=find(o.account||active),v=view(a),C=JSON.stringify(okSel(a,'comp'));\n    if(!v._ready)await Promise.race([new Promise(r=>v.addEventListener('dom-ready',r,{once:true})),sleep(15000)]);\n    const pick=`(()=>{const l=[...document.querySelectorAll(${C})];return l.find(e=>e.getClientRects().length>0)||l[0]||document.querySelector(${JSON.stringify(COMPOSER)})})()`;\n    await v.executeJavaScript(`(()=>{const c=${pick};if(c)c.focus()})()`);\n    await sleep(250);v.insertText(text);await sleep(300);\n    const len=await v.executeJavaScript(`(()=>{const c=${pick};return c?(c.value||c.innerText||'').trim().length:0})()`);\n    if(o.send){await sleep(600);await hub.send(a.id)}\n    return {len}},\n  async send(x){const v=view(find(x||active));await sleep(100);\n    v.sendInputEvent({type:'keyDown',keyCode:'Enter'});v.sendInputEvent({type:'char',keyCode:'\\r'});v.sendInputEvent({type:'keyUp',keyCode:'Enter'})},\n  async getMessages(x){const a=find(x||active);if(!a)return null;const r=await read(a);\n    return r.msgs[0]&&r.msgs[0].t?{mode:r.mode,msgs:r.msgs.map(m=>({r:m.r,t:m.t}))}:null},\n  async health(x){const a=find(x||active);if(!a)return null;const v=view(a);\n    const r=await v.executeJavaScript(`(()=>{const q=s=>{try{return document.querySelectorAll(s).length}catch{return -1}};\n      let c;try{c=document.querySelector(${JSON.stringify(selOf(a.p,'comp'))})}catch{}\n      return {url:location.href,composer:q(${JSON.stringify(selOf(a.p,'comp'))}),user:q(${JSON.stringify(selOf(a.p,'user'))}),ai:q(${JSON.stringify(selOf(a.p,'ai'))}),stop:q(${JSON.stringify(selOf(a.p,'stop'))}),send:q(${JSON.stringify(selOf(a.p,'send'))}),composerLen:c?(c.value||c.innerText||'').trim().length:0}})()`);\n    return {...r,account:pub(a),mode:r.user>0&&r.ai>0?'structured':r.user+r.ai>0?'partial':'none'}},\n  get aiEnabled(){return !!(settings.gemini&&settings.gemini.key)},\n  // Résumé par Gemini ; renvoie null (jamais d'exception) si pas de clé ou en cas d'échec\n  async summarize(text,o={}){\n    const g=settings.gemini||{};if(!g.key)return null;\n    const body=String(text).slice(-(o.max||350000));\n    const sys='Tu prépares le transfert d\\'une conversation vers un autre compte de la même IA. Tu produis un résumé fidèle, dense et directement exploitable. Tu n\\'inventes rien : si une information est absente, tu écris « aucun ».';\n    const prompt=`Voici une conversation entre un utilisateur et une IA (${o.platform||'IA'}). Écris le résumé dans la langue de la conversation, en Markdown, 700 mots maximum, avec exactement ces sections :\n## Objectif et contexte\n## Où on en est (fait / en cours)\n## Décisions, contraintes et préférences de l'utilisateur (formats, style, ce qui a été refusé)\n## Éléments techniques précis (noms de fichiers, fonctions, valeurs, versions : garde les identifiants exacts ; ne recopie pas de longs blocs de code, décris leur rôle)\n## Problèmes ouverts et erreurs\n## Prochaine étape (la dernière demande de l'utilisateur, et si la dernière réponse de l'IA est terminée ou semble coupée)\n${o.extra?o.extra+'\\n':''}\n=== CONVERSATION ===\n${body}\n=== FIN ===`;\n    try{const r=await api.gemini({key:g.key,model:g.model||GEM,system:sys,prompt});\n      if(!r.ok){LOG.unshift({ts:Date.now(),acc:'code',type:'summary-error',detail:r.error});return null}\n      return r.text}\n    catch(e){LOG.unshift({ts:Date.now(),acc:'code',type:'summary-error',detail:String(e&&e.message||e)});return null}},\n  handoff:(from,o)=>enqueue(()=>handoff(from,{...o,auto:false})),\n  async continueOn(t,o={}){const r=await hub.handoff(o.from||active,{to:t,send:o.send});if(!r.ok)throw new Error(r.error);return r.n},   // ancien nom, conservé\n  runInPage:(js,x)=>view(find(x||active)).executeJavaScript(js),\n  reload(x){const a=find(x||active);if(a)view(a).reload()},\n  notify(m,o={}){toast(m);if(settings.notif.enabled===true&&!document.hasFocus())api.notify(o.title||'AI Hub',String(m),null).catch(()=>{})},\n  copy:t=>api.copy(t),\n  log(...a){LOG.unshift({ts:Date.now(),acc:'code',type:'log',detail:a.join(' ')})},\n  setLimited(x,v=true){const a=find(x);if(a){stOf(a.id).limited=!!v;renderList()}},\n  rename(x,n){const a=find(x);if(a){a.n=String(n);save();renderList()}},\n  store:{get:k=>store[k]??null,set:(k,v)=>{store[k]=v;save()}}\n};\nfunction loadCode(){\n  for(const k in H)delete H[k];\n  if(!settings.devMode)return 'désactivé';\n  const on=(t,fn)=>{(H[t]??=[]).push(fn);return()=>{H[t]=H[t].filter(f=>f!==fn)}};\n  const once=(t,fn)=>{const off=on(t,e=>{off();return fn(e)});return off};\n  try{new Function('hub','on','once','sleep',`return (async()=>{${userCode}\\n})()`)(hub,on,once,sleep).catch(codeErr);return'ok'}\n  catch(x){codeErr(x);return'Erreur : '+x.message}\n}\n\n// ---------- paramètres ----------\nfunction selectTab(t){tab=t;\n  document.querySelectorAll('.snav button').forEach(x=>x.classList.toggle('on',x.dataset.t===t));\n  document.querySelectorAll('.pane').forEach(p=>p.classList.toggle('on',p.id==='p-'+t));\n  if(t==='log')drawLog();if(t==='upd')drawUpd();if(t==='rel')drawRel();if(t==='gen')drawNotif()}\ndocument.querySelectorAll('.snav button').forEach(b=>b.onclick=()=>selectTab(b.dataset.t));\n$('gear').onclick=()=>{setOpen=!setOpen;filesOpen=false;render();if(setOpen)selectTab(tab)};\n$('preall').onchange=e=>{settings.preloadAll=e.target.checked;save();render()};\n\n// mode développeur : sans lui, aucun script perso ni détection perso n'est exécuté\nfunction applyDev(){\n  document.body.classList.toggle('dev',!!settings.devMode);$('dev').checked=!!settings.devMode;\n  const r=loadCode();$('cst').textContent=settings.devMode?(r==='ok'?'Code activé ✔':r):'';\n  if(!settings.devMode&&['code','det','log'].includes(tab)&&setOpen)selectTab('gen');pushCfg()}\n$('dev').onchange=e=>{\n  if(e.target.checked&&!confirm('Le mode développeur exécute du code JavaScript avec un accès complet à tes comptes (conversations, sessions). N\\'active jamais un script dont tu ne comprends pas le contenu, surtout s\\'il vient d\\'un fichier importé.\\n\\nActiver le mode développeur ?')){e.target.checked=false;return}\n  settings.devMode=e.target.checked;save();applyDev();toast(settings.devMode?'Mode développeur activé':'Mode développeur désactivé : les scripts ne s\\'exécutent plus')};\n$('savecode').onclick=()=>{userCode=$('code').value;save();const r=loadCode();$('cst').textContent=r==='ok'?'Code activé ✔':r};\n$('resetcode').onclick=()=>{$('code').value=EXAMPLE};\n$('evlist').innerHTML=EVENTS.map(([n,d])=>`<code>${n}</code><span>${d}</span>`).join('');\n\n// réglages de la reprise\ndocument.querySelectorAll('[data-r]').forEach(el=>el.onchange=()=>{const k=el.dataset.r;\n  settings.relay[k]=el.type==='checkbox'?el.checked:el.type==='number'?Math.min(300000,Math.max(5000,+el.value||60000)):el.value;\n  if(el.type==='number')el.value=settings.relay[k];save()});\nconst tm=t=>new Date(t).toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'});\nfunction drawRel(){\n  document.querySelectorAll('[data-r]').forEach(el=>{const v=settings.relay[el.dataset.r];if(el.type==='checkbox')el.checked=!!v;else el.value=v??''});\n  $('sumnote').textContent=hub.aiEnabled?'Au-delà de 15 000 caractères : résumé + derniers échanges au texte exact.':'Pas de clé Gemini : la conversation est transmise en entier (tronquée si trop longue). Ajoute une clé ci-dessous.';\n  $('hlist').textContent=HAND.length?HAND.slice(0,8).map(h=>h.ok?`${tm(h.ts)}  ${h.from.p} · ${h.from.n} → ${h.to.p} · ${h.to.n}  (${h.how}, ${h.chars} car.${h.sent?', envoyé':''})`:`${tm(h.ts)}  ${h.from?h.from.n:'?'}  ✘ ${h.err}`).join('\\n'):'Aucune reprise pour l\\'instant.'}\n\n// ---------- export / import de comptes ----------\n$('exp').onclick=async()=>{\n  const r=await api.exportAll({state:{accs,active,detectors,settings,code:userCode,store},partitions:accs.map(a=>'persist:'+a.id),pass:$('pass').value});\n  $('msg').textContent=r.ok?`Exporté ${r.encrypted?'(chiffré)':'(NON chiffré, mets un mot de passe)'} : ${r.path}`:'Annulé'};\n$('imp').onclick=async()=>{\n  let r;try{r=await api.importAll($('pass').value)}catch(e){return $('msg').textContent='Fichier illisible : '+e.message}\n  if(!r.ok)return $('msg').textContent=r.error||'Annulé';\n  const s=r.state||{};(s.accs||[]).forEach(x=>{if(!accs.some(a=>a.id===x.id))accs.push(x)});\n  if(!active)active=s.active||null;\n  if(s.detectors&&s.detectors.length&&!detectors.length)detectors=s.detectors;\n  // le code importé est gardé mais ne s'exécute que si TU actives le mode développeur ; on ne remplace pas ton code sans demander\n  if(s.code&&s.code!==userCode&&!isOldExample(s.code)&&confirm('Le fichier contient du code personnalisé. Le remplacer par le tien ? (Il ne s\\'exécutera que si le mode développeur est activé.)'))userCode=s.code;\n  if(s.settings){const m=mergeSettings(s.settings);\n    settings.selectors={...m.selectors,...settings.selectors};\n    if(!settings.gemini.key&&m.gemini.key)settings.gemini=m.gemini;\n    settings.relay={...m.relay,...settings.relay};}                   // devMode et notifications ne sont jamais importés\n  store={...(s.store||{}),...store};\n  save();$('msg').textContent=`Importé : ${(s.accs||[]).length} comptes, ${r.cookies} cookies`+(r.version&&r.version!==r.current?` (fichier créé avec la version ${r.version}, la tienne est ${r.current} : vérifie que tout est là)`:'')+'. Redémarrage…';setTimeout(()=>location.reload(),r.version&&r.version!==r.current?4000:900)};\n\n// ---------- détections personnalisées + journal ----------\nfunction drawDet(){\n  $('dets').innerHTML=detectors.map((d,i)=>`<div class=\"row2\"><input data-i=\"${i}\" data-k=\"name\" value=\"${esc(d.name)}\" placeholder=\"nom de l'événement\"><select data-i=\"${i}\" data-k=\"kind\"><option value=\"selector\"${d.kind==='selector'?' selected':''}>Sélecteur CSS</option><option value=\"text\"${d.kind==='text'?' selected':''}>Texte (regex)</option></select><input data-i=\"${i}\" data-k=\"value\" value=\"${esc(d.value)}\" placeholder=\"ex. .banner-limit  ou  quota épuisé\"><select data-i=\"${i}\" data-k=\"site\"><option value=\"*\">Tous les sites</option>${Object.keys(P).map(k=>`<option${d.site===k?' selected':''}>${k}</option>`).join('')}</select><button class=\"btn\" data-rm=\"${i}\">${IC('x')}</button></div>`).join('')}\n$('dets').oninput=e=>{const{i,k}=e.target.dataset;if(k)detectors[i][k]=e.target.value};\n$('dets').onclick=e=>{const b=e.target.closest('[data-rm]');if(b){detectors.splice(+b.dataset.rm,1);drawDet()}};\n$('adddet').onclick=()=>{detectors.push({name:'mon-evenement',kind:'text',value:'',site:'*'});drawDet()};\n$('savedet').onclick=()=>{save();pushCfg();toast('Détections enregistrées')};\nfunction drawLog(){\n  const f=$('lf').value.toLowerCase();\n  $('logst').innerHTML=accs.map(a=>{const s=stOf(a.id);return `<div>${esc(a.p)} · ${esc(a.n)} : ${s.gen?'répond':'au repos'}${s.limited?' · limite':''}${s.logged===false?' · déconnecté':''} · dernier événement : ${esc(s.last||'aucun')}</div>`}).join('')||'Aucun compte.';\n  $('logl').textContent=LOG.filter(l=>!f||(l.type+l.acc+JSON.stringify(l.detail||'')).toLowerCase().includes(f)).slice(0,200)\n    .map(l=>`${new Date(l.ts).toLocaleTimeString()}  ${l.acc}  ${l.type}  ${l.detail?JSON.stringify(l.detail).slice(0,150):''}`).join('\\n')||'Aucun événement pour l\\'instant.'}\n$('lf').oninput=drawLog;$('logclr').onclick=()=>{LOG.length=0;drawLog()};\n$('logcp').onclick=()=>{api.copy(JSON.stringify(LOG,null,1));toast('Journal copié')};\n\n// ---------- récupération + renommage ----------\nlet renId=null;\n$('rcancel').onclick=()=>$('dlg2').close();\n$('rok').onclick=()=>{const n=$('rname').value.trim();if(n&&renId){find(renId).n=n;save();renderList();if(!setOpen)render()}$('dlg2').close()};\n$('rname').onkeydown=e=>{if(e.key==='Enter')$('rok').click()};\nconst guess=ds=>{for(const k of Object.keys(P)){if(k==='Gemini')continue;const h=new URL(P[k][0]).hostname;if(ds.some(d=>d.includes('.')&&h.endsWith(d)&&!/google\\.com$/.test(d)))return k}\n  return ds.some(d=>/google\\.com$/.test(d))?'Gemini':null};\nasync function recover(auto){\n  let n=0;\n  for(const o of await api.orphans(accs.map(a=>a.id))){const p=guess(o.domains);if(!p)continue;\n    accs.push({id:o.id,p,n:`${p} récupéré ${accs.filter(a=>a.p===p).length+1}`});n++}\n  if(n){save();toast(`${n} compte(s) retrouvé(s) : renomme-les avec le crayon`)}else if(!auto)toast('Aucun compte perdu à retrouver');\n  return n}\n$('recover').onclick=async()=>{await recover(false);render()};\n$('opendata').onclick=()=>api.openData();\n\n// ---------- Gemini ----------\n$('gkey').onchange=()=>{settings.gemini.key=$('gkey').value.trim();save();drawRel();$('gmsg').textContent=settings.gemini.key?'Clé enregistrée.':'Clé supprimée : la conversation sera transmise en entier.'};\n$('gmodel').onchange=()=>{settings.gemini.model=$('gmodel').value.trim()||GEM;$('gmodel').value=settings.gemini.model;save()};\n$('gtest').onclick=async()=>{\n  settings.gemini.key=$('gkey').value.trim();settings.gemini.model=$('gmodel').value.trim()||GEM;save();drawRel();\n  if(!settings.gemini.key)return $('gmsg').textContent='Entre une clé d\\'abord.';\n  $('gmsg').textContent='Test en cours…';\n  const r=await api.gemini({key:settings.gemini.key,model:settings.gemini.model,prompt:'Réponds uniquement par le mot OK.'});\n  $('gmsg').textContent=r.ok?'✔ Gemini répond ('+settings.gemini.model+').':'✘ '+r.error+(r.status===404?' — essaie un autre nom de modèle (ex. gemini-3.5-flash).':'')};\n\n// ---------- sélecteurs de secours + diagnostic ----------\nconst SELK=['user','ai','comp','stop','send'];\n$('selplat').innerHTML=Object.keys(P).map(k=>`<option>${k}</option>`).join('');\nfunction fillSel(){const c=(settings.selectors||{})[$('selplat').value]||{};SELK.forEach(k=>$('sel-'+k).value=c[k]||'')}\n$('selplat').onchange=fillSel;\n$('selsave').onclick=()=>{const c={};SELK.forEach(k=>{const v=$('sel-'+k).value.trim();if(v)c[k]=v});\n  settings.selectors[$('selplat').value]=c;save();pushCfg();Object.values(st).forEach(x=>x.degraded=false);toast('Sélecteurs enregistrés pour '+$('selplat').value)};\n$('diag').onclick=async()=>{\n  const o=$('diagout');o.style.display='block';o.textContent='Analyse…';const lines=[];\n  for(const a of accs){\n    if(!document.querySelector(`webview[data-id=\"${a.id}\"]`)){lines.push(`${a.p} · ${a.n} : non chargé (clique dessus ou active « Garder tous les comptes chargés »)`);continue}\n    try{const h=await hub.health(a.id);\n      lines.push(`${h.composer>0?'✔':'✘'} ${a.p} · ${a.n} : saisie ${h.composer}, tes messages ${h.user}, réponses IA ${h.ai}, stop ${h.stop}, envoyer ${h.send} → ${h.mode==='structured'?'conversation lue':h.mode==='partial'?'lecture partielle ⚠':h.user+h.ai===0?'aucun message à lire (normal sur un nouveau chat)':'à vérifier ⚠'}`)}\n    catch(e){lines.push(`✘ ${a.p} · ${a.n} : ${e.message}`)}}\n  o.textContent=lines.join('\\n')||'Aucun compte.'};\n\n// ---------- mises à jour ----------\nconst dt=t=>t?new Date(t).toLocaleString():'';\nasync function drawUpd(){\n  const i=await api.updInfo();\n  $('upinfo').innerHTML=`Lanceur : <b>${esc(i.launcherVersion)}</b> · version active : <b>${esc(i.active==='bundled'?'d\\'origine ('+i.launcherVersion+')':i.active)}</b>`\n    +(i.pending?` · <span class=\"warn\">en essai (pas encore confirmée)</span>`:'')+(i.rolledBack?`<br><span class=\"warn\">Une mise à jour a été annulée automatiquement : ${esc(i.rolledBack)}</span>`:'');\n  $('upvers').textContent=i.versions.length?i.versions.map(v=>`${v.version}${v.version===i.current?'  (active)':v.version===i.previous?'  (précédente)':''}${v.ok?'':'  ⚠ fichiers invalides'}${i.bad.includes(v.version)?'  ✘ annulée':''}  ${v.notes?'— '+v.notes:''}`).join('\\n'):'Aucune mise à jour installée : version d\\'origine.';\n  $('uphist').textContent=i.history.map(h=>`${dt(h.ts)}  ${h.action}  ${h.version}  ${h.detail||''}`).join('\\n')||'—'}\n$('upapply').onclick=async()=>{\n  const r=await api.updApply();if(r.cancelled)return;\n  if(!r.ok){$('upmsg').textContent='✘ '+r.error;return}\n  $('upmsg').textContent=`✔ Version ${r.version} installée${r.notes?' : '+r.notes:''}.`;drawUpd();\n  if(confirm(`Version ${r.version} installée. Redémarrer maintenant pour l'essayer ?\\n(Si elle ne démarre pas correctement, l'app revient toute seule à la version précédente.)`))api.relaunch()};\nconst revert=async to=>{const r=await api.updRevert(to);if(!r.ok){$('upmsg').textContent='✘ '+r.error;return}\n  $('upmsg').textContent='Retour à '+(r.version==='bundled'?'la version d\\'origine':r.version)+'. Redémarrage…';setTimeout(()=>api.relaunch(),600)};\n$('uprev').onclick=()=>revert('previous');\n$('uporig').onclick=()=>{if(confirm('Revenir à la version d\\'origine fournie avec l\\'exe ? (tes comptes et ton code sont conservés)'))revert('bundled')};\n\n// ---------- démarrage ----------\n// Santé : l'app confirme qu'elle fonctionne ; sinon, retour arrière automatique (si une mise à jour est en essai)\nasync function init(){\n  let s=await api.stateLoad();\n  if(!s)s={accs:LS('accs',[]),active:localStorage.act||null,detectors:LS('det',[]),settings:LS('set',{}),code:localStorage.code||EXAMPLE,store:{}};\n  const upgraded=!s.v||s.v<3;\n  accs=s.accs||[];active=s.active||null;detectors=s.detectors||[];settings=mergeSettings(s.settings);\n  userCode=s.code||EXAMPLE;store=s.store||{};\n  let migrated=false;\n  if(isOldExample(userCode))userCode=EXAMPLE;                                     // ancien exemple non modifié : remplacé\n  else if(upgraded&&userCode.trim()&&userCode!==EXAMPLE&&!settings.devMode)migrated=true; // ton code est conservé, mais désactivé tant que le mode développeur est coupé\n  $('preall').checked=!!settings.preloadAll;$('code').value=userCode;$('gkey').value=settings.gemini.key;$('gmodel').value=settings.gemini.model;\n  fillSel();drawDet();applyTheme();drawNotif();drawRel();loadFiles();\n  PRE=await api.wvpreload();ready=true;\n  await recover(true);\n  if(!find(active))active=accs[0]?.id||null;\n  save();render();applyDev();\n  api.updInfo().then(i=>{if(i.rolledBack){toast('Mise à jour annulée automatiquement : '+i.rolledBack);LOG.unshift({ts:Date.now(),acc:'app',type:'update-rollback',detail:i.rolledBack})}}).catch(()=>{});\n  setTimeout(()=>{window.__healthy=true;api.updHealthy()},3000);\n  if(migrated)setTimeout(()=>toast('Tes scripts sont conservés dans Paramètres > Général > Mode développeur (désactivé). La reprise sur un autre compte est maintenant intégrée.'),2400);\n  setTimeout(()=>{if(settings.notif.enabled===null&&!$('dlgH').open&&!$('dlg').open)$('dlgN').showModal()},3200);   // demande d'autorisation des notifications\n}\nconst T0=performance.now();\ninit().catch(e=>{toast('Erreur au démarrage : '+e.message);api.updFail(e.message)}).finally(()=>setTimeout(()=>{$('splash').classList.add('out');setTimeout(()=>$('splash').remove(),600)},Math.max(0,1700-(performance.now()-T0))));\n</script></body></html>\n"}}}