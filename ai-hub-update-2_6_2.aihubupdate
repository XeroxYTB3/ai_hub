{"app": "ai-hub-update", "format": 1, "version": "2.6.2", "notes": "Ctrl+V colle une capture d'écran (ou toute image copiée) dans la barre de chat : elle apparaît en pastille et part avec le message, même sans texte. Les images collées sont rangées dans la bibliothèque avec l'étiquette « capture ». Paquet complet cumulatif.", "createdAt": "2026-10-07T19:18:39.000Z", "requiresLauncher": null, "files": {"main-core.js": {"sha256": "a0946fd0b6dd3984a137c1d69394d559bd5ade44ae98006329f9417f0045efa0", "content": "const { app, BrowserWindow, ipcMain, session, clipboard, dialog, Notification, shell, nativeTheme } = require('electron');\nconst path = require('path'), fs = require('fs'), crypto = require('crypto');\nconst { pathToFileURL } = require('url');\n\nmodule.exports = function start(ctx) {\nlet win;\n// (Le dossier de données fixe est défini par le lanceur main.js)\nconst ud = () => app.getPath('userData');\nconst STATE = () => path.join(ud(), 'ai-hub-state.json');\nconst BK = () => path.join(ud(), 'backups');\nlet lastBk = 0;\n\n// Thème enregistré (lu avant d'ouvrir la fenêtre pour éviter un flash blanc/noir au démarrage)\nconst BG = { dark: '#262624', light: '#FAF9F5' };\nfunction savedTheme() { try { const t = JSON.parse(fs.readFileSync(STATE(), 'utf8')).settings.theme; return ['light', 'dark'].includes(t) ? t : 'system'; } catch { return 'system'; } }\nif (process.platform === 'win32') { try { app.setAppUserModelId('com.aihub.app'); } catch {} }   // nécessaire pour les notifications Windows\n\n// Retire le drapeau « automatisé » de Chromium (une des choses que regarde la page de connexion Google)\ntry { app.commandLine.appendSwitch('disable-blink-features', 'AutomationControlled'); } catch {}\n\n// Les sites ne peuvent pas envoyer leurs propres notifications ni demander la position : AI Hub centralise les notifications\nconst DENY = new Set(['notifications', 'geolocation', 'midi', 'midiSysex']);\napp.on('session-created', (s) => {\n  try {\n    s.setPermissionRequestHandler((_wc, perm, cb) => cb(!DENY.has(perm)));\n    s.setPermissionCheckHandler((_wc, perm) => !DENY.has(perm));\n  } catch {}\n});\n\n// Connexion Google (\"ce navigateur ou cette application ne sont peut-être pas sécurisés\") : on retire toute trace d'Electron\n// de l'identité du navigateur, dans les en-têtes réseau (User-Agent + sec-ch-ua) ET dans les fenêtres de connexion (popups).\nconst CHROME_FULL = process.versions.chrome || '130.0.0.0', CHROME_MAJOR = CHROME_FULL.split('.')[0];\nconst cleanUA = (ua) => String(ua || '').replace(/\\s?Electron\\/\\S+/, '').replace(/\\s?ai-hub\\/\\S+/, '').replace(/\\s?AI Hub\\/\\S+/i, '');\n// Client Hints d'un vrai Google Chrome (Electron n'annonce que « Chromium » + « Electron », ce que Google refuse)\nconst CH_BRANDS = '\"Chromium\";v=\"' + CHROME_MAJOR + '\", \"Google Chrome\";v=\"' + CHROME_MAJOR + '\", \"Not?A_Brand\";v=\"99\"';\nconst CH_FULL = '\"Chromium\";v=\"' + CHROME_FULL + '\", \"Google Chrome\";v=\"' + CHROME_FULL + '\", \"Not?A_Brand\";v=\"99.0.0.0\"';\nconst GOOGLE_HOST = /(^|\\.)(google\\.[a-z.]+|gstatic\\.com|googleapis\\.com|googleusercontent\\.com|youtube\\.com)$/i;\napp.on('session-created', (s) => {\n  try {\n    s.setUserAgent(cleanUA(s.getUserAgent()));\n    s.webRequest.onBeforeSendHeaders((d, cb) => {\n      const h = d.requestHeaders; let host = ''; try { host = new URL(d.url).hostname; } catch {}\n      let hasCh = false, hasFull = false;\n      for (const k of Object.keys(h)) {\n        if (/^user-agent$/i.test(k)) h[k] = cleanUA(h[k]);\n        else if (/^sec-ch-ua$/i.test(k)) { h[k] = CH_BRANDS; hasCh = true; }\n        else if (/^sec-ch-ua-full-version-list$/i.test(k)) { h[k] = CH_FULL; hasFull = true; }\n      }\n      if (GOOGLE_HOST.test(host) && /^https:/i.test(d.url)) { if (!hasCh) h['sec-ch-ua'] = CH_BRANDS; if (!hasFull) h['sec-ch-ua-full-version-list'] = CH_FULL; }\n      cb({ requestHeaders: h });\n    });\n  } catch {}\n});\napp.on('web-contents-created', (_e, wc) => { try { wc.setUserAgent(cleanUA(wc.getUserAgent())); } catch {} });\n\nfunction create() {\n  nativeTheme.themeSource = savedTheme();\n  win = new BrowserWindow({\n    width: 1440, height: 900, backgroundColor: nativeTheme.shouldUseDarkColors ? BG.dark : BG.light, autoHideMenuBar: true,\n    icon: fs.existsSync(path.join(__dirname, 'icon.ico')) ? path.join(__dirname, 'icon.ico') : undefined,\n    webPreferences: { preload: path.join(__dirname, 'preload.js'), webviewTag: true, contextIsolation: true }\n  });\n  win.loadFile(path.join(__dirname, 'index.html'));\n  nativeTheme.on('updated', () => { try { win.setBackgroundColor(nativeTheme.shouldUseDarkColors ? BG.dark : BG.light); } catch {} });\n  win.webContents.on('render-process-gone', (_e, d) => { ctx.fatal('interface plantée : ' + (d && d.reason)); });\n}\n\n// ---------- 2.4.0 : détection par le réseau + historique local des conversations ----------\nconst NET_HOSTS = /(^|\\.)(claude\\.ai|chatgpt\\.com|openai\\.com|gemini\\.google\\.com)$/;\nconst COMPLETION = /\\/(completion|backend-api\\/(f\\/)?conversation|StreamGenerate)(\\/|$)/i;\napp.on('session-created', (s) => {\n  try {\n    s.webRequest.onCompleted((d) => {\n      try {\n        if (!win || win.isDestroyed() || !d.webContentsId) return;\n        const u = new URL(d.url);\n        if (!NET_HOSTS.test(u.hostname)) return;\n        const isComp = d.method === 'POST' && COMPLETION.test(u.pathname);\n        const bad = [429, 503, 529].includes(d.statusCode) && (isComp || /\\/(api|backend-api)\\//.test(u.pathname));\n        if (!isComp && !bad) return;\n        const h = d.responseHeaders || {};\n        const pick = (n) => { const k = Object.keys(h).find((x) => x.toLowerCase() === n); return k ? String([].concat(h[k])[0]) : null; };\n        let until = 0; const ra = pick('retry-after');\n        if (ra) { const n = Number(ra); until = isFinite(n) ? Date.now() + n * 1000 : (Date.parse(ra) || 0); }\n        const quota = {};\n        for (const k of Object.keys(h)) if (/ratelimit|usage|quota/i.test(k)) quota[k.toLowerCase()] = String([].concat(h[k])[0]).slice(0, 120);\n        win.webContents.send('net-event', { wc: d.webContentsId, status: d.statusCode, host: u.hostname, completion: isComp, until, quota, ts: Date.now() });\n      } catch {}\n    });\n  } catch {}\n});\n\n// Historique local : un fichier JSON (300 conversations max), recherche plein texte simple\nconst CV = () => path.join(ud(), 'conversations.json');\nlet cvCache = null, cvT = null;\nconst cvLoad = () => cvCache || (cvCache = (() => { try { const j = JSON.parse(fs.readFileSync(CV(), 'utf8')); return Array.isArray(j) ? j : []; } catch { return []; } })());\nconst cvWrite = () => { try { fs.writeFileSync(CV() + '.tmp', JSON.stringify(cvCache || [])); fs.renameSync(CV() + '.tmp', CV()); } catch {} };\nconst cvSave = () => { clearTimeout(cvT); cvT = setTimeout(cvWrite, 1500); };\napp.on('before-quit', () => { if (cvCache) cvWrite(); });\nipcMain.handle('conv:put', (_e, c) => {\n  if (!c || !c.key || !c.text) return false;\n  const l = cvLoad(), key = String(c.key).slice(0, 300), i = l.findIndex((x) => x.key === key);\n  if (i >= 0) l.splice(i, 1);\n  l.unshift({ key, acc: c.acc, platform: c.platform, name: c.name, url: String(c.url || '').slice(0, 500), title: String(c.title || '').slice(0, 160), ts: Date.now(), text: String(c.text).slice(-60000) });\n  if (l.length > 300) l.length = 300;\n  cvSave(); return true;\n});\nipcMain.handle('conv:search', (_e, q) => {\n  const terms = String(q || '').toLowerCase().split(/\\s+/).filter(Boolean).slice(0, 6);\n  if (!terms.length) return [];\n  const out = [];\n  for (const c of cvLoad()) {\n    const t = c.text.toLowerCase(), ti = (c.title || '').toLowerCase();\n    if (!terms.every((w) => t.includes(w) || ti.includes(w))) continue;\n    let score = 0; for (const w of terms) { score += (ti.includes(w) ? 5 : 0) + Math.min(10, t.split(w).length - 1); }\n    const p = Math.max(0, t.indexOf(terms[0]) - 60);\n    out.push({ score, key: c.key, acc: c.acc, platform: c.platform, name: c.name, url: c.url, title: c.title, ts: c.ts, snip: c.text.slice(p, p + 180).replace(/\\s+/g, ' ') });\n  }\n  return out.sort((a, b) => b.score - a.score || b.ts - a.ts).slice(0, 20);\n});\nipcMain.handle('conv:count', () => cvLoad().length);\nipcMain.handle('conv:clear', () => { cvCache = []; cvWrite(); return true; });\n\nipcMain.handle('copy', (_e, t) => clipboard.writeText(t));\nipcMain.handle('clear', (_e, p) => session.fromPartition(p).clearStorageData());\nipcMain.handle('wvpreload', () => pathToFileURL(path.join(__dirname, 'webview-preload.js')).href);\n// Notifications Windows : un clic ramène la fenêtre au premier plan et ouvre le compte concerné\nconst liveNotifs = new Set();\nipcMain.handle('notify', (_e, t, b, accId) => {\n  if (!Notification.isSupported()) return { ok: false, error: 'unsupported' };\n  try {\n    const n = new Notification({ title: String(t || 'AI Hub'), body: String(b || '') });\n    liveNotifs.add(n);                                   // garder une référence (sinon le clic peut être perdu)\n    n.on('close', () => liveNotifs.delete(n));\n    n.on('failed', () => liveNotifs.delete(n));\n    n.on('click', () => {\n      liveNotifs.delete(n);\n      if (!win) return;\n      if (win.isMinimized()) win.restore();\n      win.show(); win.focus();\n      win.webContents.send('notif-click', accId || null);\n    });\n    n.show();\n    return { ok: true };\n  } catch (e) { return { ok: false, error: e.message }; }\n});\nipcMain.handle('theme:set', (_e, t) => { nativeTheme.themeSource = ['light', 'dark'].includes(t) ? t : 'system'; return nativeTheme.shouldUseDarkColors; });\n\n// Export de tous les comptes : liste + cookies de chaque session, chiffré (AES-256-GCM) si mot de passe\nipcMain.handle('export', async (_e, { state, partitions, pass }) => {\n  const cookies = {};\n  for (const p of partitions) cookies[p] = await session.fromPartition(p).cookies.get({});\n  const data = JSON.stringify({ app: 'ai-hub', version: app.getVersion(), v: 1, exportedAt: new Date().toISOString(), state, cookies });\n  let out = data;\n  if (pass) {\n    const salt = crypto.randomBytes(16), iv = crypto.randomBytes(12);\n    const c = crypto.createCipheriv('aes-256-gcm', crypto.scryptSync(pass, salt, 32), iv);\n    const enc = Buffer.concat([c.update(data, 'utf8'), c.final()]);\n    out = JSON.stringify({ app: 'ai-hub', version: app.getVersion(), enc: 1, salt: salt.toString('base64'), iv: iv.toString('base64'), tag: c.getAuthTag().toString('base64'), data: enc.toString('base64') });\n  }\n  const r = await dialog.showSaveDialog(win, { defaultPath: 'ai-hub-comptes-' + new Date().toISOString().slice(0, 10) + '.json' });\n  if (r.canceled) return { ok: false };\n  fs.writeFileSync(r.filePath, out);\n  return { ok: true, path: r.filePath, encrypted: !!pass };\n});\n\nipcMain.handle('import', async (_e, pass) => {\n  const r = await dialog.showOpenDialog(win, { filters: [{ name: 'JSON', extensions: ['json'] }], properties: ['openFile'] });\n  if (r.canceled) return { ok: false };\n  let j = JSON.parse(fs.readFileSync(r.filePaths[0], 'utf8'));\n  const ver = j.version;\n  if (j.app && j.app !== 'ai-hub') return { ok: false, error: 'Ce fichier ne vient pas de AI Hub' };\n  if (j.enc) {\n    try {\n      const d = crypto.createDecipheriv('aes-256-gcm', crypto.scryptSync(pass || '', Buffer.from(j.salt, 'base64'), 32), Buffer.from(j.iv, 'base64'));\n      d.setAuthTag(Buffer.from(j.tag, 'base64'));\n      j = JSON.parse(Buffer.concat([d.update(Buffer.from(j.data, 'base64')), d.final()]).toString('utf8'));\n    } catch { return { ok: false, error: 'Mot de passe incorrect ou fichier corrompu' }; }\n  }\n  let n = 0;\n  for (const [p, list] of Object.entries(j.cookies || {})) for (const c of list) {\n    try {\n      const o = { url: `http${c.secure ? 's' : ''}://${c.domain.replace(/^\\./, '')}${c.path}`, name: c.name, value: c.value, path: c.path, secure: c.secure, httpOnly: c.httpOnly, sameSite: c.sameSite, expirationDate: c.expirationDate };\n      if (!c.hostOnly) o.domain = c.domain;\n      await session.fromPartition(p).cookies.set(o); n++;\n    } catch {}\n  }\n  return { ok: true, state: j.state, cookies: n, version: ver || j.version, current: app.getVersion() };\n});\n\n// Sauvegarde de l'état (comptes, code, détections) dans un fichier avec copies de secours\nconst count = (s) => { try { return (JSON.parse(s).accs || []).length; } catch { return -1; } };\nipcMain.handle('state:load', () => {\n  const files = [STATE()];\n  try { files.push(...fs.readdirSync(BK()).sort().reverse().map((f) => path.join(BK(), f))); } catch {}\n  for (const f of files) { try { return JSON.parse(fs.readFileSync(f, 'utf8')); } catch {} }\n  return null;\n});\nipcMain.handle('state:save', (_e, json) => {\n  fs.mkdirSync(BK(), { recursive: true });\n  try {\n    const old = fs.readFileSync(STATE(), 'utf8');\n    if (old !== json && (count(json) < count(old) || Date.now() - lastBk > 60000)) {\n      fs.writeFileSync(path.join(BK(), 'state-' + new Date().toISOString().replace(/[:.]/g, '-') + '.json'), old); lastBk = Date.now();\n      fs.readdirSync(BK()).sort().reverse().slice(40).forEach((f) => fs.unlinkSync(path.join(BK(), f)));\n    }\n  } catch {}\n  fs.writeFileSync(STATE() + '.tmp', json); fs.renameSync(STATE() + '.tmp', STATE());\n  return true;\n});\n// Sessions qui existent sur le disque mais ne sont plus dans la liste des comptes\nipcMain.handle('orphans', async (_e, known) => {\n  let names = []; try { names = fs.readdirSync(path.join(ud(), 'Partitions')); } catch {}\n  const out = [];\n  for (const n of names) {\n    if (!/^a\\d+$/.test(n) || known.includes(n)) continue;\n    const ck = await session.fromPartition('persist:' + n).cookies.get({});\n    if (ck.length) out.push({ id: n, domains: [...new Set(ck.map((c) => c.domain.replace(/^\\./, '')))] });\n  }\n  return out;\n});\nipcMain.handle('open-data', () => shell.openPath(ud()));\n\n\n// ---------- Résumé par Gemini (appel fait ici, dans le processus principal : pas de souci CORS) ----------\nipcMain.handle('gemini', async (_e, { key, model, system, prompt }) => {\n  if (!key) return { ok: false, error: 'Clé Gemini absente' };\n  const m = String(model || 'gemini-flash-latest').replace(/[^\\w.\\-]/g, '');\n  const ac = new AbortController(), to = setTimeout(() => ac.abort(), 90000);\n  try {\n    const r = await fetch((process.env.AIHUB_GEMINI_URL || 'https://generativelanguage.googleapis.com/v1beta/models/') + m + ':generateContent', {\n      method: 'POST', signal: ac.signal, headers: { 'Content-Type': 'application/json', 'x-goog-api-key': key },\n      body: JSON.stringify({ systemInstruction: system ? { parts: [{ text: system }] } : undefined, contents: [{ role: 'user', parts: [{ text: prompt }] }], generationConfig: { temperature: 0.2, maxOutputTokens: 8192 } })\n    });\n    const j = await r.json().catch(() => null);\n    if (!r.ok) return { ok: false, status: r.status, error: (j && j.error && j.error.message) || 'HTTP ' + r.status };\n    const c = j && j.candidates && j.candidates[0];\n    const text = ((c && c.content && c.content.parts) || []).map((p) => p.text || '').join('').trim();\n    if (!text) return { ok: false, error: 'Réponse vide (' + ((c && c.finishReason) || (j && j.promptFeedback && j.promptFeedback.blockReason) || '?') + ')' };\n    return { ok: true, text };\n  } catch (e) { return { ok: false, error: e.name === 'AbortError' ? 'Délai dépassé (90 s)' : e.message }; }\n  finally { clearTimeout(to); }\n});\n\n// ---------- Mises à jour (la logique est dans updater.js, testée à part) ----------\nconst backupState = (ver) => {                       // copie des données AVANT d'installer : on ne perd rien\n  try { fs.mkdirSync(BK(), { recursive: true }); fs.copyFileSync(STATE(), path.join(BK(), 'state-' + new Date().toISOString().replace(/[:.]/g, '-') + '-avant-maj-' + ver + '.json')); } catch {}\n};\nipcMain.handle('upd:info', () => Object.assign(ctx.updater.info(), { active: ctx.boot.version, rolledBack: ctx.boot.rolledBack, dataDir: ud() }));\nipcMain.handle('upd:apply', async () => {\n  const r = await dialog.showOpenDialog(win, { filters: [{ name: 'Mise à jour AI Hub', extensions: ['aihubupdate', 'json'] }], properties: ['openFile'] });\n  if (r.canceled) return { ok: false, cancelled: true };\n  try { return ctx.updater.install(ctx.updater.readPackage(r.filePaths[0]), { beforeInstall: backupState }); }\n  catch (e) { return { ok: false, error: 'Fichier illisible : ' + e.message }; }\n});\nipcMain.handle('upd:revert', (_e, to) => ctx.updater.revert(to));\nipcMain.handle('upd:healthy', () => ctx.updater.confirm());\nipcMain.handle('upd:fail', (_e, reason) => ctx.fatal('interface : ' + String(reason).slice(0, 200)));\nipcMain.handle('relaunch', () => { ctx.relaunch(); });\n// ---------- 2.5.4 : export du logiciel complet en ZIP (mode développeur) ----------\n// <PACK>\nconst zlib = require('zlib');\nconst CRC_T = (() => { const t = new Uint32Array(256); for (let n = 0; n < 256; n++) { let c = n; for (let k = 0; k < 8; k++) c = c & 1 ? 0xEDB88320 ^ (c >>> 1) : c >>> 1; t[n] = c >>> 0; } return t; })();\nconst crc32 = (b) => { let c = 0xFFFFFFFF; for (let i = 0; i < b.length; i++) c = CRC_T[(c ^ b[i]) & 255] ^ (c >>> 8); return (c ^ 0xFFFFFFFF) >>> 0; };\nfunction makeZip(entries) {                       // entries : [{ name, data: Buffer, mtime: Date }]\n  const parts = [], central = []; let off = 0;\n  for (const e of entries) {\n    const name = Buffer.from(e.name, 'utf8'), raw = e.data, def = zlib.deflateRawSync(raw), useDef = def.length < raw.length;\n    const body = useDef ? def : raw, method = useDef ? 8 : 0, crc = crc32(raw), d = e.mtime || new Date();\n    const dt = (((d.getFullYear() - 1980) << 9) | ((d.getMonth() + 1) << 5) | d.getDate()) & 0xFFFF, tm = ((d.getHours() << 11) | (d.getMinutes() << 5) | (d.getSeconds() >> 1)) & 0xFFFF;\n    const lh = Buffer.alloc(30);\n    lh.writeUInt32LE(0x04034b50, 0); lh.writeUInt16LE(20, 4); lh.writeUInt16LE(0x0800, 6); lh.writeUInt16LE(method, 8); lh.writeUInt16LE(tm, 10); lh.writeUInt16LE(dt, 12);\n    lh.writeUInt32LE(crc, 14); lh.writeUInt32LE(body.length, 18); lh.writeUInt32LE(raw.length, 22); lh.writeUInt16LE(name.length, 26);\n    parts.push(lh, name, body);\n    const ch = Buffer.alloc(46);\n    ch.writeUInt32LE(0x02014b50, 0); ch.writeUInt16LE(20, 4); ch.writeUInt16LE(20, 6); ch.writeUInt16LE(0x0800, 8); ch.writeUInt16LE(method, 10); ch.writeUInt16LE(tm, 12); ch.writeUInt16LE(dt, 14);\n    ch.writeUInt32LE(crc, 16); ch.writeUInt32LE(body.length, 20); ch.writeUInt32LE(raw.length, 24); ch.writeUInt16LE(name.length, 28); ch.writeUInt32LE(off, 42);\n    central.push(ch, name);\n    off += 30 + name.length + body.length;\n  }\n  const cd = Buffer.concat(central), end = Buffer.alloc(22);\n  end.writeUInt32LE(0x06054b50, 0); end.writeUInt16LE(entries.length, 8); end.writeUInt16LE(entries.length, 10); end.writeUInt32LE(cd.length, 12); end.writeUInt32LE(off, 16);\n  return Buffer.concat([...parts, cd, end]);\n}\nconst PACK_SKIP = /^(node_modules|\\.git|dist|out|release)$/i;\nfunction packWalk(root, rel, map, lim) {\n  let names; try { names = fs.readdirSync(path.join(root, rel)); } catch { return; }\n  for (const n of names) {\n    const r = rel ? rel + '/' + n : n, full = path.join(root, r);\n    let st; try { st = fs.statSync(full); } catch { continue; }\n    if (st.isDirectory()) { if (!PACK_SKIP.test(n)) packWalk(root, r, map, lim); continue; }\n    if (!st.isFile() || st.size > 40 * 1048576) continue;\n    if (lim.n >= 5000 || lim.bytes + st.size > 300 * 1048576) throw new Error('logiciel trop gros pour le ZIP (plus de 5000 fichiers ou 300 Mo)');\n    map.set(r, { name: r, data: fs.readFileSync(full), mtime: st.mtime }); lim.n++; lim.bytes += st.size;\n  }\n}\nfunction packApp(ver, appRoot, activeDir) {\n  const map = new Map(), lim = { n: 0, bytes: 0 };\n  packWalk(appRoot, '', map, lim);                                                  // lanceur + fichiers d'origine\n  if (path.resolve(activeDir) !== path.resolve(appRoot)) packWalk(activeDir, '', map, lim);   // version active : remplace les fichiers du même nom\n  const core = ['main-core.js', 'preload.js', 'webview-preload.js', 'index.html'];\n  if (core.every((f) => map.has(f))) {                                              // paquet de mise à jour prêt à réinstaller\n    const files = {};\n    for (const f of core) { const c = map.get(f).data.toString('utf8'); files[f] = { sha256: crypto.createHash('sha256').update(c, 'utf8').digest('hex'), content: c }; }\n    map.set('ai-hub-update-' + ver + '.aihubupdate', { name: 'ai-hub-update-' + ver + '.aihubupdate', data: Buffer.from(JSON.stringify({ app: 'ai-hub-update', format: 1, version: ver, notes: 'Export complet du logiciel', createdAt: new Date().toISOString(), requiresLauncher: null, files }), 'utf8') });\n  }\n  map.set('LISEZMOI-EXPORT.txt', { name: 'LISEZMOI-EXPORT.txt', data: Buffer.from(\n    'AI Hub - export du logiciel\\r\\nVersion : ' + ver + '\\r\\nCréé le : ' + new Date().toLocaleString('fr-FR') + '\\r\\n\\r\\n' +\n    'Contenu : les fichiers du logiciel dans leur état actuel (version active par-dessus les fichiers du lanceur).\\r\\n' +\n    'Ne contient PAS tes comptes, cookies, conversations ni ton code personnalisé (ils restent dans ' + ud() + ').\\r\\n\\r\\n' +\n    'Pour relancer depuis les sources : installer Node.js, puis dans ce dossier : npm install electron  puis  npx electron .\\r\\n' +\n    'Pour réinstaller cette version dans AI Hub : Paramètres > Mises à jour > Installer un fichier de mise à jour > ai-hub-update-' + ver + '.aihubupdate\\r\\n', 'utf8') });\n  const entries = [...map.values()];\n  return { buf: makeZip(entries), count: entries.length };\n}\n// </PACK>\nipcMain.handle('pack:zip', async () => {\n  try {\n    const info = ctx.updater.info(), boot = ctx.boot || {};\n    const ver = boot.version && boot.version !== 'bundled' ? boot.version : (info.launcherVersion || app.getVersion());\n    const r = await dialog.showSaveDialog(win, { defaultPath: 'ai-hub-' + ver + '-' + new Date().toISOString().slice(0, 10) + '.zip', filters: [{ name: 'ZIP', extensions: ['zip'] }] });\n    if (r.canceled || !r.filePath) return { ok: false, cancelled: true };\n    const res = packApp(ver, app.getAppPath(), __dirname);\n    fs.writeFileSync(r.filePath, res.buf);\n    try { shell.showItemInFolder(r.filePath); } catch {}\n    return { ok: true, path: r.filePath, files: res.count, size: res.buf.length, version: ver };\n  } catch (e) { return { ok: false, error: e.message }; }\n});\n\n// ---------- 2.5.5 : connexion via le vrai Google Chrome (Google refuse les fenêtres intégrées) ----------\n// On ouvre un vrai Chrome (profil temporaire, port de débogage local), tu t'y connectes normalement,\n// puis AI Hub lit les cookies du site concerné et les copie dans le compte. Le profil temporaire est supprimé ensuite.\n// <CHROME>\nconst http = require('http'), cp = require('child_process'), os = require('os');\nlet chromeProc = null, chromeDir = null;\nfunction chromePaths() {\n  const e = process.env, c = [];\n  if (process.platform === 'win32') {\n    for (const b of [e.LOCALAPPDATA, e.ProgramFiles, e['ProgramFiles(x86)']]) if (b) c.push(path.join(b, 'Google', 'Chrome', 'Application', 'chrome.exe'));\n    for (const b of [e['ProgramFiles(x86)'], e.ProgramFiles, e.LOCALAPPDATA]) if (b) c.push(path.join(b, 'Microsoft', 'Edge', 'Application', 'msedge.exe'));\n  } else if (process.platform === 'darwin') {\n    c.push('/Applications/Google Chrome.app/Contents/MacOS/Google Chrome', '/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge');\n  } else {\n    c.push('/usr/bin/google-chrome', '/usr/bin/google-chrome-stable', '/usr/bin/chromium', '/usr/bin/chromium-browser', '/usr/bin/microsoft-edge');\n  }\n  return c;\n}\nconst cdpJson = (port, p) => new Promise((res, rej) => {\n  const r = http.get({ host: '127.0.0.1', port, path: p, timeout: 3000 }, (m) => { let d = ''; m.on('data', (x) => { d += x; }); m.on('end', () => { try { res(JSON.parse(d)); } catch (e) { rej(e); } }); });\n  r.on('error', rej); r.on('timeout', () => r.destroy(new Error('délai dépassé')));\n});\n// cookie Chrome (protocole DevTools) -> cookie Electron ; null si à ignorer\nfunction toElectronCookie(c, hosts) {\n  const raw = String(c.domain || ''), dom = raw.replace(/^\\./, '').toLowerCase();\n  if (!dom || c.partitionKey || /^(cf_clearance|__cf_bm|_cfuvid)$/.test(c.name)) return null;\n  if (!hosts.some((h) => dom === h || dom.endsWith('.' + h))) return null;\n  const o = { url: 'http' + (c.secure ? 's' : '') + '://' + dom + (c.path || '/'), name: c.name, value: c.value, path: c.path || '/', secure: !!c.secure, httpOnly: !!c.httpOnly };\n  if (raw.startsWith('.')) o.domain = raw;\n  const ss = String(c.sameSite || '').toLowerCase();\n  o.sameSite = ss === 'none' ? 'no_restriction' : ss === 'lax' ? 'lax' : ss === 'strict' ? 'strict' : 'unspecified';\n  if (c.expires > 0) o.expirationDate = c.expires;\n  return o;\n}\nfunction chromeClean() {                           // supprime les profils temporaires oubliés (ils contiennent une session Google)\n  try { for (const n of fs.readdirSync(os.tmpdir())) if (/^ai-hub-chrome-\\d+$/.test(n)) { try { fs.rmSync(path.join(os.tmpdir(), n), { recursive: true, force: true, maxRetries: 8, retryDelay: 400 }); } catch {} } } catch {}\n}\nfunction chromeStop() {\n  const p = chromeProc, dir = chromeDir; chromeProc = null; chromeDir = null;\n  if (p && p.exitCode === null) {\n    try { if (process.platform === 'win32') cp.execFile('taskkill', ['/pid', String(p.pid), '/T', '/F'], () => {}); else p.kill('SIGTERM'); } catch {}\n  }\n  if (dir) setTimeout(() => { try { fs.rmSync(dir, { recursive: true, force: true, maxRetries: 8, retryDelay: 400 }); } catch {} }, 1500);\n}\n// </CHROME>\nipcMain.handle('chrome:start', async (_e, url) => {\n  try {\n    chromeStop(); chromeClean();\n    if (!/^https:\\/\\/[\\w.-]+(\\/|$)/i.test(String(url))) return { ok: false, error: 'adresse invalide' };\n    const exe = chromePaths().find((p) => { try { return fs.existsSync(p); } catch { return false; } });\n    if (!exe) return { ok: false, error: \"Google Chrome (ou Microsoft Edge) n'est pas installé sur cet ordinateur.\" };\n    const port = 9300 + Math.floor(Math.random() * 500);\n    chromeDir = path.join(os.tmpdir(), 'ai-hub-chrome-' + Date.now());\n    fs.mkdirSync(chromeDir, { recursive: true });\n    const proc = cp.spawn(exe, ['--user-data-dir=' + chromeDir, '--remote-debugging-port=' + port, '--remote-allow-origins=*', '--no-first-run', '--no-default-browser-check', String(url)], { stdio: 'ignore' });\n    chromeProc = proc; let dead = false; proc.on('exit', () => { dead = true; }); proc.on('error', () => { dead = true; });\n    for (let i = 0; i < 40; i++) {                  // attend que Chrome réponde (20 s max)\n      await new Promise((r) => setTimeout(r, 500));\n      if (dead) { chromeStop(); return { ok: false, error: 'Chrome s\\'est fermé au démarrage.' }; }\n      try { const v = await cdpJson(port, '/json/version'); if (v && v.webSocketDebuggerUrl) return { ok: true, port, browser: String(v.Browser || '') }; } catch {}\n    }\n    chromeStop(); return { ok: false, error: 'Chrome ne répond pas.' };\n  } catch (e) { chromeStop(); return { ok: false, error: e.message }; }\n});\nipcMain.handle('chrome:ws', async (_e, port) => {\n  try { const v = await cdpJson(Number(port), '/json/version'); return { ok: true, ws: v.webSocketDebuggerUrl }; }\n  catch { return { ok: false, error: 'Chrome ne répond plus (l\\'as-tu fermé ?). Clique « Ouvrir Chrome » pour recommencer.' }; }\n});\nipcMain.handle('chrome:import', async (_e, { partition, hosts, cookies }) => {\n  try {\n    if (!/^persist:a\\d+$/.test(String(partition))) return { ok: false, error: 'compte invalide' };\n    const ses = session.fromPartition(partition); let n = 0, skipped = 0;\n    for (const c of cookies || []) {\n      const o = toElectronCookie(c, (hosts || []).map((h) => String(h).toLowerCase()));\n      if (!o) { skipped++; continue; }\n      try { await ses.cookies.set(o); n++; } catch { skipped++; }\n    }\n    try { await ses.cookies.flushStore(); } catch {}\n    return { ok: true, imported: n, skipped };\n  } catch (e) { return { ok: false, error: e.message }; }\n});\nipcMain.handle('chrome:stop', () => { chromeStop(); return true; });\napp.on('before-quit', () => { chromeStop(); });\napp.whenReady().then(chromeClean);\n\n// Garde-fou : une nouvelle version qui ne confirme pas en 15 s est annulée\nif (ctx.updater.info().pending) setTimeout(() => { if (ctx.updater.info().pending) ctx.fatal('aucune confirmation de démarrage en 15 s'); }, 15000);\n\n// Une seule instance à la fois : empêche deux fenêtres d'écraser les mêmes données\nif (!app.requestSingleInstanceLock()) app.quit();\nelse {\n  app.on('second-instance', () => { if (win) { if (win.isMinimized()) win.restore(); win.show(); win.focus(); } });\n  app.whenReady().then(create);\n}\napp.on('window-all-closed', () => app.quit());\n};\n"}, "preload.js": {"sha256": "a3ca915dcc48c3c0079c92186ef44a63f351308d636f6b58d265255c36aae335", "content": "const { contextBridge, ipcRenderer } = require('electron');\nconst i = (c) => (...a) => ipcRenderer.invoke(c, ...a);\ncontextBridge.exposeInMainWorld('api', {\n  copy: i('copy'), clear: i('clear'), wvpreload: i('wvpreload'), notify: i('notify'),\n  exportAll: i('export'), importAll: i('import'),\n  stateLoad: i('state:load'), stateSave: i('state:save'), orphans: i('orphans'), openData: i('open-data'),\n  gemini: i('gemini'), updInfo: i('upd:info'), updApply: i('upd:apply'), updRevert: i('upd:revert'),\n  updHealthy: i('upd:healthy'), updFail: i('upd:fail'), relaunch: i('relaunch'), packZip: i('pack:zip'), chromeStart: i('chrome:start'), chromeWs: i('chrome:ws'), chromeImport: i('chrome:import'), chromeStop: i('chrome:stop'),\n  setTheme: i('theme:set'), convPut: i('conv:put'), convSearch: i('conv:search'), convCount: i('conv:count'), convClear: i('conv:clear'),\n  onNet: (cb) => ipcRenderer.on('net-event', (_e, d) => cb(d)), onNotifClick: (cb) => ipcRenderer.on('notif-click', (_e, id) => cb(id))\n});\n"}, "webview-preload.js": {"sha256": "8511342266a6c29c125e76e44f14ec61b424af29dcc16e3cae8ded80d86ed8e6", "content": "// Tourne DANS chaque page de chat : détecte les événements et les envoie à l'app\nconst { ipcRenderer, webFrame } = require('electron');\nlet cfg = { detectors: [], idle: 120, sel: {} };\n\n// Sélecteurs par défaut + sélecteurs de secours ajoutés dans Paramètres > Détections (cfg.sel)\nconst BASE = {\n  user: '[data-testid=\"user-message\"],user-query,[data-message-author-role=\"user\"]',\n  ai: '.font-claude-response,model-response,[data-message-author-role]:not([data-message-author-role=\"user\"])',   // aligné sur index.html\n  comp: '[contenteditable=\"true\"],textarea',\n  stop: '[data-testid=\"stop-button\"],button[aria-label*=\"Stop\" i],button[aria-label*=\"Arrêter\" i],button[aria-label*=\"Interrompre\" i]',\n  send: '[data-testid=\"send-button\"],button[aria-label*=\"Send\" i],button[aria-label*=\"Envoyer\" i]'\n};\nconst S = Object.assign({}, BASE);\nlet SKIP = '';\nfunction applySel() {\n  const sel = cfg.sel || {};\n  for (const k of Object.keys(BASE)) {\n    let extra = (sel[k] || '').trim();\n    if (extra) { try { document.querySelector(extra); } catch { ipcRenderer.sendToHost('hub-event', { type: 'selector-invalid', detail: { key: k, value: extra }, url: location.href, ts: Date.now() }); extra = ''; } }\n    S[k] = extra ? BASE[k] + ',' + extra : BASE[k];\n  }\n  SKIP = S.user + ',' + S.ai + ',' + S.comp + ',nav,aside,script,style,noscript';\n}\napplySel();\nipcRenderer.on('hub:config', (_e, c) => { cfg = c; applySel(); });\n\n// Limite atteinte : gérée à part (machine à états persistante, voir poll). Textes FR + EN de Claude, ChatGPT, Gemini...\nconst LIMIT_RE = /(you('|’)?ve (hit|reached|exceeded) (your|the|our|this) [\\w\\s-]{0,25}(limit|cap)|you (have|had) (hit|reached|exceeded) (your|the|our) [\\w\\s-]{0,25}(limit|cap)|you('|’)?re out of [\\w\\s-]{0,15}messages|usage (limit|cap)|message (limit|cap)|limit reached|out of (free )?messages|limite (d['’]utilisation|de messages|quotidienne|horaire|atteinte|dépassée)|vous avez (atteint|dépassé) (votre|la) limite|vous avez (épuisé|atteint) (vos|votre) [\\w\\s'’-]{0,25}(messages|quota|limite)|quota (épuisé|dépassé|exceeded)|(n['’]avez|il n['’]y a) plus de messages|plus de messages (gratuits|disponibles)|plus aucun message|come back (later|tomorrow)|reviens? plus tard)/i;\n// Heure de retour annoncée par le site : « jusqu'à 13:40 », « until 1:40 PM », « resets at 14:00 »...\nfunction parseUntil(s) {\n  const m = String(s || '').match(/(?:jusqu['’]?\\s*(?:à|a)|until|resets?(?:\\s+at)?|reviens?\\s+(?:à|at)|back\\s+at)\\s+(\\d{1,2})(?:\\s*[:h]\\s*(\\d{2}))?\\s*(a\\.?m\\.?|p\\.?m\\.?)?/i);\n  if (!m) return 0;\n  let h = +m[1], mi = +(m[2] || 0); const ap = (m[3] || '').toLowerCase().replace(/\\./g, '');\n  if (ap === 'pm' && h < 12) h += 12; if (ap === 'am' && h === 12) h = 0;\n  if (h > 23 || mi > 59) return 0;\n  const d = new Date(); d.setHours(h, mi, 0, 0);\n  if (d.getTime() <= Date.now() - 60000) d.setDate(d.getDate() + 1);   // déjà passée aujourd'hui : c'est demain\n  return d.getTime();\n}\n// [événement, regex, événement de fin]\nconst PAT = [\n  ['limit-soon', /(\\d+|few) messages? (remaining|left)|il vous reste \\d+ message|\\d+ messages? restants?/i],\n  ['rate-limit', /(too many (requests|messages)|rate limit|trop de (requêtes|messages)|slow down|ralentissez)/i],\n  ['overloaded', /(overloaded|at capacity|high demand|forte demande|surcharg|temporarily unavailable|service unavailable|temporairement indisponible)/i],\n  ['error', /(something went wrong|an error occurred|une erreur (est survenue|s['’]est produite)|network error|erreur réseau|failed to (load|send|generate)|impossible de (générer|envoyer)|unable to (send|generate))/i],\n  ['chat-too-long', /(conversation (is )?too long|conversation trop longue|context (window|limit)|maximum (conversation )?length|longueur maximale|start a new (chat|conversation)|commencez une nouvelle conversation)/i],\n  ['captcha', /(verify (that )?you are human|verifying you are human|vérifiez que vous êtes (un )?humain|checking your browser|just a moment|vérification de sécurité)/i, 'captcha-cleared']\n];\nconst LOGIN_BTN = /^(log ?in|sign ?in|se connecter|connexion|continue with (google|email)|continuer avec (google|e-?mail))$/im;\n\nconst emit = (type, detail) => ipcRenderer.sendToHost('hub-event', { type, detail, url: location.href, ts: Date.now() });\nconst q = (s) => { try { return [...document.querySelectorAll(s)]; } catch { return []; } };\nconst vis = (e) => e && e.offsetParent !== null;\nemit('page-start');\nconst flags = {};\nconst edge = (k, on, onT, offT, d) => {\n  if (on && !flags[k]) { flags[k] = 1; emit(onT, d); }\n  else if (!on && flags[k]) { flags[k] = 0; if (offT) emit(offT); }\n};\n// Texte court de TOUTE la page : uniquement pour la détection de connexion et les pages sans conversation (captcha, erreur plein écran)\nfunction pageTexts() {\n  const out = [], w = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT); let n;\n  while ((n = w.nextNode())) {\n    const t = n.nodeValue.trim();\n    if (t.length > 2 && t.length < 300) { const p = n.parentElement; if (p && !p.closest(SKIP)) out.push(t); }\n  }\n  return out.join('\\n');\n}\n\n// Texte court des ZONES D'INTERFACE seulement (alertes, fenêtres, bandeau autour de la zone de saisie).\n// La conversation n'est JAMAIS lue : même si les sélecteurs de messages changent, un échange qui parle de\n// \"limite atteinte\" ne peut plus déclencher de fausse alerte. On exclut aussi toute zone qui défile (= la conversation).\nconst ZONE_ALERT = '[role=\"alert\"],[role=\"status\"],[role=\"alertdialog\"],[role=\"dialog\"],[aria-modal=\"true\"],[aria-live=\"assertive\"],[data-testid*=\"limit\" i],[data-testid*=\"banner\" i],[data-testid*=\"toast\" i],[data-testid*=\"error\" i],[class*=\"toast\" i],[class*=\"banner\" i],[class*=\"snackbar\" i]';\nlet scrollMemo = new WeakMap();\nconst isScroller = (el) => {\n  let r = scrollMemo.get(el);\n  if (r === undefined) {\n    try { const cs = getComputedStyle(el); r = /(auto|scroll)/.test(cs.overflowY) && el.clientHeight > 120 && el.scrollHeight > el.clientHeight + 40; } catch { r = false; }\n    scrollMemo.set(el, r);\n  }\n  return r;\n};\nconst inTranscript = (el, root) => { for (let e = el; e; e = e.parentElement) { if (isScroller(e)) return true; if (e === root) break; } return false; };\nconst hasMsg = (el) => { try { return !!el.querySelector(S.user + ',' + S.ai) || !!el.closest(S.user + ',' + S.ai); } catch { return false; } };\nfunction zoneTexts() {\n  scrollMemo = new WeakMap();\n  const roots = new Set(q(ZONE_ALERT));\n  const c = q(S.comp).find(vis);\n  if (c) {                                    // bandeau juste au-dessus / autour de la zone de saisie\n    let p = c;\n    for (let i = 0; i < 5 && p.parentElement && p.parentElement !== document.body; i++) {\n      const n = p.parentElement;\n      if (isScroller(n) || hasMsg(n)) break;\n      p = n;\n    }\n    roots.add(p);\n  }\n  const UPG = /^(mettre à niveau|upgrade|passer (à|au) |s['’]abonner|subscribe|get (pro|max|plus))/i;\n  for (const b of q('button,a')) {            // le bandeau de limite contient presque toujours un bouton d'abonnement\n    if (!vis(b)) continue;\n    const t = (b.textContent || '').trim();\n    if (t.length > 40 || !UPG.test(t)) continue;\n    let p = b;\n    for (let i = 0; i < 4 && p.parentElement && p.parentElement !== document.body; i++) {\n      const n = p.parentElement;\n      if (isScroller(n) || hasMsg(n)) break;\n      p = n;\n    }\n    roots.add(p);\n  }\n  const out = new Set();\n  for (const root of roots) {\n    if (!root.isConnected || hasMsg(root)) continue;\n    const w = document.createTreeWalker(root, NodeFilter.SHOW_TEXT); let n;\n    while ((n = w.nextNode())) {\n      const t = n.nodeValue.trim();\n      if (t.length < 3 || t.length >= 300) continue;\n      const el = n.parentElement;\n      if (!el || !el.getClientRects().length || el.closest(SKIP) || inTranscript(el, root)) continue;\n      out.add(t);\n    }\n  }\n  return [...out].join('\\n');\n}\n\n// État stable : il faut N relevés consécutifs pour passer à \"actif\" (évite les clignotements)\nconst cnt = {};\nfunction stable(k, raw, nOn, nOff) {\n  const c = cnt[k] || (cnt[k] = { on: false, a: 0, b: 0 });\n  if (raw) { c.b = 0; if (!c.on && ++c.a >= nOn) c.on = true; }\n  else { c.a = 0; if (c.on && ++c.b >= nOff) c.on = false; }\n  return c.on;\n}\n\n// ---------- Limite : mémoire persistante (la limite reste marquée tant qu'elle n'est pas vraiment levée) ----------\n// Sources : (1) texte du bandeau, (2) réponse réseau 429 / \"exceeded_limit\" du site (fiable, indépendante de l'affichage).\n// Elle n'est levée que si : un message est ensuite envoyé avec succès, l'IA a répondu, le bandeau disparaît sur la même\n// page sans changement de conversation (limite réinitialisée), ou après 6 h. Changer de conversation ne la lève plus.\nconst lim = { on: false, ts: 0, src: '', until: 0 };\nlet lastNav = Date.now(), missSince = 0;      // dernière navigation ; début de l'absence du bandeau\nconst LIM_TTL = 6 * 3600 * 1000;\nfunction setLim(on, src, match, until) {\n  if (on === lim.on) return;\n  lim.on = on; lim.src = on ? src : ''; lim.until = on ? (until || 0) : 0; lim.ts = Date.now(); missSince = 0;\n  if (on) emit('limit-hit', { match: String(match || '').slice(0, 120), source: src, until: lim.until || undefined });\n  else emit('limit-cleared');\n}\n// L'app dit que l'heure de retour est passée : on oublie la limite sans bruit (elle sera redétectée si elle est encore là)\nipcRenderer.on('hub:limit-reset', () => { lim.on = false;