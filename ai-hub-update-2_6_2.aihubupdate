n, true); document.removeEventListener('keydown', onHubKey, true);\n}\nfunction toggleHubMenu() {\n  if (hmenu) return closeHubMenu();\n  ipcRenderer.sendToHost('hub-attach-open');      // l'app renvoie la liste à jour (hub:menu)\n  const dark = hDark();\n  hmenu = hel('div', 'position:fixed;z-index:2147483647;width:330px;max-height:62vh;overflow:auto;box-sizing:border-box;padding:6px;border-radius:12px;font:13px/1.35 system-ui,-apple-system,Segoe UI,sans-serif;box-shadow:0 8px 30px rgba(0,0,0,.28);border:1px solid ' + (dark ? '#4a4843' : '#e4e1d6') + ';background:' + (dark ? '#2b2a27' : '#fff') + ';color:' + (dark ? '#ece9e0' : '#1f1e1d'));\n  hmenu.dataset.dark = dark ? '1' : '';\n  hmenu.appendChild(hel('div', 'font-size:11px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;opacity:.6;padding:6px 10px 4px', 'Joindre depuis AI Hub'));\n  if ((MENU.files || []).length > 8) {\n    const inp = hel('input', 'width:calc(100% - 12px);margin:2px 6px 6px;padding:6px 9px;border-radius:8px;border:1px solid ' + (dark ? '#4a4843' : '#d8d4c8') + ';background:transparent;color:inherit;font:inherit;box-sizing:border-box;outline:none');\n    inp.placeholder = 'Rechercher…'; inp.value = hq; inp.addEventListener('input', () => { hq = inp.value; drawHubMenu(); });\n    hmenu.appendChild(inp);\n  }\n  hlist = hel('div', ''); hmenu.appendChild(hlist);\n  hfoot = hel('div', 'position:sticky;bottom:-6px;display:none;gap:8px;align-items:center;padding:8px 6px 4px;margin-top:4px'); hmenu.appendChild(hfoot);\n  document.body.appendChild(hmenu); drawHubMenu();\n  const r = hbtn.getBoundingClientRect();\n  hmenu.style.left = Math.max(8, Math.min(r.left, innerWidth - 338)) + 'px';\n  if (r.top > innerHeight / 2) hmenu.style.bottom = Math.max(8, innerHeight - r.top + 8) + 'px'; else hmenu.style.top = (r.bottom + 8) + 'px';\n  document.addEventListener('mousedown', onHubDown, true); document.addEventListener('keydown', onHubKey, true);\n}\nfunction drawHubMenu() {\n  if (!hlist) return;\n  updHubFoot();\n  const dark = !!hmenu.dataset.dark, hov = dark ? 'rgba(255,255,255,.08)' : 'rgba(31,30,29,.06)', pick = (o) => { ipcRenderer.sendToHost('hub-attach-pick', o); closeHubMenu(); };\n  const files = (MENU.files || []).filter((f) => !hq || f.name.toLowerCase().includes(hq.toLowerCase()));\n  hlist.textContent = '';\n  if (!(MENU.files || []).length) { hlist.appendChild(hel('div', 'padding:10px;opacity:.7', 'Aucun fichier. Ajoute-en dans AI Hub > Fichiers (tu peux les classer par projet).')); return; }\n  if (!files.length) { hlist.appendChild(hel('div', 'padding:10px;opacity:.7', 'Aucun fichier ne correspond.')); return; }\n  const groups = (MENU.projects || []).map((p) => ({ p, f: files.filter((x) => x.proj === p.id) })).concat([{ p: null, f: files.filter((x) => !x.proj) }]).filter((g) => g.f.length);\n  for (const g of groups) {\n    const head = hel('div', 'display:flex;align-items:center;gap:8px;padding:8px 10px 3px');\n    head.appendChild(hel('span', 'flex:1;font-weight:600;font-size:12.5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap', g.p ? g.p.name : 'Sans projet'));\n    if (g.p) {\n      const b = hel('button', 'border:0;background:none;color:#c6613f;font:inherit;font-size:11.5px;cursor:pointer;padding:2px 4px;border-radius:6px', 'contexte seul');\n      b.title = 'Ajoute seulement le résumé du projet dans la zone de message'; b.addEventListener('click', () => pick({ pid: g.p.id })); head.appendChild(b);\n    }\n    { const allIn = g.f.every((x) => SELH.has(x.id)); const sb = hel('button', 'border:0;background:none;color:#c6613f;font:inherit;font-size:11.5px;cursor:pointer;padding:2px 4px;border-radius:6px', allIn ? 'désélectionner' : 'tout sélectionner'); sb.title = 'Sélectionne tous les fichiers de ce groupe pour les envoyer en une fois'; sb.addEventListener('click', () => { g.f.forEach((x) => allIn ? SELH.delete(x.id) : SELH.add(x.id)); drawHubMenu(); }); head.appendChild(sb); }\n    hlist.appendChild(head);\n    for (const f of g.f) {\n      const row = hel('button', 'display:flex;align-items:center;gap:9px;width:100%;padding:7px 10px;border:0;background:none;color:inherit;font:inherit;text-align:left;cursor:pointer;border-radius:8px');\n      const ext = ((f.name.includes('.') ? f.name.split('.').pop() : 'file') || 'file').slice(0, 4).toUpperCase();\n      row.appendChild(mkCb(f.id)); row.appendChild(hel('span', 'flex:none;min-width:34px;text-align:center;font-size:10px;font-weight:700;padding:3px 4px;border-radius:6px;background:' + (dark ? 'rgba(198,97,63,.22)' : 'rgba(198,97,63,.12)') + ';color:#c6613f', ext));\n      row.appendChild(hel('span', 'flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap', f.name));\n      row.appendChild(hel('span', 'flex:none;font-size:11.5px;opacity:.55', hSize(f.size)));\n      row.addEventListener('mouseenter', () => { row.style.background = hov; }); row.addEventListener('mouseleave', () => { row.style.background = 'none'; });\n      row.addEventListener('click', () => { if (SELH.size) { SELH.has(f.id) ? SELH.delete(f.id) : SELH.add(f.id); drawHubMenu(); } else pick({ fid: f.id }); }); hlist.appendChild(row);\n    }\n  }\n}\n\nfunction mkCb(id) {\n  const cb = hel('input', 'flex:none;width:15px;height:15px;margin:0;accent-color:#c6613f;cursor:pointer'); cb.type = 'checkbox'; cb.checked = SELH.has(id); cb.title = 'Sélectionner pour envoyer plusieurs fichiers';\n  cb.addEventListener('click', (e) => e.stopPropagation()); cb.addEventListener('change', () => { cb.checked ? SELH.add(id) : SELH.delete(id); drawHubMenu(); }); return cb;\n}\nfunction updHubFoot() {\n  if (!hfoot) return; hfoot.textContent = '';\n  if (!SELH.size) { hfoot.style.display = 'none'; return; }\n  const dark = hmenu && hmenu.dataset.dark; hfoot.style.display = 'flex'; hfoot.style.background = dark ? '#2b2a27' : '#fff'; hfoot.style.borderTop = '1px solid ' + (dark ? '#4a4843' : '#e4e1d6');\n  const go = hel('button', 'flex:1;border:0;border-radius:8px;padding:8px 10px;background:#c6613f;color:#fff;font:inherit;font-weight:600;cursor:pointer', 'Joindre ' + SELH.size + ' fichier' + (SELH.size > 1 ? 's' : ''));\n  go.addEventListener('click', () => { const fids = [...SELH]; ipcRenderer.sendToHost('hub-attach-pick', { fids }); closeHubMenu(); });\n  const no = hel('button', 'border:0;background:none;color:inherit;opacity:.7;font:inherit;cursor:pointer;padding:6px 8px', 'Annuler'); no.addEventListener('click', () => { SELH.clear(); drawHubMenu(); });\n  hfoot.appendChild(go); hfoot.appendChild(no);\n}\n"}, "index.html": {"sha256": "2782ca2f3739890046e8fa7c9585979b6d898ed9c20acc3842d5425d8f0774d6", "content": "<!DOCTYPE html>\n<html lang=\"fr\" data-theme=\"system\"><head><meta charset=\"UTF-8\"><title>AI Hub</title>\n<script>/* garde-fou : une erreur au démarrage d'une version en essai la fait annuler tout de suite */\nwindow.__healthy=false;(()=>{const f=m=>{if(!window.__healthy&&window.api)window.api.updFail(String(m))};addEventListener('error',e=>f(e.message));addEventListener('unhandledrejection',e=>f(e.reason&&e.reason.message||e.reason))})();</script>\n<style>\n/* ===== Thème : palette inspirée de claude.ai (fond crème, accent terracotta ; sombre = gris chaud) ===== */\n:root{color-scheme:light;\n--bg:#FAF9F5;--side:#F3F1EA;--panel:#FFFFFF;--hover:rgba(31,30,29,.06);--sel:rgba(31,30,29,.09);\n--line:#E4E1D6;--line2:#CFCBBE;--txt:#1F1E1D;--dim:#6F6D66;--acc:#C6613F;--btn:#B5532F;--btnh:#9E4527;\n--soft:rgba(198,97,63,.10);--ok:#2F7D5B;--warn:#A9691A;--err:#B3412F;--tbg:#1F1E1D;--ttx:#FAF9F5;\n--shadow:0 1px 2px rgba(31,30,29,.06),0 8px 28px rgba(31,30,29,.12);\n--serif:\"Iowan Old Style\",\"Palatino Linotype\",Palatino,\"Book Antiqua\",Georgia,serif;\n--sans:system-ui,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif}\n:root[data-theme=dark]{color-scheme:dark;\n--bg:#262624;--side:#1F1E1D;--panel:#30302E;--hover:rgba(250,249,245,.06);--sel:rgba(250,249,245,.10);\n--line:#3D3C38;--line2:#57554E;--txt:#F2F0E8;--dim:#A3A198;--acc:#E08A6B;--btn:#B5532F;--btnh:#C65F39;\n--soft:rgba(224,138,107,.14);--ok:#6CC59A;--warn:#E0B060;--err:#EE8A78;--tbg:#F2F0E8;--ttx:#1F1E1D;\n--shadow:0 1px 2px rgba(0,0,0,.3),0 8px 28px rgba(0,0,0,.45)}\n@media (prefers-color-scheme:dark){:root[data-theme=system]{color-scheme:dark;\n--bg:#262624;--side:#1F1E1D;--panel:#30302E;--hover:rgba(250,249,245,.06);--sel:rgba(250,249,245,.10);\n--line:#3D3C38;--line2:#57554E;--txt:#F2F0E8;--dim:#A3A198;--acc:#E08A6B;--btn:#B5532F;--btnh:#C65F39;\n--soft:rgba(224,138,107,.14);--ok:#6CC59A;--warn:#E0B060;--err:#EE8A78;--tbg:#F2F0E8;--ttx:#1F1E1D;\n--shadow:0 1px 2px rgba(0,0,0,.3),0 8px 28px rgba(0,0,0,.45)}}\n\n*{box-sizing:border-box;margin:0}\nhtml,body{height:100%}\nbody{display:flex;background:var(--bg);color:var(--txt);font:14px/1.5 var(--sans);-webkit-font-smoothing:antialiased}\n::-webkit-scrollbar{width:10px;height:10px}::-webkit-scrollbar-thumb{background:var(--line);border-radius:10px;border:2px solid transparent;background-clip:content-box}::-webkit-scrollbar-thumb:hover{background:var(--line2);background-clip:content-box}\n:focus-visible{outline:2px solid var(--acc);outline-offset:2px}\n.ic{width:16px;height:16px;flex:none}\ncode{font:12.5px Consolas,monospace;background:var(--hover);padding:1px 5px;border-radius:5px}\n\n/* barre latérale */\naside{width:264px;background:var(--side);border-right:1px solid var(--line);display:flex;flex-direction:column;padding:14px 12px;gap:10px;flex:none}\n.brand{display:flex;align-items:center;gap:10px;padding:4px 8px 6px}\n.brand svg{width:26px;height:26px;color:var(--acc)}\nh1{font:500 22px var(--serif);letter-spacing:-.01em}\n#list{flex:1;overflow:auto;margin:0 -4px;padding:0 4px}\n.grp{color:var(--dim);font-size:11.5px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;padding:14px 10px 4px}\n.acc{display:flex;align-items:center;gap:9px;padding:7px 10px;border-radius:8px;cursor:pointer;min-height:34px}\n.acc:hover{background:var(--hover)}.acc.on{background:var(--sel);font-weight:500}\n.dot{width:8px;height:8px;border-radius:50%;flex:none}\n.acc span{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.acc b{display:none;font-weight:400;color:var(--dim);padding:3px;border-radius:6px;line-height:0}\n.acc:hover b{display:block}.acc b:hover{color:var(--txt);background:var(--hover)}.acc b[data-del]:hover{color:var(--err)}\n.bd{display:inline-flex;font-style:normal;color:var(--dim)}.bd.err{color:var(--err)}.bd.warn{color:var(--warn)}\n.spin{width:12px;height:12px;border:2px solid var(--line2);border-top-color:var(--acc);border-radius:50%;animation:rot .8s linear infinite;flex:none}\n@keyframes rot{to{transform:rotate(360deg)}}\n\n/* boutons et champs */\n.btn{font:inherit;font-weight:500;color:var(--txt);background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:7px 12px;cursor:pointer;display:inline-flex;align-items:center;gap:7px;transition:background .12s,border-color .12s}\n.btn:hover{background:var(--hover);border-color:var(--line2)}\n.btn.pri{background:var(--btn);border-color:var(--btn);color:#fff}.btn.pri:hover{background:var(--btnh);border-color:var(--btnh)}\n.btn.ghost{background:transparent;border-color:transparent}.btn.ghost:hover{background:var(--hover)}\n.btn.wide{width:100%;justify-content:center}.btn.wide.left{justify-content:flex-start}\n.btn:disabled{opacity:.5;cursor:default}\nselect,input:not([type=checkbox]),textarea{padding:8px 10px;background:var(--panel);color:var(--txt);border:1px solid var(--line);border-radius:8px;font:inherit}\nselect{padding-right:6px}\ntextarea,pre{font:13px Consolas,monospace}\ninput::placeholder,textarea::placeholder{color:var(--dim)}\npre{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:12px;overflow:auto;white-space:pre-wrap;line-height:1.5}\ndetails{margin:12px 0}summary{cursor:pointer;color:var(--acc);font-weight:500}\n\n/* zone principale */\nmain{flex:1;display:flex;flex-direction:column;min-width:0}\nheader{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 16px;border-bottom:1px solid var(--line);min-height:56px}\nheader strong{font-weight:500;font-size:15px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.hbtns{display:flex;gap:6px;flex:none}\n#ask{display:flex;align-items:center;gap:12px;flex-wrap:wrap;padding:10px 16px;background:var(--soft);border-bottom:1px solid var(--line)}\n#ask[hidden]{display:none}#ask span{flex:1;min-width:200px}\n#views{flex:1;position:relative;background:var(--bg)}\nwebview{position:absolute;inset:0;width:100%;height:100%;display:none;background:var(--bg)}\nwebview.on{display:flex}\n#empty{position:absolute;inset:0;display:grid;place-items:center;text-align:center;padding:40px}\n#empty div{max-width:420px}\n#empty h2{font:500 28px var(--serif);letter-spacing:-.01em;margin-bottom:8px}\n#empty p{color:var(--dim);margin-bottom:18px}\n#bar{position:absolute;top:0;left:0;right:0;height:2px;z-index:6;overflow:hidden;display:none}\n#bar.on{display:block}#bar i{display:block;height:100%;width:35%;background:var(--acc);animation:slide 1s infinite ease-in-out}\n@keyframes slide{from{transform:translateX(-100%)}to{transform:translateX(300%)}}\n\n/* paramètres */\n#set{position:absolute;inset:0;z-index:5;background:var(--bg);display:none}\n#set.on{display:grid;grid-template-columns:250px 1fr}\n.snav{border-right:1px solid var(--line);background:var(--side);padding:22px 12px;display:flex;flex-direction:column;gap:2px;overflow:auto}\n.snav h2{font:500 22px var(--serif);padding:0 10px 14px}\n.snav button{font:inherit;text-align:left;background:none;border:0;color:var(--dim);padding:8px 10px;border-radius:8px;cursor:pointer}\n.snav button:hover{background:var(--hover);color:var(--txt)}.snav button.on{background:var(--sel);color:var(--txt);font-weight:500}\n.sgrp{color:var(--dim);font-size:11.5px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;padding:16px 10px 4px}\n.dev-only{display:none}body.dev .dev-only{display:block}\n.spanes{overflow:auto}\n.pane{display:none;padding:28px 40px 56px;max-width:840px}.pane.on{display:block}\n.pane h2{font:500 28px var(--serif);letter-spacing:-.01em;margin-bottom:6px}\n.pane h3{font-size:14px;font-weight:600;margin:26px 0 6px}\n.pane p,.dim,.lead{color:var(--dim);line-height:1.55}\n.pane p{margin:4px 0}\n.warn{color:var(--warn);margin:8px 0}\n.card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:4px 18px;margin:8px 0}\n.card.pad{padding:16px 18px}\n.opt{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:14px 0;border-bottom:1px solid var(--line);cursor:pointer}\n.opt:last-child{border-bottom:0}.opt.nc{cursor:default}\n.opt b{font-weight:500}.opt small{display:block;color:var(--dim);font-size:12.5px;margin-top:2px;line-height:1.45}\n.opt.off{opacity:.55}\n.sw{appearance:none;-webkit-appearance:none;width:38px;height:22px;padding:0;border:0;border-radius:22px;background:var(--line2);position:relative;cursor:pointer;flex:none;transition:background .15s}\n.sw::after{content:\"\";position:absolute;top:3px;left:3px;width:16px;height:16px;border-radius:50%;background:#fff;transition:transform .15s;box-shadow:0 1px 2px rgba(0,0,0,.25)}\n.sw:checked{background:var(--btn)}.sw:checked::after{transform:translateX(16px)}\n.seg{display:inline-flex;background:var(--hover);border-radius:10px;padding:3px;gap:2px}\n.seg button{font:inherit;border:0;background:none;color:var(--dim);padding:5px 14px;border-radius:8px;cursor:pointer}\n.seg button.on{background:var(--panel);color:var(--txt);box-shadow:0 1px 2px rgba(0,0,0,.14);font-weight:500}\n.line{display:flex;gap:8px;align-items:center;margin:10px 0;flex-wrap:wrap}\n.pill{display:inline-block;font-size:12px;font-weight:500;padding:2px 9px;border-radius:20px;background:var(--hover);color:var(--dim)}\n.pill.ok{background:rgba(47,125,91,.14);color:var(--ok)}.pill.no{background:rgba(179,65,47,.13);color:var(--err)}\n#code{width:100%;height:42vh;resize:vertical;white-space:pre;tab-size:2}\n.ev{display:grid;grid-template-columns:170px 1fr;gap:3px 12px;font-size:13px}.ev code{color:var(--acc);background:none;padding:0}\n.row2{display:grid;grid-template-columns:1.1fr 1fr 2fr 1fr auto;gap:6px;margin:6px 0}\n#logl{max-height:46vh;overflow:auto}\n#custom{width:100%;height:190px;resize:vertical}\n\n/* fenêtres, bulle */\ndialog{margin:auto;background:var(--panel);color:var(--txt);border:1px solid var(--line);border-radius:16px;padding:22px;width:380px;box-shadow:var(--shadow)}\ndialog::backdrop{background:rgba(0,0,0,.45)}\ndialog h3{font:500 20px var(--serif);margin-bottom:6px}\ndialog label{display:block;margin:14px 0 4px;color:var(--dim)}\ndialog label.inl{display:flex;align-items:center;gap:8px;color:var(--txt)}\ndialog select,dialog input:not([type=checkbox]){width:100%}\n.row{display:flex;gap:8px;justify-content:flex-end;margin-top:20px}\n#toast{position:fixed;bottom:24px;left:50%;transform:translate(-50%,20px);background:var(--tbg);color:var(--ttx);padding:10px 16px;border-radius:10px;font-weight:500;opacity:0;pointer-events:none;transition:.2s;z-index:99;max-width:70vw;box-shadow:var(--shadow)}\n#toast.show{opacity:1;transform:translate(-50%,0)}\n@media (prefers-reduced-motion:reduce){#toast{transition:none}.spin{animation-duration:2.4s}}\n\n/* écran de démarrage */\n#splash{position:fixed;inset:0;z-index:50;background:var(--bg);display:flex;flex-direction:column;align-items:center;justify-content:center;transition:opacity .5s,transform .5s}\n#splash.out{opacity:0;transform:scale(1.04);pointer-events:none}\n#splash svg{width:150px;height:150px;overflow:visible}\n#splash .ln{stroke:var(--acc);stroke-width:4;stroke-linecap:round;stroke-dasharray:140;stroke-dashoffset:140;animation:draw .7s ease-out forwards}\n#splash .nd,#splash .ct,#splash .rg{transform-box:fill-box;transform-origin:center}\n#splash .nd{fill:var(--acc);transform:scale(0);animation:pop .45s cubic-bezier(.2,1.6,.4,1) forwards}\n#splash .ct{fill:var(--txt);animation:beat 1.4s ease-in-out .9s infinite}\n#splash .rg{fill:none;stroke:var(--acc);stroke-width:2;opacity:0;animation:ring 1.6s ease-out .9s infinite}\n#splash .wm{margin-top:24px;font:500 24px var(--serif);letter-spacing:.3em;text-indent:.3em;opacity:0;transform:translateY(8px);animation:rise .6s .7s forwards}\n@keyframes draw{to{stroke-dashoffset:0}}@keyframes pop{to{transform:scale(1)}}@keyframes beat{50%{transform:scale(1.18)}}\n@keyframes ring{0%{opacity:.7;transform:scale(1)}100%{opacity:0;transform:scale(3.4)}}@keyframes rise{to{opacity:1;transform:none}}\n@media (prefers-reduced-motion:reduce){#splash *{animation-duration:.01s!important;animation-delay:0s!important}}\n\n/* ===== 2.2.2 : animations, thème, page Fichiers ===== */\n:root{--ease:cubic-bezier(.2,.8,.2,1);--spring:cubic-bezier(.3,1.4,.5,1)}\n.themeswap,.themeswap *{transition:background-color .38s ease,color .38s ease,border-color .38s ease,fill .38s ease,stroke .38s ease,box-shadow .38s ease!important}\n@keyframes pagein{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}\n@keyframes fadein{from{opacity:0}to{opacity:1}}\n@keyframes itemin{from{opacity:0;transform:translateX(-10px)}to{opacity:1;transform:none}}\n@keyframes cardin{from{opacity:0;transform:translateY(16px) scale(.97)}to{opacity:1;transform:none}}\n@keyframes dlgin{from{opacity:0;transform:translateY(14px) scale(.96)}to{opacity:1;transform:none}}\n@keyframes menuin{from{opacity:0;transform:translateY(-6px) scale(.96)}to{opacity:1;transform:none}}\n@keyframes askin{from{opacity:0;transform:translateY(-8px)}to{opacity:1;transform:none}}\n@keyframes floaty{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}\n@keyframes pulsebd{0%,100%{border-color:var(--acc)}50%{border-color:transparent}}\n\n.brand svg{transition:transform .8s var(--spring)}.brand:hover svg{transform:rotate(60deg) scale(1.06)}\n.acc{transition:background .15s,transform .2s var(--ease)}.acc:hover{transform:translateX(2px)}\n.acc.enter{animation:itemin .42s var(--ease) backwards;animation-delay:calc(var(--i,0)*50ms)}\n.grp.enter{animation:fadein .6s ease backwards}\n.acc.on .dot{box-shadow:0 0 0 3px var(--soft)}.dot{transition:box-shadow .25s}\n.btn{transition:background .15s,border-color .15s,transform .18s var(--ease),box-shadow .22s}\n.btn:active{transform:scale(.97)}\n.btn.pri:hover{box-shadow:0 5px 16px rgba(181,83,47,.30);transform:translateY(-1px)}\n.btn.pri:active{transform:scale(.97)}\n.btn.on{background:var(--sel)}\n#set.on{animation:pagein .36s var(--ease) backwards}\n.pane.on{animation:pagein .4s var(--ease) backwards}\n#empty>div{animation:pagein .7s var(--ease) backwards}\n.sw{transition:background .2s}.sw::after{transition:transform .28s var(--spring),width .15s}\n.sw:active::after{width:20px}.sw:checked:active::after{transform:translateX(12px)}\n.card{transition:border-color .2s,box-shadow .25s}.card:hover{border-color:var(--line2)}\n.seg{position:relative}\n.seg .ind{position:absolute;top:3px;bottom:3px;left:0;width:var(--w,0);transform:translateX(var(--x,0));background:var(--panel);border-radius:8px;box-shadow:0 1px 2px rgba(0,0,0,.14);transition:transform .32s var(--spring),width .32s var(--ease);pointer-events:none}\n.seg button{position:relative;z-index:1;transition:color .2s}\n.seg button.on{background:none!important;box-shadow:none!important}\ndialog[open]{animation:dlgin .3s var(--ease)}\ndialog[open]::backdrop{animation:fadein .25s ease;backdrop-filter:blur(2px)}\n#ask:not([hidden]){animation:askin .4s var(--ease)}\n\n.foot{display:flex;gap:6px;align-items:center}\n.foot #gear{flex:1;min-width:0;width:auto}\n.btn.ic-only{padding:8px;line-height:0}\n.tg{position:relative;width:16px;height:16px;display:block}\n.tg>span{position:absolute;inset:0;display:block;transition:transform .6s var(--spring),opacity .3s ease}\n.tg .moon{opacity:0;transform:rotate(-80deg) scale(.3)}\n:root[data-eff=dark] .tg .sun{opacity:0;transform:rotate(80deg) scale(.3)}\n:root[data-eff=dark] .tg .moon{opacity:1;transform:none}\n#filesbtn .pill{margin-left:auto}.pill:empty{display:none}\n\n#files{position:absolute;inset:0;z-index:5;background:var(--bg);display:none;overflow:auto;padding:30px 40px 56px}\n#files.on{display:block;animation:pagein .38s var(--ease) backwards}\n.fhead{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;flex-wrap:wrap;margin-bottom:22px}\n.fhead h2{font:500 30px var(--serif);letter-spacing:-.01em}\n.fhead p{color:var(--dim);margin-top:4px;max-width:540px}\n.fact{display:flex;gap:10px;align-items:center;flex-wrap:wrap}\n.fsearch{position:relative;display:flex;align-items:center}\n.fsearch .ic{position:absolute;left:11px;color:var(--dim);pointer-events:none}\n.fsearch input{padding-left:34px;width:220px;transition:border-color .15s,box-shadow .2s,width .28s var(--ease)}\n.fsearch input:focus{outline:none;border-color:var(--acc);box-shadow:0 0 0 3px var(--soft);width:280px}\n#fgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:14px}\n.fcard{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:14px;display:flex;flex-direction:column;gap:6px;min-width:0;transition:transform .26s var(--ease),box-shadow .26s,border-color .2s;animation:cardin .5s var(--ease) backwards;animation-delay:calc(min(var(--i,0),14)*38ms)}\n.fcard:hover{transform:translateY(-3px);box-shadow:var(--shadow);border-color:var(--line2)}\n#fgrid.noanim .fcard{animation:none}\n.ftile{width:46px;height:46px;border-radius:12px;display:grid;place-items:center;font:600 12px var(--sans);letter-spacing:.04em;color:var(--tint,var(--dim));background:var(--soft);background:color-mix(in srgb,var(--tint,var(--dim)) 15%,transparent);margin-bottom:6px;transition:transform .35s var(--spring)}\n.fcard:hover .ftile{transform:scale(1.08) rotate(-3deg)}\n.k-image{--tint:#5B8FD0}.k-pdf{--tint:#D4604A}.k-doc{--tint:#4F86D9}.k-sheet{--tint:#3F9A6A}.k-code{--tint:#9A78D2}.k-zip{--tint:#C4902F}.k-txt{--tint:#8A877D}\n.fthumb{height:112px;border-radius:10px;overflow:hidden;background:var(--hover);margin-bottom:6px}\n.fthumb img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .6s var(--ease)}\n.fcard:hover .fthumb img{transform:scale(1.06)}\n.fname{font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.fmeta{color:var(--dim);font-size:12.5px}\n.fact2{display:flex;gap:4px;align-items:center;margin-top:8px}\n.fact2 .btn.sm:first-child{flex:1;justify-content:center}\n.btn.sm{padding:5px 9px;font-size:13px}.btn.ico{padding:6px;line-height:0}\n.btn.ico.del:hover{color:var(--err)}\n#fempty{display:none;place-items:center;text-align:center;padding:70px 20px}\n#fempty>div{max-width:380px}\n#fempty .big{width:84px;height:84px;margin:0 auto 18px;border-radius:24px;display:grid;place-items:center;color:var(--acc);background:var(--soft);animation:floaty 3.4s ease-in-out infinite}\n#fempty .big .ic{width:38px;height:38px}\n#fempty h3{font:500 22px var(--serif);margin-bottom:6px}\n#fempty p{color:var(--dim);margin-bottom:16px}\n#fdrop{position:fixed;top:68px;left:276px;right:12px;bottom:12px;border:2px dashed var(--acc);border-radius:20px;background:var(--soft);backdrop-filter:blur(3px);display:grid;place-items:center;text-align:center;opacity:0;pointer-events:none;transform:scale(.985);transition:opacity .2s,transform .28s var(--ease);z-index:7}\n#fdrop.on{opacity:1;transform:none;animation:pulsebd 1.5s ease-in-out infinite}\n#fdrop b{display:block;font:500 22px var(--serif);margin-top:10px}#fdrop span{color:var(--dim)}\n#fdrop .ic{width:42px;height:42px;color:var(--acc);animation:floaty 1.6s ease-in-out infinite}\n#fmenu{position:fixed;z-index:80;width:260px;max-height:50vh;overflow:auto;background:var(--panel);border:1px solid var(--line);border-radius:12px;box-shadow:var(--shadow);padding:6px}\n#fmenu[hidden]{display:none}#fmenu.in{animation:menuin .18s var(--ease)}\n#fmenu .mt{color:var(--dim);font-size:11.5px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;padding:6px 10px 4px}\n#fmenu button{font:inherit;color:var(--txt);width:100%;display:flex;align-items:center;gap:9px;padding:8px 10px;border:0;background:none;border-radius:8px;cursor:pointer;text-align:left;transition:background .12s}\n#fmenu button:hover{background:var(--hover)}\n#fmenu button span{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n#fmenu button em{font-style:normal;font-size:11.5px;color:var(--acc);font-weight:500}\n@media (prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-delay:0s!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}\n/* 2.2.4 : projets */\n#fprojs{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 16px}\n.chip{font:inherit;font-size:13px;color:var(--txt);background:var(--panel);border:1px solid var(--line);border-radius:999px;padding:5px 12px;cursor:pointer;display:inline-flex;align-items:center;gap:6px;transition:background .15s,border-color .15s,transform .18s var(--ease)}\n.chip:hover{background:var(--hover);transform:translateY(-1px)}\n.chip .ic{width:14px;height:14px}\n.chip i{font-style:normal;font-size:11.5px;color:var(--dim)}\n.chip.on{background:var(--soft);border-color:var(--acc);color:var(--acc)}.chip.on i{color:var(--acc)}\n.chip.add{border-style:dashed;color:var(--dim)}\n#fpedit{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:14px;margin:0 0 18px;display:flex;flex-direction:column;gap:10px}\n#fpedit[hidden]{display:none}\n#fpedit .pe-row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}\n#fpedit input,#fpedit textarea{font:inherit;color:var(--txt);background:var(--bg);border:1px solid var(--line);border-radius:8px;padding:7px 10px;outline:none;min-width:0}\n#fpedit input{flex:1}#fpedit textarea{resize:vertical;width:100%;box-sizing:border-box}\n#fpedit input:focus,#fpedit textarea:focus{border-color:var(--acc)}\n#psum{margin:0;white-space:pre-wrap;font:12.5px/1.5 inherit;color:var(--dim);background:var(--bg);border:1px solid var(--line);border-radius:8px;padding:9px 11px;max-height:190px;overflow:auto}\n.psel{font:inherit;font-size:12px;color:var(--dim);background:var(--bg);border:1px solid var(--line);border-radius:8px;padding:4px 6px;margin-top:2px;max-width:100%;cursor:pointer}\n.psel:hover{border-color:var(--acc)}\n/* 2.2.6 : cartes fichiers façon Claude, icônes animées, couleurs personnalisables */\n#fgrid{grid-template-columns:repeat(auto-fill,minmax(290px,1fr))}\n.fcard .frow{display:flex;gap:13px;align-items:center;min-width:0}\n.fcard .fbody{min-width:0;flex:1;display:flex;flex-direction:column;gap:1px}\n.ftile{--sp:2.6s;width:52px;height:60px;flex:none;margin:0;border-radius:13px;color:var(--tint);display:grid;place-items:center;position:relative;overflow:hidden;\n  border:1px solid color-mix(in srgb,var(--tint) 55%,transparent);\n  background:linear-gradient(160deg,color-mix(in srgb,var(--tint) 38%,var(--panel)),color-mix(in srgb,var(--tint) 9%,var(--panel)) 85%);\n  box-shadow:0 0 0 0 color-mix(in srgb,var(--tint) 0%,transparent),inset 0 1px 0 color-mix(in srgb,var(--tint) 35%,transparent);\n  animation:ficGlow calc(var(--sp)*1.6) ease-in-out infinite;transition:transform .35s var(--spring)}\n.ftile::after{content:\"\";position:absolute;inset:0;background:linear-gradient(115deg,transparent 35%,color-mix(in srgb,var(--tint) 40%,#fff) 50%,transparent 65%);opacity:0;transform:translateX(-100%)}\n:is(.fcard,.fc-item):hover .ftile{--sp:1s;transform:translateY(-2px) rotate(-2.5deg) scale(1.05)}\n:is(.fcard,.fc-item):hover .ftile::after{animation:ficShine 1.1s ease-out}\n.fic{width:26px;height:26px;overflow:visible;position:relative;z-index:1;filter:drop-shadow(0 0 5px color-mix(in srgb,var(--tint) 55%,transparent))}\n.fic *{transform-box:fill-box;transform-origin:center}\n.fcard .fthumb{width:52px;height:60px;flex:none;margin:0;border-radius:13px;border:1px solid var(--line)}\n@keyframes ficGlow{0%,100%{box-shadow:0 0 0 0 color-mix(in srgb,var(--tint) 0%,transparent),inset 0 1px 0 color-mix(in srgb,var(--tint) 35%,transparent)}50%{box-shadow:0 0 16px 0 color-mix(in srgb,var(--tint) 38%,transparent),inset 0 1px 0 color-mix(in srgb,var(--tint) 35%,transparent)}}\n@keyframes ficShine{to{transform:translateX(100%);opacity:.55}}\n@keyframes ficSpinA{0%{transform:scaleX(1)}50%{transform:scaleX(.04)}100%{transform:scaleX(1)}}\n@keyframes ficSpinB{0%{transform:scaleX(.04)}50%{transform:scaleX(1)}100%{transform:scaleX(.04)}}\n@keyframes ficSun{0%,100%{transform:translate(0,0) scale(1)}50%{transform:translate(7px,-1px) scale(1.25)}}\n@keyframes ficDraw{0%{stroke-dasharray:1 1;stroke-dashoffset:1}55%,85%{stroke-dasharray:1 1;stroke-dashoffset:0}100%{stroke-dasharray:1 1;stroke-dashoffset:-1}}\n@keyframes ficBrL{0%,100%{transform:translateX(0) rotate(0)}50%{transform:translateX(-2.8px) rotate(-7deg)}}\n@keyframes ficBrR{0%,100%{transform:translateX(0) rotate(0)}50%{transform:translateX(2.8px) rotate(7deg)}}\n@keyframes ficChL{0%,100%{transform:translateX(0)}50%{transform:translateX(-3px)}}\n@keyframes ficChR{0%,100%{transform:translateX(0)}50%{transform:translateX(3px)}}\n@keyframes ficSlash{0%,100%{transform:rotate(0) scaleY(1)}50%{transform:rotate(14deg) scaleY(1.12)}}\n@keyframes ficLid{0%,18%,100%{transform:rotate(0) translateY(0)}45%,70%{transform:rotate(-16deg) translate(-1px,-2.5px)}}\n@keyframes ficItem{0%,18%,100%{transform:translateY(2px);opacity:0}45%,70%{transform:translateY(-5px);opacity:1}}\n@keyframes ficZip{0%,100%{opacity:1}50%{opacity:.2}}\n@keyframes ficCell{0%,100%{opacity:0}40%{opacity:.5}}\n@keyframes ficBar{0%,100%{transform:scaleY(.3)}50%{transform:scaleY(1.15)}}\n@keyframes ficPlay{0%,100%{transform:scale(1)}50%{transform:scale(1.28)}}\n@keyframes ficRing{0%{transform:scale(.6);opacity:.9}100%{transform:scale(2.1);opacity:0}}\n@keyframes ficFold{0%,100%{transform:rotate(0)}50%{transform:rotate(-14deg) scale(1.2)}}\n/* 2.2.7 : AU REPOS = animations douces et lentes ; AU SURVOL = animations complètes, différentes */\n@keyframes ficIdleFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-1.4px)}}\n@keyframes ficIdleSun{0%,100%{transform:translateY(0)}50%{transform:translateY(-1.8px)}}\n@keyframes ficIdleBr{0%,100%{transform:scale(1)}50%{transform:scale(1.07)}}\n@keyframes ficIdleFade{0%,100%{opacity:1}50%{opacity:.4}}\n@keyframes ficIdleLid{0%,100%{transform:rotate(0)}50%{transform:rotate(-4deg)}}\n@keyframes ficIdleBar{0%,100%{transform:scaleY(.6)}50%{transform:scaleY(.95)}}\n@keyframes ficIdlePlay{0%,100%{transform:scale(1)}50%{transform:scale(1.1)}}\n@keyframes ficTilt{0%,100%{transform:rotate(0)}25%{transform:rotate(-9deg)}75%{transform:rotate(9deg)}}\n.fic{animation:ficIdleFloat calc(var(--sp)*1.4) ease-in-out infinite}\n.ik-web .a{animation:ficSpinA calc(var(--sp)*2.4) linear infinite}.ik-web .b{animation:ficSpinB calc(var(--sp)*2.4) linear infinite}\n.ik-vector .a,.ik-image .a{animation:ficIdleSun calc(var(--sp)*1.3) ease-in-out infinite}\n.ik-braces .a,.ik-braces .b{animation:ficIdleBr calc(var(--sp)*1.4) ease-in-out infinite}\n.ik-code .a,.ik-code .b{animation:ficIdleFade calc(var(--sp)*1.2) ease-in-out infinite}.ik-code .b{animation-delay:.6s}\n.ik-zip .a{animation:ficIdleLid calc(var(--sp)*1.3) ease-in-out infinite;transform-origin:left bottom}.ik-zip .c{opacity:0}\n.ik-pdf .b,.ik-doc .c,.ik-txt .c{animation:ficIdleFade calc(var(--sp)*.7) ease-in-out infinite}\n.ik-sheet .a{animation:ficCell calc(var(--sp)*1.8) ease-in-out infinite}.ik-sheet .b,.ik-sheet .c{opacity:0}\n.ik-audio .a,.ik-audio .b,.ik-audio .c{animation:ficIdleBar calc(var(--sp)*.9) ease-in-out infinite}.ik-audio .b{animation-delay:.2s}.ik-audio .c{animation-delay:.4s}\n.ik-video .a{animation:ficIdlePlay calc(var(--sp)*1.2) ease-in-out infinite}\n.ik-file .a{animation:ficIdleFade calc(var(--sp)*1.2) ease-in-out infinite}\n:is(.fcard,.fc-item):hover .fic{animation:none}\n:is(.fcard,.fc-item):hover .ik-web .fic{animation:ficTilt calc(var(--sp)*2.2) ease-in-out infinite}\n:is(.fcard,.fc-item):hover .ik-web .a{animation:ficSpinA var(--sp) linear infinite}:is(.fcard,.fc-item):hover .ik-web .b{animation:ficSpinB var(--sp) linear infinite}\n:is(.fcard,.fc-item):hover :is(.ik-vector,.ik-image) .a{animation:ficSun calc(var(--sp)*1.5) ease-in-out infinite}\n:is(.fcard,.fc-item):hover :is(.ik-vector,.ik-image) .b{animation:ficDraw calc(var(--sp)*1.4) ease-in-out infinite}\n:is(.fcard,.fc-item):hover .ik-braces .a{animation:ficBrL var(--sp) ease-in-out infinite}:is(.fcard,.fc-item):hover .ik-braces .b{animation:ficBrR var(--sp) ease-in-out infinite}\n:is(.fcard,.fc-item):hover .ik-code .a{animation:ficChL var(--sp) ease-in-out infinite}:is(.fcard,.fc-item):hover .ik-code .b{animation:ficChR var(--sp) ease-in-out infinite}:is(.fcard,.fc-item):hover .ik-code .c{animation:ficSlash var(--sp) ease-in-out infinite}\n:is(.fcard,.fc-item):hover .ik-zip .a{animation:ficLid calc(var(--sp)*1.5) ease-in-out infinite;transform-origin:left bottom}:is(.fcard,.fc-item):hover .ik-zip .c{animation:ficItem calc(var(--sp)*1.5) ease-in-out infinite}:is(.fcard,.fc-item):hover .ik-zip .b{animation:ficZip var(--sp) ease-in-out infinite}\n:is(.fcard,.fc-item):hover :is(.ik-pdf,.ik-doc,.ik-txt) :is(.a,.b,.c),:is(.fcard,.fc-item):hover .ik-file .b{stroke-dasharray:1 1;animation:ficDraw calc(var(--sp)*1.6) ease-in-out infinite}\n:is(.fcard,.fc-item):hover :is(.ik-pdf,.ik-doc,.ik-txt) .b,:is(.fcard,.fc-item):hover :is(.ik-pdf,.ik-doc,.ik-txt) .c{animation-delay:.25s}:is(.fcard,.fc-item):hover :is(.ik-doc,.ik-txt) .c{animation-delay:.5s}\n:is(.fcard,.fc-item):hover .ik-sheet .a{animation:ficCell calc(var(--sp)*1.5) ease-in-out infinite}:is(.fcard,.fc-item):hover .ik-sheet .b{animation:ficCell calc(var(--sp)*1.5) .3s ease-in-out infinite}:is(.fcard,.fc-item):hover .ik-sheet .c{animation:ficCell calc(var(--sp)*1.5) .6s ease-in-out infinite}\n:is(.fcard,.fc-item):hover .ik-audio :is(.a,.b,.c){animation:ficBar calc(var(--sp)*.55) ease-in-out infinite}:is(.fcard,.fc-item):hover .ik-audio .b{animation-delay:.15s}:is(.fcard,.fc-item):hover .ik-audio .c{animation-delay:.3s}\n:is(.fcard,.fc-item):hover .ik-video .a{animation:ficPlay var(--sp) ease-in-out infinite}:is(.fcard,.fc-item):hover .ik-video .b{animation:ficRing var(--sp) ease-out infinite}\n:is(.fcard,.fc-item):hover .ik-file .a{animation:ficFold calc(var(--sp)*1.2) ease-in-out infinite;transform-origin:top right}\n/* 2.2.9 : sélection groupée */\n.chipw{display:inline-flex;align-items:center;gap:2px}\n.chipsel{font:inherit;font-size:15px;line-height:1;color:var(--dim);background:transparent;border:0;border-radius:8px;padding:4px 5px;cursor:pointer}\n.chipsel:hover:not(:disabled){background:var(--hover);color:var(--acc)}.chipsel.on{color:var(--acc)}.chipsel:disabled{opacity:.3;cursor:default}\n#fselbar{display:flex;align-items:center;gap:10px;flex-wrap:wrap;background:var(--soft);border:1px solid var(--acc);border-radius:12px;padding:8px 14px;margin:0 0 14px;font-size:13px}\n#fselbar[hidden]{display:none}#fselbar .sp{flex:1}\n.fcard{position:relative}.fcard.sel{border-color:var(--acc);box-shadow:0 0 0 1px var(--acc) inset}\n.fck{position:absolute;top:8px;right:8px;z-index:2;display:flex;cursor:pointer}.fck input{width:16px;height:16px;accent-color:var(--acc);cursor:pointer;margin:0}\n/* 2.2.8 : classement automatique */\n#fauto{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:12px 14px;margin:0 0 14px}\n#fauto[hidden]{display:none}\n#fauto .ap-h{display:flex;align-items:center;gap:10px;margin-bottom:6px}\n#fauto .ap{border-top:1px solid var(--line);padding:8px 0}\n#fauto .ap label{display:flex;align-items:center;gap:8px;font-size:13px;flex-wrap:wrap}\n#fauto .apn{font-weight:600}\n#fauto .apin{font:inherit;font-size:13px;font-weight:600;color:var(--txt);background:var(--bg);border:1px solid var(--line);border-radius:8px;padding:3px 8px;min-width:160px}\n#fauto .tag{font-style:normal;font-size:11px;color:var(--acc);background:var(--soft);border-radius:999px;padding:2px 8px}\n#fauto ul{margin:4px 0 0 26px;padding:0;list-style:none;font-size:12px;color:var(--dim)}\n#fauto .ap-f{display:flex;align-items:center;gap:8px;flex-wrap:wrap;border-top:1px solid var(--line);padding-top:10px;margin-top:4px}\n#fauto .ap-f .sp{flex:1}\n/* 2.2.7 : limite avec heure de retour, scanner */\n.bd .until{font-size:11px;font-weight:600;margin-left:3px;font-variant-numeric:tabular-nums}\n.bd.err{align-items:center}\n#fscan{display:flex;align-items:center;gap:12px;flex-wrap:wrap;background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:10px 14px;margin:0 0 14px}\n#fscan[hidden]{display:none}\n#fscan .st{font-size:13px;flex:1;min-width:200px}\n#fscan .pb{flex:1 1 160px;height:6px;border-radius:6px;background:var(--line);overflow:hidden}#fscan .pb i{display:block;height:100%;width:0;background:var(--acc);transition:width .25s}\n#fscan pre{flex:1 1 100%;margin:2px 0 0;font-size:12px;white-space:pre-wrap;max-height:150px;overflow:auto;color:var(--dim)}\n#ficols{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:14px;margin:0 0 18px}\n#ficols[hidden]{display:none}\n.fc-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px;flex-wrap:wrap}\n.fc-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:10px}\n.fc-item{display:flex;align-items:center;gap:11px;padding:8px;border:1px solid var(--line);border-radius:12px;cursor:pointer}\n.fc-item .ftile{width:40px;height:46px;border-radius:10px}.fc-item .fic{width:21px;height:21px}\n.fc-n{flex:1;font-size:13px;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.fc-item input[type=color]{width:34px;height:30px;padding:0;border:1px solid var(--line);border-radius:8px;background:none;cursor:pointer}\n\n/* 2.3.0 */\n#ftools{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin:0 0 14px}\n#ftools select,.finp{font:inherit;font-size:13px;color:var(--txt);background:var(--panel);border:1px solid var(--line);border-radius:9px;padding:6px 9px;outline:none;cursor:pointer}\n.finp{cursor:text;min-width:140px}.finp:focus,#ftools select:hover{border-color:var(--acc)}\n#ftools .sp{flex:1}\n#ftools .vt{display:inline-flex;border:1px solid var(--line);border-radius:9px;overflow:hidden}\n#ftools .vt button{font:inherit;background:var(--panel);color:var(--dim);border:0;padding:6px 10px;cursor:pointer}#ftools .vt button.on{background:var(--soft);color:var(--acc)}\n#fgrid.list{grid-template-columns:1fr;gap:8px}\n#fgrid.list .fcard{flex-direction:row;align-items:center;gap:14px;padding:10px 14px}\n#fgrid.list .fcard .frow{flex:1}#fgrid.list .fact2{margin:0}\n#fgrid.list .fthumb{width:52px;height:52px;margin:0;flex:none}\n.ftags{display:flex;flex-wrap:wrap;gap:4px;margin-top:3px}\n.ftag{font:inherit;font-size:11.5px;color:var(--acc);background:var(--soft);border:0;border-radius:999px;padding:1px 8px;cursor:pointer}\n.ftag.add{color:var(--dim);background:transparent;border:1px dashed var(--line)}\n.fstar{color:var(--dim)}.fstar.on{color:#E0A526}\n#fprev{position:fixed;inset:0;z-index:90;background:rgba(0,0,0,.6);display:grid;place-items:center;backdrop-filter:blur(3px)}#fprev[hidden]{display:none}\n.pvbox{width:min(920px,92vw);height:min(80vh,760px);background:var(--panel);border:1px solid var(--line);border-radius:16px;display:flex;flex-direction:column;overflow:hidden;box-shadow:var(--shadow)}\n.pvhead{display:flex;align-items:center;gap:10px;padding:10px 14px;border-bottom:1px solid var(--line)}.pvhead .sp{flex:1}\n#pvbody{flex:1;overflow:auto;display:grid;place-items:center;min-height:0}#pvbody img{max-width:100%;max-height:100%;object-fit:contain}#pvbody iframe{width:100%;height:100%;border:0}\n#pvbody pre{margin:0;align-self:stretch;justify-self:stretch;padding:14px;white-space:pre-wrap;word-break:break-word;font:12.5px/1.5 ui-monospace,Consolas,monospace;text-align:left;overflow:auto}\n</style></head><body>\n<div id=\"splash\"><svg viewBox=\"0 0 120 120\"><g>\n<line class=\"ln\" x1=\"60\" y1=\"60\" x2=\"60\" y2=\"14\" style=\"animation-delay:.1s\"/><line class=\"ln\" x1=\"60\" y1=\"60\" x2=\"20\" y2=\"94\" style=\"animation-delay:.25s\"/><line class=\"ln\" x1=\"60\" y1=\"60\" x2=\"100\" y2=\"94\" style=\"animation-delay:.4s\"/>\n<circle class=\"nd\" cx=\"60\" cy=\"14\" r=\"9\" style=\"animation-delay:.35s\"/><circle class=\"nd\" cx=\"20\" cy=\"94\" r=\"9\" style=\"animation-delay:.5s\"/><circle class=\"nd\" cx=\"100\" cy=\"94\" r=\"9\" style=\"animation-delay:.65s\"/>\n<circle class=\"rg\" cx=\"60\" cy=\"60\" r=\"11\"/><circle class=\"ct\" cx=\"60\" cy=\"60\" r=\"13\"/></g></svg><div class=\"wm\">AI HUB</div></div>\n\n<aside>\n  <div class=\"brand\"><svg viewBox=\"0 0 120 120\" fill=\"currentColor\" stroke=\"currentColor\"><line x1=\"60\" y1=\"60\" x2=\"60\" y2=\"18\" stroke-width=\"7\" stroke-linecap=\"round\"/><line x1=\"60\" y1=\"60\" x2=\"24\" y2=\"92\" stroke-width=\"7\" stroke-linecap=\"round\"/><line x1=\"60\" y1=\"60\" x2=\"96\" y2=\"92\" stroke-width=\"7\" stroke-linecap=\"round\"/><circle cx=\"60\" cy=\"16\" r=\"12\" stroke=\"none\"/><circle cx=\"22\" cy=\"94\" r=\"12\" stroke=\"none\"/><circle cx=\"98\" cy=\"94\" r=\"12\" stroke=\"none\"/><circle cx=\"60\" cy=\"60\" r=\"15\" stroke=\"none\"/></svg><h1>AI Hub</h1></div>\n  <button id=\"newproj\" class=\"btn pri wide\" data-ic=\"plus\">Nouveau projet</button>\n  <div class=\"grp pgrp\">Projets</div>\n  <div id=\"plist\"></div>\n  <div id=\"keysbox\">\n    <button id=\"keystog\" class=\"keyshead\" type=\"button\" aria-expanded=\"true\"><span class=\"kt\">Clés <small>(comptes IA)</small></span><em id=\"kcount\"></em><svg class=\"ic chev\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m6 9 6 6 6-6\"/></svg></button>\n    <div id=\"keysbody\"><button id=\"add\" class=\"btn wide\" data-ic=\"plus\">Ajouter une clé</button><div id=\"list\"></div></div>\n  </div>\n  <button id=\"filesbtn\" class=\"btn ghost wide left\" data-ic=\"folder\">Fichiers<span class=\"pill\" id=\"fcount\"></span></button>\n  <div class=\"foot\"><button id=\"gear\" class=\"btn ghost wide left\" data-ic=\"sliders\">Paramètres</button><button id=\"themebtn\" class=\"btn ghost ic-only\" title=\"Basculer clair / sombre\" aria-label=\"Basculer clair / sombre\"></button></div>\n</aside>\n\n<main>\n  <header><strong id=\"title\">Aucun compte sélectionné</strong>\n    <div class=\"hbtns\"><button id=\"reload\" class=\"btn ghost\" data-ic=\"refresh\">Recharger</button><button id=\"chromelogin\" class=\"btn ghost\" data-ic=\"lock\" title=\"Se connecter (Google, etc.) dans un vrai Chrome puis récupérer la session\">Connexion via Chrome</button><button id=\"handoff\" class=\"btn\" data-ic=\"swap\">Reprendre ailleurs</button><button id=\"export\" class=\"btn\" data-ic=\"copy\">Copier la conversation</button></div></header>\n  <div id=\"ask\" hidden><span id=\"asktxt\"></span><button id=\"askyes\" class=\"btn pri\">Reprendre</button><button id=\"askno\" class=\"btn\">Ignorer</button></div>\n  <div id=\"views\"><div id=\"bar\"><i></i></div>\n  <div id=\"empty\"><div><h2>Tes projets, une seule interface de chat</h2><p>Chaque compte IA est une clé : AI Hub la branche tout seul et en change quand une limite est atteinte, sans que tu quittes la conversation.</p><div class=\"ebtns\"><button id=\"newproj2\" class=\"btn pri\" data-ic=\"plus\">Créer un projet</button><button id=\"add2\" class=\"btn\" data-ic=\"plus\">Ajouter une clé</button></div></div></div>\n\n  <section id=\"chat\">\n    <div id=\"ch-top\">\n      <div class=\"ch-id\"><b id=\"ch-name\"></b><span id=\"ch-desc\"></span></div>\n      <div class=\"ch-act\">\n        <button id=\"ch-key\" class=\"btn\" type=\"button\" title=\"Quelle clé (compte) est branchée\"></button>\n        <button id=\"ch-copy\" class=\"btn ghost ico\" type=\"button\" title=\"Copier la conversation\" aria-label=\"Copier la conversation\" data-ic=\"copy\"></button>\n        <button id=\"ch-new\" class=\"btn ghost ico\" type=\"button\" title=\"Nouvelle conversation (vide l'historique du projet)\" aria-label=\"Nouvelle conversation\" data-ic=\"refresh\"></button>\n      </div>\n    </div>\n    <div id=\"ch-msgs\"></div>\n    <div id=\"ch-bar\">\n      <div id=\"ch-chips\"></div>\n      <div id=\"ch-box\">\n        <button id=\"ch-att\" class=\"btn ghost ico\" type=\"button\" title=\"Joindre des fichiers de la bibliothèque\" aria-label=\"Joindre des fichiers\" data-ic=\"clip\"></button>\n        <textarea id=\"ch-in\" rows=\"1\" placeholder=\"Écris ton message… (Entrée pour envoyer, Maj+Entrée pour un retour à la ligne)\" spellcheck=\"true\"></textarea>\n        <button id=\"ch-send\" class=\"btn pri\" type=\"button\">Envoyer</button>\n        <button id=\"ch-stop\" class=\"btn\" type=\"button\" hidden>Arrêter</button>\n      </div>\n      <div id=\"ch-hint\">Les clés répondent en arrière-plan : tu restes ici, AI Hub change de clé si une limite est atteinte.</div>\n    </div>\n  </section>\n  <div id=\"ch-menu\" hidden></div>\n\n  <section id=\"files\">\n    <div class=\"fhead\">\n      <div><h2>Fichiers</h2><p id=\"fsub\"></p></div>\n      <div class=\"fact\"><div class=\"fsearch\"><span data-ic=\"search\"></span><input id=\"fq\" placeholder=\"Rechercher un fichier…\" autocomplete=\"off\"></div><button id=\"fscanbtn\" class=\"btn\" data-ic=\"search\"><span id=\"fscanlbl\">Scanner Claude</span></button><button id=\"fautobtn\" class=\"btn\" data-ic=\"folder\">Classer automatiquement</button><button id=\"fcolbtn\" class=\"btn\" data-ic=\"sliders\">Couleurs</button><button id=\"fadd\" class=\"btn pri\" data-ic=\"plus\">Ajouter des fichiers</button></div>\n    </div>\n    <div id=\"fscan\" hidden><span class=\"st\" id=\"fscantxt\"></span><span class=\"pb\"><i id=\"fscanbar\"></i></span><button class=\"btn sm\" id=\"fscancp\">Copier le rapport</button><button class=\"btn ghost sm\" id=\"fscanx\">Fermer</button><pre id=\"fscanrep\"></pre></div><div id=\"fauto\" hidden></div><div id=\"ficols\" hidden></div><div id=\"fprojs\"></div><div id=\"fselbar\" hidden></div><div id=\"fpedit\" hidden></div>\n    <div id=\"fgrid\"></div>\n    <div id=\"fempty\"><div><div class=\"big\" data-ic=\"folder\"></div><h3>Aucun fichier pour l'instant</h3><p>Ajoute un fichier une seule fois : il sera disponible sur tous tes comptes, prêt à être joint à n'importe quelle conversation.</p><button id=\"fadd2\" class=\"btn pri\" data-ic=\"plus\">Ajouter des fichiers</button></div></div>\n    <input type=\"file\" id=\"fin\" multiple hidden>\n  </section>\n  <div id=\"fdrop\"><div><div data-ic=\"upload\"></div><b>Dépose tes fichiers ici</b><span>Ils seront disponibles sur tous tes comptes</span></div></div>\n  <div id=\"fmenu\" hidden></div>\n  <section id=\"set\">\n    <nav class=\"snav\"><h2>Paramètres</h2>\n      <button data-t=\"gen\" class=\"on\">Général</button>\n      <button data-t=\"acc\">Comptes et sauvegarde</button>\n      <button data-t=\"rel\">Reprise sur un autre compte</button>\n      <button data-t=\"upd\">Mises à jour</button>\n      <div class=\"dev-only\"><div class=\"sgrp\">Développeur</div>\n        <button data-t=\"code\" style=\"width:100%\">Code personnalisé</button><button data-t=\"det\" style=\"width:100%\">Détections</button><button data-t=\"log\" style=\"width:100%\">Journal en direct</button></div>\n    </nav>\n    <div class=\"spanes\">\n\n    <div class=\"pane on\" id=\"p-gen\">\n      <h2>Général</h2>\n      <h3>Apparence</h3>\n      <div class=\"card\"><div class=\"opt nc\"><span><b>Thème</b><small>« Système » suit le thème de Windows. Les sites (Claude, ChatGPT…) qui suivent le thème du système changent aussi.</small></span>\n        <span class=\"seg\" id=\"theme\"><button data-th=\"system\">Système</button><button data-th=\"light\">Clair</button><button data-th=\"dark\">Sombre</button></span></div></div>\n\n      <h3>Notifications</h3>\n      <div class=\"card pad\"><div class=\"line\" style=\"margin:0\"><span id=\"nstate\" class=\"pill\"></span><button id=\"nauth\" class=\"btn\"></button><button id=\"ntest\" class=\"btn\">Envoyer un test</button></div>\n        <p id=\"nhint\" style=\"margin-top:10px\"></p></div>\n      <div class=\"card\" id=\"ntypes\">\n        <label class=\"opt\"><span><b>Réponse terminée</b><small>Quand l'IA finit de répondre sur un compte que tu ne regardes pas.</small></span><input type=\"checkbox\" class=\"sw\" data-n=\"done\"></label>\n        <label class=\"opt\"><span><b>Limite atteinte</b><small>Quand un compte n'a plus de messages.</small></span><input type=\"checkbox\" class=\"sw\" data-n=\"limit\"></label>\n        <label class=\"opt\"><span><b>Reprise sur un autre compte</b><small>Quand une conversation est transférée (ou ne peut pas l'être).</small></span><input type=\"checkbox\" class=\"sw\" data-n=\"handoff\"></label>\n        <label class=\"opt\"><span><b>Compte déconnecté</b><small>Quand une session expire.</small></span><input type=\"checkbox\" class=\"sw\" data-n=\"logout\"></label>\n      </div>\n\n      <h3>Options</h3>\n      <div class=\"card\">\n        <label class=\"opt\"><span><b>Garder tous les comptes chargés en arrière-plan</b><small>Nécessaire pour détecter les limites et les réponses sur les comptes qui ne sont pas affichés.</small></span><input type=\"checkbox\" class=\"sw\" id=\"preall\"></label>\n        <label class=\"opt\"><span><b>Mode développeur</b><small>Active l'onglet « Code personnalisé » (scripts JavaScript), les détections personnalisées et le journal en direct. Désactivé : aucun script n'est exécuté.</small></span><input type=\"checkbox\" class=\"sw\" id=\"dev\"></label>\n      </div>\n    </div>\n\n    <div class=\"pane\" id=\"p-acc\">\n      <h2>Comptes et sauvegarde</h2>\n      <h3>Fichier de comptes</h3>\n      <p>Enregistre tes comptes, leurs sessions connectées et tes réglages dans UN fichier. Charge-le dans une autre instance de AI Hub (autre PC, réinstallation) : les comptes arrivent déjà connectés. Les comptes déjà présents sont conservés.</p>\n      <p class=\"warn\">Ce fichier donne accès à tes comptes sans mot de passe. Mets un mot de passe de chiffrement, et ne le partage jamais.</p>\n      <div class=\"line\"><input id=\"pass\" type=\"password\" placeholder=\"Mot de passe de chiffrement\" autocomplete=\"off\" style=\"width:260px\">\n        <button id=\"exp\" class=\"btn pri\">Enregistrer dans un fichier</button><button id=\"imp\" class=\"btn\">Charger depuis un fichier</button></div>\n      <p id=\"msg\"></p>\n      <h3>Sécurité des données</h3>\n      <p>Les comptes sont enregistrés avec des copies de secours automatiques, et une seule fenêtre AI Hub peut tourner à la fois. Si un compte a disparu de la liste, sa session existe peut-être encore :</p>\n      <div class=\"line\"><button id=\"recover\" class=\"btn\">Retrouver les comptes perdus</button><button id=\"opendata\" class=\"btn\">Ouvrir le dossier des données</button></div>\n    </div>\n\n    <div class=\"pane\" id=\"p-rel\">\n      <h2>Reprise sur un autre compte</h2>\n      <p class=\"lead\">Quand un compte atteint sa limite, AI Hub reprend la conversation sur un autre compte et prépare le message de reprise.</p>\n      <div class=\"card\">\n        <label class=\"opt\"><span><b>Reprise automatique</b><small>Détecte la limite et lance la reprise sans que tu aies à intervenir.</small></span><input type=\"checkbox\" class=\"sw\" data-r=\"enabled\"></label>\n        <div class=\"opt nc\"><span><b>Quand la limite est atteinte</b></span><select data-r=\"mode\"><option value=\"auto\">Reprendre tout de suite</option><option value=\"ask\">Me demander d'abord</option></select></div>\n        <label class=\"opt\"><span><b>Même plateforme seulement</b><small>Ex. de Claude vers un autre compte Claude.</small></span><input type=\"checkbox\" class=\"sw\" data-r=\"samePlatform\"></label>\n        <label class=\"opt\"><span><b>Envoyer le message automatiquement</b><small>Sinon, le message est collé dans la zone de saisie et tu valides toi-même (recommandé pour commencer).</small></span><input type=\"checkbox\" class=\"sw\" data-r=\"send\"></label>\n      </div>\n      <h3>Contenu transmis</h3>\n      <div class=\"card\">\n        <label class=\"opt\"><span><b>Résumer les longues conversations avec Gemini</b><small id=\"sumnote\"></small></span><input type=\"checkbox\" class=\"sw\" data-r=\"summary\"></label>\n        <div class=\"opt nc\"><span><b>Consigne donnée à l'IA</b></span><select data-r=\"tpl\"><option value=\"continue\">Continuer directement le travail</option><option value=\"ready\">Répondre « Prêt » et attendre</option></select></div>\n        <div class=\"opt nc\"><span><b>Taille maximale</b><small>En caractères. Au-delà, les messages du milieu sont omis (le début et la fin sont gardés).</small></span><input type=\"number\" data-r=\"maxChars\" min=\"5000\" max=\"300000\" step=\"5000\" style=\"width:110px\"></div>\n      </div>\n      <details><summary>Modèle du message (avancé)</summary>\n        <p>Laisse vide pour utiliser le modèle intégré. Variables : <code>{plateforme}</code> <code>{compte}</code> <code>{contexte}</code> <code>{suite}</code> <code>{date}</code></p>\n        <textarea id=\"custom\" data-r=\"custom\" spellcheck=\"false\" placeholder=\"[REPRISE] Voici le contexte :&#10;{contexte}&#10;&#10;{suite}\"></textarea></details>\n\n      <h3>Résumé par IA (Gemini)</h3>\n      <p>La conversation est envoyée à Google pour être résumée. Sans clé, ou si Gemini ne répond pas, la conversation est transmise en entier (tronquée si trop longue). La clé est stockée dans le fichier de données de l'app (et dans le fichier de comptes exporté, chiffré si tu mets un mot de passe).</p>\n      <div class=\"line\"><input id=\"gkey\" type=\"password\" placeholder=\"Clé API Gemini\" autocomplete=\"off\" style=\"width:300px\"><input id=\"gmodel\" placeholder=\"modèle\" style=\"width:200px\"><button id=\"gtest\" class=\"btn\">Tester</button></div>\n      <p id=\"gmsg\"></p>\n\n      <h3>Dernières reprises</h3>\n      <pre id=\"hlist\">Aucune reprise pour l'instant.</pre>\n\n      <details><summary>Lecture des conversations (si un site a changé)</summary>\n        <p>Si un site change son code et que l'app ne lit plus la conversation (icône d'alerte dans la liste des comptes), ajoute ici des sélecteurs CSS : ils s'ajoutent aux sélecteurs d'origine, sans mise à jour de l'app. Sépare plusieurs sélecteurs par des virgules. Pour en trouver un : clic droit sur l'élément dans Chrome &gt; Inspecter.</p>\n        <div class=\"line\"><select id=\"selplat\"></select></div>\n        <div class=\"line\"><input id=\"sel-user\" placeholder=\"Tes messages\" style=\"flex:1\"><input id=\"sel-ai\" placeholder=\"Réponses de l'IA\" style=\"flex:1\"></div>\n        <div class=\"line\"><input id=\"sel-comp\" placeholder=\"Zone de saisie\" style=\"flex:1\"><input id=\"sel-stop\" placeholder=\"Bouton Stop\" style=\"flex:1\"><input id=\"sel-send\" placeholder=\"Bouton Envoyer\" style=\"flex:1\"></div>\n        <div class=\"line\"><button id=\"selsave\" class=\"btn pri\">Enregistrer les sélecteurs</button><button id=\"diag\" class=\"btn\">Tester les sélecteurs (comptes chargés)</button></div>\n        <pre id=\"diagout\" style=\"display:none\"></pre></details>\n    </div>\n\n    <div class=\"pane\" id=\"p-upd\">\n      <h2>Mises à jour</h2>\n      <h3>Version</h3><div id=\"upinfo\" class=\"dim\"></div>\n      <p>Une mise à jour est un fichier <code>.aihubupdate</code>. Avant de l'installer, tes données sont copiées dans les sauvegardes. Si la nouvelle version ne démarre pas correctement, l'app revient toute seule à la précédente.</p>\n      <div class=\"line\"><button id=\"upapply\" class=\"btn pri\">Installer un fichier de mise à jour</button><button id=\"uprev\" class=\"btn\">Revenir à la version précédente</button><button id=\"uporig\" class=\"btn\">Revenir à la version d'origine</button></div>\n      <p id=\"upmsg\"></p>\n      <div class=\"dev-only\"><h3>Exporter le logiciel (mode développeur)</h3>\n        <p>Crée un fichier ZIP avec tout le logiciel tel qu'il est maintenant (version active + fichiers du lanceur), plus un paquet <code>.aihubupdate</code> prêt à réinstaller. Tes comptes, cookies et conversations ne sont <b>pas</b> inclus.</p>\n        <div class=\"line\"><button id=\"packzip\" class=\"btn\">Exporter le logiciel en ZIP</button></div><p id=\"packmsg\"></p></div>\n      <h3>Versions installées</h3><pre id=\"upvers\"></pre>\n      <h3>Historique</h3><pre id=\"uphist\"></pre>\n    </div>\n\n    <div class=\"pane\" id=\"p-code\">\n      <h2>Code personnalisé</h2>\n      <p>Mode développeur. Ton code s'exécute dans l'app avec un accès complet à tes comptes et réagit aux événements. Il est relancé à chaque enregistrement et au démarrage. La reprise sur un autre compte est déjà intégrée (onglet « Reprise ») : inutile de la refaire ici, ou tu risques une double reprise.</p>\n      <textarea id=\"code\" spellcheck=\"false\"></textarea>\n      <div class=\"line\"><button id=\"savecode\" class=\"btn pri\">Enregistrer et activer</button><button id=\"resetcode\" class=\"btn\">Remettre l'exemple</button><span id=\"cst\" class=\"dim\"></span></div>\n      <details open><summary>API disponible</summary><pre>on('limit-hit', async ev =&gt; { ... })     // '*' = tous les événements ; once(...) = une seule fois\nev = { type, detail, url, ts, account:{id,platform,name} }\n\nhub.accounts                  liste des comptes     hub.active   compte affiché\nhub.state(id?)                { gen, limited, logged, last, lastAt }\nhub.switchTo(nom|id|n°|\"Claude:nom\")                 hub.next({samePlatform, skipLimited, dir})\nhub.available({samePlatform, from})                  premier compte non limité\nhub.handoff(from?, {to, send, summary})              reprise intégrée : renvoie { ok, to, mode, chars } ou { ok:false, error }\nhub.getConversation(compte?)                         texte de la conversation (null s'il n'y en a pas)\nhub.getMessages(compte?)     hub.health(compte?)     messages lus / diagnostic des sélecteurs\nhub.exportConversation(compte?)                      idem + copie dans le presse-papiers\nhub.newChat(compte?)                                 ouvre une nouvelle conversation\nhub.paste(texte, {account, send})                    écrit dans la zone de saisie (send:true = Entrée)\nhub.send(compte?)             hub.continueOn(compte, {from, send})   (ancien nom de handoff)\nhub.summarize(texte, {platform})   hub.aiEnabled     résumé Gemini (null sans clé)\nhub.runInPage(js, compte?)   hub.reload(compte?)     hub.notify(msg)   hub.copy(texte)\nhub.log(...)   hub.store.get(k) / hub.store.set(k,v)   hub.setLimited(c, bool)   hub.rename(c, nom)   await sleep(ms)</pre></details>\n    </div>\n\n    <div class=\"pane\" id=\"p-det\">\n      <h2>Détections</h2>\n      <h3>Événements détectés automatiquement</h3>\n      <div class=\"ev\" id=\"evlist\"></div>\n      <h3>Tes propres détections</h3>\n      <p>Un événement est émis quand le sélecteur CSS existe dans la page (ou que le texte correspond à la regex), et <code>nom-gone</code> quand il disparaît.</p>\n      <div id=\"dets\"></div>\n      <div class=\"line\"><button id=\"adddet\" class=\"btn\">Ajouter une détection</button><button id=\"savedet\" class=\"btn pri\">Enregistrer</button></div>\n    </div>\n\n    <div class=\"pane\" id=\"p-log\">\n      <h2>Journal en direct</h2>\n      <div id=\"logst\" class=\"dim\"></div>\n      <div class=\"line\"><input id=\"lf\" placeholder=\"Filtrer (ex. limit, handoff, claude…)\"><button id=\"logclr\" class=\"btn\">Vider</button><button id=\"logcp\" class=\"btn\">Copier en JSON</button></div>\n      <pre id=\"logl\"></pre>\n    </div>\n\n    </div>\n  </section></div>\n</main>\n\n<dialog id=\"dlg\"><h3>Nouvelle clé (compte IA)</h3>\n  <label for=\"plat\">Plateforme</label><select id=\"plat\"></select>\n  <label for=\"name\">Nom du compte</label><input id=\"name\" placeholder=\"ex. perso, lycée, projet\" autocomplete=\"off\">\n  <div class=\"row\"><button id=\"cancel\" class=\"btn\">Annuler</button><button id=\"ok\" class=\"btn pri\">Ajouter</button></div></dialog>\n<dialog id=\"dlgC\"><h3>Connexion via Google Chrome</h3>\n  <p class=\"dim\" id=\"cinfo\"></p>\n  <p>Google refuse la connexion dans les fenêtres intégrées comme AI Hub. Ici, tu te connectes dans un vrai Chrome (avec Google, comme d'habitude), puis AI Hub récupère la session pour ce compte.</p>\n  <ol class=\"dim\" style=\"margin:6px 0 10px 18px;line-height:1.7\"><li>Clique « Ouvrir Chrome ».</li><li>Connecte-toi sur le site (« Continuer avec Google »…).</li><li>Reviens ici et clique « J'ai fini : importer ».</li></ol>\n  <p id=\"cmsg\"></p>\n  <div class=\"row\"><button id=\"cclose\" class=\"btn\">Fermer</button><button id=\"copen\" class=\"btn\">Ouvrir Chrome</button><button id=\"cimp\" class=\"btn pri\" disabled>J'ai fini : importer</button></div></dialog>\n<dialog id=\"dlg2\"><h3>Renommer le compte</h3><label for=\"rname\">Nom</label><input id=\"rname\" autocomplete=\"off\">\n  <div class=\"row\"><button id=\"rcancel\" class=\"btn\">Annuler</button><button id=\"rok\" class=\"btn pri\">Enregistrer</button></div></dialog>\n<dialog id=\"dlgH\"><h3>Reprendre sur un autre compte</h3>\n  <p class=\"dim\" id=\"hsrc\"></p>\n  <label for=\"hto\">Compte de destination</label><select id=\"hto\"></select>\n  <label for=\"hmode\">Contenu transmis</label><select id=\"hmode\"><option value=\"sum\">Résumé + derniers échanges (si Gemini est configuré)</option><option value=\"full\">Conversation complète</option></select>\n  <label class=\"inl\"><input type=\"checkbox\" class=\"sw\" id=\"hsend\"> Envoyer le message automatiquement</label>\n  <div class=\"row\"><button id=\"hcancel\" class=\"btn\">Annuler</button><button id=\"hok\" class=\"btn pri\">Reprendre</button></div></dialog>\n<dialog id=\"dlgN\"><h3>Activer les notifications ?</h3>\n  <p class=\"dim\">AI Hub peut t'envoyer une notification Windows quand une réponse est terminée sur un autre compte, quand une limite est atteinte ou quand une conversation est reprise ailleurs. Tu peux choisir les types de notifications dans Paramètres &gt; Général.</p>\n  <div class=\"row\"><button id=\"nno\" class=\"btn\">Refuser</button><button id=\"nlater\" class=\"btn\">Plus tard</button><button id=\"nyes\" class=\"btn pri\" autofocus>Autoriser</button></div></dialog>\n<dialog id=\"dlgP\"><h3 id=\"pdt\">Nouveau projet</h3>\n  <label for=\"pdn\">Nom du projet</label><input id=\"pdn\" maxlength=\"60\" autocomplete=\"off\" placeholder=\"ex. Robot DeskBuddy, Mod CinematicMC\">\n  <label for=\"pdd\">Instructions / contexte (facultatif)</label><textarea id=\"pdd\" rows=\"5\" style=\"width:100%;resize:vertical\" placeholder=\"Ce texte est donné à l'IA au début de chaque nouveau fil du projet (par ex. le but, le style de réponse voulu).\"></textarea>\n  <div class=\"row\"><button id=\"pdc\" class=\"btn\" type=\"button\">Annuler</button><button id=\"pdok\" class=\"btn pri\" type=\"button\">Créer</button></div></dialog>\n<div id=\"toast\"></div>\n<script>\nconst P={Claude:['https://claude.ai/new','#e0905f'],ChatGPT:['https://chatgpt.com','#3ecf9e'],Gemini:['https://gemini.google.com','#6e9bff'],'Le Chat':['https://chat.mistral.ai','#ff8a3d'],Copilot:['https://copilot.microsoft.com','#a98bff'],Perplexity:['https://www.perplexity.ai','#35c4d6'],Grok:['https://grok.com','#8a8a98'],DeepSeek:['https://chat.deepseek.com','#5b7cff']};\nconst ICONS={plus:'<path d=\"M5 12h14M12 5v14\"/>',sliders:'<path d=\"M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6\"/>',edit:'<path d=\"M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z\"/>',x:'<path d=\"M18 6 6 18M6 6l12 12\"/>',copy:'<rect x=\"9\" y=\"9\" width=\"13\" height=\"13\" rx=\"2\"/><path d=\"M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1\"/>',refresh:'<path d=\"M3 12a9 9 0 0 1 15-6.7L21 8M21 3v5h-5M21 12a9 9 0 0 1-15 6.7L3 16M3 21v-5h5\"/>',swap:'<path d=\"m16 3 4 4-4 4M20 7H4M8 21l-4-4 4-4M4 17h16\"/>',lock:'<rect x=\"3\" y=\"11\" width=\"18\" height=\"11\" rx=\"2\"/><path d=\"M7 11V7a5 5 0 0 1 10 0v4\"/>',warn:'<path d=\"m21.7 18-8-14a2 2 0 0 0-3.4 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.7-3Z\"/><path d=\"M12 9v4M12 17h.01\"/>',ban:'<circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"m4.9 4.9 14.2 14.2\"/>'};\nconst IC=n=>`<svg class=\"ic\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">${ICONS[n]||''}</svg>`;\nObject.assign(ICONS,{\nfolder:'<path d=\"M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z\"/>',\nclip:'<path d=\"m21.4 11-9.2 9.2a5.5 5.5 0 0 1-7.8-7.8l9.2-9.2a3.7 3.7 0 0 1 5.2 5.2l-9.2 9.2a1.8 1.8 0 0 1-2.6-2.6l8.5-8.5\"/>',\ndl:'<path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3\"/>',\nupload:'<path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12\"/>',\ntrash:'<path d=\"M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6M10 11v6M14 11v6\"/>',\nsearch:'<circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/>',\nsun:'<circle cx=\"12\" cy=\"12\" r=\"4\"/><path d=\"M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4\"/>',\nmoon:'<path d=\"M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z\"/>'});\nlet filesOpen=false;\nconst seenA=new Set(),seenG=new Set();                       // animation d'entrée : seulement la 1re fois qu'un élément apparaît\nconst entA=id=>seenA.has(id)?'':(seenA.add(id),'enter'),entG=p=>seenG.has(p)?'':(seenG.add(p),'enter');\n\nconst EVENTS=[['page-loaded','une page finit de charger'],['url-changed','l\\'adresse change (detail: from, to)'],['new-chat','une nouvelle conversation s\\'ouvre'],['chat-opened','une ancienne conversation s\\'ouvre'],['logged-in','le compte est connecté'],['login-required','page de connexion affichée'],['session-expired','déconnecté alors qu\\'il était connecté'],['typing','tu commences à écrire'],['send-attempt','Entrée ou clic sur Envoyer (detail: preview)'],['message-sent','ta question est apparue dans la conversation'],['response-started','l\\'IA commence à répondre'],['response-complete','la réponse est terminée (chars, seconds, preview)'],['limit-hit','limite de messages / d\\'utilisation atteinte'],['limit-cleared','le message de limite a disparu'],['limit-soon','\"il vous reste N messages\"'],['rate-limit','trop de requêtes'],['overloaded','service surchargé / indisponible'],['error','erreur « something went wrong » etc.'],['chat-too-long','conversation trop longue'],['captcha','vérification « êtes-vous humain »'],['captcha-cleared','vérification passée'],['idle','aucune activité depuis 2 min'],['active','reprise après inactivité'],['tab-hidden','le compte n\\'est plus affiché'],['tab-visible','le compte est affiché'],['offline','plus de connexion internet'],['online','connexion revenue'],['code-error','(journal seulement) erreur dans ton code'],['handoff-*','(journal seulement) reprise sur un autre compte : ok, skip, fail'],['mon-nom','tes détections personnalisées (+ mon-nom-gone)']];\nconst EXAMPLE=`// Mode développeur : ton code réagit aux événements des comptes.\n// La reprise sur un autre compte est intégrée (Paramètres > Reprise) : inutile de la refaire ici.\n\n// Exemple : compter les messages envoyés par jour et par compte\n// on('message-sent', ev => {\n//   const jour = new Date().toISOString().slice(0, 10);\n//   const cle = 'msgs-' + ev.account.id + '-' + jour;\n//   hub.store.set(cle, (hub.store.get(cle) || 0) + 1);\n// });\n\n// Exemple : lancer une reprise à la main après une erreur\n// on('error', ev => hub.handoff(ev.account.id));\n`;\n// Ancien exemple (2.1) : s'il n'a pas été modifié, on le remplace pour ne pas doubler la reprise intégrée\nconst isOldExample=c=>/continueOn\\(cible/.test(c)&&c.length<1000;\nconst UA=navigator.userAgent.replace(/\\s?Electron\\/\\S+/,'').replace(/\\s?ai-hub\\/\\S+/,'');\nconst COMPOSER='[contenteditable=\"true\"],textarea';\nconst GEM='gemini-flash-latest';\nconst $=id=>document.getElementById(id);\nconst esc=s=>String(s).replace(/[&<>\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]));\nconst LS=(k,d)=>{try{const v=JSON.parse(localStorage[k]);return v??d}catch{return d}};\nconst sleep=ms=>new Promise(r=>setTimeout(r,ms));\nconst DEF=()=>({preloadAll:false,theme:'system',devMode:false,\n  notif:{enabled:null,on:{done:true,limit:true,handoff:true,logout:true}},\n  relay:{enabled:true,mode:'auto',samePlatform:true,send:false,summary:true,summaryAbove:15000,tpl:'continue',maxChars:60000,custom:''},\n  gemini:{key:'',model:GEM},selectors:{},projects:[],fcol:{}});\nfunction mergeSettings(s){const d=DEF();s=s||{};\n  return {...d,...s,notif:{...d.notif,...(s.notif||{}),on:{...d.notif.on,...((s.notif||{}).on||{})}},relay:{...d.relay,...(s.relay||{})},gemini:{...d.gemini,...(s.gemini||{})},selectors:s.selectors||{},projects:Array.isArray(s.projects)?s.projects:[],fcol:s.fcol&&typeof s.fcol==='object'?s.fcol:{}}}\nlet accs=[],active=null,detectors=[],settings=DEF(),userCode=EXAMPLE,store={},ready=false;\nlet PRE='',setOpen=false,tab='gen';  // filesOpen : voir plus haut\nconst st={},LOG=[],H={},HAND=[];\nconst stOf=id=>st[id]??={gen:false,limited:false,logged:null,last:'',lastAt:0};\nconst pub=a=>a&&{id:a.id,platform:a.p,name:a.n};\nconst save=()=>{if(ready)api.stateSave(JSON.stringify({v:3,accs,active,detectors,settings,code:userCode,store}))};\nconst toast=t=>{const e=$('toast');e.textContent=t;e.classList.add('show');clearTimeout(toast._t);toast._t=setTimeout(()=>e.classList.remove('show'),3200)};\nconst find=x=>x==null?null:typeof x==='object'?accs.find(a=>a.id===x.id)||null:accs.find(a=>a.id===x)||accs.find(a=>a.n.toLowerCase()===String(x).toLowerCase())||accs.find(a=>(a.p+':'+a.n).toLowerCase()===String(x).toLowerCase())||(/^\\d+$/.test(x)?accs[+x-1]:null)||null;\n$('plat').innerHTML=Object.keys(P).map(k=>`<option>${k}</option>`).join('');\ndocument.querySelectorAll('[data-ic]').forEach(e=>e.insertAdjacentHTML('afterbegin',IC(e.dataset.ic)));\n\n// ---------- thème ----------\nconst mq=matchMedia('(prefers-color-scheme:dark)');\nconst effTheme=()=>{const t=settings.theme||'system';return t==='system'?(mq.matches?'dark':'light'):t};\nfunction applyTheme(animate){const t=settings.theme||'system',h=document.documentElement;\n  if(animate===true){h.classList.add('themeswap');clearTimeout(applyTheme._t);applyTheme._t=setTimeout(()=>h.classList.remove('themeswap'),480)}   // fondu doux entre clair et sombre\n  h.dataset.theme=t;h.dataset.eff=effTheme();\n  document.querySelectorAll('#theme button').forEach(b=>b.classList.toggle('on',b.dataset.th===t));try{api.setTheme(t)}catch{}}\nmq.addEventListener('change',()=>{if((settings.theme||'system')==='system')applyTheme(true)});\ndocument.querySelectorAll('#theme button').forEach(b=>b.onclick=()=>{settings.theme=b.dataset.th;save();applyTheme(true)});\n\n// ---------- 2.2.2 : sélecteur animé, bouton de thème, fichiers partagés ----------\nfunction fitSeg(s){let ind=s.querySelector(':scope>.ind');if(!ind){s.insertAdjacentHTML('afterbegin','<i class=\"ind\"></i>')}\n  const b=s.querySelector('button.on');if(!b||!b.offsetWidth)return;s.style.setProperty('--x',b.offsetLeft+'px');s.style.setProperty('--w',b.offsetWidth+'px')}\ndocument.querySelectorAll('.seg').forEach(s=>{fitSeg(s);const f=()=>requestAnimationFrame(()=>fitSeg(s));\n  new ResizeObserver(f).observe(s);new MutationObserver(f).observe(s,{subtree:true,attributes:true,attributeFilter:['class'],childList:true})});\n$('themebtn').innerHTML='<span class=\"tg\"><span class=\"sun\">'+IC('sun')+'</span><span class=\"moon\">'+IC('moon')+'</span></span>';\n$('themebtn').onclick=()=>{settings.theme=effTheme()==='dark'?'light':'dark';save();applyTheme(true)};\n\n// Bibliothèque de fichiers commune à tous les comptes (stockée localement dans l'appli, IndexedDB)\nconst FDB={db:null,\n  open(){return this.db||(this.db=new Promise((ok,ko)=>{const r=indexedDB.open('aihub-files',1);r.onupgradeneeded=()=>r.result.createObjectStore('files',{keyPath:'id'});r.onsuccess=()=>ok(r.result);r.onerror=()=>ko(r.error)}))},\n  async tx(mode,fn){const db=await this.open();return new Promise((ok,ko)=>{const t=db.transaction('files',mode);let r;try{r=fn(t.objectStore('files'))}catch(x){return ko(x)}\n    t.oncomplete=()=>ok(r&&r.result);t.onerror=()=>ko(t.error);t.onabort=()=>ko(t.error)})},\n  all(){return this.tx('readonly',s=>s.getAll())},put(f){return this.tx('readwrite',s=>s.put(f))},del(id){return this.tx('readwrite',s=>s.delete(id))}};\nlet FILES=[],TRASH=[],fq='',fUrls=[],SEL=new Set();\nconst MAXF=100*1048576;\nconst fmtSize=n=>n<1024?n+' o':n<1048576?Math.round(n/1024)+' Ko':(n/1048576).toFixed(1).replace('.',',')+' Mo';\nconst extOf=n=>n.includes('.')?n.split('.').pop():'';\nconst kindOf=f=>{const e=extOf(f.name).toLowerCase(),t=f.type||'';\n  if(t.startsWith('image/'))return'image';if(e==='pdf')return'pdf';if(/^(docx?|odt|rtf)$/.test(e))return'doc';if(/^(xlsx?|csv|tsv|ods)$/.test(e))return'sheet';\n  if(/^(js|ts|jsx|tsx|py|java|c|cpp|cs|go|rs|rb|php|html|css|json|xml|ya?ml|sh|bat|sql|md)$/.test(e))return'code';if(/^(zip|rar|7z|tar|gz)$/.test(e))return'zip';return'txt'};\nasync function addFiles(list){let ok=0,big=0;\n  for(const f of list){if(f.size>MAXF){big++;continue}\n    try{await FDB.put({id:'f'+Date.now().toString(36)+Math.random().toString(36).slice(2,6),name:f.name,type:f.type||'',size:f.size,added:Date.now(),proj:(isProjId(fproj)?fproj:''),blob:f});ok++}catch{}}\n  await loadFiles();\n  toast(ok?`${ok} fichier${ok>1?'s ajoutés':' ajouté'} à la bibliothèque`+(big?` (${big} trop gros, 100 Mo max)`:''):big?'Fichier trop gros (100 Mo maximum)':'Impossible d\\'ajouter le fichier')}\nfunction openFMenu(btn,id){const m=$('fmenu');if(!accs.length)return toast('Ajoute d\\'abord un compte');\n  const by={};accs.forEach(a=>(by[a.p]??=[]).push(a));\n  m.innerHTML='<div class=\"mt\">Joindre à…</div>'+Object.keys(by).map(p=>by[p].map(a=>`<button data-acc=\"${a.id}\"><i class=\"dot\" style=\"background:${P[p][1]}\"></i><span>${esc(p)} · ${esc(a.n)}</span>${a.id===active?'<em>actif</em>':''}</button>`).join('')).join('');\n  m.dataset.file=id;m.hidden=false;\n  const r=btn.getBoundingClientRect();m.style.left=Math.max(12,Math.min(r.left,innerWidth-272))+'px';m.style.top=(r.bottom+6)+'px';\n  const h=m.offsetHeight;if(r.bottom+6+h>innerHeight-12)m.style.top=Math.max(12,r.top-h-6)+'px';\n  m.classList.remove('in');void m.offsetWidth;m.classList.add('in')}\nconst closeFMenu=()=>{$('fmenu').hidden=true};\ndocument.addEventListener('mousedown',e=>{if(!e.target.closest('#fmenu')&&!e.target.closest('[data-att]'))closeFMenu()});\ndocument.addEventListener('keydown',e=>{if(e.key==='Escape')closeFMenu()});\n$('fmenu').onclick=e=>{const b=e.target.closest('[data-acc]');if(!b)return;const id=$('fmenu').dataset.file;closeFMenu();attachFile(id,b.dataset.acc)};\n// Joint le fichier à la zone de message du compte choisi (champ d'envoi de fichier de la page, sinon collage dans la zone de saisie)\nasync function attachFile(fid,accId,o={}){const f=FILES.find(x=>x.id===fid),a=find(accId);if(!f||!a)return;\n  if(!o.stay){active=a.id;setOpen=false;filesOpen=false;save();render()}\n  const v=view(a);for(let i=0;i<60&&!v._ready;i++)await sleep(250);\n  if(!v._ready)return toast(`La page de ${a.p} n'est pas prête, réessaie dans un instant`);\n  if(f.size>25*1048576)toast('Gros fichier : le transfert peut prendre un moment…');\n  let b64;try{b64=await new Promise((ok,ko)=>{const r=new FileReader();r.onload=()=>ok(String(r.result).split(',')[1]||'');r.onerror=ko;r.readAsDataURL(f.blob)})}catch{return toast('Lecture du fichier impossible')}\n  const js=ATTACH_JS+'('+JSON.stringify(b64)+','+JSON.stringify(f.name)+','+JSON.stringify(f.type||'')+')';\n  try{const r=await v.executeJavaScript(js);\n    if(r!=='none'&&f.proj)addProjectContext(a,f.proj,f).catch(x=>toast('Contexte du projet non ajouté : '+String(x&&x.message||x).slice(0,60)));\n    toast(r==='none'?`Aucune zone de message trouvée sur ${a.p} : ouvre une conversation puis réessaie`:`Fichier transmis à ${a.p} · ${a.n}. Vérifie qu'il apparaît dans la zone de message.`)}\n  catch(x){toast('Impossible de joindre le fichier : '+String(x&&x.message||x).slice(0,80))}}\nconst ATTACH_JS=`(async(b64,name,type)=>{\n  const bin=atob(b64),u8=new Uint8Array(bin.length);for(let i=0;i<bin.length;i++)u8[i]=bin.charCodeAt(i);\n  const file=new File([u8],name,{type:type||'application/octet-stream'}),dt=new DataTransfer();dt.items.add(file);\n  const look=()=>({inp:[...document.querySelectorAll('input[type=file]')].find(i=>!i.disabled),box:document.querySelector('div[contenteditable=\"true\"],textarea,[role=textbox]')});\n  let t={};for(let i=0;i<32;i++){t=look();if(t.inp||t.box)break;await new Promise(r=>setTimeout(r,250))}\n  if(t.inp){t.inp.files=dt.files;t.inp.dispatchEvent(new Event('input',{bubbles:true}));t.inp.dispatchEvent(new Event('change',{bubbles:true}));return 'input'}\n  if(t.box){t.box.focus();t.box.dispatchEvent(new ClipboardEvent('paste',{clipboardData:dt,bubbles:true,cancelable:true}));return 'paste'}\n  return 'none'})`;\n$('fgrid').onclick=async e=>{const at=e.target.closest('[data-att]'),dl=e.target.closest('[data-dl]'),rm=e.target.closest('[data-rm]');\n  if(at)return openFMenu(at,at.dataset.att);\n  if(dl){const f=FILES.find(x=>x.id===dl.dataset.dl);if(!f)return;const a=document.createElement('a');a.href=URL.createObjectURL(f.blob);a.download=f.name;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),5000);return}\n  if(rm){const f=FILES.find(x=>x.id===rm.dataset.rm);if(!f||!confirm(`Supprimer « ${f.name} » de la bibliothèque ? (Les conversations où il a déjà été joint ne changent pas.)`))return;\n    if(String(f.id).startsWith('scan-')){(settings.scanSkip??=[]).push(f.id);save()}await FDB.del(f.id);await loadFiles()}};\n\n// ---------- 2.2.7 : scanner des fichiers de Claude (joints + créés par Claude) ----------\n// Ces deux fonctions ne tournent PAS ici : elles sont envoyées dans la page claude.ai du compte (avec sa session) via executeJavaScript.\nasync function scanListPage(){\n  const J=async u=>{const r=await fetch(u,{credentials:'include',headers:{accept:'application/json'}});if(!r.ok)throw new Error(u.replace(/[0-9a-f]{8}-[0-9a-f-]{27}/g,'…')+' → HTTP '+r.status);return r.json()};\n  const orgs=await J('/api/organizations');\n  const list=Array.isArray(orgs)?orgs:[];\n  const o=list.find(x=>(x.capabilities||[]).includes('chat'))||list[0];\n  if(!o||!o.uuid)throw new Error('organisation introuvable (compte non connecté ?)');\n  const convs=[],ids=new Set(),lim=100;\n  for(let off=0;off<3000;off+=lim){\n    let pg;try{pg=await J('/api/organizations/'+o.uuid+'/chat_conversations?limit='+lim+'&offset='+off)}catch(e){if(off===0)throw e;break}\n    if(!Array.isArray(pg))break;\n    const fresh=pg.filter(c=>c&&c.uuid&&!ids.has(c.uuid));\n    if(!fresh.length)break;\n    for(const c of fresh){ids.add(c.uuid);convs.push({uuid:c.uuid,name:c.name||''})}\n    if(pg.length<lim)break;\n  }\n  return {org:o.uuid,convs};\n}\nasync function scanConvPage(a){\n  const J=async u=>{const r=await fetch(u,{credentials:'include',headers:{accept:'application/json'}});if(!r.ok)throw new Error('HTTP '+r.status);return r.json()};\n  const c=await J('/api/organizations/'+a.org+'/chat_conversations/'+a.uuid+'?tree=True&rendering_mode=messages&render_all_tools=true');\n  const errors=[],created=new Map(),attached=[],urls=new Set();\n  const extFor=(i)=>{const t=String(i.type||'');return /html/.test(t)?'.html':/svg/.test(t)?'.svg':/react/.test(t)?'.jsx':/markdown/.test(t)?'.md':/mermaid/.test(t)?'.mmd':/code/.test(t)?('.'+(String(i.language||'txt').toLowerCase().replace(/[^a-z0-9]/g,'')||'txt')):'.txt'};\n  for(const m of (c.chat_messages||[])){\n    const when=m.created_at||'';\n    for(const t of (m.attachments||[])){if(t&&t.file_name&&typeof t.extracted_content==='string'&&t.extracted_content)attached.push({kind:'attached',name:t.file_name,text:t.extracted_content,when})}\n    for(const f of [...(m.files||[]),...(m.files_v2||[])]){\n      const nm=f&&(f.file_name||f.name);\n      const url=f&&((f.document_asset&&f.document_asset.url)||(f.preview_asset&&f.preview_asset.url)||f.preview_url||f.thumbnail_url);\n      if(nm&&url&&!urls.has(url)){urls.add(url);attached.push({kind:'attached',name:nm,url,when})}\n    }\n    for(const b of (m.content||[])){\n      if(!b||b.type!=='tool_use'||!b.input)continue;\n      const i=b.input;\n      if(typeof i.file_text==='string'&&i.path&&i.file_text)created.set(String(i.path),{kind:'created',name:String(i.path).split('/').pop(),text:i.file_text,when});\n      else if(b.name==='artifacts'&&typeof i.content==='string'&&i.content&&(i.command==='create'||i.command==='rewrite')){const base=String(i.title||i.id||'artifact');created.set('artifact:'+(i.id||base),{kind:'created',name:/\\.\\w{1,6}$/.test(base)?base:base+extFor(i),text:i.content,when})}\n    }\n  }\n  const files=[...attached.filter(f=>f.text!=null),...created.values()];\n  for(const f of attached.filter(f=>f.url)){\n    try{\n      const r=await fetch(f.url,{credentials:'include'});if(!r.ok){errors.push(f.name+' : HTTP '+r.status);continue}\n      const b=await r.blob();if(b.size>a.max){errors.push(f.name+' : trop gros');continue}\n      const u8=new Uint8Array(await b.arrayBuffer());let s='';for(let i=0;i<u8.length;i+=0x8000)s+=String.fromCharCode.apply(null,u8.subarray(i,i+0x8000));\n      files.push({kind:'attached',name:f.name,b64:btoa(s),type:b.type||'',when:f.when});\n    }catch(e){errors.push(f.name+' : '+String(e&&e.message||e))}\n  }\n  return {files,errors};\n}\nconst fnv=s=>{let h=2166136261;for(let i=0;i<s.length;i++){h^=s.charCodeAt(i);h=Math.imul(h,16777619)}return (h>>>0).toString(36)};\nconst b64Blob=(b64,type)=>{const bin=atob(b64),u=new Uint8Array(bin.length);for(let i=0;i<bin.length;i++)u[i]=bin.charCodeAt(i);return new Blob([u],{type})};\nconst MIME={html:'text/html',htm:'text/html',svg:'image/svg+xml',json:'application/json',md:'text/markdown',css:'text/css',js:'text/javascript',csv:'text/csv',xml:'application/xml'};\nconst cleanName=n=>String(n||'fichier').replace(/[\\\\/:*?\"<>|\\u0000-\\u001f]/g,'_').slice(0,120)||'fichier';\nlet scanning=false,scanStop=false,scanLog=[];\nasync function scanClaude(){\n  if(scanning){scanStop=true;$('fscanlbl').textContent='Arrêt…';return}\n  const cl=accs.filter(a=>a.p==='Claude');\n  if(!cl.length)return toast('Aucun compte Claude à scanner');\n  scanning=true;scanStop=false;scanLog=[];\n  const box=$('fscan'),say=(t,p)=>{$('fscantxt').textContent=t;if(p!=null)$('fscanbar').style.width=Math.round(p*100)+'%'},rep=()=>{$('fscanrep').textContent=scanLog.slice(-60).join('\\n')};\n  box.hidden=false;$('fscanlbl').textContent='Arrêter le scan';say('Démarrage…',0);rep();\n  const sk=new Set(settings.scanSkip||[]),have=new Set([...FILES,...TRASH].map(f=>f.id));\n  let added=0,convDone=0,convTotal=0,fails=0;\n  try{\n    for(const a of cl){\n      if(scanStop)break;\n      say('Compte '+a.n+' : ouverture de la page Claude…');\n      const v=view(a);for(let i=0;i<60&&!v._ready;i++)await sleep(250);\n      let host='';try{host=new URL(v.getURL()).hostname}catch{}\n      if(!v._ready||!/(^|\\.)claude\\.ai$/.test(host)){scanLog.push(a.n+' : page Claude non prête (connecte-toi puis relance le scan)');rep();continue}\n      let L;try{L=await v.executeJavaScript('('+scanListPage.toString()+')()')}catch(x){scanLog.push(a.n+' : liste des conversations impossible — '+String(x&&x.message||x).slice(0,160));rep();continue}\n      convTotal+=L.convs.length;scanLog.push(a.n+' : '+L.convs.length+' conversation(s) trouvée(s)');rep();\n      let idx=0,found=0;\n      const worker=async()=>{\n        while(!scanStop){\n          const c=L.convs[idx++];if(!c)return;\n          try{\n            const r=await v.executeJavaScript('('+scanConvPage.toString()+')('+JSON.stringify({org:L.org,uuid:c.uuid,max:MAXF})+')');\n            for(const f of r.files||[]){\n              const name=cleanName(f.name),id='scan-'+fnv([a.id,f.kind,c.uuid,name,f.text!=null?f.text.length:(f.b64||'').length].join('|'));\n              found++;if(sk.has(id)||have.has(id))continue;\n              const ext=extOf(name).toLowerCase(),blob=f.text!=null?new Blob([f.text],{type:MIME[ext]||'text/plain'}):b64Blob(f.b64,f.type||'application/octet-stream');\n              if(!blob.size||blob.size>MAXF)continue;\n              await FDB.put({id,name,type:blob.type,size:blob.size,added:Date.now(),proj:'',blob,src:{p:'Claude',acc:a.n,conv:c.name||'Sans titre',kind:f.kind}});\n              have.add(id);added++;\n            }\n            for(const e of r.errors||[])scanLog.push('  '+(c.name||c.uuid).slice(0,40)+' · '+e);\n          }catch(x){fails++;scanLog.push('  '+(c.name||c.uuid).slice(0,40)+' : '+String(x&&x.message||x).slice(0,120))}\n          convDone++;say(`Conversation ${convDone}/${convTotal} · ${added} nouveau${added>1?'x':''} fichier${added>1?'s':''}`,convTotal?convDone/convTotal:0);\n        }\n      };\n      await Promise.all([worker(),worker(),worker()]);\n      scanLog.push(a.n+' : '+found+' fichier(s) repéré(s) dans les conversations');rep();\n    }\n  }catch(x){scanLog.push('Erreur : '+String(x&&x.message||x))}\n  scanning=false;$('fscanlbl').textContent='Scanner Claude';\n  scanLog.push((scanStop?'Scan arrêté':'Scan terminé')+' : '+convDone+' conversation(s) lue(s), '+added+' fichier(s) ajouté(s)'+(fails?', '+fails+' erreur(s)':''));\n  say((scanStop?'Scan arrêté · ':'Scan terminé · ')+added+' fichier'+(added>1?'s ajoutés':' ajouté')+' · '+convDone+' conversation'+(convDone>1?'s':'')+' lue'+(convDone>1?'s':''),1);rep();\n  await loadFiles(false);\n  if(added)toast(added+' fichier'+(added>1?'s':'')+' ajouté'+(added>1?'s':'')+' depuis Claude');\n  if(added&&settings.autoClass!==false){try{const pl=autoPlan(FILES,PJ());if(pl.length){const r=await applyAuto(pl);if(r.n){scanLog.push('Classement automatique : '+r.n+' fichier(s) rangé(s) dans '+r.projs+' projet(s)');rep();toast(r.n+' fichier'+(r.n>1?'s classés':' classé')+' automatiquement · « Classer automatiquement » permet d\\'annuler')}}}catch(x){scanLog.push('Classement automatique impossible : '+String(x&&x.message||x).slice(0,100));rep()}}\n}\n$('fscanbtn').onclick=scanClaude;\n$('fscanx').onclick=()=>{if(!scanning)$('fscan').hidden=true};\n$('fscancp').onclick=()=>{api.copy(scanLog.join('\\n'));toast('Rapport copié')};\n$('filesbtn').onclick=()=>{filesOpen=!filesOpen;setOpen=false;render();if(filesOpen)loadFiles()};\nconst pickFiles=()=>$('fin').click();$('fadd').onclick=pickFiles;$('fadd2').onclick=pickFiles;\n$('fin').onchange=e=>{const l=[...e.target.files];e.target.value='';if(l.length)addFiles(l)};\n$('fq').oninput=e=>{fq=e.target.value;drawFiles(false)};\nlet dragN=0;const isFileDrag=e=>e.dataTransfer&&[...e.dataTransfer.types].includes('Files');\n$('files').addEventListener('dragenter',e=>{if(!isFileDrag(e))return;e.preventDefault();dragN++;$('fdrop').classList.add('on')});\n$('files').addEventListener('dragover',e=>{if(isFileDrag(e))e.preventDefault()});\n$('files').addEventListener('dragleave',()=>{dragN=Math.max(0,dragN-1);if(!dragN)$('fdrop').classList.remove('on')});\n$('files').addEventListener('drop',e=>{e.preventDefault();dragN=0;$('fdrop').classList.remove('on');if(e.dataTransfer.files.length)addFiles([...e.dataTransfer.files])});\ndocument.addEventListener('dragover',e=>e.preventDefault());document.addEventListener('drop',e=>e.preventDefault());   // jamais d'ouverture d'un fichier lâché à côté\n\n// ---------- 2.2.6 : icônes animées par type de fichier, couleurs personnalisables ----------\nconst FI_SVG=b=>`<svg class=\"fic\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">${b}</svg>`;\nconst PG='<path d=\"M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8Z\"/><path d=\"M14 3v5h5\"/>';\nconst FI={\n  web:{n:'HTML / web',t:'#F0629A',l:'Code',s:FI_SVG('<circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M3 12h18\"/><ellipse class=\"a\" cx=\"12\" cy=\"12\" rx=\"4.4\" ry=\"9\"/><ellipse class=\"b\" cx=\"12\" cy=\"12\" rx=\"4.4\" ry=\"9\"/>')},\n  vector:{n:'SVG',t:'#8B7CFF',l:'Image',s:FI_SVG('<rect x=\"3.5\" y=\"4\" width=\"17\" height=\"16\" rx=\"3\"/><circle class=\"a\" cx=\"9\" cy=\"9.5\" r=\"1.8\"/><path class=\"b\" pathLength=\"1\" d=\"m4 18 5-5 3.5 3.5 3-3L20 17\"/>')},\n  image:{n:'Images',t:'#4DA3FF',l:'Image',s:FI_SVG('<rect x=\"3.5\" y=\"4\" width=\"17\" height=\"16\" rx=\"3\"/><circle class=\"a\" cx=\"9\" cy=\"9.5\" r=\"1.8\"/><path class=\"b\" pathLength=\"1\" d=\"m4 18 5-5 3.5 3.5 3-3L20 17\"/>')},\n  braces:{n:'JSON / YAML / XML',t:'#F5A524',l:'Code',s:FI_SVG('<path class=\"a\" d=\"M9 4C6.5 4 7 7 7 9s-.5 3-3 3c2.5 0 3 1 3 3s-.5 5 2 5\"/><path class=\"b\" d=\"M15 4c2.5 0 2 3 2 5s.5 3 3 3c-2.5 0-3 1-3 3s.5 5-2 5\"/>')},\n  code:{n:'Code',t:'#2FC9A6',l:'Code',s:FI_SVG('<path class=\"a\" d=\"m8 7-5 5 5 5\"/><path class=\"b\" d=\"m16 7 5 5-5 5\"/><path class=\"c\" d=\"m13.5 5-3 14\"/>')},\n  zip:{n:'Archives',t:'#9C9AA6',l:'Archive',s:FI_SVG('<rect class=\"c\" x=\"9.8\" y=\"9\" width=\"4.4\" height=\"3.2\" rx=\".8\" fill=\"currentColor\" stroke=\"none\"/><path class=\"a\" d=\"M3.5 4.5h17v4h-17z\"/><path d=\"M5 8.5V18a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8.5\"/><path class=\"b\" d=\"M10 13.5h4\"/>')},\n  pdf:{n:'PDF',t:'#F0603F',l:'Document',s:FI_SVG(PG+'<path class=\"a\" pathLength=\"1\" d=\"M8.5 12.5h7\"/><path class=\"b\" pathLength=\"1\" d=\"M8.5 16h5\"/>')},\n  doc:{n:'Word / documents',t:'#5B8DEF',l:'Document',s:FI_SVG(PG+'<path class=\"a\" pathLength=\"1\" d=\"M8.5 12h7\"/><path class=\"b\" pathLength=\"1\" d=\"M8.5 15h7\"/><path class=\"c\" pathLength=\"1\" d=\"M8.5 18h4\"/>')},\n  sheet:{n:'Tableurs / CSV',t:'#3DBE7A',l:'Tableur',s:FI_SVG('<rect class=\"a\" x=\"10.2\" y=\"4.6\" width=\"9.6\" height=\"4.8\" rx=\".5\" fill=\"currentColor\" stroke=\"none\"/><rect class=\"b\" x=\"10.2\" y=\"10.6\" width=\"9.6\" height=\"3.8\" rx=\".5\" fill=\"currentColor\" stroke=\"none\"/><rect class=\"c\" x=\"10.2\" y=\"15.6\" width=\"9.6\" height=\"3.8\" rx=\".5\" fill=\"currentColor\" stroke=\"none\"/><rect x=\"3.5\" y=\"4\" width=\"17\" height=\"16\" rx=\"2.5\"/><path d=\"M3.5 10h17M3.5 15h17M9.5 4v16\"/>')},\n  txt:{n:'Texte / Markdown',t:'#E3B341',l:'Texte',s:FI_SVG('<path class=\"a\" pathLength=\"1\" d=\"M5 7h14\"/><path class=\"b\" pathLength=\"1\" d=\"M5 12h14\"/><path class=\"c\" pathLength=\"1\" d=\"M5 17h9\"/>')},\n  audio:{n:'Audio',t:'#2FC4C0',l:'Audio',s:FI_SVG('<path class=\"a\" d=\"M4.5 10v4\"/><path class=\"b\" d=\"M8.5 6v12\"/><path class=\"c\" d=\"M12.5 4v16\"/><path class=\"b\" d=\"M16.5 7.5v9\"/><path class=\"a\" d=\"M20.5 10.5v3\"/>')},\n  video:{n:'Vidéo',t:'#D55CE0',l:'Vidéo',s:FI_SVG('<rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"3\"/><circle class=\"b\" cx=\"12\" cy=\"12\" r=\"4.6\"/><path class=\"a\" d=\"m10.6 9.8 3.8 2.2-3.8 2.2Z\" fill=\"currentColor\"/>')},\n  file:{n:'Autres fichiers',t:'#A3A3B0',l:'Fichier',s:FI_SVG(PG.replace('<path d=\"M14 3v5h5\"/>','<path class=\"a\" d=\"M14 3v5h5\"/>')+'<path class=\"b\" pathLength=\"1\" d=\"M8.5 14h7\"/>')}\n};\nfunction iconKind(f){const e=extOf(f.name).toLowerCase(),t=f.type||'';\n  if(/^(html?|xhtml)$/.test(e))return'web';if(e==='svg')return'vector';\n  if(t.startsWith('image/')||/^(png|jpe?g|gif|webp|bmp|ico|avif|heic)$/.test(e))return'image';\n  if(/^(json|jsonc|json5|ya?ml|toml|xml)$/.test(e))return'braces';\n  if(/^(js|mjs|cjs|ts|jsx|tsx|py|java|c|h|cpp|hpp|cs|go|rs|rb|php|css|scss|sh|bat|ps1|sql|kt|swift|lua|gd|glsl|vue)$/.test(e))return'code';\n  if(/^(zip|rar|7z|tar|gz|tgz|bz2|xz|jar|apk)$/.test(e))return'zip';if(e==='pdf')return'pdf';\n  if(/^(docx?|odt|rtf|pages)$/.test(e))return'doc';if(/^(xlsx?|csv|tsv|ods|numbers)$/.test(e))return'sheet';\n  if(/^(txt|md|markdown|log|ini|cfg|rst)$/.test(e)||t.startsWith('text/'))return'txt';\n  if(t.startsWith('audio/')||/^(mp3|wav|ogg|flac|m4a|aac)$/.test(e))return'audio';\n  if(t.startsWith('video/')||/^(mp4|webm|mov|mkv|avi)$/.test(e))return'video';\n  return'file'}\n// Couleurs : par défaut celles de FI, remplaçables par type (settings.fcol), appliquées via des variables CSS\nconst fcolOf=ik=>{const c=(settings.fcol||{})[ik];return /^#[0-9a-f]{6}$/i.test(c||'')?c:FI[ik].t};\nfunction applyFcol(){for(const ik in FI)document.documentElement.style.setProperty('--fc-'+ik,fcolOf(ik))}\nconst fileTile=f=>{const ik=iconKind(f);return `<div class=\"ftile ik-${ik}\" style=\"--tint:var(--fc-${ik})\">${FI[ik].s}</div>`};\nconst fileLabel=f=>{const d=FI[iconKind(f)],e=(extOf(f.name)||'').toUpperCase();return d.l+(e?' · '+e.slice(0,5):'')};\nfunction drawFcols(){const el=$('ficols');if(!el)return;\n  el.innerHTML='<div class=\"fc-head\"><b>Couleurs des fichiers</b><button class=\"btn ghost sm\" id=\"fcreset\">Rétablir les couleurs d\\'origine</button></div><div class=\"fc-grid\">'\n    +Object.keys(FI).map(ik=>`<label class=\"fc-item\"><span class=\"ftile ik-${ik}\" style=\"--tint:var(--fc-${ik})\">${FI[ik].s}</span><span class=\"fc-n\">${esc(FI[ik].n)}</span><input type=\"color\" data-fc=\"${ik}\" value=\"${fcolOf(ik)}\"></label>`).join('')+'</div>'}\n$('ficols').addEventListener('input',e=>{const i=e.target.closest('[data-fc]');if(!i)return;\n  (settings.fcol??={})[i.dataset.fc]=i.value;applyFcol();clearTimeout(drawFcols._t);drawFcols._t=setTimeout(save,300)});\n$('ficols').addEventListener('click',e=>{if(!e.target.closest('#fcreset'))return;settings.fcol={};save();applyFcol();drawFcols()});\n$('fcolbtn').onclick=()=>{const el=$('ficols');el.hidden=!el.hidden;if(!el.hidden)drawFcols()};\n\n// ---------- 2.2.4 : projets (tri des fichiers) + bouton « Fichiers AI Hub » dans la barre de saisie de Claude ----------\nlet fproj='all';\nconst PJ=()=>settings.projects||(settings.projects=[]);\nconst projOf=f=>PJ().find(p=>p.id===f.proj)||null;\nconst pjIdx=f=>{const i=PJ().findIndex(p=>p.id===f.proj);return i<0?1e6:i};\nconst sortP=(a,b)=>{const s=settings.fsort||'new',nm=(x,y)=>x.name.localeCompare(y.name,'fr',{numeric:true}),c=s==='old'?a.added-b.added:s==='az'?nm(a,b):s==='za'?nm(b,a):s==='big'?b.size-a.size:s==='small'?a.size-b.size:s==='type'?(kindOf(a).localeCompare(kindOf(b))||b.added-a.added):b.added-a.added;return fproj==='all'&&s==='new'?(pjIdx(a)-pjIdx(b)||c):c};\nconst projSel=f=>`<select class=\"psel\" data-pj=\"${f.id}\" title=\"Projet de ce fichier\"><option value=\"\">Sans projet</option>${PJ().map(p=>`<option value=\"${p.id}\"${p.id===f.proj?' selected':''}>${esc(p.name)}</option>`).join('')}</select>`;\nfunction drawProjs(){const el=$('fprojs');if(!el)return;\n  const cnt=id=>FILES.filter(f=>id==='none'?!projOf(f):f.proj===id).length;\n  const sa=id=>{const ids=catIds(id),all=ids.length&&ids.every(x=>SEL.has(x));return `<button class=\"chipsel${all?' on':''}\" data-pa=\"${id}\" title=\"${all?'Désélectionner':'Tout sélectionner'} dans cette catégorie\"${ids.length?'':' disabled'}>${all?'☑':'☐'}</button>`};\n  el.innerHTML=`<span class=\"chipw\"><button class=\"chip ${fproj==='all'?'on':''}\" data-pf=\"all\">Tous<i>${FILES.length}</i></button>${sa('all')}</span><span class=\"chipw\"><button class=\"chip ${fproj==='none'?'on':''}\" data-pf=\"none\">Non classés<i>${cnt('none')}</i></button>${sa('none')}</span>`+extraChips()\n    +PJ().map(p=>`<span class=\"chipw\"><button class=\"chip ${fproj===p.id?'on':''}\" data-pf=\"${p.id}\">${IC('folder')}${esc(p.name)}<i>${cnt(p.id)}</i></button>${sa(p.id)}</span>`).join('')\n    +trashChip()+`<button class=\"chip add\" data-pf=\"new\">${IC('plus')}Projet</button>`;\n  drawPEdit()}\nfunction drawPEdit(){const el=$('fpedit'),p=PJ().find(x=>x.id===fproj);\n  if(!p){el.hidden=true;el.innerHTML='';delete el.dataset.pid;return}\n  if(el.dataset.pid===p.id&&!el.hidden)return;           // ne pas écraser la saisie en cours\n  el.dataset.pid=p.id;el.hidden=false;\n  el.innerHTML=`<div class=\"pe-row\"><input id=\"pname\" value=\"${esc(p.name)}\" maxlength=\"60\" placeholder=\"Nom du projet\" autocomplete=\"off\"><button class=\"btn sm\" id=\"patt\">${IC('clip')}Joindre tout le projet à…</button><button class=\"btn ghost sm del\" id=\"pdel\">${IC('trash')}Supprimer le projet</button></div>\n    <textarea id=\"pdesc\" rows=\"3\" placeholder=\"Décris le projet en quelques mots (facultatif) : à quoi servent ces fichiers ? Cela améliore le résumé donné à Claude.\">${esc(p.desc||'')}</textarea>\n    <div class=\"pe-row\"><button class=\"btn sm\" id=\"psumb\">${IC('refresh')}Générer le résumé</button><span class=\"dim\" id=\"pstat\"></span></div><pre id=\"psum\"></pre>`;\n  showSum(p)}\nfunction showSum(p){const s=$('psum');if(!s)return;s.textContent=p.sum||'Pas encore de résumé : il est créé automatiquement la première fois que tu joins un fichier de ce projet (Gemini si ta clé est enregistrée, sinon un résumé par mots-clés).';\n  $('pstat').textContent=p.sum?'Source : '+p.how:''}\n$('fprojs').onclick=e=>{const b=e.target.closest('[data-pf]');if(!b)return;\n  if(b.dataset.pf==='new'){const p={id:'p'+Date.now().toString(36),name:'Nouveau projet',desc:''};PJ().push(p);fproj=p.id;save();drawFiles(false);setTimeout(()=>{const i=$('pname');if(i){i.focus();i.select()}},60);return}\n  fproj=b.dataset.pf;drawFiles(false)};\n$('fpedit').addEventListener('change',e=>{const p=PJ().find(x=>x.id===fproj);if(!p)return;\n  if(e.target.id==='pname'){p.name=e.target.value.trim()||'Projet';e.target.value=p.name;save();drawFiles(false)}\n  if(e.target.id==='pdesc'){p.desc=e.target.value;save()}});\n$('fpedit').addEventListener('click',async e=>{const p=PJ().find(x=>x.id===fproj);if(!p)return;\n  if(e.target.closest('#pdel')){if(!confirm(`Supprimer le projet « ${p.name} » ? Ses fichiers restent dans la bibliothèque (sans projet).`))return;\n    for(const f of FILES.filter(x=>x.proj===p.id))try{await FDB.put({...f,proj:''})}catch{}\n    settings.projects=PJ().filter(x=>x.id!==p.id);fproj='all';save();await loadFiles(false);return}\n  if(e.target.closest('#psumb')){$('pstat').textContent='Génération…';try{await projSummary(p,true)}catch{}showSum(p)}});\n$('fgrid').addEventListener('change',async e=>{const s=e.target.closest('select[data-pj]');if(!s)return;\n  const f=FILES.find(x=>x.id===s.dataset.pj);if(!f)return;\n  try{await FDB.put({...f,proj:s.value,man:true,auto:false})}catch{return toast('Impossible de changer le projet')}\n  await loadFiles(false)});\n\n\n// ---------- 2.2.9 : sélection par catégorie + suppression groupée ----------\nconst catIds=id=>viewList(id).map(f=>f.id);\nasync function delSelected(){const ids=[...SEL];if(!ids.length)return;\n  if(!confirm(`Supprimer ${ids.length} fichier${ids.length>1?'s':''} de la bibliothèque ? Cette action est définitive. (Les conversations où ils ont déjà été joints ne changent pas.)`))return;\n  let n=0;for(const id of ids){try{if(String(id).startsWith('scan-'))(settings.scanSkip??=[]).push(id);await FDB.del(id);n++}catch{}}\n  SEL.clear();save();await loadFiles(false);toast(n+' fichier'+(n>1?'s supprimés':' supprimé'))}\n$('fprojs').addEventListener('click',e=>{const b=e.target.closest('[data-pa]');if(!b||b.disabled)return;\n  const ids=catIds(b.dataset.pa),all=ids.length&&ids.every(x=>SEL.has(x));\n  ids.forEach(x=>all?SEL.delete(x):SEL.add(x));drawFiles(false)});\n$('fgrid').addEventListener('change',e=>{const c=e.target.closest('input[data-sel]');if(!c)return;\n  c.checked?SEL.add(c.dataset.sel):SEL.delete(c.dataset.sel);c.closest('.fcard').classList.toggle('sel',c.checked);drawProjs();drawSel()});\n$('fselbar').addEventListener('click',e=>{if(e.target.closest('#selnone')){SEL.clear();drawFiles(false)}else if(e.target.closest('#seldel'))delSelected()});\n\n// ---------- 2.2.8 : classement automatique des fichiers en projets ----------\nconst AGEN=new Set(['index','main','app','script','scripts','test','tests','readme','untitled','image','img','photo','screenshot','capture','document','doc','file','fichier','new','nouveau','copy','copie','final','old','backup','temp','tmp','data','style','styles','code','texte','text','page','sans','titre','artifact','output','result','resultat','export','download','sans titre']);\nconst ASTOP=new Set(['de','du','des','la','le','les','un','une','et','en','pour','the','of','and','to','in','mon','ma','mes']);\nconst aTok=s=>String(s||'').replace(/\\.[A-Za-z0-9]{1,6}$/,'').normalize('NFD').replace(/[\\u0300-\\u036f]/g,'').toLowerCase().replace(/\\(\\d+\\)/g,' ').split(/[^a-z0-9]+/).filter(Boolean);\nconst aSig=t=>t.length>=2&&!AGEN.has(t)&&!ASTOP.has(t);\nconst aStem=name=>{const out=[];for(const t of aTok(name)){if(/^v?\\d+$/.test(t))break;if(aSig(t))out.push(t)}return out};\nconst aCap=s=>{s=String(s).trim().slice(0,60);return s.charAt(0).toUpperCase()+s.slice(1)};\n// files : [{id,name,proj,man,src}] ; projects : [{id,name}] -> [{pid|null,name,files:[file],tokens}]\nfunction autoPlan(files,projects){\n  const hasP=f=>!!f.proj&&projects.some(p=>p.id===f.proj),elig=f=>!hasP(f)&&!f.man;\n  const par=files.map((_,i)=>i),find=i=>{while(par[i]!==i){par[i]=par[par[i]];i=par[i]}return i},uni=(a,b)=>{a=find(a);b=find(b);if(a!==b)par[b]=a};\n  const bucket={},put=(k,i)=>{if(k)(bucket[k]??=[]).push(i)};\n  const convOf=f=>{const c=f.src&&f.src.conv;return c&&!/^(sans titre|untitled)$/i.test(String(c).trim())?String(c).trim():''};\n  files.forEach((f,i)=>{const st=aStem(f.name);let k='';\n    if(st.length){k=st[0].length>=4?st[0]:st.slice(0,2).join(' ');if(k.length<3)k=''}\n    put(k&&'n|'+k,i);const c=convOf(f);if(c)put('c|'+((f.src&&f.src.acc)||'')+'|'+c.toLowerCase(),i)});\n  for(const [k,ix] of Object.entries(bucket)){if(ix.length<2)continue;if(k[0]==='c'&&ix.length>25)continue;for(let j=1;j<ix.length;j++)uni(ix[0],ix[j])}\n  const comps={};files.forEach((f,i)=>(comps[find(i)]??=[]).push(f));\n  const out=[],newByName={};\n  for(const mem of Object.values(comps)){\n    const free=mem.filter(elig);if(!free.length)continue;\n    const anch=mem.filter(hasP);let pid=null,name='';\n    if(anch.length){const c={};anch.forEach(f=>c[f.proj]=(c[f.proj]||0)+1);pid=Object.keys(c).sort((a,b)=>c[b]-c[a])[0];name=projects.find(p=>p.id===pid).name}\n    else{\n      const toks=new Set();mem.forEach(f=>{aStem(f.name).forEach(t=>toks.add(t));aTok(convOf(f)).filter(aSig).forEach(t=>toks.add(t))});\n      const hit=projects.find(p=>{const pt=aTok(p.name).filter(aSig);return pt.length&&pt.every(t=>toks.has(t))});\n      if(hit){pid=hit.id;name=hit.name}\n      else if(free.length>=2){\n        const cs={};mem.forEach(f=>{const s=aStem(f.name);if(s.length)cs[s[0]]=(cs[s[0]]||0)+1});\n        const top=Object.keys(cs).sort((a,b)=>cs[b]-cs[a])[0];\n        const cv={};mem.forEach(f=>{const c=convOf(f);if(c)cv[c]=(cv[c]||0)+1});\n        const topc=Object.keys(cv).sort((a,b)=>cv[b]-cv[a])[0];\n        if(top&&cs[top]>=Math.ceil(mem.length/2)){const m=mem.find(f=>aStem(f.name)[0]===top);name=aCap(aStem(m.name).slice(0,3).join(' '))}\n        else if(topc)name=aCap(topc);\n        else if(top)name=aCap(top);else name='Projet automatique';\n        const ex=projects.find(p=>p.name.toLowerCase()===name.toLowerCase());if(ex){pid=ex.id;name=ex.name}\n      }else continue;\n    }\n    const key=pid?'p|'+pid:'n|'+name.toLowerCase();\n    if(newByName[key]){newByName[key].files.push(...free);continue}\n    out.push(newByName[key]={pid,name,files:[...free]});\n  }\n  return out.sort((a,b)=>b.files.length-a.files.length||a.name.localeCompare(b.name));\n}\nlet autoProps=[];\nasync function applyAuto(props){\n  const created=[],moved=[];\n  for(const p of props){\n    let pid=p.pid;\n    if(!pid){const ex=PJ().find(x=>x.name.toLowerCase()===p.name.toLowerCase());\n      if(ex)pid=ex.id;else{pid='p'+Date.now().toString(36)+Math.random().toString(36).slice(2,5);PJ().push({id:pid,name:p.name,desc:'',auto:true});created.push(pid)}}\n    for(const f of p.files){const cur=FILES.find(x=>x.id===f.id);if(!cur||projOf(cur)||cur.man)continue;\n      try{await FDB.put({...cur,proj:pid,auto:true});moved.push({id:cur.id,to:pid})}catch{}}}\n  settings.lastAuto={created,moved};save();await loadFiles(false);return {n:moved.length,projs:new Set(moved.map(m=>m.to)).size}}\nasync function undoAuto(){const la=settings.lastAuto;if(!la||!la.moved||!la.moved.length)return toast('Rien à annuler');\n  let n=0;for(const m of la.moved){const f=FILES.find(x=>x.id===m.id);if(f&&f.proj===m.to&&f.auto){try{await FDB.put({...f,proj:'',auto:false});n++}catch{}}}\n  await loadFiles(false);\n  settings.projects=PJ().filter(p=>!((la.created||[]).includes(p.id)&&!FILES.some(f=>f.proj===p.id)));\n  if(!PJ().some(p=>p.id===fproj)&&!['all','none','fav','recent','trash'].includes(fproj))fproj='all';\n  settings.lastAuto=null;save();await loadFiles(false);toast(n+' fichier'+(n>1?'s remis':' remis')+' sans projet');drawAuto()}\nfunction drawAuto(){const el=$('fauto');el.hidden=false;\n  const la=settings.lastAuto,sel=autoProps.length;\n  el.innerHTML=`<div class=\"ap-h\"><b>Classement automatique</b><span class=\"dim\">${sel?sel+' regroupement'+(sel>1?'s':'')+' proposé'+(sel>1?'s':''):''}</span></div>`\n    +(sel?autoProps.map((p,i)=>`<div class=\"ap\"><label><input type=\"checkbox\" data-ap=\"${i}\" checked>${p.pid?`<span class=\"apn\">${esc(p.name)}</span>`:`<input class=\"apin\" data-apn=\"${i}\" value=\"${esc(p.name)}\" maxlength=\"60\">`}<em class=\"tag\">${p.pid?'projet existant':'nouveau projet'}</em><span class=\"dim\">${p.files.length} fichier${p.files.length>1?'s':''}</span></label><ul>${p.files.slice(0,8).map(f=>`<li>${esc(f.name)}</li>`).join('')}${p.files.length>8?`<li>… et ${p.files.length-8} autre${p.files.length-8>1?'s':''}</li>`:''}</ul></div>`).join(''):'<p class=\"dim\">Rien à classer : tous les fichiers sont déjà rangés, ou aucun n\\'a de point commun (même nom, même conversation) avec un autre. Un fichier que tu ranges toi-même n\\'est jamais déplacé.</p>')\n    +`<div class=\"ap-f\"><label class=\"dim\"><input type=\"checkbox\" id=\"apauto\"${settings.autoClass!==false?' checked':''}> Classer automatiquement après chaque scan</label><span class=\"sp\"></span>`\n    +(la&&la.moved&&la.moved.length?`<button class=\"btn ghost sm\" id=\"apundo\">Annuler le dernier classement (${la.moved.length})</button>`:'')\n    +(sel?`<button class=\"btn pri sm\" id=\"apgo\">Classer la sélection</button>`:'')+`<button class=\"btn ghost sm\" id=\"apx\">Fermer</button></div>`}\nfunction runAutoPreview(){if(!FILES.length){toast('La bibliothèque est vide');return}autoProps=autoPlan(FILES,PJ());drawAuto()}\n$('fautobtn').onclick=runAutoPreview;\n$('fauto').addEventListener('click',async e=>{\n  if(e.target.closest('#apx')){$('fauto').hidden=true;return}\n  if(e.target.closest('#apundo'))return undoAuto();\n  if(e.target.closest('#apgo')){\n    const sel=[...$('fauto').querySelectorAll('input[data-ap]')].filter(c=>c.checked).map(c=>{const p=autoProps[+c.dataset.ap];const i=$('fauto').querySelector(`input[data-apn=\"${c.dataset.ap}\"]`);return {...p,name:i?(i.value.trim()||p.name):p.name}});\n    if(!sel.length)return toast('Aucun regroupement coché');\n    const r=await applyAuto(sel);autoProps=[];drawAuto();toast(r.n+' fichier'+(r.n>1?'s classés':' classé')+' dans '+r.projs+' projet'+(r.projs>1?'s':''))}});\n$('fauto').addEventListener('change',e=>{if(e.target.id==='apauto'){settings.autoClass=e.target.checked;save()}});\n\n// Résumé d'un projet : Gemini si une clé est enregistrée, sinon repli par mots-clés. Mis en cache tant que les fichiers ne changent pas.\nconst STOPW=new Set('avec dans pour that this from have with います les des une est sur par pas plus comme mais vous nous leur ils elles cette ces aux the and for are was not you your but can will var let const function return true false null undefined import export class else then when what which about into over html json text file name type data'.split(' '));\nasync function sampleOf(f){const k=kindOf(f),e=extOf(f.name).toLowerCase();\n  if(f.size>3*1048576||!(k==='code'||k==='txt'||/^(csv|tsv|md|txt|log|ini|cfg|toml)$/.test(e)))return '';\n  try{return (await f.blob.slice(0,6000).text()).replace(/\\0/g,'').slice(0,5000)}catch{return ''}}\nfunction keywordsOf(texts,n=12){const c={};\n  for(const t of texts)for(const w of (String(t).toLowerCase().match(/[a-zà-ÿ][a-zà-ÿ0-9_]{3,}/g)||[]))if(!STOPW.has(w))c[w]=(c[w]||0)+1;\n  return Object.entries(c).sort((a,b)=>b[1]-a[1]).slice(0,n).map(x=>x[0])}\nfunction fallbackProj(p,fl,samples){\n  const kinds={};fl.forEach(f=>{const k=kindOf(f);kinds[k]=(kinds[k]||0)+1});\n  const kw=keywordsOf(fl.map(f=>f.name.replace(/[._-]/g,' ')).concat(samples,[p.desc||'',p.name]));\n  return (p.desc&&p.desc.trim()?p.desc.trim()+'\\n':'')+`Projet « ${p.name} » : ${fl.length} fichier${fl.length>1?'s':''}`+(Object.keys(kinds).length?' ('+Object.entries(kinds).map(([k,n])=>n+' '+k).join(', ')+')':'')+'.\\n'\n    +'Fichiers : '+fl.slice(0,25).map(f=>f.name).join(', ')+(fl.length>25?'…':'')+'.'+(kw.length?'\\nMots-clés : '+kw.join(', ')+'.':'')}\nasync function projSummary(p,force){\n  const fl=FILES.filter(f=>f.proj===p.id),g=settings.gemini||{},sig=(p.desc||'')+'|'+p.name+'|'+fl.map(f=>f.id+':'+f.size).sort().join(',')+'|'+(g.key?'g':'k');\n  if(!force&&p.sum&&p.sig===sig)return {text:p.sum,how:p.how};\n  const samples=[];let tot=0;\n  for(const f of fl){if(tot>24000)break;const s=await sampleOf(f);if(s){samples.push(s);tot+=s.length}}\n  let text='',how='';\n  if(g.key){toast('Résumé du projet « '+p.name+' » par Gemini…');\n    const prompt=`Résume en 120 mots maximum, en français, ce projet pour qu'une IA comprenne de quoi il s'agit quand elle reçoit l'un de ses fichiers. Dis à quoi sert le projet et le rôle probable de chaque fichier. N'invente rien : si tu ne sais pas, dis-le.\\nNom du projet : ${p.name}\\nDescription de l'utilisateur : ${p.desc||'aucune'}\\nFichiers : ${fl.map(f=>f.name+' ('+fmtSize(f.size)+')').join(', ')||'aucun'}\\n`\n      +(samples.length?'\\nExtraits de fichiers texte :\\n'+samples.map((s,i)=>'--- extrait '+(i+1)+' ---\\n'+s).join('\\n'):'');\n    try{const r=await api.gemini({key:g.key,model:g.model||GEM,system:'Tu écris des résumés de projet courts, fidèles et factuels.',prompt});\n      if(r&&r.ok&&r.text){text=String(r.text).trim();how='Gemini'}else LOG.unshift({ts:Date.now(),acc:'code',type:'summary-error',detail:'résumé de projet : '+((r&&r.error)||'échec')})}\n    catch(x){LOG.unshift({ts:Date.now(),acc:'code',type:'summary-error',detail:String(x&&x.message||x)})}}\n  if(!text){text=fallbackProj(p,fl,samples);how='mots-clés'}\n  p.sum=text;p.sig=sig;p.how=how;save();return {text,how}}\n\n// Texte ajouté dans la zone de message quand on joint un fichier d'un projet : Claude sait d'où il vient.\nconst ANN={};\nasync function addProjectContext(a,pid,f){\n  const p=PJ().find(x=>x.id===pid);if(!p)return;\n  await sleep(700);\n  const v=view(a);let url='';try{url=v.getURL()}catch{}\n  const chat=/\\/(chat|c)\\/[\\w-]{8,}/.test(url),key=a.id+'|'+pid;\n  let txt;\n  if(chat&&ANN[key]===url)txt=`[Projet « ${p.name} »${f?' · fichier joint : '+f.name:''}]\\n\\n`;\n  else{const s=await projSummary(p);\n    txt=`[CONTEXTE DU PROJET « ${p.name} »]\\n${s.text}\\n`+(f?`\\nFichier joint maintenant : ${f.name} (il fait partie de ce projet).\\n`:'')+`\\n`;\n    if(chat)ANN[key]=url}\n  await hub.paste(txt,{account:a.id});\n  toast(f?`Fichier et contexte du projet « ${p.name} » ajoutés`:`Contexte du projet « ${p.name} » ajouté`)}\nfunction pushMenu(only){\n  const d={projects:PJ().map(p=>({id:p.id,name:p.name})),files:FILES.map(f=>({id:f.id,name:f.name,size:f.size,proj:projOf(f)?f.proj:'',k:kindOf(f)}))};\n  document.querySelectorAll('webview').forEach(v=>{if(only&&v!==only)return;\n    const a=accs.find(x=>x.id===v.dataset.id);if(!a||a.p!=='Claude'||!v._ready)return;try{v.send('hub:menu',d)}catch{}})}\n// ---------- notifications ----------\n// Le système (Windows) n'affiche une notification que si l'utilisateur a autorisé AI Hub ici ; sinon, simple bulle dans l'app.\nfunction ping(type,title,body,accId,o={}){\n  const N=settings.notif;if(type!=='script'&&N.on[type]===false)return;\n  const focused=document.hasFocus();\n  if(focused||o.toast)toast(title+(body?' — '+body:''));\n  if(!focused&&N.enabled===true)api.notify(title,body||'',accId||null).catch(()=>{});\n}\nfunction drawNotif(){\n  const N=settings.notif,on=N.enabled===true;\n  $('nstate').textContent=on?'Autorisées':N.enabled===false?'Refusées':'Pas encore demandé';\n  $('nstate').className='pill '+(on?'ok':N.enabled===false?'no':'');\n  $('nauth').textContent=on?'Désactiver':'Autoriser les notifications';\n  $('nauth').classList.toggle('pri',!on);$('ntest').disabled=!on;\n  $('nhint').textContent=on?'Si rien ne s\\'affiche : Paramètres Windows > Système > Notifications > AI Hub, et vérifie que le mode « Ne pas déranger » est désactivé.':'Les notifications ne s\\'affichent que lorsque la fenêtre AI Hub n\\'est pas au premier plan.';\n  document.querySelectorAll('[data-n]').forEach(el=>{el.checked=N.on[el.dataset.n]!==false;el.closest('.opt').classList.toggle('off',!on)});\n}\nasync function testNotif(){const r=await api.notify('AI Hub','Les notifications fonctionnent.',null);\n  if(!r.ok)toast('Notifications non prises en charge par ce système.');return r.ok}\nasync function setNotif(v){settings.notif.enabled=v;save();drawNotif();if(v){const ok=await testNotif();if(!ok){settings.notif.enabled=false;save();drawNotif()}}}\n$('nauth').onclick=()=>setNotif(settings.notif.enabled!==true);\n$('ntest').onclick=testNotif;\ndocument.querySelectorAll('[data-n]').forEach(el=>el.onchange=()=>{settings.notif.on[el.dataset.n]=el.checked;save()});\n$('nyes').onclick=()=>{$('dlgN').close();setNotif(true)};\n$('nno').onclick=()=>{$('dlgN').close();setNotif(false)};\n$('nlater').onclick=()=>$('dlgN').close();\napi.onNotifClick(id=>{if(id&&find(id)){active=id;setOpen=false;filesOpen=false;save();render()}});\n\n// ---------- vues (une par compte) ----------\nconst cfg=p=>({idle:120,sel:(settings.selectors||{})[p]||{},detectors:settings.devMode?detectors.map(d=>({...d,host:d.site&&d.site!=='*'&&P[d.site]?new URL(P[d.site][0]).hostname:'*'})):[]});\nconst pushCfg=()=>document.querySelectorAll('webview').forEach(v=>{const a=find(v.dataset.id);if(a)try{v.send('hub:config',cfg(a.p))}catch{}});\n\nfunction view(a){\n  let v=document.querySelector(`webview[data-id=\"${a.id}\"]`);\n  if(!v){v=document.createElement('webview');v.dataset.id=a.id;\n    v.setAttribute('partition','persist:'+a.id);v.setAttribute('useragent',UA);v.setAttribute('allowpopups','');v.setAttribute('preload',PRE);\n    v.addEventListener('ipc-message',e=>{if(e.channel==='hub-event')handle(a,e.args[0]);else if(e.channel==='hub-attach-open')pushMenu(v);else if(e.channel==='hub-attach-pick')onMenuPick(a,e.args[0]).catch(x=>toast('Impossible de joindre : '+String(x&&x.message||x).slice(0,80)))});\n    v.addEventListener('did-start-loading',()=>{v._ld=true;bar()});v.addEventListener('did-stop-loading',()=>{v._ld=false;bar()});\n    v.addEventListener('dom-ready',()=>{v._ready=true;try{v.send('hub:config',cfg(a.p))}catch{}pushMenu(v)});\n    v.src=P[a.p][0];$('views').appendChild(v);}\n  return v;\n}\nconst bar=()=>{const v=document.querySelector(`webview[data-id=\"${active}\"]`);$('bar').classList.toggle('on',!!(v&&v._ld&&!setOpen&&!filesOpen))};\n\nfunction handle(a,ev){\n  const s=stOf(a.id),t=ev.type;\n  if(t==='page-start'){if(!(s.limited&&limAlive(a,s))){s.limited=false;s.until=0;s.limAt=0;persistLim(a)}s.gen=false;s.logged=null;return renderList()}\n  if(t==='google-blocked')toast('Google refuse la connexion dans cette fenêtre. Clique « Connexion via Chrome » (en haut) : tu te connectes dans un vrai Chrome et AI Hub récupère la session.');\n  if(t==='limit-hit'){const u=+((ev.detail||{}).until)||0;if(u&&u<=Date.now()){limReset(a);return}s.until=u||s.until||0}\n  if(t==='limit-cleared')s.until=0;\n  if(t==='response-started')s.gen=true;if(t==='response-complete')s.gen=false;\n  if(t==='limit-hit'){if(!s.limited||!s.limAt)s.limAt=ev.ts||Date.now();s.limited=true}if(t==='limit-cleared'){s.limited=false;s.limAt=0}\n  if(t==='limit-hit'||t==='limit-cleared')persistLim(a);\n  if(t==='logged-in')s.logged=true;if(t==='login-required')s.logged=false;\n  s.last=t;s.lastAt=ev.ts;\n  LOG.unshift({ts:ev.ts,acc:a.p+' · '+a.n,type:t,detail:ev.detail,url:ev.url});if(LOG.length>500)LOG.pop();\n  const e={...ev,account:pub(a)};\n  (H[t]||[]).concat(H['*']||[]).forEach(fn=>run(fn,e));          // scripts perso (vide si le mode développeur est désactivé)\n  if(t==='limit-hit')onLimit(a);\n  else if(t==='response-complete')onDone(a,ev);\n  else if(t==='session-expired')ping('logout','Compte déconnecté',a.p+' · '+a.n,a.id);\n  renderList();if(setOpen&&tab==='log')drawLog();\n}\nconst codeErr=x=>{LOG.unshift({ts:Date.now(),acc:'code',type:'code-error',detail:String(x&&x.message||x)});$('cst').textContent='Erreur : '+String(x&&x.message||x)};\nconst run=async(fn,e)=>{try{await fn(e)}catch(x){codeErr(x)}};\nfunction onDone(a,ev){\n  if(a.id===active&&!setOpen&&document.hasFocus())return;          // tu regardes déjà ce compte\n  const d=ev.detail||{};if((d.chars||0)<20)return;\n  ping('done',a.p+' · '+a.n+' a répondu',(d.preview||'').replace(/\\s+/g,' ').slice(0,110),a.id);\n}\n\n// ---------- liste des comptes ----------\nconst hm=t=>new Date(t).toLocaleTimeString('fr-FR',{hour:'2-digit',minute:'2-digit'});\nconst limReset=a=>{const v=document.querySelector(`webview[data-id=\"${a.id}\"]`);try{v&&v.send('hub:limit-reset')}catch{}};\nsetInterval(()=>{let ch=false;for(const a of accs){const s=stOf(a.id);if(s.limited&&s.until&&s.until<=Date.now()){s.limited=false;s.until=0;s.limAt=0;persistLim(a);limReset(a);ch=true;ping('limit','Limite levée',a.p+' · '+a.n+' peut de nouveau répondre',a.id)}}if(ch)renderList()},15000);\nconst badges=s=>(s.gen?'<i class=\"spin\" title=\"L\\'IA répond\"></i>':'')+(s.limited?`<em class=\"bd err\" title=\"${s.until?'Limite atteinte jusqu’à '+hm(s.until):'Limite atteinte'+(s.limAt?' (depuis '+hm(s.limAt)+')':'')}\">${IC('ban')}${s.until?`<small class=\"until\">${hm(s.until)}</small>`:''}</em>`:'')+(s.logged===false?`<em class=\"bd\" title=\"Déconnecté\">${IC('lock')}</em>`:'')+(s.degraded?`<em class=\"bd warn\" title=\"Conversation non reconnue : sélecteurs à vérifier (Paramètres > Reprise)\">${IC('warn')}</em>`:'');\nfunction renderList(){\n  const by={};accs.forEach(a=>(by[a.p]??=[]).push(a));\n  $('list').innerHTML=Object.keys(by).map(p=>`<div class=\"grp ${entG(p)}\">${esc(p)}</div>`+by[p].map((a,i)=>{const s=stOf(a.id);\n    return `<div class=\"acc ${a.id===active&&!setOpen&&!filesOpen?'on':''} ${entA(a.id)}\" style=\"--i:${i}\" data-id=\"${a.id}\"><i class=\"dot\" style=\"background:${P[p][1]}\"></i><span>${esc(a.n)}</span>${badges(s)}<b data-ren=\"${a.id}\" title=\"Renommer\">${IC('edit')}</b><b data-del=\"${a.id}\" title=\"Supprimer\">${IC('x')}</b></div>`}).join('')).join('');\n}\nfunction render(){\n  renderList();if(!PRE)return;\n  if(settings.preloadAll)accs.forEach(view);\n  document.querySelectorAll('webview').forEach(v=>v.classList.toggle('on',v.dataset.id===active));\n  const a=find(active);\n  $('title').textContent=filesOpen?'Fichiers':setOpen?'Paramètres':a?`${a.p} · ${a.n}`:'Aucun compte sélectionné';\n  $('empty').style.display=a?'none':'grid';\n  document.querySelector('.hbtns').style.visibility=(setOpen||filesOpen||!a)?'hidden':'visible';\n  $('set').classList.toggle('on',setOpen&&!filesOpen);$('files').classList.toggle('on',filesOpen);$('filesbtn').classList.toggle('on',filesOpen);\n  if(a)view(a).classList.add('on');\n  bar();\n}\n$('list').onclick=async e=>{\n  const rn=e.target.closest('[data-ren]'),d=e.target.closest('[data-del]');\n  if(rn){renId=rn.dataset.ren;$('rname').value=find(renId).n;$('dlg2').showModal();$('rname').focus();return}\n  if(d){const id=d.dataset.del,a=find(id);if(!confirm(`Supprimer ${a.p} · ${a.n} et sa session ?`))return;\n    document.querySelector(`webview[data-id=\"${id}\"]`)?.remove();await api.clear('persist:'+id);delete st[id];\n    accs=accs.filter(x=>x.id!==id);if(active===id)active=accs[0]?.id||null;save();return render();}\n  const r=e.target.closest('.acc');if(r){active=r.dataset.id;setOpen=false;filesOpen=false;save();render();}\n};\nconst openAdd=()=>{$('name').value='';$('dlg').showModal();$('name').focus()};\n$('add').onclick=openAdd;$('add2').onclick=openAdd;\n$('cancel').onclick=()=>$('dlg').close();\n$('ok').onclick=()=>{const n=$('name').value.trim();if(!n)return $('name').focus();\n  const a={id:'a'+Date.now(),p:$('plat').value,n};accs.push(a);active=a.id;setOpen=false;filesOpen=false;save();$('dlg').close();render();};\n$('name').onkeydown=e=>{if(e.key==='Enter')$('ok').click()};\n$('reload').onclick=()=>hub.reload();\n\n// ---------- lecture des conversations ----------\n// Sélecteurs d'origine (alignés sur webview-preload.js) + sélecteurs de secours de Paramètres > Reprise\nconst SELB={user:'[data-testid=\"user-message\"],user-query,[data-message-author-role=\"user\"]',ai:'.font-claude-response,model-response,[data-message-author-role]:not([data-message-author-role=\"user\"])',comp:COMPOSER,stop:'[data-testid=\"stop-button\"],button[aria-label*=\"Stop\" i],button[aria-label*=\"Arrêter\" i],button[aria-label*=\"Interrompre\" i]',send:'[data-testid=\"send-button\"],button[aria-label*=\"Send\" i],button[aria-label*=\"Envoyer\" i]'};\nconst selOf=(p,k)=>{const x=((settings.selectors||{})[p]||{})[k];return x&&x.trim()?SELB[k]+','+x.trim():SELB[k]};\nconst isChatUrl=u=>{try{return /\\/(chat|c|chats|app|thread|search|s)\\/[\\w-]{8,}/.test(new URL(u).pathname)}catch{return false}};\n// Une conversation est « reconnue » dès qu'on trouve au moins UN de tes messages (la limite peut empêcher toute réponse de l'IA)\nconst EXTRACT=a=>`(()=>{const ok=s=>{try{document.querySelector(s);return true}catch{return false}};\nconst U=${JSON.stringify(selOf(a.p,'user'))},A=${JSON.stringify(selOf(a.p,'ai'))};\nconst UU=ok(U)?U:${JSON.stringify(SELB.user)},AA=ok(A)?A:${JSON.stringify(SELB.ai)};\nconst els=[...document.querySelectorAll(UU+','+AA)];\nconst top=els.filter(e=>!els.some(o=>o!==e&&o.contains(e)));\nconst out=top.map(e=>({r:e.matches(UU)?'user':'ai',t:e.innerText.trim()})).filter(m=>m.t);\nif(out.some(m=>m.r==='user'))return {mode:'structured',msgs:out,url:location.href};\nconst m=document.querySelector('main')||document.body;\nreturn {mode:'raw',msgs:[{r:'raw',t:(m.innerText||'').trim()}],url:location.href};})()`;\nasync function read(a){\n  const r=await view(a).executeJavaScript(EXTRACT(a)),s=stOf(a.id);\n  if(r.mode==='raw'&&r.msgs[0]&&r.msgs[0].t&&isChatUrl(r.url)){        // page de conversation mais messages non reconnus\n    if(!s.degraded)LOG.unshift({ts:Date.now(),acc:a.p+' · '+a.n,type:'selector-warning',detail:'messages non reconnus : texte brut utilisé. Ajoute des sélecteurs de secours (Paramètres > Reprise).'});\n    s.degraded=true;renderList()}\n  else if(r.mode==='structured'&&s.degraded){s.degraded=false;renderList()}\n  return r}\n\n// ---------- construction du message de reprise ----------\nconst fmt=m=>(m.r==='user'?'👤 Moi : ':'🤖 IA : ')+m.t;\n// Garde le début (objectif) + la fin ; supprime des messages entiers au milieu\nfunction fit(msgs,max){\n  const all=msgs.map(fmt),size=s=>s.length+2;\n  if(all.reduce((n,s)=>n+size(s),0)<=max)return {text:all.join('\\n\\n'),cut:0};\n  const head=all[0].slice(0,Math.min(4000,Math.floor(max*.15)));\n  let budget=max-head.length-80,i=all.length-1;const tail=[];\n  while(i>0&&budget>200){const s=all[i];\n    if(size(s)<=budget){tail.unshift(s);budget-=size(s);i--}\n    else{tail.unshift('[…début du message tronqué…] '+s.slice(-(budget-40)));budget=0;i--;break}}\n  return {text:head+'\\n\\n[…'+i+' message(s) intermédiaire(s) omis…]\\n\\n'+tail.join('\\n\\n'),cut:i};\n}\nconst fitTail=(msgs,max)=>{const out=[];let n=0;for(let i=msgs.length-1;i>=0;i--){const s=fmt(msgs[i]);if(n+s.length>max&&out.length)break;out.unshift(n+s.length>max?s.slice(-max):s);n+=s.length}return {text:out.join('\\n\\n')}};\nconst TPL_CONTINUE=`[REPRISE AUTOMATIQUE] Cette conversation vient d'un autre compte {plateforme} ({compte}) qui a atteint sa limite. Tu es le relais : tu reprends le travail exactement là où il en est, sans perte.\n\n{contexte}\n\n## INSTRUCTIONS\n1. Ne dis pas bonjour, ne résume pas ce que je viens de te donner et ne repose pas de question dont la réponse figure déjà plus haut. Travaille directement.\n2. {suite}\n3. Réponds de façon concise et directe, dans le même registre et la même langue que la conversation.\n4. Si une information dont tu as besoin manque dans ce transfert, dis-le en une phrase au lieu de l'inventer.`;\nconst TPL_READY=`[CONTEXTE : conversation exportée depuis {plateforme}]\nVoici l'historique d'une conversation précédente. Lis-le en entier, retiens le contexte, réponds seulement « Prêt », puis continue la discussion à partir de là.\n\n{contexte}\n`;\nconst fill=(tpl,v)=>tpl.replace(/\\{(\\w+)\\}/g,(m,k)=>v[k]??m);\nconst ctxFull=(msgs,max)=>{const f=fit(msgs,max);return {ctx:'## CONVERSATION'+(f.cut?` (${f.cut} messages intermédiaires omis)`:'')+'\\n--- DÉBUT ---\\n'+f.text+'\\n--- FIN ---',how:f.cut?'tronqué':'complet'}};\nasync function buildHandoff(src,conv,o){\n  const R=settings.relay,msgs=conv.msgs.filter(m=>m.t);let ctx='',how='';\n  if(conv.mode==='raw'){ctx='## CONVERSATION (texte brut de la page)\\n--- DÉBUT ---\\n'+msgs[0].t.slice(-R.maxChars)+'\\n--- FIN ---';how='texte brut'}\n  else{\n    const full=msgs.map(fmt).join('\\n\\n');\n    if((o.summary??R.summary)&&hub.aiEnabled&&full.length>R.summaryAbove){\n      toast('Résumé de la conversation par Gemini…');\n      const sum=await hub.summarize(full,{platform:src.p});\n      if(sum){ctx='## RÉSUMÉ DE LA CONVERSATION\\n'+sum+'\\n\\n## FIN DE LA CONVERSATION (telle quelle)\\n'+fitTail(msgs,Math.min(8000,Math.floor(R.maxChars/4))).text;how='résumé'}\n    }\n    if(!ctx){const c=ctxFull(msgs,R.maxChars);ctx=c.ctx;how=c.how}\n  }\n  const last=msgs[msgs.length-1];\n  const suite=last&&last.r==='user'?'Ma dernière demande n\\'a pas reçu de réponse : réponds-y maintenant.'\n    :stOf(src.id).gen?'Ta dernière réponse a été interrompue par la limite : reprends-la exactement là où elle s\\'arrête, sans la recommencer.'\n    :'Continue la tâche en cours dans la logique de la fin de la conversation, avec la prochaine étape concrète. Si rien n\\'est en attente, dis-le en une ligne et attends ma prochaine demande.';\n  const tpl=R.custom&&R.custom.trim()?R.custom:R.tpl==='ready'?TPL_READY:TPL_CONTINUE;\n  const text=fill(tpl,{plateforme:src.p,compte:src.n,contexte:ctx,suite,date:new Date().toLocaleString()});\n  return {text,how,chars:text.length};\n}\n// Texte copié par le bouton « Copier la conversation » (modèle « Prêt », sans résumé)\nasync function exportPack(a){\n  const conv=await read(a);\n  if(conv.mode==='raw'&&(!isChatUrl(conv.url)||!conv.msgs[0]||!conv.msgs[0].t))return null;\n  const msgs=conv.msgs.filter(m=>m.t);if(!msgs.length)return null;\n  const body=conv.mode==='raw'?'--- DÉBUT ---\\n'+msgs[0].t.slice(-settings.relay.maxChars)+'\\n--- FIN ---':ctxFull(msgs,settings.relay.maxChars).ctx;\n  return {mode:conv.mode,n:msgs.length,txt:fill(TPL_READY,{plateforme:a.p,contexte:body})};\n}\n$('export').onclick=async()=>{\n  const a=find(active);if(!a)return toast('Sélectionne un compte d\\'abord');\n  try{const r=await exportPack(a);if(!r)return toast('Aucune conversation trouvée sur cette page');\n    await api.copy(r.txt);toast(r.mode==='raw'?'Copié : texte brut de la page (format du site non reconnu)':`Copié : ${r.n} messages. Colle-le ailleurs !`);\n  }catch(e){toast('Export impossible : '+e.message)}\n};\n\n// ---------- reprise sur un autre compte ----------\nlet HQ=Promise.resolve(),LASTANY=0;const LASTH={};\nconst enqueue=f=>{const p=HQ.then(f);HQ=p.catch(x=>hlog('fail',null,String(x&&x.message||x)));return p};   // une reprise à la fois\nconst hlog=(type,src,detail)=>LOG.unshift({ts:Date.now(),acc:src?src.p+' · '+src.n:'app',type:'handoff-'+type,detail});\nconst pickTarget=(src,visited=[])=>accs.find(x=>x.id!==src.id&&!visited.includes(x.id)&&!stOf(x.id).limited&&stOf(x.id).logged!==false&&(!settings.relay.samePlatform||x.p===src.p))||null;\nconst okSel=(a,k)=>{try{document.createDocumentFragment().querySelector(selOf(a.p,k));return selOf(a.p,k)}catch{return SELB[k]}};\n// Attend que la zone de saisie soit visible (page chargée). Renvoie true, 'login' ou false.\nasync function waitComposer(a,ms){\n  const v=view(a),t0=Date.now(),C=JSON.stringify(okSel(a,'comp'));\n  while(Date.now()-t0<ms){\n    try{const r=await v.executeJavaScript(`(()=>({c:[...document.querySelectorAll(${C})].some(e=>e.getClientRects().length>0),pw:!!document.querySelector('input[type=password]')}))()`);\n      if(r.c)return true;if(r.pw&&Date.now()-t0>4000)return 'login'}catch{}\n    await sleep(500)}\n  return false}\nfunction onLimit(a){\n  const R=settings.relay,dst=R.enabled?pickTarget(a):null;\n  if(!dst){ping('limit','Limite atteinte',a.p+' · '+a.n+(R.enabled?' — aucun autre compte disponible':''),a.id,{toast:true});return}\n  if(R.mode==='ask'){ping('limit','Limite atteinte sur '+a.p+' · '+a.n,'Ouvre AI Hub pour reprendre sur '+dst.n,a.id);return askBanner(a,dst)}\n  enqueue(()=>handoff(a.id,{to:dst.id,auto:true}));\n}\nfunction askBanner(src,dst){const b=$('ask');b.hidden=false;b.dataset.src=src.id;b.dataset.dst=dst.id;\n  $('asktxt').innerHTML=`Limite atteinte sur <b>${esc(src.p)} · ${esc(src.n)}</b>. Reprendre la conversation sur <b>${esc(dst.p)} · ${esc(dst.n)}</b> ?`}\n$('askyes').onclick=()=>{const b=$('ask');b.hidden=true;enqueue(()=>handoff(b.dataset.src,{to:b.dataset.dst}))};\n$('askno').onclick=()=>{$('ask').hidden=true};\n\nasync function handoff(fromId,o={}){\n  const R=settings.relay,src=find(fromId||active),now=Date.now();\n  const fail=(msg,silent)=>{hlog('fail',src,msg);HAND.unshift({ts:now,from:src,ok:false,err:msg});\n    if(silent)ping('limit','Limite atteinte',src.p+' · '+src.n,src.id,{toast:true});else ping('handoff','Reprise impossible',msg,src&&src.id,{toast:true});return {ok:false,error:msg}};\n  if(!src)return {ok:false,error:'compte introuvable'};\n  // garde-fous contre les boucles et les doublons (limit-hit se redéclenche à chaque rechargement de page)\n  if(o.auto&&(now-(LASTH[src.id]||0)<300000||now-LASTANY<20000)){hlog('skip',src,'reprise récente : ignorée');return {ok:false,error:'reprise récente'}}\n  let dst=o.to?find(o.to):pickTarget(src);\n  if(!dst)return fail('aucun autre compte disponible'+(R.samePlatform?' sur '+src.p:''));\n  let conv;try{conv=await read(src)}catch(e){return fail('lecture impossible : '+e.message)}\n  const text0=conv.msgs[0]&&conv.msgs[0].t;\n  if(conv.mode==='raw'){\n    if(!text0||!isChatUrl(conv.url))return fail('aucune conversation à reprendre sur '+src.p+' · '+src.n,o.auto);\n    if(o.auto)return fail('conversation non reconnue sur '+src.n+' (sélecteurs à vérifier) : reprise annulée');\n    if(!confirm('Le format de la conversation n\\'est pas reconnu : AI Hub transmettrait le texte brut de la page (avec des éléments d\\'interface). Continuer ?'))return {ok:false,cancelled:true};\n  }\n  const built=await buildHandoff(src,conv,o),visited=[src.id];\n  for(let i=0;i<accs.length&&dst;i++){\n    toast('Reprise : '+src.n+' → '+dst.n+'…');\n    hub.switchTo(dst);await hub.newChat(dst);\n    const w=await waitComposer(dst,25000);\n    if(w===true)await sleep(1500);   // la limite peut s'afficher juste après le chargement\n    if(w!==true||stOf(dst.id).limited||stOf(dst.id).logged===false){\n      hlog('skip',dst,w==='login'||stOf(dst.id).logged===false?'déconnecté':w?'limite atteinte':'page non prête');\n      visited.push(dst.id);dst=o.strict?null:pickTarget(src,visited);continue}\n    let r=await hub.paste(built.text,{account:dst,send:false});\n    if(!r.len){await sleep(1200);r=await hub.paste(built.text,{account:dst,send:false})}\n    if(!r.len){await api.copy(built.text);return fail('collage impossible sur '+dst.n+' : le message est copié dans le presse-papiers (Ctrl+V)')}\n    const send=o.send??R.send;if(send){await sleep(500);await hub.send(dst.id)}\n    LASTH[src.id]=Date.now();LASTANY=Date.now();\n    HAND.unshift({ts:Date.now(),from:src,to:dst,how:built.how,chars:built.chars,sent:!!send,ok:true});if(HAND.length>20)HAND.pop();\n    hlog('ok',src,{to:dst.p+' · '+dst.n,mode:built.how,chars:built.chars,sent:!!send});\n    ping('handoff','Reprise sur '+dst.p+' · '+dst.n,send?'Message envoyé ('+built.how+').':'Message prêt dans la zone de saisie : relis-le et valide.',dst.id,{toast:true});\n    if(setOpen&&tab==='rel')drawRel();\n    return {ok:true,to:pub(dst),mode:built.how,chars:built.chars,n:conv.msgs.length};\n  }\n  return fail('aucun compte disponible : '+(accs.length>1?'tous sont limités, déconnectés ou non prêts':'ajoute un autre compte'));\n}\n// fenêtre « Reprendre ailleurs » (manuel)\n$('handoff').onclick=()=>{const a=find(active);if(!a)return toast('Sélectionne un compte d\\'abord');\n  const others=accs.filter(x=>x.id!==a.id);if(!others.length)return toast('Ajoute un autre compte pour reprendre la conversation.');\n  const sorted=[...others].sort((x,y)=>(x.p===a.p?0:1)-(y.p===a.p?0:1)||(stOf(x.id).limited?1:0)-(stOf(y.id).limited?1:0));\n  $('hsrc').textContent='Depuis '+a.p+' · '+a.n;\n  $('hto').innerHTML=sorted.map(x=>`<option value=\"${x.id}\">${esc(x.p)} · ${esc(x.n)}${stOf(x.id).limited?' (limite atteinte)':''}${stOf(x.id).logged===false?' (déconnecté)':''}</option>`).join('');\n  $('hmode').value=settings.relay.summary&&hub.aiEnabled?'sum':'full';$('hsend').checked=!!settings.relay.send;\n  $('dlgH').dataset.src=a.id;$('dlgH').showModal()};\n$('hcancel').onclick=()=>$('dlgH').close();\n$('hok').onclick=()=>{const d=$('dlgH');d.close();\n  enqueue(()=>handoff(d.dataset.src,{to:$('hto').value,strict:true,send:$('hsend').checked,summary:$('hmode').value==='sum'})).then(r=>{if(!r.ok&&!r.cancelled&&r.error&&!/^reprise récente/.test(r.error))toast('Reprise impossible : '+r.error)}).catch(x=>toast('Reprise impossible : '+(x&&x.message||x)))};\n\n// ---------- API pour ton code (mode développeur) ----------\nconst hub={\n  get accounts(){return accs.map(pub)},get active(){return pub(find(active))},\n  state:id=>st[(find(id||active)||{}).id],\n  switchTo(x){const a=find(x);if(!a)return null;active=a.id;setOpen=false;filesOpen=false;save();render();return pub(a)},\n  available(o={}){const f=find(o.from||active);return pub(accs.find(a=>a.id!==(f&&f.id)&&!stOf(a.id).limited&&(!o.samePlatform||a.p===(f&&f.p))))||null},\n  next(o={}){const n=accs.length,i=accs.findIndex(a=>a.id===active),d=o.dir||1,cur=find(active);\n    for(let k=1;k<=n;k++){const a=accs[(((i+k*d)%n)+n)%n];\n      if(a.id!==active&&(o.skipLimited===false||!stOf(a.id).limited)&&(!o.samePlatform||a.p===cur?.p))return hub.switchTo(a)}return null},\n  async getConversation(x){const a=find(x||active);const r=a&&await exportPack(a);return r&&r.txt},\n  async exportConversation(x){const t=await hub.getConversation(x);if(t){await api.copy(t);toast('Conversation copiée')}return t},\n  async newChat(x){const a=find(x||active),v=view(a);\n    if(!v._ready)await Promise.race([new Promise(r=>v.addEventListener('dom-ready',r,{once:true})),sleep(15000)]);\n    v.loadURL(P[a.p][0]);await new Promise(r=>{v.addEventListener('did-stop-loading',r,{once:true});setTimeout(r,15000)})},\n  async paste(text,o={}){const a=find(o.account||active),v=view(a),C=JSON.stringify(okSel(a,'comp'));\n    if(!v._ready)await Promise.race([new Promise(r=>v.addEventListener('dom-ready',r,{once:true})),sleep(15000)]);\n    const pick=`(()=>{const l=[...document.querySelectorAll(${C})];return l.find(e=>e.getClientRects().length>0)||l[0]||document.querySelector(${JSON.stringify(COMPOSER)})})()`;\n    await v.executeJavaScript(`(()=>{const c=${pick};if(c)c.focus()})()`);\n    await sleep(250);v.insertText(text);await sleep(300);\n    const len=await v.executeJavaScript(`(()=>{const c=${pick};return c?(c.value||c.innerText||'').trim().length:0})()`);\n    if(o.send){await sleep(600);await hub.send(a.id)}\n    return {len}},\n  async send(x){const v=view(find(x||active));await sleep(100);\n    v.sendInputEvent({type:'keyDown',keyCode:'Enter'});v.sendInputEvent({type:'char',keyCode:'\\r'});v.sendInputEvent({type:'keyUp',keyCode:'Enter'})},\n  async getMessages(x){const a=find(x||active);if(!a)return null;const r=await read(a);\n    return r.msgs[0]&&r.msgs[0].t?{mode:r.mode,msgs:r.msgs.map(m=>({r:m.r,t:m.t}))}:null},\n  async health(x){const a=find(x||active);if(!a)return null;const v=view(a);\n    const r=await v.executeJavaScript(`(()=>{const q=s=>{try{return document.querySelectorAll(s).length}catch{return -1}};\n      let c;try{c=document.querySelector(${JSON.stringify(selOf(a.p,'comp'))})}catch{}\n      return {url:location.href,composer:q(${JSON.stringify(selOf(a.p,'comp'))}),user:q(${JSON.stringify(selOf(a.p,'user'))}),ai:q(${JSON.stringify(selOf(a.p,'ai'))}),stop:q(${JSON.stringify(selOf(a.p,'stop'))}),send:q(${JSON.stringify(selOf(a.p,'send'))}),composerLen:c?(c.value||c.innerText||'').trim().length:0}})()`);\n    return {...r,account:pub(a),mode:r.user>0&&r.ai>0?'structured':r.user+r.ai>0?'partial':'none'}},\n  get aiEnabled(){return !!(settings.gemini&&settings.gemini.key)},\n  // Résumé par Gemini ; renvoie null (jamais d'exception) si pas de clé ou en cas d'échec\n  async summarize(text,o={}){\n    const g=settings.gemini||{};if(!g.key)return null;\n    const body=String(text).slice(-(o.max||350000));\n    const sys='Tu prépares le transfert d\\'une conversation vers un autre compte de la même IA. Tu produis un résumé fidèle, dense et directement exploitable. Tu n\\'inventes rien : si une information est absente, tu écris « aucun ».';\n    const prompt=`Voici une conversation entre un utilisateur et une IA (${o.platform||'IA'}). Écris le résumé dans la langue de la conversation, en Markdown, 700 mots maximum, avec exactement ces sections :\n## Objectif et contexte\n## Où on en est (fait / en cours)\n## Décisions, contraintes et préférences de l'utilisateur (formats, style, ce qui a été refusé)\n## Éléments techniques précis (noms de fichiers, fonctions, valeurs, versions : garde les identifiants exacts ; ne recopie pas de longs blocs de code, décris leur rôle)\n## Problèmes ouverts et erreurs\n## Prochaine étape (la dernière demande de l'utilisateur, et si la dernière réponse de l'IA est terminée ou semble coupée)\n${o.extra?o.extra+'\\n':''}\n=== CONVERSATION ===\n${body}\n=== FIN ===`;\n    try{const r=await api.gemini({key:g.key,model:g.model||GEM,system:sys,prompt});\n      if(!r.ok){LOG.unshift({ts:Date.now(),acc:'code',type:'summary-error',detail:r.error});return null}\n      return r.text}\n    catch(e){LOG.unshift({ts:Date.now(),acc:'code',type:'summary-error',detail:String(e&&e.message||e)});return null}},\n  handoff:(from,o)=>enqueue(()=>handoff(from,{...o,auto:false})),\n  async continueOn(t,o={}){const r=await hub.handoff(o.from||active,{to:t,send:o.send});if(!r.ok)throw new Error(r.error);return r.n},   // ancien nom, conservé\n  runInPage:(js,x)=>view(find(x||active)).executeJavaScript(js),\n  reload(x){const a=find(x||active);if(a){const s=stOf(a.id);s.limited=false;s.until=0;s.limAt=0;persistLim(a);renderList();view(a).reload()}},\n  notify(m,o={}){toast(m);if(settings.notif.enabled===true&&!document.hasFocus())api.notify(o.title||'AI Hub',String(m),null).catch(()=>{})},\n  copy:t=>api.copy(t),\n  log(...a){LOG.unshift({ts:Date.now(),acc:'code',type:'log',detail:a.join(' ')})},\n  setLimited(x,v=true){const a=find(x);if(a){const s=stOf(a.id);s.limited=!!v;s.limAt=v?Date.now():0;if(!v)s.until=0;persistLim(a);renderList()}},\n  rename(x,n){const a=find(x);if(a){a.n=String(n);save();renderList()}},\n  store:{get:k=>store[k]??null,set:(k,v)=>{store[k]=v;save()}}\n};\nfunction loadCode(){\n  for(const k in H)delete H[k];\n  if(!settings.devMode)return 'désactivé';\n  const on=(t,fn)=>{(H[t]??=[]).push(fn);return()=>{H[t]=H[t].filter(f=>f!==fn)}};\n  const once=(t,fn)=>{const off=on(t,e=>{off();return fn(e)});return off};\n  try{new Function('hub','on','once','sleep',`return (async()=>{${userCode}\\n})()`)(hub,on,once,sleep).catch(codeErr);return'ok'}\n  catch(x){codeErr(x);return'Erreur : '+x.message}\n}\n\n// ---------- paramètres ----------\nfunction selectTab(t){tab=t;\n  document.querySelectorAll('.snav button').forEach(x=>x.classList.toggle('on',x.dataset.t===t));\n  document.querySelectorAll('.pane').forEach(p=>p.classList.toggle('on',p.id==='p-'+t));\n  if(t==='log')drawLog();if(t==='upd')drawUpd();if(t==='rel')drawRel();if(t==='gen')drawNotif()}\ndocument.querySelectorAll('.snav button').forEach(b=>b.onclick=()=>selectTab(b.dataset.t));\n$('gear').onclick=()=>{setOpen=!setOpen;filesOpen=false;render();if(setOpen)selectTab(tab)};\n$('preall').onchange=e=>{settings.preloadAll=e.target.checked;save();render()};\n\n// mode développeur : sans lui, aucun script perso ni détection perso n'est exécuté\nfunction applyDev(){\n  document.body.classList.toggle('dev',!!settings.devMode);$('dev').checked=!!settings.devMode;\n  const r=loadCode();$('cst').textContent=settings.devMode?(r==='ok'?'Code activé ✔':r):'';\n  if(!settings.devMode&&['code','det','log'].includes(tab)&&setOpen)selectTab('gen');pushCfg()}\n$('dev').onchange=e=>{\n  if(e.target.checked&&!confirm('Le mode développeur exécute du code JavaScript avec un accès complet à tes comptes (conversations, sessions). N\\'active jamais un script dont tu ne comprends pas le contenu, surtout s\\'il vient d\\'un fichier importé.\\n\\nActiver le mode développeur ?')){e.target.checked=false;return}\n  settings.devMode=e.target.checked;save();applyDev();toast(settings.devMode?'Mode développeur activé':'Mode développeur désactivé : les scripts ne s\\'exécutent plus')};\n$('savecode').onclick=()=>{userCode=$('code').value;save();const r=loadCode();$('cst').textContent=r==='ok'?'Code activé ✔':r};\n$('resetcode').onclick=()=>{$('code').value=EXAMPLE};\n$('evlist').innerHTML=EVENTS.map(([n,d])=>`<code>${n}</code><span>${d}</span>`).join('');\n\n// réglages de la reprise\ndocument.querySelectorAll('[data-r]').forEach(el=>el.onchange=()=>{const k=el.dataset.r;\n  settings.relay[k]=el.type==='checkbox'?el.checked:el.type==='number'?Math.min(300000,Math.max(5000,+el.value||60000)):el.value;\n  if(el.type==='number')el.value=settings.relay[k];save()});\nconst tm=t=>new Date(t).toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'});\nfunction drawRel(){\n  document.querySelectorAll('[data-r]').forEach(el=>{const v=settings.relay[el.dataset.r];if(el.type==='checkbox')el.checked=!!v;else el.value=v??''});\n  $('sumnote').textContent=hub.aiEnabled?'Au-delà de 15 000 caractères : résumé + derniers échanges au texte exact.':'Pas de clé Gemini : la conversation est transmise en entier (tronquée si trop longue). Ajoute une clé ci-dessous.';\n  $('hlist').textContent=HAND.length?HAND.slice(0,8).map(h=>h.ok?`${tm(h.ts)}  ${h.from.p} · ${h.from.n} → ${h.to.p} · ${h.to.n}  (${h.how}, ${h.chars} car.${h.sent?', envoyé':''})`:`${tm(h.ts)}  ${h.from?h.from.n:'?'}  ✘ ${h.err}`).join('\\n'):'Aucune reprise pour l\\'instant.'}\n\n// ---------- export / import de comptes ----------\n$('exp').onclick=async()=>{\n  const r=await api.exportAll({state:{accs,active,detectors,settings,code:userCode,store},partitions:accs.map(a=>'persist:'+a.id),pass:$('pass').value});\n  $('msg').textContent=r.ok?`Exporté ${r.encrypted?'(chiffré)':'(NON chiffré, mets un mot de passe)'} : ${r.path}`:'Annulé'};\n$('imp').onclick=async()=>{\n  let r;try{r=await api.importAll($('pass').value)}catch(e){return $('msg').textContent='Fichier illisible : '+e.message}\n  if(!r.ok)return $('msg').textContent=r.error||'Annulé';\n  const s=r.state||{};(s.accs||[]).forEach(x=>{if(!accs.some(a=>a.id===x.id))accs.push(x)});\n  if(!active)active=s.active||null;\n  if(s.detectors&&s.detectors.length&&!detectors.length)detectors=s.detectors;\n  // le code importé est gardé mais ne s'exécute que si TU actives le mode développeur ; on ne remplace pas ton code sans demander\n  if(s.code&&s.code!==userCode&&!isOldExample(s.code)&&confirm('Le fichier contient du code personnalisé. Le remplacer par le tien ? (Il ne s\\'exécutera que si le mode développeur est activé.)'))userCode=s.code;\n  if(s.settings){const m=mergeSettings(s.settings);\n    settings.selectors={...m.selectors,...settings.selectors};\n    if(!settings.gemini.key&&m.gemini.key)settings.gemini=m.gemini;\n    settings.relay={...m.relay,...settings.relay};}                   // devMode et notifications ne sont jamais importés\n  store={...(s.store||{}),...store};\n  save();$('msg').textContent=`Importé : ${(s.accs||[]).length} comptes, ${r.cookies} cookies`+(r.version&&r.version!==r.current?` (fichier créé avec la version ${r.version}, la tienne est ${r.current} : vérifie que tout est là)`:'')+'. Redémarrage…';setTimeout(()=>location.reload(),r.version&&r.version!==r.current?4000:900)};\n\n// ---------- détections personnalisées + journal ----------\nfunction drawDet(){\n  $('dets').innerHTML=detectors.map((d,i)=>`<div class=\"row2\"><input data-i=\"${i}\" data-k=\"name\" value=\"${esc(d.name)}\" placeholder=\"nom de l'événement\"><select data-i=\"${i}\" data-k=\"kind\"><option value=\"selector\"${d.kind==='selector'?' selected':''}>Sélecteur CSS</option><option value=\"text\"${d.kind==='text'?' selected':''}>Texte (regex)</option></select><input data-i=\"${i}\" data-k=\"value\" value=\"${esc(d.value)}\" placeholder=\"ex. .banner-limit  ou  quota épuisé\"><select data-i=\"${i}\" data-k=\"site\"><option value=\"*\">Tous les sites</option>${Object.keys(P).map(k=>`<option${d.site===k?' selected':''}>${k}</option>`).join('')}</select><button class=\"btn\" data-rm=\"${i}\">${IC('x')}</button></div>`).join('')}\n$('dets').oninput=e=>{const{i,k}=e.target.dataset;if(k)detectors[i][k]=e.target.value};\n$('dets').onclick=e=>{const b=e.target.closest('[data-rm]');if(b){detectors.splice(+b.dataset.rm,1);drawDet()}};\n$('adddet').onclick=()=>{detectors.push({name:'mon-evenement',kind:'text',value:'',site:'*'});drawDet()};\n$('savedet').onclick=()=>{save();pushCfg();toast('Détections enregistrées')};\nfunction drawLog(){\n  const f=$('lf').value.toLowerCase();\n  $('logst').innerHTML=accs.map(a=>{const s=stOf(a.id);return `<div>${esc(a.p)} · ${esc(a.n)} : ${s.gen?'répond':'au repos'}${s.limited?' · limite':''}${s.logged===false?' · déconnecté':''} · dernier événement : ${esc(s.last||'aucun')}</div>`}).join('')||'Aucun compte.';\n  $('logl').textContent=LOG.filter(l=>!f||(l.type+l.acc+JSON.stringify(l.detail||'')).toLowerCase().includes(f)).slice(0,200)\n    .map(l=>`${new Date(l.ts).toLocaleTimeString()}  ${l.acc}  ${l.type}  ${l.detail?JSON.stringify(l.detail).slice(0,150):''}`).join('\\n')||'Aucun événement pour l\\'instant.'}\n$('lf').oninput=drawLog;$('logclr').onclick=()=>{LOG.length=0;drawLog()};\n$('logcp').onclick=()=>{api.copy(JSON.stringify(LOG,null,1));toast('Journal copié')};\n\n// ---------- récupération + renommage ----------\nlet renId=null;\n$('rcancel').onclick=()=>$('dlg2').close();\n$('rok').onclick=()=>{const n=$('rname').value.trim();if(n&&renId){find(renId).n=n;save();renderList();if(!setOpen)render()}$('dlg2').close()};\n$('rname').onkeydown=e=>{if(e.key==='Enter')$('rok').click()};\nconst guess=ds=>{for(const k of Object.keys(P)){if(k==='Gemini')continue;const h=new URL(P[k][0]).hostname;if(ds.some(d=>d.includes('.')&&h.endsWith(d)&&!/google\\.com$/.test(d)))return k}\n  return ds.some(d=>/google\\.com$/.test(d))?'Gemini':null};\nasync function recover(auto){\n  let n=0;\n  for(const o of await api.orphans(accs.map(a=>a.id))){const p=guess(o.domains);if(!p)continue;\n    accs.push({id:o.id,p,n:`${p} récupéré ${accs.filter(a=>a.p===p).length+1}`});n++}\n  if(n){save();toast(`${n} compte(s) retrouvé(s) : renomme-les avec le crayon`)}else if(!auto)toast('Aucun compte perdu à retrouver');\n  return n}\n$('recover').onclick=async()=>{await recover(false);render()};\n$('opendata').onclick=()=>api.openData();\n\n// ---------- Gemini ----------\n$('gkey').onchange=()=>{settings.gemini.key=$('gkey').value.trim();save();drawRel();$('gmsg').textContent=settings.gemini.key?'Clé enregistrée.':'Clé supprimée : la conversation sera transmise en entier.'};\n$('gmodel').onchange=()=>{settings.gemini.model=$('gmodel').value.trim()||GEM;$('gmodel').value=settings.gemini.model;save()};\n$('gtest').onclick=async()=>{\n  settings.gemini.key=$('gkey').value.trim();settings.gemini.model=$('gmodel').value.trim()||GEM;save();drawRel();\n  if(!settings.gemini.key)return $('gmsg').textContent='Entre une clé d\\'abord.';\n  $('gmsg').textContent='Test en cours…';\n  const r=await api.gemini({key:settings.gemini.key,model:settings.gemini.model,prompt:'Réponds uniquement par le mot OK.'});\n  $('gmsg').textContent=r.ok?'✔ Gemini répond ('+settings.gemini.model+').':'✘ '+r.error+(r.status===404?' — essaie un autre nom de modèle (ex. gemini-3.5-flash).':'')};\n\n// ---------- sélecteurs de secours + diagnostic ----------\nconst SELK=['user','ai','comp','stop','send'];\n$('selplat').innerHTML=Object.keys(P).map(k=>`<option>${k}</option>`).join('');\nfunction fillSel(){const c=(settings.selectors||{})[$('selplat').value]||{};SELK.forEach(k=>$('sel-'+k).value=c[k]||'')}\n$('selplat').onchange=fillSel;\n$('selsave').onclick=()=>{const c={};SELK.forEach(k=>{const v=$('sel-'+k).value.trim();if(v)c[k]=v});\n  settings.selectors[$('selplat').value]=c;save();pushCfg();Object.values(st).forEach(x=>x.degraded=false);toast('Sélecteurs enregistrés pour '+$('selplat').value)};\n$('diag').onclick=async()=>{\n  const o=$('diagout');o.style.display='block';o.textContent='Analyse…';const lines=[];\n  for(const a of accs){\n    if(!document.querySelector(`webview[data-id=\"${a.id}\"]`)){lines.push(`${a.p} · ${a.n} : non chargé (clique dessus ou active « Garder tous les comptes chargés »)`);continue}\n    try{const h=await hub.health(a.id);\n      lines.push(`${h.composer>0?'✔':'✘'} ${a.p} · ${a.n} : saisie ${h.composer}, tes messages ${h.user}, réponses IA ${h.ai}, stop ${h.stop}, envoyer ${h.send} → ${h.mode==='structured'?'conversation lue':h.mode==='partial'?'lecture partielle ⚠':h.user+h.ai===0?'aucun message à lire (normal sur un nouveau chat)':'à vérifier ⚠'}`)}\n    catch(e){lines.push(`✘ ${a.p} · ${a.n} : ${e.message}`)}}\n  o.textContent=lines.join('\\n')||'Aucun compte.'};\n\n// ---------- mises à jour ----------\nconst dt=t=>t?new Date(t).toLocaleString():'';\nasync function drawUpd(){\n  const i=await api.updInfo();\n  $('upinfo').innerHTML=`Lanceur : <b>${esc(i.launcherVersion)}</b> · version active : <b>${esc(i.active==='bundled'?'d\\'origine ('+i.launcherVersion+')':i.active)}</b>`\n    +(i.pending?` · <span class=\"warn\">en essai (pas encore confirmée)</span>`:'')+(i.rolledBack?`<br><span class=\"warn\">Une mise à jour a été annulée automatiquement : ${esc(i.rolledBack)}</span>`:'');\n  $('upvers').textContent=i.versions.length?i.versions.map(v=>`${v.version}${v.version===i.current?'  (active)':v.version===i.previous?'  (précédente)':''}${v.ok?'':'  ⚠ fichiers invalides'}${i.bad.includes(v.version)?'  ✘ annulée':''}  ${v.notes?'— '+v.notes:''}`).join('\\n'):'Aucune mise à jour installée : version d\\'origine.';\n  $('uphist').textContent=i.history.map(h=>`${dt(h.ts)}  ${h.action}  ${h.version}  ${h.detail||''}`).join('\\n')||'—'}\n$('upapply').onclick=async()=>{\n  const r=await api.updApply();if(r.cancelled)return;\n  if(!r.ok){$('upmsg').textContent='✘ '+r.error;return}\n  $('upmsg').textContent=`✔ Version ${r.version} installée${r.notes?' : '+r.notes:''}.`;drawUpd();\n  if(confirm(`Version ${r.version} installée. Redémarrer maintenant pour l'essayer ?\\n(Si elle ne démarre pas correctement, l'app revient toute seule à la version précédente.)`))api.relaunch()};\nconst revert=async to=>{const r=await api.updRevert(to);if(!r.ok){$('upmsg').textContent='✘ '+r.error;return}\n  $('upmsg').textContent='Retour à '+(r.version==='bundled'?'la version d\\'origine':r.version)+'. Redémarrage…';setTimeout(()=>api.relaunch(),600)};\n$('packzip').onclick=async()=>{const b=$('packzip');b.disabled=true;$('packmsg').textContent='Création du ZIP…';\n  try{const r=await api.packZip();$('packmsg').textContent=r.cancelled?'':r.ok?`✔ ZIP créé : ${r.files} fichiers, ${(r.size/1048576).toFixed(1)} Mo (version ${r.version}). ${r.path}`:'✘ '+r.error}\n  catch(e){$('packmsg').textContent='✘ '+e.message}finally{b.disabled=false}};\n$('uprev').onclick=()=>revert('previous');\n$('uporig').onclick=()=>{if(confirm('Revenir à la version d\\'origine fournie avec l\\'exe ? (tes comptes et ton code sont conservés)'))revert('bundled')};\n\n// ---- 2.5.4 : les limites atteintes sont enregistrées (elles survivent à la fermeture de l'app) ----\nconst LIM_H={Claude:5,ChatGPT:5,Gemini:24};   // sans heure de fin connue : on garde la limite pendant la fenêtre habituelle du site\nfunction limAlive(a,s){const n=Date.now();if(s.until)return s.until>n;return n-(s.limAt||n)<(LIM_H[a.p]||5)*36e5}\nfunction persistLim(a){try{const m=store.__limits=store.__limits||{},s=stOf(a.id);\n  if(s.limited&&limAlive(a,s))m[a.id]={until:s.until||0,at:s.limAt||Date.now()};else delete m[a.id];save()}catch{}}\nfunction restoreLimits(){try{const m=store.__limits||{};let ch=false;\n  for(const id of Object.keys(m)){const a=find(id);if(!a){delete m[id];ch=true;continue}\n    const s=stOf(id);s.limited=true;s.until=+m[id].until||0;s.limAt=+m[id].at||Date.now();\n    if(!limAlive(a,s)){s.limited=false;s.until=0;s.limAt=0;delete m[id];ch=true}}\n  if(ch)save()}catch{}}\n\n// ---------- démarrage ----------\n// Santé : l'app confirme qu'elle fonctionne ; sinon, retour arrière automatique (si une mise à jour est en essai)\nasync function init(){\n  let s=await api.stateLoad();\n  if(!s)s={accs:LS('accs',[]),active:localStorage.act||null,detectors:LS('det',[]),settings:LS('set',{}),code:localStorage.code||EXAMPLE,store:{}};\n  const upgraded=!s.v||s.v<3;\n  accs=s.accs||[];active=s.active||null;detectors=s.detectors||[];settings=mergeSettings(s.settings);\n  userCode=s.code||EXAMPLE;store=s.store||{};restoreLimits();\n  let migrated=false;\n  if(isOldExample(userCode))userCode=EXAMPLE;                                     // ancien exemple non modifié : remplacé\n  else if(upgraded&&userCode.trim()&&userCode!==EXAMPLE&&!settings.devMode)migrated=true; // ton code est conservé, mais désactivé tant que le mode développeur est coupé\n  $('preall').checked=!!settings.preloadAll;$('code').value=userCode;$('gkey').value=settings.gemini.key;$('gmodel').value=settings.gemini.model;\n  fillSel();drawDet();applyTheme();drawNotif();drawRel();loadFiles();\n  PRE=await api.wvpreload();ready=true;\n  await recover(true);\n  if(!find(active))active=accs[0]?.id||null;\n  save();render();applyDev();\n  api.updInfo().then(i=>{if(i.rolledBack){toast('Mise à jour annulée automatiquement : '+i.rolledBack);LOG.unshift({ts:Date.now(),acc:'app',type:'update-rollback',detail:i.rolledBack})}}).catch(()=>{});\n  setTimeout(()=>{window.__healthy=true;api.updHealthy()},3000);\n  if(migrated)setTimeout(()=>toast('Tes scripts sont conservés dans Paramètres > Général > Mode développeur (désactivé). La reprise sur un autre compte est maintenant intégrée.'),2400);\n  setTimeout(()=>{if(settings.notif.enabled===null&&!$('dlgH').open&&!$('dlg').open)$('dlgN').showModal()},3200);   // demande d'autorisation des notifications\n}\n\n// ---------- 2.3.0 : page Fichiers réorganisée + envoi de plusieurs fichiers ----------\nconst DAY=864e5,TTL=30*DAY,FKINDS={image:'Images',pdf:'PDF',doc:'Documents',sheet:'Tableurs',code:'Code',zip:'Archives',txt:'Texte'};\nlet ftype='',lastSel=null,VIS=[],lastT=false,shiftNext=false,PVID=null,PVURL=null;\nconst byId=id=>FILES.find(x=>x.id===id)||TRASH.find(x=>x.id===id);\nconst isProjId=id=>PJ().some(p=>p.id===id);\nconst fview=()=>settings.fview==='list'?'list':'grid';\nconst viewList=id=>id==='trash'?TRASH:id==='fav'?FILES.filter(f=>f.fav):id==='recent'?FILES.filter(f=>Date.now()-f.added<7*DAY):id==='none'?FILES.filter(f=>!projOf(f)):id==='all'?FILES:FILES.filter(f=>f.proj===id);\nconst matchQ=(f,q)=>!q||q.split(/\\s+/).filter(Boolean).every(t=>t[0]==='#'?(f.tags||[]).some(x=>x.includes(t.slice(1))):t.startsWith('type:')?(kindOf(f)===t.slice(5)||extOf(f.name).toLowerCase()===t.slice(5)):(f.name.toLowerCase().includes(t)||(f.tags||[]).some(x=>x.includes(t))));\nconst dlFile=f=>{if(!f)return;const a=document.createElement('a');a.href=URL.createObjectURL(f.blob);a.download=f.name;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),5000)};\nconst b64Of=blob=>new Promise((ok,ko)=>{const r=new FileReader();r.onload=()=>ok(String(r.result).split(',')[1]||'');r.onerror=ko;r.readAsDataURL(blob)});\nconst cleanTag=v=>v.replace(/^#/,'').toLowerCase().slice(0,24);\nfunction extraChips(){return `<span class=\"chipw\"><button class=\"chip ${fproj==='fav'?'on':''}\" data-pf=\"fav\">★ Favoris<i>${FILES.filter(f=>f.fav).length}</i></button></span><span class=\"chipw\"><button class=\"chip ${fproj==='recent'?'on':''}\" data-pf=\"recent\">Récents<i>${viewList('recent').length}</i></button></span>`}\nfunction trashChip(){return `<button class=\"chip ${fproj==='trash'?'on':''}\" data-pf=\"trash\">${IC('trash')}Corbeille<i>${TRASH.length}</i></button>`}\n$('fprojs').insertAdjacentHTML('afterend','<div id=\"ftools\"></div>');\ndocument.body.insertAdjacentHTML('beforeend','<div id=\"fprev\" hidden><div class=\"pvbox\"><div class=\"pvhead\"><b id=\"pvname\"></b><span class=\"sp\"></span><button class=\"btn ghost sm\" id=\"pvdl\">Enregistrer</button><button class=\"btn ghost sm\" id=\"pvx\">Fermer</button></div><div id=\"pvbody\"></div></div></div>');\nasync function loadFiles(anim=true){let all=[];try{all=await FDB.all()||[]}catch{}\n  const old=all.filter(f=>f.del&&Date.now()-f.del>TTL);\n  for(const f of old){try{if(String(f.id).startsWith('scan-'))(settings.scanSkip??=[]).push(f.id);await FDB.del(f.id)}catch{}}\n  if(old.length)save();\n  all=all.filter(f=>!old.includes(f));FILES=all.filter(f=>!f.del).sort((a,b)=>b.added-a.added);TRASH=all.filter(f=>f.del).sort((a,b)=>b.del-a.del);drawFiles(anim)}\nfunction drawTools(){const el=$('ftools');if(!el)return;const kc={};FILES.forEach(f=>{const k=kindOf(f);kc[k]=(kc[k]||0)+1});if(ftype&&!kc[ftype])ftype='';\n  el.innerHTML=`<select id=\"fsort\" title=\"Trier\"><option value=\"new\">Plus récents</option><option value=\"old\">Plus anciens</option><option value=\"az\">Nom A → Z</option><option value=\"za\">Nom Z → A</option><option value=\"big\">Plus gros</option><option value=\"small\">Plus petits</option><option value=\"type\">Par type</option></select><select id=\"ftype\" title=\"Filtrer par type\"><option value=\"\">Tous les types</option>${Object.keys(FKINDS).filter(k=>kc[k]).map(k=>`<option value=\"${k}\">${FKINDS[k]} (${kc[k]})</option>`).join('')}</select><span class=\"vt\"><button data-v=\"grid\" class=\"${fview()==='grid'?'on':''}\" title=\"Grille\">▦</button><button data-v=\"list\" class=\"${fview()==='list'?'on':''}\" title=\"Liste\">☰</button></span><span class=\"sp\"></span><button class=\"btn ghost sm\" id=\"fdup\" title=\"Même nom et même taille\">Doublons</button>`+(fproj==='trash'&&TRASH.length?`<button class=\"btn ghost sm del\" id=\"fempt\">${IC('trash')}Vider la corbeille</button>`:'');\n  $('fsort').value=settings.fsort||'new';$('ftype').value=ftype}\nfunction drawFiles(anim=true){applyFcol();\n  fUrls.forEach(u=>URL.revokeObjectURL(u));fUrls=[];\n  if(fproj!=='all'&&!['none','fav','recent','trash'].includes(fproj)&&!isProjId(fproj))fproj='all';\n  const tr=fproj==='trash';if(tr!==lastT){SEL.clear();lastT=tr}\n  const q=fq.trim().toLowerCase(),tot=FILES.reduce((s,f)=>s+f.size,0),n=accs.length;\n  const list=viewList(fproj).filter(f=>matchQ(f,q)&&(!ftype||kindOf(f)===ftype)).sort(sortP);VIS=list.map(f=>f.id);\n  $('fsub').textContent=FILES.length?`${FILES.length} fichier${FILES.length>1?'s':''} · ${fmtSize(tot)} · disponibles sur ${n} compte${n>1?'s':''}`+(TRASH.length?` · ${TRASH.length} dans la corbeille`:''):'Ta bibliothèque est commune à tous tes comptes.';\n  $('fcount').textContent=FILES.length||'';\n  $('fempty').style.display=FILES.length||TRASH.length?'none':'grid';\n  const g=$('fgrid');g.classList.toggle('noanim',!anim);g.classList.toggle('list',fview()==='list');\n  g.innerHTML=list.map((f,i)=>{const ik=iconKind(f);let top;\n    if(ik==='image'){const u=URL.createObjectURL(f.blob);fUrls.push(u);top=`<div class=\"fthumb\" data-prev=\"${f.id}\" style=\"cursor:zoom-in\"><img src=\"${u}\" alt=\"\"></div>`}else top=`<div data-prevw=\"${f.id}\" style=\"cursor:zoom-in;display:flex\">${fileTile(f)}</div>`;\n    const d=new Date(f.added).toLocaleDateString('fr-FR',{day:'numeric',month:'short'});\n    const tags=`<div class=\"ftags\">${(f.tags||[]).map(t=>`<button class=\"ftag\" data-tag=\"${esc(t)}\" title=\"Clic : filtrer · clic droit : retirer\">#${esc(t)}</button>`).join('')}${tr?'':`<button class=\"ftag add\" data-addtag=\"${f.id}\">+ étiquette</button>`}</div>`;\n    const src=f.src?`<div class=\"fmeta\" title=\"${esc(f.src.conv||'')}\">${f.src.kind==='created'?'Créé par Claude':'Joint'} · ${esc(f.src.conv||'')}</div>`:'';\n    const acts=tr?`<button class=\"btn sm\" data-restore=\"${f.id}\">Restaurer</button><button class=\"btn ghost sm ico del\" data-purge=\"${f.id}\" title=\"Supprimer définitivement\">${IC('trash')}</button>`\n      :`<button class=\"btn sm\" data-att=\"${f.id}\">${IC('clip')}Joindre à…</button><button class=\"btn ghost sm ico fstar${f.fav?' on':''}\" data-fav=\"${f.id}\" title=\"Favori\">${f.fav?'★':'☆'}</button><button class=\"btn ghost sm ico\" data-edtn=\"${f.id}\" title=\"Renommer (F2)\">${IC('edit')}</button><button class=\"btn ghost sm ico\" data-dl=\"${f.id}\" title=\"Enregistrer sous\">${IC('dl')}</button><button class=\"btn ghost sm ico del\" data-rm=\"${f.id}\" title=\"Mettre à la corbeille\">${IC('trash')}</button>`;\n    return `<div class=\"fcard${SEL.has(f.id)?' sel':''}\" data-id=\"${f.id}\" style=\"--i:${i}\"><label class=\"fck\" title=\"Sélectionner (Maj+clic : plage)\"><input type=\"checkbox\" data-sel=\"${f.id}\"${SEL.has(f.id)?' checked':''}></label><div class=\"frow\">${top}<div class=\"fbody\"><div class=\"fname\" data-rn=\"${f.id}\" title=\"${esc(f.name)} · double-clic pour renommer\">${esc(f.name)}</div><div class=\"fmeta\">${esc(fileLabel(f))}</div><div class=\"fmeta\">${fmtSize(f.size)} · ${d}${tr?` · supprimé dans ${Math.max(0,Math.ceil((TTL-(Date.now()-f.del))/DAY))} j`:''}</div>${src}${tr?'':projSel(f)}${tags}</div></div><div class=\"fact2\">${acts}</div></div>`}).join('')\n    +(!list.length&&(FILES.length||TRASH.length)?`<p class=\"dim\">${q?'Aucun fichier ne correspond.':tr?'La corbeille est vide.':fproj==='fav'?'Aucun favori : clique sur l\\'étoile d\\'une carte.':'Aucun fichier dans cette sélection.'}</p>`:'');\n  drawTools();drawProjs();drawSel();pushMenu()}\n// corbeille (30 jours), étiquettes, favoris\nasync function trashIds(ids){let n=0;for(const id of ids){const f=FILES.find(x=>x.id===id);if(!f)continue;try{await FDB.put({...f,del:Date.now()});n++}catch{}SEL.delete(id)}\n  await loadFiles(false);if(n)toast(`${n} fichier${n>1?'s déplacés':' déplacé'} dans la corbeille · restauration possible pendant 30 jours`)}\nasync function restoreIds(ids){let n=0;for(const id of ids){const f=TRASH.find(x=>x.id===id);if(!f)continue;try{await FDB.put({...f,del:0});n++}catch{}SEL.delete(id)}await loadFiles(false);if(n)toast(`${n} fichier${n>1?'s restaurés':' restauré'}`)}\nasync function purgeIds(ids,ask){ids=ids.filter(id=>TRASH.some(f=>f.id===id));if(!ids.length)return;\n  if(ask&&!confirm(`Supprimer définitivement ${ids.length} fichier${ids.length>1?'s':''} ? Cette action est irréversible.`))return;\n  for(const id of ids){try{if(String(id).startsWith('scan-'))(settings.scanSkip??=[]).push(id);await FDB.del(id)}catch{}SEL.delete(id)}save();await loadFiles(false);toast('Supprimé définitivement')}\nasync function dedupe(){const seen=new Map(),dups=[];for(const f of [...FILES].sort((a,b)=>a.added-b.added)){const k=f.name.toLowerCase()+'|'+f.size;seen.has(k)?dups.push(f):seen.set(k,f)}\n  if(!dups.length)return toast('Aucun doublon (même nom et même taille)');\n  if(!confirm(`${dups.length} doublon${dups.length>1?'s':''} trouvé${dups.length>1?'s':''} (${fmtSize(dups.reduce((s,f)=>s+f.size,0))}). Mettre les copies les plus récentes à la corbeille et garder l'original ?`))return;\n  await trashIds(dups.map(f=>f.id))}\nfunction inlineInput(el,ph,cb,val=''){const i=document.createElement('input');i.className='finp';i.placeholder=ph;i.value=val;el.replaceWith(i);i.focus();i.select();let done=0;\n  const end=ok=>{if(done)return;done=1;const v=i.value.trim();ok&&v?Promise.resolve(cb(v)).catch(()=>{}).then(()=>loadFiles(false)):drawFiles(false)};\n  i.onkeydown=e=>{if(e.key==='Enter')end(true);else if(e.key==='Escape')end(false);e.stopPropagation()};i.onblur=()=>end(true)}\nfunction startRename(id){const f=byId(id),el=document.querySelector(`.fcard[data-id=\"${id}\"] .fname`);if(!f||!el)return;\n  inlineInput(el,'Nom du fichier',v=>v!==f.name&&FDB.put({...f,name:v.slice(0,200)}),f.name)}\nconst addTag=async(ids,t)=>{t=cleanTag(t);if(!t)return;for(const id of ids){const f=byId(id);if(f&&!(f.tags||[]).includes(t))await FDB.put({...f,tags:[...(f.tags||[]),t]})}};\n// aperçu rapide\nasync function openPrev(id){const f=byId(id);if(!f)return;PVID=id;$('fprev').hidden=false;$('pvname').textContent=f.name;const body=$('pvbody');\n  if(PVURL)URL.revokeObjectURL(PVURL);PVURL=null;body.textContent='';const k=kindOf(f);\n  if(k==='image'||k==='pdf'){PVURL=URL.createObjectURL(f.blob);body.innerHTML=k==='image'?`<img src=\"${PVURL}\" alt=\"\">`:`<iframe src=\"${PVURL}\"></iframe>`;return}\n  if(f.size<1048576&&!(await f.blob.slice(0,2048).text()).includes('\\0')){const pre=document.createElement('pre');pre.textContent=await f.blob.text();body.appendChild(pre);return}\n  body.innerHTML='<p class=\"dim\">Pas d\\'aperçu pour ce type de fichier : utilise « Enregistrer ».</p>'}\nfunction closePrev(){$('fprev').hidden=true;$('pvbody').textContent='';if(PVURL)URL.revokeObjectURL(PVURL);PVURL=null}\n$('pvx').onclick=closePrev;$('pvdl').onclick=()=>dlFile(byId(PVID));$('fprev').onclick=e=>{if(e.target.id==='fprev')closePrev()};\n// envoi de plusieurs fichiers d'un coup\nconst ATTACH_MANY_JS=`(async(items)=>{\n  const dt=new DataTransfer();\n  for(const it of items){const bin=atob(it.b64),u8=new Uint8Array(bin.length);for(let i=0;i<bin.length;i++)u8[i]=bin.charCodeAt(i);dt.items.add(new File([u8],it.name,{type:it.type||'application/octet-stream'}))}\n  const look=()=>({inp:[...document.querySelectorAll('input[type=file]')].find(i=>!i.disabled),box:document.querySelector('div[contenteditable=true],textarea,[role=textbox]')});\n  let t={};for(let i=0;i<32;i++){t=look();if(t.inp||t.box)break;await new Promise(r=>setTimeout(r,250))}\n  if(t.inp){t.inp.files=dt.files;t.inp.dispatchEvent(new Event('input',{bubbles:true}));t.inp.dispatchEvent(new Event('change',{bubbles:true}));return 'input'}\n  if(t.box){t.box.focus();t.box.dispatchEvent(new ClipboardEvent('paste',{clipboardData:dt,bubbles:true,cancelable:true}));return 'paste'}\n  return 'none'})`;\nasync function attachFiles(ids,accId,o={}){const fs=ids.map(id=>FILES.find(x=>x.id===id)).filter(Boolean),a=find(accId);if(!fs.length||!a)return;\n  if(fs.length===1)return attachFile(fs[0].id,accId,o);\n  if(!o.stay){active=a.id;setOpen=false;filesOpen=false;save();render()}\n  const v=view(a);for(let i=0;i<60&&!v._ready;i++)await sleep(250);\n  if(!v._ready)return toast(`La page de ${a.p} n'est pas prête, réessaie dans un instant`);\n  if(fs.reduce((s,f)=>s+f.size,0)>25*1048576)toast('Gros transfert : cela peut prendre un moment…');\n  const items=[];for(const f of fs){try{items.push({b64:await b64Of(f.blob),name:f.name,type:f.type||''})}catch{}}\n  if(!items.length)return toast('Lecture des fichiers impossible');\n  try{const r=await v.executeJavaScript(ATTACH_MANY_JS+'('+JSON.stringify(items)+')');\n    if(r==='none')return toast(`Aucune zone de message trouvée sur ${a.p} : ouvre une conversation puis réessaie`);\n    for(const p of [...new Set(fs.map(f=>f.proj).filter(p=>p&&isProjId(p)))]){try{await addProjectContext(a,p,null)}catch(x){toast('Contexte du projet non ajouté : '+String(x&&x.message||x).slice(0,60))}}\n    toast(`${items.length} fichiers transmis à ${a.p} · ${a.n}. Vérifie qu'ils apparaissent dans la zone de message.`)}\n  catch(x){toast('Impossible de joindre les fichiers : '+String(x&&x.message||x).slice(0,80))}}\nasync function onMenuPick(a,p){\n  if(!p)return;\n  if(p.fids&&p.fids.length)return attachFiles(p.fids,a.id,{stay:true});\n  if(p.fid)return attachFile(p.fid,a.id,{stay:true});\n  if(p.pid)return addProjectContext(a,p.pid,null)}\nfunction openMulti(btn,ids){if(!ids.length)return toast('Aucun fichier à joindre');openFMenu(btn,'');const m=$('fmenu');m.dataset.ids=JSON.stringify(ids);m.querySelector('.mt').textContent='Joindre '+ids.length+' fichier'+(ids.length>1?'s':'')+' à…'}\n$('fmenu').onclick=e=>{const b=e.target.closest('[data-acc]');if(!b)return;const m=$('fmenu'),ids=m.dataset.ids?JSON.parse(m.dataset.ids):null,id=m.dataset.file;m.dataset.ids='';closeFMenu();ids?attachFiles(ids,b.dataset.acc):attachFile(id,b.dataset.acc)};\n// barre de sélection\nfunction drawSel(){const bar=$('fselbar');if(!bar)return;\n  for(const id of [...SEL])if(!byId(id))SEL.delete(id);\n  if(!SEL.size){bar.hidden=true;bar.innerHTML='';return}\n  const tr=fproj==='trash',s=SEL.size>1?'s':'';bar.hidden=false;\n  bar.innerHTML=`<b>${SEL.size} fichier${s} sélectionné${s}</b><button class=\"btn ghost sm\" id=\"selvis\">Tout sélectionner (${VIS.length})</button><span class=\"sp\"></span>`\n    +(tr?`<button class=\"btn sm\" id=\"selrest\">Restaurer</button><button class=\"btn ghost sm del\" id=\"selpurge\">Supprimer définitivement</button>`\n    :`<button class=\"btn sm pri\" id=\"selatt\">${IC('clip')}Joindre à…</button><select class=\"psel\" id=\"selmove\"><option value=\"\">Déplacer vers…</option><option value=\"-\">Sans projet</option>${PJ().map(p=>`<option value=\"${p.id}\">${esc(p.name)}</option>`).join('')}</select><button class=\"btn ghost sm\" id=\"selfav\">★ Favori</button><button class=\"btn ghost sm\" id=\"seltag\"># Étiquette</button><button class=\"btn ghost sm\" id=\"seldl\">${IC('dl')}Télécharger</button><button class=\"btn ghost sm del\" id=\"seltrash\">${IC('trash')}Corbeille</button>`)\n    +`<button class=\"btn ghost sm\" id=\"selnone\">Désélectionner</button>`}\n$('fselbar').addEventListener('click',async e=>{const b=e.target.closest('button');if(!b)return;const ids=[...SEL];\n  if(b.id==='selvis'){VIS.forEach(x=>SEL.add(x));drawFiles(false)}\n  else if(b.id==='selatt')openMulti(b,ids.filter(x=>FILES.some(f=>f.id===x)))\n  else if(b.id==='selfav'){const all=ids.every(x=>(byId(x)||{}).fav);for(const x of ids){const f=byId(x);if(f)await FDB.put({...f,fav:!all})}await loadFiles(false)}\n  else if(b.id==='seltag')inlineInput(b,'Étiquette pour la sélection',v=>addTag(ids,v))\n  else if(b.id==='seldl'){for(const x of ids){dlFile(byId(x));await sleep(250)}}\n  else if(b.id==='seltrash')trashIds(ids)\n  else if(b.id==='selrest')restoreIds(ids)\n  else if(b.id==='selpurge')purgeIds(ids,true)});\n$('fselbar').addEventListener('change',async e=>{if(e.target.id!=='selmove'||!e.target.value)return;const v=e.target.value;\n  for(const x of [...SEL]){const f=byId(x);if(f)await FDB.put({...f,proj:v==='-'?'':v,man:true,auto:false})}await loadFiles(false);toast('Fichiers déplacés')});\n$('fpedit').addEventListener('click',e=>{const b=e.target.closest('#patt');if(b)openMulti(b,FILES.filter(f=>f.proj===fproj).map(f=>f.id))});\n// barre d'outils\n$('ftools').addEventListener('change',e=>{if(e.target.id==='fsort'){settings.fsort=e.target.value;save();drawFiles(false)}else if(e.target.id==='ftype'){ftype=e.target.value;drawFiles(false)}});\n$('ftools').addEventListener('click',e=>{const v=e.target.closest('[data-v]');if(v){settings.fview=v.dataset.v;save();return drawFiles(false)}\n  if(e.target.closest('#fdup'))return dedupe();if(e.target.closest('#fempt'))purgeIds(TRASH.map(f=>f.id),true)});\n// cartes\n$('fgrid').onclick=async e=>{const g=s=>e.target.closest(s);let b;\n  if(b=g('[data-att]')){$('fmenu').dataset.ids='';return openFMenu(b,b.dataset.att)}\n  if(b=g('[data-dl]'))return dlFile(byId(b.dataset.dl));\n  if(b=g('[data-fav]')){const f=byId(b.dataset.fav);if(f){await FDB.put({...f,fav:!f.fav});await loadFiles(false)}return}\n  if(b=g('[data-rm]'))return trashIds([b.dataset.rm]);\n  if(b=g('[data-restore]'))return restoreIds([b.dataset.restore]);\n  if(b=g('[data-purge]'))return purgeIds([b.dataset.purge],true);\n  if(b=g('[data-prev]')||g('[data-prevw]'))return openPrev(b.dataset.prev||b.dataset.prevw);\n  if(b=g('[data-edtn]'))return startRename(b.dataset.edtn);\n  if(b=g('[data-addtag]'))return inlineInput(b,'Étiquette',v=>addTag([b.dataset.addtag],v));\n  if(b=g('[data-tag]')){fq='#'+b.dataset.tag;$('fq').value=fq;drawFiles(false)}};\n$('fgrid').ondblclick=e=>{const n=e.target.closest('[data-rn]');if(n&&fproj!=='trash')startRename(n.dataset.rn)};\n$('fgrid').addEventListener('contextmenu',e=>{const t=e.target.closest('[data-tag]');if(!t)return;e.preventDefault();const f=byId(t.closest('.fcard').dataset.id);\n  if(f)FDB.put({...f,tags:(f.tags||[]).filter(x=>x!==t.dataset.tag)}).then(()=>loadFiles(false))});\n$('fgrid').addEventListener('click',e=>{if(e.target.closest('input[data-sel]'))shiftNext=e.shiftKey},true);\n$('fgrid').addEventListener('change',e=>{const c=e.target.closest('input[data-sel]');if(!c)return;const id=c.dataset.sel;\n  if(shiftNext&&lastSel&&lastSel!==id){const a=VIS.indexOf(lastSel),b=VIS.indexOf(id);if(a>=0&&b>=0){VIS.slice(Math.min(a,b),Math.max(a,b)+1).forEach(x=>SEL.add(x));drawFiles(false)}}\n  lastSel=id;shiftNext=false});\n// raccourcis clavier\ndocument.addEventListener('keydown',e=>{if(!filesOpen)return;\n  if(!$('fprev').hidden){if(e.key==='Escape'||e.key===' '){e.preventDefault();closePrev()}else if(e.key==='ArrowRight'||e.key==='ArrowLeft'){const n=VIS[VIS.indexOf(PVID)+(e.key==='ArrowRight'?1:-1)];if(n)openPrev(n)}return}\n  if(/^(INPUT|TEXTAREA|SELECT)$/.test((e.target||{}).tagName))return;\n  const k=e.key.toLowerCase(),ctl=e.ctrlKey||e.metaKey;\n  if(ctl&&k==='a'){e.preventDefault();VIS.forEach(x=>SEL.add(x));drawFiles(false)}\n  else if(ctl&&k==='f'){e.preventDefault();$('fq').focus()}\n  else if(e.key==='Delete'&&SEL.size)fproj==='trash'?purgeIds([...SEL],true):trashIds([...SEL]);\n  else if(e.key===' '&&SEL.size){e.preventDefault();openPrev([...SEL][0])}\n  else if(e.key==='F2'&&SEL.size===1)startRename([...SEL][0]);\n  else if(e.key==='Escape'&&SEL.size){SEL.clear();drawFiles(false)}});\n\nconst T0=performance.now();\ninit().catch(e=>{toast('Erreur au démarrage : '+e.message);api.updFail(e.message)}).finally(()=>setTimeout(()=>{$('splash').classList.add('out');setTimeout(()=>$('splash').remove(),600)},Math.max(0,1700-(performance.now()-T0))));\n</script><style id=\"css240\">\n.k-ov{position:fixed;inset:0;z-index:99990;background:rgba(0,0,0,.38);display:none;align-items:flex-start;justify-content:center;padding-top:12vh;font-family:var(--sans)}\n.k-ov.on{display:flex}\n.k-box{width:min(640px,92vw);max-height:76vh;overflow:auto;background:var(--panel);color:var(--txt);border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow);animation:kin .16s var(--ease)}\n@keyframes kin{from{opacity:0;transform:translateY(-8px) scale(.98)}to{opacity:1;transform:none}}\n.k-in{width:100%;box-sizing:border-box;border:0;border-bottom:1px solid var(--line);background:transparent;color:var(--txt);font:inherit;font-size:16px;padding:14px 16px;outline:none}\n.k-it{padding:9px 16px;cursor:pointer;display:flex;flex-direction:column;gap:2px}\n.k-it.sel,.k-it:hover{background:var(--sel)}\n.k-it b{font-weight:600;font-size:14px}.k-it small{color:var(--dim);font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.k-h{padding:8px 16px 2px;color:var(--dim);font-size:11px;text-transform:uppercase;letter-spacing:.06em}\n.k-pad{padding:16px 18px}.k-pad h3{margin:0 0 10px;font-family:var(--serif);font-weight:500;font-size:20px}\n.k-t{width:100%;border-collapse:collapse;font-size:13px}.k-t th{color:var(--dim);font-weight:500;text-align:left;padding:6px 8px;border-bottom:1px solid var(--line)}\n.k-t td{padding:7px 8px;border-bottom:1px solid var(--line)}\n.acc{position:relative}\n.qr{flex:none;display:inline-flex;line-height:0;cursor:pointer;border-radius:50%}\n.qr circle{fill:none;stroke-width:3}.qr .t{stroke:rgba(128,128,128,.28)}\n.qr .p{stroke:var(--ok);stroke-linecap:round;transition:stroke-dasharray .5s,stroke .3s}\n.qr.w .p{stroke:var(--warn)}.qr.e .p{stroke:var(--err)}.qr.z{opacity:.55}.qr:hover{transform:scale(1.12)}\n#q-glob{position:fixed;right:14px;bottom:14px;z-index:40;display:flex;align-items:center;gap:10px;padding:8px 14px;border-radius:12px;background:var(--tbg);color:var(--ttx);font-size:12px;box-shadow:0 4px 16px rgba(0,0,0,.28);cursor:pointer;user-select:none;opacity:.94}\n#q-glob:hover{opacity:1}#q-glob b{font-weight:600;font-variant-numeric:tabular-nums}#q-glob small{opacity:.7;font-size:11px}\n#q-glob .gb{width:64px;height:4px;border-radius:4px;background:rgba(128,128,128,.35);overflow:hidden}#q-glob .gb i{display:block;height:100%;background:#6CC59A;transition:width .3s}\n#q-glob.w .gb i{background:#E0B060}#q-glob.e .gb i{background:#EE8A78}\n/* 2.5.1 : anneaux parfaitement ronds et bien placés */\n.acc .qr{flex:none;width:24px;height:24px;min-width:24px;max-width:24px;aspect-ratio:1/1;display:block;line-height:0;margin-left:2px;border-radius:50%;overflow:visible}\n.acc .qr svg{display:block;width:24px;height:24px}\n.acc:hover b{position:absolute;top:50%;transform:translateY(-50%);background:var(--sel);z-index:2}\n.acc b[data-del]{right:40px}.acc b[data-ren]{right:66px}\n#q-glob{right:16px;bottom:16px;gap:16px;padding:10px 16px;border-radius:20px;align-items:flex-start}\n#q-glob .gi{display:flex;flex-direction:column;align-items:center;gap:4px}\n#q-glob .gi small{font-size:10px;opacity:.7;letter-spacing:.02em}\n#q-glob .rg{position:relative;width:48px;height:48px;min-width:48px;aspect-ratio:1/1;flex:none;border-radius:50%}\n#q-glob .rg svg{display:block;width:48px;height:48px}\n#q-glob .rg circle{fill:none}#q-glob .rg .t{stroke:rgba(128,128,128,.3)}\n#q-glob .rg .p{stroke:#6CC59A;stroke-linecap:round;transition:stroke-dasharray .5s,stroke .3s}\n#q-glob .rg.w .p{stroke:#E0B060}#q-glob .rg.e .p{stroke:#EE8A78}\n#q-glob .rg b{position:absolute;inset:0;display:grid;place-items:center;font-size:12px;font-weight:600;font-variant-numeric:tabular-nums}\n\n/* 2.5.2 : jauge unique + bas de barre latérale */\n#q-glob{padding:10px 14px;border-radius:18px;align-items:center}\n#q-glob .rg{width:56px;height:56px;min-width:56px}#q-glob .rg svg{width:56px;height:56px}\n#q-glob .rg b{font-size:13px}\n#q-glob .gi small{font-size:10px;opacity:.75}\naside #filesbtn{margin-top:8px;padding:9px 12px;border-radius:10px;transition:background .15s,color .15s}\naside #filesbtn:hover,aside .foot #gear:hover{background:var(--sel)}\naside #filesbtn .pill{min-width:22px;height:20px;padding:0 7px;border-radius:999px;display:inline-grid;place-items:center;font-size:11px;font-weight:600;font-variant-numeric:tabular-nums;background:var(--soft);color:var(--dim);border:1px solid var(--line)}\naside .foot{margin-top:6px;padding-top:10px;border-top:1px solid var(--line);gap:8px}\naside .foot #gear{padding:9px 12px;border-radius:10px}\naside .foot #themebtn{width:38px;height:38px;flex:none;display:grid;place-items:center;padding:0;border-radius:10px;border:1px solid var(--line);background:var(--soft);transition:background .2s,border-color .2s,transform .18s}\naside .foot #themebtn:hover{background:var(--sel);border-color:var(--line2)}\naside .foot #themebtn .tg{color:var(--acc)}\n\n/* 2.5.3 : au survol, crayon et croix prennent la place des badges (plus de chevauchement) */\n.acc:hover b,.acc:hover b[data-ren],.acc:hover b[data-del]{position:static;transform:none;right:auto;top:auto;display:grid;place-items:center;width:24px;height:24px;padding:0;flex:none;background:transparent}\n.acc:hover b:hover{background:var(--hover)}\n.acc:hover .bd,.acc:hover .spin{display:none}\n\n.q-f{display:flex;flex-direction:column;gap:6px;margin:10px 0}.q-f label{font-size:12px;color:var(--dim)}\n.q-f input,.q-f select{border:1px solid var(--line);background:var(--soft);color:var(--txt);border-radius:8px;padding:8px 10px;font:inherit}\n\n.k-pill{display:inline-block;padding:1px 8px;border-radius:99px;font-size:11px;background:var(--soft);color:var(--acc)}.k-pill.ok{background:rgba(47,125,91,.12);color:var(--ok)}.k-pill.err{background:rgba(179,65,47,.12);color:var(--err)}\n.k-row{display:flex;gap:6px;align-items:center;margin:6px 0;flex-wrap:wrap}\n.k-row select,.k-row input[type=text]{background:var(--bg);color:var(--txt);border:1px solid var(--line2);border-radius:8px;padding:5px 8px;font:inherit;font-size:13px}\n.k-btn{background:var(--btn);color:#fff;border:0;border-radius:8px;padding:6px 12px;cursor:pointer;font:inherit;font-size:13px}.k-btn.g{background:var(--hover);color:var(--txt)}\n</style>\n<script>\n(()=>{try{\nconst V240='2.5.1',$$=s=>document.querySelector(s),esc=s=>String(s??'').replace(/[&<>\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]));\nconst day=(o=0)=>new Date(Date.now()-o*864e5).toISOString().slice(0,10);\nconst gs=(k,d)=>{const v=hub.store.get(k);return v==null?d:v},ss=(k,v)=>hub.store.set(k,v);\n\n// ---- 1. Détection par le réseau (statuts HTTP réels, compteur de messages réel) ----\nconst lastNet={};\napi.onNet(e=>{try{\n  const v=[...document.querySelectorAll('webview')].find(w=>{try{return w.getWebContentsId()===e.wc}catch{return false}});\n  const a=v&&find(v.dataset.id);if(!a)return;\n  const s=stOf(a.id);if(Object.keys(e.quota||{}).length)s.quota=e.quota;\n  if(e.completion&&e.status<400){const k='n-'+a.id+'-'+day();ss(k,(gs(k,0))+1);try{const tk='qts-'+a.id,t7=Date.now()-7*864e5;ss(tk,gs(tk,[]).filter(x=>x>t7).concat(Date.now()).slice(-2000))}catch{}try{window.__qRefresh&&window.__qRefresh()}catch{}return}\n  const key=a.id+e.status;if(Date.now()-(lastNet[key]||0)<10000)return;lastNet[key]=Date.now();\n  const d={match:'HTTP '+e.status+' (réseau)',via:'network',status:e.status,until:e.until||0,quota:e.quota};\n  const type=e.status===429?(e.completion&&gs('__netlimit',true)?'limit-hit':'rate-limit'):'overloaded';\n  s.net429=(s.net429||0)+(e.status===429?1:0);\n  handle(a,{type,ts:e.ts,url:'',detail:d});\n}catch(x){}});\n\n// ---- 2. Historique local : on enregistre la conversation après chaque réponse ----\nconst capT={};\nconst _h=handle;\nhandle=function(a,ev){\n  _h(a,ev);\n  try{ if(ev.type==='response-complete'){clearTimeout(capT[a.id]);capT[a.id]=setTimeout(async()=>{\n      const v=document.querySelector(`webview[data-id=\"${a.id}\"]`),txt=await hub.getConversation(a.id);if(!v||!txt||txt.length<50)return;\n      let url='',title='';try{url=v.getURL();title=v.getTitle()}catch{}\n      api.convPut({key:a.id+'|'+url,acc:a.id,platform:a.p,name:a.n,url,title,text:txt})},4000)}\n    runRules(a,ev);\n  }catch(x){}\n};\n\n// ---- 3. Règles sans code : quand [événement] sur [plateforme] → [action] ----\nconst REV=[['limit-hit','Limite atteinte'],['rate-limit','Trop de requêtes'],['overloaded','Service saturé'],['error','Erreur'],['chat-too-long','Conversation trop longue'],['limit-soon','Limite bientôt atteinte'],['session-expired','Compte déconnecté'],['captcha','Vérification anti-robot'],['response-complete','Réponse terminée'],['idle','Inactif 2 min']];\nconst RACT=[['notify','Me notifier'],['next','Passer au compte suivant (même plateforme)'],['continue','Reprendre la conversation sur un autre compte'],['copy','Copier la conversation'],['mark','Marquer le compte comme limité'],['reload','Recharger la page']];\nconst cool={};\nasync function runRules(a,ev){\n  for(const r of gs('__rules',[])){\n    if(r.ev!==ev.type||(r.plat&&r.plat!=='*'&&r.plat!==a.p))continue;\n    if(ev.type==='response-complete'&&a.id===active)continue;\n    const k=r.id+a.id;if(Date.now()-(cool[k]||0)<20000)continue;cool[k]=Date.now();\n    try{\n      if(r.act==='notify')hub.notify((r.arg||REV.find(x=>x[0]===r.ev)[1])+' — '+a.p+' · '+a.n);\n      else if(r.act==='next')hub.next({samePlatform:true});\n      else if(r.act==='continue'){const t=hub.available({samePlatform:true,from:a.id});if(t)await hub.continueOn(t,{from:a.id,send:false});else hub.notify('Aucun autre compte '+a.p+' disponible')}\n      else if(r.act==='copy'){await hub.exportConversation(a.id);hub.notify('Conversation copiée')}\n      else if(r.act==='mark')hub.setLimited(a.id,true);\n      else if(r.act==='reload')hub.reload(a.id);\n    }catch(x){codeErr(x)}\n  }\n}\n\n// ---- 4. Fenêtre modale + tableau de bord + règles + palette Ctrl+K ----\nconst ov=document.createElement('div');ov.className='k-ov';ov.innerHTML='<div class=\"k-box\" id=\"k-box\"></div>';document.body.appendChild(ov);\nconst box=$$('#k-box'),close=()=>ov.classList.remove('on'),open=h=>{box.innerHTML=h;ov.classList.add('on')};\nov.addEventListener('mousedown',e=>{if(e.target===ov)close()});\n\nfunction dashboard(){\n  const rows=accs.map(a=>{const s=stOf(a.id);let n7=0;for(let i=0;i<7;i++)n7+=gs('n-'+a.id+'-'+day(i),0);\n    const lim=s.limited?`<span class=\"k-pill err\">Limité${s.until?' jusqu’à '+new Date(s.until).toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'}):''}</span>`:s.logged===false?'<span class=\"k-pill err\">Déconnecté</span>':s.gen?'<span class=\"k-pill\">Répond…</span>':'<span class=\"k-pill ok\">OK</span>';\n    const q=s.quota&&Object.entries(s.quota).slice(0,2).map(([k,v])=>esc(k.replace(/^.*ratelimit-?/,'')+': '+v)).join(' · ');\n    return `<tr><td><b>${esc(a.n)}</b><br><small style=\"color:var(--dim)\">${esc(a.p)}</small></td><td>${lim}</td><td>${(()=>{const q=qInfo(a);return q.max?q.n+'/'+q.max:q.n+' / —'})()}</td><td>${gs('n-'+a.id+'-'+day(),0)}</td><td>${n7}</td><td>${s.net429||0}</td><td style=\"color:var(--dim);font-size:11px\">${q||'—'}</td></tr>`}).join('');\n  open(`<div class=\"k-pad\"><h3>Tableau de bord</h3><table class=\"k-t\"><tr><th>Compte</th><th>État</th><th>Quota</th><th>Msgs aujourd’hui</th><th>7 jours</th><th>HTTP 429</th><th>Quota (en-têtes)</th></tr>${rows||'<tr><td colspan=7>Aucun compte</td></tr>'}</table>\n  <p style=\"color:var(--dim);font-size:12px\">Les messages sont comptés d’après les vraies requêtes réseau, pas à la main. Les en-têtes de quota ne s’affichent que si le site en envoie.</p>\n  <div class=\"k-row\"><button class=\"k-btn g\" id=\"k-x\">Fermer</button></div></div>`);\n  $$('#k-x').onclick=close;\n}\nfunction rules(){\n  const R=gs('__rules',[]),sel=(id,l,v)=>`<select id=\"${id}\">${l.map(x=>`<option value=\"${x[0]}\"${x[0]===v?' selected':''}>${esc(x[1])}</option>`).join('')}</select>`;\n  const plats=[['*','Toutes les plateformes'],...[...new Set(accs.map(a=>a.p))].map(p=>[p,p])];\n  open(`<div class=\"k-pad\"><h3>Règles automatiques</h3>\n  ${R.map((r,i)=>`<div class=\"k-row\"><span>Quand <b>${esc((REV.find(x=>x[0]===r.ev)||[,r.ev])[1])}</b> sur <b>${esc(r.plat==='*'?'toutes':r.plat)}</b> → ${esc((RACT.find(x=>x[0]===r.act)||[,r.act])[1])}</span><button class=\"k-btn g\" data-d=\"${i}\">Supprimer</button></div>`).join('')||'<p style=\"color:var(--dim)\">Aucune règle.</p>'}\n  <div class=\"k-row\" style=\"margin-top:14px\">Quand ${sel('r-ev',REV,'limit-hit')} sur ${sel('r-pl',plats,'*')} alors ${sel('r-ac',RACT,'notify')}<button class=\"k-btn\" id=\"r-add\">Ajouter</button></div>\n  <label class=\"k-row\" style=\"font-size:13px\"><input type=\"checkbox\" id=\"r-nl\"${gs('__netlimit',true)?' checked':''}> Le réseau (HTTP 429 sur l’envoi d’un message) peut marquer un compte comme limité</label>\n  <div class=\"k-row\"><button class=\"k-btn g\" id=\"k-x\">Fermer</button></div></div>`);\n  $$('#k-x').onclick=close;\n  $$('#r-add').onclick=()=>{R.push({id:'r'+Date.now(),ev:$$('#r-ev').value,plat:$$('#r-pl').value,act:$$('#r-ac').value});ss('__rules',R);rules()};\n  $$('#r-nl').onchange=e=>ss('__netlimit',e.target.checked);\n  box.querySelectorAll('[data-d]').forEach(b=>b.onclick=()=>{R.splice(+b.dataset.d,1);ss('__rules',R);rules()});\n}\n\nlet items=[],idx=0,qT=null,qs=0;\nfunction drawPal(){box.querySelector('#k-list').innerHTML=items.map((it,i)=>it.h?`<div class=\"k-h\">${esc(it.h)}</div>`:`<div class=\"k-it${i===idx?' sel':''}\" data-i=\"${i}\"><b>${esc(it.t)}</b><small>${esc(it.s||'')}</small></div>`).join('');\n  box.querySelectorAll('.k-it').forEach(e=>e.onclick=()=>pick(+e.dataset.i))}\nfunction pick(i){const it=items[i];if(!it||it.h)return;close();it.go()}\nasync function build(q){\n  const ql=q.toLowerCase(),my=++qs,out=[];\n  const cmds=[{t:'Tableau de bord',s:'Messages, limites et quotas par compte',go:dashboard},{t:'Règles automatiques',s:'Quand X arrive, faire Y — sans code',go:rules},{t:'Vider l’historique local',s:'Efface les conversations enregistrées',go:async()=>{await api.convClear();toast('Historique vidé')}}].filter(c=>!ql||c.t.toLowerCase().includes(ql));\n  if(cmds.length)out.push({h:'Commandes'},...cmds);\n  const ac=accs.filter(a=>!ql||(a.p+' '+a.n).toLowerCase().includes(ql)).map(a=>({t:a.n,s:a.p+(stOf(a.id).limited?' · limité':''),go:()=>hub.switchTo(a.id)}));\n  if(ac.length)out.push({h:'Comptes'},...ac);\n  items=out;idx=out.findIndex(x=>!x.h);drawPal();\n  if(q.trim().length>=2){const r=await api.convSearch(q);if(my!==qs)return;\n    if(r.length){items=out.concat([{h:'Conversations enregistrées'}],r.map(c=>({t:c.title||c.name+' · '+c.platform,s:c.name+' — '+c.snip,go:()=>{const a=find(c.acc);if(!a)return toast('Compte introuvable');hub.switchTo(a.id);const v=document.querySelector(`webview[data-id=\"${a.id}\"]`);if(v&&c.url)setTimeout(()=>{try{v.loadURL(c.url)}catch{}},300)}})));if(idx<0)idx=items.findIndex(x=>!x.h);drawPal()}}\n}\nfunction palette(){open('<input class=\"k-in\" id=\"k-q\" placeholder=\"Rechercher un compte, une conversation, une commande…\" autocomplete=\"off\"><div id=\"k-list\" style=\"padding:6px 0\"></div>');\n  const q=$$('#k-q');q.focus();build('');q.oninput=()=>{clearTimeout(qT);qT=setTimeout(()=>build(q.value),150)}}\naddEventListener('keydown',e=>{\n  if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='k'){e.preventDefault();ov.classList.contains('on')?close():palette();return}\n  if(!ov.classList.contains('on'))return;\n  if(e.key==='Escape')close();\n  else if(box.querySelector('#k-q')&&['ArrowDown','ArrowUp','Enter'].includes(e.key)){e.preventDefault();\n    if(e.key==='Enter')return pick(idx);const d=e.key==='ArrowDown'?1:-1;let i=idx;do{i+=d}while(items[i]&&items[i].h);if(items[i]){idx=i;drawPal();box.querySelector('.k-it.sel')?.scrollIntoView({block:'nearest'})}}\n},true);\n\n// ---- 5. (2.5.0) Compteurs de quota : un par compte (barre de gauche) + un global (bas à droite) ----\nconst QW={day:['Aujourd’hui (minuit à minuit)',0],'5h':['5 heures glissantes',5],'24h':['24 heures glissantes',24],'7j':['7 jours glissants',168]};\nconst QC=()=>gs('__quota',{});\nconst num=v=>{const n=parseFloat(String(v).replace(/[^\\d.]/g,''));return isFinite(n)?n:null};\nfunction realQ(s){ // vrais compteurs envoyés par le site (en-têtes), si disponibles\n  const q=s&&s.quota;if(!q)return null;let lim=null,rem=null;\n  for(const [k,v] of Object.entries(q)){const n=num(v);if(n==null)continue;\n    if(/remaining/.test(k)&&rem==null)rem=n;else if(/limit/.test(k)&&!/remaining|reset/.test(k)&&lim==null)lim=n}\n  return lim!=null&&rem!=null&&lim>=rem&&lim>0?{n:lim-rem,max:lim}:null}\nconst QDEF={Claude:{max:40,win:'5h'},ChatGPT:{max:40,win:'5h'},Gemini:{max:50,win:'24h'}};\nfunction qInfo(a){\n  const c=QC()[a.id]||{},r=realQ(stOf(a.id)),hit=gs('qhit-'+a.id,0),d=QDEF[a.p]||{max:0,win:'day'};\n  const w=QW[c.win||d.win]?(c.win||d.win):'day';\n  if(r)return{n:r.n,max:r.max,real:true,win:w,src:'site'};\n  let n;if(w==='day')n=gs('n-'+a.id+'-'+day(),0);\n  else{const t=Date.now()-QW[w][1]*36e5;n=gs('qts-'+a.id,[]).filter(x=>x>t).length}\n  return{n,max:c.max||hit||d.max||0,real:false,win:w,src:c.max?'manuel':hit?'appris':'estimé'}}\nconst qCls=(n,m,lim)=>lim||(m&&n>=m)?'e':(m&&n/m>=.8)?'w':'';\nconst ringSvg=(pr,sz,sw)=>{const R=(sz-sw)/2,C=2*Math.PI*R,m=sz/2;\n  return '<svg viewBox=\"0 0 '+sz+' '+sz+'\" width=\"'+sz+'\" height=\"'+sz+'\"><circle class=\"t\" cx=\"'+m+'\" cy=\"'+m+'\" r=\"'+R+'\" stroke-width=\"'+sw+'\"/><circle class=\"p\" cx=\"'+m+'\" cy=\"'+m+'\" r=\"'+R+'\" stroke-width=\"'+sw+'\" transform=\"rotate(-90 '+m+' '+m+')\" stroke-dasharray=\"'+(Math.max(0,Math.min(1,pr))*C).toFixed(1)+' '+C.toFixed(1)+'\"/></svg>'};\nfunction decorate(){\n  document.querySelectorAll('#list .acc').forEach(row=>{\n    const a=find(row.dataset.id);if(!a)return;const q=qInfo(a),s=stOf(a.id),cls=qCls(q.n,q.max,s.limited);\n    row.querySelector('.qr')?.remove();\n    const pr=q.max?Math.min(1,q.n/q.max):(s.limited?1:0);\n    const c=document.createElement('div');c.className='qr '+cls+(q.max?'':' z');c.dataset.q=a.id;c.innerHTML=ringSvg(pr,24,3);\n    c.title=q.max?'Quota '+q.n+'/'+q.max+' ('+Math.round(q.n/q.max*100)+' %) · '+QW[q.win][0]+' · plafond '+q.src:q.n+' message(s) · '+QW[q.win][0];\n    row.appendChild(c)})}\nlet gEl=null;\nfunction glob(){\n  if(!gEl){gEl=document.createElement('div');gEl.id='q-glob';gEl.title='Quota global — clic : tableau de bord';document.body.appendChild(gEl);gEl.onclick=dashboard}\n  let tot=0,uMax=0,sMax=0,free=0;\n  for(const a of accs){const q=qInfo(a),s=stOf(a.id);tot+=q.n;if(q.max){uMax+=q.n;sMax+=q.max}if(!s.limited&&s.logged!==false)free++}\n  const n=accs.length,c1=qCls(uMax,sMax,false),c2=!n?'':free===0?'e':free/n<=.34?'w':'';\n  gEl.className=c1;gEl.style.display=n?'flex':'none';\n  gEl.innerHTML='<div class=\"gi\"><div class=\"rg '+c2+'\">'+ringSvg(n?free/n:0,56,5)+'<b>'+free+'/'+n+'</b></div><small>Comptes dispo</small></div>';\n  gEl.title='Comptes disponibles : '+free+' sur '+n+' · '+tot+' message(s) au total — clic : tableau de bord'}\n// ---- 2.5.5 : connexion via un vrai Chrome (contourne le blocage Google des fenêtres intégrées) ----\nconst LOGIN_HOSTS={Claude:['claude.ai','anthropic.com'],ChatGPT:['chatgpt.com','openai.com'],Gemini:['google.com'],'Le Chat':['mistral.ai'],Copilot:['microsoft.com','live.com','bing.com','microsoftonline.com'],Perplexity:['perplexity.ai'],Grok:['grok.com','x.ai','x.com'],DeepSeek:['deepseek.com']};\nconst loginHosts=a=>LOGIN_HOSTS[a.p]||(()=>{try{return [new URL(P[a.p][0]).hostname.split('.').slice(-2).join('.')]}catch{return []}})();\nlet CH={acc:null,port:0};\nfunction cdpCookies(url){return new Promise((res,rej)=>{\n  let done=false;const ws=new WebSocket(url);\n  const t=setTimeout(()=>{if(!done){done=true;try{ws.close()}catch{}rej(new Error('Chrome ne répond pas'))}},8000);\n  ws.onopen=()=>ws.send(JSON.stringify({id:1,method:'Storage.getCookies'}));\n  ws.onmessage=m=>{let j;try{j=JSON.parse(m.data)}catch{return}if(j.id!==1)return;done=true;clearTimeout(t);try{ws.close()}catch{}\n    j.error?rej(new Error(j.error.message)):res((j.result&&j.result.cookies)||[])};\n  ws.onerror=()=>{if(!done){done=true;clearTimeout(t);rej(new Error('Connexion à Chrome impossible'))}}})}\n$('chromelogin').onclick=()=>{const a=find(active);if(!a)return toast('Choisis d’abord un compte');\n  CH={acc:a.id,port:0};$('cinfo').textContent=a.p+' · '+a.n;$('cmsg').textContent='';$('copen').disabled=false;$('cimp').disabled=true;$('dlgC').showModal()};\n$('copen').onclick=async()=>{const a=find(CH.acc);if(!a)return;$('copen').disabled=true;$('cmsg').textContent='Ouverture de Chrome…';\n  const r=await api.chromeStart(P[a.p][0]);\n  if(!r.ok){$('cmsg').textContent='✘ '+r.error;$('copen').disabled=false;return}\n  CH.port=r.port;$('cimp').disabled=false;$('cmsg').textContent='Chrome est ouvert : connecte-toi sur le site, puis reviens ici cliquer « J’ai fini ».'};\n$('cimp').onclick=async()=>{const a=find(CH.acc);if(!a||!CH.port)return;$('cimp').disabled=true;$('cmsg').textContent='Lecture de la session…';\n  try{\n    const w=await api.chromeWs(CH.port);if(!w.ok)throw new Error(w.error);\n    const cookies=await cdpCookies(w.ws);\n    const r=await api.chromeImport({partition:'persist:'+a.id,hosts:loginHosts(a),cookies});\n    if(!r.ok)throw new Error(r.error);\n    if(!r.imported){$('cmsg').textContent='Aucune connexion trouvée dans Chrome pour ce site. Finis de te connecter dans Chrome, puis reclique « J’ai fini ».';$('cimp').disabled=false;return}\n    CH.port=0;api.chromeStop();$('dlgC').close();toast('Connexion importée ('+r.imported+' cookies) : rechargement…');\n    const v=document.querySelector('webview[data-id=\"'+a.id+'\"]');try{if(v)v.loadURL(P[a.p][0])}catch{}\n  }catch(e){$('cmsg').textContent='✘ '+(e.message||e);$('cimp').disabled=false}};\n$('cclose').onclick=()=>$('dlgC').close();\n$('dlgC').addEventListener('close',()=>{if(CH.port){CH.port=0;api.chromeStop()}});\nfunction refreshQ(){try{decorate();glob()}catch(x){}}\nwindow.__qRefresh=refreshQ;\nconst _rl=renderList;renderList=function(){_rl.apply(this,arguments);refreshQ()};\nsetInterval(refreshQ,30000);\n\nfunction quotaDlg(id){\n  const a=find(id);if(!a)return;const c=QC()[id]||{},q=qInfo(a),hit=gs('qhit-'+id,0);\n  open(`<div class=\"k-pad\"><h3>Quota · ${esc(a.p)} — ${esc(a.n)}</h3>\n  <p style=\"color:var(--dim);font-size:12px\">Utilisé : <b>${q.n}</b>${q.real?' (quota réel du site : '+q.n+'/'+q.max+')':' message(s) sur la fenêtre choisie'}.${hit?' Dernière limite atteinte à <b>'+hit+'</b> message(s).':''}</p>\n  <div class=\"q-f\"><label>Plafond de messages (0 = aucun)</label><input id=\"q-max\" type=\"number\" min=\"0\" value=\"${c.max||''}\" placeholder=\"ex. 40\">\n  <label>Fenêtre de comptage</label><select id=\"q-win\">${Object.entries(QW).map(([k,v])=>`<option value=\"${k}\"${k===(c.win||'day')?' selected':''}>${esc(v[0])}</option>`).join('')}</select></div>\n  <div class=\"k-row\">${hit?'<button class=\"k-btn g\" id=\"q-hit\">Utiliser '+hit+'</button>':''}<button class=\"k-btn g\" id=\"q-rz\">Remettre à 0</button><button class=\"k-btn g\" id=\"q-x\">Annuler</button><button class=\"k-btn\" id=\"q-ok\">Enregistrer</button></div></div>`);\n  $$('#q-x').onclick=close;\n  if(hit)$$('#q-hit').onclick=()=>{$$('#q-max').value=hit};\n  $$('#q-rz').onclick=()=>{ss('qts-'+id,[]);ss('n-'+id+'-'+day(),0);refreshQ();close();toast('Compteur remis à 0')};\n  $$('#q-ok').onclick=()=>{const m=Math.max(0,parseInt($$('#q-max').value,10)||0),all=QC();all[id]={max:m,win:$$('#q-win').value};ss('__quota',all);refreshQ();close()}}\n$('list').addEventListener('click',e=>{const q=e.target.closest('[data-q]');if(q){e.stopPropagation();const a=find(q.dataset.q);if(a){const i=qInfo(a);toast(a.n+' : '+i.n+(i.max?'/'+i.max:'')+' message(s) · '+QW[i.win][0]+(i.max?' · plafond '+i.src:''))}}},true);\n\n// apprentissage : quand une limite tombe, on retient le nombre de messages utilisés\nconst _h2=handle;\nhandle=function(a,ev){_h2(a,ev);try{if(ev.type==='limit-hit'){const q=qInfo(a);if(q.n>0)ss('qhit-'+a.id,q.n)}if(ev.type==='limit-cleared'){ss('qts-'+a.id,[])}refreshQ()}catch(x){}};\nrefreshQ();\n\nwindow.hub240={dashboard,rules,palette,quotaDlg,version:V240};\nsetTimeout(()=>{if(!gs('__k240',false)){ss('__k240',true);toast('Nouveau : Ctrl+K = recherche globale, tableau de bord et règles')}},5000);\n}catch(x){console.error('module 2.5.0',x)}})();\n</script>\n<style id=\"css260\">\n/* ===== 2.6.0 : projets + chat unique, comptes = clés ===== */\naside .pgrp{padding:10px 10px 2px}\n#plist{flex:1 1 auto;min-height:70px;overflow:auto;margin:0 -4px;padding:0 4px}\n#plist .acc.prj{gap:9px}\n#plist .acc .pic{display:inline-flex;line-height:0;color:var(--dim);text-decoration:none;flex:none}\n#plist .acc.on .pic{color:var(--acc)}\n#plist .acc .pn{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n#plist .acc:hover b{position:static;transform:none;display:grid;place-items:center;width:24px;height:24px;padding:0;background:transparent}\n#plist .acc:hover .spin{display:none}\n#plist .pempty{color:var(--dim);font-size:13px;padding:10px;line-height:1.45}\n#keysbox{flex:none;display:flex;flex-direction:column;min-height:0;max-height:44%;border-top:1px solid var(--line);padding-top:6px}\n.keyshead{display:flex;align-items:center;gap:8px;width:100%;background:transparent;border:0;color:var(--dim);font:inherit;font-size:11.5px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;padding:6px 10px;cursor:pointer;border-radius:8px;text-align:left}\n.keyshead:hover{background:var(--hover);color:var(--txt)}\n.keyshead .kt{flex:1}.keyshead small{font-weight:500;text-transform:none;letter-spacing:0;opacity:.8}\n.keyshead em{font-style:normal;font-variant-numeric:tabular-nums;background:var(--soft);color:var(--dim);border:1px solid var(--line);border-radius:999px;padding:0 7px;font-size:11px;line-height:18px}\n.keyshead .chev{transition:transform .2s}\n#keysbox.min .chev{transform:rotate(-90deg)}\n#keysbody{display:flex;flex-direction:column;gap:6px;min-height:0;overflow:hidden;padding-top:4px}\n#keysbox.min #keysbody{display:none}\n#keysbox #list{flex:1 1 auto;min-height:0;overflow:auto}\n#keysbox #add{padding:5px 9px;font-size:13px}\n#list .acc.inuse{box-shadow:inset 3px 0 0 var(--acc)}\n#list .acc.inuse>span{color:var(--acc);font-weight:500}\n.ebtns{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}\n\n/* le chat recouvre les pages des comptes (qui continuent de tourner dessous) */\nwebview.drv{display:flex}\n#chat{position:absolute;inset:0;z-index:5;background:var(--bg);display:none;flex-direction:column;min-height:0}\n#chat.on{display:flex;animation:pagein .3s var(--ease) backwards}\n#ch-top{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 22px;border-bottom:1px solid var(--line);flex:none}\n.ch-id{min-width:0;display:flex;flex-direction:column}\n#ch-name{font:500 18px var(--serif);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n#ch-desc{color:var(--dim);font-size:12.5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:60ch}\n#ch-desc:empty{display:none}\n.ch-act{display:flex;align-items:center;gap:6px;flex:none}\n#ch-key{max-width:300px}\n#ch-key .kl{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n#ch-key .ks{font-size:11.5px;color:var(--dim)}\n#ch-key.bad{border-color:var(--err);color:var(--err)}\n#ch-msgs{flex:1;overflow:auto;padding:22px 0 10px;scroll-behavior:smooth}\n#ch-msgs>*{width:min(820px,calc(100% - 44px));margin-left:auto;margin-right:auto}\n.m{display:flex;flex-direction:column;margin-bottom:18px;animation:itemin .3s var(--ease) backwards}\n.m .b{white-space:pre-wrap;word-break:break-word;line-height:1.6;font-size:14.5px}\n.m.u{align-items:flex-end}\n.m.u .b{background:var(--sel);border-radius:16px 16px 4px 16px;padding:10px 14px;max-width:85%}\n.m.a .b{padding:2px 2px}\n.m .mk{display:flex;align-items:center;gap:7px;color:var(--dim);font-size:12px;margin-bottom:4px}\n.m .mf{margin-top:6px;font-size:12px;color:var(--dim)}\n.m.s{align-items:center;margin-bottom:14px}\n.m.s span{background:var(--soft);color:var(--dim);border:1px solid var(--line);border-radius:999px;padding:3px 12px;font-size:12.5px;text-align:center}\n.m.s.warn span{color:var(--warn)}\n.m .cb{position:relative;margin:8px 0;white-space:normal}\n.m .cb pre{background:var(--side);border:1px solid var(--line);border-radius:10px;padding:12px 14px;overflow:auto;white-space:pre;font-size:12.5px;margin:0}\n.m .cb .cbc{position:absolute;top:6px;right:6px;font:inherit;font-size:11.5px;color:var(--dim);background:var(--panel);border:1px solid var(--line);border-radius:6px;padding:2px 8px;cursor:pointer}\n.m .cb .cbc:hover{color:var(--txt)}\n.ch-typing{display:flex;align-items:center;gap:9px;color:var(--dim);font-size:13px;margin-bottom:18px}\n.ch-empty{text-align:center;color:var(--dim);margin-top:11vh;line-height:1.6}\n.ch-empty h3{font:500 26px var(--serif);color:var(--txt);margin-bottom:8px}\n.ch-empty p{max-width:520px;margin:0 auto 6px}\n#ch-bar{flex:none;padding:6px 0 14px}\n#ch-bar>*{width:min(820px,calc(100% - 44px));margin-left:auto;margin-right:auto}\n#ch-box{display:flex;align-items:flex-end;gap:6px;background:var(--panel);border:1px solid var(--line2);border-radius:16px;padding:8px 8px 8px 6px;box-shadow:var(--shadow);transition:border-color .15s}\n#ch-box:focus-within{border-color:var(--acc)}\n#ch-in{flex:1;border:0;background:transparent;resize:none;max-height:220px;padding:7px 6px;font:14.5px/1.5 var(--sans);outline:none}\n#ch-in:focus-visible{outline:none}\n#ch-chips{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:6px}\n#ch-chips:empty{display:none}\n#ch-chips .fc{display:inline-flex;align-items:center;gap:6px;background:var(--soft);border:1px solid var(--line);border-radius:999px;padding:2px 4px 2px 10px;font-size:12.5px}\n#ch-chips .fc b{font-weight:400;cursor:pointer;color:var(--dim);line-height:0;padding:3px;border-radius:50%}\n#ch-chips .fc b:hover{color:var(--err);background:var(--hover)}\n#ch-hint{color:var(--dim);font-size:11.5px;text-align:center;margin-top:7px}\n#ch-menu{position:fixed;z-index:200;min-width:270px;max-width:380px;max-height:60vh;overflow:auto;background:var(--panel);border:1px solid var(--line);border-radius:12px;box-shadow:var(--shadow);padding:6px}\n#ch-menu[hidden]{display:none}\n#ch-menu .mt{color:var(--dim);font-size:11px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;padding:8px 10px 4px}\n#ch-menu button{display:flex;align-items:center;gap:9px;width:100%;text-align:left;background:transparent;border:0;color:var(--txt);font:inherit;padding:7px 10px;border-radius:8px;cursor:pointer}\n#ch-menu button:hover{background:var(--hover)}\n#ch-menu button .tx{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n#ch-menu button em{font-style:normal;color:var(--dim);font-size:11.5px}\n#ch-menu button em.err{color:var(--err)}\n#ch-menu button.on{background:var(--sel)}\n#ch-menu button.on::after{content:'✓';color:var(--acc)}\n#ch-menu .sep{height:1px;background:var(--line);margin:6px 4px}\nwebview.on{z-index:1}\n\n</style>\n<script>\n/* 2.6.0 — Projets à gauche, un seul chat, les comptes sont des « clés » qu'AI Hub branche et change tout seul. */\n(function(){try{\nconst CV='2.6.0';\nconst lbl=a=>a.p+' · '+a.n;\nconst P0=id=>PJ().find(p=>p.id===id)||null;\nconst keyOk=a=>{const s=stOf(a.id);return !s.limited&&s.logged!==false};\nconst mid=()=>'m'+Date.now().toString(36)+Math.random().toString(36).slice(2,5);\nconst TXT0='Écris ton message… (Entrée pour envoyer, Maj+Entrée pour un retour à la ligne)';\n\n// ---------- stockage des conversations de projet (IndexedDB, local) ----------\nconst CDB={db:null,\n  open(){return this.db||(this.db=new Promise((ok,ko)=>{const r=indexedDB.open('aihub-chats',1);r.onupgradeneeded=()=>r.result.createObjectStore('chats',{keyPath:'id'});r.onsuccess=()=>ok(r.result);r.onerror=()=>ko(r.error)}))},\n  async tx(mode,fn){const db=await this.open();return new Promise((ok,ko)=>{const t=db.transaction('chats',mode);let r;try{r=fn(t.objectStore('chats'))}catch(x){return ko(x)}t.oncomplete=()=>ok(r&&r.result);t.onerror=()=>ko(t.error);t.onabort=()=>ko(t.error)})},\n  get(id){return this.tx('readonly',s=>s.get(id))},put(o){return this.tx('readwrite',s=>s.put(o))},del(id){return this.tx('readwrite',s=>s.delete(id))}};\nconst CH={};\nconst chatOf=async pid=>CH[pid]||(CH[pid]=(await CDB.get(pid).catch(()=>null))||{id:pid,msgs:[],threads:{},seen:{},key:''});\nconst chSave=ch=>CDB.put(JSON.parse(JSON.stringify(ch))).catch(()=>{});\n\n// ---------- état de l'interface ----------\nlet chatProj=null,keyRaw=false,chatInit=false,lastActive,quiet=false,drawnFor=null,wasOn=false,CUR=null,PEND=[],editP=null,MENU=null;\nconst DRV=new Set(),WAIT={};\nconst showChat=()=>!!(chatProj&&P0(chatProj)&&!setOpen&&!filesOpen&&!keyRaw);\n\n// ---------- barre latérale : projets ----------\nfunction renderProjs(){\n  const el=$('plist');if(!el)return;\n  el.innerHTML=PJ().map(p=>{const on=p.id===chatProj&&showChat(),run=CUR&&CUR.pid===p.id;\n    return `<div class=\"acc prj${on?' on':''}\" data-pid=\"${p.id}\"><u class=\"pic\">${IC('folder')}</u><span class=\"pn\">${esc(p.name)}</span>${run?'<i class=\"spin\" title=\"Une clé répond\"></i>':''}<b data-pren=\"${p.id}\" title=\"Modifier le projet\">${IC('edit')}</b><b data-pdel=\"${p.id}\" title=\"Supprimer le projet\">${IC('x')}</b></div>`}).join('')\n    ||'<div class=\"pempty\">Aucun projet pour l\\'instant. Crée-en un : chaque projet a son propre chat.</div>';\n  const k=$('kcount');if(k)k.textContent=accs.length||'';\n}\nfunction openProject(id){chatProj=id;keyRaw=false;setOpen=false;filesOpen=false;settings.lastProj=id;save();PEND=[];render();drawChat();setTimeout(()=>{const i=$('ch-in');if(i)i.focus()},60)}\n$('plist').onclick=e=>{\n  const rn=e.target.closest('[data-pren]'),d=e.target.closest('[data-pdel]');\n  if(rn)return openProjDlg(P0(rn.dataset.pren));\n  if(d)return delProject(d.dataset.pdel);\n  const r=e.target.closest('[data-pid]');if(r)openProject(r.dataset.pid)};\nfunction openProjDlg(p){editP=p||null;$('pdt').textContent=p?'Modifier le projet':'Nouveau projet';$('pdok').textContent=p?'Enregistrer':'Créer';\n  $('pdn').value=p?p.name:'';$('pdd').value=p?(p.desc||''):'';$('dlgP').showModal();$('pdn').focus()}\n$('pdc').onclick=()=>$('dlgP').close();\n$('pdok').onclick=()=>{const n=$('pdn').value.trim();if(!n)return $('pdn').focus();const d=$('pdd').value;\n  $('dlgP').close();\n  if(editP){editP.name=n;editP.desc=d;save();renderProjs();drawChat();try{drawFiles(false)}catch{}return}\n  const p={id:'p'+Date.now().toString(36),name:n,desc:d};PJ().push(p);save();openProject(p.id)};\n$('pdn').onkeydown=e=>{if(e.key==='Enter')$('pdok').click()};\n$('newproj').onclick=()=>openProjDlg();$('newproj2').onclick=()=>openProjDlg();\nasync function delProject(id){const p=P0(id);if(!p)return;\n  if(CUR&&CUR.pid===id)return toast('Une réponse est en cours dans ce projet : clique d\\'abord sur Arrêter.');\n  if(!confirm(`Supprimer le projet « ${p.name} » et sa conversation ? Ses fichiers restent dans la bibliothèque (sans projet).`))return;\n  for(const f of FILES.filter(x=>x.proj===id))try{await FDB.put({...f,proj:''})}catch{}\n  settings.projects=PJ().filter(x=>x.id!==id);delete CH[id];await CDB.del(id).catch(()=>{});\n  if(chatProj===id){chatProj=(PJ()[0]||{}).id||null;settings.lastProj=chatProj;drawnFor=null}\n  save();try{await loadFiles(false)}catch{}render();drawChat()}\n\n// ---------- zone « Clés » repliable ----------\n(function(){const box=$('keysbox'),set=m=>{box.classList.toggle('min',m);$('keystog').setAttribute('aria-expanded',String(!m));try{localStorage.keysmin=m?'1':''}catch{}};\n  set(!!localStorage.keysmin);$('keystog').onclick=()=>set(!box.classList.contains('min'))})();\n\n// ---------- affichage du chat ----------\nfunction md(t){let h=esc(t);\n  h=h.replace(/```[\\w+-]*\\n?([\\s\\S]*?)```/g,(m,c)=>`<div class=\"cb\"><button class=\"cbc\" data-cc type=\"button\">Copier</button><pre>${c.replace(/\\n$/,'')}</pre></div>`);\n  return h.replace(/`([^`\\n]+)`/g,'<code>$1</code>').replace(/\\*\\*([^*\\n]+)\\*\\*/g,'<b>$1</b>')}\nfunction drawKeyChip(){const b=$('ch-key'),p=P0(chatProj);if(!b||!p)return;\n  const ch=CH[p.id],cur=find(p.pin)||find(ch&&ch.key)||null;\n  if(!accs.length){b.innerHTML=IC('lock')+'<span class=\"kl\">Aucune clé : ajoutes-en une</span>';b.className='btn bad';return}\n  if(!cur)b.innerHTML=IC('swap')+'<span class=\"kl\">Clé : automatique</span>';\n  else{const s=stOf(cur.id);b.innerHTML=`<i class=\"dot\" style=\"background:${P[cur.p][1]}\"></i><span class=\"kl\">${esc(lbl(cur))}</span><span class=\"ks\">${p.pin?'fixée':'auto'}${s.limited?' · limite':''}</span>`}\n  b.className='btn'+(accs.some(keyOk)?'':' bad')}\nfunction msgHtml(m){\n  if(m.r==='user')return `<div class=\"m u\"><div class=\"b\">${md(m.t)}</div>${m.files&&m.files.length?`<div class=\"mf\">${IC('clip')} ${esc(m.files.join(', '))}</div>`:''}</div>`;\n  if(m.r==='ai'){const k=m.k||{},c=P[k.p]?P[k.p][1]:'var(--dim)';\n    return `<div class=\"m a\"><div class=\"mk\"><i class=\"dot\" style=\"background:${c}\"></i>${esc(k.p?k.p+' · '+k.n:'IA')}</div><div class=\"b\">${md(m.t)}</div></div>`}\n  return `<div class=\"m s${m.warn?' warn':''}\"><span>${esc(m.t)}</span></div>`}\nfunction drawMsgs(stick){const ch=CH[chatProj];if(!ch)return;const box=$('ch-msgs');\n  const near=box.scrollHeight-box.scrollTop-box.clientHeight<140;\n  const k=CUR&&CUR.pid===ch.id?find(CUR.key):null;\n  let h=ch.msgs.map(msgHtml).join('');\n  if(CUR&&CUR.pid===ch.id)h+=`<div class=\"ch-typing\"><i class=\"spin\"></i><span>${k?esc(lbl(k))+' répond…':'Branchement d\\'une clé…'}</span></div>`;\n  if(!ch.msgs.length&&!CUR){const ok=accs.filter(keyOk).length;\n    h=`<div class=\"ch-empty\"><h3>${esc((P0(chatProj)||{}).name||'')}</h3><p>${accs.length?`Écris ton premier message ci-dessous. AI Hub l'envoie avec une de tes clés (${ok} prête${ok>1?'s':''} sur ${accs.length}) et en change tout seul si une limite est atteinte.`:'Ajoute d\\'abord une clé (un compte IA) dans la zone « Clés » à gauche : une fois connectée, elle sert à tous tes projets.'}</p></div>`}\n  box.innerHTML=h;if(stick||near)box.scrollTop=box.scrollHeight}\nasync function drawChat(){const p=P0(chatProj);if(!p)return;drawnFor=p.id;\n  await chatOf(p.id);if(chatProj!==p.id)return;\n  $('ch-name').textContent=p.name;$('ch-desc').textContent=(p.desc||'').replace(/\\s+/g,' ').trim();\n  drawMsgs(true);drawChips();setBusy()}\nfunction drawChips(){const el=$('ch-chips');if(!el)return;\n  el.innerHTML=PEND.map(id=>{const f=FILES.find(x=>x.id===id);return f?`<span class=\"fc\">${esc(f.name)}<b data-rmf=\"${id}\" title=\"Retirer\">${IC('x')}</b></span>`:''}).join('')}\n$('ch-chips').onclick=e=>{const b=e.target.closest('[data-rmf]');if(b){PEND=PEND.filter(x=>x!==b.dataset.rmf);drawChips()}};\nfunction setBusy(){const run=!!CUR,here=run&&CUR.pid===chatProj;\n  $('ch-send').hidden=here;$('ch-stop').hidden=!here;\n  $('ch-in').placeholder=run&&!here?'Une réponse est en cours dans un autre projet…':TXT0;\n  renderProjs();if(chatProj)drawKeyChip();if(chatProj&&CH[chatProj])drawMsgs(false)}\nfunction autoGrow(){const i=$('ch-in');i.style.height='auto';i.style.height=Math.min(220,i.scrollHeight)+'px'}\n$('ch-in').addEventListener('input',autoGrow);\n$('ch-in').addEventListener('keydown',e=>{if(e.key==='Enter'&&!e.shiftKey&&!e.isComposing){e.preventDefault();chatSend()}});\n// 2.6.2 : Ctrl+V colle une capture d'écran (ou toute image du presse-papiers) dans la barre de chat\n$('ch-in').addEventListener('paste',async e=>{\n  const items=[...((e.clipboardData&&e.clipboardData.items)||[])].filter(i=>i.kind==='file'&&/^image\\//.test(i.type));\n  if(!items.length)return;e.preventDefault();\n  const d=new Date(),pad=x=>String(x).padStart(2,'0'),stamp=`${d.getFullYear()}${pad(d.getMonth()+1)}${pad(d.getDate())}-${pad(d.getHours())}${pad(d.getMinutes())}${pad(d.getSeconds())}`;\n  let n=0;\n  for(const it of items){const b=it.getAsFile();if(!b)continue;\n    const ext=((b.type.split('/')[1]||'png').replace('jpeg','jpg').replace(/[^a-z0-9]/g,''))||'png';\n    const id='f'+Date.now().toString(36)+Math.random().toString(36).slice(2,6);\n    try{await FDB.put({id,name:`capture-${stamp}${items.length>1?'-'+(n+1):''}.${ext}`,type:b.type,size:b.size,added:Date.now(),proj:'',tags:['capture'],blob:b});PEND.push(id);n++}catch{}}\n  if(!n)return toast('Impossible de coller l\\'image');\n  await loadFiles(false);drawChips();toast(n>1?n+' images collées':'Image collée')});\n$('ch-send').onclick=()=>chatSend();\n$('ch-msgs').addEventListener('click',async e=>{const c=e.target.closest('[data-cc]');if(!c)return;\n  const t=c.parentElement.querySelector('pre').textContent;await api.copy(t);c.textContent='Copié';setTimeout(()=>c.textContent='Copier',1400)});\n\n// ---------- menus (clé du projet, fichiers à joindre) ----------\nfunction showMenu(btn,html,fn){const m=$('ch-menu');m.innerHTML=html;MENU={fn,btn};m.hidden=false;\n  const r=btn.getBoundingClientRect(),w=m.offsetWidth,h=m.offsetHeight;\n  m.style.left=Math.max(12,Math.min(r.right-w,innerWidth-w-12))+'px';\n  m.style.top=(r.bottom+6+h>innerHeight-12?Math.max(12,r.top-h-6):r.bottom+6)+'px'}\nconst closeMenu=()=>{$('ch-menu').hidden=true;MENU=null};\n$('ch-menu').addEventListener('click',e=>{if(MENU)MENU.fn(e)});\ndocument.addEventListener('mousedown',e=>{if(!e.target.closest('#ch-menu')&&!e.target.closest('#ch-key')&&!e.target.closest('#ch-att'))closeMenu()});\ndocument.addEventListener('keydown',e=>{if(e.key==='Escape')closeMenu()});\nfunction keyMenu(btn){const p=P0(chatProj);if(!p)return;const cur=CH[p.id]&&CH[p.id].key;\n  const rows=accs.map(a=>{const s=stOf(a.id);\n    return `<button data-pin=\"${a.id}\" class=\"${p.pin===a.id?'on':''}\"><i class=\"dot\" style=\"background:${P[a.p][1]}\"></i><span class=\"tx\">${esc(lbl(a))}</span>${s.limited?'<em class=\"err\">limite</em>':s.logged===false?'<em class=\"err\">déconnectée</em>':cur===a.id?'<em>branchée</em>':''}</button>`}).join('');\n  showMenu(btn,`<div class=\"mt\">Clé de ce projet</div><button data-pin=\"\" class=\"${!p.pin?'on':''}\"><span class=\"tx\">Automatique (recommandé)</span><em>change seule</em></button>${rows}<div class=\"sep\"></div><button data-act=\"keys\"><span class=\"tx\">Gérer les clés…</span></button>`,e=>{\n    const b=e.target.closest('button');if(!b)return;\n    if(b.dataset.act==='keys'){closeMenu();$('keysbox').classList.remove('min');return}\n    if(b.dataset.pin!==undefined){p.pin=b.dataset.pin;save();closeMenu();drawKeyChip()}})}\n$('ch-key').onclick=e=>{if($('ch-menu').hidden||!MENU)keyMenu(e.currentTarget);else closeMenu()};\nfunction fileMenu(btn){const p=P0(chatProj);if(!p)return;\n  const mine=FILES.filter(f=>f.proj===p.id),others=FILES.filter(f=>f.proj!==p.id).slice(0,40);\n  const row=f=>`<button data-fid=\"${f.id}\" class=\"${PEND.includes(f.id)?'on':''}\"><span class=\"tx\">${esc(f.name)}</span><em>${fmtSize(f.size)}</em></button>`;\n  const html=FILES.length?((mine.length?'<div class=\"mt\">Fichiers du projet</div>'+mine.map(row).join(''):'')+(others.length?'<div class=\"mt\">Autres fichiers</div>'+others.map(row).join(''):'')):'<div class=\"mt\">Bibliothèque vide</div><button data-act=\"files\"><span class=\"tx\">Ouvrir la bibliothèque de fichiers…</span></button>';\n  showMenu(btn,html,e=>{const b=e.target.closest('button');if(!b)return;\n    if(b.dataset.act==='files'){closeMenu();filesOpen=true;setOpen=false;render();try{drawFiles(false)}catch{}return}\n    const id=b.dataset.fid;if(!id)return;PEND=PEND.includes(id)?PEND.filter(x=>x!==id):PEND.concat(id);drawChips();b.classList.toggle('on',PEND.includes(id))})}\n$('ch-att').onclick=e=>{if($('ch-menu').hidden||!MENU)fileMenu(e.currentTarget);else closeMenu()};\n$('ch-copy').onclick=async()=>{const ch=CH[chatProj];if(!ch||!ch.msgs.some(m=>m.r!=='sys'))return toast('Rien à copier pour l\\'instant');\n  await api.copy(ch.msgs.filter(m=>m.r!=='sys').map(fmt).join('\\n\\n'));toast('Conversation du projet copiée')};\n$('ch-new').onclick=async()=>{const ch=CH[chatProj];if(!ch)return;if(CUR)return toast('Une réponse est en cours : attends la fin ou clique Arrêter.');\n  if(!ch.msgs.length)return toast('La conversation est déjà vide');\n  if(!confirm('Vider la conversation de ce projet et repartir sur un fil neuf ? (Utilise « Copier » avant si tu veux la garder.)'))return;\n  ch.msgs=[];ch.threads={};ch.seen={};chSave(ch);drawMsgs(true)};\n\n// ---------- le moteur : choisir une clé, envoyer, attendre, lire, changer de clé ----------\nfunction keyOrder(p,ch,skip){\n  const ok=accs.filter(a=>keyOk(a)&&!skip.includes(a.id)),first=[],pin=find(p.pin),cur=find(ch.key);\n  if(pin&&ok.includes(pin))first.push(pin);\n  if(cur&&ok.includes(cur)&&!first.includes(cur))first.push(cur);\n  const plat=(first[0]&&first[0].p)||(cur&&cur.p)||'';\n  return first.concat(ok.filter(a=>!first.includes(a)).sort((x,y)=>(x.p===plat?0:1)-(y.p===plat?0:1)))}\nfunction addMsg(ch,m){const o={id:mid(),ts:Date.now(),...m};ch.msgs.push(o);chSave(ch);if(chatProj===ch.id)drawMsgs(true);return o}\nasync function projCtx(p){\n  const parts=[];if(p.desc&&p.desc.trim())parts.push(p.desc.trim());\n  try{if(FILES.some(f=>f.proj===p.id)){const r=await projSummary(p);if(r&&r.text)parts.push(r.text)}}catch{}\n  return parts.length?`[PROJET « ${p.name} »]\\n`+parts.join('\\n\\n'):''}\nasync function compose(p,ch,a,pendIdx,text,fresh){\n  const R=settings.relay,miss=ch.msgs.slice(ch.seen[a.id]||0,pendIdx).filter(m=>m.r!=='sys'&&m.t);\n  const head=fresh?await projCtx(p):'';\n  if(!head&&!miss.length)return text;\n  let out=head?head+'\\n\\n':'';\n  if(miss.length){let body='';const full=miss.map(fmt).join('\\n\\n');\n    if(hub.aiEnabled&&R.summary&&full.length>(R.summaryAbove||15000)){toast('Résumé de l\\'historique par Gemini…');\n      const sum=await hub.summarize(full,{platform:a.p});if(sum)body='## RÉSUMÉ\\n'+sum+'\\n\\n## DERNIERS ÉCHANGES\\n'+fitTail(miss,6000).text}\n    if(!body)body=fit(miss,Math.min(R.maxChars||60000,60000)).text;\n    out+=`[HISTORIQUE] Cette conversation continue depuis un autre compte ou une autre IA (changement de clé automatique par AI Hub). Voici ce qui s'est dit avant : lis-le, retiens-le, ne le résume pas et ne dis pas bonjour.\\n--- DÉBUT ---\\n${body}\\n--- FIN ---\\n\\n`}\n  return out+'MA DEMANDE :\\n'+text}\nfunction makeWait(a){const w={started:false,sent:false,done:false,preview:''};\n  w.promise=new Promise(res=>{w.fin=r=>{if(w.done)return;w.done=true;clearTimeout(w.t1);clearTimeout(w.t2);if(WAIT[a.id]===w)delete WAIT[a.id];res(r)}});\n  w.t1=setTimeout(()=>{if(!w.started&&!w.sent)w.fin('nostart')},45000);\n  w.t2=setTimeout(()=>w.fin('timeout'),20*60000);\n  w.cancel=()=>w.fin('cancel');WAIT[a.id]=w;return w}\nconst _handle=handle;\nhandle=function(a,ev){_handle(a,ev);const w=WAIT[a.id];if(!w)return;const t=ev.type;\n  if(t==='send-attempt'||t==='message-sent')w.sent=true;\n  if(t==='response-started'){w.started=true;w.sent=true}\n  if(t==='response-complete'&&(w.started||w.sent)){w.preview=((ev.detail||{}).preview)||'';w.fin('done')}\n  else if(t==='limit-hit')w.fin('limit');\n  else if(t==='rate-limit'){try{hub.setLimited(a.id,true)}catch{}w.fin('limit')}\n  else if(t==='login-required'||t==='session-expired'||t==='google-blocked')w.fin('login')};\n// Une clé pilotée par un projet ne déclenche plus l'ancienne reprise automatique (elle collerait dans un autre compte)\nconst _onLimit=onLimit;\nonLimit=function(a){if(DRV.has(a.id)||(settings.keyIds||[]).includes(a.id)){ping('limit','Limite atteinte',lbl(a)+' — AI Hub change de clé au prochain message',null);return}return _onLimit(a)};\n\nasync function driveKey(p,ch,a,pendIdx,text,files){\n  const v=view(a);v.classList.add('drv');DRV.add(a.id);\n  if(!(settings.keyIds||[]).includes(a.id)){(settings.keyIds=settings.keyIds||[]).push(a.id);save()}\n  try{\n    for(let i=0;i<60&&!v._ready;i++)await sleep(250);\n    if(!v._ready)return {ok:false,reason:'page non prête',skip:true};\n    if(CUR&&CUR.cancel)return {ok:false,cancel:true};\n    // 1. ouvrir le bon fil : celui du projet sur cette clé, sinon une nouvelle conversation\n    const url=ch.threads[a.id];let cur='';try{cur=v.getURL()}catch{}\n    if(url){if(cur.split('#')[0]!==url.split('#')[0]){v.loadURL(url);await new Promise(r=>{v.addEventListener('did-stop-loading',r,{once:true});setTimeout(r,20000)})}}\n    else await hub.newChat(a);\n    const w0=await waitComposer(a,25000);\n    if(w0===true)await sleep(1500);\n    const s=stOf(a.id);\n    if(w0!==true||s.limited||s.logged===false)return {ok:false,reason:(w0==='login'||s.logged===false)?'déconnectée':s.limited?'limite atteinte':'page non prête',skip:true};\n    let fresh=!url;\n    if(url){let u2='';try{u2=v.getURL()}catch{}if(!isChatUrl(u2)){fresh=true;delete ch.threads[a.id];ch.seen[a.id]=0}}\n    if(CUR&&CUR.cancel)return {ok:false,cancel:true};\n    // 2. fichiers joints\n    if(files.length){try{const items=[];for(const f of files)items.push({b64:await b64Of(f.blob),name:f.name,type:f.type||''});\n        const r=await v.executeJavaScript(ATTACH_MANY_JS+'('+JSON.stringify(items)+')');\n        if(r==='none')addMsg(ch,{r:'sys',warn:true,t:`Fichiers non joints : pas de zone de message trouvée sur ${lbl(a)}`});else await sleep(1800)}\n      catch(x){addMsg(ch,{r:'sys',warn:true,t:'Fichiers non joints : '+String(x&&x.message||x).slice(0,80)})}}\n    // 3. message (+ contexte du projet / historique manquant) puis envoi\n    const msg=await compose(p,ch,a,pendIdx,text,fresh);\n    let W=makeWait(a),r=await hub.paste(msg,{account:a,send:false});\n    if(!r.len){await sleep(1200);r=await hub.paste(msg,{account:a,send:false})}\n    if(!r.len){W.cancel();return {ok:false,reason:'collage impossible',skip:true}}\n    await sleep(600);await hub.send(a.id);\n    let res=await W.promise;\n    if(res==='nostart'){      // l'envoi par Entrée n'a rien déclenché : on clique le bouton Envoyer\n      W=makeWait(a);\n      try{await v.executeJavaScript(`(()=>{const b=document.querySelector(${JSON.stringify(okSel(a,'send'))});if(b)b.click()})()`)}catch{}\n      res=await W.promise;if(res==='nostart')return {ok:false,reason:'envoi impossible',skip:true}}\n    if(res==='cancel')return {ok:false,cancel:true};\n    if(res==='limit')return {ok:false,reason:'limite atteinte'};\n    if(res==='login')return {ok:false,reason:'session expirée',skip:true};\n    if(res==='timeout')return {ok:false,reason:'pas de réponse après 20 min',skip:true};\n    // 4. lire la réponse\n    await sleep(900);\n    if(stOf(a.id).limited)return {ok:false,reason:'limite atteinte'};\n    let reply='';\n    for(let i=0;i<4&&!reply;i++){try{const c=await read(a);if(c.mode==='structured'){const l=c.msgs[c.msgs.length-1];if(l&&l.r==='ai'&&l.t)reply=l.t}}catch{}if(!reply)await sleep(800)}\n    if(!reply)reply=(W.preview?W.preview+' […]\\n\\n':'')+'(AI Hub n\\'a pas pu relire la réponse complète sur cette clé : ouvre la clé dans la zone « Clés » pour la voir en entier, ou règle les sélecteurs dans Paramètres > Reprise.)';\n    try{const u=v.getURL();if(isChatUrl(u))ch.threads[a.id]=u}catch{}\n    return {ok:true,reply}\n  }finally{setTimeout(()=>DRV.delete(a.id),30000)}}\n\nasync function runTurn(p,ch,text,files){\n  const pendIdx=ch.msgs.length-1,skip=[];let last='';\n  for(let n=0;n<=accs.length;n++){\n    const a=keyOrder(p,ch,skip)[0];\n    if(!a){addMsg(ch,{r:'sys',warn:true,t:accs.length?`Aucune clé disponible${last?' ('+last+')':''}. Attends la fin d'une limite, reconnecte une clé ou ajoutes-en une.`:'Aucune clé : ajoute un compte IA dans la zone « Clés » à gauche.'});return false}\n    if(ch.key&&ch.key!==a.id){const o=find(ch.key);addMsg(ch,{r:'sys',t:`Clé changée : ${o?lbl(o):'—'} → ${lbl(a)}${last?' ('+last+')':''}`})}\n    ch.key=a.id;CUR.key=a.id;chSave(ch);drawKeyChip();renderList();drawMsgs(true);\n    const r=await driveKey(p,ch,a,pendIdx,text,files);\n    if(r.ok){addMsg(ch,{r:'ai',t:r.reply,k:{id:a.id,p:a.p,n:a.n}});ch.seen[a.id]=ch.msgs.length;chSave(ch);\n      if(!(showChat()&&chatProj===p.id&&document.hasFocus()))ping('done','Projet « '+p.name+' » : réponse prête',r.reply.replace(/\\s+/g,' ').slice(0,110),null);\n      return true}\n    if(r.cancel){addMsg(ch,{r:'sys',t:'Envoi interrompu.'});return false}\n    const s=stOf(a.id);\n    last=(r.reason==='limite atteinte'?'limite atteinte sur '+lbl(a)+(s.until?' jusqu\\'à '+hm(s.until):''):lbl(a)+' : '+(r.reason||'échec'));\n    skip.push(a.id)}\n  return false}\n\nasync function chatSend(){\n  const pid=chatProj,p=P0(pid);if(!p)return;\n  const inp=$('ch-in');let text=inp.value.trim();if(!text&&PEND.length)text=PEND.length>1?'Regarde les fichiers joints.':'Regarde le fichier joint.';if(!text)return;\n  if(CUR)return toast('Une réponse est déjà en cours'+(CUR.pid!==pid?' dans « '+((P0(CUR.pid)||{}).name||'un autre projet')+' »':'')+'.');\n  if(!accs.length)return toast('Ajoute d\\'abord une clé (un compte IA) dans la zone « Clés » à gauche');\n  const ch=await chatOf(pid),files=PEND.map(id=>FILES.find(f=>f.id===id)).filter(Boolean);\n  inp.value='';autoGrow();PEND=[];drawChips();\n  addMsg(ch,{r:'user',t:text,files:files.map(f=>f.name)});\n  CUR={pid,key:null,cancel:false};setBusy();\n  try{await runTurn(p,ch,text,files)}\n  catch(x){addMsg(ch,{r:'sys',warn:true,t:'Erreur : '+String(x&&x.message||x).slice(0,160)})}\n  finally{CUR=null;document.querySelectorAll('webview.drv').forEach(v=>v.classList.remove('drv'));setBusy();renderList();if(chatProj===pid)$('ch-in').focus()}}\n$('ch-stop').onclick=async()=>{if(!CUR)return;CUR.cancel=true;const a=find(CUR.key);\n  if(a){try{await view(a).executeJavaScript(`(()=>{const b=document.querySelector(${JSON.stringify(okSel(a,'stop'))});if(b)b.click()})()`)}catch{}\n    const w=WAIT[a.id];if(w)w.cancel()}};\n\n// ---------- branchement sur l'interface existante ----------\nconst _render=render;\nrender=function(){\n  if(!chatInit&&ready){chatInit=true;lastActive=active;const pj=PJ();chatProj=P0(settings.lastProj)?settings.lastProj:(pj[0]&&pj[0].id)||null}\n  else if(active!==lastActive){if(chatInit&&!quiet)keyRaw=true;lastActive=active}\n  _render();\n  const sc=showChat(),none=chatInit&&!sc&&!keyRaw&&!setOpen&&!filesOpen;\n  $('chat').classList.toggle('on',sc);\n  if(sc||none){$('empty').style.display=sc?'none':'grid';document.querySelector('.hbtns').style.visibility='hidden'}\n  if(sc){const p=P0(chatProj);$('title').textContent='Projet · '+p.name;if(!wasOn||drawnFor!==chatProj)drawChat()}\n  else if(none)$('title').textContent='AI Hub';\n  if(none)document.querySelectorAll('webview.on').forEach(v=>v.classList.remove('on'));\n  wasOn=sc;renderProjs()};\nconst _renderList=renderList;\nrenderList=function(){_renderList();\n  const k=showChat()&&CH[chatProj]&&CH[chatProj].key;\n  if(k){const r=document.querySelector(`#list .acc[data-id=\"${k}\"]`);if(r)r.classList.add('inuse')}\n  renderProjs();if(chatProj&&!$('chat').hidden)drawKeyChip()};\nconst _af=attachFile;attachFile=function(f,a,o){if(!(o&&o.stay))keyRaw=true;return _af.apply(this,arguments)};\nconst _afs=attachFiles;attachFiles=function(f,a,o){if(!(o&&o.stay))keyRaw=true;return _afs.apply(this,arguments)};\n// Cliquer sur une clé dans la liste = voir sa vraie page (pour te connecter) ; cliquer sur un projet = revenir au chat\n$('list').addEventListener('click',e=>{\n  if(e.target.closest('[data-del],[data-ren]')){quiet=true;setTimeout(()=>quiet=false,1500);return}\n  if(e.target.closest('.acc')&&!e.target.closest('[data-q]'))keyRaw=true},true);\n$('add').lastChild&&($('add').lastChild.textContent='Ajouter une clé');\n\nwindow.hub260={version:CV,projects:()=>PJ().map(p=>({id:p.id,name:p.name})),chat:pid=>CH[pid]||null};\n}catch(x){console.error('module 2.6.0',x)}})();\n\n</script>\n<style id=\"css261\">\n/* ===== 2.6.1 : page Fichiers épurée (liste simple, projets à gauche, actions au survol) ===== */\n#files.fnew{padding:22px 32px 48px}\n#files.fnew .fhead{margin-bottom:14px;align-items:center;gap:16px}\n#files.fnew .fhead h2{font:600 20px var(--sans);letter-spacing:-.01em}\n#files.fnew .fhead p{font-size:12.5px;margin-top:1px}\n#files.fnew .fact{position:relative;gap:8px;flex-wrap:nowrap}\n#files.fnew .fsearch input{width:210px;font:inherit;font-size:13px;color:var(--txt);background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:6px 10px 6px 32px}\n#files.fnew .fsearch input:focus{width:260px;box-shadow:none;border-color:var(--line2)}\n#fhmenu{position:absolute;right:0;top:calc(100% + 6px);z-index:30;min-width:230px;padding:4px;background:var(--panel);border:1px solid var(--line);border-radius:10px;box-shadow:var(--shadow)}\n#fhmenu[hidden]{display:none}\n#fhmenu:not([hidden]){display:flex;flex-direction:column;gap:1px}\n#fhmenu .btn{width:100%;justify-content:flex-start;background:none;border:0;border-radius:7px;padding:7px 10px;font-size:13px;font-weight:400}\n#fhmenu .btn:hover{background:var(--hover)}\n\n#fwrap{display:grid;grid-template-columns:188px minmax(0,1fr);gap:28px;align-items:start}\n#fmain{min-width:0}\n#files.fnew #fprojs{display:flex;flex-direction:column;gap:1px;margin:0;position:sticky;top:0}\n#fprojs .pi{position:relative;display:flex;align-items:center}\n#fprojs .pb{flex:1;min-width:0;display:flex;align-items:center;gap:8px;font:inherit;font-size:13px;color:var(--dim);background:none;border:0;padding:6px 10px;border-radius:7px;cursor:pointer;text-align:left}\n#fprojs .pb span{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n#fprojs .pb i{font-style:normal;font-size:11.5px;opacity:.7;font-variant-numeric:tabular-nums}\n#fprojs .pb .ic{width:14px;height:14px}\n#fprojs .pb:hover{background:var(--hover);color:var(--txt)}\n#fprojs .pi.on .pb{background:var(--sel);color:var(--txt);font-weight:500}\n#fprojs .pi .chipsel{position:absolute;right:4px;opacity:0;font-size:14px}\n#fprojs .pi:hover .chipsel,#fprojs .pi .chipsel.on{opacity:1}\n#fprojs .pi:hover .pb i{visibility:hidden}\n#fprojs .pgl{display:flex;align-items:center;justify-content:space-between;margin-top:14px;padding:0 4px 3px 10px;font-size:11px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:var(--dim)}\n#fprojs .pnew{display:grid;place-items:center;width:22px;height:22px;padding:0;border:0;border-radius:6px;background:none;color:var(--dim);cursor:pointer}\n#fprojs .pnew:hover{background:var(--hover);color:var(--txt)}\n#fprojs .psep{height:1px;background:var(--line);margin:10px 6px 6px}\n\n#files.fnew #ftools{gap:6px;margin:0 0 6px;padding-bottom:8px;border-bottom:1px solid var(--line);font-size:12.5px}\n#files.fnew #ftools select{background:transparent;border:0;color:var(--dim);padding:4px 6px;border-radius:6px;font-size:12.5px}\n#files.fnew #ftools select:hover{background:var(--hover);color:var(--txt);border:0}\n#ftools .fcnt{color:var(--dim);font-size:12.5px;margin-right:8px}\n#files.fnew #ftools .vt{border:0;gap:2px}\n#files.fnew #ftools .vt button{background:transparent;border-radius:6px;padding:3px 8px}\n#files.fnew #ftools .vt button.on{background:var(--sel);color:var(--txt)}\n\n#files.fnew #fpedit{background:none;border:0;border-bottom:1px solid var(--line);border-radius:0;padding:0 0 12px;margin:0 0 6px;gap:8px}\n#files.fnew #fpedit #pname{font:600 17px var(--sans);background:transparent;border:1px solid transparent;padding:4px 6px}\n#files.fnew #fpedit #pname:hover{border-color:var(--line)}\n#files.fnew #fpedit textarea{font-size:13px;background:transparent}\n#fpedit .pe-more summary{cursor:pointer;color:var(--dim);font-size:12.5px;padding:2px 0;list-style:none}\n#fpedit .pe-more summary::-webkit-details-marker{display:none}\n#fpedit .pe-more summary::before{content:'›';display:inline-block;width:12px;transition:transform .15s}\n#fpedit .pe-more[open] summary::before{transform:rotate(90deg)}\n#fpedit .pe-more .pe-row{margin:8px 0}\n#files.fnew :is(#fscan,#fauto,#ficols){background:transparent;border-radius:10px;margin-bottom:10px}\n\n/* liste (par défaut) */\n#files.fnew #fgrid{display:flex;flex-direction:column;gap:0}\n#files.fnew #fgrid .fcard{display:grid;grid-template-columns:22px 40px minmax(0,1fr) auto auto;align-items:center;gap:12px;min-height:56px;padding:8px 10px;background:transparent;border:0;border-bottom:1px solid var(--line);border-radius:0;box-shadow:none;transform:none;animation:none}\n#files.fnew #fgrid .fcard:hover{background:var(--hover);transform:none;box-shadow:none}\n#files.fnew #fgrid .fcard.sel{background:var(--soft);box-shadow:none}\n#files.fnew #fgrid .fck{position:static;display:flex;opacity:0;transition:opacity .12s}\n#files.fnew #fgrid .fcard:hover .fck,#files.fnew #fgrid .fcard.sel .fck,#fgrid.hassel .fck{opacity:1}\n#files.fnew #fgrid .fpv{width:40px;height:44px;display:grid;place-items:center;cursor:zoom-in;border-radius:8px;overflow:hidden}\n#files.fnew #fgrid .fpi{width:40px;height:40px;background:var(--hover)}\n#files.fnew #fgrid .fpi img{width:100%;height:100%;object-fit:cover;display:block;transform:none}\n#files.fnew #fgrid .ftile{width:34px;height:40px;margin:0;border-radius:8px;animation:none;box-shadow:none;border:1px solid color-mix(in srgb,var(--tint) 35%,transparent);background:color-mix(in srgb,var(--tint) 13%,var(--panel))}\n#files.fnew #fgrid .ftile::after{display:none}\n#files.fnew #fgrid .ftile *{animation:none!important}\n#files.fnew #fgrid .ftile .fic{width:18px;height:18px}\n#files.fnew #fgrid .fcard:hover .ftile{transform:none}\n#files.fnew #fgrid .fbody{min-width:0;display:flex;flex-direction:column;gap:2px}\n#files.fnew #fgrid .fname{font-size:13.5px;font-weight:500}\n#files.fnew #fgrid .fmeta{display:flex;align-items:center;gap:5px;font-size:12px;color:var(--dim);white-space:nowrap;overflow:hidden}\n#files.fnew #fgrid .ftag{font-size:11px;padding:0 6px;border-radius:5px;background:var(--hover);color:var(--dim)}\n#files.fnew #fgrid .ftag:hover{color:var(--acc)}\n#files.fnew #fgrid .ftag.add{opacity:0;background:none;border:1px dashed var(--line)}\n#files.fnew #fgrid .fcard:hover .ftag.add{opacity:1}\n#files.fnew #fgrid .fside{display:inline-flex;align-items:center;gap:5px;max-width:170px;font-size:12px;color:var(--dim);white-space:nowrap}\n#files.fnew #fgrid .fside span{overflow:hidden;text-overflow:ellipsis}\n#files.fnew #fgrid .fside .ic{width:12px;height:12px}\n#files.fnew #fgrid .fact2{margin:0;gap:2px}\n#files.fnew #fgrid .fact2 .btn{opacity:0;transition:opacity .12s,background .12s;flex:none}\n#files.fnew #fgrid .fcard:hover .fact2 .btn,#files.fnew #fgrid .fcard:focus-within .fact2 .btn,#files.fnew #fgrid .fstar.on{opacity:1}\n\n/* grille (au choix) */\n#files.fnew #fgrid.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(176px,1fr));gap:12px}\n#files.fnew #fgrid.grid .fcard{display:flex;flex-direction:column;align-items:stretch;gap:0;padding:0;min-height:0;position:relative;overflow:hidden;background:var(--panel);border:1px solid var(--line);border-radius:10px}\n#files.fnew #fgrid.grid .fcard:hover{background:var(--panel);border-color:var(--line2)}\n#files.fnew #fgrid.grid .fcard.sel{background:var(--soft);border-color:var(--acc)}\n#files.fnew #fgrid.grid .fck{position:absolute;top:8px;left:8px;z-index:2}\n#files.fnew #fgrid.grid .fpv{width:100%;height:112px;border-radius:0;background:var(--hover)}\n#files.fnew #fgrid.grid .fpi{width:100%;height:112px}\n#files.fnew #fgrid.grid .ftile{width:44px;height:52px}\n#files.fnew #fgrid.grid .fbody{padding:10px 12px 2px}\n#files.fnew #fgrid.grid .fside{padding:0 12px;max-width:none}\n#files.fnew #fgrid.grid .fact2{padding:6px 8px 8px}\n\n/* barre de sélection flottante */\n#files.fnew #fselbar{position:sticky;bottom:14px;z-index:6;margin:14px 0 0;background:var(--panel);border:1px solid var(--line2);border-radius:12px;box-shadow:var(--shadow);padding:8px 12px}\n#files.fnew #fselbar[hidden]{display:none}\n\n/* menu « ⋯ » d'un fichier */\n#fmore{position:fixed;z-index:90;min-width:210px;max-height:70vh;overflow:auto;padding:4px;background:var(--panel);border:1px solid var(--line);border-radius:10px;box-shadow:var(--shadow)}\n#fmore[hidden]{display:none}\n#fmore button{font:inherit;font-size:13px;color:var(--txt);width:100%;display:flex;align-items:center;gap:9px;padding:7px 10px;border:0;background:none;border-radius:7px;cursor:pointer;text-align:left}\n#fmore button:hover{background:var(--hover)}\n#fmore button.del{color:var(--err)}\n#fmore button.cur::after{content:'✓';margin-left:auto;color:var(--acc)}\n#fmore .mt{color:var(--dim);font-size:11px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;padding:6px 10px 3px}\n#fmore .msep{height:1px;background:var(--line);margin:4px 2px}\n\n#files.fnew #fempty .big{width:56px;height:56px;border-radius:14px;animation:none}\n#files.fnew #fempty h3{font:600 16px var(--sans)}\n#files.fnew #fempty p{font-size:13px}\n\n@media (max-width:900px){\n  #files.fnew{padding:18px 16px 40px}\n  #fwrap{grid-template-columns:1fr;gap:12px}\n  #files.fnew #fprojs{flex-direction:row;overflow-x:auto;position:static;padding-bottom:6px}\n  #fprojs .pi{flex:none}#fprojs .pgl,#fprojs .psep{display:none}\n  #files.fnew #fgrid:not(.grid) .fcard{grid-template-columns:22px 40px minmax(0,1fr) auto}\n  #files.fnew #fgrid .fside{display:none}\n}\n</style>\n<script>\n/* 2.6.1 — Page Fichiers épurée : projets à gauche, liste simple, actions au survol, menu « ⋯ ». Les données, la corbeille, les étiquettes, la sélection multiple et les raccourcis restent ceux de la 2.6.0. */\nObject.assign(ICONS,{more:'<circle cx=\"5\" cy=\"12\" r=\"1.3\"/><circle cx=\"12\" cy=\"12\" r=\"1.3\"/><circle cx=\"19\" cy=\"12\" r=\"1.3\"/>'});\nconst fvw=()=>settings.fview==='grid'?'grid':'list';\n\n// ---------- structure : barre de projets à gauche, contenu à droite, outils rares dans un menu ----------\nlet fnewOK=false;\ntry{\n  const files=$('files'),head=files.querySelector('.fhead'),side=$('fprojs'),selbar=$('fselbar'),empty=$('fempty'),act=head.querySelector('.fact'),fa=$('fadd');\n  const btns=['fscanbtn','fautobtn','fcolbtn'].map(id=>$(id));\n  if(!files||!head||!side||!selbar||!empty||!act||!fa||btns.some(b=>!b))throw new Error('éléments de la page Fichiers introuvables');\n  const main=document.createElement('div'),wrap=document.createElement('div'),menu=document.createElement('div'),mb=document.createElement('button');\n  main.id='fmain';wrap.id='fwrap';menu.id='fhmenu';menu.hidden=true;\n  head.after(wrap);wrap.append(side,main);\n  [...files.children].forEach(el=>{if(el!==head&&el!==wrap&&el.id!=='fin')main.appendChild(el)});\n  main.insertBefore(selbar,empty);\n  btns.forEach(b=>menu.appendChild(b));\n  menu.insertAdjacentHTML('beforeend',`<button class=\"btn\" id=\"fdup2\" type=\"button\">${IC('copy')}Chercher les doublons</button>`);\n  mb.className='btn ghost ico';mb.id='fhmore';mb.type='button';mb.title='Plus d\\'options : scanner Claude, classement automatique, couleurs, doublons';mb.setAttribute('aria-label','Plus d\\'options');mb.innerHTML=IC('more');\n  act.insertBefore(mb,fa);act.appendChild(menu);\n  if(fa.lastChild&&fa.lastChild.nodeType===3)fa.lastChild.textContent='Ajouter';\n  mb.onclick=e=>{e.stopPropagation();menu.hidden=!menu.hidden};\n  menu.addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;if(b.id==='fdup2')dedupe();setTimeout(()=>{menu.hidden=true},0)});\n  document.addEventListener('click',e=>{if(!menu.hidden&&!e.target.closest('#fhmenu,#fhmore'))menu.hidden=true});\n  files.classList.add('fnew');fnewOK=true;\n}catch(x){console.error('2.6.1 structure',x)}\n\n// ---------- barre de projets (à gauche) ----------\nfunction drawProjs(){const el=$('fprojs');if(!el)return;\n  const cnt=id=>FILES.filter(f=>id==='none'?!projOf(f):f.proj===id).length;\n  const sa=id=>{const ids=catIds(id),all=ids.length&&ids.every(x=>SEL.has(x));return `<button class=\"chipsel${all?' on':''}\" data-pa=\"${id}\" title=\"${all?'Désélectionner':'Tout sélectionner'} dans cette catégorie\"${ids.length?'':' disabled'}>${all?'☑':'☐'}</button>`};\n  const it=(id,label,n,ic,sel=true)=>`<div class=\"pi${fproj===id?' on':''}\"><button class=\"pb\" data-pf=\"${id}\">${ic?IC(ic):''}<span>${label}</span><i>${n}</i></button>${sel?sa(id):''}</div>`;\n  el.innerHTML=it('all','Tous',FILES.length,'')+it('recent','Récents',viewList('recent').length,'',false)+it('fav','Favoris',FILES.filter(f=>f.fav).length,'',false)+it('none','Non classés',cnt('none'),'')\n    +`<div class=\"pgl\"><span>Projets</span><button class=\"pnew\" data-pf=\"new\" title=\"Nouveau projet\" aria-label=\"Nouveau projet\">${IC('plus')}</button></div>`\n    +PJ().map(p=>it(p.id,esc(p.name),cnt(p.id),'folder')).join('')\n    +`<div class=\"psep\"></div>`+it('trash','Corbeille',TRASH.length,'trash',false);\n  drawPEdit()}\n\nfunction drawPEdit(){const el=$('fpedit'),p=PJ().find(x=>x.id===fproj);\n  if(!p){el.hidden=true;el.innerHTML='';delete el.dataset.pid;return}\n  if(el.dataset.pid===p.id&&!el.hidden)return;           // ne pas écraser la saisie en cours\n  el.dataset.pid=p.id;el.hidden=false;\n  el.innerHTML=`<div class=\"pe-row\"><input id=\"pname\" value=\"${esc(p.name)}\" maxlength=\"60\" placeholder=\"Nom du projet\" autocomplete=\"off\"><button class=\"btn sm\" id=\"patt\">${IC('clip')}Joindre tout le projet à…</button><button class=\"btn ghost sm del\" id=\"pdel\">${IC('trash')}Supprimer</button></div>\n    <textarea id=\"pdesc\" rows=\"2\" placeholder=\"Décris le projet en quelques mots (facultatif) : cela améliore le résumé donné à l'IA.\">${esc(p.desc||'')}</textarea>\n    <details class=\"pe-more\"><summary>Résumé donné à l'IA</summary><div class=\"pe-row\"><button class=\"btn sm\" id=\"psumb\">${IC('refresh')}Générer le résumé</button><span class=\"dim\" id=\"pstat\"></span></div><pre id=\"psum\"></pre></details>`;\n  showSum(p)}\n\n// ---------- barre d'outils : tri, type, vue ----------\nfunction drawTools(){const el=$('ftools');if(!el)return;const kc={};FILES.forEach(f=>{const k=kindOf(f);kc[k]=(kc[k]||0)+1});if(ftype&&!kc[ftype])ftype='';\n  const n=VIS.length;\n  el.innerHTML=`<span class=\"fcnt\">${n} élément${n>1?'s':''}</span><select id=\"fsort\" title=\"Trier\"><option value=\"new\">Plus récents</option><option value=\"old\">Plus anciens</option><option value=\"az\">Nom A → Z</option><option value=\"za\">Nom Z → A</option><option value=\"big\">Plus gros</option><option value=\"small\">Plus petits</option><option value=\"type\">Par type</option></select><select id=\"ftype\" title=\"Filtrer par type\"><option value=\"\">Tous les types</option>${Object.keys(FKINDS).filter(k=>kc[k]).map(k=>`<option value=\"${k}\">${FKINDS[k]} (${kc[k]})</option>`).join('')}</select><span class=\"sp\"></span>`\n    +(fproj==='trash'&&TRASH.length?`<button class=\"btn ghost sm del\" id=\"fempt\">${IC('trash')}Vider la corbeille</button>`:'')\n    +`<span class=\"vt\"><button data-v=\"list\" class=\"${fvw()==='list'?'on':''}\" title=\"Liste\">☰</button><button data-v=\"grid\" class=\"${fvw()==='grid'?'on':''}\" title=\"Grille\">▦</button></span>`;\n  $('fsort').value=settings.fsort||'new';$('ftype').value=ftype}\n\n// ---------- liste des fichiers ----------\nfunction drawFiles(anim=true){try{applyFcol()}catch{}\n  fUrls.forEach(u=>URL.revokeObjectURL(u));fUrls=[];\n  if(fproj!=='all'&&!['none','fav','recent','trash'].includes(fproj)&&!isProjId(fproj))fproj='all';\n  const tr=fproj==='trash';if(tr!==lastT){SEL.clear();lastT=tr}\n  const q=fq.trim().toLowerCase(),tot=FILES.reduce((s,f)=>s+f.size,0),n=accs.length;\n  const list=viewList(fproj).filter(f=>matchQ(f,q)&&(!ftype||kindOf(f)===ftype)).sort(sortP);VIS=list.map(f=>f.id);\n  $('fsub').textContent=FILES.length?`${FILES.length} fichier${FILES.length>1?'s':''} · ${fmtSize(tot)} · partagés entre tes ${n} compte${n>1?'s':''}`:'Ta bibliothèque est commune à tous tes comptes.';\n  $('fcount').textContent=FILES.length||'';\n  $('fempty').style.display=FILES.length||TRASH.length?'none':'grid';\n  const g=$('fgrid');g.classList.toggle('noanim',!anim);g.classList.toggle('list',fvw()==='list');g.classList.toggle('grid',fvw()==='grid');g.classList.toggle('hassel',SEL.size>0);\n  g.innerHTML=list.map((f,i)=>{const ik=iconKind(f);let pv;\n    if(ik==='image'){const u=URL.createObjectURL(f.blob);fUrls.push(u);pv=`<div class=\"fpv fpi\" data-prev=\"${f.id}\"><img src=\"${u}\" alt=\"\"></div>`}else pv=`<div class=\"fpv\" data-prevw=\"${f.id}\">${fileTile(f)}</div>`;\n    const d=new Date(f.added).toLocaleDateString('fr-FR',{day:'numeric',month:'short'}),pj=projOf(f);\n    const bits=[fileLabel(f),fmtSize(f.size),d];if(f.src)bits.push(f.src.kind==='created'?'Créé par Claude':'Joint');if(tr)bits.push(`supprimé dans ${Math.max(0,Math.ceil((TTL-(Date.now()-f.del))/DAY))} j`);\n    const tags=(f.tags||[]).map(t=>`<button class=\"ftag\" data-tag=\"${esc(t)}\" title=\"Clic : filtrer · clic droit : retirer\">#${esc(t)}</button>`).join('')+(tr?'':`<button class=\"ftag add\" data-addtag=\"${f.id}\" title=\"Ajouter une étiquette\">+ #</button>`);\n    const side=pj&&fproj!==pj.id?`<span class=\"fside\" title=\"Projet : ${esc(pj.name)}\">${IC('folder')}<span>${esc(pj.name)}</span></span>`:'<span class=\"fside\"></span>';\n    const acts=tr?`<button class=\"btn sm\" data-restore=\"${f.id}\">Restaurer</button><button class=\"btn ghost sm ico del\" data-purge=\"${f.id}\" title=\"Supprimer définitivement\">${IC('trash')}</button>`\n      :`<button class=\"btn sm\" data-att=\"${f.id}\" title=\"Joindre à une conversation\">${IC('clip')}Joindre</button><button class=\"btn ghost sm ico fstar${f.fav?' on':''}\" data-fav=\"${f.id}\" title=\"Favori\">${f.fav?'★':'☆'}</button><button class=\"btn ghost sm ico\" data-more=\"${f.id}\" title=\"Plus d'actions\" aria-label=\"Plus d'actions\">${IC('more')}</button>`;\n    return `<div class=\"fcard frw${SEL.has(f.id)?' sel':''}\" data-id=\"${f.id}\" style=\"--i:${i}\"><label class=\"fck\" title=\"Sélectionner (Maj+clic : plage)\"><input type=\"checkbox\" data-sel=\"${f.id}\"${SEL.has(f.id)?' checked':''}></label>${pv}<div class=\"fbody\"><div class=\"fname\" data-rn=\"${f.id}\" title=\"${esc(f.name)} · double-clic pour renommer\">${esc(f.name)}</div><div class=\"fmeta\" title=\"${esc((f.src&&f.src.conv)||'')}\"><span>${bits.map(esc).join(' · ')}</span>${tags}</div></div>${side}<div class=\"fact2\">${acts}</div></div>`}).join('')\n    +(!list.length&&(FILES.length||TRASH.length)?`<p class=\"dim\" style=\"padding:22px 4px\">${q?'Aucun fichier ne correspond.':tr?'La corbeille est vide.':fproj==='fav'?'Aucun favori : clique sur l\\'étoile d\\'un fichier.':'Aucun fichier dans cette sélection.'}</p>`:'');\n  drawTools();drawProjs();drawSel();pushMenu()}\n\n// ---------- menu « ⋯ » d'un fichier ----------\ndocument.body.insertAdjacentHTML('beforeend','<div id=\"fmore\" hidden></div>');\nfunction closeMore(){const m=$('fmore');m.hidden=true;m.innerHTML='';m.dataset.id=''}\nfunction openMore(btn,id){const f=byId(id);if(!f)return;const m=$('fmore');\n  m.dataset.id=id;\n  m.innerHTML=`<button data-m=\"rn\">${IC('edit')}Renommer</button><button data-m=\"dl\">${IC('dl')}Télécharger</button><button data-m=\"tag\"># Ajouter une étiquette</button><div class=\"msep\"></div><div class=\"mt\">Projet</div><button data-m=\"mv\" data-p=\"\"${!projOf(f)?' class=\"cur\"':''}>Sans projet</button>${PJ().map(p=>`<button data-m=\"mv\" data-p=\"${p.id}\"${p.id===f.proj?' class=\"cur\"':''}>${IC('folder')}${esc(p.name)}</button>`).join('')}<div class=\"msep\"></div><button data-m=\"rm\" class=\"del\">${IC('trash')}Mettre à la corbeille</button>`;\n  m.hidden=false;const r=btn.getBoundingClientRect(),w=m.offsetWidth,h=m.offsetHeight;\n  m.style.left=Math.max(8,Math.min(r.right-w,innerWidth-w-8))+'px';m.style.top=(r.bottom+6+h>innerHeight?Math.max(8,r.top-h-6):r.bottom+6)+'px'}\n$('fgrid').addEventListener('click',e=>{const b=e.target.closest('[data-more]');if(!b)return;e.stopPropagation();const m=$('fmore');\n  if(!m.hidden&&m.dataset.id===b.dataset.more)return closeMore();openMore(b,b.dataset.more)});\n$('fmore').addEventListener('click',async e=>{const b=e.target.closest('button[data-m]');if(!b)return;const id=$('fmore').dataset.id,f=byId(id);closeMore();if(!f)return;\n  const m=b.dataset.m;\n  if(m==='rn')startRename(id);\n  else if(m==='dl')dlFile(f);\n  else if(m==='tag'){const el=document.querySelector(`.fcard[data-id=\"${id}\"] [data-addtag]`);if(el)inlineInput(el,'Étiquette',v=>addTag([id],v))}\n  else if(m==='rm')trashIds([id]);\n  else if(m==='mv'){try{await FDB.put({...f,proj:b.dataset.p,man:true,auto:false})}catch{return toast('Impossible de changer le projet')}await loadFiles(false);toast(b.dataset.p?'Fichier déplacé vers « '+((PJ().find(p=>p.id===b.dataset.p)||{}).name||'projet')+' »':'Fichier retiré du projet')}});\ndocument.addEventListener('click',e=>{if(!$('fmore').hidden&&!e.target.closest('#fmore,[data-more]'))closeMore()});\ndocument.addEventListener('keydown',e=>{if(e.key==='Escape'&&!$('fmore').hidden)closeMore()});\n$('files').addEventListener('scroll',()=>{if(!$('fmore').hidden)closeMore()},{passive:true});\naddEventListener('resize',()=>{if(!$('fmore').hidden)closeMore()});\n// la case à cocher met à jour l'affichage de la sélection (cases visibles dès qu'un fichier est choisi)\n$('fgrid').addEventListener('change',e=>{if(e.target.closest('input[data-sel]'))$('fgrid').classList.toggle('hassel',SEL.size>0)});\n\nif(fnewOK)try{drawFiles(false)}catch(x){console.error('2.6.1 draw',x)}\n</script>\n</body></html>\n"}}}