oie la liste (noms seulement) ; un clic renvoie le choix à l'app, qui joint le fichier.\nlet MENU = { projects: [], files: [] };\nlet hbtn = null, hmenu = null, hlist = null, hfoot = null, hq = '';\nconst SELH = new Set();\nipcRenderer.on('hub:menu', (_e, d) => { if (d) MENU = d; if (hmenu) drawHubMenu(); });\nconst ATT = 'button[aria-label*=\"Add files\" i],button[aria-label*=\"Ajouter des fichiers\" i],button[aria-label*=\"Attach\" i],button[aria-label*=\"Joindre\" i],button[aria-label*=\"Upload\" i],[data-testid=\"input-menu-trigger\"],[data-testid=\"file-upload\"]';\nconst hsvg = () => {\n  const ns = 'http://www.w3.org/2000/svg', s = document.createElementNS(ns, 'svg'), p = document.createElementNS(ns, 'path');\n  for (const [k, v] of [['viewBox', '0 0 24 24'], ['width', '18'], ['height', '18'], ['fill', 'none'], ['stroke', 'currentColor'], ['stroke-width', '1.8'], ['stroke-linecap', 'round'], ['stroke-linejoin', 'round']]) s.setAttribute(k, v);\n  p.setAttribute('d', 'M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z'); s.appendChild(p); return s;\n};\nfunction ensureHubBtn() {\n  try {\n    if (!document.body || !/(^|\\.)claude\\.ai$/.test(location.hostname)) return;\n    const comp = q(S.comp).find(vis);\n    if (!comp) { if (hbtn) hbtn.style.display = 'none'; closeHubMenu(); return; }\n    if (!hbtn) {\n      hbtn = document.createElement('button'); hbtn.type = 'button'; hbtn.setAttribute('data-aihub', '1');\n      hbtn.setAttribute('aria-label', 'Joindre un fichier AI Hub'); hbtn.title = 'Joindre un fichier de tes projets AI Hub';\n      hbtn.appendChild(hsvg());\n      hbtn.addEventListener('mousedown', (e) => e.preventDefault());\n      hbtn.addEventListener('click', (e) => { e.preventDefault(); e.stopPropagation(); toggleHubMenu(); });\n    }\n    let att = null, el = comp;\n    for (let i = 0; i < 10 && el && !att; i++, el = el.parentElement) att = [...el.querySelectorAll(ATT)].find((b) => b !== hbtn && vis(b));\n    if (att) {\